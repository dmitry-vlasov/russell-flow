#!/bin/bash
# Wrapper for the Flow9 Mizar verifier (src/mizar/original), mirrors bin/russellj.
# The MML working copy defaults to $RUSSELL_MATH/MML-test; override with mml=<dir>.

set -e

SCRIPT_DIR=$( cd "$( dirname "$0" )" && pwd -P )
BASE_DIR=$( cd "$( dirname "$SCRIPT_DIR" )" && pwd -P )

MEM="4g"
ARGS=()
HAS_MML=0

for i in "$@"; do
case $i in
	mem=*)
		MEM="${i#*=}"
	;;
	mml=*)
		HAS_MML=1
		ARGS+=("$i")
	;;
	*)
		ARGS+=("$i")
	;;
esac
done

if [ "$HAS_MML" = 0 ] && [ -n "$RUSSELL_MATH" ]; then
	ARGS+=("mml=$RUSSELL_MATH/MML-test")
fi

java -Xss128m -Xmx$MEM -jar "$BASE_DIR/src/mizar/original/mizar.jar" "${ARGS[@]}"
