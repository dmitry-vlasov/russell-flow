/**
	@help {
		Read a foundation and print its declarative RULE TABLE: every assertion
		classified by statement shape (refl / shrink / grow / trans / antisym /
		intro / transport / unfold-bi / clash / identity), plus THE HOLE LIST —
		n-hyp combiners with no shape-matched guarded (d-form) companion, i.e.
		the rules deduction mode cannot run. Holes drive the curation loop:
		grep set.mm for the missing d-form, else author it in miz_aux.ru.

		  russellj info/rule-table file=mizar/miz_set.ru
		  russellj info/rule-table file=mizar/miz_set.ru dump=1 role=trans
	}
	@defarg file
	@category info

	@arg file  { the .ru source to read (foundation) }
	@arg dump  { 1 = print every classified rule @defval 0 }
	@arg holes { 1 = print the d-form hole list @defval 1 }
	@arg role  { restrict dump/holes to one role (refl, trans, ...); all = no filter @defval all }
*/

read-ru file=$file;
info-rule-table dump=$dump holes=$holes role=$role;
