/**
	@help {
		Scan the loaded sources into the SOFT-TYPE REGISTRY and report what the type
		layer contains: mode/attribute unfolds and the three cluster-registration
		kinds (functorial / conditional / existential), per role and per head.

		  russellj no-server=1 info/type-table file=mizar/subset_1.ru
		  russellj no-server=1 info/type-table file=mizar/subset_1.ru dump=1

		Read-only — nothing here touches proof search.
	}
	@defarg file
	@arg file { the .ru to read (its imports come with it) }
	@arg dump { 1 = print every classified rule @defval 0 }
	@arg role { restrict to one role @defval  }
	@arg top  { how many heads to list @defval 12 }
	@category info
*/
read-ru file=$file;
info-type-table dump=$dump role=$role top=$top;
