/**
	@help {
		Load a dataset and measure expression-deduplication potential:
		whole-expression interning (a trie) vs subterm sharing (a hash-consed DAG),
		both compared against the current flat representation.

		  russellj info/dedup afile=set-3000
	}
	@defarg afile
	@category info

	@arg afile { dataset directory name. @defval set-3000 }
*/

conf-load dir=./$afile;
read-ru;

stats-dedup;
