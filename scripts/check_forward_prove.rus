/**
	@help {
		P2 bidirectional-search check: grow the proof-carrying forward front from
		a theorem's premises and verify every derived fact's engine-built proof.
	}
	@defarg afile
	@category prover

	@arg afile { @defval set-10000  input Russell dataset directory name }
	@arg target { Theorem to take premises from. @defval syl }
	@arg depth { Forward depth. @defval 3 }
	@arg dump { 1 = print first failing proofs. @defval 0 }
*/

conf-set verb=1;
conf-load dir=./$afile;

read-ru;
	print ("ru read: " + read-ru.size + " files in " + time2s(read-ru.time));

test/forward-prove target=$target depth=$depth dump=$dump;
