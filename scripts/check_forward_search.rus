/**
	@help {
		Regression test for the bidirectional interior join: runs a bounded
		backward BFS with forward search OFF vs ON over the target and asserts
		forward-on is additive (loses nothing) and reproves strictly more.
		Crashes (strict-fail) on a violation. Run from ~/dev/math.
	}
	@defarg afile
	@category test

	@arg afile     { @defval set-10000  input dataset directory name }
	@arg target    { @defval stride-30  theorems to test }
	@arg fs_depth  { @defval 2          forward depth for the ON pass }
	@arg min_gain  { @defval 3          min #theorems forward must newly reprove }
*/

conf-set verb=1;
conf-load dir=./$afile;

read-ru;
	print ("ru read: " + read-ru.size + " files in " + time2s(read-ru.time));

test/forward-search target=$target fs-depth=$fs_depth min-gain=$min_gain
	max-depth=5 max-size=4096 time-ms=20000 strict-fail=1;

print "forward-search regression test PASSED";
