/**
	@help {
		DEBUG: translate an A-map article (foundation + article) back to Metamath and
		verify the result with the external Metamath checker — the ru -> mm direction.

		  russellj translate/mizar/to_mm module=xb1

		Reads miz_set + the article, translates everything to Metamath, writes a
		self-contained (monolithic) <module>_root.mm into <out>, and runs
		`metamath read; verify proof *` on it.

		An open `?` proof step has no Metamath proof, so a not-yet-proved theorem is
		emitted with an EMPTY proof, which Metamath flags ("The proof is empty"). So:
		  - run this AFTER `translate/mizar/prove` (the more closed, the fewer flags), and
		  - on a partially-proved article Metamath's report doubles as a precise list of
		    which theorems still don't round-trip; on a FULLY-proved article (or the bare
		    foundation) it verifies clean ("All proofs in the database were verified").
	}
	@defarg module
	@category translate

	@arg module { the A-map article module (e.g. xb1) }
	@arg math   { math root holding mizar/miz_set.ru and the article }
	@arg out    { output dir for the generated .mm @defval /tmp/mizar_mm }
	@arg unproven-are-axioms { 1 = turn still-open theorems into axioms (consistent mm); 0 = leave them (Metamath flags empty proofs) @defval 1 }
*/

found := (math + "/mizar/miz_set.ru");
art   := (math + "/mizar/" + module + ".ru");
root  := (module + "_root");

// The monolithic file is written under mm-root; point it at `out` so verify-mm finds it.
conf-set mm-root=$out;
conf-set gc-after-task=1;

// The mizar/ conf's `import-roots = ..` is RELATIVE: read from another CWD it does not
// resolve, every file= source keeps its full path as module id, and the toposort then
// reports a phantom cycle (imports name `mizar/<a>`, the loaded source is `/abs/<a>`).
// Anchor the roots absolutely, exactly as translate.rus does.
conf-set import-roots=$math;
read-ru file=$found;
read-ru file=$art;

// An open `?` proof has no Metamath image; axiomatise the still-open theorems so the export
// stays consistent (and mm-compress-proofs doesn't choke on empty proofs). On by default.
uaa := unproven-are-axioms;
if ((uaa == "1")) {
	unproven-to-axioms;
		print ("unproven -> axioms: " + unproven-to-axioms.converted + " theorems");
}

ru-comments2ascii;
ru-to-mm;
	print ("ru -> mm: " + ru-to-mm.size + " files");

clear-math what=ru;
mm-extract-vars;
// NB: no mm-compress-proofs here — it's a debug/verify script, and compression crashes on any
// malformed proof (e.g. a checker-generated proof that doesn't round-trip to Metamath); writing
// uncompressed proofs lets Metamath report the offending theorem by name instead of a Java crash.

// `file=` names an existing mm source; `monolithic=` is the merged output module name.
// (The absolute path trims to the `mizar/<module>` source id through import-roots, which
// is why the roots must be anchored above.)
suffix := ("_" + module);
src := (math + "/mizar/" + module);
write-mm file=$src monolithic=$root strip-comments=0;
	print ("mm written: " + out + "/" + root + ".mm");

// The gate reports a VERDICT, not a request to read the output by eye: verify-mm's own
// success flag plus the honest per-article metric — how many of THIS article's theorems
// carry a real proof the ORIGINAL checker verified (count-suffix), against the rest,
// which unproven-to-axioms turned into $a.
verify-mm $out/$root.mm count-suffix=$suffix;
	print ("MM_VERIFY " + module + " success=" + verify-mm.success
		+ " proved(" + module + ")=" + verify-mm.suffix-proofs
		+ " total-$p=" + verify-mm.proofs + " total-$a=" + verify-mm.axioms);
