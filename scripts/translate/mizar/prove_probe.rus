/**
	@help {
		Helper for prove_env_axioms.sh: read a single probe .ru (foundation + one
		open theorem) and try to prove it. Prints a machine-readable result line.

		  russellj translate/mizar/prove_probe file=/tmp/prove_env_xb1/t1_xboole_0.ru target=t1_xboole_0

		`rel` = relevance-depth (SInE premise selection), `tl` = per-theorem time
		limit, `md`/`ms` = BFS max depth/size, `fc` = forward-closure depth. Pass
		`wr=1` to WRITE the completed proof back into the probe file so you can read it.
	}
	@defarg target
	@category translate

	@arg file   { absolute path of the probe .ru }
	@arg target { the open theorem to prove }
	@arg rel    { relevance-depth (0 = whole foundation) @defval 1 }
	@arg tl     { per-theorem time limit @defval 60s }
	@arg md     { BFS max proof-tree depth @defval 10 }
	@arg ms     { BFS max proof-tree size @defval 1000000 }
	@arg fc     { forward-closure depth (0 = off) @defval 2 }
	@arg tac    { tactic DSL (empty = bounded BFS); only paren-free atoms work via CLI @defval  }
	@arg st     { steps mode: 1 = prove each open `?` step, 0 = prove the whole statement @defval 1 }
*/

read-ru file=$file;
prove target=$target steps=$st relevance-depth=$rel time-limit=$tl exclude-disjointed=0
	max-depth=$md max-size=$ms forward-closure-depth=$fc tactic=$tac;
verify;
	print ("PROBE_RESULT " + target + " proved=" + prove.proved-count + " verify=" + verify.success);
// write the (possibly completed) proof back into the probe file so it can be read.
write-ru target=$target;
	print ("PROBE_WRITTEN " + file);
