/**
	@help {
		FULL Mizar → Russell → Metamath pipeline for ONE article in a single launch:
		  (a) translate the analyzed Mizar XML into an A-map Russell skeleton (open `?` steps),
		  (c) prove the open by-gaps with a tactic,
		  (d) linearize the proofs (inline all lemmas into one flat proof per theorem),
		  (e) optimize the proofs (shorten + remove trivial theorems),
		  (f) write the completed `.ru` and verify every proof against the Russell kernel,
		  (g) translate to Metamath (same dir) and verify with the external Metamath checker.
		(Phase (b) — hand-editing an inline tactic per step — is SKIPPED here: a command-level
		tactic proves every gap instead. Pass tac= to choose it.)

		  russellj no-server=1 mem=16g translate/mizar/pipeline article=xboole_1
		  russellj no-server=1 mem=16g translate/mizar/pipeline article=xboole_1 tac=def-close tl=30s

		Requires (all under the math root, supplied automatically from $RUSSELL_MATH):
		  - <math>/mizar/miz_set.ru          the A-map foundation (regen: translate/mizar/regen_foundation)
		  - <math>/mizar/<dep>.ru            the article's already-translated DEPENDENCIES — translate in
		                                     dependency order (tarski, xboole_0, then xboole_1, …)
		  - <math>/MML/mml/<article>.xml/.atr/.eth   the analyzed Mizar article
		The module name = the article name (so the dep `import mizar/<dep>` references resolve).
	}
	@defarg article
	@category translate

	@arg math    { math root holding mizar/miz_set.ru + MML/mml (auto-supplied from $RUSSELL_MATH) }
	@arg article { Mizar article name, e.g. xboole_1 — also the generated module name }
	@arg tac     { proving tactic (def-close-checker = A-map auto-prover incl. the Kalmar-free checker) @defval def-close-checker }
	@arg tl      { per-step time limit @defval 10s }
	@arg par     { 0 = sequential (default, reliable); 1 = parallel (experimental — does not persist under thread contention) @defval 0 }
	@arg lin     { 1 = linearize proofs (inline all lemmas into one flat proof, default); 0 = keep lemma structure @defval 1 }
	@arg opt     { 1 = optimize proofs (shorten + remove trivial theorems, default); 0 = skip @defval 1 }
	@arg opttl   { time budget for the proof-shortening pass when opt=1 @defval 120s }
	@arg v       { output level: 0 silent, 1 phase lines + summary, 2 also a ✓/✗ line per theorem; `auto` = follow conf.verb (default) @defval auto }
*/

mdir  := (math + "/MML/mml");
found := (math + "/mizar/miz_set.ru");
outd  := (math + "/mizar");
talk  := (v != "0");   // print the script's own phase lines unless explicitly silenced
// conf.verb drives every command's output. Only override it when v is given explicitly — `v=auto`
// (default) leaves a verb set by a preceding `conf-set verb=N` intact.
if (v != "auto") {
	conf-set verb=$v;
} else { }
// `module` is a NAME, not a path — ru-root (=outd) supplies the directory; the article's file becomes
// pathCombine(ru-root, mod + ".ru"). (An absolute path here would double against ru-root.) Using the
// bare name also makes the in-memory source id = s2id(mod), so `prove target=$mod` selects exactly this
// article (a CLEAN per-article count), not `all` (which is swamped by the ~9300 foundation theorems).
mod   := article;
outf  := (outd + "/" + mod + ".ru");

// The math root is an import-root so the article's `mizar/<dep>` dependency imports resolve on read,
// and the freshly-translated article gets the matching `mizar/<article>` self-id those imports expect.
conf-set ru-root=$outd;
conf-set import-roots=$math;

// ---- phase (a): analyzed Mizar XML -> A-map skeleton (every by-gap an OPEN `?` step) ----
read-ru file=$found;
mizar-to-ru article=$article dir=$mdir foundation=miz_set module=$mod proofs=1;
	if (talk) { print ("[a] translated " + article + " -> " + outf); }

// ---- phase (c): prove the article's open `?` steps (bounded + scoped: relevance-depth=0; the
// whole-foundation BFS would overflow the 2^20 rule-id space). target=$mod = just this article.
// The prove command reports per conf.verb AFTER all theorems finish (proved count read from the
// final verified math — exact). par=0 sequential by default (par=1 parallel is experimental). ----
prove target=$mod steps=1 tactic=$tac relevance-depth=0 exclude-disjointed=0 time-limit=$tl max-depth=8 max-size=65536 forward-closure-depth=0 parallel=$par;
	if (talk) { print ("[c] proved the open by-gaps of " + article + " with tactic: " + tac); }

// ---- (e1) structural cleanup (opt=1, default), scoped to THIS article (target=$mod, never the
// foundation): remove-duplicate-steps -> remove-unused-steps -> remove-unused-hyps. Run BEFORE
// linearize, on the compact lemma-structured proofs, where these passes are sound and cheap. (Running
// them AFTER linearize is unsafe: linearize occasionally emits a flat proof with an out-of-range step
// ref that only the proof-rebuilding shorten pass below repairs; feeding that to the ref-walking
// unused-* passes crashes.) All three skip open `?` theorems — only fully-proved ones are touched,
// so a partially-closed article is safe. The historical "illegal hyp index" crash here was the
// OPEN-theorem case (walking a `?` last step found no used hyps and dropped live ones); the
// proved-theorem filter fixes it. ----
if (opt == "1") {
	remove-duplicate-steps target=$mod;
	remove-unused-steps target=$mod;
	remove-unused-hyps target=$mod;
	if (talk) { print ("[e1] cleaned up: removed " + remove-unused-steps.optimized-steps + " unused + " + remove-duplicate-steps.optimized-steps + " duplicate steps, " + remove-unused-hyps.optimized-hyps + " unused hyps"); }
} else { }

// ---- (d) linearize (lin=1, default): inline every lemma sub-proof into one flat proof per theorem.
// Run AFTER the structural cleanup (which needs the lemma form) and BEFORE shorten (which wants flat
// proofs: ~1.6k mergeable steps on xboole_1 vs a handful on the lemma form, and its proof rebuild also
// normalizes any ref linearize left out of range). ----
if (lin == "1") {
	linearize-proofs target=$mod;
	if (talk) { print ("[d] linearized proofs (lemmas inlined): " + linearize-proofs.linearized-theorems + " theorems"); }
} else { }

// ---- (e2) shorten + drop trivially-derivable theorems (opt=1, default), on the flat proofs. ----
if (opt == "1") {
	shorten-proofs target=$mod time-limit=$opttl;
	remove-trivial-theorems target=$mod;
	if (talk) { print ("[e2] optimized: shortened " + shorten-proofs.shortened-steps + " steps; removed trivial theorems"); }
} else { }

// ---- (f) persist the linearized + optimized proofs, then re-verify against the Russell kernel ----
write-ru target=$mod;
	if (talk) { print ("[f] wrote completed proofs -> " + outf); }
	if (talk) { print "[f] verifying all Russell proofs against the kernel ..."; }
verify;
	if (talk) { print ("[f] Russell verify (all proofs valid): " + verify.success); }

// ---- (g) close the loop: translate to Metamath (written in the SAME dir as the article) and verify
// with the external Metamath checker. Still-open theorems become axioms so the .mm export stays
// consistent (empty proofs are invalid Metamath). write-mm monolithic=… emits one self-contained file. ----
mmout  := outd;
mmroot := (mod + "_root");
conf-set mm-root=$mmout;
unproven-to-axioms;
	if (talk) { print ("[g] open theorems -> axioms: " + unproven-to-axioms.converted); }
ru-comments2ascii;
ru-to-mm;
clear-math what=ru;
mm-extract-vars;
write-mm file=$mod monolithic=$mmroot strip-comments=0;
	if (talk) { print ("[g] wrote Metamath -> " + mmout + "/" + mmroot + ".mm"); }
verify-mm $mmout/$mmroot.mm;
	if (talk) { print ("[g] Metamath verify done (look for 'All proofs in the database were verified' above)"); }
