/**
	@help {
		FULL Mizar → Russell → Metamath pipeline for ONE article in a single launch:
		  (a) translate the analyzed Mizar XML into an A-map Russell skeleton (open `?` steps),
		  (c) prove the open by-gaps with a tactic,
		  (d) linearize the proofs (inline all lemmas into one flat proof per theorem),
		  (e) optimize the proofs (shorten + remove trivial theorems),
		  (f) write the completed `.ru` and verify every proof against the Russell kernel,
		  (g) translate to Metamath (same dir) and verify with the external Metamath checker.
		(Phase (b) — hand-editing an inline tactic per step — is SKIPPED here: a command-level
		tactic proves every gap instead. Pass tac= to choose it.)

		  russellj no-server=1 mem=16g translate/mizar/pipeline article=xboole_1
		  russellj no-server=1 mem=16g translate/mizar/pipeline article=xboole_1 tac=def-close tl=30s

		Requires (all under the math root, supplied automatically from $RUSSELL_MATH):
		  - <math>/mizar/miz_set.ru          the A-map foundation (regen: translate/mizar/regen_foundation)
		  - <math>/mizar/<dep>.ru            the article's already-translated DEPENDENCIES — translate in
		                                     dependency order (tarski, xboole_0, then xboole_1, …)
		  - <math>/mizar/miz_aux.ru          optional hand-authored companion lemmas — auto-loaded and
		                                     auto-imported by phase (a) when present
		  - <math>/MML/mml/<article>.xml/.atr/.eth   the analyzed Mizar article
		The module name = the article name (so the dep `import mizar/<dep>` references resolve).
	}
	@defarg article
	@category translate

	@arg math    { math root holding mizar/miz_set.ru + MML/mml (auto-supplied from $RUSSELL_MATH) }
	@arg article { Mizar article name, e.g. xboole_1 — also the generated module name }
	@arg tac     { proving tactic. generators-first (THE DEFAULT since 2026-07-23, user-approved) = the two direct generators (equalizer-gen, unifier-gen) in front of the checker-pipeline stages — hermetic gates: zfmisc 87/140 (record, +5 over checker-pipeline), enumset1 87/87, xboole_1 102/116, xboole_0 7/8, all MM-green. checker-pipeline = the previous 4-stage or-else. @defval generators-first }
	@arg tl      { per-step time limit @defval 10s }
	@arg dcms    { def-close-checker stage slice in WALL-CLOCK ms (checker-pipeline only) — widen on a loaded/throttled machine, e.g. dcms=9000 mzms=3000 eqms=2000 tl=16s @defval 4500 }
	@arg mzms    { checker-mizar stage slice, ms (checker-pipeline only) @defval 1500 }
	@arg eqms    { checker-eq stage slice, ms (checker-pipeline only) @defval 1000 }
	@arg par     { 0 = sequential (default, count-exact); N>1 = prove up to N theorems concurrently (~2.6x faster at N=8, but wall-clock slices lose a few borderline theorems on a power-capped machine); 1 = unbounded pool (legacy, loses most theorems) @defval 0 }
	@arg lin     { 1 = linearize proofs (inline all lemmas into one flat proof, default); 0 = keep lemma structure @defval 1 }
	@arg cl      { 1 = class-loci experimental representation (mizar-to-ru class-loci) @defval 0 }
	@arg opt     { 1 = optimize proofs (shorten + remove trivial theorems, default); 0 = skip @defval 1 }
	@arg opttl   { global time budget for the refactor/optimize pass when opt=1 @defval 120s }
	@arg v       { output level: 0 silent, 1 phase lines + summary, 2 also a ✓/✗ line per theorem; `auto` = follow conf.verb (default) @defval auto }
*/

mdir  := (math + "/MML/mml");
found := (math + "/mizar/miz_set.ru");
outd  := (math + "/mizar");
talk  := (v != "0");   // print the script's own phase lines unless explicitly silenced
// conf.verb drives the output of verify and the other commands. Only override it when v is given
// explicitly — `v=auto` (default) leaves a verb set by a preceding `conf-set verb=N` intact.
if (v != "auto") {
	conf-set verb=$v;
} else { }
// Report verbosity for the prove command, passed as progress= (highest precedence). v=auto -> empty ->
// the command falls back to conf.verb. A top-level `conf-set verb=N` is hoisted by the launcher into
// env.conf and would otherwise shadow the in-script conf-set for the prove report; progress= avoids it.
prog := "";
if (v != "auto") {
	prog := v;
} else { }
// `module` is a NAME, not a path — ru-root (=outd) supplies the directory; the article's file becomes
// pathCombine(ru-root, mod + ".ru"). (An absolute path here would double against ru-root.) Using the
// bare name also makes the in-memory source id = s2id(mod), so `prove target=$mod` selects exactly this
// article (a CLEAN per-article count), not `all` (which is swamped by the ~9300 foundation theorems).
mod   := article;
outf  := (outd + "/" + mod + ".ru");

// The math root is an import-root so the article's `mizar/<dep>` dependency imports resolve on read,
// and the freshly-translated article gets the matching `mizar/<article>` self-id those imports expect.
conf-set ru-root=$outd;
conf-set import-roots=$math;

// ---- phase (a): analyzed Mizar XML -> A-map skeleton (every by-gap an OPEN `?` step) ----
read-ru file=$found;
mizar-to-ru article=$article dir=$mdir foundation=miz_set module=$mod proofs=1 class-loci=$cl;
	if (talk) { print ("[a] translated " + article + " -> " + outf); }

// ---- phase (c): prove the article's open `?` steps (bounded + scoped: relevance-depth=0; the
// whole-foundation BFS would overflow the 2^20 rule-id space). target=$mod = just this article.
// The prove command reports per conf.verb AFTER all theorems finish (proved count read from the
// final verified math — exact). par=0 sequential by default (par=1 parallel is experimental). ----
// The default checker-pipeline tactic takes its stage slices as args (dcms/mzms/eqms —
// wall-clock ms; widen on a loaded machine). A custom tac= is invoked bare: named args
// on an arbitrary tactic would not bind.
tacinv := tac;
if (tac == "checker-pipeline") {
	tacinv := (tac + "(dc-time=" + dcms + ", mizar-time=" + mzms + ", eq-time=" + eqms + ")");
} else { }
prove target=$mod steps=1 tactic=$tacinv relevance-depth=0 exclude-disjointed=0 time-limit=$tl max-depth=8 max-size=65536 forward-closure-depth=0 parallel=$par progress=$prog;
	if (talk) { print ("[c] proved the open by-gaps of " + article + " with tactic: " + tac); }

// ---- (d) linearize (lin=1, default): inline every lemma sub-proof into one flat proof per theorem.
// Run BEFORE optimize: flattening exposes the redundancy the optimize passes remove — inlining the same
// lemma at several call sites creates duplicate/unused steps that do not exist in the lemma form (on
// xboole_1: ~300 duplicate + ~660 unused steps appear only after linearize). ----
if (lin == "1") {
	linearize-proofs target=$mod;
	if (talk) { print ("[d] linearized proofs (lemmas inlined): " + linearize-proofs.linearized-theorems + " theorems"); }
} else { }

// ---- (e) optimize (opt=1, default): invoke the canonical refactor/optimize.rus directly (single
// source of truth for the optimize sequence — optimize-hyps' duplicate/unused-step/unused-hyp loop,
// then shorten-proofs, then remove-trivial-theorems, iterated to a fixpoint). It is scoped to THIS
// article (target=$mod, never the foundation) and reuses the math already in memory: have_read=true
// makes optimize.rus skip its own read-ru, so it optimizes the linearized state in place. opttl caps
// its global time budget. All passes skip open `?` theorems, so a partially-closed article is safe. ----
if (opt == "1") {
	have_read := true;   // math already loaded (translated + proved + linearized) — optimize in place
	// keep_trivial=1: the article's theorems ARE the deliverable — a theorem legitimately
	// proved by ONE foundation-lemma application must STAY in the article (and reach the
	// .mm export as a $p), not be deduplicated away as "trivial". Removal here made the
	// metamath-gate artifact metric read 0 for tarski while 2 theorems were really proved.
	refactor/optimize target=$mod time_limit=$opttl iter_limit=10 keep_trivial=1;
	if (talk) { print ("[e] optimized " + mod + " via refactor/optimize (target=" + mod + ", budget " + opttl + ")"); }
} else { }

// ---- (f) persist the linearized + optimized proofs, then re-verify against the Russell kernel ----
write-ru target=$mod;
	if (talk) { print ("[f] wrote completed proofs -> " + outf); }
	if (talk) { print "[f] verifying all Russell proofs against the kernel ..."; }
verify;
	if (talk) { print ("[f] Russell verify (all proofs valid): " + verify.success); }

// ---- (g) close the loop: translate to Metamath (written in the SAME dir as the article) and verify
// with the external Metamath checker. Still-open theorems become axioms so the .mm export stays
// consistent (empty proofs are invalid Metamath). write-mm monolithic=… emits one self-contained file. ----
mmout  := outd;
mmroot := (mod + "_root");
conf-set mm-root=$mmout;
unproven-to-axioms;
	if (talk) { print ("[g] open theorems -> axioms: " + unproven-to-axioms.converted); }
ru-comments2ascii;
ru-to-mm;
clear-math what=ru;
mm-extract-vars;
write-mm file=$mod monolithic=$mmroot strip-comments=0;
	if (talk) { print ("[g] wrote Metamath -> " + mmout + "/" + mmroot + ".mm"); }
// THE METAMATH GATE (architectural law): the ORIGINAL checker's verdict, machine-checked.
// count-suffix=_<article> counts the article's own $p statements IN THE VERIFIED ARTIFACT —
// the honest per-article proved count. The prover's own report can be inflated by proofs
// that optimization later deletes (the circular-proof laundering); a $p here cannot.
verify-mm $mmout/$mmroot.mm count-suffix=_$article;
	if (talk) { print ("[g] METAMATH GATE [" + article + "]: success=" + verify-mm.success
		+ ", article $p proved=" + verify-mm.suffix-proofs
		+ " (total $p=" + verify-mm.proofs + ", $a=" + verify-mm.axioms + ")"); }
