/**
	@help {
		DEBUG: verify a translated A-map article with the native Russell verifier.
		Reads the foundation (miz_set) + the article and runs `verify` over everything.

		  russellj translate/mizar/verify module=xb1

		Prints `VERIFY <module> success=<bool>`. Use after `translate/mizar/translate`
		(open `?` steps are reported as not-yet-proved, not as errors) or after
		`translate/mizar/prove` (installed proofs must verify true).
	}
	@defarg module
	@category translate

	@arg module { the A-map article module (e.g. xb1) }
	@arg math   { math root holding mizar/miz_set.ru and the article }
*/

found := (math + "/mizar/miz_set.ru");
art   := (math + "/mizar/" + module + ".ru");

read-ru file=$found;
read-ru file=$art;

verify;
	print ("VERIFY " + module + " success=" + verify.success);
