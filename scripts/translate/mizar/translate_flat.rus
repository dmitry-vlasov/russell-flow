/**
	@help {
		Translate a Mizar analyzed article (the verifier's XML) into a single Russell
		.ru file you can open in an editor: the article signature + theorem statements
		+ (optionally) every per-step proof gap in hypotheses form. One command, no
		server.

		  russellj translate/mizar/translate_flat article=xboole_1 out=/tmp/miz

		Writes <out>/<article>.ru (it `import`s the miz_logic foundation). Requires the
		article's analyzed files in <math>/MML/mml (<article>.xml/.atr/.eth — produced by
		running the Mizar verifier over the MML) and the foundation at <math>/miz_logic.ru.

		Pass proofs=0 to emit just the statements (single open step each), with no proof
		skeletons.
	}
	@defarg article
	@category translate

	@arg article { Mizar article name, e.g. xboole_1 }
	@arg math    { math root holding MML/mml and miz_logic.ru (e.g. $RUSSELL_MATH) }
	@arg out     { output directory for the generated .ru @defval /tmp }
	@arg proofs  { 1 = multi-step open proof skeletons (default), 0 = statements only @defval 1 }
*/

mdir  := (math + "/MML/mml");
found := (math + "/miz_logic.ru");

// The generated article's path is rooted at ru-root, so write-ru lands in <out>.
conf-set ru-root=$out;

read-ru file=$found;
	print ("foundation loaded: " + read-ru.size + " source(s) from " + found);

mizar-to-ru article=$article dir=$mdir foundation=miz_logic proofs=$proofs;

verify;
	print ("verify success: " + verify.success);

// target=<article> writes ONLY the article (not the foundation).
write-ru target=$article;
	print "written: $out/$article.ru";
