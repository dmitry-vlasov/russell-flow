/**
	@help {
		PHASE (c): prove the open steps of an A-map article using the INLINE per-step
		tactics added in phase (b), and write the completed proofs back.

		  russellj no-server=1 mem=12g translate/mizar/prove module=xb1

		Reads miz_set + <math>/mizar/<module>.ru, runs `prove steps=1` (NO command-level
		tactic, so each `?` step uses its own inline tactic; a step with no inline tactic
		falls back to bounded BFS), writes the result back to <module>.ru, and re-verifies
		the round-trip. A theorem whose every step closes is fully proved; partially
		closed theorems keep their remaining `?` steps (not an error).

		target= restricts to one theorem (default all). After this, <module>.ru is a valid
		Russell source with complete proofs for the fully-closed theorems.
	}
	@defarg module
	@category translate

	@arg math   { math root holding mizar/miz_set.ru and mizar/<module>.ru (e.g. $RUSSELL_MATH) }
	@arg module { the A-map article module (e.g. xb1) }
	@arg target { theorem name, or `all` @defval all }
*/

found := (math + "/mizar/miz_set.ru");
art   := (math + "/mizar/" + module + ".ru");

	print ("phase (c) reading: " + art + "  (foundation: " + found + ")");
	print ("  -> this MUST be the file you edited in phase (b); it must import miz_set (from translate/mizar/translate, NOT the flat translate/mizar/translate_flat)");
read-ru file=$found;
read-ru file=$art;

// steps=1 + no tactic= : each open `?` step uses its own inline tactic.
prove target=$target steps=1;

// persist the closed proofs back into the source.
write-ru target=all;
	print "phase (c) written proofs back";

// re-verify the written source (clean round-trip = the proofs are sound).
verify;
	print ("phase (c) verify: " + verify.success);
