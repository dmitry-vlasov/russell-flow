/**
	@help {
		PHASE (c): prove the open steps of an A-map article using the INLINE per-step
		tactics added in phase (b), and write the completed proofs back.

		  russellj no-server=1 mem=12g translate/mizar/prove module=xb1

		Reads miz_set + <math>/mizar/<module>.ru, runs `prove steps=1` (NO command-level
		tactic, so each `?` step uses its own inline tactic; a step with no inline tactic
		falls back to bounded BFS), writes the result back to <module>.ru, and re-verifies
		the round-trip. A theorem whose every step closes is fully proved; partially
		closed theorems keep their remaining `?` steps (not an error).

		Output verbosity is the `v` arg (the script applies it as conf.verb): v=0 silent, v=1 the
		proved/total summary + not-proved list (default), v=2 also a ✓/✗ line per theorem. The
		report is printed AFTER every theorem finishes (no stragglers). The proved count is read
		from the final verified math, so it is always exact.

		Closes with mm=1 (default): translate the result to Metamath and run the external
		Metamath checker as final evidence.

		target= (default `auto`) proves just THIS article; pass a theorem name to restrict to
		one, or `all` for every loaded source. After this, <module>.ru is a valid Russell
		source with complete proofs for the fully-closed theorems.
	}
	@defarg module
	@category translate

	@arg math   { math root holding mizar/miz_set.ru and mizar/<module>.ru (e.g. $RUSSELL_MATH) }
	@arg module { the A-map article module (e.g. xb1) }
	@arg target { `auto` (default) = the whole article; a theorem name = just that one; `all` = every loaded source @defval auto }
	@arg tac    { tactic DSL; `def-close` for A-map auto-proving, empty = inline per-step tactics @defval def-close }
	@arg tl     { per-step time limit @defval 10s }
	@arg par    { 0 = sequential (default, reliable); 1 = parallel (experimental — does not persist proofs under thread contention) @defval 0 }
	@arg mm     { 1 = close by translating to Metamath and running the external Metamath checker; 0 = skip @defval 1 }
	@arg v      { output level: 0 silent, 1 summary, 2 a ✓/✗ line per theorem; `auto` = follow conf.verb (default) @defval auto }
*/

found  := (math + "/mizar/miz_set.ru");
art    := (math + "/mizar/" + module + ".ru");
tgt    := (math + "/mizar/" + module);
tgtdir := (math + "/mizar");
// the article's loaded source id (read-from-disk = import-root-relative). Build it with string concat
// — an inline `mizar/$module` in a command arg gets the `/` mis-parsed as division inside this script.
tgtid := ("mizar/" + module);
talk  := (v != "0");   // print the script's own phase lines unless explicitly silenced

// conf.verb drives the output of verify and the other commands. Only override it when v is given
// explicitly — `v=auto` (default) leaves a verb set by a preceding `conf-set verb=N` intact.
// NOTE: the prove report does NOT rely on this conf.verb (see `prog` below). A top-level
// `conf-set verb=N` is hoisted by the launcher into env.conf and SHADOWS this in-script conf-set for
// the prove report, so we drive that report directly with the highest-precedence `progress=` arg.
if (v != "auto") {
	conf-set verb=$v;
}
// Report verbosity for the prove command, passed as progress= (overrides conf.verb in the prove
// command). v=auto -> empty -> the command falls back to conf.verb. v=0/1/2 -> that level, always.
prog := "";
if (v != "auto") {
	prog := v;
}
// The article imports its dependency articles by their `mizar/<name>` path (relative to the math
// root) — register the math root as an import-root so those imports resolve on read.
conf-set import-roots=$math;
read-ru file=$found;
read-ru file=$art;

// steps=1 with tactic=$tac. KEEP the search BOUNDED + SCOPED (relevance-depth=0 with `def-close` uses a
// tiny scope-only index): the default whole-foundation bounded-BFS mints enough fresh vars across a
// whole article to overflow the 2^20 rule-id space. tac= empty falls back to each step's inline tactic.
// Default target = THIS article (mizar/<module>) → a clean per-article count (not the ~9300 foundation
// theorems). Override: target=<thm> or target=all. progress=$prog drives the after-all report (empty
// when v=auto → the command uses conf.verb).
if (target == "auto") {
	prove target=$tgtid steps=1 tactic=$tac relevance-depth=0 exclude-disjointed=0 time-limit=$tl max-depth=8 max-size=65536 forward-closure-depth=0 parallel=$par progress=$prog;
} else {
	prove target=$target steps=1 tactic=$tac relevance-depth=0 exclude-disjointed=0 time-limit=$tl max-depth=8 max-size=65536 forward-closure-depth=0 parallel=$par progress=$prog;
}

// persist the closed proofs back into the ARTICLE only (NOT target=all — that would rewrite the
// foundation too). The source key is the absolute no-ext path.
write-ru target=$tgt;

// Integrity check: re-verify every installed proof against the kernel (a clean round-trip means the
// prover's results are sound). verify.success = true only if ALL loaded proofs pass.
verify;
if (talk) {
	print ("Russell verify (all proofs valid): " + verify.success);
}

// Final evidence (mm=1, default): translate to Metamath (next to the article) and run the external
// Metamath checker. Still-open theorems become axioms so the export is consistent.
if (mm == "1") {
	mmroot := (module + "_root");
	conf-set mm-root=$tgtdir;
	unproven-to-axioms;
	ru-comments2ascii;
	ru-to-mm;
	clear-math what=ru;
	mm-extract-vars;
	write-mm file=$tgt monolithic=$mmroot strip-comments=0;
	verify-mm $tgtdir/$mmroot.mm;
	if (talk) {
		print ("Metamath checked -> " + tgtdir + "/" + mmroot + ".mm  (look for 'All proofs ... verified' above)");
	}
} else { }
