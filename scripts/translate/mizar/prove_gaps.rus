/**
	@help {
		Measure how many open `?` proof steps (gaps) of a translated A-map article a
		tactic can fill. Reads the foundation + article, runs `prove steps=1` with the
		given tactic over the article's gaps, and re-verifies.

		  russellj translate/mizar/prove_gaps module=xb1 tac=def-close math=$RUSSELL_MATH

		The `prove steps:` line reports closed/total steps + theorems fully proved.
		NOTE: the source key is the absolute path (no extension), so `target` defaults
		to it — restricting the measurement to the article, not the foundation.
	}
	@defarg module
	@category translate

	@arg module { the A-map article module (e.g. xb1) }
	@arg math   { math root holding mizar/miz_set.ru and the article }
	@arg tac    { tactic DSL (e.g. def-close); empty = bounded BFS @defval  }
	@arg tl     { per-step time limit @defval 10s }
*/

found := (math + "/mizar/miz_set.ru");
art   := (math + "/mizar/" + module + ".ru");
tgt   := (math + "/mizar/" + module);
read-ru file=$found;
read-ru file=$art;
prove target=$tgt steps=1 tactic=$tac relevance-depth=0 exclude-disjointed=0 time-limit=$tl max-depth=8 max-size=65536 forward-closure-depth=0;
verify target=$tgt;
	print ("GAPS_RESULT " + module + " fully-proved=" + prove.proved-count + " verify=" + verify.success);
