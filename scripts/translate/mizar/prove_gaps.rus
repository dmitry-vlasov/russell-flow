/**
	@help {
		Measure how many open `?` proof steps (gaps) of a translated A-map article a
		tactic can fill. Reads the foundation + article, runs `prove steps=1` with the
		given tactic over the gaps, and re-verifies. Does NOT write the article back.

		  russellj translate/mizar/prove_gaps module=xb1 tac=checker

		The `prove steps:` line reports closed/total steps + theorems fully proved.
	}
	@defarg module
	@category translate

	@arg module { the A-map article module (e.g. xb1) }
	@arg target { theorem name, or `all` @defval all }
	@arg tac    { tactic DSL (e.g. checker); empty = bounded BFS @defval  }
	@arg tl     { per-step time limit @defval 20s }
*/

found := (math + "/mizar/miz_set.ru");
art   := (math + "/mizar/" + module + ".ru");
read-ru file=$found;
read-ru file=$art;
prove target=$target steps=1 tactic=$tac relevance-depth=0 exclude-disjointed=0
	time-limit=$tl max-depth=8 max-size=65536 forward-closure-depth=0;
write-ru target=$module;
verify;
	print ("GAPS_RESULT " + module + " verify=" + verify.success);
