/**
	@help {
		PHASE (a): translate a Mizar analyzed article into an A-map Russell skeleton.

		  russellj no-server=1 mem=12g translate/mizar/translate article=xboole_1

		Reads the miz_set (A-map class-layer) foundation + the article's analyzed XML
		(<math>/MML/mml/<article>.xml/.atr/.eth), maps the set-theoretic core onto
		set.mm's class layer, and writes <math>/mizar/<article>.ru — every by-gap an OPEN
		`?` proof step. The result verifies (open steps are non-fatal). EDIT THAT FILE
		for phase (b): add an inline tactic to each `?` step. Then run translate/mizar/prove
		on the SAME <math>/mizar/<article>.ru. (Output is always <math>/mizar/<article>.ru —
		alongside the miz_set foundation — so dependents' `import mizar/<article>` resolves.)

		Requires <math>/mizar/miz_set.ru (regenerable via translate/mizar/regen_foundation)
		and the analyzed MML. To do translate + prove + verify in one launch, use
		translate/mizar/pipeline.
	}
	@defarg article
	@category translate

	@arg math    { math root holding mizar/miz_set.ru and MML/mml (e.g. $RUSSELL_MATH) }
	@arg article { Mizar article name, e.g. xboole_1 — also the generated module/file name }
	@arg module  { DEPRECATED/ignored — the output is always <article>.ru @defval  }
	@arg cl      { 1 = class-loci experimental representation (mizar-to-ru class-loci) @defval 0 }
	@arg facts   { 1 = insert the checker's instantiated facts as intermediate open steps (mizar-to-ru facts) @defval 0 }
	@arg emit    { 1 = close by-steps deterministically (membership unfolds + G3cp->Hilbert certificate) @defval 0 }
*/

mdir  := (math + "/MML/mml");
found := (math + "/mizar/miz_set.ru");
outd  := (math + "/mizar");
// The generated module is a NAME, not a path: ru-root (=outd) supplies the directory, so the source's
// file is pathCombine(ru-root, mod + ".ru"). (Passing an absolute path here doubled it against ru-root.)
// The file MUST be named after the article so dependents' `import mizar/<article>` resolves — hence mod
// = article. (The `module` arg is kept for backward compat but the output is always <article>.ru.)
mod   := article;

// The math root is an import-root, so the article's `mizar/<name>` dependency imports resolve and
// the dependency articles get the same `mizar/<name>` self-id the imports reference. `mizar-to-ru`
// auto-loads the already-translated dependency `.ru` files (alongside miz_set) so the cited theorems
// come from `import`, not re-inlined axioms — so translate articles in dependency order.
conf-set ru-root=$outd;
conf-set import-roots=$math;
read-ru file=$found;
mizar-to-ru article=$article dir=$mdir foundation=miz_set module=$mod proofs=1 class-loci=$cl facts=$facts emit=$emit;
verify;
	print ("phase (a) verify (open ok): " + verify.success);
write-ru target=$mod;
	print ("phase (a) written: " + outd + "/" + mod + ".ru");
