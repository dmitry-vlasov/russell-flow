/**
	@help {
		PHASE (a): translate a Mizar analyzed article into an A-map Russell skeleton.

		  russellj no-server=1 mem=12g translate/mizar_amap math=$RUSSELL_MATH article=xboole_1 module=xb1

		Reads the miz_set (A-map class-layer) foundation + the article's analyzed XML
		(<math>/MML/mml/<article>.xml/.atr/.eth), maps the set-theoretic core onto
		set.mm's class layer, and writes <out>/<module>.ru — every by-gap an OPEN `?`
		proof step. The result verifies (open steps are non-fatal). This is the input
		to phase (b): adding an inline tactic to each `?` step.

		Requires <math>/set/miz_set.ru (regenerable via setmm2miz) and the analyzed MML.
	}
	@defarg article
	@category translate

	@arg math    { math root holding set/miz_set.ru and MML/mml (e.g. $RUSSELL_MATH) }
	@arg article { Mizar article name, e.g. xboole_1 }
	@arg module  { module name for the generated .ru @defval the article name }
	@arg out     { output directory @defval <math>/set }
*/

mdir  := (math + "/MML/mml");
found := (math + "/set/miz_set.ru");
outd  := (math + "/set");

conf-set ru-root=$outd;
read-ru file=$found;
mizar-to-ru article=$article dir=$mdir foundation=miz_set module=$module proofs=1;
verify;
	print ("phase (a) verify (open ok): " + verify.success);
write-ru target=$module;
	print ("phase (a) written: " + outd + "/" + module + ".ru");
