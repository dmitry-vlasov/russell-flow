/**
	@help {
		Regenerate the A-map foundation math/mizar/miz_set.ru from the set.mm library.

		  cd ~/dev/math/set && russellj no-server=1 mem=12g translate/regen_miz_set math=$RUSSELL_MATH

		MUST be run from math/set/ — setmm2miz resolves `set_root` via the process CWD
		(not ru-root), so it needs to start where set_root.mm lives. (Do NOT quote the
		`keep` value: the .rus arg layer keeps literal quotes, which would make the
		fragment filter match nothing → 0 assertions.)

		Loads the set.mm Russell library (math/set/set_root.mm), translates the kept
		fragment (the FOL calculus + the ZF "start with Extensionality" class layer:
		cun/cin/cdif/c0/csn + elun/eldif/ssel/sstr2/… — the lemmas the A-map needs)
		WITHOUT collapsing class→set (collapse=0 = native wff/setvar/class), verifies,
		and writes math/mizar/miz_set.ru (~5133 assertions).

		`out-dir` on setmm2miz does NOT write for format=file — a write-ru step is
		required, with ru-root pointed at math/mizar (NOT math/set, which would pollute
		the set.mm library).
	}
	@defarg math
	@category translate

	@arg math { math root holding set/set_root.mm (e.g. $RUSSELL_MATH) }
*/

src := (math + "/set");
out := (math + "/mizar");

// set_root.mm is found relative to ru-root, so point it at math/set first.
conf-set ru-root=$src;
setmm2miz module=set_root keep=CLASSICAL_FIRST-ORDER_LOGIC_WITH_EQUALITY,ZF_(ZERMELO-FRAENKEL)_SET_THEORY/ZF_Set_Theory_-_start_with_the_Axiom_of_Extensionality collapse=0 out=miz_set format=file;
verify;
	print ("regen verify: " + verify.success);

// write ONLY the new foundation, into math/mizar.
conf-set ru-root=$out;
write-ru target=miz_set;
	print ("regen written: " + out + "/miz_set.ru");
