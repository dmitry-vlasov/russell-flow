/**
	@help {
		Per-step prove an A-map article: close each open `?` proof step with a tactic
		and write the completed proofs back into the source .ru so you can read them.

		  russellj no-server=1 mem=12g translate/prove_steps math=$RUSSELL_MATH

		Reads the miz_set foundation + the article, runs `prove steps=1` over every
		theorem in the article's cov.json, writes the closed proofs back to disk, then
		re-verifies. Theorems whose steps don't all close stay OPEN (`?`) — that is not
		an error. The source .ru is regenerable (translate/mizar), so writing is safe.

		Tunables: tactic=<dsl> (default prop), lim=<per-step time> (default 2s).
	}
	@defarg math
	@category translate

	@arg math   { math root holding mizar/miz_set.ru, mizar/xb1.ru, mizar/cov.json (e.g. $RUSSELL_MATH) }
	@arg tactic { tactic DSL expression run on each step @defval prop }
	@arg lim    { per-step wall-clock limit @defval 2s }
*/

found := (math + "/mizar/miz_set.ru");
art   := (math + "/mizar/xb1.ru");
cov   := (math + "/mizar/cov.json");

read-ru file=$found;
read-ru file=$art;

// steps=1 = prove each `?` gap (hyps + prior steps |- step) and install it as a lemma step.
prove target=file:$cov tactic=$tactic steps=1 time-limit=$lim;

// persist the closed proofs back into the source files (foundation is unchanged).
write-ru target=all;
	print "written proofs back to mizar/xb1.ru";

// re-verify what was just written (a clean round-trip = the proofs are sound).
verify;
	print ("verify: " + verify.success);
