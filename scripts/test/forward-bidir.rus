/**
	@help {
		CI gate for the bidirectional forward engine. Three checks:
		  1. test/forward-prove (strict): every forward-derived fact's engine-built
		     proof VERIFIES against the premises — deterministic.
		  2. test/forward-acyclic (strict): the forward front is an acyclic,
		     premise-grounded DAG and ruJoinAcyclic accepts/rejects correctly —
		     deterministic.
		  3. test/forward-search (strict): with a bounded backward BFS, forward-ON
		     reproves a NET of >= min-gain theorems forward-OFF could not (robust to
		     batch-vs-alone nondeterminism).
		Any failure crashes the run. Run from ~/dev/math.
	}
	@defarg afile
	@category test

	@arg afile { @defval set-10000  input dataset directory name }
*/

conf-set verb=1;
conf-load dir=./$afile;

read-ru;
	print ("ru read: " + read-ru.size + " files in " + time2s(read-ru.time));

print "==== forward-prove (every fact verifies) ====";
test/forward-prove target=syl    depth=3 strict-fail=1;
test/forward-prove target=mpd    depth=3 strict-fail=1;
test/forward-prove target=imim2i depth=3 strict-fail=1;
test/forward-prove target=a1d    depth=3 strict-fail=1;

print "==== forward-acyclic (acyclic + premise-grounded) ====";
test/forward-acyclic target=syl    depth=3 strict-fail=1;
test/forward-acyclic target=mpd    depth=3 strict-fail=1;
test/forward-acyclic target=imim2i depth=3 strict-fail=1;

print "==== forward-search (net reprove gain over backward-only) ====";
test/forward-search target=stride-30 fs-depth=2 min-gain=5
	max-depth=5 max-size=4096 time-ms=20000 strict-fail=1;

print "######## bidirectional forward tests PASSED ########";
