/**
	@help {
		Bidirectional-search cross-check: drive the dynamic forward front
		(ruExpandForward) and the static forward closure (ruBuildForwardClosure)
		from one theorem's premises and assert they derive the same fact set.
	}
	@defarg afile
	@category prover

	@arg afile { @defval set-10000  input Russell dataset directory name }
	@arg target { Theorem to take premises from. @defval syl }
	@arg depth { Forward depth to compare. @defval 2 }
	@arg dump { 1 = print symmetric-difference expressions. @defval 0 }
*/

conf-set verb=1;
conf-load dir=./$afile;

read-ru;
	print ("ru read: " + read-ru.size + " files in " + time2s(read-ru.time));

test/forward target=$target depth=$depth dump=$dump;
