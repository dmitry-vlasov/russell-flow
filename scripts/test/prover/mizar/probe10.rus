/**
	@help {
		Ground-fill miniature: does the forward wave compose two GROUND facts
		(trigger x fill), or do fills only ever find schematic lemma-facts?
		  russellj no-server=1 test/prover/mizar/probe10
	}
	@category test

	@arg math { math root }
	@arg tl   { time limit @defval 8s }
	@arg vb   { verbosity @defval 1 }
	@arg tac  { tactic @defval scoped(syl, ordered(loop(forward, 8))) }
*/

found := (math + "/rus-test/fill_test.ru");

conf-set import-roots=$math;
conf-set verb=$vb;
read-ru file=$found;

prove target=fill_test5 steps=1 tactic="scoped(el-scope, instantiate(assume-neg(seq(limited(bfs, size=256, depth=3, batch=8), ordered(loop(forward, 24))))))" relevance-depth=0 exclude-disjointed=0 time-limit=$tl max-depth=8 max-size=65536 forward-closure-depth=0;
verify target=fill_test5;
print ("PROBE10 fill_test5 proved=" + prove.proved-count + " verify=" + verify.success);
