/**
	@help {
		Ground-fill miniature: does the forward wave compose two GROUND facts
		(trigger x fill), or do fills only ever find schematic lemma-facts?
		  russellj no-server=1 test/prover/mizar/probe10
	}
	@category test

	@arg math { math root }
	@arg tl   { time limit @defval 8s }
	@arg vb   { verbosity @defval 1 }
	@arg tac  { tactic @defval scoped(syl, ordered(loop(forward, 8))) }
*/

found := (math + "/rus-test/cong_test.ru");

conf-set import-roots=$math;
conf-set verb=$vb;
read-ru file=$found;

prove target=cong10 steps=1 tactic="scoped(eqtri, eqcomi, difundi, inss1, inss2, instantiate(ordered(loop(forward, 16))))" relevance-depth=0 exclude-disjointed=0 time-limit=$tl max-depth=8 max-size=65536 forward-closure-depth=0;
verify target=cong10;
print ("PROBE10 cong10 proved=" + prove.proved-count + " verify=" + verify.success);
