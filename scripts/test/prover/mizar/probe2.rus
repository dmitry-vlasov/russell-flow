/**
	@help {
		Single-theorem probe of the SLICED pipeline composition (compositions with
		parens cannot be passed via CLI - this script holds it literally).
		  russellj no-server=1 test/prover/mizar/probe2 target=t91_xboole_1
	}
	@defarg target
	@category test

	@arg target { theorem name }
	@arg math   { math root }
	@arg tl     { time limit @defval 8s }
*/

found := (math + "/mizar/miz_set.ru");
art   := (math + "/mizar/xboole_1.ru");

conf-set import-roots=$math;
read-ru file=$found;
read-ru file=$art;

prove target=$target steps=1 tactic="or-else(limited(def-close-checker, time=3500), limited(checker-mizar, time=2500), checker-eq)" relevance-depth=0 exclude-disjointed=0 time-limit=$tl max-depth=8 max-size=65536 forward-closure-depth=0;
verify target=$target;
print ("PROBE2 " + target + " proved=" + prove.proved-count + " verify=" + verify.success);
