/**
	@help {
		PHASE 1 of the Mizar-solver plan (mizar-tactic-plan): the REFUTATION FRAME,
		end-to-end, on a MINIMAL hand-crafted theorem (<math>/rus-test/frame_test.ru:
		premises ps, ¬ps; goal ph).

		What it validates, mechanically (see prover-soundness-invariants):
		  - assume-neg seeds the ¬G deduction facts (¬ph→¬ph via id, ¬ph→ps and
		    ¬ph→¬ps via a1i) into the forward front;
		  - the wave clashes them: pm2.65i(¬ph→ps, ¬ph→¬ps) → ¬¬ph — DISCHARGING
		    the ¬G antecedent — then notnotri → ph;
		  - the ROOT JOIN (ruReverseJoin, forward.flow) completes the proof: the
		    derived fact MATCHES the root statement verbatim (invariant I2).

		Differential, orcoms-pattern:
		  POSITIVE: scoped({pm2.65i, notnotri}, assume-neg(loop(forward, 4))) proves it.
		  CONTROL:  the same scope + wave WITHOUT the frame must FAIL — the raw
		            premises ps, ¬ps trigger nothing (neither is rule-headed →),
		            so the frame, not the scope/wave, is what closes the theorem.
		Plus verify: the installed proof must pass the kernel.

		  russellj no-server=1 test/prover/mizar/01_refute_frame afile=set-10000

		Run from the math dir (feedback_run_from_math), one instance at a time.
		NOTE (scoped gotcha, dsl.flow): with MULTIPLE positional names, each is an
		ASSERTION name — named scopes like refute-scope are NOT expanded in a list.
	}
	@defarg afile
	@category test

	@arg afile { input Russell dataset directory name @defval set-10000 }
*/

conf-set verb=1;
conf-load dir=./$afile;

read-ru;
	print ("read-ru: " + read-ru.size + " files");
	assert (read-ru.size > 0);

read-ru file=rus-test/frame_test.ru;

// ---- CONTROL first (prove installs proofs in memory — run the must-fail before
// the must-succeed, so a positive result cannot mask the control) ---------------
prove target=frame_test steps=1 time-limit=30s
	tactic="scoped(pm2.65i, notnotri, loop(forward, 4))";
	print ("no-frame frame_test: proved=" + prove.proved-count + " (must be 0)");
	assert (prove.proved-count == 0);

// ---- POSITIVE: the frame closes it -------------------------------------------
prove target=frame_test steps=1 time-limit=30s
	tactic="scoped(pm2.65i, notnotri, assume-neg(loop(forward, 4)))";
	print ("refute-frame frame_test: proved=" + prove.proved-count);
	assert (prove.proved-count == 1);

// Soundness: the installed proof must verify (I1-I3 checked by the kernel).
verify target=frame_test;
	print ("verify frame_test: " + verify.success);
	assert (verify.success);

print "==== 01_refute_frame PASSED ====";
