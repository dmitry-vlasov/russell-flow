/**
	@help {
		THE GENERAL-PATH METRIC. Run the mizar pipeline with the hand-written literal-closer
		battery DISABLED (no-literal-closers=1), so the count reflects ONLY the general
		machinery: refutation frame, forward saturation, backward bfs, unfold/setness tables,
		congruence closure, Hilbert certificate emitter.

		  russellj no-server=1 test/prover/mizar/general_only article=zfmisc_1

		This is the number that must go UP as the general Mizar decision procedure is built,
		while the line count of src/ru/prover/tactics/literal_closers.flow goes DOWN. The
		full-stack count (off=0) hides the gap: it is carried largely by the channels.

		Baseline (2026-07-12): tarski 3/3, xboole_0 5/8, xboole_1 111/116, enumset1 81/87,
		zfmisc_1 81/140 = 281/354 general-only, versus 340/354 full-stack.
	}
	@defarg article
	@category translate
	@arg article { Mizar article name }
	@arg math    { math root (auto-supplied from $RUSSELL_MATH) }
	@arg off     { 1 = disable the hand-written literal closers @defval 1 }
*/

conf-set no-literal-closers=$off;
translate/mizar/pipeline article=$article math=$math v=1;
