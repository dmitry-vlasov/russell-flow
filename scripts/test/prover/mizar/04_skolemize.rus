/**
	@help {
		PHASE 4 of the Mizar-solver plan (mizar-tactic-plan): SKOLEMIZATION as a
		lemma scope (`exists-scope` = {sp, exlimiv, eximi} + composers — data, not
		a new atom, and ZERO engine change: see the mizar-decision-gap memory).
		On-engine skolemization: the "Skolem constant" is the free setvar exposed
		by sp (∀-elim); exlimiv's disjointed() side-condition discharges it soundly.
		The eigenvariable DV rides ordinary assertion application (ruCheckDisjs in
		ruAddProof) and the final verify checks it end-to-end — this test IS the
		"proofs carry eigenvar DV" validation.

		Corpus: <math>/rus-test/skolem_test.ru — skolem1 (one witness) and skolem2
		(TWO sequential eigenvariables x, y — the class the old single-witness
		refutation decider could not touch). No assume-neg here: the goals close
		directly forward, so the ONE variable of this phase is the quantifier
		lemma scope (the frame is P1's, already proven orthogonal).

		Differential:
		  CONTROL:  composers only {ax-mp, syl, mpd} — quantified premises never
		            open; must FAIL both.
		  POSITIVE: + {sp, exlimiv, eximi} — must close both and VERIFY (verify
		            failing would mean the eigenvar DV was dropped en route).

		  russellj no-server=1 test/prover/mizar/04_skolemize afile=set-20000

		Run from the math dir, one instance at a time.
	}
	@defarg afile
	@category test

	@arg afile { input Russell dataset directory name @defval set-20000 }
*/

conf-set verb=1;
conf-load dir=./$afile;

read-ru;
	print ("read-ru: " + read-ru.size + " files");
	assert (read-ru.size > 0);

read-ru file=rus-test/skolem_test.ru;

// ---- CONTROL first: composers only — quantifiers never open, must fail --------
prove target=skolem1 steps=1 time-limit=10s
	tactic="scoped(ax-mp, syl, mpd, ordered(loop(forward, 16)))";
	print ("no-exists skolem1: proved=" + prove.proved-count + " (must be 0)");
	assert (prove.proved-count == 0);
prove target=skolem2 steps=1 time-limit=10s
	tactic="scoped(ax-mp, syl, mpd, ordered(loop(forward, 16)))";
	print ("no-exists skolem2: proved=" + prove.proved-count + " (must be 0)");
	assert (prove.proved-count == 0);

// ---- POSITIVE: + the exists scope ----------------------------------------------
prove target=skolem1 steps=1 time-limit=10s
	tactic="scoped(sp, exlimiv, eximi, ax-mp, syl, mpd, ordered(loop(forward, 16)))";
	print ("exists skolem1: proved=" + prove.proved-count);
	assert (prove.proved-count == 1);
prove target=skolem2 steps=1 time-limit=10s
	tactic="scoped(sp, exlimiv, eximi, ax-mp, syl, mpd, ordered(loop(forward, 16)))";
	print ("exists skolem2: proved=" + prove.proved-count);
	assert (prove.proved-count == 1);

// Soundness: the installed proofs must verify — including the exlimiv
// eigenvariable disjointed() conditions (invariants I1-I3 by the kernel).
verify target=skolem1;
	assert (verify.success);
verify target=skolem2;
	assert (verify.success);
	print ("verify skolem1+skolem2: " + verify.success);

print "==== 04_skolemize PASSED ====";
