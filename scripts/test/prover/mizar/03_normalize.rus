/**
	@help {
		PHASE 3 of the Mizar-solver plan (mizar-tactic-plan): NORMALIZATION — the
		forward NNF of the negated goal, Mizar's PreCheck step, as a lemma SCOPE
		(data, not a new atom): 0-hyp decomposition facts (simplim/conax1 for
		¬(a→b), simpl/simpr for a∧b, pm2.45/pm2.46 for ¬(a∨b), notnotr for ¬¬a)
		composed under the ¬G antecedent by syl/mpd. Normalization comes AFTER the
		pivot: the frame seeds ¬G raw, these lemmas decompose it in-wave.

		Corpus: <math>/rus-test/norm_test.ru — two 0-premise goals (Clavius; a
		nested ∧/→ one). Under assume-neg the only seed is ¬G→¬G, so closing them
		REQUIRES the decomposition; and neither statement equals a scope lemma, so
		the seeded 0-hyp facts cannot root-join directly.

		Differential (one variable: the scope — plain FIFO wave in both arms):
		  CONTROL:  frame + clash lemmas only (pm2.65i, notnotri) (the P1 scope) —
		            must FAIL both goals: ¬G never decomposes.
		  POSITIVE: + normalize lemmas (syl, mpd, notnotr, simplim, conax1,
		            simpl, simpr, pm2.45, pm2.46) — must close both and VERIFY.

		  russellj no-server=1 test/prover/mizar/03_normalize afile=set-10000

		Run from the math dir, one instance at a time.
	}
	@defarg afile
	@category test

	@arg afile { input Russell dataset directory name @defval set-10000 }
*/

conf-set verb=1;
conf-load dir=./$afile;

read-ru;
	print ("read-ru: " + read-ru.size + " files");
	assert (read-ru.size > 0);

read-ru file=rus-test/norm_test.ru;

// ---- CONTROL first: frame + clash only — ¬G never decomposes, must fail -------
prove target=norm1 steps=1 time-limit=10s
	tactic="scoped(pm2.65i, notnotri, assume-neg(loop(forward, 16)))";
	print ("no-normalize norm1: proved=" + prove.proved-count + " (must be 0)");
	assert (prove.proved-count == 0);
prove target=norm2 steps=1 time-limit=10s
	tactic="scoped(pm2.65i, notnotri, assume-neg(loop(forward, 16)))";
	print ("no-normalize norm2: proved=" + prove.proved-count + " (must be 0)");
	assert (prove.proved-count == 0);

// ---- POSITIVE: + the normalize scope -------------------------------------------
prove target=norm1 steps=1 time-limit=10s
	tactic="scoped(syl, mpd, notnotr, simplim, conax1, simpl, simpr, pm2.45, pm2.46, pm2.65i, notnotri, assume-neg(ordered(loop(forward, 16))))";
	print ("normalize norm1: proved=" + prove.proved-count);
	assert (prove.proved-count == 1);
prove target=norm2 steps=1 time-limit=10s
	tactic="scoped(syl, mpd, notnotr, simplim, conax1, simpl, simpr, pm2.45, pm2.46, pm2.65i, notnotri, assume-neg(ordered(loop(forward, 16))))";
	print ("normalize norm2: proved=" + prove.proved-count);
	assert (prove.proved-count == 1);

verify target=norm1;
	assert (verify.success);
verify target=norm2;
	assert (verify.success);
	print ("verify norm1+norm2: " + verify.success);

print "==== 03_normalize PASSED ====";
