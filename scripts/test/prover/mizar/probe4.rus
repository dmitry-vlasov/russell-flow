/**
	@help {
		Single-theorem probe of the SLICED pipeline composition (compositions with
		parens cannot be passed via CLI - this script holds it literally).
		  russellj no-server=1 test/prover/mizar/probe2 target=t1_xboole_1
	}
	@defarg target
	@category test

	@arg target { theorem name }
	@arg math   { math root }
	@arg tl     { time limit @defval 8s }
	@arg vb     { verbosity @defval 1 }
*/

found := (math + "/mizar/miz_set.ru");
art   := (math + "/mizar/xboole_1.ru");

conf-set import-roots=$math;
conf-set verb=$vb;
read-ru file=$found;
read-ru file=(math + "/mizar/miz_aux.ru");
read-ru file=$art;

prove target=$target steps=1 tactic="or-else(limited(def-close-checker, time=4500), limited(checker-mizar, time=1500), limited(checker-eq, time=1000), checker-el)" relevance-depth=0 exclude-disjointed=0 time-limit=$tl max-depth=8 max-size=65536 forward-closure-depth=0;
verify target=$target;
print ("PROBE4 " + target + " proved=" + prove.proved-count + " verify=" + verify.success);
