/**
	@help {
		Stage-isolation probe for checker-el: def-close first, checker-el second,
		NO middle wave stages. Compares against probe4 (full pipeline) to separate
		budget starvation from wave-stage tree pollution.
		  russellj no-server=1 test/prover/mizar/probe7 target=t44_xboole_1
	}
	@defarg target
	@category test

	@arg target { theorem name }
	@arg math   { math root }
	@arg tl     { time limit @defval 8s }
	@arg vb     { verbosity @defval 1 }
*/

found := (math + "/mizar/miz_set.ru");
art   := (math + "/mizar/xboole_1.ru");

conf-set import-roots=$math;
conf-set verb=$vb;
read-ru file=$found;
read-ru file=$art;

prove target=$target steps=1 tactic="or-else(limited(def-close-checker, time=4500), checker-el)" relevance-depth=0 exclude-disjointed=0 time-limit=$tl max-depth=8 max-size=65536 forward-closure-depth=0;
verify target=$target;
print ("PROBE7 " + target + " proved=" + prove.proved-count + " verify=" + verify.success);
