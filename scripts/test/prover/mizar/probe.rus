/**
	@help {
		Single-theorem probe: run one tactic on one xboole_1 theorem standalone.
		  russellj no-server=1 test/prover/mizar/probe target=t100_xboole_1 tac=checker-eq
	}
	@defarg target
	@category test

	@arg target { theorem name }
	@arg math   { math root }
	@arg tac    { tactic name @defval checker-eq }
	@arg tl     { time limit @defval 8s }
	@arg vb     { verbosity @defval 1 }
*/

found := (math + "/mizar/miz_set.ru");
art   := (math + "/mizar/xboole_1.ru");

conf-set import-roots=$math;
conf-set verb=$vb;
read-ru file=$found;
read-ru file=$art;

prove target=$target steps=1 tactic=$tac relevance-depth=0 exclude-disjointed=0 time-limit=$tl max-depth=8 max-size=65536 forward-closure-depth=0;
verify target=$target;
print ("PROBE " + target + " tac=" + tac + " proved=" + prove.proved-count + " verify=" + verify.success);
