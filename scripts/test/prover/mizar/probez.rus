/**
	@help {
		Single-theorem probe of the SLICED pipeline composition against the
		zfmisc_1 article (the zfmisc_1 twin of probe2.rus).
		  russellj no-server=1 test/prover/mizar/probe0 target=t4_zfmisc_1
	}
	@defarg target
	@category test

	@arg target { theorem name }
	@arg math   { math root }
	@arg tl     { time limit @defval 8s }
	@arg vb     { verbosity @defval 1 }
*/

found := (math + "/mizar/miz_set.ru");
art   := (math + "/mizar/zfmisc_1.ru");
aux   := (math + "/mizar/miz_aux.ru");

conf-set import-roots=$math;
conf-set verb=$vb;
read-ru file=$found;
read-ru file=$aux;
read-ru file=$art;

prove target=$target steps=1 tactic="or-else(limited(def-close-checker, time=3500), limited(checker-mizar, time=2500), checker-eq)" relevance-depth=0 exclude-disjointed=0 time-limit=$tl max-depth=8 max-size=65536 forward-closure-depth=0;
verify target=$target;
print ("PROBEZ " + target + " proved=" + prove.proved-count + " verify=" + verify.success);
