/**
	@help {
		Pipeline probe that PRINTS the theorem after proving — the remaining `?`
		steps identify exactly which gap-steps stay open.
		  russellj no-server=1 test/prover/mizar/probe9 target=t53_xboole_1
	}
	@defarg target
	@category test

	@arg target { theorem name }
	@arg math   { math root }
	@arg tl     { time limit @defval 8s }
	@arg vb     { verbosity @defval 1 }
*/

found := (math + "/mizar/miz_set.ru");
art   := (math + "/mizar/zfmisc_1.ru");

conf-set import-roots=$math;
conf-set verb=$vb;
read-ru file=$found;
read-ru file=$art;

prove target=$target steps=1 tactic="or-else(limited(def-close-checker, time=4500), limited(checker-mizar, time=1500), limited(checker-eq, time=1000), checker-el)" relevance-depth=0 exclude-disjointed=0 time-limit=$tl max-depth=8 max-size=65536 forward-closure-depth=0;
print ("PROBE9Z " + target + " proved=" + prove.proved-count);
info-show name=$target;
print info-show.decl;
