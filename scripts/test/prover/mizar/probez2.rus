/**
	@help {
		zfmisc_1 probe against the FULL dependency context (mimics the pipeline's
		in-memory math exactly: all deps loaded).
		  russellj no-server=1 test/prover/mizar/probez2 target=t3_zfmisc_1
	}
	@defarg target
	@category test
	@arg target { theorem name }
	@arg math   { math root }
	@arg tl     { time limit @defval 8s }
	@arg vb     { verbosity @defval 1 }
*/
conf-set import-roots=$math;
conf-set verb=$vb;
read-ru file=$math/mizar/zfmisc_1.ru;
prove target=$target steps=1 tactic="or-else(limited(def-close-checker, time=4500), limited(checker-mizar, time=1500), limited(checker-eq, time=1000), checker-el)" relevance-depth=0 exclude-disjointed=0 time-limit=$tl max-depth=8 max-size=65536 forward-closure-depth=0;
verify target=$target;
print ("PROBEZ2 " + target + " proved=" + prove.proved-count + " verify=" + verify.success);
