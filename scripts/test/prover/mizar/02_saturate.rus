/**
	@help {
		PHASE 2 of the Mizar-solver plan (mizar-tactic-plan): the `ordered` steering
		primitive — the ONE new tactic-language atom of the whole plan.

		Corpus: <math>/rus-test/nn_ladder.ru — a ¬¬-stripping LADDER: the goal ph
		needs 8 successive notnotri applications (16 ¬'s, two per wave). Each rung's
		TRIGGER is the fact derived by the previous rung, so the ladder takes exactly
		8 forward WAVES — it cannot cascade inside one wave (equality chains can:
		the live-index fill side closes any all-seeds-present chain in wave 1, which
		is why a chain corpus CANNOT differentiate ordering). The scope adds three
		term-GROWING junk lemmas (notnoti / orci / olci): every fact spawns three
		strictly larger facts per wave — the junk front grows ~3^wave while the
		ladder core is ONE shrinking fact per wave. The congruence explosion in
		miniature: Mizar's Equalizer tames it with union-find; we tame it with
		`ordered` — BEST-FIRST waves (expand only the ≺-minimal size class, defer
		the rest), an L2 SELECTION policy: facts are DEFERRED, never discarded
		(prover-completeness-invariant).

		Differential (the binding constraint is TIME, matching the real Mizar
		concern; the fact cap is huge so the count bound never masks the ordering):
		  CONTROL:  FIFO waves, 3s — expands the whole 3^w junk front each wave,
		            dies around wave 6 of 8; must FAIL.
		  POSITIVE: ordered(...), same scope, same budgets — one rung per wave,
		            index stays ~linear; must SUCCEED and VERIFY.
		Measured shape at pinning (2026-07-08): FIFO fronts 4,12,36,108,324,972 →
		timeout; ordered fronts expand 1/wave, index 26 at close.

		  russellj no-server=1 test/prover/mizar/02_saturate afile=set-10000

		Run from the math dir, one instance at a time.
	}
	@defarg afile
	@category test

	@arg afile { input Russell dataset directory name @defval set-10000 }
*/

conf-set verb=1;
conf-load dir=./$afile;

read-ru;
	print ("read-ru: " + read-ru.size + " files");
	assert (read-ru.size > 0);

read-ru file=rus-test/nn_ladder.ru;

// ---- CONTROL first: FIFO waves under the tight TIME budget drown in junk ------
prove target=nn_ladder steps=1 time-limit=3s forward-search-size=131072
	tactic="scoped(notnotri, notnoti, orci, olci, loop(forward, 12))";
	print ("fifo nn_ladder: proved=" + prove.proved-count + " (must be 0)");
	assert (prove.proved-count == 0);

// ---- POSITIVE: ordered (best-first) steering, same scope, same budgets --------
prove target=nn_ladder steps=1 time-limit=3s forward-search-size=131072
	tactic="scoped(notnotri, notnoti, orci, olci, ordered(loop(forward, 12)))";
	print ("ordered nn_ladder: proved=" + prove.proved-count);
	assert (prove.proved-count == 1);

verify target=nn_ladder;
	print ("verify nn_ladder: " + verify.success);
	assert (verify.success);

print "==== 02_saturate PASSED ====";
