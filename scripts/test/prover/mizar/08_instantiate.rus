/**
	@help {
		FORALL-INSTANTIATE (the Mizar Unifier increment, mizar-tactic-plan):
		the `instantiate` frame seeds each ∀-premise instantiated at candidate
		terms (class-typed subterms of goal/premises) via hand-constructed spcv
		chains (ruSeedInstantiateFront, core/forward.flow) — verified by the
		kernel like any proof.

		Corpus: <math>/rus-test/inst_test.ru — one ∀-fact, one trigger fact at
		the witness term (x7∪x9), goal = the instance's consequent. Closing it
		needs instantiating the ∀-fact AT A COMPOUND TERM — the capability the
		47 open xboole_1 theorems (t14 step 2) are blocked on.

		Design under test (see the mizar-plan-progress memory):
		  - vocabulary is DATA, all in miz_set: spcv, spv, vtoclg (instantiators),
		    vex + unex (the A∈_V feed), sseq1, sseq2, eleq1, eleq2 + notbid,
		    anbi12d, imbi12d (the congruence chain for the (x=A)→(φ↔ψ) hyp);
		  - the TERM CHOICE and chain assembly need GUIDING — the eq-rewrite
		    pattern (build the guide off-engine, `replay` reconstructs it through
		    the engine, law-abiding) extended to ∀-premises; a blind wave cannot
		    do it (schematic congruence facts starve under ground-first).

		NOTE: never write a star-slash sequence inside this help — it terminates
		the comment block (that bug shipped in this file's first version).

		  russellj no-server=1 test/prover/mizar/08_instantiate

		Run from the math dir, one instance at a time.
	}
	@arg math { math root holding mizar/miz_set.ru }
	@category test
*/

found := (math + "/mizar/miz_set.ru");
conf-set import-roots=$math;
read-ru file=$found;
read-ru file=rus-test/inst_test.ru;

// ---- CONTROL: checker-mizar WITHOUT the instantiate frame — must fail ---------
prove target=inst_test steps=1 time-limit=10s
	tactic="scoped(normalize-scope, exists-scope, cluster-scope, clash-scope, assume-neg(ordered(loop(forward, 24))))";
	print ("no-inst inst_test: proved=" + prove.proved-count + " (must be 0)");
	assert (prove.proved-count == 0);

// ---- POSITIVE: checker-mizar (carries instantiate) — must close + verify ------
prove target=inst_test steps=1 time-limit=10s tactic=checker-mizar;
	print ("forall-inst inst_test: proved=" + prove.proved-count);
	assert (prove.proved-count == 1);

verify target=inst_test;
	assert (verify.success);

// ---- inst_test2: t14-step-2 in miniature — the FULL pipeline ------------------
// instantiate (∀-premise at the goal's ∪-term) → imnani → ax-mp → ¬¬goal →
// the BIDIRECTIONAL MEET (backward notnotri subgoal registered by the bounded
// bfs; the forward-derived ¬¬goal joins AT CREATION via ruReverseJoin).
prove target=inst_test2 steps=1 time-limit=20s forward-search-size=4096
	tactic="scoped(normalize-scope, clash-scope, ax-mp, instantiate(seq(limited(bfs, size=256, depth=3, batch=8), ordered(loop(forward, 64)))))";
	print ("meet inst_test2: proved=" + prove.proved-count);
	assert (prove.proved-count == 1);
verify target=inst_test2;
	assert (verify.success);

print "==== 08_instantiate PASSED ====";
