/**
	@help {
		Single-theorem probe of the curated el-scope (membership-unfold refutation)
		composition. Loads the hand-authored miz_aux.ru beside the foundation.
		  russellj no-server=1 test/prover/mizar/probe6 target=t44_xboole_1
	}
	@defarg target
	@category test

	@arg target { theorem name }
	@arg math   { math root }
	@arg tl     { time limit @defval 8s }
	@arg vb     { verbosity @defval 1 }
*/

found := (math + "/mizar/miz_set.ru");
aux   := (math + "/mizar/miz_aux.ru");
art   := (math + "/mizar/xboole_1.ru");

conf-set import-roots=$math;
conf-set verb=$vb;
read-ru file=$found;
read-ru file=$aux;
verify target=pm2.45i;
verify target=pm2.46i;
print ("AUX verify=" + verify.success);
read-ru file=$art;

prove target=$target steps=1 tactic="scoped(el-scope, instantiate(assume-neg(seq(limited(bfs, size=256, depth=3, batch=8), ordered(loop(forward, 24))))))" relevance-depth=0 exclude-disjointed=0 time-limit=$tl max-depth=8 max-size=65536 forward-closure-depth=0;
verify target=$target;
print ("PROBE6 " + target + " proved=" + prove.proved-count + " verify=" + verify.success);
