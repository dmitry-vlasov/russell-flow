/**
	@help {
		PHASE 5 of the Mizar-solver plan (mizar-tactic-plan): CLUSTER ROUNDING-UP
		as a lemma scope (`cluster-scope` = {sstri, sseli} — data, no new atom).
		The forward analog of Mizar's adjective saturation: facts propagate UP ⊆
		(transitivity; membership). Uses the 2-hyp INFERENCE forms — the theorem
		forms bundle antecedents under ∧ and are forward-dead (∧-intro never
		triggers). This is the FACT-side dual of bridge-scope's backward goal
		reductions (rel-intro).

		Corpus: <math>/rus-test/cluster_test.ru — a ⊆-chain (A⊆D from 3 links) and
		a membership rounding (D∈C from D∈A + 2 links). No assume-neg: the goals
		close directly forward; the ONE variable of this phase is the scope.

		Differential:
		  CONTROL:  composers only {ax-mp, syl, mpd} — wss/wcel facts never
		            combine; must FAIL both.
		  POSITIVE: + {sstri, sseli} — must close both and VERIFY (sseli here is the
		            1-hyp form emitting a schematic implication, so the composers
		            ride along in BOTH arms).

		  russellj no-server=1 test/prover/mizar/05_cluster afile=set-50000

		Run from the math dir, one instance at a time.
	}
	@defarg afile
	@category test

	@arg afile { input Russell dataset directory name @defval set-50000 }
*/

conf-set verb=1;
conf-load dir=./$afile;

read-ru;
	print ("read-ru: " + read-ru.size + " files");
	assert (read-ru.size > 0);

read-ru file=rus-test/cluster_test.ru;

// ---- CONTROL first: composers only — ⊆/∈ facts never combine, must fail -------
prove target=cluster1 steps=1 time-limit=10s
	tactic="scoped(ax-mp, syl, mpd, ordered(loop(forward, 16)))";
	print ("no-cluster cluster1: proved=" + prove.proved-count + " (must be 0)");
	assert (prove.proved-count == 0);
prove target=cluster2 steps=1 time-limit=10s
	tactic="scoped(ax-mp, syl, mpd, ordered(loop(forward, 16)))";
	print ("no-cluster cluster2: proved=" + prove.proved-count + " (must be 0)");
	assert (prove.proved-count == 0);

// ---- POSITIVE: the cluster scope ------------------------------------------------
prove target=cluster1 steps=1 time-limit=10s
	tactic="scoped(sstri, sseli, ax-mp, syl, mpd, ordered(loop(forward, 16)))";
	print ("cluster cluster1: proved=" + prove.proved-count);
	assert (prove.proved-count == 1);
prove target=cluster2 steps=1 time-limit=10s
	tactic="scoped(sstri, sseli, ax-mp, syl, mpd, ordered(loop(forward, 16)))";
	print ("cluster cluster2: proved=" + prove.proved-count);
	assert (prove.proved-count == 1);

verify target=cluster1;
	assert (verify.success);
verify target=cluster2;
	assert (verify.success);
	print ("verify cluster1+cluster2: " + verify.success);

print "==== 05_cluster PASSED ====";
