/**
	@help {
		PHASE 6 of the Mizar-solver plan (mizar-tactic-plan): the ASSEMBLY on a real
		article. Runs the def-close-checker pipeline EXTENDED with `checker-mizar`
		(the pure-L2 refutational composition: assume-neg + ordered ground-first
		saturation over normalize ∪ exists ∪ cluster ∪ clash) on a translated Mizar
		article, and asserts the pinned golden floor holds — the composition must
		COMPOSE (never regress the pipeline; the 70→51 ordering lesson) — and every
		installed proof verifies.

		checker-mizar is tried AFTER the install checker (same reason as
		checker-engine: a partial refinement must not preempt a whole-gap closer).

		  russellj no-server=1 mem=12g test/prover/mizar/06_mizar_xboole module=xboole_1 floor=73

		Run from the math dir, one instance at a time. Same bounded settings as
		00_baseline.rus — floors stay comparable.
	}
	@defarg module
	@category test

	@arg module { the article module under <math>/mizar/ (e.g. xboole_0, xboole_1) }
	@arg math   { math root holding mizar/miz_set.ru and the article }
	@arg tl     { per-step time limit @defval 8s }
	@arg floor  { minimum fully-proved theorems (pinned golden floor) @defval 0 }
*/

found := (math + "/mizar/miz_set.ru");
art   := (math + "/mizar/" + module + ".ru");
tgt   := ("mizar/" + module);

conf-set import-roots=$math;
read-ru file=$found;
read-ru file=$art;

prove target=$tgt steps=1 tactic="or-else(def-close-checker, checker-mizar)" relevance-depth=0 exclude-disjointed=0 time-limit=$tl max-depth=8 max-size=65536 forward-closure-depth=0;

verify target=$tgt;

print ("MIZAR_P6 module=" + module + " tl=" + tl
	+ " fully-proved=" + prove.proved-count + " floor=" + floor
	+ " verify=" + verify.success);

assert (verify.success);
assert (prove.proved-count >= floor);

print "==== 06_mizar_xboole PASSED ====";
