/**
	@help {
		PHASE 0 of the Mizar-solver plan (mizar-tactic-plan): the GOLDEN FLOOR.

		Measures how many theorems of a translated Mizar article a named tactic
		fully proves, verifies every installed proof, and asserts the count does
		not drop below the pinned floor. Every later phase of the plan (P1..P7)
		must keep this floor — a drop = a composition regression (the 70→51
		ordering lesson, see def-close-checker.tac).

		Run from the math dir (feedback_run_from_math), one instance at a time:

		  russellj no-server=1 mem=12g test/prover/mizar/00_baseline module=xboole_0 tac=def-close-checker floor=<pinned>
		  russellj no-server=1 mem=12g test/prover/mizar/00_baseline module=xboole_1 tac=def-close-checker floor=<pinned>

		NOTE: one tactic per process — `prove` installs proofs IN MEMORY, so a
		second tactic in the same session would measure an already-closed article.
		Nothing is written back to disk (no write-ru): the measurement is pure.
		`tac` must be a bare tactic NAME (CLI cannot pass parens — see
		project_script_language_gotchas); compositions get their own .tac file.
	}
	@defarg module
	@category test

	@arg module { the article module under <math>/mizar/ (e.g. xboole_0, xboole_1) }
	@arg math   { math root holding mizar/miz_set.ru and the article }
	@arg tac    { tactic NAME to measure (no parens on CLI) @defval def-close-checker }
	@arg tl     { per-step time limit @defval 8s }
	@arg floor  { minimum fully-proved theorems (pinned golden floor) @defval 0 }
*/

found := (math + "/mizar/miz_set.ru");
art   := (math + "/mizar/" + module + ".ru");
// read-from-disk source keys are IMPORT-ROOT-RELATIVE (see translate/mizar/prove.rus):
// build with string concat — an inline `mizar/$module` gets `/` mis-parsed as division.
tgt   := ("mizar/" + module);

// The article imports its dependency articles (tarski, xboole_0, …) by their
// `mizar/<name>` path relative to the math root.
conf-set import-roots=$math;
read-ru file=$found;
read-ru file=$art;

// Same bounded/scoped settings as translate/mizar/prove_gaps.rus — keep these
// STABLE across all phases so floors stay comparable.
prove target=$tgt steps=1 tactic=$tac relevance-depth=0 exclude-disjointed=0 time-limit=$tl max-depth=8 max-size=65536 forward-closure-depth=0;

// Soundness: every proof the tactic installed must verify (invariants I1-I3
// checked by the kernel, not trusted from the engine).
verify target=$tgt;

print ("MIZAR_BASELINE module=" + module + " tac=" + tac + " tl=" + tl
	+ " fully-proved=" + prove.proved-count + " floor=" + floor
	+ " verify=" + verify.success);

assert (verify.success);
assert (prove.proved-count >= floor);
