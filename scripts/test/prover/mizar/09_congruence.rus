/**
	@help {
		THE EQUALIZER (Mizar's Equate, mizar-tactic-plan equality increment):
		set-algebra equality as a composition — the `instantiate` frame seeds
		0-hyp IDENTITY schemata (wceq-headed: disjdif, difid, ...) instantiated
		at goal subterms (ruSeedIdentityFront — a one-step assertion instance,
		kernel-verified); eqtri/eqcomi/ineq*i compose the ground equalities
		in-wave; the root join closes the = goal. This targets the dominant
		open class of xboole_1 (~46/47 open theorems are set-algebra equalities).

		Corpus: <math>/rus-test/cong_test.ru — cong1 (a single disjdif instance
		root-joins the goal), cong2 (disjdif + difid + eqcomi + eqtri: a real
		Equate-style chained derivation).

		Differential:
		  CONTROL:  the same frame WITHOUT congruence-scope — must FAIL both.
		  POSITIVE: the explicit minimal lemma list (the suite convention: pin the
		            MECHANISM, not the growing scope data) — closes both,
		            VERIFIES.

		  russellj no-server=1 test/prover/mizar/09_congruence

		Run from the math dir, one instance at a time.
	}
	@arg math { math root holding mizar/miz_set.ru }
	@category test
*/

found := (math + "/mizar/miz_set.ru");
conf-set import-roots=$math;
read-ru file=$found;
read-ru file=rus-test/cong_test.ru;

// ---- CONTROL first: no congruence scope — must fail ---------------------------
prove target=cong1 steps=1 time-limit=10s
	tactic="scoped(clash-scope, ax-mp, instantiate(ordered(loop(forward, 16))))";
	print ("no-cong cong1: proved=" + prove.proved-count + " (must be 0)");
	assert (prove.proved-count == 0);
prove target=cong2 steps=1 time-limit=10s
	tactic="scoped(clash-scope, ax-mp, instantiate(ordered(loop(forward, 16))))";
	print ("no-cong cong2: proved=" + prove.proved-count + " (must be 0)");
	assert (prove.proved-count == 0);

// ---- POSITIVE: the Equalizer ---------------------------------------------------
prove target=cong1 steps=1 time-limit=10s
	tactic="scoped(eqtri, eqcomi, ineq1i, ineq2i, difin, disjdif, difid, incom, instantiate(ordered(loop(forward, 16))))";
	print ("cong cong1: proved=" + prove.proved-count);
	assert (prove.proved-count == 1);
prove target=cong2 steps=1 time-limit=10s
	tactic="scoped(eqtri, eqcomi, ineq1i, ineq2i, difin, disjdif, difid, incom, instantiate(ordered(loop(forward, 16))))";
	print ("cong cong2: proved=" + prove.proved-count);
	assert (prove.proved-count == 1);

// ---- eq-normalize: directed rewriting (lift + chain + swapped variants) -------
prove target=cong4 steps=1 time-limit=10s
	tactic="scoped(eqtri, eqcomi, ineq1i, ineq2i, difin, disjdif, difid, incom, instantiate(ordered(loop(forward, 16))))";
	print ("eqnorm cong4: proved=" + prove.proved-count);
	assert (prove.proved-count == 1);
prove target=cong5 steps=1 time-limit=10s
	tactic="scoped(eqtri, eqcomi, ineq1i, ineq2i, difin, disjdif, difid, incom, instantiate(ordered(loop(forward, 16))))";
	print ("eqnorm cong5: proved=" + prove.proved-count);
	assert (prove.proved-count == 1);
verify target=cong4;
	assert (verify.success);
verify target=cong5;
	assert (verify.success);

verify target=cong1;
	assert (verify.success);
verify target=cong2;
	assert (verify.success);
	print ("verify cong1+cong2: " + verify.success);

print "==== 09_congruence PASSED ====";
