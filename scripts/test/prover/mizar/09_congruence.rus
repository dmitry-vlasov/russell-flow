/**
	@help {
		THE EQUALIZER (Mizar's Equate, mizar-tactic-plan equality increment):
		set-algebra equality as a composition — the `instantiate` frame seeds
		0-hyp IDENTITY schemata (wceq-headed: disjdif, difid, ...) instantiated
		at goal subterms (ruSeedIdentityFront — a one-step assertion instance,
		kernel-verified); eqtri/eqcomi/ineq*i compose the ground equalities
		in-wave; the root join closes the = goal. This targets the dominant
		open class of xboole_1 (~46/47 open theorems are set-algebra equalities).

		Corpus: <math>/rus-test/cong_test.ru — cong1 (a single disjdif instance
		root-joins the goal), cong2 (disjdif + difid + eqcomi + eqtri: a real
		Equate-style chained derivation).

		Differential:
		  CONTROL:  the same frame WITHOUT congruence-scope — must FAIL both.
		  POSITIVE: the explicit minimal lemma list (the suite convention: pin the
		            MECHANISM, not the growing scope data) — closes both,
		            VERIFIES.

		  russellj no-server=1 test/prover/mizar/09_congruence

		Run from the math dir, one instance at a time.
	}
	@arg math { math root holding mizar/miz_set.ru }
	@category test
*/

found := (math + "/mizar/miz_set.ru");
conf-set import-roots=$math;
read-ru file=$found;
read-ru file=rus-test/cong_test.ru;

// ---- CONTROL first: no congruence scope — must fail ---------------------------
prove target=cong1 steps=1 time-limit=10s
	tactic="scoped(clash-scope, ax-mp, instantiate(ordered(loop(forward, 16))))";
	print ("no-cong cong1: proved=" + prove.proved-count + " (must be 0)");
	assert (prove.proved-count == 0);
prove target=cong2 steps=1 time-limit=10s
	tactic="scoped(clash-scope, ax-mp, instantiate(ordered(loop(forward, 16))))";
	print ("no-cong cong2: proved=" + prove.proved-count + " (must be 0)");
	assert (prove.proved-count == 0);

// ---- POSITIVE: the Equalizer ---------------------------------------------------
prove target=cong1 steps=1 time-limit=10s
	tactic="scoped(eqtri, eqcomi, ineq1i, ineq2i, difin, disjdif, difid, incom, instantiate(ordered(loop(forward, 16))))";
	print ("cong cong1: proved=" + prove.proved-count);
	assert (prove.proved-count == 1);
prove target=cong2 steps=1 time-limit=10s
	tactic="scoped(eqtri, eqcomi, ineq1i, ineq2i, difin, disjdif, difid, incom, instantiate(ordered(loop(forward, 16))))";
	print ("cong cong2: proved=" + prove.proved-count);
	assert (prove.proved-count == 1);

// ---- eq-normalize: directed rewriting (lift + chain + swapped variants) -------
prove target=cong4 steps=1 time-limit=10s
	tactic="scoped(eqtri, eqcomi, ineq1i, ineq2i, difin, disjdif, difid, incom, instantiate(ordered(loop(forward, 16))))";
	print ("eqnorm cong4: proved=" + prove.proved-count);
	assert (prove.proved-count == 1);
prove target=cong5 steps=1 time-limit=10s
	tactic="scoped(eqtri, eqcomi, ineq1i, ineq2i, difin, disjdif, difid, incom, instantiate(ordered(loop(forward, 16))))";
	print ("eqnorm cong5: proved=" + prove.proved-count);
	assert (prove.proved-count == 1);
verify target=cong4;
	assert (verify.success);
verify target=cong5;
	assert (verify.success);

verify target=cong1;
	assert (verify.success);
verify target=cong2;
	assert (verify.success);
	print ("verify cong1+cong2: " + verify.success);

// ---- ∀-strip + symbol closure + AC-permutation collapse (t92/t100 miniatures) --
// cong6 = t92 verbatim: strip the ∀-prefix, close the body, re-add by ax-gen;
// dfsymdif3 admitted by CLOSURE (its rhs introduces ∪ absent from the goal).
// cong7 = t100 verbatim: closure + unabs absorption + in32 regrouping the hidden
// duplicate in ((x5∩x7)∩x5) adjacent so inidm collapses it.
prove target=cong6 steps=1 time-limit=10s
	tactic="scoped(eqtri, eqcomi, ineq1i, ineq2i, uneq1i, uneq2i, difeq1i, difeq2i, incom, uncom, inidm, unidm, inass, unass, unabs, inabs, difid, difin, in0, un0, dif0, in12, in32, symdifcom, dfsymdif3, instantiate(ordered(loop(forward, 16))))";
	print ("eqnorm cong6 (forall-strip): proved=" + prove.proved-count);
	assert (prove.proved-count == 1);
prove target=cong7 steps=1 time-limit=10s
	tactic="scoped(eqtri, eqcomi, ineq1i, ineq2i, uneq1i, uneq2i, difeq1i, difeq2i, incom, uncom, inidm, unidm, inass, unass, unabs, inabs, difid, difin, in0, un0, dif0, in12, in32, symdifcom, dfsymdif3, instantiate(ordered(loop(forward, 16))))";
	print ("eqnorm cong7 (closure+AC): proved=" + prove.proved-count);
	assert (prove.proved-count == 1);
verify target=cong6;
	assert (verify.success);
verify target=cong7;
	assert (verify.success);

// ---- △-associativity via synthesized mid-swaps + global comm-fixpoint (t91) ---
// MINIMAL list: assoc+com alone — both sides must AC-converge to the same △
// arrangement (the mid-swap rules are SYNTHESIZED from the pair; the △ lift
// rides symdifeq1/2 + ax-mp by id). No eliminator needed at all.
prove target=cong8 steps=1 time-limit=10s
	tactic="scoped(eqtri, eqcomi, symdifcom, symdifass, instantiate(ordered(loop(forward, 16))))";
	print ("eqnorm cong8 (AC mid-swaps): proved=" + prove.proved-count);
	assert (prove.proved-count == 1);
// ---- rel-normalize: ⊆ goal = normalize args + 0-hyp schema + transport (t96) --
prove target=cong9 steps=1 time-limit=10s
	tactic="scoped(eqtri, eqcomi, df-symdif, ssun1, instantiate(ordered(loop(forward, 16))))";
	print ("relnorm cong9 (schema close): proved=" + prove.proved-count);
	assert (prove.proved-count == 1);
verify target=cong8;
	assert (verify.success);
verify target=cong9;
	assert (verify.success);

// ---- rel-normalize on a CONJUNCTION of ⊆: per-conjunct close + pm3.2i (t53) --
// MINIMAL list: difundi (A∖(B∪C) = (A∖B)∩(A∖C)) rewrites the shared left side
// to the ∩-form whose ONE canonical nf serves BOTH conjuncts (inss1/inss2);
// a ∖-only route (difun1+difss) cannot — the single canonical AC arrangement
// matches only one subtrahend order.
prove target=cong10 steps=1 time-limit=10s
	tactic="scoped(eqtri, eqcomi, difundi, inss1, inss2, instantiate(ordered(loop(forward, 16))))";
	print ("relnorm cong10 (conj of ⊆): proved=" + prove.proved-count);
	assert (prove.proved-count == 1);
verify target=cong10;
	assert (verify.success);

print "==== 09_congruence PASSED ====";
