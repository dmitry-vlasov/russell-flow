/**
	@help {
		Prove ONE theorem and see what the GENERAL path alone does with it (the single-theorem companion
		to general_only, which measures a whole article).

		  russellj no-server=1 test/prover/mizar/general_probe module=zfmisc_1 target=t7_zfmisc_1
		  russellj no-server=1 test/prover/mizar/general_probe module=zfmisc_1 target=t7_zfmisc_1 off=0 v=4

		RUN IT THROUGH scripts/test/prover/mizar/measure.sh --probe, NOT DIRECTLY: prove WRITES the
		completed proofs back into the article, so a probe run against the real library contaminates the
		next probe AND every later measurement of a dependent article. measure.sh hands each run a
		disposable COPY of the library as its math root.

		The article under test is regenerated from the Mizar XML on every run (phase a), so it never
		inherits a previous probe's proofs; the foundation and the dependency articles come from the
		library copy, which is what we want when looking at ONE theorem.

		`off=1` (default) disables the hand-written literal-closer battery, so what closes the theorem is
		the general machinery alone. `v=4` traces the refiner/equalizer decisions.
	}
	@defarg target
	@category test

	@arg module  { the article module, e.g. zfmisc_1 }
	@arg target  { the theorem to prove, e.g. t7_zfmisc_1 }
	@arg math    { math root (auto-supplied from $RUSSELL_MATH) }
	@arg off     { 1 = disable the hand-written literal closers (the general path); 0 = full stack @defval 1 }
	@arg tac     { tactic @defval checker-pipeline }
	@arg tl      { per-step time limit @defval 10s }
	@arg v       { verbosity @defval 1 }
*/

conf-set no-literal-closers=$off;
// (a) regenerate THIS article from the XML — never inherit a previous probe's proofs
translate/mizar/translate article=$module module=$module math=$math v=0;
// (b) prove the one theorem
translate/mizar/prove math=$math module=$module target=$target tac=$tac tl=$tl mm=0 v=$v;
