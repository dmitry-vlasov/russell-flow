/**
	@help {
		Prove ONE theorem with the hand-written literal closers optionally disabled, to see what
		the GENERAL path alone does with it (companion to general_only, which measures a whole
		article).

		  russellj no-server=1 test/prover/mizar/general_probe module=zfmisc_1 target=t7_zfmisc_1 off=1 v=4

		NOTE: the prove command WRITES the completed proofs back into the article, so repeated
		probes contaminate each other. Regenerate a pristine skeleton (translate/mizar/translate)
		and restore it before each probe.
	}
	@defarg target
	@category translate
	@arg math   { math root (auto-supplied from $RUSSELL_MATH) }
	@arg module { the article module (e.g. zfmisc_1) }
	@arg target { the theorem to prove }
	@arg off    { 1 = disable the hand-written literal closers @defval 1 }
	@arg tac    { tactic @defval checker-pipeline }
	@arg tl     { per-step time limit @defval 10s }
	@arg v      { verbosity @defval 1 }
*/

conf-set no-literal-closers=$off;
translate/mizar/prove math=$math module=$module target=$target tac=$tac tl=$tl mm=0 v=$v;
