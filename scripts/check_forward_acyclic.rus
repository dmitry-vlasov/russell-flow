/**
	@help {
		P3 bidirectional-search check: the forward front is an acyclic,
		premise-grounded DAG, and the ruJoinAcyclic join-safety predicate accepts
		a safe graft (onto the goal) and rejects a cyclic one (onto a dependency).
	}
	@defarg afile
	@category prover

	@arg afile { @defval set-10000  input Russell dataset directory name }
	@arg target { Theorem to take premises from. @defval syl }
	@arg depth { Forward depth. @defval 3 }
*/

conf-set verb=1;
conf-load dir=./$afile;

read-ru;
	print ("ru read: " + read-ru.size + " files in " + time2s(read-ru.time));

test/forward-acyclic target=$target depth=$depth;
