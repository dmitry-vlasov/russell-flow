/**
	@help {
		Reprove a sample of theorems with the dynamic, proof-carrying forward
		front (bidirectional search, P2b) ON. With forward-search-depth>0 a
		backward leaf can be closed by a forward-derived, engine-built proof,
		guarded by the acyclicity check. forward-search-depth=0 disables it (the
		engine is then byte-identical to a plain run) — use that for the additivity
		baseline and diff the reproved/not-reproved lines.

		Run from ~/dev/math.
	}
	@defarg afile
	@category prover

	@arg afile      { @defval set-10000    input math file (without extension) }
	@arg target     { @defval all          target selector: all, stride-N, a theorem id }
	@arg time_limit { @defval 60s          total wall-clock limit for the job }
	@arg fs_depth   { @defval 2            forward-search depth (0 disables the interior join) }
	@arg fs_size    { @defval 2048         max facts in the forward front }
	@arg tactic     { @defval bb           tactic: bb = limited(bfs,size=$max_size,depth=$max_depth,batch=16), or inline DSL }
	@arg max_depth  { @defval 3            backward BFS depth bound }
	@arg max_size   { @defval 1024         backward BFS size bound }
*/

print "forward-search (bidirectional) benchmark";
print "file=$afile target=$target fs_depth=$fs_depth max_depth=$max_depth max_size=$max_size";

conf-load dir=./$afile;
conf-set gc-after-task=1;

read-ru;
verify;

conf-set verb=2 time-limit=$time_limit;

reprove
	target=$target
	time-limit=$time_limit
	max-depth=$max_depth
	max-size=$max_size
	forward-search-depth=$fs_depth
	forward-search-size=$fs_size;

print ("RESULT fs_depth=$fs_depth: reproved=" + reprove.reproved-count + " failed=" + reprove.failed-count);
