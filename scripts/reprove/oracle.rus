/**
	@help {
		Reprove a stratified sample of a dataset's theorems with the oracle tactic,
		failing if any cannot be reproved. The CI regression check for the proof engine.

		The oracle is the theorem's own stored proof: it only CHOOSES which node to
		expand next. Everything else is the real engine - unification against the
		whole assertion index, premise matching, proof propagation. Two knobs widen
		the search around the oracle's path:
		  hyps=0    the oracle no longer picks the hypothesis at premise leaves; every
		            unifiable hypothesis is admitted (premise-choice explosion)
		  others=N  N alternative nodes per subgoal are expanded once besides the
		            oracle's one; -1 = all of them (one-level explosion of the frontier)
	}
	@defarg afile
	@category prover

	@arg afile {
		@defval set-50000
		input Russell dataset directory name
	}
	@arg time_limit { Time budget for the WHOLE run (job-time-limit). The full set-100000 takes about 17m and needs mem=16g (big theorems create up to 1.5M candidate props). @defval 30m }
	@arg theorem_time_limit { Time limit per theorem. @defval 60s }
	@arg astride { Take every N-th theorem (stratified sample). 1 = all theorems. @defval 1 }
	@arg parallel { 0 = one theorem at a time (the engine is parallel inside). 1 = theorems in parallel: nested contention, big proofs run out of time. @defval 0 }
	@arg others { Alternative (non-oracle) nodes expanded once per subgoal; -1 = all. @defval 0 }
	@arg hyps { 1 = the oracle picks the hypothesis at premise leaves; 0 = every unifiable one. @defval 1 }
	@arg stats { 1 = print the engine's phase statistics (candidate generation, premise matching, propagation) after the run. @defval 0 }

	Pass `verbose=1` (the standard verbose config) to print every theorem as it is
	reproved, with its time. The summary always ends with the time statistics:
	total, average per theorem, and the slowest theorem with its time.
*/

// The CLI verbosity. Captured here because the script sets `verb=` itself below.
cli_verbose := conf.verbose;

print "Reprove with oracle tactic";
print "--------------------------";
print "dataset: $afile";


conf-load dir=./$afile;
conf-set gc-after-task=1;

info/mem-stats;
conf-set verb=1;
//cache-load full=1;

read-ru;
	print ("ru read: " + read-ru.size + " files in " + time2s(read-ru.time));

verify;

conf-set verb=2 reprove-stats=$stats;

// Periodic (throttled) progress callback — safe for large datasets/CI. Fires on
// the server event loop; in one-shot CLI the timer does not tick (see docs).
progress := \pos, counts -> println(("\t" + pos + ", " + counts));

// Per-attempt line (synchronous, works in CLI): nop unless verbose=1 was passed. A theorem
// that runs out of its time slice is retried, so it can appear twice.
decl_done := nop2;
if ((cli_verbose > 0)) { decl_done := \id, t -> println(("\t'" + id + "' in " + t)); }

reprove
    target=stride-$astride
    strict-fail=1
    time-limit=$theorem_time_limit
    job-time-limit=$time_limit
    parallel=$parallel
    tactic="oracle(others=$others, hyps=$hyps)"
    info-progress=progress
    info-decl=decl_done;

// The summary the CI log needs: the reprove command itself is silent on success
// (the output-refactor convention), and without this line the whole test printed
// NOTHING between read-ru and "ALL TESTS PASSED" — indistinguishable from a
// silent crash. strict-fail=1 above still hard-crashes on any failed theorem,
// so a printed failed=0 is a real, kernel-verified result (oracle replay rides
// the ordinary engine; `verify` ran on the freshly read dataset before it).
print ("reprove-oracle [" + afile + "]: reproved=" + reprove.reproved-count +
	" failed=" + reprove.failed-count + " in " + time2s(reprove.time));
print ("time per theorem: avg=" + time2s(reprove.avg_time) +
	", max=" + time2s(reprove.max_time) + " (" + reprove.max_time_id + ")");
// (An `info/stats table=stats-prove-expand` query used to sit here: that flag and
// table exist nowhere in the code any more — today's flag is `reprove-stats`, and
// the oracle REPLAY performs no search expansions anyway, so the query always
// printed a scary-but-meaningless "Error: no ... table is found" into a passing test.)
