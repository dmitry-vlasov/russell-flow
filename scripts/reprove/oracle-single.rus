/**
	@help {
		Reproves a single theorem with the oracle prover.
		Useful as a stress test for a specific large or complex theorem.
	}
	@defarg afile
	@category prover

	@arg afile {
		@defval set-50000
		input math directory (without .ru extension)
	}
	@arg atheorem { Name of the theorem to reprove. }
	@arg time_limit { Time limit for reproving. @defval 5m }
	@arg others { Alternative (non-oracle) nodes expanded once per subgoal; -1 = all. @defval 0 }
	@arg hyps { 1 = the oracle picks the hypothesis at premise leaves; 0 = every unifiable one. @defval 1 }
	@arg stats { 1 = print the engine's phase statistics (candidate generation, premise matching, propagation) after the run. @defval 0 }
	@arg max_props { Candidate budget per theorem: props created before the prover gives up on it (0 = unlimited). ~1 GB of heap per 500k. @defval 2000000 }
	@arg allow_giveup { 1 = theorems that gave up under a limit (time, candidate budget, job budget) are listed, not failures; a search ending without a proof within its limits still fails. @defval 0 }
*/

print "Reprove single theorem with oracle";
print "----------------------------------";
print "file: $afile  theorem: $atheorem";

conf-load dir=./$afile;
conf-set gc-after-task=1;

info/mem-stats;
conf-set verb=1;

read-ru;
	print ("ru read: " + read-ru.size + " files in " + time2s(read-ru.time));

verify;

conf-set verb=2 time-limit=$time_limit reprove-stats=$stats;

// Per-decl progress callback (synchronous — works in CLI). Single theorem here.
decl_done := \id, t -> println(("\t'" + id + "' in " + t));

reprove
    target=$atheorem
    time-limit=$time_limit
    info-decl=decl_done
    max-props=$max_props
    allow-giveup=$allow_giveup
    tactic="oracle(others=$others, hyps=$hyps)";
print ("reprove-oracle-single [" + atheorem + "]: reproved=" + reprove.reproved-count + " failed=" + reprove.failed-count + " in " + time2s(reprove.time));
