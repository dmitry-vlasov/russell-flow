/**
	@help {
		Top-down oracle test: replay a theorem's proof FORWARD through the engine
		and check the goal is reconstructed + verified. Run from ~/dev/math.
	}
	@defarg afile
	@category prover

	@arg afile  { @defval set-10000  input dataset directory name }
	@arg target { @defval syl  theorem to replay forward }
	@arg limit { @defval 1  per-node proof-variant limit (1 = strict unique; N incl. target) }
	@arg nojoin { @defval 0  DBG: 1 = disable the universal join (pure backward oracle) }
*/

conf-set verb=1;
conf-load dir=./$afile;

read-ru;
	print ("ru read: " + read-ru.size + " files in " + time2s(read-ru.time));

test/forward-combined target=$target limit=$limit nojoin=$nojoin;
