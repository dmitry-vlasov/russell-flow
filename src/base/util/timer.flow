import timer;
import base/out;
import base/util/time_units;
import base/util/timed;

export {
	// Fixes the moment of program start
	ruStartTime : double;

	// Current time in milliseconds.
	ruTime() -> double;

	// A BUDGET. Historically wall-clock only: `started` + `limit` ms. A wall-clock budget makes
	// every result depend on machine load and temperature — theorems near the budget flip between
	// runs, so a real regression cannot be told from noise without a cooled repeat, and each
	// repeat costs a full article run.
	//
	// `work`/`workLimit` are the deterministic alternative: the prover TICKS the budget at its
	// real units of work (an emitter proof attempt, a search expansion, a forward fact), and the
	// budget expires after a fixed number of them regardless of the clock. Switched on globally by
	// ruSetWorkUnitsPerSec(u) — every budget of `ms` milliseconds then becomes `ms * u / 1000`
	// work units and the CLOCK IS IGNORED, so the same jar on the same input gives the same
	// answer on a loaded machine as on an idle one.
	RuTimer(
		started   : double,   // The time when timer was created.
		limit     : double,   // The wall-clock limit in ms (-1 = none).
		work      : ref int,  // Work units consumed on this budget.
		workLimit : int       // The work-unit limit (-1 = none, then the wall limit governs).
	);

	// Unlimited timer
	ruMakeTimer() -> RuTimer;
	// Timer with a limit
	ruMakeLimitedTimer(limit : double) -> RuTimer;
	// A budget that STAYS wall-clock even in work mode. The outer per-theorem budget must: the
	// article's total time is divided across theorems by the harness in MILLISECONDS, so if a
	// theorem's own budget is counted in work units it can outstay its share of the wall — and the
	// theorems after it are starved of the shared remainder. Measured: converting it moved the
	// SAME contiguous block (t87-t108 out, t109-t138 in) at every calibration, 200k / 10k / 60k
	// alike, which is the signature of a shared-budget mismatch and not of a wrong rate.
	ruMakeWallTimer(limit : double) -> RuTimer;

	// WORK-UNIT MODE: u > 0 converts every subsequent budget from wall-clock ms to work units at
	// `u` units per second of nominal budget, and stops the clock being consulted. u = 0 restores
	// wall-clock budgets. Process-global on purpose — it is a measurement mode, set once at
	// startup from the `work-units` option, exactly like ruStartTime.
	ruSetWorkUnitsPerSec(u : int) -> void;
	ruWorkUnitsPerSec() -> int;
	// Spend `n` units on this budget. Free (one ref read) when work mode is off.
	ruWorkTick(timer : RuTimer, n : int) -> void;
	// Units spent on this budget so far.
	ruWorkSpent(timer : RuTimer) -> int;
	// PER-SITE call counts since process start (site ids below) — the calibration instrument:
	// a work unit must approximate a CONSTANT slice of cost, so each site's weight is its share of
	// profiled time divided by its call count. Counting is a ref increment, always on.
	ruWorkSite : (site : int, n : int) -> void;
	ruWorkSiteCounts() -> [int];
	ruWorkSiteReset() -> void;
	// SITE WEIGHTS — one unit is meant to be one CONSTANT slice of cost, so each site is ticked by
	// its profiled cost per call relative to the cheapest site (an emitter attempt = 1). From the
	// t64 profile: an expansion is ~1.3 ms, a search step ~0.064 ms, an emitter attempt ~0.0065 ms.
	// Re-derive these whenever the hot set changes: `units=` and `sites=[...]` on every ✓/✗ line
	// give calls per site, the JFR profile gives the time shares.
	ruWWexpand : int;
	ruWWsearch : int;
	// site ids
	ruWSexpand : int;   // one backward subgoal expansion (expand.ruExpandHyp)
	ruWSemitter : int;  // one emitter proof attempt (hilbert.ruHProve)
	ruWSsearch : int;   // one bounded-search step (the `limited` combinator)
	ruWSforward : int;  // one forward application (forward wave)
	// Units ticked anywhere since process start — counted even when work mode is OFF, so any run
	// can be used to CALIBRATE the units-per-second rate of a workload (the rate is not a machine
	// constant: it differs per article, which is exactly what a first calibration got wrong).
	ruWorkTotal() -> int;

	ruTimeIsOver(timer : RuTimer) -> bool;
	ruTimeLeft(timer : RuTimer) -> double;
	ruTimeLeft2s(timer : RuTimer) -> string;
	ruTimePassed(timer : RuTimer) -> double;
	ruTimePassed2s(timer : RuTimer) -> string;
	ruTimer2s(timer : RuTimer) -> string;
}

ruStartTime = ruTime();

ruTime() -> double {
	timestamp()
}

ruWorkUnits : ref int = ref 0;

ruSetWorkUnitsPerSec(u : int) -> void { ruWorkUnits := u; }
ruWorkUnitsPerSec() -> int { ^ruWorkUnits }

ruMakeTimer() -> RuTimer {
	RuTimer(ruTime(), -1.0, ref 0, -1);
}

ruMakeWallTimer(limit : double) -> RuTimer {
	RuTimer(ruTime(), limit, ref 0, -1);
}

ruMakeLimitedTimer(limit : double) -> RuTimer {
	u = ^ruWorkUnits;
	if (u <= 0) RuTimer(ruTime(), limit, ref 0, -1)
	else if (limit < 0.0) RuTimer(ruTime(), -1.0, ref 0, -1)
	// the wall limit is dropped (-1): in work mode the clock must not decide anything
	else RuTimer(ruTime(), -1.0, ref 0, max(1, round(limit * i2d(u) / 1000.0)));
}

ruWorkTotalRef : ref int = ref 0;

ruWWexpand = 200;
ruWWsearch = 10;

ruWSexpand = 0;
ruWSemitter = 1;
ruWSsearch = 2;
ruWSforward = 3;
ruWorkSites : ref [int] = ref [0, 0, 0, 0];

ruWorkSite(site : int, n : int) -> void {
	c = ^ruWorkSites;
	if (site < 0 || site >= length(c)) {} else ruWorkSites := replace(c, site, c[site] + n);
}
ruWorkSiteCounts() -> [int] { ^ruWorkSites }
ruWorkSiteReset() -> void { ruWorkSites := [0, 0, 0, 0]; }

ruWorkTick(timer : RuTimer, n : int) -> void {
	ruWorkTotalRef := ^ruWorkTotalRef + n;
	if (timer.workLimit < 0) {} else timer.work := ^(timer.work) + n;
}

ruWorkTotal() -> int { ^ruWorkTotalRef }

ruWorkSpent(timer : RuTimer) -> int { ^(timer.work) }

ruTimeIsOver(timer : RuTimer) -> bool {
	if (timer.workLimit >= 0) ^(timer.work) > timer.workLimit
	else if (timer.limit == -1.0) false
	else (ruTime() - timer.started) > timer.limit;
}

// The budget REMAINING, always in milliseconds — callers pass it to nested budgets, so in work
// mode it is the remaining units converted back at the same rate (a nested budget then gets its
// proportional share of units, exactly as it got its share of milliseconds).
ruTimeLeft(timer : RuTimer) -> double {
	if (timer.workLimit >= 0) {
		u = ^ruWorkUnits;
		left = timer.workLimit - ^(timer.work);
		if (left <= 0 || u <= 0) 0.0 else i2d(left) * 1000.0 / i2d(u);
	} else if (timer.limit == -1.0) doubleMax
	else timer.limit - (ruTime() - timer.started);
}

ruTimePassed(timer : RuTimer) -> double {
	ruTime() - timer.started;
}

ruTimePassed2s(timer : RuTimer) -> string {
	ruTime2s(ruTime() - timer.started);
}

ruTimeLeft2s(timer : RuTimer) -> string {
	ruTime2s(ruTimeLeft(timer));
}

ruTimer2s(timer : RuTimer) -> string {
	"passed: " + ruTimePassed2s(timer) + "\n" + 
	"limit: " + (if (timer.limit == -1.0) "no" else ruTime2s(timer.limit)) +  
	(if (timer.limit == -1.0) "" else {"\n" +
	"left: " + ruTimeLeft2s(timer) + "\n" + 
	"is over: " + ruTimeLeft2s(timer) + "\n"
	});
}
