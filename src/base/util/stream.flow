// A STREAMING FILE WRITER. `setFileContent` takes the whole file as ONE string,
// which is fine for a source file and ruinous for a generated database:
// the Metamath export measured 4 s at 23 MB, 16 s at 35 MB and 8 min at 116 MB
// (super-linear), and holding a 177 MB database as a Java string — 2 bytes per
// char, plus every intermediate copy — is why those runs peaked at 17 GB and
// the kernel OOM killer took the editor down with them.
//
// Write declaration by declaration instead: linear, and the peak is the buffer.

export {
	// Open a file for writing (truncating). 0 = failure.
	native ruStreamOpen : io (path : string) -> int = RussellStream.streamOpen;
	native ruStreamWrite : io (handle : int, s : string) -> bool = RussellStream.streamWrite;
	native ruStreamClose : io (handle : int) -> bool = RussellStream.streamClose;

	// Write the pieces of a file one at a time. Returns false if the file could
	// not be opened or a write failed; the handle is always closed.
	ruStreamFile(path : string, pieces : (write : (string) -> bool) -> bool) -> bool;
}

ruStreamOpen(path : string) -> int { 0; }
ruStreamWrite(handle : int, s : string) -> bool { false; }
ruStreamClose(handle : int) -> bool { false; }

ruStreamFile(path : string, pieces : (write : (string) -> bool) -> bool) -> bool {
	h = ruStreamOpen(path);
	if (h == 0) false
	else {
		ok = ref true;
		res = pieces(\s -> { w = ruStreamWrite(h, s); if (!w) ok := false; w; });
		closed = ruStreamClose(h);
		res && ^ok && closed;
	}
}
