	// Like the stdlib `concurrent`, but a worker exception is propagated to the calling thread
	// instead of being swallowed (the stdlib native prints the trace and returns an empty array).
	native ruConcurrentStrict : (threadPool : native, tasks : [() -> ?]) -> [?] = RussellTimed.concurrentStrict;
