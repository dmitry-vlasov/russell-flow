import base/fileinfo;

// Typed AST for the MPTP `fof` subset (flat single-sorted classical FOL).
// Produced from the generated parser's SyntaxTree by mptp/parse/parse.flow;
// consumed by mptp/mptp2ru.flow to emit RuParseSource. Models src/mm/src.flow.

export {
	TptpSource(decls : [TptpDecl], info : RuFileInfo);

	// role : "axiom" | "definition" | "conjecture" | "theorem" | ...
	TptpDecl(name : string, role : string, form : TptpForm);

	TptpForm ::= TptpPred, TptpEq, TptpNeg, TptpBin, TptpQuant;
		TptpPred(name : string, args : [TptpTerm]);     // atomic predicate application
		TptpEq(left : TptpTerm, right : TptpTerm);       // equality atom
		TptpNeg(form : TptpForm);
		TptpBin(op : string, left : TptpForm, right : TptpForm);  // op: "and"|"or"|"imp"|"iff"
		TptpQuant(op : string, vars : [string], body : TptpForm); // op: "forall"|"exists"

	TptpTerm ::= TptpVar, TptpApp;
		TptpVar(name : string);                          // upper-case TPTP variable
		TptpApp(name : string, args : [TptpTerm]);       // functor / individual constant (arity 0)

	TptpAny ::= TptpSource, TptpDecl, TptpForm, TptpTerm;

	tptpForm2s(f : TptpForm) -> string;
	tptpTerm2s(t : TptpTerm) -> string;
	tptpDecl2s(d : TptpDecl) -> string;
}

tptpTerm2s(t : TptpTerm) -> string {
	switch (t) {
		TptpVar(name): name;
		TptpApp(name, args):
			if (args == []) name
			else name + "(" + strGlue(map(args, tptpTerm2s), ",") + ")";
	}
}

tptpForm2s(f : TptpForm) -> string {
	switch (f) {
		TptpPred(name, args):
			if (args == []) name
			else name + "(" + strGlue(map(args, tptpTerm2s), ",") + ")";
		TptpEq(l, r): "(" + tptpTerm2s(l) + " = " + tptpTerm2s(r) + ")";
		TptpNeg(g): "~" + tptpForm2s(g);
		TptpBin(op, l, r): {
			sym = if (op == "and") " & " else if (op == "or") " | "
				else if (op == "imp") " => " else " <=> ";
			"(" + tptpForm2s(l) + sym + tptpForm2s(r) + ")";
		}
		TptpQuant(op, vars, body): {
			q = if (op == "forall") "!" else "?";
			q + " [" + strGlue(vars, ",") + "] : " + tptpForm2s(body);
		}
	}
}

tptpDecl2s(d : TptpDecl) -> string {
	"fof(" + d.name + ", " + d.role + ",\n\t" + tptpForm2s(d.form) + " ).";
}
