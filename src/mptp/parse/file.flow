do_parse_tptp_neg(acc : SyntaxParseAcc) -> SyntaxTree {
	i = acc.i;
	if (getCharCodeAt(acc.input, acc.i) == 126 /* ~ */) {
		acc.i ::= acc.i + 1;
		c1 = do_parse_tptp_ws(acc);
