export {
	parse_tptp_source(t : string) -> Pair<SyntaxTree, ExpectError>;
}

parse_tptp_source(t : string) -> Pair<SyntaxTree, ExpectError> {
	acc = SyntaxParseAcc(t, strlen(t), 0, [], noExpectError);
	r = do_parse_tptp_source(acc);
	Pair(r, acc.expect);
}
do_parse_tptp_source(acc : SyntaxParseAcc) -> SyntaxTree {
	i = acc.i;
	c0 = do_parse_tptp_ws(acc);
	if (c0.choice != -1) {
		c1 = SyntaxStar(acc, do_parse_tptp_decl);
		SyntaxTree(st_tptp_source, 0, i, acc.i, [[c0], c1]);
	} else c0
}

do_parse_tptp_decl(acc : SyntaxParseAcc) -> SyntaxTree {
	i = acc.i;
	if (strRangeIndexOf(acc.input, "fof", acc.i, acc.i + 3) == acc.i) {
		acc.i ::= acc.i + 3;
		c1 = do_parse_tptp_ws(acc);
		if (c1.choice != -1) {
			if (getCharCodeAt(acc.input, acc.i) == 40 /* ( */) {
				acc.i ::= acc.i + 1;
				c3 = do_parse_tptp_ws(acc);
				if (c3.choice != -1) {
					c4 = do_parse_tptp_name(acc);
					if (c4.choice != -1) {
						if (getCharCodeAt(acc.input, acc.i) == 44 /* , */) {
							acc.i ::= acc.i + 1;
							c6 = do_parse_tptp_ws(acc);
							if (c6.choice != -1) {
								c7 = do_parse_tptp_role(acc);
								if (c7.choice != -1) {
									if (getCharCodeAt(acc.input, acc.i) == 44 /* , */) {
										acc.i ::= acc.i + 1;
										c9 = do_parse_tptp_ws(acc);
										if (c9.choice != -1) {
											c10 = do_parse_tptp_form(acc);
											if (c10.choice != -1) {
												if (getCharCodeAt(acc.input, acc.i) == 41 /* ) */) {
													acc.i ::= acc.i + 1;
													c12 = do_parse_tptp_ws(acc);
													if (c12.choice != -1) {
														if (getCharCodeAt(acc.input, acc.i) == 46 /* . */) {
															acc.i ::= acc.i + 1;
															c14 = do_parse_tptp_ws(acc);
															if (c14.choice != -1) {
																SyntaxTree(st_tptp_decl, 0, i, acc.i, [[c1], [c3], [c4], [c6], [c7], [c9], [c10], [c12], [c14]]);
															} else c14
														} else {
															// "Expected '.'"
															updateExpectError(acc, "", ".", i);
															failSyntaxTree;
														}
													} else c12
												} else {
													// "Expected ')'"
													updateExpectError(acc, "", ")", i);
													failSyntaxTree;
												}
											} else c10
										} else c9
									} else {
										// "Expected ','"
										updateExpectError(acc, "", ",", i);
										failSyntaxTree;
									}
								} else c7
							} else c6
						} else {
							// "Expected ','"
							updateExpectError(acc, "", ",", i);
							failSyntaxTree;
						}
					} else c4
				} else c3
			} else {
				// "Expected '('"
				updateExpectError(acc, "", "(", i);
				failSyntaxTree;
			}
		} else c1
	} else {
		// "Expected 'fof'"
		updateExpectError(acc, "", "fof", i);
		failSyntaxTree;
	}
}

do_parse_tptp_name(acc : SyntaxParseAcc) -> SyntaxTree {
	i = acc.i;
