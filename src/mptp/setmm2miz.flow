import ru/parse/src;
import base/ids;
import base/id_consts;

// setmm2miz: map set.mm's 3-type logic (wff/setvar/class) onto the miz foundation's
// (wff/setvar/set). Only `class` collapses to `set` (Mizar's individual sort); `setvar`
// is KEPT as a distinct, CONSTRUCTOR-FREE subtype of `set` (its `setvar<:class` super is
// remapped to `setvar<:set`). That distinction is load-bearing for SOUNDNESS: a setvar is
// inhabited only by variables (no rule produces it), so the type-correct unifier rejects
// substituting a TERM for a setvar — which is exactly what disjoint-variable theorems
// (chvarv, …) require. The earlier full collapse (setvar→set too) lost this and let the
// prover "prove" x = ∅. `cv` (setvar→class, now setvar→set) is the subtype super, elided in
// surface expressions, so this is a uniform type-id remap on the parse AST — class → set,
// setvar untouched — with expressions (RuParseExpr.symbs) left as-is. Valid only for the
// CLASSICAL_FIRST-ORDER_LOGIC_WITH_EQUALITY fragment (below df-clab); class abstraction
// `{x|φ}` introduces proper classes that must NOT be collapsed.

export {
	// collapse=true  : the legacy flat foundation — `class` → `set` (Mizar's individual sort),
	//                  `setvar` kept distinct; valid only BELOW df-clab (no class abstraction).
	// collapse=false : the A-map foundation — keep set.mm's native wff/setvar/class untouched so
	//                  the class layer (df-clab/cleq/clel, basic set operations) survives; Mizar
	//                  functors map onto set.mm's class operations. Only defensive type dedup.
	setmm2mizSource(src : RuParseSource, collapse : bool) -> RuParseSource;
}

setmmRemapType(t : int) -> int {
	if (t == tp2id("class")) tp2id("set") else t;  // class -> set; setvar and wff kept
}

// A definition's prop is the fixed template `( defiendum <op> definiens )` using the reserved
// placeholder ids — `↔` for a wff definiendum, `=` otherwise. Some set library .ru files have
// a CORRUPTED prop here (the placeholders were written out as stray names like `elimhyp4v`
// from an id-collision at write time); those parse only by luck in the flat grammar and FAIL
// once the setvar<:set coercion rule is present. Rebuild the template from defm — the real
// content lives in defm/defs, so this is always safe.
setmmDefProp(defm : RuParseTerm, prop : RuParseStmt) -> RuParseStmt {
	op = if (defm.type == tp2id("wff")) "↔" else "=";
	RuParseStmt(prop.class, prop.types,
		RuParseExpr([s2id("("), ruIdDefiendum(), s2id(op), ruIdDefiniens(), s2id(")")], prop.expr.pos),
		prop.pos);
}

// `remap` is the type-id transform: setmmRemapType (collapse class→set) or identity (A-map,
// keep native). Def props are ALWAYS rebuilt from the reserved placeholders — independent of
// the type map — because the corrupted `( elimhyp4v.9 ↔ elimhyp4v )` props live in the source
// library and must be repaired in both modes.
setmmVar(remap : (int) -> int, v : RuParseVar) -> RuParseVar { RuParseVar(v.id, remap(v.type), v.pos); }

setmmStmt(remap : (int) -> int, s : RuParseStmt) -> RuParseStmt {
	RuParseStmt(s.class, map(s.types, remap), s.expr, s.pos);  // expr.symbs untouched
}

setmmTerm(remap : (int) -> int, t : RuParseTerm) -> RuParseTerm { RuParseTerm(remap(t.type), t.expr, t.pos); }

setmmHyp(remap : (int) -> int, h : RuParseHyp) -> RuParseHyp { RuParseHyp(h.ind, setmmStmt(remap, h.stmt), h.pos); }

setmmProof(remap : (int) -> int, p : RuParseProof) -> RuParseProof {
	RuParseProof(map(p.vars, \v -> setmmVar(remap, v)), p.disjs, map(p.steps, \st -> setmmStep(remap, st)), p.pos);
}

setmmStep(remap : (int) -> int, st : RuParseStep) -> RuParseStep {
	RuParseStep(st.ind, st.assertion, st.refs, setmmStmt(remap, st.stmt), setmmProof(remap, st.proof), st.tactic, st.pos);
}

setmmDecl(remap : (int) -> int, d : RuParseDecl) -> RuParseDecl {
	switch (d) {
		RuParseConst(__, __, __, __, __): d;
		RuParseType(id, c, supers, pos):   RuParseType(remap(id), c, map(supers, remap), pos);
		RuParseRule(id, c, vars, term, pos): RuParseRule(id, c, map(vars, \v -> setmmVar(remap, v)), setmmTerm(remap, term), pos);
		RuParseAxiom(id, c, vars, disjs, hyps, prop, pos):
			RuParseAxiom(id, c, map(vars, \v -> setmmVar(remap, v)), disjs, map(hyps, \h -> setmmHyp(remap, h)), setmmStmt(remap, prop), pos);
		RuParseCong(id, c, vars, disjs, hyps, prop, pos):
			RuParseCong(id, c, map(vars, \v -> setmmVar(remap, v)), disjs, map(hyps, \h -> setmmHyp(remap, h)), setmmStmt(remap, prop), pos);
		RuParseDef(id, c, vars, disjs, hyps, defm, defs, prop, pos):
			RuParseDef(id, c, map(vars, \v -> setmmVar(remap, v)), disjs, map(hyps, \h -> setmmHyp(remap, h)), setmmTerm(remap, defm), setmmTerm(remap, defs), setmmDefProp(setmmTerm(remap, defm), setmmStmt(remap, prop)), pos);
		RuParseTheorem(id, c, vars, disjs, meta, hyps, prop, proof, pos):
			RuParseTheorem(id, c, map(vars, \v -> setmmVar(remap, v)), disjs, meta, map(hyps, \h -> setmmHyp(remap, h)), setmmStmt(remap, prop), setmmProof(remap, proof), pos);
	}
}

setmm2mizSource(src : RuParseSource, collapse : bool) -> RuParseSource {
	// A-map (collapse=false): identity type map — keep set.mm's native wff/setvar/class so the
	// class layer survives. Def props are still rebuilt; the merge fold dedups type decls.
	remap = if (collapse) setmmRemapType else \t -> t;
	transformed = map(src.decls, \d -> setmmDecl(remap, d));
	seen_types = ref makeSet();
	deduped = filter(transformed, \d ->
		switch (d) {
			RuParseType(id, __, __, __):
				if (containsSet(^seen_types, id)) false
				else { seen_types := insertSet(^seen_types, id); true };
			default: true;
		}
	);
	RuParseSource(src.imports, deduped, src.comments, src.info);
}
