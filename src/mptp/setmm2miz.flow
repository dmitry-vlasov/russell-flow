import ru/parse/src;
import base/ids;

// setmm2miz: collapse set.mm's 3-type logic (wff/setvar/class) into the flat
// 2-type scheme (wff/set) used by the miz foundation. `cv` (setvar→class) is a
// SUBTYPE relation, not a rule, and surface expressions elide it, so the whole
// collapse is a uniform type-id remap on the parse AST — setvar,class → set —
// with expressions (RuParseExpr.symbs) left untouched. Valid only for the
// CLASSICAL_FIRST-ORDER_LOGIC_WITH_EQUALITY fragment (below df-clab); class
// abstraction `{x|φ}` introduces proper classes that must NOT be collapsed.

export {
	setmm2mizSource(src : RuParseSource) -> RuParseSource;
}

setmmRemapType(t : int) -> int {
	if (t == tp2id("setvar") || t == tp2id("class")) tp2id("set") else t;
}

setmmVar(v : RuParseVar) -> RuParseVar { RuParseVar(v.id, setmmRemapType(v.type), v.pos); }

setmmStmt(s : RuParseStmt) -> RuParseStmt {
	RuParseStmt(s.class, map(s.types, setmmRemapType), s.expr, s.pos);  // expr.symbs untouched
}

setmmTerm(t : RuParseTerm) -> RuParseTerm { RuParseTerm(setmmRemapType(t.type), t.expr, t.pos); }

setmmHyp(h : RuParseHyp) -> RuParseHyp { RuParseHyp(h.ind, setmmStmt(h.stmt), h.pos); }

setmmProof(p : RuParseProof) -> RuParseProof {
	RuParseProof(map(p.vars, setmmVar), p.disjs, map(p.steps, setmmStep), p.pos);
}

setmmStep(st : RuParseStep) -> RuParseStep {
	RuParseStep(st.ind, st.assertion, st.refs, setmmStmt(st.stmt), setmmProof(st.proof), st.pos);
}

setmmDecl(d : RuParseDecl) -> RuParseDecl {
	switch (d) {
		RuParseConst(__, __, __, __, __): d;
		RuParseType(id, c, __, pos):       RuParseType(setmmRemapType(id), c, [], pos);  // drop the setvar<:class super
		RuParseRule(id, c, vars, term, pos): RuParseRule(id, c, map(vars, setmmVar), setmmTerm(term), pos);
		RuParseAxiom(id, c, vars, disjs, hyps, prop, pos):
			RuParseAxiom(id, c, map(vars, setmmVar), disjs, map(hyps, setmmHyp), setmmStmt(prop), pos);
		RuParseCong(id, c, vars, disjs, hyps, prop, pos):
			RuParseCong(id, c, map(vars, setmmVar), disjs, map(hyps, setmmHyp), setmmStmt(prop), pos);
		RuParseDef(id, c, vars, disjs, hyps, defm, defs, prop, pos):
			RuParseDef(id, c, map(vars, setmmVar), disjs, map(hyps, setmmHyp), setmmTerm(defm), setmmTerm(defs), setmmStmt(prop), pos);
		RuParseTheorem(id, c, vars, disjs, meta, hyps, prop, proof, pos):
			RuParseTheorem(id, c, map(vars, setmmVar), disjs, meta, map(hyps, setmmHyp), setmmStmt(prop), setmmProof(proof), pos);
	}
}

setmm2mizSource(src : RuParseSource) -> RuParseSource {
	// Transform every decl, then drop duplicate type decls (setvar and class both
	// collapse to `set`, so a source that declared both now has two `type set`).
	transformed = map(src.decls, setmmDecl);
	seen_types = ref makeSet();
	deduped = filter(transformed, \d ->
		switch (d) {
			RuParseType(id, __, __, __):
				if (containsSet(^seen_types, id)) false
				else { seen_types := insertSet(^seen_types, id); true };
			default: true;
		}
	);
	RuParseSource(src.imports, deduped, src.comments, src.info);
}
