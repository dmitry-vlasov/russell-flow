import ru/parse/src;
import base/ids;
import base/id_consts;

// setmm2miz: map set.mm's 3-type logic (wff/setvar/class) onto the miz foundation's
// (wff/setvar/set). Only `class` collapses to `set` (Mizar's individual sort); `setvar`
// is KEPT as a distinct, CONSTRUCTOR-FREE subtype of `set` (its `setvar<:class` super is
// remapped to `setvar<:set`). That distinction is load-bearing for SOUNDNESS: a setvar is
// inhabited only by variables (no rule produces it), so the type-correct unifier rejects
// substituting a TERM for a setvar — which is exactly what disjoint-variable theorems
// (chvarv, …) require. The earlier full collapse (setvar→set too) lost this and let the
// prover "prove" x = ∅. `cv` (setvar→class, now setvar→set) is the subtype super, elided in
// surface expressions, so this is a uniform type-id remap on the parse AST — class → set,
// setvar untouched — with expressions (RuParseExpr.symbs) left as-is. Valid only for the
// CLASSICAL_FIRST-ORDER_LOGIC_WITH_EQUALITY fragment (below df-clab); class abstraction
// `{x|φ}` introduces proper classes that must NOT be collapsed.

export {
	setmm2mizSource(src : RuParseSource) -> RuParseSource;
}

setmmRemapType(t : int) -> int {
	if (t == tp2id("class")) tp2id("set") else t;  // class -> set; setvar and wff kept
}

// A definition's prop is the fixed template `( defiendum <op> definiens )` using the reserved
// placeholder ids — `↔` for a wff definiendum, `=` otherwise. Some set library .ru files have
// a CORRUPTED prop here (the placeholders were written out as stray names like `elimhyp4v`
// from an id-collision at write time); those parse only by luck in the flat grammar and FAIL
// once the setvar<:set coercion rule is present. Rebuild the template from defm — the real
// content lives in defm/defs, so this is always safe.
setmmDefProp(defm : RuParseTerm, prop : RuParseStmt) -> RuParseStmt {
	op = if (defm.type == tp2id("wff")) "↔" else "=";
	RuParseStmt(prop.class, prop.types,
		RuParseExpr([s2id("("), ruIdDefiendum(), s2id(op), ruIdDefiniens(), s2id(")")], prop.expr.pos),
		prop.pos);
}

setmmVar(v : RuParseVar) -> RuParseVar { RuParseVar(v.id, setmmRemapType(v.type), v.pos); }

setmmStmt(s : RuParseStmt) -> RuParseStmt {
	RuParseStmt(s.class, map(s.types, setmmRemapType), s.expr, s.pos);  // expr.symbs untouched
}

setmmTerm(t : RuParseTerm) -> RuParseTerm { RuParseTerm(setmmRemapType(t.type), t.expr, t.pos); }

setmmHyp(h : RuParseHyp) -> RuParseHyp { RuParseHyp(h.ind, setmmStmt(h.stmt), h.pos); }

setmmProof(p : RuParseProof) -> RuParseProof {
	RuParseProof(map(p.vars, setmmVar), p.disjs, map(p.steps, setmmStep), p.pos);
}

setmmStep(st : RuParseStep) -> RuParseStep {
	RuParseStep(st.ind, st.assertion, st.refs, setmmStmt(st.stmt), setmmProof(st.proof), st.pos);
}

setmmDecl(d : RuParseDecl) -> RuParseDecl {
	switch (d) {
		RuParseConst(__, __, __, __, __): d;
		RuParseType(id, c, supers, pos):   RuParseType(setmmRemapType(id), c, map(supers, setmmRemapType), pos);  // keep setvar<:set super
		RuParseRule(id, c, vars, term, pos): RuParseRule(id, c, map(vars, setmmVar), setmmTerm(term), pos);
		RuParseAxiom(id, c, vars, disjs, hyps, prop, pos):
			RuParseAxiom(id, c, map(vars, setmmVar), disjs, map(hyps, setmmHyp), setmmStmt(prop), pos);
		RuParseCong(id, c, vars, disjs, hyps, prop, pos):
			RuParseCong(id, c, map(vars, setmmVar), disjs, map(hyps, setmmHyp), setmmStmt(prop), pos);
		RuParseDef(id, c, vars, disjs, hyps, defm, defs, prop, pos):
			RuParseDef(id, c, map(vars, setmmVar), disjs, map(hyps, setmmHyp), setmmTerm(defm), setmmTerm(defs), setmmDefProp(setmmTerm(defm), setmmStmt(prop)), pos);
		RuParseTheorem(id, c, vars, disjs, meta, hyps, prop, proof, pos):
			RuParseTheorem(id, c, map(vars, setmmVar), disjs, meta, map(hyps, setmmHyp), setmmStmt(prop), setmmProof(proof), pos);
	}
}

setmm2mizSource(src : RuParseSource) -> RuParseSource {
	// Transform every decl, then drop duplicate type decls (setvar and class both
	// collapse to `set`, so a source that declared both now has two `type set`).
	transformed = map(src.decls, setmmDecl);
	seen_types = ref makeSet();
	deduped = filter(transformed, \d ->
		switch (d) {
			RuParseType(id, __, __, __):
				if (containsSet(^seen_types, id)) false
				else { seen_types := insertSet(^seen_types, id); true };
			default: true;
		}
	);
	RuParseSource(src.imports, deduped, src.comments, src.info);
}
