import ru/parse/src;
import ru/parse/util;
import base/util/fileinfo;
import base/ids;
import base/id_consts;
import mptp/src;

// Translate a parsed TPTP (MPTP) source into a Russell RuParseSource: a
// self-contained flat-FOL kernel + the article signature (one const+rule per
// functor/predicate) + every fof as an axiom (theorems/conjectures as STUB
// axioms). Builds RuParse* structs directly — the same intermediate mm2ru
// produces — so the result rides the normal collect/verify pipeline.
// Mirrors src/mm/mm2ru.flow. The Python scripts/mptp/mptp2ru.py is the oracle
// for the expected .ru output.

export {
	mptpFoundationSource(module : string, conf : RuConf) -> RuParseSource;
	mptpArticleSource(tptp : TptpSource, sigForms : [TptpForm], extra : [RuParseDecl], import_ids : [int], module : string, conf : RuConf, notationOf : (string) -> string, emit : MptpEmit) -> RuParseSource;
	mptpHypTheorem(name : string, hyps : [TptpForm], goal : TptpForm) -> RuParseTheorem;
	mptpProofTheorem(name : string, comment : string, hyps : [TptpForm], steps : [TptpForm]) -> RuParseTheorem;
	mptpAxiomC(name : string, comment : string, form : TptpForm) -> RuParseAxiom;

	// How an article's signature is emitted, parameterised by the target foundation:
	//  - `termType`   : the sort of individual terms — "set" (flat miz_logic) or "class" (A-map miz_set).
	//  - `isReused`   : symbols the foundation already provides a rule for → emit NO article rule/def.
	//                   KIND-AWARE: `isPred` says whether the occurrence is in WFF position (a
	//                   predicate/mode/attribute) or TERM position (a functor). A name alone is
	//                   NOT enough — Mizar happily spells an ATTRIBUTE `pair` while the bracket
	//                   FUNCTOR { , } is also named `pair`, and matching the term A-map from a
	//                   wff position emitted the guard as a TERM (`∀x ( { x } → …)`), which does
	//                   not parse and lost the WHOLE article: 16 of the 34 parse failures in the
	//                   2026-07-19 MML survey, cascading from xtuple_0 into relat_1/funct_1/….
	MptpEmit(termType : string, isReused : (string, bool) -> bool, reusedCong : bool);

	// Flat foundation (miz_logic): individuals are `set`; only ∈ is reused (wcel) and it needs an
	// article term-level congruence (the flat foundation lacks one).
	mptpFlatEmit() -> MptpEmit;
	// A-map foundation (miz_set): individuals are `class`; the set-theoretic core (∪/∩/∖/△/∅/⊆/⊊/∈
	// + singleton/pair) maps onto set.mm's class operations, which carry their own membership
	// lemmas AND equality congruences, so the article emits no rule/def/congruence for them.
	mptpAmapEmit() -> MptpEmit;
	mptpAmapReused(name : string) -> bool;
}

mptpFlatEmit() -> MptpEmit { MptpEmit("set", \n, isPred -> isPred && n == "∈", true); }
mptpAmapEmit() -> MptpEmit { MptpEmit("class", mptpAmapReusedKind, false); }

// The Mizar set-theoretic constructors that map onto set.mm's class layer in miz_set, SPLIT BY
// KIND. The symbols are exactly what mizOpName / mizBracketName emit (so the article formulas
// already use the foundation's symbols); `singleton`/`pair`/`triple` are the circumfix bracket
// functor NAMES. Splitting is a CORRECTNESS requirement, not tidiness — see MptpEmit.
// TERM-valued (class layer): only ever reused from functor position.
mptpAmapReusedTerm(name : string) -> bool {
	exists(["∪", "∩", "∖", "△", "∅", "×.", "singleton", "pair", "triple",
		// the zfmisc alignment: power set (cpw), union of a family (cuni), ordered
		// pair (cop) — the foundation's velpw/eluni/opth corpus replaces the
		// article-local fn_bool/fn_union/fn_opair definitional axioms
		"𝒫", "∪.", "opair"], \s -> s == name);
}
// WFF-valued relations: only ever reused from predicate position.
mptpAmapReusedPred(name : string) -> bool {
	exists(["⊆", "⊊", "∈"], \s -> s == name);
}
mptpAmapReusedKind(name : string, isPred : bool) -> bool {
	if (isPred) mptpAmapReusedPred(name) else mptpAmapReusedTerm(name);
}
// Kind-agnostic legacy view (either position) — used only where the kind is genuinely unknown.
mptpAmapReused(name : string) -> bool { mptpAmapReusedTerm(name) || mptpAmapReusedPred(name); }

// ---- small builders -------------------------------------------------------

mptpConst(sym : string) -> RuParseConst { RuParseConst(s2id(sym), [], -1, "", -1); }

// Drop later decls whose NAME was already emitted (see mptpArticleSource).
mptpDedupDecls(ds : [RuParseDecl]) -> [RuParseDecl] {
	(fold(ds, Pair([], makeSet()), \acc : Pair<[RuParseDecl], Set<int>>, d -> {
		id = d.id;
		if (containsSet(acc.second, id)) acc
		else Pair(arrayPush(acc.first, d), insertSet(acc.second, id));
	})).first;
}
mptpVar(name : string, type : string) -> RuParseVar { RuParseVar(s2id(name), tp2id(type), -1); }
mptpExpr(toks : [string]) -> RuParseExpr { RuParseExpr(map(toks, s2id), -1); }

mptpRule(name : string, vars : [Pair<string, string>], rtype : string, toks : [string]) -> RuParseRule {
	RuParseRule(s2id(name), [], map(vars, \p -> mptpVar(p.first, p.second)),
		RuParseTerm(tp2id(rtype), mptpExpr(toks), -1), -1);
}

mptpStmt(toks : [string]) -> RuParseStmt {
	// The provability marker sits in the statement *class* position, which the .ru
	// reader lexes as an identifier, so it must be ascii `|-` (the unicode ⊢ is not
	// a valid id-char and breaks the text round-trip). Operators inside may stay unicode.
	RuParseStmt(s2id("|-"), [tp2id("wff")], mptpExpr(toks), -1);
}

// |- <formula> as an axiom over object vars (used for the MPTP definitions/axioms). Object vars
// are `setvar` — they are bound by ∀/∃ (wal/wex, which take a setvar) and coerce into term
// positions via the setvar<:set/class super; plain `set`/`class` won't fit a wal binder.
mptpAxiom(name : string, vars : [string], toks : [string]) -> RuParseAxiom {
	RuParseAxiom(s2id(name), [], map(vars, \v -> mptpVar(v, "setvar")), [], [], mptpStmt(toks), -1);
}

// general logical axiom/rule: typed vars, distinct-variable pairs, |- hypotheses, |- conclusion
mptpFolAx(name : string, vars : [Pair<string, string>], disjs : [Pair<string, string>],
		hyps : [[string]], prop : [string]) -> RuParseAxiom {
	RuParseAxiom(s2id(name), [],
		map(vars, \p -> mptpVar(p.first, p.second)),
		map(disjs, \d -> RuParseDisj([s2id(d.first), s2id(d.second)], -1)),
		mapi(hyps, \i, h -> RuParseHyp(i, mptpStmt(h), -1)),
		mptpStmt(prop), -1);
}

// definition: defiendum :↔ definiens. `prop` carries the reserved defiendum/definiens
// placeholder tokens joined by ↔, exactly as the .ru reader produces (ruMakeDef).
mptpDef(name : string, vars : [Pair<string, string>], defm : [string], defs : [string]) -> RuParseDef {
	RuParseDef(s2id(name), [], map(vars, \p -> mptpVar(p.first, p.second)), [], [],
		RuParseTerm(tp2id("wff"), mptpExpr(defm), -1),
		RuParseTerm(tp2id("wff"), mptpExpr(defs), -1),
		RuParseStmt(s2id("|-"), [tp2id("wff")],
			RuParseExpr([s2id("("), ruIdDefiendum(), s2id("↔"), ruIdDefiniens(), s2id(")")], -1), -1),
		-1);
}

// ∧ / ∨ / ∃ as genuine definitions (df-an/df-or/df-ex), mirroring set.mm
mptpDefs() -> [RuParseDef] {
	w2 = [Pair("ph", "wff"), Pair("ps", "wff")];
	[
		mptpDef("df-an", w2, ["(", "ph", "∧", "ps", ")"], ["¬", "(", "ph", "→", "¬", "ps", ")"]),
		mptpDef("df-or", w2, ["(", "ph", "∨", "ps", ")"], ["(", "¬", "ph", "→", "ps", ")"]),
		mptpDef("df-ex", [Pair("ph", "wff"), Pair("x", "set")], ["∃", "x", "ph"], ["¬", "∀", "x", "¬", "ph"]),
	];
}

// ---- classical FOL + equality proof calculus (set.mm axioms, flat `set` sort) ----

mptpFolAxioms() -> [RuParseAxiom] {
	w2 = [Pair("ph", "wff"), Pair("ps", "wff")];
	[
		// propositional
		mptpFolAx("ax-mp", w2, [], [["ph"], ["(", "ph", "→", "ps", ")"]], ["ps"]),
		mptpFolAx("ax-1", w2, [], [], ["(", "ph", "→", "(", "ps", "→", "ph", ")", ")"]),
		mptpFolAx("ax-2", [Pair("ph", "wff"), Pair("ps", "wff"), Pair("ch", "wff")], [], [],
			["(", "(", "ph", "→", "(", "ps", "→", "ch", ")", ")", "→",
			 "(", "(", "ph", "→", "ps", ")", "→", "(", "ph", "→", "ch", ")", ")", ")"]),
		mptpFolAx("ax-3", w2, [], [], ["(", "(", "¬", "ph", "→", "¬", "ps", ")", "→", "(", "ps", "→", "ph", ")", ")"]),
		// biconditional (elim/elim/intro) — replaces df-bi
		mptpFolAx("bi1", w2, [], [], ["(", "(", "ph", "↔", "ps", ")", "→", "(", "ph", "→", "ps", ")", ")"]),
		mptpFolAx("bi2", w2, [], [], ["(", "(", "ph", "↔", "ps", ")", "→", "(", "ps", "→", "ph", ")", ")"]),
		mptpFolAx("bi3", w2, [], [],
			["(", "(", "ph", "→", "ps", ")", "→", "(", "(", "ps", "→", "ph", ")", "→", "(", "ph", "↔", "ps", ")", ")", ")"]),
		// predicate calculus + equality
		mptpFolAx("ax-gen", [Pair("ph", "wff"), Pair("x", "set")], [], [["ph"]], ["∀", "x", "ph"]),
		mptpFolAx("ax-4", [Pair("ph", "wff"), Pair("ps", "wff"), Pair("x", "set")], [], [],
			["(", "∀", "x", "(", "ph", "→", "ps", ")", "→", "(", "∀", "x", "ph", "→", "∀", "x", "ps", ")", ")"]),
		mptpFolAx("ax-5", [Pair("ph", "wff"), Pair("x", "set")], [Pair("ph", "x")], [], ["(", "ph", "→", "∀", "x", "ph", ")"]),
		mptpFolAx("ax-6", [Pair("x", "set"), Pair("y", "set")], [], [], ["¬", "∀", "x", "¬", "(", "x", "=", "y", ")"]),
		mptpFolAx("ax-7", [Pair("x", "set"), Pair("y", "set"), Pair("z", "set")], [], [],
			["(", "(", "x", "=", "y", ")", "→", "(", "(", "x", "=", "z", ")", "→", "(", "y", "=", "z", ")", ")", ")"]),
		mptpFolAx("ax-10", [Pair("ph", "wff"), Pair("x", "set")], [], [],
			["(", "¬", "∀", "x", "ph", "→", "∀", "x", "¬", "∀", "x", "ph", ")"]),
		mptpFolAx("ax-11", [Pair("ph", "wff"), Pair("x", "set"), Pair("y", "set")], [], [],
			["(", "∀", "x", "∀", "y", "ph", "→", "∀", "y", "∀", "x", "ph", ")"]),
		mptpFolAx("ax-12", [Pair("ph", "wff"), Pair("x", "set"), Pair("y", "set")], [], [],
			["(", "(", "x", "=", "y", ")", "→", "(", "∀", "y", "ph", "→", "∀", "x", "(", "(", "x", "=", "y", ")", "→", "ph", ")", ")", ")"]),
		mptpFolAx("ax-13", [Pair("x", "set"), Pair("y", "set"), Pair("z", "set")], [], [],
			["(", "¬", "(", "x", "=", "y", ")", "→", "(", "(", "y", "=", "z", ")", "→", "∀", "x", "(", "y", "=", "z", ")", ")", ")"]),
	];
}

// per-signature equality congruence (generalises set.mm ax-8/ax-9 to the whole signature):
// the FULL simultaneous congruence — ALL argument positions vary at once, one equality
// hypothesis each — concluding that the results are EQUAL (functor, on terms) or
// EQUIVALENT (predicate, on wffs). No premise, fully symmetric:
//   functor f/n:    a0=b0, …, a(n-1)=b(n-1)  ⊢  ( f(a0..) =  f(b0..) )
//   predicate p/n:  a0=b0, …, a(n-1)=b(n-1)  ⊢  ( p(a0..) ↔ p(b0..) )
mptpCong(termType : string, prefix : string, name : string, arity : int, is_func : bool) -> RuParseCong {
	idxs  = enumFromTo(0, arity - 1);
	a = \j -> "a" + i2s(j);
	b = \j -> "b" + i2s(j);
	left   = mptpApp(name, map(idxs, \j -> [a(j)]));
	right  = mptpApp(name, map(idxs, \j -> [b(j)]));
	eqhyps = map(idxs, \j -> ["(", a(j), "=", b(j), ")"]);
	vars   = concatA(map(idxs, \j -> [Pair(a(j), termType), Pair(b(j), termType)]));
	// term equality `=` for a functor result, wff equivalence `↔` for a predicate result.
	conn = if (is_func) "=" else "↔";
	hyps = eqhyps;
	prop = concatA([["("], left, [conn], right, [")"]]);
	ax = mptpFolAx(prefix + mptpRuleId(name) + "_cong", vars, [], hyps, prop);
	RuParseCong(ax.id, mptpComment("congruence: " + name + " respects equality in all arguments"),
		ax.vars, ax.disjs, ax.hyps, ax.prop, ax.pos);
}

// per-slot DEDUCTION-form congruence axiom (the forall-instantiate chain's vocabulary —
// ruFwdBiChain composes ⊢ (x=A) → (φ ↔ φ[A/x]) and needs the →-form at ARTICLE atoms,
// exactly as eleq1/sseq1/eqeq1 serve the foundation atoms; the i-form congruence above
// cannot feed it: its equality hypotheses are BARE, the chain's are hypothetical).
// Same trust level as the i-form (both are A-map congruence axioms). 1-based slot:
//   functor  f/n, slot i:  ⊢ ( ( ai = bi ) → ( f(..ai..) = f(..bi..) ) )
//   predicate p/n, slot i: ⊢ ( ( ai = bi ) → ( p(..ai..) ↔ p(..bi..) ) )
mptpCongD(termType : string, prefix : string, name : string, arity : int, is_func : bool, slot : int) -> RuParseAxiom {
	idxs  = enumFromTo(0, arity - 1);
	a = \j -> "a" + i2s(j);
	bs = "b" + i2s(slot);
	left  = mptpApp(name, map(idxs, \j -> [a(j)]));
	right = mptpApp(name, map(idxs, \j -> if (j == slot) [bs] else [a(j)]));
	vars  = concat(map(idxs, \j -> Pair(a(j), termType)), [Pair(bs, termType)]);
	conn = if (is_func) "=" else "↔";
	prop = concatA([["(", "(", a(slot), "=", bs, ")", "→", "("], left, [conn], right, [")", ")"]]);
	mptpFolAx(prefix + mptpRuleId(name) + "_cong" + i2s(slot + 1) + "d", vars, [], [], prop);
}

mptpCongruences(sig : MptpSig, emit : MptpEmit) -> [RuParseDecl] {
	// only arity >= 1 has a non-trivial congruence (a nullary constant is its own).
	congs = \prefix, pairs, is_func -> filtermap(pairs, \p ->
		if (p.second < 1) None() else Some(mptpCong(emit.termType, prefix, p.first, p.second, is_func)));
	congds = \prefix, pairs, is_func -> concatA(map(pairs, \p : Pair<string, int> ->
		map(enumFromTo(0, p.second - 1), \slot -> mptpCongD(emit.termType, prefix, p.first, p.second, is_func, slot))));
	ci : [RuParseDecl] = concatA([
		congs("fn_", tree2pairs(sig.funcs), true),
		congs("pr_", tree2pairs(sig.preds), false),
		// reused symbols: a congruence only when the foundation lacks one (flat path, ∈). The A-map
		// foundation carries eleq*/uneq*/sseq* etc., so reusedCong=false → none emitted.
		if (emit.reusedCong) congs("pr_", tree2pairs(sig.reused), false) else []
	]);
	cd : [RuParseDecl] = concatA([
		congds("fn_", tree2pairs(sig.funcs), true),
		congds("pr_", tree2pairs(sig.preds), false)
	]);
	concat(ci, cd);
}

// fully-parenthesised prefix application shared by rule body and usage:
//   arity 0 -> [name];  arity n -> "(" name arg0 .. argn ")"
mptpApp(name : string, argToks : [[string]]) -> [string] {
	if (argToks == []) [name]
	else {
		br = mptpBracketParts(name);
		if (br != [])
			// a bracket functor renders circumfix: { a0 }, { a0 , a1 }, [ a0 , a1 ].
			concat(concat([br[0]], mptpJoinArgs(argToks, br[1])), [br[2]])
		else if (length(argToks) == 2 && mptpIsInfix(name))
			// a binary infix operator renders between its arguments: ( a0 ∪ a1 ), ( x in y ).
			concatA([["("], argToks[0], [name], argToks[1], [")"]])
		else if (length(argToks) == 1 && mptpIsBarePrefix(name))
			// a foundation bare-prefix functor renders WITHOUT parens — the foundation
			// term shape is `𝒫 A` / `∪. A` (set.mm cpw/cuni), not `( 𝒫 A )`.
			concat([name], argToks[0])
		else concat(concat(["(", name], concatA(argToks)), [")"]);
	}
}

// Binary operators written infix in the source. The unicode symbols are what mizOpName
// emits; the words are the common infix predicates. (MPTP names are never infix, so the
// MPTP front-end is unaffected.)
mptpIsInfix(name : string) -> bool {
	exists(["∪", "∩", "∖", "△", "⊆", "⊊", "⊄", "∈", "×.", "misses", "meets", "are_equipotent"], \s -> s == name);
}

// Foundation unary functors whose term shape is bare-prefix (no parens): 𝒫 A (cpw), ∪. A (cuni).
mptpIsBarePrefix(name : string) -> bool {
	name == "𝒫" || name == "∪.";
}

// Circumfix bracket functors -> [left, separator, right], else []. The bracket symbols are
// either in the foundation ([ ] ,) or auto-interned ({ }).
// An ascii spelling that can't round-trip in `ascii <X> ;;` — block-delimiter brackets or spaces.
mptpAsciiUnsafe(s : string) -> bool {
	exists(["{", "}", "[", "]", " "], \c -> strContains(s, c));
}
mptpBracketParts(name : string) -> [string] {
	if (name == "singleton") ["{", "", "}"]
	else if (name == "pair") ["{", ",", "}"]   // { a0 , a1 }
	else if (name == "triple") ["{", ",", "}"] // { a0 , a1 , a2 } → foundation ctp
	else if (name == "opair") ["〈", ",", "〉"] // 〈 a0 , a1 〉 → foundation cop (Kuratowski, same as Mizar's [ , ])
	else [];
}

mptpJoinArgs(argToks : [[string]], sep : string) -> [string] {
	foldi(argToks, [], \i, acc, arg -> if (i == 0 || sep == "") concat(acc, arg) else concat(concat(acc, [sep]), arg));
}

// ---- the fixed flat-FOL kernel --------------------------------------------

mptpKernelConsts() -> [RuParseConst] {
	map(["(", ")", "¬", "→", "↔", "∧", "∨", "∀", "∃", "=", "|-"], mptpConst);
}

mptpKernelRules() -> [RuParseRule] {
	[
		mptpRule("wn",  [Pair("ph", "wff")],                  "wff", ["¬", "ph"]),
		mptpRule("wi",  [Pair("ph", "wff"), Pair("ps", "wff")], "wff", ["(", "ph", "→", "ps", ")"]),
		mptpRule("wb",  [Pair("ph", "wff"), Pair("ps", "wff")], "wff", ["(", "ph", "↔", "ps", ")"]),
		mptpRule("wa",  [Pair("ph", "wff"), Pair("ps", "wff")], "wff", ["(", "ph", "∧", "ps", ")"]),
		mptpRule("wo",  [Pair("ph", "wff"), Pair("ps", "wff")], "wff", ["(", "ph", "∨", "ps", ")"]),
		mptpRule("wal", [Pair("x", "set"), Pair("ph", "wff")], "wff", ["∀", "x", "ph"]),
		mptpRule("wex", [Pair("x", "set"), Pair("ph", "wff")], "wff", ["∃", "x", "ph"]),
		mptpRule("weq", [Pair("a", "set"), Pair("b", "set")],  "wff", ["(", "a", "=", "b", ")"]),
	];
}

// ---- signature collection -------------------------------------------------

// (funcs, preds) : name -> arity
// `funcs`/`preds`: article symbols (each gets a rule + a congruence). `reused`: symbols the
// foundation already provides a rule for (∈ = wcel) but NO term-level congruence — they get a
// congruence here, NOT a rule. Without the ∈ congruence, equal terms can't be rewritten inside
// membership (the equalizer has nothing to use).
MptpSig(funcs : Tree<string, int>, preds : Tree<string, int>, reused : Tree<string, int>);

mptpCollectSig(decls : [TptpDecl], emit : MptpEmit) -> MptpSig {
	fold(decls, MptpSig(makeTree(), makeTree(), makeTree()), \acc, d -> mptpSigForm(emit, acc, d.form));
}

mptpSigForm(emit : MptpEmit, acc : MptpSig, f : TptpForm) -> MptpSig {
	switch (f) {
		// A foundation-provided (reused) predicate gets NO article rule — collect it into `reused`
		// instead (the flat path then adds a term-level congruence for ∈; the A-map path doesn't,
		// the foundation has eleq*). `$true`/`$false` are foundation constants. STILL traverse the
		// arguments — functors nested inside membership (e.g. `x ∈ ( a ∪ b )`) reach the signature.
		TptpPred(name, args): {
			isReused = emit.isReused(name, true);
			isConst  = name == "$true" || name == "$false";
			preds1  = if (isConst || isReused) acc.preds else setTree(acc.preds, name, length(args));
			reused1 = if (isReused) setTree(acc.reused, name, length(args)) else acc.reused;
			fold(args, MptpSig(acc.funcs, preds1, reused1), \a, t -> mptpSigTerm(emit, a, t));
		}
		TptpEq(l, r):         mptpSigTerm(emit, mptpSigTerm(emit, acc, l), r);
		TptpNeg(g):           mptpSigForm(emit, acc, g);
		TptpBin(__, l, r):    mptpSigForm(emit, mptpSigForm(emit, acc, l), r);
		TptpQuant(__, __, b): mptpSigForm(emit, acc, b);
	}
}

mptpSigTerm(emit : MptpEmit, acc : MptpSig, t : TptpTerm) -> MptpSig {
	switch (t) {
		TptpVar(__): acc;
		// an abstraction's BODY carries the symbols — traverse it
		TptpAbs(__, body): mptpSigForm(emit, acc, body);
		TptpApp(name, args): {
			// a reused functor (∪/∩/∖/△/∅/singleton/pair) is foundation-provided — collect it into
			// `reused` (no article rule), but still traverse its arguments.
			isReused = emit.isReused(name, false);
			funcs1  = if (isReused) acc.funcs  else setTree(acc.funcs, name, length(args));
			reused1 = if (isReused) setTree(acc.reused, name, length(args)) else acc.reused;
			fold(args, MptpSig(funcs1, acc.preds, reused1), \a, t2 -> mptpSigTerm(emit, a, t2));
		}
	}
}

// `notationOf(name)` gives the human Mizar surface symbol for an MPTP name (\+\, c=, in,
// …) or "" — appended to the signature comments. The MPTP front-end passes \_ -> "".
mptpSigDecls(sig : MptpSig, termType : string, notationOf : (string) -> string) -> Pair<[RuParseConst], [RuParseRule]> {
	fns = map(tree2pairs(sig.funcs), \p -> mptpSigRule("fn_", p.first, p.second, termType, termType, notationOf));
	prs = map(tree2pairs(sig.preds), \p -> mptpSigRule("pr_", p.first, p.second, "wff", termType, notationOf));
	// a predicate symbol that is never also a functor still needs its constant
	names = uniq(concat(getTreeKeys(sig.funcs), getTreeKeys(sig.preds)));
	consts = filtermap(names, \n ->
		// a bracket functor renders circumfix ({ }, [ ]) — it has no single symbol constant.
		if (mptpBracketParts(n) != []) None()
		else {
			ref  = mptpRefComment(n);
			nota = notationOf(n);   // the original Mizar ascii spelling (c=, \/, …)
			// extended form: the math symbol, its Mizar ascii, and its LaTeX rendering.
			// Skip an ascii spelling that contains block-delimiter brackets or spaces — `ascii { }` /
			// `ascii [: :]` don't round-trip parse. An unmapped bracket functor (no foundation target, e.g.
			// enum4-8) then emits as a plain opaque `symbol <name>` + `rule fn_<name>` that re-reads cleanly.
			asciiId = if (nota != "" && nota != n && !mptpAsciiUnsafe(nota)) s2id(nota) else -1;
			Some(RuParseConst(s2id(n),
				mptpComment("Mizar symbol " + n + (if (ref == "") "" else " (" + ref + ")")),
				asciiId, mptpLatex(n), -1));
		});
	Pair(consts, concat(fns, prs));
}

// LaTeX rendering for the math symbols mizOpName/mizBracketName emit (others: "").
mptpLatex(name : string) -> string {
	lookupTreeDef(pairs2tree([
		Pair("∪", "\\cup"), Pair("∩", "\\cap"), Pair("∖", "\\setminus"), Pair("△", "\\bigtriangleup"),
		Pair("∅", "\\emptyset"), Pair("⊆", "\\subseteq"), Pair("⊊", "\\subsetneq"), Pair("⊄", "\\not\\subset"),
		Pair("∈", "\\in"), Pair("⋃", "\\bigcup"), Pair("misses", "\\nasymp")
	]), name, "");
}

mptpSigRule(prefix : string, name : string, arity : int, rtype : string, argType : string, notationOf : (string) -> string) -> RuParseRule {
	vars = map(enumFromTo(0, arity - 1), \i -> Pair("a" + i2s(i), argType));
	body = mptpApp(name, map(enumFromTo(0, arity - 1), \i -> ["a" + i2s(i)]));
	ref  = mptpRefComment(name);
	nota = notationOf(name);
	kw   = if (rtype == "wff") "predicate" else "functor";
	// `name` may be a non-identifier symbol (∪, ⊆, …) — fine as the symbol in the term, but
	// the rule NAME must be a valid id, so slug it (∪ -> cup).
	RuParseRule(mptpRule(prefix + mptpRuleId(name), vars, rtype, body) with
		comments = mptpComment("grammar for the " + kw + " " + name + (if (ref == "") "" else " (" + ref + ")") +
			" — " + i2s(arity) + "-ary" + (if (nota == "") "" else "  ::  " + nota)));
}

// A valid Russell identifier for a symbol used in a rule/axiom NAME. Symbols that aren't
// identifier-safe (the unicode operators mizOpName emits) map to an alphanumeric slug; an
// already-valid name passes through. Keep in sync with mizOpName's symbol set.
mptpRuleId(name : string) -> string {
	lookupTreeDef(pairs2tree([
		Pair("∪", "cup"), Pair("∩", "cap"), Pair("∖", "diff"), Pair("△", "symdiff"),
		Pair("∅", "emptyset"), Pair("⊆", "subset"), Pair("⊊", "psubset"), Pair("⊄", "ncsubset"),
		Pair("∈", "in"), Pair("⋃", "union")
	]), name, name);
}

// ---- formula / term -> token list -----------------------------------------

mptpVrename(v : string) -> string { toLowerCase(v); }   // X3 -> x3 (no v_ prefix)

// "k1_tarski" -> "TARSKI:1", "r2_hidden" -> "HIDDEN:2"; readable names (in/union) -> "".
mptpRefComment(name : string) -> string {
	us = strIndexOf(name, "_");
	if (us < 1) ""
	else {
		head = substring(name, 0, us);
		aid  = substring(name, us + 1, strlen(name) - us - 1);
		nr   = substring(head, 1, strlen(head) - 1);
		if (aid == "" || nr == "" || !forall(s2a(nr), \c -> c >= 48 && c <= 57)) ""
		else toUpperCase(aid) + ":" + nr;
	}
}

mptpOpSym(op : string) -> string {
	if (op == "and") "∧" else if (op == "or") "∨" else if (op == "imp") "→" else "↔";
}

mptpTermToks(t : TptpTerm) -> [string] {
	switch (t) {
		TptpVar(name): [mptpVrename(name)];
		// the foundation's `cab` rule is  { x ∣ ph }
		TptpAbs(v, body): concat3(["{", mptpVrename(v), "∣"], mptpFormToks(body), ["}"]);
		TptpApp(name, args): mptpApp(name, map(args, mptpTermToks));
	}
}

mptpFormToks(f : TptpForm) -> [string] {
	switch (f) {
		TptpPred(name, args):
			if (name == "$true") ["⊤"] else if (name == "$false") ["F."]
			else mptpApp(name, map(args, mptpTermToks));
		TptpEq(l, r):         concat(concat(["("], mptpTermToks(l)), concat(["="], concat(mptpTermToks(r), [")"])));
		TptpNeg(g):           concat(["¬"], mptpFormToks(g));
		TptpBin(op, l, r):    concat(concat(["("], mptpFormToks(l)), concat([mptpOpSym(op)], concat(mptpFormToks(r), [")"])));
		TptpQuant(op, vars, body): {
			q = if (op == "forall") "∀" else "∃";
			foldr(vars, mptpFormToks(body), \acc, v -> concat([q, mptpVrename(v)], acc));
		}
	}
}

mptpFormVars(f : TptpForm) -> [string] {
	uniq(mptpDoFormVars(f));
}

mptpDoFormVars(f : TptpForm) -> [string] {
	switch (f) {
		TptpPred(__, args): concatA(map(args, mptpDoTermVars));
		TptpEq(l, r):       concat(mptpDoTermVars(l), mptpDoTermVars(r));
		TptpNeg(g):         mptpDoFormVars(g);
		TptpBin(__, l, r):  concat(mptpDoFormVars(l), mptpDoFormVars(r));
		TptpQuant(__, vs, body): concat(map(vs, mptpVrename), mptpDoFormVars(body));
	}
}

mptpDoTermVars(t : TptpTerm) -> [string] {
	switch (t) {
		TptpVar(name): [mptpVrename(name)];
		TptpAbs(v, body): concat([mptpVrename(v)], mptpDoFormVars(body));
		TptpApp(__, args): concatA(map(args, mptpDoTermVars));
	}
}

mptpDeclAxiom(d : TptpDecl) -> RuParseAxiom {
	mptpAxiom(d.name, mptpFormVars(d.form), mptpFormToks(d.form));
}

// theorem/conjecture role -> an OPEN RuParseTheorem: proof is a single `problem`
// step (step 1 : wff = ? |- goal), i.e. a `prove` target. The transport phase
// replaces this with a real proof.
mptpDeclTheorem(d : TptpDecl) -> RuParseTheorem {
	toks = mptpFormToks(d.form);
	vars = map(mptpFormVars(d.form), \v -> mptpVar(v, "setvar"));
	problem = RuParseStep(0, ruParseProblem, [],
		RuParseStmt(s2id("|-"), [tp2id("wff")], mptpExpr(toks), -1), ruParseNoProof, "", -1);
	RuParseTheorem(s2id(d.name), [], vars, [], RuParseMeta([], -1), [],
		mptpStmt(toks), RuParseProof([], [], [problem], -1), -1);
}

mptpDeclAssertion(d : TptpDecl) -> RuParseDecl {
	if (d.role == "theorem" || d.role == "conjecture") mptpDeclTheorem(d) else mptpDeclAxiom(d);
}

// ---- bootstrap derived-lemma layer (open theorems; proved by `prove`) -------
// Short, high-reuse propositional lemmas that give proof search chaining material
// it otherwise lacks from raw axioms. Emitted OPEN (single problem step), in
// dependency order; `prove target=all` discharges them before the MPTP theorems.

mptpOpenThm(name : string, vars : [Pair<string, string>], hyps : [[string]], prop : [string]) -> RuParseTheorem {
	problem = RuParseStep(0, ruParseProblem, [],
		RuParseStmt(s2id("|-"), [tp2id("wff")], mptpExpr(prop), -1), ruParseNoProof, "", -1);
	RuParseTheorem(s2id(name), [], map(vars, \p -> mptpVar(p.first, p.second)), [],
		RuParseMeta([], -1),
		mapi(hyps, \i, h -> RuParseHyp(i, mptpStmt(h), -1)),
		mptpStmt(prop), RuParseProof([], [], [problem], -1), -1);
}

mptpLemmas() -> [RuParseTheorem] {
	w2 = [Pair("ph", "wff"), Pair("ps", "wff")];
	w3 = [Pair("ph", "wff"), Pair("ps", "wff"), Pair("ch", "wff")];
	[
		// a1i:  ph  ⊢  ( ps → ph )
		mptpOpenThm("a1i", w2, [["ph"]], ["(", "ps", "→", "ph", ")"]),
		// id:  ⊢  ( ph → ph )
		mptpOpenThm("id", [Pair("ph", "wff")], [], ["(", "ph", "→", "ph", ")"]),
		// a2i:  ( ph → ( ps → ch ) )  ⊢  ( ( ph → ps ) → ( ph → ch ) )
		mptpOpenThm("a2i", w3, [["(", "ph", "→", "(", "ps", "→", "ch", ")", ")"]],
			["(", "(", "ph", "→", "ps", ")", "→", "(", "ph", "→", "ch", ")", ")"]),
		// mpd:  ( ph → ps ) , ( ph → ( ps → ch ) )  ⊢  ( ph → ch )
		mptpOpenThm("mpd", w3, [["(", "ph", "→", "ps", ")"], ["(", "ph", "→", "(", "ps", "→", "ch", ")", ")"]],
			["(", "ph", "→", "ch", ")"]),
		// syl:  ( ph → ps ) , ( ps → ch )  ⊢  ( ph → ch )
		mptpOpenThm("syl", w3, [["(", "ph", "→", "ps", ")"], ["(", "ps", "→", "ch", ")"]],
			["(", "ph", "→", "ch", ")"]),
		// mpbi:  ph , ( ph ↔ ps )  ⊢  ps
		mptpOpenThm("mpbi", w2, [["ph"], ["(", "ph", "↔", "ps", ")"]], ["ps"]),
		// mpbir:  ps , ( ph ↔ ps )  ⊢  ph
		mptpOpenThm("mpbir", w2, [["ps"], ["(", "ph", "↔", "ps", ")"]], ["ph"]),
		// alimi:  ( ph → ps )  ⊢  ( ∀ x ph → ∀ x ps )   [ax-gen, ax-4, ax-mp]
		mptpOpenThm("alimi", [Pair("ph", "wff"), Pair("ps", "wff"), Pair("x", "set")],
			[["(", "ph", "→", "ps", ")"]], ["(", "∀", "x", "ph", "→", "∀", "x", "ps", ")"]),
	];
}

// ---- assemble -------------------------------------------------------------

// Assign an increasing source position to each top-level decl. Directly-built
// RuParse decls all carry pos=-1; some downstream ordering (and the prover's
// per-theorem assertion scope) relies on real, distinct, increasing positions,
// which the text parser supplies but a hand-built source does not.
mptpSetPos(decl : RuParseDecl, pos : int) -> RuParseDecl {
	switch (decl) {
		RuParseConst(id, c, a, l, __):           RuParseConst(id, c, a, l, pos);
		RuParseType(id, c, s, __):               RuParseType(id, c, s, pos);
		RuParseRule(id, c, v, t, __):            RuParseRule(id, c, v, t, pos);
		RuParseAxiom(id, c, v, d, h, p, __):     RuParseAxiom(id, c, v, d, h, p, pos);
		RuParseCong(id, c, v, d, h, p, __):      RuParseCong(id, c, v, d, h, p, pos);
		RuParseDef(id, c, v, d, h, dm, ds, p, __): RuParseDef(id, c, v, d, h, dm, ds, p, pos);
		RuParseTheorem(id, c, v, d, m, h, p, pr, __): RuParseTheorem(id, c, v, d, m, h, p, pr, pos);
	}
}

mptpPosition(decls : [RuParseDecl]) -> [RuParseDecl] {
	mapi(decls, \i, d -> mptpSetPos(d, (i + 1) * 16));
}

// The signature-INDEPENDENT logic: grammar + FOL axioms + definitions + the
// derived-lemma corpus. Authored/maintained as a standalone Russell foundation
// `.ru` (generate once, prove the lemmas, commit, then grow it by editing the
// .ru directly). Articles import it rather than re-emitting it.
mptpFoundationSource(module : string, conf : RuConf) -> RuParseSource {
	consts : [RuParseDecl] = map(mptpKernelConsts(), \c -> c);
	types  : [RuParseDecl] = [RuParseType(tp2id("set"), [], [], -1), RuParseType(tp2id("wff"), [], [], -1)];
	krules : [RuParseDecl] = map(mptpKernelRules(), \r -> r);
	kdefs  : [RuParseDecl] = map(mptpDefs(), \d -> d);
	folax  : [RuParseDecl] = map(mptpFolAxioms(), \a -> a);
	lemmas : [RuParseDecl] = map(mptpLemmas(), \t -> t);
	RuParseSource(
		[],
		mptpPosition(concatA([consts, types, krules, kdefs, folax, lemmas])),
		[],
		ruNewFileInfo(module, conf, ".ru")
	);
}

// A translated article: imports the foundation, then adds only the
// signature-DEPENDENT material — the symbol signature, per-symbol equality
// congruences, and the relativized axioms/theorems.
mptpArticleSource(tptp : TptpSource, sigForms : [TptpForm], extra : [RuParseDecl], import_ids : [int], module : string, conf : RuConf, notationOf : (string) -> string, emit : MptpEmit) -> RuParseSource {
	// Collect the symbol signature from the emitted decls AND from `sigForms` — the forms
	// of the `extra` theorems (their hyps/steps), which aren't TptpDecls but still use the
	// article's predicates/functions, so they must contribute to the signature.
	sig = mptpCollectSig(concatA([tptp.decls, map(sigForms, \f -> TptpDecl("_sig", "axiom", f))]), emit);
	sig_decls = mptpSigDecls(sig, emit.termType, notationOf);
	sconsts : [RuParseDecl] = map(sig_decls.first, \c -> c);
	srules : [RuParseDecl] = map(sig_decls.second, \r -> r);
	congs  : [RuParseDecl] = map(mptpCongruences(sig, emit), \a -> a);
	axioms : [RuParseDecl] = map(tptp.decls, \d -> mptpDeclAssertion(d));
	// DEFENSIVE DEDUP by decl name. The per-source signature is already uniq'd, but a name can
	// still arrive twice from independent paths — notably the `unhandled_term_<Tag>` placeholder
	// the translator mints for a Mizar construct it cannot render (funct_1: <Choice>), which is
	// emitted once per occurrence. A duplicate decl is a hard CRASH at parse-collect that costs
	// the whole article, so collapse identical names here: first wins, order preserved.
	RuParseSource(
		map(import_ids, \id -> RuParseImport(id, -1)),
		mptpPosition(mptpDedupDecls(concatA([sconsts, srules, congs, axioms, extra]))),
		[],
		ruNewFileInfo(module, conf, ".ru")
	);
}

// An OPEN theorem in HYPOTHESES form: hypotheses `hyps` (as |- $e statements) and
// conclusion `goal` (a single problem step). Unlike mptpDeclTheorem (whole formula in
// the conclusion), this gives the prover the antecedents as immediate facts — the
// natural form for the Mizar proof gaps φ ⊢ P.
mptpHypTheorem(name : string, hyps : [TptpForm], goal : TptpForm) -> RuParseTheorem {
	mptpProofTheorem(name, "", hyps, [goal]);
}

// One theorem per source theorem, in HYPOTHESES form: hypotheses `hyps` (the let-guards
// + assumptions — the shared proof context) and a multi-step proof where each `step` is
// one proof-step proposition left OPEN (`?` problem step). The conclusion (= the theorem
// prop) is the LAST step. Filling the open steps yields a complete proof — no separate
// assembly. (`steps` must be non-empty; for a direct/no-proof theorem pass [statement].)
mptpProofTheorem(name : string, comment : string, hyps : [TptpForm], steps : [TptpForm]) -> RuParseTheorem {
	goal = if (steps == []) TptpPred("$true", []) else steps[length(steps) - 1];
	allForms = concat(hyps, steps);
	// object variables are setvars (they are bound by ∀/∃ = wal/wex, which take a setvar, and
	// coerce into term positions via the setvar<:set super) — NOT plain `set` terms. This is
	// what makes disjoint-variable theorems sound: a setvar can't be a compound term.
	vars = map(uniq(concatA(map(allForms, mptpFormVars))), \v -> mptpVar(v, "setvar"));
	proofSteps = mapi(steps, \i, sp -> RuParseStep(i, ruParseProblem, [],
		RuParseStmt(s2id("|-"), [tp2id("wff")], mptpExpr(mptpFormToks(sp)), -1), ruParseNoProof, "", -1));
	RuParseTheorem(s2id(name), mptpComment(comment), vars, [], RuParseMeta([], -1),
		mapi(hyps, \i, h -> RuParseHyp(i, mptpStmt(mptpFormToks(h)), -1)),
		mptpStmt(mptpFormToks(goal)), RuParseProof([], [], proofSteps, -1), -1);
}

mptpComment(text : string) -> [RuParseComment] {
	if (text == "") [] else [RuParseComment(" " + text + " ", "", -1)];
}

// An axiom with an optional comment (used for the env theorems/definitions).
mptpAxiomC(name : string, comment : string, form : TptpForm) -> RuParseAxiom {
	RuParseAxiom(s2id(name), mptpComment(comment),
		map(mptpFormVars(form), \v -> mptpVar(v, "setvar")), [], [], mptpStmt(mptpFormToks(form)), -1);
}
