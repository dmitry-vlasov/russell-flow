import base/fileinfo;

// Typed AST for flat single-sorted classical FOL — the NEUTRAL intermediate
// representation between the front-ends and the Russell emitter. Two producers:
// the LIVE Mizar XML translator (mizar/miz2ru.flow) and the legacy TPTP parser
// (mptp/parse/parse.flow, which reads the MPTP `fof` subset this AST began as);
// one consumer: fol/fol2ru.flow, emitting RuParseSource. Models src/mm/src.flow.

export {
	FolSource(decls : [FolDecl], info : RuFileInfo);

	// role : "axiom" | "definition" | "conjecture" | "theorem" | ...
	FolDecl(name : string, role : string, form : FolForm);

	FolForm ::= FolPred, FolEq, FolNeg, FolBin, FolQuant;
		FolPred(name : string, args : [FolTerm]);     // atomic predicate application
		FolEq(left : FolTerm, right : FolTerm);       // equality atom
		FolNeg(form : FolForm);
		FolBin(op : string, left : FolForm, right : FolForm);  // op: "and"|"or"|"imp"|"iff"
		FolQuant(op : string, vars : [string], body : FolForm); // op: "forall"|"exists"

	FolTerm ::= FolVar, FolApp, FolAbs;
		FolVar(name : string);                          // upper-case TPTP variable
		FolApp(name : string, args : [FolTerm]);       // functor / individual constant (arity 0)
		// CLASS ABSTRACTION `{ var | body }` — the only term that binds a variable and carries a
		// FORMULA. Needed for Mizar's Fraenkel term `{ f(x) where x is T : P[x] }`, which is
		// set.mm's native `cab` idiom, so translating it advances the set.mm/MML merge rather
		// than working around it.
		FolAbs(var : string, body : FolForm);

	FolAny ::= FolSource, FolDecl, FolForm, FolTerm;

	tptpForm2s(f : FolForm) -> string;
	tptpTerm2s(t : FolTerm) -> string;
	tptpDecl2s(d : FolDecl) -> string;
}

tptpTerm2s(t : FolTerm) -> string {
	switch (t) {
		FolVar(name): name;
		FolAbs(v, body): "{" + v + " | " + tptpForm2s(body) + "}";
		FolApp(name, args):
			if (args == []) name
			else name + "(" + strGlue(map(args, tptpTerm2s), ",") + ")";
	}
}

tptpForm2s(f : FolForm) -> string {
	switch (f) {
		FolPred(name, args):
			if (args == []) name
			else name + "(" + strGlue(map(args, tptpTerm2s), ",") + ")";
		FolEq(l, r): "(" + tptpTerm2s(l) + " = " + tptpTerm2s(r) + ")";
		FolNeg(g): "~" + tptpForm2s(g);
		FolBin(op, l, r): {
			sym = if (op == "and") " & " else if (op == "or") " | "
				else if (op == "imp") " => " else " <=> ";
			"(" + tptpForm2s(l) + sym + tptpForm2s(r) + ")";
		}
		FolQuant(op, vars, body): {
			q = if (op == "forall") "!" else "?";
			q + " [" + strGlue(vars, ",") + "] : " + tptpForm2s(body);
		}
	}
}

tptpDecl2s(d : FolDecl) -> string {
	"fof(" + d.name + ", " + d.role + ",\n\t" + tptpForm2s(d.form) + " ).";
}
