import ru/prover/tactics/pproof;
import fol/src;

// PHASE 2, step 2 of the Kalmár-free certificate generator (see pproof.flow):
// translate a G3cp derivation into a forward HILBERT proof over the
// foundation's propositional lemmas, in the FolForm dialect of the emitted
// articles. Deterministic, no search: one fixed step pattern per G3cp rule.
//
// NATURAL-DEDUCTION REFUTATION FORM — the shape Mizar itself reasons in.
// One CONTEXT C = ⋀(facts ++ [¬goal] ++ assumption stack), left-nested and
// only ever EXTENDED (weakening is free): every sequent of the derivation is
// realized as |- C → F. against the context current at its tree position.
// Each formula G3cp decomposes is DERIVED once as a cached step |- C → f
// (one fixed lemma per connective: simpl/simpr for ∧, biimp/biimpr for ↔,
// notnotr, pm2.45/pm2.46 for ¬∨, simplim/conax1 for ¬→, ...); a cached step
// is lifted into a deeper assumption frame by one simpl+syl, deduplicated
// globally. Branching rules (∨L, →L, ∧R) push an assumption, refute the
// child, and discharge with ex / efald / jaod. The root refutation
// |- ⋀(facts ++ [¬goal]) → F. becomes |- goal by ex + con1d + fal.
// Proof size tracks the G3cp tree, not the context squared.
//
// The lemma vocabulary (all present in miz_set.ru with these exact shapes):
//   id simpl simpr syl jca ex efald mpd mpi ax-mp a1i pm2.21d
//   notnotr pm2.45 pm2.46 simplim conax1 biimp biimpr impbi imp con3i
//   jaod con1i con1d tru fal pm3.2i

export {
	// One emitted step: its statement, the foundation assertion it cites, and
	// premise references in the assertion's OWN hypothesis order.
	FolPStep(form : FolForm, assertion : string, refs : [FolPRef]);
	FolPRef ::= FolPRefStep, FolPRefFact;
		FolPRefStep(i : int);  // index into the emitted step list (0-based)
		FolPRefFact(i : int);  // the caller's i-th fact, available as |- facts[i]

	// A Hilbert proof of `facts |- goal`, or None when the entailment does not
	// hold propositionally (G3cp countermodel). The last step proves |- goal.
	// `atom` renders a RuPAtom key as the article-dialect formula.
	folPCert(facts : [RuPForm], goal : RuPForm, atom : (string) -> FolForm) -> Maybe<[FolPStep]>;
	// folPCert with size guards: None also when the G3cp tree exceeds maxNodes
	// or the emitted proof exceeds maxSteps.
	folPCertBounded(facts : [RuPForm], goal : RuPForm, atom : (string) -> FolForm,
		maxNodes : int, maxSteps : int) -> Maybe<[FolPStep]>;

	// the same skeleton->dialect rendering the steps use (for headers/reports)
	folPFol(f : RuPForm, atom : (string) -> FolForm) -> FolForm;
}

FolPAcc(steps : ref [FolPStep], atom : (string) -> FolForm, fail : ref bool,
	memo : ref Tree<string, int>, used : ref Set<int>);

// a cached derivation |- C(ctx prefix of length `depth`) → form.
// idx < 0 marks a LAZY root projection of ctx element -(idx+1): it is emitted
// on first use and its ROOT-FACT index recorded — pass 2 rebuilds the
// certificate over the used facts only, so unused facts never enter C.
FolPDer(idx : int, depth : int, form : RuPForm, roots : Set<int>);

folPForm(a : FolPAcc, f : RuPForm) -> FolForm {
	switch (f) {
		RuPAtom(key):  a.atom(key);
		RuPNot(g):     FolNeg(folPForm(a, g));
		RuPAnd(l, r):  FolBin("and", folPForm(a, l), folPForm(a, r));
		RuPOr(l, r):   FolBin("or",  folPForm(a, l), folPForm(a, r));
		RuPImp(l, r):  FolBin("imp", folPForm(a, l), folPForm(a, r));
		RuPIff(l, r):  FolBin("iff", folPForm(a, l), folPForm(a, r));
		RuPTrue():     FolPred("$true", []);
		RuPFalse():    FolPred("$false", []);
	}
}

folPConj(fs : [RuPForm]) -> RuPForm {
	if (fs == []) RuPTrue() else fold(tail(fs), fs[0], \acc, f -> RuPAnd(acc, f));
}

folPImp(a : FolPAcc, l : RuPForm, r : RuPForm) -> FolForm {
	FolBin("imp", folPForm(a, l), folPForm(a, r));
}

// structural keys (fol2ru's token renderer is not importable here — cycle)
folPKeyP(f : RuPForm) -> string {
	switch (f) {
		RuPAtom(k):   "@" + k;
		RuPNot(g):    "~" + folPKeyP(g);
		RuPAnd(l, r): "&(" + folPKeyP(l) + "," + folPKeyP(r) + ")";
		RuPOr(l, r):  "|(" + folPKeyP(l) + "," + folPKeyP(r) + ")";
		RuPImp(l, r): ">(" + folPKeyP(l) + "," + folPKeyP(r) + ")";
		RuPIff(l, r): "=(" + folPKeyP(l) + "," + folPKeyP(r) + ")";
		RuPTrue():    "T";
		RuPFalse():   "F";
	}
}

// emit with GLOBAL common-step elimination: an identical (assertion, refs,
// statement) step is the same step — lifts and projections repeat across
// G3cp nodes, and dedup keeps certificates near-linear in the tree
folPEmit(a : FolPAcc, form : FolForm, assertion : string, refs : [FolPRef]) -> int {
	key = assertion + "|" + strGlue(map(refs, \r -> switch (r) {
		FolPRefStep(i): "s" + i2s(i);
		FolPRefFact(i): "f" + i2s(i);
	}), ",") + "|" + folPKey(form);
	switch (lookupTree(^(a.memo), key)) {
		Some(i): i;
		None(): {
			a.steps := arrayPush(^(a.steps), FolPStep(form, assertion, refs));
			i = length(^(a.steps)) - 1;
			a.memo := setTree(^(a.memo), key, i);
			i;
		}
	}
}

folPKey(f : FolForm) -> string {
	switch (f) {
		FolPred(n, args):  n + "(" + strGlue(map(args, folPTKey), ",") + ")";
		FolEq(l, r):       "=(" + folPTKey(l) + "," + folPTKey(r) + ")";
		FolNeg(g):         "~" + folPKey(g);
		FolBin(op, l, r):  op + "(" + folPKey(l) + "," + folPKey(r) + ")";
		FolQuant(op, vs, b): op + "[" + strGlue(vs, ",") + "]" + folPKey(b);
	}
}
folPTKey(t : FolTerm) -> string {
	switch (t) {
		FolVar(n): n;
		FolApp(n, args): n + "(" + strGlue(map(args, folPTKey), ",") + ")";
		FolAbs(v, b): "{" + v + "|" + folPKey(b) + "}";
	}
}

sref(i : int) -> FolPRef { FolPRefStep(i); }

// |- ⋀ctx → ctx[i]  (ctx left-nested; steps shared through the global memo)
folPPrj(a : FolPAcc, ctx : [RuPForm], i : int) -> int {
	n = length(ctx);
	c = folPConj(ctx);
	if (n == 1) folPEmit(a, folPImp(a, c, ctx[0]), "id", [])
	else if (i == n - 1) folPEmit(a, folPImp(a, c, ctx[i]), "simpr", [])
	else {
		pre = subrange(ctx, 0, n - 1);
		u = folPEmit(a, folPImp(a, c, folPConj(pre)), "simpl", []);
		v = folPPrj(a, pre, i);
		folPEmit(a, folPImp(a, c, ctx[i]), "syl", [sref(u), sref(v)]);
	}
}

// |- C(ctx) → C(prefix of length e)  (e < length(ctx); one simpl per frame)
folPDown(a : FolPAcc, ctx : [RuPForm], e : int) -> int {
	d = length(ctx);
	pre = subrange(ctx, 0, d - 1);
	s = folPEmit(a, folPImp(a, folPConj(ctx), folPConj(pre)), "simpl", []);
	if (e == d - 1) s
	else {
		r = folPDown(a, pre, e);
		folPEmit(a, folPImp(a, folPConj(ctx), folPConj(subrange(ctx, 0, e))), "syl", [sref(s), sref(r)]);
	}
}

// the cached derivation of `f`, lifted into the current frame when older
folPGet(a : FolPAcc, ctx : [RuPForm], der : Tree<string, FolPDer>, f : RuPForm) -> int {
	switch (lookupTree(der, folPKeyP(f))) {
		None(): {
			a.fail := true;
			folPEmit(a, folPForm(a, f), "PCERT_UNRESOLVED", []);
		}
		Some(e): {
			idx = if (e.idx >= 0) e.idx
				else folPPrj(a, subrange(ctx, 0, e.depth), -e.idx - 1);
			if (e.depth == length(ctx)) idx
			else {
				br = folPDown(a, ctx, e.depth);
				folPEmit(a, folPImp(a, folPConj(ctx), f), "syl", [sref(br), sref(idx)]);
			}
		}
	}
}

folPAdd(der : Tree<string, FolPDer>, f : RuPForm, idx : int, depth : int, roots : Set<int>) -> Tree<string, FolPDer> {
	setTree(der, folPKeyP(f), FolPDer(idx, depth, f, roots));
}

// provenance of a cached formula: which root facts it descends from
folPRoots(der : Tree<string, FolPDer>, f : RuPForm) -> Set<int> {
	switch (lookupTree(der, folPKeyP(f))) {
		None(): makeSet();
		Some(e): e.roots;
	}
}

// an axiom leaf consumed `f` — its root facts are semantically USED
folPUse(a : FolPAcc, der : Tree<string, FolPDer>, f : RuPForm) -> void {
	a.used := mergeSets(^(a.used), folPRoots(der, f));
}

// |- C→x (pos), |- C→¬x (neg)  =>  |- C → F.
folPContra(a : FolPAcc, c : RuPForm, x : RuPForm, pos : int, neg : int) -> int {
	u = folPEmit(a, folPImp(a, c, RuPImp(x, RuPFalse())), "pm2.21d", [sref(neg)]);
	folPEmit(a, folPImp(a, c, RuPFalse()), "mpd", [sref(pos), sref(u)]);
}

folPDecomposable(f : RuPForm) -> bool {
	switch (f) { RuPAtom(__): false; RuPTrue(): false; RuPFalse(): false; default: true; }
}

// push assumption x: extended context + its own projection cached
FolPFrame(ctx : [RuPForm], der : Tree<string, FolPDer>);
folPPush(a : FolPAcc, ctx : [RuPForm], der : Tree<string, FolPDer>, x : RuPForm, roots : Set<int>) -> FolPFrame {
	ctx2 = arrayPush(ctx, x);
	sx = folPEmit(a, folPImp(a, folPConj(ctx2), x), "simpr", []);
	FolPFrame(ctx2, folPAdd(der, x, sx, length(ctx2), roots));
}

// |- C(ctx) → F. for this derivation node, deriving what its rule needs
folPProve(a : FolPAcc, d : RuPDeriv, ctx : [RuPForm], der : Tree<string, FolPDer>) -> int {
	c = folPConj(ctx);
	dep = length(ctx);
	fls : RuPForm = RuPFalse();
	switch (d) {
		RuPDAxiom(g, dl): {
			if (exists(g, \f -> f == fls)) {
				folPUse(a, der, fls);
				folPGet(a, ctx, der, fls);
			}
			else if (exists(dl, \f -> f == RuPTrue())) {
				folPUse(a, der, RuPNot(RuPTrue()));
				n = folPGet(a, ctx, der, RuPNot(RuPTrue()));
				t = folPEmit(a, folPForm(a, RuPTrue()), "tru", []);
				ta = folPEmit(a, folPImp(a, c, RuPTrue()), "a1i", [sref(t)]);
				folPContra(a, c, RuPTrue(), ta, n);
			} else {
				pi = findiDef(g, \f -> ruPCtains(dl, f), -1);
				if (pi < 0) {
					a.fail := true;
					folPEmit(a, folPForm(a, fls), "PCERT_BAD_AXIOM", []);
				} else {
					p = g[pi];
					folPUse(a, der, p);
					folPUse(a, der, RuPNot(p));
					pos = folPGet(a, ctx, der, p);
					neg = folPGet(a, ctx, der, RuPNot(p));
					folPContra(a, c, p, pos, neg);
				}
			}
		}
		RuPDRule(rule, g, dl, kids): {
			pick = ruPPickPrincipal(g, dl);
			f = if (pick.first) g[pick.second] else dl[pick.second];
			if (rule == "¬L") folPProve(a, kids[0], ctx, der)
			else if (rule == "∧L") {
				switch (f) {
					RuPAnd(x, y): {
						pf = folPGet(a, ctx, der, f);
						da = folPEmit(a, folPImp(a, c, x), "syl",
							[sref(pf), sref(folPEmit(a, folPImp(a, f, x), "simpl", []))]);
						db = folPEmit(a, folPImp(a, c, y), "syl",
							[sref(pf), sref(folPEmit(a, folPImp(a, f, y), "simpr", []))]);
						rs = folPRoots(der, f);
						folPProve(a, kids[0], ctx, folPAdd(folPAdd(der, x, da, dep, rs), y, db, dep, rs));
					}
					default: folPBad(a);
				}
			} else if (rule == "∨L") {
				switch (f) {
					RuPOr(x, y): {
						pf = folPGet(a, ctx, der, f);
						rs = folPRoots(der, f);
						f1 = folPPush(a, ctx, der, x, rs);
						e1 = folPEmit(a, folPImp(a, c, RuPImp(x, fls)), "ex",
							[sref(folPProve(a, kids[0], f1.ctx, f1.der))]);
						f2 = folPPush(a, ctx, der, y, rs);
						e2 = folPEmit(a, folPImp(a, c, RuPImp(y, fls)), "ex",
							[sref(folPProve(a, kids[1], f2.ctx, f2.der))]);
						jd = folPEmit(a, folPImp(a, c, RuPImp(f, fls)), "jaod", [sref(e1), sref(e2)]);
						folPEmit(a, folPImp(a, c, fls), "mpd", [sref(pf), sref(jd)]);
					}
					default: folPBad(a);
				}
			} else if (rule == "→L") {
				switch (f) {
					RuPImp(x, y): {
						pf = folPGet(a, ctx, der, f);
						rs = folPRoots(der, f);
						f1 = folPPush(a, ctx, der, RuPNot(x), rs);
						ea = folPEmit(a, folPImp(a, c, x), "efald",
							[sref(folPProve(a, kids[0], f1.ctx, f1.der))]);
						f2 = folPPush(a, ctx, der, y, rs);
						eb = folPEmit(a, folPImp(a, c, RuPImp(y, fls)), "ex",
							[sref(folPProve(a, kids[1], f2.ctx, f2.der))]);
						m1 = folPEmit(a, folPImp(a, c, y), "mpd", [sref(ea), sref(pf)]);
						folPEmit(a, folPImp(a, c, fls), "mpd", [sref(m1), sref(eb)]);
					}
					default: folPBad(a);
				}
			} else if (rule == "↔L") {
				switch (f) {
					RuPIff(x, y): {
						pf = folPGet(a, ctx, der, f);
						// pproof appends the two directions SEPARATELY to gamma
						d1 = folPEmit(a, folPImp(a, c, RuPImp(x, y)), "syl",
							[sref(pf), sref(folPEmit(a, folPImp(a, f, RuPImp(x, y)), "biimp", []))]);
						d2 = folPEmit(a, folPImp(a, c, RuPImp(y, x)), "syl",
							[sref(pf), sref(folPEmit(a, folPImp(a, f, RuPImp(y, x)), "biimpr", []))]);
						rs = folPRoots(der, f);
						folPProve(a, kids[0], ctx,
							folPAdd(folPAdd(der, RuPImp(x, y), d1, dep, rs), RuPImp(y, x), d2, dep, rs));
					}
					default: folPBad(a);
				}
			} else if (rule == "¬R") {
				switch (f) {
					RuPNot(x): {
						nf = folPGet(a, ctx, der, RuPNot(f));
						da = folPEmit(a, folPImp(a, c, x), "syl",
							[sref(nf), sref(folPEmit(a, folPImp(a, RuPNot(f), x), "notnotr", []))]);
						folPProve(a, kids[0], ctx, folPAdd(der, x, da, dep, folPRoots(der, RuPNot(f))));
					}
					default: folPBad(a);
				}
			} else if (rule == "∧R") {
				switch (f) {
					RuPAnd(x, y): {
						nf = folPGet(a, ctx, der, RuPNot(f));
						rs = folPRoots(der, RuPNot(f));
						f1 = folPPush(a, ctx, der, RuPNot(x), rs);
						ea = folPEmit(a, folPImp(a, c, x), "efald",
							[sref(folPProve(a, kids[0], f1.ctx, f1.der))]);
						f2 = folPPush(a, ctx, der, RuPNot(y), rs);
						eb = folPEmit(a, folPImp(a, c, y), "efald",
							[sref(folPProve(a, kids[1], f2.ctx, f2.der))]);
						jj = folPEmit(a, folPImp(a, c, f), "jca", [sref(ea), sref(eb)]);
						folPContra(a, c, f, jj, nf);
					}
					default: folPBad(a);
				}
			} else if (rule == "∨R") {
				switch (f) {
					RuPOr(x, y): {
						nf = folPGet(a, ctx, der, RuPNot(f));
						d1 = folPEmit(a, folPImp(a, c, RuPNot(x)), "syl",
							[sref(nf), sref(folPEmit(a, folPImp(a, RuPNot(f), RuPNot(x)), "pm2.45", []))]);
						d2 = folPEmit(a, folPImp(a, c, RuPNot(y)), "syl",
							[sref(nf), sref(folPEmit(a, folPImp(a, RuPNot(f), RuPNot(y)), "pm2.46", []))]);
						rs = folPRoots(der, RuPNot(f));
						folPProve(a, kids[0], ctx,
							folPAdd(folPAdd(der, RuPNot(x), d1, dep, rs), RuPNot(y), d2, dep, rs));
					}
					default: folPBad(a);
				}
			} else if (rule == "→R") {
				switch (f) {
					RuPImp(x, y): {
						nf = folPGet(a, ctx, der, RuPNot(f));
						d1 = folPEmit(a, folPImp(a, c, x), "syl",
							[sref(nf), sref(folPEmit(a, folPImp(a, RuPNot(f), x), "simplim", []))]);
						d2 = folPEmit(a, folPImp(a, c, RuPNot(y)), "syl",
							[sref(nf), sref(folPEmit(a, folPImp(a, RuPNot(f), RuPNot(y)), "conax1", []))]);
						rs = folPRoots(der, RuPNot(f));
						folPProve(a, kids[0], ctx,
							folPAdd(folPAdd(der, x, d1, dep, rs), RuPNot(y), d2, dep, rs));
					}
					default: folPBad(a);
				}
			} else if (rule == "↔R") {
				switch (f) {
					RuPIff(x, y): {
						both = RuPAnd(RuPImp(x, y), RuPImp(y, x));
						nf = folPGet(a, ctx, der, RuPNot(f));
						ib = folPEmit(a, folPImp(a, RuPImp(x, y), RuPImp(RuPImp(y, x), f)), "impbi", []);
						im = folPEmit(a, folPImp(a, both, f), "imp", [sref(ib)]);
						c3 = folPEmit(a, folPImp(a, RuPNot(f), RuPNot(both)), "con3i", [sref(im)]);
						dd = folPEmit(a, folPImp(a, c, RuPNot(both)), "syl", [sref(nf), sref(c3)]);
						folPProve(a, kids[0], ctx, folPAdd(der, RuPNot(both), dd, dep, folPRoots(der, RuPNot(f))));
					}
					default: folPBad(a);
				}
			} else folPBad(a);
		}
	}
}

folPBad(a : FolPAcc) -> int {
	a.fail := true;
	folPEmit(a, FolPred("$false", []), "PCERT_BAD_RULE", []);
}

ruPCtains(fs : [RuPForm], f : RuPForm) -> bool { exists(fs, \x -> x == f); }

folPFol(f : RuPForm, atom : (string) -> FolForm) -> FolForm {
	folPForm(FolPAcc(ref [], atom, ref false, ref makeTree(), ref makeSet()), f);
}

folPCert(facts : [RuPForm], goal : RuPForm, atom : (string) -> FolForm) -> Maybe<[FolPStep]> {
	folPCertBounded(facts, goal, atom, 2000000000, 2000000000);
}

folPDerivNodes(d : RuPDeriv) -> int {
	switch (d) {
		RuPDAxiom(__, __): 1;
		RuPDRule(__, __, __, kids): fold(kids, 1, \acc, k -> acc + folPDerivNodes(k));
	}
}

// two passes: the first discovers which facts the refutation actually uses
// (lazy root projections), the second rebuilds over the used facts only —
// the context C then never mentions an unused fact. FolPRefFact indices stay
// the caller's ORIGINAL ones throughout.
folPCertBounded(facts0 : [RuPForm], goal : RuPForm, atom : (string) -> FolForm,
	maxNodes : int, maxSteps : int) -> Maybe<[FolPStep]> {
	all = mapi(facts0, \i, f -> Pair(f, i));
	switch (folPDoCert(all, goal, atom, maxNodes, maxSteps)) {
		None(): None();
		Some(p1): {
			if (sizeSet(p1.second) >= length(all)) Some(p1.first)
			else {
				kept = filter(all, \pr -> containsSet(p1.second, pr.second));
				switch (folPDoCert(kept, goal, atom, maxNodes, maxSteps)) {
					Some(p2): Some(p2.first);
					None(): Some(p1.first);
				}
			}
		}
	}
}

folPDoCert(factsI : [Pair<RuPForm, int>], goal : RuPForm, atom : (string) -> FolForm,
	maxNodes : int, maxSteps : int) -> Maybe<Pair<[FolPStep], Set<int>>> {
	facts = map(factsI, \p -> p.first);
	switch (ruPProveSeq(facts, [goal])) {
		None(): None();
		Some(dr): if (folPDerivNodes(dr) > maxNodes) None() else {
			a = FolPAcc(ref [], atom, ref false, ref makeTree(), ref makeSet());
			ctx0 = arrayPush(facts, RuPNot(goal));
			der0 = foldi(ctx0, makeTree(), \i, acc, f ->
				folPAdd(acc, f, -(i + 1), length(ctx0),
					if (i < length(factsI)) makeSet1(i) else makeSet()));
			rootIdx = folPProve(a, dr, ctx0, der0);
			fls : RuPForm = RuPFalse();
			if (facts == []) {
				c1 = folPEmit(a, folPImp(a, RuPNot(fls), goal), "con1i", [sref(rootIdx)]);
				fl = folPEmit(a, folPForm(a, RuPNot(fls)), "fal", []);
				folPEmit(a, folPForm(a, goal), "ax-mp", [sref(fl), sref(c1)]);
				{}
			} else {
				fc = folPConj(facts);
				exi = folPEmit(a, folPImp(a, fc, RuPImp(RuPNot(goal), fls)), "ex", [sref(rootIdx)]);
				cd = folPEmit(a, folPImp(a, fc, RuPImp(RuPNot(fls), goal)), "con1d", [sref(exi)]);
				fl = folPEmit(a, folPForm(a, RuPNot(fls)), "fal", []);
				mp = folPEmit(a, folPImp(a, fc, goal), "mpi", [sref(fl), sref(cd)]);
				start : Pair<FolPRef, RuPForm> = Pair(FolPRefFact(factsI[0].second), facts[0]);
				conj = foldi(tail(facts), start, \i, acc, f -> {
					nf = RuPAnd(acc.second, f);
					r : FolPRef = sref(folPEmit(a, folPForm(a, nf), "pm3.2i",
						[acc.first, FolPRefFact(factsI[i + 1].second)]));
					Pair(r, nf);
				});
				folPEmit(a, folPForm(a, goal), "ax-mp", [conj.first, sref(mp)]);
				{}
			}
			usedOrig = foldSet(^(a.used), makeSet(), \s, i ->
				if (i < length(factsI)) insertSet(s, factsI[i].second) else s);
			if (^(a.fail) || length(^(a.steps)) > maxSteps) None()
			else Some(Pair(^(a.steps), usedOrig));
		}
	}
}
