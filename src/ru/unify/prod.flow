import ru/prover/core/util;
import ru/unify/indexes;

import ru/util/src2s;

export {
	RuSubData(
		sub : RuSubst,
		data: ?
	);
	ruUnifySubsProd(
		prod : CartProd<RuSubData<?>>,
		admitExp : (RuExp) -> bool,
		math : RuMath, 
		env : RuEnv
	) -> [RuSubData<[?]>];

	ruUnifyProdSubs2s(
		prod : CartProd<RuSubData<?>>,
		math : RuMath
	) -> string;
}

RuSubsColumn(
	var : RuVar,
	rows : [RuIndex<int>]
);

RuSubsMatrix(
	cols : [RuSubsColumn]
);

ruSubsMatrix2s(matrix : RuSubsMatrix, math : RuMath) -> string {
	n_rows = if (matrix.cols == []) 0 else length(matrix.cols[0].rows);
	stringMatrix2s(
		map(matrix.cols, \col -> map(col.rows, \row -> ruIndex2s(row, i2s, math))),
		Some(map(matrix.cols, \col -> ru2s(col.var, math))),
		Some(map(enumFromTo(1, n_rows), \i -> "h_" + i2s(i)))
	);
}

ruMakeSubsMatrix(prod : CartProd<RuSubData<?>>) -> RuSubsMatrix {
	ruMakeSubsMatrixOf(prod, \__ -> true);
}

// Columns only for the variables `keep` admits (ruUnifySubsProd keeps the SHARED ones:
// bound in two or more variant substitutions; a variable bound in a single variant has
// a column that never filters any row combination).
ruMakeSubsMatrixOf(prod : CartProd<RuSubData<?>>, keep : (int) -> bool) -> RuSubsMatrix {
	vars = set2array(fold(prod.sets, makeSet(), \acc, ss ->
		fold(ss, acc, \ac, s ->
			mergeSets(ac, buildSet(filtermap(hashMapValues(s.sub.map), \se -> if (keep(se.var.id)) Some(se.var) else None())))
		)
	));
	make_cell = \v, ss -> {
		foldi(ss, ruMakeIndex(), \i, ac, s ->
			switch (ruLookupSubst(s.sub, v)) {
				Some(ex): ruSetIndex(ex, i, ac);
				None(): ruSetIndex(RuExp([v], -1), i, ac);
			}
		)
	}
	RuSubsMatrix(
		fold(vars, [], \acc, v ->
			concat(acc, 
				[RuSubsColumn(v,
					fold(prod.sets, [], \ac, ss ->
						concat(ac, [make_cell(v, ss)])
					)
				)]
			)
		)
	);
}

ruUnifyProdSubs2s(prod : CartProd<RuSubData<?>>, math : RuMath) -> string {
	ruSubsMatrix2s(ruMakeSubsMatrix(prod), math);
}

RuSubArrData(
	subs : [RuSubst],
	data : ?
);

ruIntersectCols(col1 : [RuSubArrData<[Set<int>]>], col2 : [RuUnified<[Set<int>]>], math : RuMath) -> [RuSubArrData<[Set<int>]>] {
	fold(col1, [], \acc, unif1 ->
		fold(col2, acc, \ac, unif2 -> {
				common = mapi(unif1.data, \i, d1 -> intersectSets(d1, unif2.data[i]));
				if (exists(common, isEmptySet)) ac else
				concat(ac, [RuSubArrData(concat(unif1.subs, [unif2.sub]), common)]);
			}
		)
	);
}

ruUnifiedCols2s(unified : [[RuUnified<[Set<int>]>]], matrix : RuSubsMatrix, math : RuMath) -> string {
	n_rows = if (matrix.cols == []) 0 else length(matrix.cols[0].rows);
	stringMatrix2s(
		map(unified, \col -> map(col, \row -> 
			"sub:\n" + ruSubst2s(row.sub, math) + "\n" + 
			"data:\n" + superglue(row.data, \set -> "{" + superglue(set2array(set), i2s, ", ") + "}", "\n")
		)),
		Some(map(matrix.cols, \col -> ru2s(col.var, math))),
		Some(map(enumFromTo(1, n_rows), \i -> "h_" + i2s(i)))
	);
}

ruUnifiedCols2s1(unified : [[RuUnified<[Set<int>]>]], matrix : RuSubsMatrix, math : RuMath) -> string {
	superglue(unified, 
		\col -> superglue(col, 
			\row -> 
				"sub:\n" + ruSubst2s(row.sub, math) + "\n" + 
				"data:\n" + superglue(row.data, \set -> "{" + superglue(set2array(set), i2s, ", ") + "}", "\n"), 
			"\n--------------\n"
		),
		"\n================\n"
	);
}

ruUnifiedCol2s1(col : [RuSubData<[Set<int>]>], math : RuMath) -> string {
	superglue(col, 
		\row -> 
			"sub:\n" + ruSubst2s(row.sub, math) + "\n" + 
			"data:\n" + superglue(row.data, \set -> "{" + superglue(set2array(set), i2s, ", ") + "}", "\n"), 
		"\n--------------\n"
	);
}

ruUnifySubsProd(prod : CartProd<RuSubData<?>>, admitExp : (RuExp) -> bool, math : RuMath, env : RuEnv) -> [RuSubData<[?]>] {
	subs = prod.sets;
	if (subs == [] || exists(subs, \s -> s == [])) [] else 
	if (length(subs) == 1) map(subs[0], \d -> RuSubData(d.sub, [d.data])) else {
		stats_on = ruOptsString(env.conf.opts, "reprove-stats", "") == "1";
		t_mx = ruMakeTimer();
		// How many variant substitutions bind each variable, over all hyps. A variable bound
		// in ONE variant only gets no column (it cannot filter: every other row reads it as
		// free); its binding is restored per row combination in `finalize` below. On dffi3
		// in hard mode this cut the matrices from ~900 columns to the few shared ones.
		// Counted per HYP (not per variant): a variable bound only by variants of one hyp
		// cannot filter across hyps either — its column just groups that hyp's variants.
		bind_count : Tree<int, int> = fold(subs, makeTree(), \acc, ss -> {
			hyp_vars = fold(ss, makeSet(), \ac, s -> foldHashMap(s.sub.map, ac, \v, __, a -> insertSet(a, v)));
			foldSet(hyp_vars, acc, \a, v -> setTree(a, v, lookupTreeDef(a, v, 0) + 1));
		});
		shared = \vid -> lookupTreeDef(bind_count, vid, 0) >= 2;
		uniques : [[RuSubst]] = map(subs, \ss -> map(ss, \s -> ruFilterSub(s.sub, \v, __ -> !shared(v.id))));
		// A row combination's unifier: the group's shared-variable unifier plus the chosen
		// variants' private bindings, unified together (private right-hand sides may mention
		// shared variables and vice versa).
		finalize = \group_sub : RuSubst, vect : [int] -> {
			parts = filter(mapi(vect, \i, n -> uniques[i][n]), \u -> sizeHashMap(u.map) > 0);
			maybeBind(
				if (parts == []) Some(group_sub) else ruUnifySubs(concat([group_sub], parts), math, env),
				\s3 -> if (ruSubSatisfies(s3, admitExp)) Some(s3) else None()
			);
		};
		matrix = ruMakeSubsMatrixOf(prod, shared);
		if (stats_on) {
			ruAddStats("prod-matrix", RuStatsRow("", pairs2tree([Pair("time", ruTimePassed(t_mx)), Pair("count", 1.0),
				Pair("cols", i2d(length(matrix.cols))), Pair("rows", i2d(length(subs)))])));
		}
		if (matrix.cols == []) {
			// No shared variable: every row combination stands on its own.
			idx_prod = CartProd(map(subs, \ss -> enumFromTo(0, length(ss) - 1)));
			filtermapCartProd(idx_prod, \vect ->
				maybeMap(finalize(ruEmptySubst, vect), \s -> RuSubData(s, mapi(vect, \i, n -> subs[i][n].data)))
			);
		} else {
			empty = ref false;
			unified = mapi(matrix.cols, 
				\i, col -> {
					size = fold(col.rows, 1, \acc, ind -> acc * ruIndexDataCount(ind));
					t_col = ruMakeTimer();
					uns = ruUnifyIndexes(col.rows, ruEmptySubst, math, env);
					if (stats_on) {
						ruAddStats("prod-column", RuStatsRow("", pairs2tree([Pair("time", ruTimePassed(t_col)), Pair("count", 1.0),
							Pair("size", i2d(size)), Pair("rets", i2d(length(uns)))])));
					}
					unif_col = filtermap(uns, \unif -> {
						switch (ruLookupSubst(unif.sub, col.var)) {
							None(): 
								maybeBind(ruAdd2Subst1(unif.sub, col.var, unif.expr, math, env), \s ->
									if (ruSubSatisfies(s, admitExp)) {
										Some(RuUnified(s, unif.data, ruApplySubst(unif.expr, s)));
									} else {
										None();
									}
								);
							Some(ex): {
								maybeBind(ruUnifyExps([unif.expr, ex], unif.sub, math, env), \un -> 
									maybeBind(ruCompose(unif.sub, un), \s ->
										if (ruSubSatisfies(s, admitExp)) {
											Some(RuUnified(s, unif.data, ruApplySubst(ex, s)));
										} else {
											None();
										}
									)
								);
							}
						}
					});
					if (unif_col == []) {
						empty := true;
					}
					unif_col
				}
			);
			dbg = ruOptsString(env.conf.opts, "unify-prod-check", "") == "1" && sizeCartProd(prod) <= 8;
			if (dbg) {
				env.out.println("PROD-TRACE columns (" + i2s(length(matrix.cols)) + "): " + strGlue(map(matrix.cols, \c -> ru2s(c.var, math)), " ") +
					"\n" + strIndent(ruUnifiedCols2s1(unified, matrix, math)));
			}
			if (^empty) [] else {
				t_int = ruMakeTimer();
				inter_cols = fold(
					tail(unified), 
					map(unified[0], \unif -> RuSubArrData([unif.sub], unif.data)), 
					\acc, col -> ruIntersectCols(acc, col, math)
				);
				if (stats_on) {
					ruAddStats("prod-intersect", RuStatsRow("", pairs2tree([Pair("time", ruTimePassed(t_int)), Pair("count", 1.0),
						Pair("rets", i2d(length(inter_cols))), Pair("size", i2d(fold(unified, 0, \a, c -> a + length(c))))])));
				}
				t_fold = ruMakeTimer();
				// One n-ary unification per row group. The former PAIRWISE fold threaded up to
				// ~900 one-binding column unifiers through ruUnifySubs one at a time, re-resolving
				// the growing accumulator at every step: 158 of 180 summed seconds on dffi3 in
				// hard mode (a single group of 128 rows x 922 columns took 29 s). ruUnifySubs
				// splits an array of substitutions in one linear pass.
				intersected = filtermap(inter_cols, \ss -> {
					r = ruUnifySubs(ss.subs, math, env);
					if (dbg) {
						env.out.println("PROD-TRACE unify-group of " + i2s(length(ss.subs)) + " column unifiers => " +
							switch (r) { Some(s3): "\n" + strIndent(strIndent(ruSubst2s(s3, math))); None(): "FAIL"; });
					}
					maybeMap(
						maybeBind(r, \s3 -> if (ruSubSatisfies(s3, admitExp)) Some(s3) else None()),
						\s -> RuSubData(s, ss.data)
					)
				});
				if (stats_on) {
					ruAddStats("prod-fold", RuStatsRow("", pairs2tree([Pair("time", ruTimePassed(t_fold)), Pair("count", 1.0),
						Pair("rets", i2d(length(intersected))), Pair("size", i2d(fold(inter_cols, 0, \a, ss -> a + length(ss.subs))))])));
				}
				fold(intersected, [],
					\acc, unif -> {
						ret_prod = CartProd(map(unif.data, \d -> set2array(d)));
						concat(acc, filtermapCartProd(ret_prod, \v ->
							maybeMap(finalize(unif.sub, v), \s -> RuSubData(s, mapi(v, \i, n -> subs[i][n].data)))
						))
					}
				);
			}
		}
	}
}
