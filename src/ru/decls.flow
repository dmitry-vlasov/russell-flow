import ru/src;
import ru/lang;

export {
	// `gen` = a GLOBALLY UNIQUE stamp of this assertion set, minted by ruNextDeclsGen() at every
	// construction that changes `assertions`. It exists to be an O(1) CACHE KEY: the registry
	// caches (unfold, setness, congruence, rule/type tables, instantiate, equalizer_plan, dsl, …)
	// all keyed themselves on `sizeTree(math.decls.assertions)` — a full O(n) walk of ~9800
	// assertions computed on EVERY lookup, which the profile put at 8.9% of prover time in
	// ruInTables alone.
	// UNIQUE, not merely incremented: a restricted math (a filtered assertion set built with
	// `RuDecls(decls with …)`) would otherwise inherit its parent's stamp and read the parent's
	// tables. A size key happened to catch that case; a shared counter would not.
	RuDecls(
		lang       : RuLang,
		assertions : Tree<int, RuAssertion>,
		gen        : int
	);
	// mint a fresh stamp — call it whenever `assertions` changes
	ruNextDeclsGen() -> int;

	ruEmptyDecls = RuDecls(ruEmptyLang, makeTree(), 0);
}

ruDeclsGenCounter : ref int = ref 0;

ruNextDeclsGen() -> int {
	ruDeclsGenCounter := ^ruDeclsGenCounter + 1;
	^ruDeclsGenCounter;
}
