import ru/prover/core/prove;
import ru/prover/core/util;
import ru/prover/core/relevance;
import ru/prover/tactics/breadth_first;
import ru/prover/tactics/dsl;
import ru/prover/core/stats;
import ru/prover/core/fragment;
import ru/prover/ml/premise_selector;
import ru/util/normalize;
import ru/util/src;
import ru/util/utils;
import ru/map_decls;
import comm;

export {
	ruCommProve : RuComm;
}

ruCommProve = RuComm(
	RuCommInfo(
		"prove", "prover",
		"prove theorems with a tactic and write found proofs back",
		"target", true, false,
		concat([
			RuCommArg("target",                true,  "the target: a theorem, file or all",                                             "all"),
			RuCommArg("max-depth",             true,  "max proof tree depth (used by the default tactic)",                              "5"),
			RuCommArg("max-size",              true,  "max proof tree size (used by the default tactic)",                               "4096"),
			RuCommArg("time-limit",            true,  "per-theorem wall-clock limit (e.g. 60s, 5m)",                                    "60s"),
			RuCommArg("job-time-limit",        true,  "total wall-clock cap for the whole job (empty = n*time-limit/p)",                ""),
			RuCommArg("fragment-depth",        true,  "fragment-index depth (>0 enables fragment-replay tactic atoms)",                 "0"),
			RuCommArg("forward-closure-depth", true,  "shallow forward proof search: depth of premise closure (0 disables; 1-3 typical)", "0"),
			RuCommArg("forward-closure-size",  true,  "max number of facts in the forward closure index",                               "1024"),
			RuCommArg("tactic",                true,  "tactic DSL expression; if empty, bounded-bfs(max-depth, max-size) is used",      ""),
			RuCommArg("steps",                 true,  "1 = prove each open `?` proof step (gap) and install it, instead of the whole statement", "0"),
			RuCommArg("max-proof-steps",       true,  "steps mode: skip installing a gap proof larger than this many steps (0 = no cap)",        "256"),
			RuCommArg("min-index-rule-nodes",  true,  "min rule-node count for step index entries (1 = index all steps)",                 "1"),
			RuCommArg("relevance-depth",       true,  "SInE premise-selection rounds (0 = off = whole foundation; 1-3 typical)",          "0"),
			RuCommArg("relevance-tolerance",   true,  "SInE trigger tolerance (>=1; higher = more premises kept)",                        "1.2"),
			RuCommArg("relevance-ubiq",        true,  "fraction of assertions a symbol must hit to count as ubiquitous logical glue",     "0.4"),
			RuCommArg("exclude-disjointed",    true,  "drop disjoint-variable theorems from scope (efficiency; soundness is type-level)", "1")
		], ruMapFnCommArgs), []
	),
	ruRunProve
);

ruRunProve(unit : RuUnit) -> Maybe<RuState> {
	env   = ruUnitEnv(unit);
	task  = unit.task;
	state = unit.state;
	conf  = state.conf;
	math  = ruMathFromSources(state.ru, env);
	target = ruDetermineTarget(task, math, env);
	if (target == RuTargetNone()) {
		env.out.error("prove: no target", []);
		Some(state);
	} else {
		rel_depth      = ruTaskIntArg(task, "relevance-depth", 0);
		index          = if (rel_depth <= 0) ruMakeIndexForTarget(target, math, env)
			else switch (target) {
				RuTargetDecl(decl): switch (decl) {
					RuTheorem(__, __, __, __): {
						goalSyms = ruAssertionSymbols(decl);
						tol  = ruTaskDoubleArg(task, "relevance-tolerance", 1.2);
						ubiq = ruTaskDoubleArg(task, "relevance-ubiq", 0.4);
						log_max = ruTaskIntArg(task, "relevance-logical-steps", 6);
						scope = ruRelevantAssertions(goalSyms, math.decls.assertions, tol, ubiq, rel_depth, log_max);
						// Efficiency knob (NOT soundness — the foundation now distinguishes setvar, so
						// the type-correct unifier rejects substituting a term for a setvar; a disjoint-
						// variable theorem can no longer be misapplied). DV theorems rarely help first-
						// order Mizar gaps and widen the scope, so drop them by default; =0 keeps them.
						no_dv = ruTaskBoolArg(task, "exclude-disjointed", true);
						dvIds = if (!no_dv) makeSet() else foldTree(math.decls.assertions, makeSet(),
							\id, ass, acc -> if (sizeSet(ass.infer.vars.disjs) == 0) acc else insertSet(acc, id));
						env.out.println("relevance: scoped to " + i2s(sizeSet(scope)) + " / " +
							i2s(sizeTree(math.decls.assertions)) + " assertions (depth " + i2s(rel_depth) +
							(if (no_dv) ", −" + i2s(sizeSet(dvIds)) + " disjoint-conditioned" else "") + ")");
						ruInitTheoremAssertionsIndexKeep(decl, math, env,
							\id -> containsSet(scope, id) && !containsSet(dvIds, id));
					}
					default: ruMakeIndexForTarget(target, math, env);
				}
				default: ruMakeIndexForTarget(target, math, env);
			};
		max_frag_depth = ruTaskIntArg(task, "fragment-depth", 0);
		frag_pair      = if (max_frag_depth > 0)
			Some(ruBuildFragments(math, max_frag_depth, env))
		else None();
		tactic_src_early = ruTaskStringArg(task, "tactic", "");
		min_rule_nodes = ruTaskIntArg(task, "min-index-rule-nodes", 1);
		step_index = if (strContains(tactic_src_early, "spr") || strContains(tactic_src_early, "linear-guided"))
			Some(ruBuildStepIndex(math, min_rule_nodes))
		else None();
		ctx = RuTacticContext(math, env, step_index, None());
		tactic_str = ruTaskStringArg(task, "tactic", "");
		default_builder = ruStaticTacticBuilder(ruDefaultProveTactic(task));
		builder : RuTacticBuilder = if (tactic_str != "") {
			switch (ruParseAndBuildTactic(tactic_str, ctx)) {
				Some(b): b;
				None():  default_builder;
			}
		} else default_builder;

		per_th_ms      = ruParseTime(ruTaskStringArg(task, "time-limit", "60s"));
		steps_mode     = ruTaskBoolArg(task, "steps", false);
		proved_count   = ref 0;
		finished_count = ref 0;
		steps_closed   = ref 0;
		steps_total    = ref 0;
		started_ids    : ref [int] = ref [];
		proved_ids     : ref [int] = ref [];
		inc_proved     = ruAtomicIntInc(proved_count);
		inc_finished   = ruAtomicIntInc(finished_count);
		add_closed     = ruAtomicIntAdd(steps_closed);
		add_total      = ruAtomicIntAdd(steps_total);
		push_started   = ruAtomicRefArrayPush(started_ids);
		push_proved    = ruAtomicRefArrayPush(proved_ids);

		prove_fn = \decl, time_limit, env1 -> {
			th = cast(decl : RuDecl -> RuTheorem);
			th_timer = ruMakeTimer();
			push_started(th.info.id);
			// Cap at per_th_ms so retries cannot exceed the user-intended per-theorem limit.
			capped_limit = min(time_limit, per_th_ms);
			if (steps_mode) {
				// Per-step proving: close each open `?` gap `(hyps + prior steps) ⊢ step.stmt`
				// and install the found proof as a lemma step. A theorem counts as "proved"
				// only when EVERY step closes (the verifier then sees no problem steps).
				r = ruProveTheoremSteps(th, index, builder, ctx, capped_limit, ruTaskIntArg(task, "max-proof-steps", 256), task.args, math, env1);
				th2 = r.first; nclosed = r.second.first; ntotal = r.second.second;
				inc_finished(1);
				add_closed(nclosed); add_total(ntotal);
				if (ntotal > 0 && nclosed == ntotal) { inc_proved(1); push_proved(th.info.id); };
				// No outer normalize: each gap proof is normalized self-contained inside
				// ruProveTheoremSteps, so its fresh vars/disjs stay in the lemma sub-proof.
				RuMappedDecl(true, nclosed > 0, th2);
			} else {
			goal = if (ruTheoremIsProved(th)) ruProofQedStep(th.proof)
			       else RuStep(-1, -1, [], th.infer.prop, ruNoProof, "", -1);
			prover_task = RuProverTask(th.info, ruDoneTactic, id2s(th.info.id), task.args, th.infer.hyps, goal);
			penv_pre = switch (frag_pair) {
				Some(fp): ruInitProverEnvWithFrags(prover_task, math, env1, index, capped_limit, fp);
				None():   ruInitProverEnv(prover_task, math, env1, index, capped_limit);
			};
			built = builder.build(penv_pre);
			penv0 = built.first;
			penv0.tactic := Some(built.second);
			penv1 = ruExpandHyp(penv0.tree.root, penv0);
			penv2 = ruProve(penv1);
			inc_finished(1);
			switch (ruProverEnvProof(penv2.tree)) {
				Some(proof): {
					inc_proved(1);
					push_proved(th.info.id);
					proved_th = ruNormalizeTheoremVarsDisjs(RuTheorem(th with proof = proof));
										RuMappedDecl(true, true, proved_th);
				}
				None(): {
										RuMappedDecl(true, false, decl);
				}
			}
			}
		};

		// Proving is internally concurrent (ruProve uses ruConcurrent); running
		// multiple theorems concurrently at the outer level causes nested
		// thread-pool contention. Force sequential outer traversal via -seq.
		// Scale the total budget by min(n, nProc) so that each theorem gets
		// per_th_ms * min(n, nProc) / n ≈ per_th_ms / density — the same budget
		// the old concurrent dispatch provided (time * nProc / n), without OOM.
		n_theorems     = length(filter(ruTargetDecls(target, math, env), ruDeclIsTheorem));
		n_par          = availableProcessors();
		computed_total = per_th_ms * i2d(min(max(1, n_theorems), n_par));
		job_limit_str  = ruTaskStringArg(task, "job-time-limit", "");
		total_ms       = if (job_limit_str != "" && job_limit_str != "no") min(computed_total, ruParseTime(job_limit_str)) else computed_total;
		seq_task = RuTask(task with args =
			setTree(
				setTree(task.args, "target", ruTaskStringArg(task, "target", "all") + "-seq"),
				"time-limit", ruTime2s(total_ms)
			)
		);
		new_state = ruMapFnComm(
			RuUnit(seq_task, state, env.out),
			RuMapFn(
				RuMapFnInfo(
					"prove",
					\decl -> ruTargetPredicate(target)(decl) && ruDeclIsTheorem(decl),
					\__ -> 1.0,
					\ -> if (steps_mode)
							"closed " + i2s(^steps_closed) + "/" + i2s(^steps_total) + " steps, " + i2s(^proved_count) + " fully proved"
							else "proved: " + i2s(^proved_count) + " theorems"
				),
				prove_fn
			)
		);
		// Compute not-proved as started − proved (catches both search failures
		// and theorems that timed out before prove_fn could complete).
		if (steps_mode) {
			st = ^steps_total; sc = ^steps_closed;
			env.out.println("prove steps: closed " + i2s(sc) + "/" + i2s(st) + " steps = " +
				i2s(if (st == 0) 0 else 100 * sc / st) + "%, " + i2s(^proved_count) + " theorems fully proved");
		};
		proved_set = buildSet(^proved_ids);
		not_proved = set2array(fold(^started_ids, makeSet(), \acc, id ->
			if (containsSet(proved_set, id)) acc else insertSet(acc, id)
		));
				if (not_proved != []) {
			env.out.error("prove: not proved: " + strGlue(map(not_proved, id2s), ", "), []);
		}
		Some(RuState(new_state with
			vars = setTree(new_state.vars, "prove", pairs2tree([
				Pair("proved-count",    flow(^proved_count)),
				Pair("failed-count",    flow(length(not_proved))),
				Pair("failed-theorems", flow(map(not_proved, id2s)))
			]))
		))
	}
}

// Prove each open `?` step of a theorem skeleton in order. For step i the gap is
// `(hyps + prior steps) ⊢ step.stmt`; on success the found sub-proof is installed as a
// LEMMA step (assertion = ruStepLemma) whose refs list the premises in the SAME order the
// prover saw them — RuHypRef for the theorem's hyps, then RuStepRef for the prior steps —
// so the sub-proof's hyp-refs resolve correctly at verify time (ruRefPremise). Returns the
// updated theorem and (steps closed, steps total). Already-closed steps are kept as-is.
ruProveTheoremSteps(
	th : RuTheorem, index : RuIndex<RuAssertion>, builder : RuTacticBuilder, ctx : RuTacticContext,
	limit : double, max_steps : int, args : Tree<string, flow>, math : RuMath, env : RuEnv
) -> Pair<RuTheorem, Pair<int, int>> {
	hyps  = th.infer.hyps;
	nh    = length(hyps);
	// Skeleton `?` step stmts carry class -1; the real statement class is the prop's (`|-`). The
	// prover's conclusion inherits the goal's class, and lemma refs resolve against the stored step
	// stmts, so normalize EVERY step's class (open or closed) to the prop class for consistency.
	scls   = th.infer.prop.class;
	fixCls = \s : RuStmt -> RuStmt(s with class = scls);
	steps  = map(th.proof.steps, \st -> RuStep(st with stmt = fixCls(st.stmt)));
	premHyps = map(hyps, \h -> RuHyp(h.ind, fixCls(h.stmt), h.pos));
	// Accumulate theorem-var disjoint provisos that normalizing a gap proof pushes out of the sub-proof
	// (both ends are theorem vars, so they belong on the theorem, not the lemma) — promoted to the
	// inference below, else the verifier rejects them ("restrictions not present in inherited").
	promoted_disjs : ref Set<RuDisj> = ref makeSet();
	acc = foldi(steps, Pair([], 0), \i, ac : Pair<[RuStep], int>, step -> {
		done    = ac.first;
		nclosed = ac.second;
		if (step.assertion != ruStepProblem) Pair(arrayPush(done, step), nclosed + 1)
		else {
			premises : [RuPremise] = concat(premHyps, take(steps, i));
			goal = RuStep(-1, ruStepLemma, [], step.stmt, ruNoProof, "", -1);
			header = "step " + i2s(i + 1) + " of " + id2s(th.info.id);
			task = RuProverTask(th.info, ruDoneTactic, header, args, premises, goal);
			penv_pre = ruInitProverEnv(task, math, env, index, limit);
			// Inline per-step tactic (e.g. `? ap(...) |- ...`) overrides the command-level tactic
			// for this step; fall back to the command tactic if absent or unparseable.
			stepBuilder = if (step.tactic == "") builder
				else switch (ruParseAndBuildTactic(step.tactic, ctx)) { Some(b): b; None(): builder; };
			built = stepBuilder.build(penv_pre);
			penv0 = built.first;
			penv0.tactic := Some(built.second);
			penv2 = ruProve(ruExpandHyp(penv0.tree.root, penv0));
			switch (ruProverEnvProof(penv2.tree)) {
				Some(pf): {
					refs : [RuRef] = concat(
						map(enumFromTo(0, nh - 1), \j -> RuHypRef(j)),
						map(enumFromTo(0, i - 1),  \j -> RuStepRef(j))
					);
					// Make the gap proof self-contained: normalize it as a standalone derivation
					// `(premises ⊢ step.stmt)` so its own fresh setvars + disjoint provisos (the
					// equalizer's goal-side ⊆/= unfold) land IN the sub-proof's vars — the verifier
					// checks a lemma step's sub-proof with only its own vars, not the outer theorem's.
					tmpTh = RuTheorem(th.info, RuInference(ruEmptyVarsDisjs, premises2hyps(premises), step.stmt), makeSet(), pf);
					normTh = ruNormalizeTheoremVarsDisjs(tmpTh);
					subProof = normTh.proof;
					// SAFETY NET: a tactic may CONSTRUCT a proof by hand (the `checker` assembles ax-gen /
					// mpbir / membership-unfold steps and injects them, bypassing the engine's
					// by-construction validity). Re-verify the gap proof here — the verifier re-derives it
					// by substitution — and if it does not check, leave the step OPEN rather than install an
					// invalid proof. So a construction bug yields "unproven", never a disproved theorem.
					verified = length(ruVerifyTheorem(normTh, math, env).errs) == 0;
					// Reject pathologically large proofs (the Kalmár closer is exponential — a single
					// goal can blow up to thousands of opaque steps, which bloats the file and overflows
					// the writer). Such a step is left OPEN rather than installed. max_steps<=0 = no cap.
					if ((max_steps > 0 && ruProofSize(subProof) > max_steps) || !verified) Pair(arrayPush(done, step), nclosed)
					else {
						// Capture the DVs normalization moved to the inference (those over step vars, which
						// are theorem/premise vars) so a theorem-var DV the proof needs isn't silently dropped.
						promoted_disjs := mergeSets(^promoted_disjs, normTh.infer.vars.disjs);
						// If the sub-proof is a single direct assertion application that yields exactly
						// this step's statement, collapse the lemma wrapper into a plain step (e.g.
						// `step i = lemma() |- P proof { step 1 = ssun1() |- P }` becomes `step i = ssun1() |- P`).
						// Remap the leaf's premise refs (RuHypRef into the premise list) to the outer-scope
						// refs `refs[j]` (hyps + prior steps), the same premise->ref map used for the lemma.
						closed = if (length(subProof.steps) == 1 && subProof.steps[0].assertion >= 0
							&& ruEqualStmts(subProof.steps[0].stmt, step.stmt)) {
							leaf = subProof.steps[0];
							leafRefs = map(leaf.refs, \r -> switch (r) {
								RuHypRef(j): elementAt(refs, j, r);
								RuStepRef(__): r; // a single-step proof has no prior steps to reference
							});
							RuStep(step with assertion = leaf.assertion, refs = leafRefs, proof = ruNoProof);
						} else {
							RuStep(step with assertion = ruStepLemma, refs = refs, proof = subProof);
						}
						Pair(arrayPush(done, closed), nclosed + 1);
					}
				}
				None(): Pair(arrayPush(done, step), nclosed);
			}
		}
	});
	new_proof = RuProof(th.proof with steps = acc.first);
	// Promote the captured DVs that are OVER THEOREM VARS into the theorem's inference. A DV between two
	// theorem vars — e.g. eq0 forcing disjointed(x4 x7) in t7_xboole_0, inherent to the statement — must
	// be DECLARED on the theorem (the sub-proof can't hold it: x4/x7 aren't in its frame) or the verifier
	// rejects it. Fresh-var DVs are excluded (both ends must be theorem vars; those stay in the sub-proof).
	th_var_set = ruAssertion2Vars(th);
	promoted = filterSet(^promoted_disjs,
		\d -> containsSet(th_var_set, d.v1) && containsSet(th_var_set, d.v2));
	new_th = RuTheorem(th with
		infer = RuInference(th.infer with vars = RuVarsDisjs(th.infer.vars.vars, mergeSets(th.infer.vars.disjs, promoted))),
		proof = new_proof
	);
	Pair(new_th, Pair(acc.second, length(steps)));
}

// Premises (hyps ++ prior steps) re-expressed as positional hyps for the standalone sub-proof.
premises2hyps(premises : [RuPremise]) -> [RuHyp] {
	mapi(premises, \j, p -> RuHyp(j, ruPremiseStmt(p), -1));
}

ruPremiseStmt(p : RuPremise) -> RuStmt {
	switch (p) {
		RuHyp(__, stmt, __):        stmt;
		RuStep(__, __, __, stmt, __, __, __): stmt;
	}
}

ruDefaultProveTactic(task : RuTask) -> RuProverTactic {
	max_depth = ruTaskIntArg(task, "max-depth", 5);
	max_size  = ruTaskIntArg(task, "max-size",  4096);
	ruBoundedBFSTactic(max_depth, max_size)
}
