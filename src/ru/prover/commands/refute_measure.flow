import ru/prover/tactics/refute;
import ru/prover/tactics/equalizer;   // ruStripForall
import ru/util/math;                  // ruMathFromSources
import ru/util/exp;                   // ruExp
import comm;

// PHASE 1 measurement (project_mizar_proving_stats): for each theorem of `module` in the loaded base,
// decide `hyps |- prop` with the refutation decider (ruRefuteEntails) and report which it would close.
// Read-only oracle measure — NO proofs produced — to estimate the ceiling of the Mizar-style checker
// before building certificate extraction. Usage: read miz_set + the article, then
//   refute-gaps module=xboole_1
export {
	ruCommRefuteGaps : RuComm;
}

ruCommRefuteGaps = RuComm(
	RuCommInfo(
		"refute-gaps", "prover",
		"PHASE-1 oracle: count theorems of module=<m> the refutation decider would close (no proofs)",
		"module", false, false,
		[RuCommArg("module", true, "article suffix, e.g. xboole_1 (matches theorem names *_<module>)", "")], []
	),
	ruRunRefuteGaps
);

ruRunRefuteGaps(unit : RuUnit) -> Maybe<RuState> {
	env    = ruUnitEnv(unit);
	state  = unit.state;
	module = ruTaskStringArg(unit.task, "module", "");
	math   = ruMathFromSources(state.ru, env);
	suffix = "_" + module;
	refuted = foldTree(math.decls.assertions, [], \id, ass, acc -> switch (ass) {
		RuTheorem(info, infer, __, __): {
			name = id2s(info.id);
			if (!endsWith(name, suffix)) acc
			else {
				hyps = map(infer.hyps, \h -> ruExp(h.stmt.exps[0]));
				goal = ruStripForall(ruExp(infer.prop.exps[0])).first;
				if (ruRefuteEntails(hyps, goal)) concat(acc, [name]) else acc;
			}
		}
		default: acc;
	});
	env.out.println("REFUTE-GAPS module=" + module + " refuted=" + i2s(length(refuted)));
	env.out.println("  " + strGlue(sort(refuted), ", "));
	Some(state);
}
