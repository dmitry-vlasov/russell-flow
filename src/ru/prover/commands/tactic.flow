import ru/prover/tactics/dsl;
import ru/prover/tactics/tac_file;
import base/task;
import comm;

// The `tactic` command: a front door to the per-component tactic annotations (ruTacticHelp), which were
// otherwise only reachable via the unknown-atom parse error. No args → print the whole annotated list of
// tactic components (atoms + combinators + selectors); `name=<atom>` → print the matching component's
// annotation. Read-only: it never touches the math base, so it works from anywhere.
export {
	ruCommTactic : RuComm;
}

ruCommTactic = RuComm(
	RuCommInfo(
		"tactic", "prover",
		"list tactic components (atoms + combinators), or describe one with name=<atom>",
		"name", false, false,
		[RuCommArg("name", true, "tactic component name; empty = list all components", "")], []
	),
	ruRunTactic
);

ruRunTactic(unit : RuUnit) -> Maybe<RuState> {
	env  = ruUnitEnv(unit);
	name = ruTaskStringArg(unit.task, "name", "");
	out  = if (name == "") {
		// Built-in components + the file-based (.tac) tactics under tactics/.
		ruTacticHelpLookup("") + "\n\nFile tactics (tactics/*.tac); `tactic name=<x>` for details:" + ruFileTacticsTable(env);
	} else if (!ruIsBuiltinTacticName(name)) {
		// A non-built-in name may be a .tac file — show its @help/@arg metadata; else fall back to the
		// built-in lookup (categories, substring match, or the not-found note + full list).
		switch (ruLoadTacFile(name, env)) {
			Some(tf): ruCommInfo2s(tf.info, true);
			None():   ruTacticHelpLookup(name);
		}
	} else ruTacticHelpLookup(name);
	env.out.println(out);
	Some(unit.state);
}
