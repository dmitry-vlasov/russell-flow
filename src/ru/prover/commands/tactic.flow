import ru/prover/tactics/dsl;
import base/task;
import comm;

// The `tactic` command: a front door to the per-component tactic annotations (ruTacticHelp), which were
// otherwise only reachable via the unknown-atom parse error. No args → print the whole annotated list of
// tactic components (atoms + combinators + selectors); `name=<atom>` → print the matching component's
// annotation. Read-only: it never touches the math base, so it works from anywhere.
export {
	ruCommTactic : RuComm;
}

ruCommTactic = RuComm(
	RuCommInfo(
		"tactic", "prover",
		"list tactic components (atoms + combinators), or describe one with name=<atom>",
		"name", false, false,
		[RuCommArg("name", true, "tactic component name; empty = list all components", "")], []
	),
	ruRunTactic
);

ruRunTactic(unit : RuUnit) -> Maybe<RuState> {
	env  = ruUnitEnv(unit);
	name = ruTaskStringArg(unit.task, "name", "");
	env.out.println(ruTacticHelpLookup(name));
	Some(unit.state);
}
