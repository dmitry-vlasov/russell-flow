import ru/prover/tactics/unifier_plan;
import ru/prover/tactics/unifier_gen;
import ru/verify/math;
import ru/math;
import comm;
import base/ids;

// UNIFIER-PROBE — measure the Unifier planner's DECISION coverage over one article's
// theorems, with no PVT and no proof construction: for each theorem whose (∀-stripped)
// statement is NOT a plain equality (the Equalizer's fragment), run the planner's
// decision core (ruUnfPlanDecide) against the article-scope universal premises. This is
// the acceptance instrument for the Unifier planner, before any generator exists:
// "does the transcribed Mizar PreCheck+Equate+Unification DECIDE these goals?"
//
//   russellj no-server=1 <read the article first> unifier-probe target=xboole_1

export {
	ruCommUnifierProbe : RuComm;
}

ruCommUnifierProbe = RuComm(
	RuCommInfo(
		"unifier-probe", "prover",
		"measure the Unifier planner's decision coverage over an article's non-equality theorems",
		"target", false, false,
		[RuCommArg("target", false, "the article source module (e.g. xboole_1)", ""),
		 RuCommArg("th", true, "probe only this theorem (name), e.g. t8_xboole_1", ""),
		 RuCommArg("steps", true, "1 = probe skeleton GAP STEPS (goal = step, premises = hyps + prior steps + the step's by-list) — the actual checker workload", "0"),
		 RuCommArg("max-clauses", true, "DNF clause cap (Mizar LatOvfl analogue)", "64"),
		 RuCommArg("max-substs", true, "substitution collection cap", "128"),
		 RuCommArg("budget-ms", true, "per-theorem decision budget, ms", "2000")],
		[RuCommRet("unifier-probe.decided", "int", "non-equality theorems the planner decides"),
		 RuCommRet("unifier-probe.goals", "int", "theorems whose statement is not an equality"),
		 RuCommRet("unifier-probe.total", "int", "theorems in the article")]
	),
	ruRunUnifierProbe
);

ruRunUnifierProbe(unit : RuUnit) -> Maybe<RuState> {
	env   = ruUnitEnv(unit);
	state = unit.state;
	math  = ruMathFromSources(state.ru, env);
	target = ruTaskStringArg(unit.task, "target", "");
	srcM = switch (lookupTree(math.sources, s2id(target))) {
		Some(s): Some(s);
		None(): foldTree(math.sources, None(), \__, s, acc ->
			if (isSome(acc)) acc
			else if (s.info.module == target || endsWith(s.info.module, "/" + target)) Some(s) else acc);
	}
	switch (srcM) {
		None(): {
			env.out.error("unifier-probe: source '" + target + "' is not loaded", []);
			Some(state);
		}
		Some(src): {
			thName = ruTaskStringArg(unit.task, "th", "");
			maxClauses = ruTaskIntArg(unit.task, "max-clauses", 64);
			maxSubsts = ruTaskIntArg(unit.task, "max-substs", 128);
			budgetMs = i2d(ruTaskIntArg(unit.task, "budget-ms", 2000));
			theorems = filtermap(src.decls, \d -> switch (d) {
				RuTheorem(info, __, __, __):
					if (thName == "" || id2s(info.id) == thName) Some(d) else None();
				default: None();
			});
			if (ruTaskIntArg(unit.task, "steps", 0) == 1) {
				ruUnfProbeSteps(env, state, math, target, theorems, maxClauses, maxSubsts, budgetMs);
			} else {
			timer = ruMakeTimer();
			// refutation-kind census over decided theorems (which machinery carries)
			byPrem = ref 0; byClash = ref 0; byEq = ref 0; byTriv = ref 0;
			counts = fold(theorems, Pair(0, 0), \acc : Pair<int, int>, th -> {
				prop = ruExp(th.infer.prop.exps[0]);
				matrix = ruEqzStripAlls(prop);
				isEq = ruInHead(matrix) == s2id("wceq") && ruInArity(matrix) == 2;
				if (isEq) {
					if (ruVerbose(env.conf) > 1) {
						env.out.println("  - " + id2s(th.info.id) + ": an equality goal (Equalizer's)");
					}
					acc;
				} else {
					prems0 = ruUnfScopePremises(math, env, th.info);
					// THE BY-LIST (carried from the Mizar XML as `by(...)` step annotations):
					// when present, the premise set is EXACTLY the citations plus the
					// always-available definitions (Mizar's InferConstDef). No by-list ->
					// article premises only (foundation wholesale floods).
					byRefs = fold(th.proof.steps, makeSet(), \bacc, st -> {
						t = trim2(st.tactic, " ");
						if (!startsWith(t, "by(")) bacc
						else fold(strSplit(substring(t, 3, strlen(t) - 4), ","), bacc, \ba, r -> {
							rn = trim2(r, " ");
							if (rn == "") ba else insertSet(ba, rn);
						});
					});
					isDef = \nm : string -> startsWith(nm, "d") && strlen(nm) > 1
						&& isDigits(substring(nm, 1, 1)) && strContains(nm, "_");
					prems = if (isEmptySet(byRefs))
						filter(prems0, \pp -> !pp.foundational || pp.charShape)
						else filter(prems0, \pp ->
							containsSet(byRefs, id2s(pp.assId)) || isDef(id2s(pp.assId))
							|| (pp.foundational && pp.charShape));
					if (ruVerbose(env.conf) > 1) {
						env.out.println("  == " + id2s(th.info.id) + " goal: " + ru2s(matrix, math)
							+ (if (isEmptySet(byRefs)) "  [no by-list]"
								else "  by(" + strGlue(map(set2array(byRefs), idfn), ", ") + ")"));
					}
					hyps = map(th.infer.hyps, \h -> ruExp(h.stmt.exps[0]));
					plan = ruUnfPlanDecide(math, env, th.infer.prop.class, prems, hyps, prop,
						maxClauses, maxSubsts, budgetMs);
					if (plan.provable) {
						kinds = fold(plan.refutations, makeSet(), \ks, r -> insertSet(ks, switch (r) {
							RuUnfByContradiction(__): "triv";
							RuUnfByReflexivity(__, __): "eq";
							RuUnfByAtomClash(__, __): "clash";
							RuUnfByPremise(__, __): "prem";
						}));
						if (containsSet(kinds, "prem")) byPrem := ^byPrem + 1
						else if (containsSet(kinds, "clash")) byClash := ^byClash + 1
						else if (containsSet(kinds, "eq")) byEq := ^byEq + 1
						else byTriv := ^byTriv + 1;
					} else {};
					if (ruVerbose(env.conf) > 2 && plan.provable) {
						iter(plan.refutations, \r -> env.out.println("      " + switch (r) {
							RuUnfByContradiction(l): "trivial: " + ru2s(l, math);
							RuUnfByReflexivity(l, rr): "reflexivity: " + ru2s(l, math) + " ~ " + ru2s(rr, math);
							RuUnfByAtomClash(p, n): "atom clash: " + ru2s(p, math) + " vs ¬" + ru2s(n, math);
							RuUnfByPremise(aid, bind): "premise " + id2s(aid) + " @ "
								+ strGlue(map(tree2pairs(bind), \pb ->
									id2s(pb.first) + ":=" + ru2s(pb.second, math)), ", ");
						}));
					} else {};
					if (ruVerbose(env.conf) > 0) {
						env.out.println("  " + (if (plan.provable) "+ " else "- ") + id2s(th.info.id)
							+ (if (plan.provable) " DECIDED" else " open")
							+ " (disjuncts=" + i2s(plan.disjuncts) + ", refuted=" + i2s(plan.refuted)
							+ ", premises=" + i2s(plan.premises)
							+ (if (plan.overflow) ", OVERFLOW" else "") + ")");
					}
					Pair(acc.first + (if (plan.provable) 1 else 0), acc.second + 1);
				}
			});
			env.out.println("unifier-probe [" + target + "]: decided " + i2s(counts.first)
				+ " of " + i2s(counts.second) + " non-equality goals (" + i2s(length(theorems))
				+ " theorems) in " + ruTimePassed2s(timer));
			env.out.println("  refutations: premise-instance " + i2s(^byPrem)
				+ ", atom-clash " + i2s(^byClash) + ", reflexivity " + i2s(^byEq)
				+ ", trivial " + i2s(^byTriv));
			Some(RuState(state with
				vars = setTree(state.vars, "unifier-probe", pairs2tree([
					Pair("decided", flow(counts.first)),
					Pair("goals", flow(counts.second)),
					Pair("total", flow(length(theorems))),
					Pair("time", flow(ruTimePassed(timer)))
				]))
			));
			}
		}
	}
}

// PER-STEP mode — the ACTUAL checker workload: each skeleton gap step is one
// inference (goal = the step statement; basis = theorem hyps + PRIOR step
// statements; universal premises = the step's by-list + always-available
// definitions; ∀-closed prior steps join the PREMISES, not the basis).
ruUnfProbeSteps(env : RuEnv, state : RuState, math : RuMath, target : string,
	theorems : [RuTheorem], maxClauses : int, maxSubsts : int,
	budgetMs : double) -> Maybe<RuState> {
	timer = ruMakeTimer();
	byPrem = ref 0; byClash = ref 0; byEq = ref 0; byTriv = ref 0;
	eqSteps = ref 0;
	asmOk = ref 0; asmBad = ref 0;
	parseBy = \tac : string -> {
		t = trim2(tac, " ");
		if (!startsWith(t, "by(")) makeSet()
		else fold(strSplit(substring(t, 3, strlen(t) - 4), ","), makeSet(), \ba, r -> {
			rn = trim2(r, " ");
			if (rn == "") ba else insertSet(ba, rn);
		});
	}
	isDef = \nm : string -> startsWith(nm, "d") && strlen(nm) > 1
		&& isDigits(substring(nm, 1, 1)) && strContains(nm, "_");
	counts = fold(theorems, Pair(0, 0), \accT : Pair<int, int>, th -> {
		prems0 = ruUnfScopePremises(math, env, th.info);
		thHyps = map(th.infer.hyps, \h -> ruExp(h.stmt.exps[0]));
		foldi(th.proof.steps, accT, \si, acc : Pair<int, int>, step -> {
			if (step.stmt.exps == []) acc else {
				goal = ruExp(step.stmt.exps[0]);
				matrix = ruEqzStripAlls(goal);
				if (ruInHead(matrix) == s2id("wceq") && ruInArity(matrix) == 2) {
					eqSteps := ^eqSteps + 1;
					acc;
				} else {
					prior = map(take(th.proof.steps, si), \ps -> ruExp(ps.stmt.exps[0]));
					// the REAL premise list an assembled step proof verifies against:
					// theorem hyps then ALL prior steps, leaf-indexed in order
					allPrems = concat(thHyps, prior);
					// ∀-closed prior steps are UNIVERSAL facts — offer them as premises
					stepPremIdx : ref Tree<int, Pair<int, RuExp>> = ref makeTree();
					stepPrems = filtermapi(prior, \pi, p ->
						if (ruInHead(p) != s2id("wal")) None()
						else {
							pm = ruEqzStripAlls(p);
							if (ruUnfIsEq2(pm)) None()
							else {
								vars = fold(pm.nodes, makeSet(), \a, n -> switch (n) {
									RuVar(id, __): insertSet(a, id);
									RuRuleNode(__, __): a;
								});
								if (isEmptySet(vars)) None()
								else {
									sid = s2id("step" + i2s(pi + 1));
									stepPremIdx := setTree(^stepPremIdx, sid,
										Pair(length(thHyps) + pi, p));
									Some(RuUnfPremise(sid, pm, set2array(vars), false, false));
								}
							}
						});
					basisIdx = filtermapi(allPrems, \bi, p ->
						if (ruInHead(p) == s2id("wal")) None() else Some(Pair(p, bi)));
					hyps = map(basisIdx, \b -> b.first);
					byRefs = parseBy(step.tactic);
					prems = concat(
						if (isEmptySet(byRefs)) filter(prems0, \pp -> !pp.foundational || pp.charShape)
						else filter(prems0, \pp ->
							containsSet(byRefs, id2s(pp.assId)) || isDef(id2s(pp.assId))
							|| (pp.foundational && pp.charShape)),
						stepPrems);
					plan = ruUnfPlanDecide(math, env, th.infer.prop.class, prems, hyps, goal,
						maxClauses, maxSubsts, budgetMs);
					if (plan.provable) {
						kinds = fold(plan.refutations, makeSet(), \ks, r -> insertSet(ks, switch (r) {
							RuUnfByContradiction(__): "triv";
							RuUnfByReflexivity(__, __): "eq";
							RuUnfByAtomClash(__, __): "clash";
							RuUnfByPremise(__, __): "prem";
						}));
						if (containsSet(kinds, "prem")) byPrem := ^byPrem + 1
						else if (containsSet(kinds, "clash")) byClash := ^byClash + 1
						else if (containsSet(kinds, "eq")) byEq := ^byEq + 1
						else byTriv := ^byTriv + 1;
					} else {};
					// the direct generator + the standard verifier (assembly-first gate)
					asmV = if (!plan.provable) false
					else switch (ruUnfStepProof(math, env, th.infer.prop.class, plan,
							basisIdx, ^stepPremIdx, goal)) {
						None(): false;
						Some(gp): {
							steps = ruMakeLinearProof(gp.first);
							vhyps = mapi(allPrems, \hi, hp ->
								RuHyp(hi, RuStmt(th.infer.prop.class, [hp], -1), -1));
							propStmt = RuStmt(th.infer.prop.class, [goal], -1);
							extra = differenceSets(
								fold(steps, makeSet(), \a, stp -> mergeSets(a, ruStmt2Vars(stp.stmt))),
								fold(vhyps, ruStmt2Vars(propStmt), \a, h ->
									mergeSets(a, ruStmt2Vars(h.stmt))));
							prf = RuProof(RuVarsDisjs(values2tree(set2array(extra), \v -> v.id),
								gp.second), steps, -1);
							res = ruVerifyProof(prf, vhyps, propStmt, math, env);
							ok = res.errs == [];
							if (ok) asmOk := ^asmOk + 1 else {
								asmBad := ^asmBad + 1;
								if (ruVerbose(env.conf) > 1) {
									iter(res.errs, \e -> env.out.println("      asm verify err ["
										+ id2s(th.info.id) + " step " + i2s(si + 1) + "]: "
										+ strLeft(toString(e), 400)));
								} else {};
							}
							ok;
						}
					}
					if (ruVerbose(env.conf) > 0) {
						env.out.println("  " + (if (plan.provable) "+ " else "- ")
							+ id2s(th.info.id) + " step " + i2s(si + 1)
							+ (if (plan.provable) " DECIDED" else " open")
							+ (if (asmV) " ASSEMBLED+VERIFIED"
								else if (plan.provable) " no-assembly" else "")
							+ " (disjuncts=" + i2s(plan.disjuncts) + ", refuted=" + i2s(plan.refuted)
							+ ", premises=" + i2s(plan.premises)
							+ (if (plan.overflow) ", OVERFLOW" else "") + ")");
					}
					Pair(acc.first + (if (plan.provable) 1 else 0), acc.second + 1);
				}
			}
		});
	});
	env.out.println("unifier-probe steps [" + target + "]: decided " + i2s(counts.first)
		+ " of " + i2s(counts.second) + " non-equality gap steps (" + i2s(^eqSteps)
		+ " equality steps skipped, " + i2s(length(theorems)) + " theorems) in "
		+ ruTimePassed2s(timer));
	env.out.println("  refutations: premise-instance " + i2s(^byPrem)
		+ ", atom-clash " + i2s(^byClash) + ", reflexivity " + i2s(^byEq)
		+ ", trivial " + i2s(^byTriv));
	env.out.println("  direct generator: assembled+verified " + i2s(^asmOk)
		+ ", no-assembly " + i2s(counts.first - ^asmOk - ^asmBad)
		+ ", REJECTED " + i2s(^asmBad));
	Some(RuState(state with
		vars = setTree(state.vars, "unifier-probe", pairs2tree([
			Pair("decided", flow(counts.first)),
			Pair("goals", flow(counts.second)),
			Pair("total", flow(length(theorems))),
			Pair("time", flow(ruTimePassed(timer)))
		]))
	));
}

ruUnfIsEq2(e : RuExp) -> bool { ruInHead(e) == s2id("wceq") && ruInArity(e) == 2 }
