import ru/prover/tactics/equalizer_plan;
import ru/math;
import comm;
import base/ids;

// EQUALIZER-PROBE — measure the Equalizer planner's DECISION coverage over one
// article's theorems, with no PVT and no proof construction: for each theorem whose
// (∀-stripped) statement is an equality, run the planner's decision core
// (ruEqzPlanDecide) against the article-scope universal equality premises. This is the
// acceptance instrument for the Equalizer planner (the enumset1 class): it answers
// "does the transcribed Mizar Equate+instantiation DECIDE these goals?" before any
// executor wiring exists.
//
//   russellj no-server=1 <read the article first> equalizer-probe target=enumset1

export {
	ruCommEqualizerProbe : RuComm;
}

ruCommEqualizerProbe = RuComm(
	RuCommInfo(
		"equalizer-probe", "prover",
		"measure the Equalizer planner's decision coverage over an article's equality theorems",
		"target", false, false,
		[RuCommArg("target", false, "the article source module (e.g. enumset1)", "")],
		[RuCommRet("equalizer-probe.decided", "int", "equality theorems the planner decides"),
		 RuCommRet("equalizer-probe.eq-goals", "int", "theorems whose statement is an equality"),
		 RuCommRet("equalizer-probe.total", "int", "theorems in the article")]
	),
	ruRunEqualizerProbe
);

ruRunEqualizerProbe(unit : RuUnit) -> Maybe<RuState> {
	env   = ruUnitEnv(unit);
	state = unit.state;
	math  = ruMathFromSources(state.ru, env);
	target = ruTaskStringArg(unit.task, "target", "");
	srcM = switch (lookupTree(math.sources, s2id(target))) {
		Some(s): Some(s);
		None(): foldTree(math.sources, None(), \__, s, acc ->
			if (isSome(acc)) acc
			else if (s.info.module == target || endsWith(s.info.module, "/" + target)) Some(s) else acc);
	}
	switch (srcM) {
		None(): {
			env.out.error("equalizer-probe: source '" + target + "' is not loaded", []);
			Some(state);
		}
		Some(src): {
			theorems = filtermap(src.decls, \d -> switch (d) {
				RuTheorem(__, __, __, __): Some(d);
				default: None();
			});
			timer = ruMakeTimer();
			// route classes (the executor work distribution): pure = every route fact is a
			// hyp or a setvar-only premise instance (directly replayable); elems = uses an
			// element-set equality (needs the extensionality builder); classBound = a setvar
			// premise var bound to a class slice (needs ax-gen + spcv re-generalization)
			rtElems = ref 0; rtClass = ref 0; rtPure = ref 0;
			counts = fold(theorems, Pair(0, 0), \acc : Pair<int, int>, th -> {
				prop = ruExp(th.infer.prop.exps[0]);
				matrix = ruEqzStripAlls(prop);
				isEq = ruInHead(matrix) == s2id("wceq") && ruInArity(matrix) == 2;
				if (!isEq) {
					if (ruVerbose(env.conf) > 1) {
						env.out.println("  - " + id2s(th.info.id) + ": not an equality goal");
					}
					acc;
				} else {
					prems0 = ruEqzScopePremises(math, env, th.info);
					// THE BY-LIST (carried from the Mizar XML as `by(...)` step annotations):
					// when present, the article-side premise set is EXACTLY the citations —
					// the original checker's own premise list — plus the foundational
					// def/struct family (the A-map bridge for reused constructors, whose
					// citations resolve to no emitted name). No by-list -> full scope.
					byRefs = fold(th.proof.steps, makeSet(), \bacc, st -> {
						t = trim2(st.tactic, " ");
						if (!startsWith(t, "by(")) bacc
						else fold(strSplit(substring(t, 3, strlen(t) - 4), ","), bacc, \ba, r -> {
							rn = trim2(r, " ");
							if (rn == "") ba else insertSet(ba, rn);
						});
					});
					// DEFINITIONS are always available WITHOUT citation — Mizar's checker
					// expands definientia from the environment automatically (equalizer.pas
					// InferConstDef at Equate start; the .dfs file), so `by`-lists never cite
					// them. Keep every dN_<aid> axiom alongside the cited premises.
					isDef = \nm : string -> startsWith(nm, "d") && strlen(nm) > 1
						&& isDigits(substring(nm, 1, 1)) && strContains(nm, "_");
					prems = if (isEmptySet(byRefs)) prems0
						else filter(prems0, \pp -> pp.foundational
							|| containsSet(byRefs, id2s(pp.assId)) || isDef(id2s(pp.assId)));
					if (ruVerbose(env.conf) > 1) {
						gm = ruEqzStripAlls(prop);
						gss = ruInArgs(gm);
						env.out.println("  == " + id2s(th.info.id) + " goal: " + ru2s(gm, math)
							+ "  lhsHead=" + id2s(ruInHead(gss[0])) + " rhsHead=" + id2s(ruInHead(gss[1]))
							+ (if (isEmptySet(byRefs)) "  [no by-list]"
								else "  by(" + strGlue(map(set2array(byRefs), idfn), ", ") + ")"));

					}
					hyps = map(th.infer.hyps, \h -> ruExp(h.stmt.exps[0]));
					// element rules = the definition-consumption channel (InferConstDef):
					// membership biconds + means-defs, available WITHOUT citation
					elemRules = ruEqzElemRules(math, env, th.info);
					plan = ruEqzPlanDecide(math, env, th.infer.prop.class, prems, elemRules, hyps, prop);
					nElems = length(filter(plan.route, \f -> switch (f.src) {
						RuEqzSrcElems(__, __): true; default: false; }));
					nClass = length(filter(plan.route, \f -> switch (f.src) {
						RuEqzSrcPremise(__, __, cb): cb; default: false; }));
					if (plan.provable) {
						if (nElems > 0) rtElems := ^rtElems + 1 else {};
						if (nClass > 0) rtClass := ^rtClass + 1 else {};
						if (nElems == 0 && nClass == 0) rtPure := ^rtPure + 1 else {};
					} else {};
					if (ruVerbose(env.conf) > 0) {
						env.out.println("  " + (if (plan.provable) "+ " else "- ") + id2s(th.info.id)
							+ (if (plan.provable) " DECIDED" else " open")
							+ " (rounds=" + i2s(plan.rounds) + ", instances=" + i2s(plan.instances)
							+ ", premises=" + i2s(plan.premises)
							+ (if (plan.provable) ", route=" + i2s(length(plan.route))
								+ (if (nElems > 0) " elems=" + i2s(nElems) else "")
								+ (if (nClass > 0) " classBound=" + i2s(nClass) else "") else "")
							+ (if (plan.overflow) ", OVERFLOW" else "") + ")");
					}
					Pair(acc.first + (if (plan.provable) 1 else 0), acc.second + 1);
				}
			});
			env.out.println("equalizer-probe [" + target + "]: decided " + i2s(counts.first)
				+ " of " + i2s(counts.second) + " equality goals (" + i2s(length(theorems))
				+ " theorems) in " + ruTimePassed2s(timer));
			env.out.println("  routes: pure " + i2s(^rtPure) + ", with elem-eqs " + i2s(^rtElems)
				+ ", with class-bound instances " + i2s(^rtClass));
			Some(RuState(state with
				vars = setTree(state.vars, "equalizer-probe", pairs2tree([
					Pair("decided", flow(counts.first)),
					Pair("eq-goals", flow(counts.second)),
					Pair("total", flow(length(theorems))),
					Pair("time", flow(ruTimePassed(timer)))
				]))
			));
		}
	}
}
