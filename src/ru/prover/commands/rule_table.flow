import ru/prover/tactics/rule_table;
import ru/math;
import comm;
import base/comms;
import base/ids;

// The rule-table report (P0 of the rule-table plan): scan the loaded foundation into
// the declarative rule table and print what was found — per-role counts, the
// delegated congruence-table sizes, and THE HOLE LIST: n-hyp combiners with no
// shape-matched guarded (d-form) companion in the foundation. Holes are the curation
// loop's input: grep set.mm for the missing d-form, reuse it if present, else author
// it in miz_aux.ru. Informational only — nothing here touches proof search.
//
// Invoked through the script wrapper (which does the read):
//   russellj no-server=1 info/rule-table file=mizar/miz_set.ru
//   russellj no-server=1 info/rule-table file=mizar/miz_set.ru dump=1

export {
	ruCommRuleTable : RuComm;
}

ruCommRuleTable = RuComm(
	RuCommInfo(
		"info-rule-table", "info",
		"scan the foundation into the declarative rule table; report d-form holes",
		"", true, false,
		[
			RuCommArg("dump",  true, "1 = print every classified rule", "0"),
			RuCommArg("holes", true, "1 = print combiners with no guarded (d-form) companion", "1"),
			RuCommArg("role",  true, "restrict dump/holes to one role (refl, trans, …)", "")
		], []
	),
	ruRunRuleTable
);

ruRunRuleTable(unit : RuUnit) -> Maybe<RuState> {
	env  = ruUnitEnv(unit);
	math = ruMathFromSources(unit.state.ru, env);
	table = ruRuleTable(math);
	roleArg = ruTaskStringArg(unit.task, "role", "");
	inRole = \r : RuTableRule -> roleArg == "" || roleArg == "all" || ruTableRole2s(r.role) == roleArg;

	// per-role summary
	counts = fold(table.all, makeTree(), \acc, r ->
		setTree(acc, ruTableRole2s(r.role), lookupTreeDef(acc, ruTableRole2s(r.role), 0) + 1));
	env.out.println("rule table: " + i2s(length(table.all)) + " rules over "
		+ i2s(sizeTree(table.byHead)) + " heads, "
		+ i2s(sizeTree(table.guarded)) + " guarded (d-form-shaped) assertions");
	traverseInOrder(counts, \role, n ->
		env.out.println("  " + role + ": " + i2s(n)));
	// the delegated mechanical tables (scanned elsewhere, indexed there)
	congs = ruCongRulesCached(math);
	ncongs = fold(getTreeValues(congs), 0, \acc, rs -> acc + length(rs));
	env.out.println("  (delegated) term congruences: " + i2s(ncongs));
	atoms = ruInAtomCongsCached(math);
	natoms = fold(getTreeValues(atoms), 0, \acc, rs -> acc + length(rs));
	env.out.println("  (delegated) atom congruences: " + i2s(natoms));

	if (ruTaskStringArg(unit.task, "dump", "0") == "1") {
		iter(filter(table.all, inRole), \r ->
			env.out.println("  " + ruRtRule2s(r)));
	} else {};

	if (ruTaskStringArg(unit.task, "holes", "1") == "1") {
		holes = filter(ruTableHoles(table), inRole);
		if (holes == []) {
			env.out.println("d-form holes: none — every combiner has a guarded companion");
		} else {
			env.out.println("d-form HOLES (" + i2s(length(holes)) + "): combiners deduction mode cannot run —");
			iter(holes, \r -> env.out.println("  " + ruRtRule2s(r)));
		}
	} else {};
	Some(unit.state);
}

ruRtRule2s(r : RuTableRule) -> string {
	id2s(r.assId) + "  [" + ruTableRole2s(r.role) + "]"
		+ " head=" + id2s(r.head)
		+ (if (r.aux >= 0) " aux=" + id2s(r.aux) else "")
		+ " hyps=" + i2s(r.nhyps)
		+ (if (r.hasDisjs) " DV" else "")
		+ switch (r.dform) {
			RuDFormLift(): "  d: a1i-lift";
			RuDFormFound(did): "  d: " + id2s(did);
			RuDFormHole(): "  d: HOLE";
		};
}
