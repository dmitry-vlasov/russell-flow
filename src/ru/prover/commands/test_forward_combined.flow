import ru/prover/core/env;
import ru/prover/core/expand;
import ru/prover/core/prove;
import ru/prover/core/forward;
import ru/prover/core/util;
import ru/prover/tactics/dsl;
import ru/util/target;
import ru/util/utils;
import ru/proof_tree;
import base/concurrent;
import comm;

// COMBINED oracle: the GENERAL bidirectional algorithm, no cut, no depth limit.
// The two directions MEET IN THE MIDDLE at a frontier depth D (frontier arg, default
// maxDepth/2). The BACKWARD oracle expands the goal down through the top D levels
// (proving the upper half by ordinary decomposition); the FORWARD facts are revealed
// only for nodes at depth >= D, so Level-1's POSITIONAL join (expand.flow P2b) closes
// each branch AT the frontier with the forward subproof of that node (the lower half).
// Forward proofs propagate UP through the backward structure to the root. Neither side
// proves a node the other proves — they meet, they do not overlap. That ADDITIVE
// invariant is asserted by keepVariant (crash on a duplicate variant). onProof verifies
// the assembled proof. frontier=0 reveals everything (forward-dominant, backward builds
// only the top structure); a frontier past the proof depth reveals nothing (pure
// backward oracle). The MP/cut explosion is Level-2's concern; Level-1 expands and joins.

export {
	ruCommTestForwardCombined : RuComm;
}

// --- Bidirectional oracle tactic: additive-invariant CHECK -----------------------
// The completeness-test oracle installs `keepVariant` (fns hook) NOT to reduce the
// number of variants (that is bounded by the design: the POSITIONAL join gives one
// forward proof per node, and the oracle's max_variants bounds backward branching),
// but to ASSERT the ADDITIVE invariant: the algorithm must never emit the same proof
// variant twice on a node — top-down and bottom-up must MEET, not duplicate. When a
// duplicate IS emitted (equal up to variable renaming, ruProofTreeAlphaEq), that is a
// bug in the algorithm, so we CRASH rather than silently drop it.

// Identity of the node a proof variant is stored on (so the check is per-node).
ruProofHypKey(h : RuProverHyp) -> string {
	switch (h) {
		RuProverExp(ind, __, __, __, parent): "E" + i2s(parent.id) + "_" + i2s(ind);
		RuProverRoot(__, __, __):             "R";
	}
}
ruProofNodeKey(p : RuProverProof) -> string {
	switch (p) {
		RuProverProofProp(node, __, __):        "P" + i2s(node.id);
		RuProverProofTop(node, __, __, __):     ruProofHypKey(node);
		RuProverProofStmt(node, __, __, __):    ruProofHypKey(node);
		RuProverProofForward(node, __, __, __): ruProofHypKey(node);
	}
}

RuVariantGate(
	seen : ref Tree<string, [RuProofTree]>  // node-key -> proof variants already emitted on it
);
ruMakeVariantGate() -> RuVariantGate {
	RuVariantGate(ref makeTree());
}
// Never reduces — always returns true (keep). It only CHECKS: if this variant is
// alpha-equal to one already emitted on the same node, the additive invariant is
// broken, so crash with the offending node.
ruVariantGateKeep(g : RuVariantGate, p : RuProverProof) -> bool {
	tree = ruMakeProofTree(p);
	nk = ruProofNodeKey(p);
	stored = lookupTreeDef(^(g.seen), nk, []);
	if (exists(stored, \t -> ruProofTreeAlphaEq(t, tree))) {
		ruCrash("bidirectional oracle: duplicate proof variant emitted on node " + nk +
			" — the algorithm is not additive (a proof variant was produced twice)");
		true;
	} else {
		g.seen := setTree(^(g.seen), nk, arrayPush(stored, tree));
		true;
	}
}

// Forward-derive every proof node's fact (post-order, premises up), tagging each with
// its proof-DAG PATH (child-index sequence). The path is how the join later connects
// this fact to the backward subgoal at the SAME node (ruNodePath). Recorded in
// derivation order — the order the combined loop reveals them.
ruCombinedDerive(node : RuProofTree, path : [int], seeds : [RuProverExp], acc : ref [Pair<RuProverExp, [int]>], prover_env : RuProverEnv) -> Maybe<RuProverExp> {
	switch (node) {
		RuProofHyp(h, __): if (h >= 0 && h < length(seeds)) Some(seeds[h]) else None();
		RuProofStep(aid, children, __): {
			cf = mapi(children, \i, c -> ruCombinedDerive(c, arrayPush(path, i), seeds, acc, prover_env));
			facts = filtermap(cf, idfn);
			if (length(facts) != length(cf)) None()
			else {
				res = ruApplyForwardOn(lookupTreeDef(prover_env.math.decls.assertions, aid, ruNoAxiom), facts, prover_env);
				maybeApply(res, \f -> refArrayPush(acc, Pair(f, path)));
				res;
			}
		}
	}
}

// Run backward rounds until the goal is proved. All forward facts are pre-revealed
// into the front before the loop, so the positional P2b join closes each subgoal at
// creation and there is nothing to reveal here — the loop just drives the backward
// structure and the propagation.
ruCombinedLoop(prover_env : RuProverEnv, fuel : int) -> RuProverEnv {
	if (ruTreeIsProved(prover_env.tree) || fuel <= 0 || ruTimeIsOver(prover_env.conf.timer)) prover_env
	else {
		br = ruProveOneRound(prover_env);
		if (ruTreeIsProved(br.first.tree) || !br.second) br.first
		else ruCombinedLoop(br.first, fuel - 1);
	}
}

ruCommTestForwardCombined = RuComm(
	RuCommInfo(
		"test/forward-combined", "prover",
		"combined oracle: fairly interleave backward + forward, meeting at the universal join; verify",
		"target", true, false,
		[
			RuCommArg("target", true, "theorems to reconstruct", "all"),
			RuCommArg("limit", true, "per-node proof-variant limit (1 = strict unique; N = N variants incl. target; 0 = off)", "1"),
			RuCommArg("frontier", true, "meet-in-the-middle depth: backward proves the top D levels, forward the rest (-1 = maxDepth/2; N = fixed D; 0 = forward-dominant)", "-1"),
			RuCommArg("threads", true, "worker threads (0 = all cores)", "0"),
			RuCommArg("nojoin", true, "DBG: 1 = disable the universal join (pure backward oracle)", "0"),
			RuCommArg("strict-fail", true, "1 = crash if any combined reconstruction fails", "0")
		], []
	),
	ruRunTestForwardCombined
);

ruRunTestForwardCombined(unit : RuUnit) -> Maybe<RuState> {
	env   = ruUnitEnv(unit);
	task  = unit.task;
	state = unit.state;
	math  = ruMathFromSources(state.ru, env);
	target = ruDetermineTarget(task, math, env);
	theorems = filter(filtermap(ruTargetDecls(target, math, env), ruDecl2Theorem), ruTheoremIsProved);
	if (theorems == []) {
		env.out.error("test/forward-combined: target has no theorem", []);
		Some(state);
	} else {
	// Per-theorem worker; reconstructions are independent, so theorems run
	// concurrently over a per-worker RuEnv `e`.
	one = \th : RuTheorem, e : RuEnv -> {
		index = ruMakeIndexForTarget(RuTargetDecl(th), math, e);
		prover_task = RuProverTask(th.info, ruDoneTactic, id2s(th.info.id), task.args, th.infer.hyps, ruProofQedStep(th.proof));
		penv_pre0 = ruInitProverEnv(prover_task, math, e, index, 60000.0);
		// Install the variant gate: it ASSERTS the additive invariant (crash if any
		// node's proof is emitted twice). Inert when limit<=0. Shared refs → one gate
		// per theorem, active throughout. The forward front is installed below, once
		// all facts are derived (nojoin=1 leaves it uninstalled = pure backward oracle).
		limit = ruTaskIntArg(task, "limit", 1);
		penv_pre = if (limit <= 0) penv_pre0 else {
			gate = ruMakeVariantGate();
			RuProverEnv(penv_pre0 with fns = RuProverFuncs(penv_pre0.fns with keepVariant = \p -> ruVariantGateKeep(gate, p)));
		};
		c_task    = ruConstProverTask(prover_task, math);
		cpremises = c_task.const.premises;

		// Forward-derive every proof node's fact (tagged with its proof-DAG path).
		fwd0  = ruInitProverForwardProved(cpremises, index, penv_pre.math, e);
		acc : ref [Pair<RuProverExp, [int]>] = ref [];
		ignore = ruCombinedDerive(ruTheoremProofTree(th, math), [], fwd0.front, acc, penv_pre);
		facts = ^acc;

		// MEET IN THE MIDDLE. Reveal a forward fact only for nodes at depth >= the
		// frontier D (path length = proof-DAG depth). The backward oracle then expands
		// the TOP D levels itself (subgoals above D see no fact, so they are decomposed),
		// and the POSITIONAL P2b join closes each branch AT the frontier with its forward
		// fact (which carries the whole subproof below D). So backward proves the upper
		// half and forward the lower half — they MEET at D, with no node proved by both
		// (the ADDITIVE invariant, checked by keepVariant).
		//   frontier=-1 (default): D = maxDepth/2, a balanced split per theorem
		//   frontier=N            : fixed D=N (top N levels backward)
		//   frontier=0            : reveal all => forward-dominant (backward builds only structure)
		maxDepth   = fold(facts, 0, \m, fp -> max(m, length(fp.second)));
		frontierArg = ruTaskIntArg(task, "frontier", -1);
		frontierD  = if (frontierArg >= 0) frontierArg else maxDepth / 2;
		revealed   = filter(facts, \fp -> length(fp.second) >= frontierD);
		front_all = fold(revealed, RuProverForward(ruMakeIndex(), [], ruMakeIndex(), ruMakeIndex(), makeSet(), makeTree()),
			\fr, fp -> {
				fe = ruExp(fp.first.stmt.exps[0]);
				RuProverForward(fr with
					index     = ruSetIndex(fe, fp.first, fr.index),
					seen      = insertSet(fr.seen, ruExpKey(fe)),
					pathIndex = setTree(fr.pathIndex, fp.second, fp.first)
				);
			}
		);
		if (ruTaskStringArg(task, "nojoin", "") == "1") {} else penv_pre.forwardFront := Some(front_all);

		// Backward oracle drives the structure; max_variants=max_proofs=limit bounds
		// its per-node branching. All joining is done at subgoal creation (P2b), so the
		// loop just runs backward rounds — no lazy reveal.
		ctx = RuTacticContext(math, e, None(), None());
		ostr = if (limit <= 0) "oracle(-1, -1)" else "oracle(-1, -1, " + i2s(limit) + ", " + i2s(limit) + ")";
		result = switch (ruParseAndBuildTactic(ostr, ctx)) {
			None(): "ORACLE-BUILD-FAILED";
			Some(builder): {
				built = builder.build(penv_pre);
				penv0 = built.first;
				penv0.tactic := Some(built.second);
				penv1 = ruExpandHyp(penv0.tree.root, penv0);
				penv  = ruCombinedLoop(penv1, length(facts) + 5000);
				if (length(^(penv.tree.proofs)) > 0) "RECONSTRUCTED+VERIFIED" else "NOT-RECONSTRUCTED";
			}
		};
		Pair(th.info.id, result);
	};
	threads = ruTaskIntArg(task, "threads", 0);  // 0 = auto (all cores)
	results = ruConcurrentLimited(
		map(theorems, \th -> \e -> one(th, e)),
		if (threads <= 0) 1000 else threads,
		env
	);
	ok  = filter(results, \r -> r.second == "RECONSTRUCTED+VERIFIED");
	bad = filter(results, \r -> r.second != "RECONSTRUCTED+VERIFIED");
	if (length(theorems) == 1) {
		env.out.println("test/forward-combined: theorem=" + id2s(results[0].first) + "  => " + results[0].second);
	} else {
		env.out.println("test/forward-combined: " + i2s(length(ok)) + "/" + i2s(length(results)) + " reconstructed+verified");
		iter(take(bad, 12), \r -> env.out.println("  NOT-RECONSTRUCTED: " + id2s(r.first) + " => " + r.second));
	};
	if (ruTaskIntArg(task, "strict-fail", 0) > 0 && bad != []) {
		ruCrash("test/forward-combined: failed for " + i2s(length(bad)) + " theorem(s)");
	}
	Some(state);
	}
}
