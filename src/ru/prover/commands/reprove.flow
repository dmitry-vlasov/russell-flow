import ru/prover/core/runner;
import ru/prover/core/util;
import ru/prover/commands/coverage;
import ru/prover/tactics/breadth_first;
import ru/prover/tactics/combinators;
import ru/prover/core/controls;
import ru/prover/tactics/dsl;
import ru/prover/tactics/subproof_replay;
import ru/prover/core/stats;
import ru/prover/core/fragment;
import ru/prover/ml/premise_selector;
import ru/map_decls;
import comm;
import ru/util/src2s;

export {
	ruCommReprove : RuComm;
}

ruCommReprove = RuComm(
	RuCommInfo(
		"reprove", "prover",
		"reprove theorems with a tactic supplied via the DSL (default: a strict bounded BFS)",
		"target", true, false,
		concat([
			RuCommArg("target",         true, "the target: a theorem, file or all",                                            "all"),
			RuCommArg("max-depth",      true, "max proof tree depth (used by the default tactic)",                             "5"),
			RuCommArg("max-size",       true, "max proof tree size (used by the default tactic)",                              "4096"),
			RuCommArg("time-limit",     true, "per-theorem wall-clock limit (e.g. 60s, 5m)",                                   "60s"),
			RuCommArg("job-time-limit", true, "total wall-clock cap for the whole job (empty = n*time-limit/p)",               ""),
			RuCommArg("fragment-depth", true, "fragment-index depth (>0 builds the fragment index and enables fragment-replay)", "0"),
			RuCommArg("forward-closure-depth", true, "shallow forward proof search: depth of premise closure (0 disables; 1-3 typical)", "0"),
			RuCommArg("forward-closure-size",  true, "max number of facts in the forward closure index", "1024"),
			RuCommArg("forward-search-depth",  true, "bidirectional search: depth of the proof-carrying dynamic forward front (0 disables; the interior join is then inert)", "0"),
			RuCommArg("forward-search-size",   true, "max number of facts in the dynamic forward front", "2048"),
			RuCommArg("load-ml",        true, "set to 1 to load the ML selector (required by the `ml` atom)",                  "0"),
			RuCommArg("tactic",         true, "tactic DSL expression or .tac derived-tactic ref; if empty, a strict bounded BFS (limited(bfs, size=max-size, depth=max-depth, batch=16)) is used", ""),
			RuCommArg("strict-fail",    true, "set to 1 to crash if any theorem could not be reproved (CI / regression mode)", "0"),
			RuCommArg("replace",        true, "set to 1 to INSTALL the found proof into the theorem (the one accepted by the $d check); `changed-count` then counts installed proofs that differ from the stored ones — for an end-to-end check: verify, write-ru, export, Metamath", "0"),
			RuCommArg("coverage",       true, "set to 1 to measure proof-step coverage from the search tree inline",           "0"),
			RuCommArg("parallel",             true, "0 = one theorem at a time; 1 = all theorems at once (flood); N > 1 = at most N theorems in flight (bounded width — the heavy oracle modes need this: a flood exhausts the heap)", "0"),
			RuCommArg("min-index-rule-nodes", true, "min rule-node count for step index entries (1 = index all steps; only used when tactic contains spr or linear-guided)", "1"),
			// progress + per-decl callbacks are read by ruMapFnComm (this command routes through it):
		], ruMapFnCommArgs), []
	),
	ruRunReprove
);

ruRunReprove(unit : RuUnit) -> Maybe<RuState> {
	env   = ruUnitEnv(unit);
	task  = unit.task;
	state = unit.state;
	conf  = state.conf;
	math  = ruMathFromSources(state.ru, env);
	target = ruDetermineTarget(task, math, env);
	if (target == RuTargetNone()) {
		env.out.error("reprove: no target", []);
		Some(state);
	} else {
		index          = ruMakeIndexForTarget(target, math, env);
		max_frag_depth = ruTaskIntArg(task, "fragment-depth", 0);
		frag_pair      = if (max_frag_depth > 0)
			Some(ruBuildFragments(math, max_frag_depth, env))
		else None();
		// step_index is expensive on large corpora (~7s and several GB for
		// set-50000+).  Only build it when the tactic actually references
		// the `spr` atom that needs it.
		// Expand any .tac file reference first, so a tactic= file whose BODY uses spr/linear-guided still
		// triggers the step-index build (the raw `tactic` arg would just be the file path).
		tactic_src_early = ruResolveTacticSource(ruTaskStringArg(task, "tactic", ""), env);
		min_rule_nodes = ruTaskIntArg(task, "min-index-rule-nodes", 1);
		step_index = if (strContains(tactic_src_early, "spr") || strContains(tactic_src_early, "linear-guided"))
			Some(ruBuildStepIndex(math, min_rule_nodes))
		else None();
		load_ml    = ruTaskIntArg(task, "load-ml", 0) > 0;
		selector   = if (load_ml) {
			s = ruLoadMlSelector(conf);
			if (sizeTree(s.features) == 0) {
				env.out.error("reprove: no ML models found, run learn-assertions first", []);
				None()
			} else Some(s)
		} else None();

		if (load_ml && selector == None()) Some(state)
		else {
			ctx = RuTacticContext(math, env, step_index, selector, None(), Some(ruMakeTacticBoard()));
			tactic_str = ruTaskStringArg(task, "tactic", "");
			default_builder = ruStaticTacticBuilder(ruDefaultReproveTactic(task));
			builder : RuTacticBuilder = if (tactic_str != "") {
				switch (ruParseAndBuildTactic(tactic_str, ctx)) {
					Some(b): b;
					None():  default_builder;
				}
			} else default_builder;

			do_coverage    = ruTaskIntArg(task, "coverage", 0) > 0;
			per_th_ms       = ruParseTime(ruTaskStringArg(task, "time-limit", "60s"));
			processed_count = ref 0;
			finished_count  = ref 0;
			reproved_count  = ref 0;
			started_ids     : ref [int] = ref [];
			finished_ids    : ref [int] = ref [];   // ruBuildAndProve returned (did not run out of its time slice)
			gaveup_ids      : ref [int] = ref [];   // returned WITHOUT a proof with its wall timer over (the engine gave up)
			reproved_ids    : ref [int] = ref [];
			total_steps     : ref int = ref 0;
			covered_steps   : ref int = ref 0;
			full_cov_count  : ref int = ref 0;   // theorems whose original proof is 100% covered
			gap_count       : ref int = ref 0;   // 100% covered but NOT reproved — engine-gap signal
			// Outer traversal is sequential (-seq target), so a plain ref Set is safe.
			// Count each theorem's coverage only on its first attempt; retries are skipped
			// to avoid inflating the denominator when fast-failing theorems get many retries.
			covered_th_ids  : ref Set<int> = ref makeSet();
			inc_reproved    = ruAtomicIntInc(reproved_count);
			inc_processed   = ruAtomicIntInc(processed_count);
			inc_finished    = ruAtomicIntInc(finished_count);
			push_started    = ruAtomicRefArrayPush(started_ids);
			push_finished   = ruAtomicRefArrayPush(finished_ids);
			push_gaveup     = ruAtomicRefArrayPush(gaveup_ids);
			push_reproved   = ruAtomicRefArrayPush(reproved_ids);
			add_total       = ruAtomicIntInc(total_steps);
			add_covered     = ruAtomicIntInc(covered_steps);
			inc_full_cov    = ruAtomicIntInc(full_cov_count);
			inc_gap         = ruAtomicIntInc(gap_count);
			do_replace      = ruTaskIntArg(task, "replace", 0) > 0;
			changed_count   = ref 0;
			inc_changed     = ruAtomicIntInc(changed_count);

			// The job budget (job-time-limit): a theorem is not STARTED once it has run out. It is
			// deliberately not folded into the mapper's budget — ruMapDeclsSequentially splits that
			// evenly over all theorems, so a 30m job cap would shrink every first-pass slice to
			// 30m / n (2 s on a 913-theorem run), kill every big proof, and rerun it in the retry
			// cycles while the killed attempt kept burning CPU in the background.
			job_limit_str = ruTaskStringArg(task, "job-time-limit", "");
			job_ms        = if (job_limit_str != "" && job_limit_str != "no") ruParseTime(job_limit_str) else doubleMax;
			job_timer     = ruMakeTimer();
			reprove_fn = \decl, time_limit, env1 -> {
				th = cast(decl : RuDecl -> RuTheorem);
				replaced : ref Maybe<RuDecl> = ref None();
				if (ruTheoremIsProved(th) && ruTimePassed(job_timer) < job_ms) {
					inc_processed(1);
					push_started(th.info.id);
					th_timer = ruMakeTimer();
					// Cap at per_th_ms so retries (which inherit the full remaining
					// job budget) cannot exceed the user-intended per-theorem limit.
					capped_limit = min(time_limit, per_th_ms);
					penv = ruBuildAndProve(th, task, index, builder, capped_limit, frag_pair, math, env1);
					inc_finished(1);
					push_finished(th.info.id);
					// A proof reached the goal AND respects the original theorem's
					// disjoint-variable budget (no strengthening). Both are required
					// for a genuine reproval of THIS theorem.
					reproved = length(^(penv.tree.proofs)) > 0 && ruReprovedWithinDisjs(th, penv, math, env1);
					if (!reproved && ruTimeIsOver(penv.conf.timer)) {
						push_gaveup(th.info.id);
					}
					if (reproved) {
						inc_reproved(1);
						push_reproved(th.info.id);
						if (do_replace) {
							// Install the first found proof within the theorem's $d budget.
							accepted = find(^(penv.tree.proofs), \p -> {
								normalized = ruNormalizeTheoremVarsDisjs(RuTheorem(th with proof = p));
								ruSubsetDisjs(normalized.infer.vars.disjs, th.infer.vars.disjs);
							});
							maybeApply(accepted, \p -> {
								new_th = ruNormalizeTheoremVarsDisjs(RuTheorem(th with proof = p));
								if (ru2s(new_th.proof, math) != ru2s(th.proof, math)) inc_changed(1);
								replaced := Some(new_th);
							});
						}
					} else if (length(^(penv.tree.proofs)) > 0 && env1.conf.verbose >= 3) {
						// The engine found proofs, but each needs MORE disjoint-variable conditions than the
						// theorem declares — a proof of a stronger-hypothesis statement, not of this theorem.
						env1.out.println("  " + id2s(th.info.id) + ": " + i2s(length(^(penv.tree.proofs))) +
							" root proof(s) found, ALL rejected by the $d check; theorem $d: {" + ruDisjs2s(th.infer.vars.disjs) + "}");
						iter(^(penv.tree.proofs), \p -> {
							normalized = ruNormalizeTheoremVarsDisjs(RuTheorem(th with proof = p));
							env1.out.println("    proof needs $d: {" + ruDisjs2s(normalized.infer.vars.disjs) + "}\n" +
								strIndent(strIndent(ru2s(p, math))));
						});
					}
					// Coverage extracted while the tree is still live, before GC.
					// Only count on first attempt per theorem to avoid retry inflation.
					if (do_coverage && !containsSet(^covered_th_ids, th.info.id)) {
						covered_th_ids := insertSet(^covered_th_ids, th.info.id);
						orig_tree = ruTheoremProofTree(th, math);
						cov = ruAlignProofWithTree(orig_tree, vector2array(penv.tree.root.children));
						tot = ruCoverageStepCount(cov);
						covd = ruCoveredStepCount(cov);
						add_total(tot);
						add_covered(covd);
						// full-covered = every original step explored; gap = fully
						// covered yet not reproved (the engine found the skeleton but
						// could not assemble a proof — an engine-gap signal, formerly
						// measure-coverage's distinguishing output).
						full_covered = tot > 0 && covd == tot;
						if (full_covered) inc_full_cov(1);
						if (full_covered && !reproved) inc_gap(1);
					}
				}
				switch (^replaced) {
					Some(d): RuMappedDecl(true, true, d);
					None():  RuMappedDecl(true, false, decl);
				}
			};

			// parallel=1: lightweight tactics that do not use the internal concurrent prover can
			// safely run theorems in parallel — pass the target through unchanged.
			// parallel=0 (default): ruProve uses ruConcurrent internally; running multiple
			// theorems concurrently causes nested thread-pool contention, so force a sequential
			// outer traversal via -seq.
			// Either way the mapper's budget is per_th * n: ruMapDeclsSequentially hands each
			// theorem total/n, so every theorem gets its full time-limit on the first pass (the
			// flood mode's slice is per_th * nproc, which capped_limit above trims to per_th).
			// Passed as a plain number of seconds, which ruParseTime reads back exactly.
			n_parallel    = ruTaskIntArg(task, "parallel", 0);
			run_parallel  = n_parallel > 0;
			n_theorems    = length(filter(ruTargetDecls(target, math, env), \d ->
				ruDeclIsTheorem(d) && ruTheoremIsProved(cast(d : RuDecl -> RuTheorem))
			));
			map_total_s   = per_th_ms * i2d(max(1, n_theorems)) / 1000.0;
			dispatch_task = RuTask(task with args =
				setTree(
					if (run_parallel) {
						// parallel=N > 1: bounded-width streaming (ruMapDeclsConcurrentlyBounded).
						if (n_parallel > 1) setTree(task.args, "map-width", i2s(n_parallel)) else task.args
					} else setTree(task.args, "target", ruTaskStringArg(task, "target", "all") + "-seq"),
					"time-limit", d2s(map_total_s)
				)
			);
			new_state = ruMapFnComm(
				RuUnit(dispatch_task, state, env.out),
				RuMapFn(
					RuMapFnInfo(
						"reprove",
						\decl -> ruTargetPredicate(target)(decl) && ruDeclIsTheorem(decl),
						\__ -> 1.0,
						\ -> "reproved: " + i2s(^reproved_count) + " theorems"
					),
					reprove_fn
				)
			);

			// reprove-stats=1 (conf option): the engine's phase tables — count, summed time
			// and, for the unifiers, the summed number of results — so a slow reprove can be
			// attributed to candidate generation, premise matching or proof propagation.
			if (ruOptsString(env.conf.opts, "reprove-stats", "") == "1") {
				tables = ["unify_assertion", "add_unified", "unify_premise", "ruExpandHyp", "ruExpandProp", "ruBuildPropProofs", "tactic-step", "ruAddProof-exhaustive", "ruAddProof-matrix", "ruAddProof-dedup", "prod-matrix", "prod-column", "prod-intersect", "prod-fold", "ruExpandLeafsInto-merge", "ruUnifySubs-ruDoUnifySubs"];
				env.out.println("reprove-stats (phase: count / time / results):");
				iter(tables, \t -> if (ruExistsStats(t)) {
					env.out.println("  " + rpad(t, " ", 20) +
						" count=" + ruShowStats(t, ruSumStats("count")) +
						" time=" + ruShowStats(t, ruSumStats("time")) +
						" rets=" + ruShowStats(t, ruSumStats("rets")));
				});
				iter(["prod-matrix", "prod-column", "prod-intersect", "prod-fold"], \t -> if (ruExistsStats(t)) {
					env.out.println("  " + t + ": max time=" + ruShowStats(t, ruMaxStats("time")) + " max size=" + ruShowStats(t, ruMaxStats("size")) +
						" max rets=" + ruShowStats(t, ruMaxStats("rets")) + " sum size=" + ruShowStats(t, ruSumStats("size")) +
						(if (t == "prod-matrix") " sum cols=" + ruShowStats(t, ruSumStats("cols")) + " max cols=" + ruShowStats(t, ruMaxStats("cols")) + " max rows=" + ruShowStats(t, ruMaxStats("rows")) else ""));
				});
				iter(["ruAddProof-exhaustive", "ruAddProof-matrix"], \t -> if (ruExistsStats(t)) {
					env.out.println("  " + t + ": max size=" + ruShowStats(t, ruMaxStats("size")) + " max time=" + ruShowStats(t, ruMaxStats("time")) +
						" max rets=" + ruShowStats(t, ruMaxStats("rets")) + "\n" + strIndent(strIndent(ruShowStats(t, ruDistribLogSumStats("size", "time", 12)))));
				});
				// add_unified sub-timers (expand.flow): 2 = ruAssertion2Vars, 3 = ruMakeFresherSubst
				// (fresh-var interning), 4 = ruUnsafeCompose, 5 = prop record + push, 6 = setTree.
				if (ruExistsStats("add_unified")) {
					env.out.println("  add_unified breakdown: vars=" + ruShowStats("add_unified", ruSumStats("time2")) +
						" fresher=" + ruShowStats("add_unified", ruSumStats("time3")) +
						" compose=" + ruShowStats("add_unified", ruSumStats("time4")) +
						" prop=" + ruShowStats("add_unified", ruSumStats("time5")) +
						" setTree=" + ruShowStats("add_unified", ruSumStats("time6")));
				}
			}
			// Compute not-reproved as started − reproved to avoid duplicates from
			// retry passes calling reprove_fn more than once for the same theorem.
			reproved_set   = buildSet(^reproved_ids);
			not_reproved   = set2array(fold(^started_ids, makeSet(), \acc, id ->
				if (containsSet(reproved_set, id)) acc else insertSet(acc, id)
			));
			// A started theorem that never finished ran out of its time slice (the per-theorem
			// time-limit, or the job budget) — a different story from a search that ended
			// without a proof, so the strict-fail message names both groups.
			// Two ways to run out of time: killed by the slice (never finished), or the engine's own
			// wall timer expired and it returned without a proof (gave up).
			finished_set = buildSet(^finished_ids);
			gaveup_set   = buildSet(^gaveup_ids);
			timed_out    = filter(not_reproved, \id -> !containsSet(finished_set, id) || containsSet(gaveup_set, id));
			// Theorems the job budget ran out BEFORE: never started, so neither reproved
			// nor failed — a silent pass with a short count unless strict-fail counts them.
			not_started  = n_theorems - sizeSet(buildSet(^started_ids));
			if (ruTaskIntArg(task, "strict-fail", 0) > 0 && (not_reproved != [] || not_started > 0)) {
				show_ids = \ids -> strGlue(map(take(ids, 32), id2s), ", ") + (if (length(ids) > 32) ", ..." else "");
				ruCrash("reprove: strict-fail: " + i2s(length(not_reproved)) + " theorem(s) failed to reprove" +
					(if (not_reproved == []) "" else ": " + show_ids(not_reproved)) +
					(if (timed_out == []) "" else
						"\n  of them " + i2s(length(timed_out)) + " ran out of the time limit (time-limit per theorem / the job budget): " + show_ids(timed_out)) +
					(if (not_started <= 0) "" else
						"\n  " + i2s(not_started) + " theorem(s) were never started: the job budget (job-time-limit) ran out"));
			}

			cov_vars = if (do_coverage) {
				n_tot = ^total_steps;
				n_cov = ^covered_steps;
				[
					Pair("covered-steps",  flow(n_cov)),
					Pair("total-steps",    flow(n_tot)),
					Pair("coverage-pct",   flow(if (n_tot > 0) i2d(n_cov) / i2d(n_tot) * 100.0 else 0.0)),
					Pair("full-cov-count", flow(^full_cov_count)),
					Pair("gap-count",      flow(^gap_count))
				]
			} else [];

			// Keep the run statistics ruMapFnComm stored under "reprove" (time, avg_time,
			// max_time, max_time_id, ...) and ADD the reprove-specific results to them.
			map_vars : Tree<string, flow> = switch (lookupTree(new_state.vars, "reprove")) {
				Some(v): cast(v : flow -> Tree<string, flow>);
				None():  makeTree();
			}
			Some(RuState(new_state with
				vars = setTree(new_state.vars, "reprove", mergeTree(map_vars, pairs2tree(concat([
					// Distinct theorems: a retried theorem can be counted per ATTEMPT otherwise (an
					// attempt that ran out of its slice keeps running in the background and may
					// still finish and report).
					Pair("reproved-count",  flow(sizeSet(reproved_set))),
					Pair("failed-count",    flow(length(not_reproved))),
					Pair("failed-theorems", flow(map(not_reproved, id2s))),
					Pair("timed-out-count", flow(length(timed_out))),
					Pair("changed-count",   flow(^changed_count)),
					Pair("not-started-count", flow(max(0, not_started)))
				], cov_vars))))
			))
		}
	}
}

ruDefaultReproveTactic(task : RuTask) -> RuProverTactic {
	max_depth = ruTaskIntArg(task, "max-depth", 5);
	max_size  = ruTaskIntArg(task, "max-size",  4096);
	ruLimitedTactic(ruBreadthFirstTactic, 0.0, 0, 0, max_size, max_depth, ruSearchBatch)   // strict bounded BFS
}

// Reproving means proving the ORIGINAL theorem, so a found proof may use the
// SAME or FEWER disjoint-variable ($d) restrictions than the theorem declares,
// but never MORE. A proof needing extra $d proves a strictly stronger-hypothesis
// theorem that merely shares the conclusion — not a reproval. Each found proof
// carries the $d its steps require; normalising RuTheorem(th with proof=p)
// surfaces them at theorem level, and ruSubsetDisjs(found, declared) accepts
// exactly the loosen-or-equal case.
ruReprovedWithinDisjs(th : RuTheorem, penv : RuProverEnv, math : RuMath, env : RuEnv) -> bool {
	exists(^(penv.tree.proofs), \p -> {
		normalized = ruNormalizeTheoremVarsDisjs(RuTheorem(th with proof = p));
		ruSubsetDisjs(normalized.infer.vars.disjs, th.infer.vars.disjs)
	})
}
