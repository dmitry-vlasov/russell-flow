import ru/prover/core/forward;
import ru/prover/core/prove;
import ru/prover/core/util;
import ru/prover/tactics/dsl;
import ru/util/target;
import ru/util/utils;
import ru/proof_tree;
import ru/verify/proof;
import base/concurrent;
import comm;

// Top-down (forward) ORACLE test (P4a). The oracle = the theorem's own proof:
// replay it FORWARD through the engine — for each proof step, apply its assertion
// to its children's already-derived facts via ruApplyForwardOn — and check the
// root produces a fact that covers the goal, with a verifier-accepted proof.
// This exercises the general forward application on a real proof's applications,
// guided (so tractable) — validating the top-down engine in isolation from the
// hard L2-selection problem.

export {
	ruCommTestForwardOracle : RuComm;
}

// Build the forward fact for a proof-tree node by replaying it bottom-up:
// hypotheses map to premise seeds; each step applies its assertion to its
// children's facts. None if any application fails to assemble.
ruOracleBuildFact(node : RuProofTree, seeds : [RuProverExp], prover_env : RuProverEnv) -> Maybe<RuProverExp> {
	switch (node) {
		RuProofHyp(h, __):
			if (h >= 0 && h < length(seeds)) Some(seeds[h]) else None();
		RuProofStep(aid, children, __): {
			cf = map(children, \c -> ruOracleBuildFact(c, seeds, prover_env));
			facts = filtermap(cf, idfn);
			if (length(facts) != length(cf)) None()
			else ruApplyForwardOn(lookupTreeDef(prover_env.math.decls.assertions, aid, ruNoAxiom), facts, prover_env);
		}
	}
}

ruCommTestForwardOracle = RuComm(
	RuCommInfo(
		"test/forward-oracle", "prover",
		"top-down oracle: replay a theorem's proof FORWARD through the engine and verify the goal is reached",
		"target", true, false,
		[
			RuCommArg("target", true, "a single theorem", "all"),
			RuCommArg("threads", true, "worker threads (0 = all cores)", "0"),
			RuCommArg("strict-fail", true, "1 = crash if the forward replay does not reconstruct the goal", "0")
		], []
	),
	ruRunTestForwardOracle
);

ruRunTestForwardOracle(unit : RuUnit) -> Maybe<RuState> {
	env   = ruUnitEnv(unit);
	task  = unit.task;
	state = unit.state;
	math  = ruMathFromSources(state.ru, env);
	target = ruDetermineTarget(task, math, env);
	theorems = filter(filtermap(ruTargetDecls(target, math, env), ruDecl2Theorem), ruTheoremIsProved);
	if (theorems == []) {
		env.out.error("test/forward-oracle: target has no theorem", []);
		Some(state);
	} else {
	one = \th : RuTheorem, e : RuEnv -> {
		index = ruMakeIndexForTarget(RuTargetDecl(th), math, e);
		prover_task = RuProverTask(th.info, ruDoneTactic, id2s(th.info.id), task.args, th.infer.hyps, ruProofQedStep(th.proof));
		prover_env = ruInitProver(prover_task, math, e, index, 60000.0);
		c_task    = ruConstProverTask(prover_task, math);
		cmath     = c_task.env.math;
		cpremises = c_task.const.premises;
		cgoal     = c_task.const.goal;

		fwd0  = ruInitProverForwardProved(cpremises, index, prover_env.math, e);
		seeds = fwd0.front;
		proof_tree = ruTheoremProofTree(th, math);

		root_fact = ruOracleBuildFact(proof_tree, seeds, prover_env);
		result = switch (root_fact) {
			None(): "NO-FACT (an application failed to assemble)";
			Some(pf): {
				gexp = ruExp(cgoal.stmt.exps[0]);
				fexp = ruExp(pf.stmt.exps[0]);
				// The goal must be an instance of the forward-derived root fact.
				switch (ruMatchExp(gexp, fexp, cmath, e)) {
					None(): "GOAL-NOT-COVERED  root=" + ru2s(fexp, cmath);
					Some(sigma): {
						// Specialise the root fact's proof to the goal and verify it.
						steps0 = ruMakeLinearProof(ruMakeProofTree(vector2array(pf.proofs)[0]));
						steps  = map(steps0, \st -> RuStep(st with
							stmt = RuStmt(st.stmt with exps = map(st.stmt.exps, \ex -> ruApplySubst(ruExp(ex), sigma)))
						));
						taskG = RuProverTask(prover_task with premises = cpremises, goal = cgoal);
						if (isSome(ruMakeProofFromSteps(taskG, steps, cmath, e))) "RECONSTRUCTED+VERIFIED"
						else "GOAL-COVERED-BUT-UNVERIFIED";
					}
				}
			}
		};
		result;
	};
	results = ruConcurrentLimited(map(theorems, \th -> \e -> Pair(th.info.id, one(th, e))), if (ruTaskIntArg(task, "threads", 0) <= 0) 1000 else ruTaskIntArg(task, "threads", 0), env);
	ok = filter(results, \r -> r.second == "RECONSTRUCTED+VERIFIED");
	bad = filter(results, \r -> r.second != "RECONSTRUCTED+VERIFIED");
	if (length(theorems) == 1) {
		env.out.println("test/forward-oracle: theorem=" + id2s(theorems[0].info.id) + "  => " + results[0].second);
	} else {
		env.out.println("test/forward-oracle: " + i2s(length(ok)) + "/" + i2s(length(results)) + " reconstructed+verified");
		iter(take(bad, 12), \r -> env.out.println("  NOT-RECONSTRUCTED: " + id2s(r.first) + " => " + r.second));
	};
	if (ruTaskIntArg(task, "strict-fail", 0) > 0 && bad != []) {
		ruCrash("test/forward-oracle: forward replay failed for " + i2s(length(bad)) + " theorem(s)");
	}
	Some(state);
	}
}
