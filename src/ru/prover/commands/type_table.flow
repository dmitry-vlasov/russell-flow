import ru/prover/tactics/type_table;
import ru/math;
import comm;
import base/comms;
import base/ids;

// The TYPE-REGISTRY report (soft-type-layer.md §4.1/§7): scan the loaded articles into the
// type table and print what the soft-type layer actually contains — mode/attribute unfolds and
// the three cluster-registration kinds, per role and per head. Informational only; nothing
// here touches proof search. Invoked through the script wrapper (which does the read):
//   russellj no-server=1 info/type-table file=mizar/subset_1.ru
//   russellj no-server=1 info/type-table file=mizar/subset_1.ru dump=1

export {
	ruCommTypeTable : RuComm;
}

ruCommTypeTable = RuComm(
	RuCommInfo(
		"info-type-table", "info",
		"scan the loaded sources into the soft-type registry; report unfolds and cluster rules",
		"", true, false,
		[
			RuCommArg("dump", true, "1 = print every classified rule", "0"),
			RuCommArg("role", true, "restrict to one role (def, func-cluster, cond-cluster, ex-cluster)", ""),
			RuCommArg("top",  true, "how many heads to list by rule count", "12")
		], []
	),
	ruRunTypeTable
);

ruRunTypeTable(unit : RuUnit) -> Maybe<RuState> {
	env  = ruUnitEnv(unit);
	math = ruMathFromSources(unit.state.ru, env);
	table = ruTypeTable(math);
	roleArg = ruTaskStringArg(unit.task, "role", "");
	inRole = \r : RuTyRule -> roleArg == "" || roleArg == "all" || ruTyRole2s(r.role) == roleArg;

	counts = fold(table.all, makeTree(), \acc, r ->
		setTree(acc, ruTyRole2s(r.role), lookupTreeDef(acc, ruTyRole2s(r.role), 0) + 1));
	nguard = length(filter(table.all, \r -> r.guarded));
	npar   = length(filter(table.all, \r -> r.arity > 1));
	env.out.println("type table: " + i2s(length(table.all)) + " rules over "
		+ i2s(sizeTree(table.byHead)) + " heads"
		+ " (" + i2s(npar) + " parameterised, " + i2s(nguard) + " with a guarded/empty-case split)");
	traverseInOrder(counts, \role, n -> env.out.println("  " + role + ": " + i2s(n)));

	// the busiest heads — where the type layer's mass actually is
	top = s2i(ruTaskStringArg(unit.task, "top", "12"));
	heads = mergeSort(map(tree2pairs(table.byHead), \p -> Pair(length(p.second), p.first)),
		\a, b -> b.first - a.first);
	env.out.println("  busiest heads:");
	iter(take(heads, top), \p ->
		env.out.println("    " + id2s(p.second) + ": " + i2s(p.first)));

	if (ruTaskStringArg(unit.task, "dump", "0") == "1") {
		iter(filter(table.all, inRole), \r ->
			env.out.println("  " + ruTyRole2s(r.role) + "  " + id2s(r.assId)
				+ "  head=" + id2s(r.head) + "/" + i2s(r.arity) + (if (r.guarded) "  [guarded]" else "")));
	} else {};
	Some(unit.state);
}
