import ru/prover/core/forward;
import ru/prover/core/prove;
import ru/prover/core/util;
import ru/prover/tactics/dsl;
import ru/util/target;
import ru/util/utils;
import comm;

// P3 check: the acyclicity invariant of the forward front (the one genuinely new
// correctness check the bidirectional engine needs), plus structural soundness.
//
// For the proof-carrying forward front of a theorem it asserts:
//   (1) DAG          — no derived fact depends (transitively) on itself;
//   (2) premise-grounded — every fact's proof tree bottoms out in premise refs,
//                      so a forward proof can never reference a backward node
//                      (this is WHY a premise-grown front is acyclic by build);
//   (3) join-safety  — ruJoinAcyclic ACCEPTS grafting a fact onto the root goal
//                      (the goal is not among the fact's premise deps) and
//                      REJECTS grafting it onto one of its own dependencies
//                      (which would be a self-supporting cycle).
//
// Additivity is structural: this and all forward code live off the live engine,
// so forward-off is byte-identical to today (the full test/all battery is green).

export {
	ruCommTestForwardAcyclic : RuComm;
}

ruCommTestForwardAcyclic = RuComm(
	RuCommInfo(
		"test/forward-acyclic", "prover",
		"P3 check: forward front is an acyclic, premise-grounded DAG; ruJoinAcyclic accepts/rejects correctly",
		"target", true, false,
		[
			RuCommArg("target", true, "a single theorem to take premises from", "all"),
			RuCommArg("depth",  true, "forward depth", "3"),
			RuCommArg("strict-fail", true, "1 = crash on any unsound fact / join-safety fail", "0")
		], []
	),
	ruRunTestForwardAcyclic
);

ruRunTestForwardAcyclic(unit : RuUnit) -> Maybe<RuState> {
	env   = ruUnitEnv(unit);
	task  = unit.task;
	state = unit.state;
	math  = ruMathFromSources(state.ru, env);
	target = ruDetermineTarget(task, math, env);
	depth = ruTaskIntArg(task, "depth", 3);

	theorems = filtermap(ruTargetDecls(target, math, env), ruDecl2Theorem);
	if (theorems == []) {
		env.out.error("test/forward-acyclic: target has no theorem", []);
		Some(state);
	} else {
		th = theorems[0];
		index = ruMakeIndexForTarget(target, math, env);
		prover_task = RuProverTask(
			th.info, ruDoneTactic, id2s(th.info.id),
			task.args, th.infer.hyps, ruProofQedStep(th.proof)
		);
		prover_env = ruInitProver(prover_task, math, env, index, 60000.0);
		c_task    = ruConstProverTask(prover_task, math);
		cpremises = c_task.const.premises;
		cgoal     = c_task.const.goal;

		fwd0 = ruInitProverForwardProved(cpremises, index, prover_env.math, env);
		final_fwd = foldRange(1, depth, fwd0, \fwd, __ ->
			fold(fwd.front, RuProverForward(fwd with front = []), \st, fact ->
				// Test-harness bound only (NOT an engine cap): without L2 selection the
				// general forward engine expands exhaustively, so cap the front so this
				// correctness check stays runnable.
				if (ruIndexDataCount(st.index) >= 600) st else ruExpandForwardProved(st, fact, prover_env).first
			)
		);

		// Exclude the depth-0 seeds; only derived facts have a derivation to check.
		premise_keys = fold(cpremises, makeSet(), \acc, p -> insertSet(acc, ruExpKey(ruExp(p.stmt.exps[0]))));
		derived = filter(ruIndexValues(final_fwd.index), \f ->
			!containsSet(premise_keys, ruExpKey(ruExp(f.stmt.exps[0]))));

		// (1)+(2): every derived fact is an acyclic, premise-grounded proof.
		unsound = filter(derived, \f -> !ruForwardFactSound(f));

		// (3): join-safety on a derived fact that actually has dependencies.
		goal_key = ruExpKey(ruExp(cgoal.stmt.exps[0]));
		with_deps = filter(derived, \f -> sizeSet(ruForwardDepKeys(f)) > 0);
		join_ok = if (with_deps == []) true else {
			f = with_deps[0];
			dep = set2array(ruForwardDepKeys(f))[0];
			// accept grafting onto the goal (not a dependency), reject grafting onto
			// an actual dependency (would close a cycle).
			ruJoinAcyclic(f, goal_key) && !ruJoinAcyclic(f, dep);
		};

		ok = unsound == [] && join_ok;
		env.out.println(
			"test/forward-acyclic: theorem=" + id2s(th.info.id) +
			" depth=" + i2s(depth) +
			"  derived=" + i2s(length(derived)) +
			" unsound=" + i2s(length(unsound)) +
			" join-safety=" + (if (join_ok) "ok" else "FAIL") +
			"  => " + (if (ok) "ACYCLIC-SOUND" else "FAILURE")
		);
		if (ruTaskIntArg(task, "strict-fail", 0) > 0 && !ok) {
			ruCrash("test/forward-acyclic: " + i2s(length(unsound)) + " unsound fact(s), join-safety " + (if (join_ok) "ok" else "FAIL"));
		}
		Some(state);
	}
}
