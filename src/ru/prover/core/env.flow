import base/util/math;
import ru/prover/core/util;
import ru/prover/core/conf;
import ru/prover/core/fragment;
import ru/prover/core/forward_closure;
import ru/unify/indexes;
import ru/verify/math;

export {

	RuTacticStack(
		tactic : RuProverTactic,
		parent : Maybe<RuTacticStack>
	);

	// The dynamic forward front (bidirectional search). Defined here, next to
	// RuProverEnv, so RuProverEnv can hold one without a circular import (the
	// forward.flow operations import this module for RuProverEnv). See forward.flow.
	// One rule-headed hypothesis of an assertion, used as a forward trigger:
	// when a fact matches hyp `pos` of `assertion`, the other hyps are filled
	// from the front and the conclusion is derived (forward modus ponens etc.).
	RuFwdHyp(assertion : RuAssertion, pos : int);

	RuProverForward(
		// Produced facts keyed by expression: dedup during growth and the
		// lookup structure the interior join polls.
		index    : RuIndex<RuProverExp>,
		// Facts created but not yet forward-expanded (the frontier).
		front    : [RuProverExp],
		// Single-hypothesis assertions keyed by their hypothesis expression.
		hypIndex : RuIndex<RuAssertion>,
		// Multi-hypothesis (>=2) assertions: each RULE-HEADED hyp keyed by its
		// expression, paired with its position. Bare-metavar hyps are excluded as
		// triggers (they match everything ⇒ explosion); they get filled from the
		// front instead. Empty for the single-hyp-only forward front.
		multiHyp : RuIndex<RuFwdHyp>,
		// Structural keys of every fact seen, to avoid re-deriving duplicates.
		seen     : Set<[RuExpNode]>,
		// POSITIONAL correspondence: proof-DAG path -> the forward fact derived at that
		// path. The completeness-test join uses this to connect a forward fact to the
		// backward subgoal at the SAME proof-DAG node (ruNodePath), instead of every
		// subgoal it merely unifies with — exact, positional identity. Empty otherwise.
		pathIndex : Tree<[int], RuProverExp>
	);

	RuProverEnv(
		conf : RuProverConf,
		tree : RuProverTree,

		toExpand : ref [int],
		//tactics : Maybe<RuTacticStack>,
		tactic : ref Maybe<RuProverTactic>,

		math : RuMath,
		env : RuEnv,
		fns : RuProverFuncs,
		importDependencies : Tree<int, Set<int>>,
		fragmentTrees : Tree<int, RuProofFragment>,

		// Assertion IDs permanently excluded from unification during this proof session.
		// Modified by prove-forbid; checked inside fns.unifyAssertion.
		forbidden : ref Set<int>,

		// When non-empty, only assertions with these IDs are allowed (overrides forbidden).
		// Temporarily set by prove-expand with assertion= arg; always restored after.
		whitelist : ref [int],

		// The proof-carrying dynamic forward front (bidirectional search). None
		// when forward-search-depth = 0 (the default) — then the interior join is
		// inert and the engine is byte-identical to today. Built once after the
		// env is constructed (it needs the env for ruAddProof); a ref so that
		// build step can populate it. Polled at the backward splice in expand.flow.
		forwardFront : ref Maybe<RuProverForward>,

		// The backward subgoal index: every OPEN backward subgoal E-node, keyed by
		// expression. The symmetric counterpart to forwardFront — together they are
		// the universal join: on creating any node, the engine checks the OPPOSITE
		// index. A backward subgoal checks the forward front (expand.flow); a new
		// forward fact checks THIS index (forward.flow). Populated as backward
		// subgoals are created. Inert while empty.
		backwardFront : ref RuIndex<RuProverExp>,

		// The assertion index this proof session searches over (the same index
		// ruInitProverEnv is handed). Kept so the `forward` tactic atom can seed the
		// proof-carrying forward front on demand (ruSeedForwardFront) without the
		// caller re-threading the index. The proof-reconstruction constructor
		// (proof2theorem.flow), which never uses forward, stores an empty index.
		assertions : RuIndex<RuAssertion>,

		// Refutation mode (the `assume-neg` atom): when true, ruSeedForwardFront ALSO
		// seeds the negated-goal deduction facts `¬G→¬G` (id) and `¬G→hyp_i` (a1i), so
		// the forward wave can saturate ¬G to a clash and derive G via pm2.65i+notnotr —
		// the law-abiding realization of the Mizar `by`-checker's refutational procedure.
		// Inert (byte-identical to today) while false.
		refute : ref bool,

		// Ordered-saturation steering (the `ordered` atom): when true, each forward
		// wave processes its frontier in ≺-ascending term-size order (smallest facts
		// first), so under a fact budget the small saturation core (equality chains,
		// literals) stays ahead of term-GROWING congruence junk — ordered rewriting
		// as a pure L2 SELECTION policy. Facts are REORDERED, never discarded
		// (completeness invariant: a LIMIT hit later is still just a limit).
		// Inert (byte-identical FIFO) while false.
		ordered : ref bool,

		// Instantiation mode (the `instantiate` atom, the Mizar UNIFIER): when true,
		// ruSeedForwardFront ALSO seeds each ∀-premise instantiated at candidate terms
		// (class-typed subterms of the goal/premises) via hand-constructed spcv chains
		// (ruSeedInstantiateFront). Inert while false.
		instantiate : ref bool,

		// JOIN-ADMISSION policy (L2-provided, like whitelist/ordered): consulted by
		// ruReverseJoin before grafting a forward fact onto a backward subgoal.
		// L1 only ASKS — it never decides which joins matter (the engine stays
		// calculus-agnostic; taming e.g. cut-style bare subgoals is an L2 selection
		// concern). Default: admit everything (byte-identical to the plain engine).
		admitJoin : ref (RuProverExp, RuProverExp) -> bool
	);

	RuProverFuncs(
		admitExp : (RuExp) -> bool,
		unifyAssertion : (RuProverHyp) -> [RuUnified<RuAssertion>],
		unifyPremise   : (RuProverHyp) -> [RuUnified<RuPremise>],
		unifyFragment  : (RuProverHyp) -> [RuUnified<RuAssertion>],
		// True if the expression directly unifies with any current theorem premise.
		// Strict literal-premise semantic: used by linear_guided as a 1-step closure
		// oracle. DO NOT broaden to include forward-derived facts here; that would
		// invalidate linear_guided's "this assertion closes everything" assumption.
		matchesPremise : (RuExp) -> bool,
		// Forward-closure equivalent of unifyPremise: returns every closure fact
		// whose expression unifies with the leaf's expression, plus the unifier.
		// Each result's data carries the RuFwWitness needed for splicing.
		// Empty when the closure was built with forward-closure-depth = 0.
		unifyClosure : (RuProverHyp) -> [RuUnified<RuForwardFact>],
		fresher : (RuVar) -> RuVar,
		unconst : (RuExp) -> RuExp,
		onProof : (RuProofTree) -> void,
		onProp : (RuProverProp) -> void,
		idxer : () -> int,
		// Proof-variant admission hook, consulted at every point a proof variant is
		// about to be emitted onto a node (the E-node join/propagation sites and the
		// prop-level assembly). Returns whether to keep it. DEFAULT: \__ -> true
		// (inert — the engine emits every variant, byte-identical to today). The ONLY
		// override is the bidirectional completeness-test oracle tactic (the single
		// sanctioned L1/L2 exception, see [[feedback_l1l2_oracle_exception]]), which
		// (1) DEDUPS variants so top-down and bottom-up never emit the same proof twice
		// (the ADDITIVE invariant) and (2) bounds each node to `limit` variants while
		// always keeping the target proof — limit=1 gives strict one-proof-per-node.
		keepVariant : (RuProverProof) -> bool
	);

	ruInitProverEnv(
		task : RuProverTask,
		math : RuMath,
		env : RuEnv,
		assertions : RuIndex<RuAssertion>,
		time_limit : double
	) -> RuProverEnv;

	ruInitProverEnvWithFrags(
		task : RuProverTask,
		math : RuMath,
		env : RuEnv,
		assertions : RuIndex<RuAssertion>,
		time_limit : double,
		frag_pair : Pair<RuIndex<RuAssertion>, Tree<int, RuProofFragment>>
	) -> RuProverEnv;
}

ruEstimateMaxExp(index : RuIndex<RuAssertion>) -> int {
	theorems = filtermap(ruIndexValues(index), ruDecl2Theorem);
	proofs = map(theorems, \th -> th.proof);
	steps = ruConcatA(map(proofs, ruAllProofSteps));
	step_exp_lens = map(steps, \step ->
		i2d(fold(step.stmt.exps, 0, \acc, ex -> acc + length(ex.nodes)))
	);

	sum_num_max = ruSumDoublesFromArray(step_exp_lens);
	len_num_max = ruMaxDoubleFromArray(step_exp_lens);
	if (len_num_max < 4096.0) 256 else {
		avg_len = sum_num_max / i2d(length(step_exp_lens));
		sigma_sum = fold(step_exp_lens, 0.0, \acc, len ->
			acc + (len - avg_len) * (len - avg_len)
		);
		sigma = sqrt(sigma_sum / len_num_max);
		round(avg_len + 3.0 * sigma);
	}
	round(len_num_max + 64.0);
}

ruEstimateMaxExp1(index : RuIndex<RuAssertion>) -> int {
	len_num_max = ruFoldIndex(index, Triple(0.0, 0, 0), \acc, ass ->
		eitherMap(ruDecl2Theorem(ass), \th ->
			fold(th.proof.steps, acc, \ac, step -> {
				len = fold(step.stmt.exps, 0, \a, ex -> a + length(ruExp(ex).nodes));
				Triple(ac.first + i2d(len), ac.second + 1, max(acc.third, len))
			}),
			acc
		)
	);
	if (len_num_max.second < 4096) 256 else {
		avg_len = len_num_max.first / i2d(len_num_max.second);
		sigma_sum = ruFoldIndex(index, 0.0, \acc, ass ->
			eitherMap(ruDecl2Theorem(ass), \th ->
				fold(th.proof.steps, acc, \ac, step -> {
					delta = i2d(fold(step.stmt.exps, 0, \a, ex -> a + length(ruExp(ex).nodes))) - avg_len;
					ac + delta * delta;
				}),
				acc
			)
		);
		sigma = sqrt(sigma_sum / i2d(len_num_max.second));
		round(avg_len + 3.0 * sigma);
	}
	len_num_max.third + 64;
}

ruInitProverEnv(
	task : RuProverTask,
	math0 : RuMath,
	env : RuEnv,
	assertions : RuIndex<RuAssertion>,
	time_limit : double
) -> RuProverEnv {
	max_frag_depth = {
		frag_val = lookupTreeDef(task.args, "fragment-depth", "0");
		if (runtimeValueType(frag_val) == "int") cast(frag_val : flow -> int)
		else s2i(cast(frag_val : flow -> string));
	};
	ruInitProverEnvWithFrags(task, math0, env, assertions, time_limit,
		ruBuildFragments(math0, max_frag_depth, env)
	);
}

// NOTE: frag_pair is the full global fragment index without source-order filtering.
// Use only from reproval/benchmarking contexts (reprove-dumb, reprove-with-oracle).
// Do NOT call from interactive proving or the oracle prover — fragments may reference
// theorems that are not yet proven at the point of use.
ruInitProverEnvWithFrags(
	task : RuProverTask,
	math0 : RuMath,
	env : RuEnv,
	assertions : RuIndex<RuAssertion>,
	time_limit : double,
	frag_pair : Pair<RuIndex<RuAssertion>, Tree<int, RuProofFragment>>
) -> RuProverEnv {
	c_task = ruConstProverTask(task, math0);
	math = c_task.env.math;
	premises = ruInitTaskPremisesIndex(c_task.const);
	frag_index = frag_pair.first;
	frag_trees = frag_pair.second;

	// Forward closure over the task premises. When forward-closure-depth = 0
	// (default), this index is exactly the premises themselves and matchesPremise
	// behavior is unchanged from before. When > 0, single-hypothesis assertions
	// are iteratively applied to extend the index, so matchesPremise also
	// detects expressions reachable from the premises in k forward steps.
	fc_depth = {
		v = lookupTreeDef(task.args, "forward-closure-depth", "0");
		if (runtimeValueType(v) == "int") cast(v : flow -> int)
		else s2i(cast(v : flow -> string));
	};
	fc_size = {
		v = lookupTreeDef(task.args, "forward-closure-size", "1024");
		if (runtimeValueType(v) == "int") cast(v : flow -> int)
		else s2i(cast(v : flow -> string));
	};
	fc_fresh_id = ref 0;
	fc_inc_fresh_id = ruAtomicIntAdd(fc_fresh_id);
	fc_fresher = \v : RuVar -> RuVar(s2id(id2s(v.id) + "_fc" + i2s(fc_inc_fresh_id(1))), v.type);
	premises_with_idx = map(c_task.const.premises, \p -> Pair(ruExp(p.stmt.exps[0]), p.ind));
	forward_closure = ruBuildForwardClosure(
		premises_with_idx, assertions, fc_fresher, math, env, fc_depth, fc_size
	);
	proofs : ref [RuProof] = ref [];
	root = RuProverRoot(makeVector(5), c_task.const.goal.stmt, makeVector(1024));
	id = ref 0;
	inc_id = ruAtomicIntAdd(id);
	fresh_id = ref 0;
	inc_fresh_id = ruAtomicIntAdd(fresh_id);
	forbidden = ref makeSet();
	whitelist = ref [];
	add_proof = synchronizedUnaryFn(proofs, \proof_root -> {
		steps = map(ruMakeLinearProof(proof_root), \st ->
			RuStep(st with
				stmt = RuStmt(st.stmt with
					exps = map(st.stmt.exps, \ex -> c_task.env.unconst(ruExp(ex)))
				)
			)
		);
		switch (ruMakeProofFromSteps(task, steps, math, env)) {
			Some(proof): {
				refArrayPush(proofs, proof);
			}
			None(): {
							}
		}
	})
	//max_expr_len = ruEstimateMaxExp(assertions);

	funcs = RuProverFuncs(
		\expr -> true,//length(expr.nodes) < max_expr_len,
		\hyp -> filter(ruUnifyIndex(ruExp(hyp.stmt.exps[0]), assertions, ruEmptySubst, math, env), \u ->
			if (length(^whitelist) > 0) contains(^whitelist, u.data.info.id)
			else !containsSet(^forbidden, u.data.info.id)
		),
		\hyp -> ruUnifyIndex(ruExp(hyp.stmt.exps[0]), premises, ruEmptySubst, math, env),
		\hyp -> ruUnifyIndex(ruExp(hyp.stmt.exps[0]), frag_index, ruEmptySubst, math, env),
		\exp -> length(ruUnifyIndex(exp, premises, ruEmptySubst, math, env)) > 0,
		\hyp -> ruUnifyIndex(ruExp(hyp.stmt.exps[0]), forward_closure, ruEmptySubst, math, env),
		\v -> RuVar(s2id(id2s(v.id) + "_" + i2s(inc_fresh_id(1))), v.type),
		c_task.env.unconst,
		add_proof,
		nop1,
		\-> inc_id(1),
		\__ -> true
	);
	RuProverEnv(
		RuProverConf(
			task,
			ruMakeLimitedTimer(time_limit),
		),
		RuProverTree(makeTree(), makeTree(), root, proofs),
		ref [], ref Some(task.tactic),
		math, env, funcs,
		ruSourcesAllImported(math.sources, env),
		frag_trees,
		forbidden,
		whitelist,
		ref None(),
		ref ruMakeIndex(),
		assertions,
		ref false,
		ref false,
		ref false,
		ref \__, __ -> true,
	);
}
