import ru/prover/core/env;
import ru/prover/core/tree;
import ru/prover/core/proofs;
import ru/prover/core/util;

// ---------------------------------------------------------------------------
// Bidirectional search: a DYNAMIC forward front, grown one node per call.
//
// This is the structural mirror of ruExpandHyp (core/expand.flow). Where
// ruExpandHyp matches a GOAL against assertion CONCLUSIONS and fans the
// assertion's hypotheses into child subgoals, ruExpandForward matches a known
// FACT against assertion HYPOTHESES and emits the assertion's CONCLUSION as a
// new derived fact. Same `unify -> substitute -> emit` primitive, same node
// records (RuProverProp / RuProverExp) — see [[engine-owns-proofs]].
//
// SCOPE OF THIS LAYER (deliberately minimal, fully additive):
//   - single-hypothesis assertions only;
//   - builds PVT STRUCTURE + a forward index, NO proof variants and NO
//     propagation (a fresh forward node has nothing below it, so nothing
//     propagates — eager propagation fires only at a JOIN, wired by the
//     proof-building layer below);
//   - lives in its own module and is not wired into RuProverEnv, so with the
//     forward front unused the engine is byte-for-byte today's engine
//     (the additivity invariant).
//
// ORIENTATION. A produced fact is a forward "top" (like the backward ROOT it
// has no consumer yet), so its RuProverExp.parent is the ruNoProverProp
// sentinel. The derivation step propA links downward: propA.parent = the
// produced fact, propA.children = [the input fact]. The proof-building layer wires
// the join and the upward propagation that this orientation enables; until then
// nothing walks a forward parent chain, so the sentinel top is safe.
// ---------------------------------------------------------------------------

// RuProverForward is defined in core/env.flow (so RuProverEnv can hold one
// without a circular import); this module provides its operations.

export {
	// Seed the front with the task premises (each paired with its theorem-hyp
	// index) and build the single-hyp assertion index. assertions is the same
	// index ruInitProverEnv is handed.
	ruInitProverForward(
		premises   : [Pair<RuExp, int>],
		assertions : RuIndex<RuAssertion>,
		math       : RuMath,
		env        : RuEnv
	) -> RuProverForward;

	// Expand ONE forward fact: match it against every single-hyp assertion
	// hypothesis and emit the resulting conclusions as new facts. Returns the
	// updated front state; the second component is the freshly produced facts
	// (so a caller / test can inspect exactly what this one step derived).
	ruExpandForward(
		fwd        : RuProverForward,
		fact       : RuProverExp,
		fresher    : (RuVar) -> RuVar,
		idxer      : () -> int,
		math       : RuMath,
		env        : RuEnv
	) -> Pair<RuProverForward, [RuProverExp]>;

	// ----- forward proof building + the join -----------------------------
	// Same as ruInitProverForward, but each premise seed carries a real proof
	// variant (a RuProverProofTop hypothesis reference), so ruExpandForwardProved
	// can chain proofs through ruAddProof. cpremises must be in the prover's
	// const form (the form prover_env.math uses).
	ruInitProverForwardProved(
		cpremises  : [RuPremise],
		assertions : RuIndex<RuAssertion>,
		math       : RuMath,
		env        : RuEnv
	) -> RuProverForward;

	// Like ruExpandForward, but additionally BUILDS each produced fact's proof
	// variants by routing the input fact's proofs through the engine's ruAddProof
	// (no hand-built proofs — the law-abiding path). The produced fact ends up
	// with RuProverProofStmt variants in its .proofs, ready to be grafted at a
	// join. Needs a real RuProverEnv for ruAddProof / fresher / idxer.
	ruExpandForwardProved(
		fwd        : RuProverForward,
		fact       : RuProverExp,
		prover_env : RuProverEnv
	) -> Pair<RuProverForward, [RuProverExp]>;

	// ----- acyclicity (the one genuinely new correctness check) -----------
	// The dependency set of a forward fact: the node-lists (RuExp.nodes, compared
	// structurally by the Set) of every INPUT fact used, transitively, to derive it —
	// down to the premise seeds. A premise seed has no inputs, so its dep set is empty.
	// Walks the node structure (produced fact -> its prop -> the prop's input fact -> ...).
	ruForwardDepKeys(fact : RuProverExp) -> Set<[RuExpNode]>;

	// The join-safety predicate. A join grafts forward fact `fact`'s proof onto a
	// backward node whose statement has key `target_key`. That is acyclic iff the
	// forward derivation does NOT already depend on the target — otherwise the
	// grafted proof would (transitively) depend on the very node it is proving,
	// i.e. a self-supporting cycle. This is the one new check the bidirectional
	// engine needs; everything else reuses the existing acyclic-by-construction
	// machinery. (Forward facts grown only from premises are premise-grounded, so
	// this always holds for them; the check earns its keep once forward nodes can
	// be seeded from backward-discovered subgoals.)
	ruJoinAcyclic(fact : RuProverExp, target_key : [RuExpNode]) -> bool;

	// Structural soundness of a built fact: (a) DAG — the fact does not depend on
	// itself; (b) premise-grounded — every leaf of its proof tree is a premise
	// hypothesis reference (so a forward proof can never reference a backward
	// node, which is WHY the front is acyclic by construction).
	ruForwardFactSound(fact : RuProverExp) -> bool;

	// Number of steps in a fact's (first) proof tree — a uniform "shallowness"
	// measure for ordering join candidates (works for both single- and multi-hyp
	// facts, unlike the dep-key count which a multi-hyp fact leaves empty).
	ruForwardProofSize(fact : RuProverExp) -> int;

	// ----- wire the proof-carrying front into the live engine ------------
	// If forward-search-depth > 0 in the task args, build the proof-carrying
	// forward front (to that depth, capped by forward-search-size) and install it
	// in prover_env.forwardFront, so the backward splice in expand.flow can close
	// leaves with forward-derived proofs. A no-op when the flag is 0 — then the
	// engine is byte-identical to today. Must be called AFTER prover_env is fully
	// constructed (it grows the front through prover_env's ruAddProof).
	ruMaybeBuildForwardFront(
		prover_env : RuProverEnv,
		task       : RuProverTask,
		assertions : RuIndex<RuAssertion>
	) -> void;

	// Apply an assertion to n given fact E-nodes (one per hypothesis, in order),
	// no front search — the top-down oracle uses this to replay a proof forward.
	ruApplyForwardOn(
		assertion : RuAssertion,
		facts     : [RuProverExp],
		prover_env : RuProverEnv
	) -> Maybe<RuProverExp>;

	// Universal join, forward->backward: discharge every open backward subgoal a new
	// forward fact covers (forward-search feature).
	ruReverseJoin(pf : RuProverExp, prover_env : RuProverEnv) -> void;

	// ----- the `forward` tactic atom's engine hooks ----------------------
	// Seed a depth-0 proof-carrying forward front (task premises as facts + the
	// single-/multi-hyp assertion indexes) into prover_env.forwardFront IF none is
	// installed yet, so the `forward` atom can drive waves from the premises. A no-op
	// when a front already exists (e.g. forward-search-depth pre-grew one). MUST run
	// BEFORE ruExpandHyp(root) so the root's backward subgoals register in
	// backwardFront (the reverse-join index; expand.flow gates that on forwardFront
	// != None). Const form matches prover_env.math (ruConstProverTask is deterministic).
	// Reads the task and assertion index from prover_env (conf.task / assertions).
	ruSeedForwardFront(prover_env : RuProverEnv) -> void;

	// Advance the forward front by ONE wave: expand every fact currently in the
	// frontier (fwd.front) via ruExpandForwardProved, and set the new frontier to the
	// facts derived this wave (the forward mirror of one BFS round over the backward
	// frontier). Joins fire inside ruExpandForwardProved (ruReverseJoin) and via the
	// backward splice as facts are created; all proofs are engine-built through
	// ruAddProof. Returns whether the wave produced any new facts (false = front
	// exhausted / no front installed → the driver stops). Engine-level (L1); the
	// `forward` tactic only signals when to call it.
	ruRunForwardWave(prover_env : RuProverEnv) -> bool;

	// Positional proof-DAG path of a backward node (hypothesis-index sequence).
	ruNodePath(h : RuProverHyp) -> [int];
}

ruInitProverForward(
	premises   : [Pair<RuExp, int>],
	assertions : RuIndex<RuAssertion>,
	math       : RuMath,
	env        : RuEnv
) -> RuProverForward {
	one_hyp_asses = filter(ruIndexValues(assertions), \ass ->
		length(ass.infer.hyps) == 1
	);
	hyp_index = fold(one_hyp_asses, ruMakeIndex(), \acc, ass -> {
		h = ass.infer.hyps[0];
		ruSetIndex(ruExp(h.stmt.exps[0]), ass, acc);
	});
	// Each premise becomes a forward "top": a RuProverExp with the premise's
	// theorem-hyp index as `ind`, no proofs yet, no children, sentinel parent.
	seed_facts = map(premises, \p ->
		RuProverExp(p.second, makeVector(0), RuStmt(ruNoStmt with exps = [p.first]), makeVector(0), ruNoProverProp)
	);
	seen0 = fold(seed_facts, makeSet(), \acc, f -> insertSet(acc, (ruExp(f.stmt.exps[0])).nodes));
	idx0  = fold(seed_facts, ruMakeIndex(), \acc, f -> ruSetIndex(ruExp(f.stmt.exps[0]), f, acc));
	RuProverForward(idx0, seed_facts, hyp_index, ruMakeIndex(), seen0, makeTree());
}

// A bare metavariable hypothesis (the whole expr is a single variable node)
// matches every fact, so it must NOT be a forward trigger — it is filled from
// the front instead. Anything with structure (or a nullary constant) is fine.
ruHypIsBareVar(h : RuExp) -> bool {
	length(h.nodes) == 1 && switch (h.nodes[0]) { RuVar(__, __): true; default: false; };
}

ruExpandForward(
	fwd     : RuProverForward,
	fact    : RuProverExp,
	fresher : (RuVar) -> RuVar,
	idxer   : () -> int,
	math    : RuMath,
	env     : RuEnv
) -> Pair<RuProverForward, [RuProverExp]> {
	fact_exp = ruExp(fact.stmt.exps[0]);
	// Head-symbol prefilter via the hyp index. The candidate subs use the
	// assertion's ORIGINAL var ids, which may COLLIDE with the fact's own vars
	// (assertions and a raw fact draw from the same id space). So we do NOT use
	// those subs directly: like ruIterAssertionsForFact, we freshen the
	// assertion's vars FIRST, then re-unify the fresh hyp against the fact. This
	// keeps the assertion var namespace disjoint from the fact's, avoiding the
	// variable capture that over-specialises the conclusion. (ruExpandHyp can
	// freshen AFTER only because the backward prover runs on const-form goals
	// whose vars never collide with assertion vars — a forward primitive must
	// not assume that.)
	candidates = ruUnifyIndex(fact_exp, fwd.hypIndex, ruEmptySubst, math, env);
	fold(candidates, Pair(fwd, []), \acc, cand -> {
		st        = acc.first;
		produced  = acc.second;
		assertion = cand.data;
		a_vars    = ruAssertion2Vars(assertion);
		fresh_sub = ruMakeFresherSubst(set2array(a_vars), fresher);
		fresh_hyp = ruApplySubst(ruExp(assertion.infer.hyps[0].stmt.exps[0]), fresh_sub);
		switch (ruUnifyExps([fresh_hyp, fact_exp], ruEmptySubst, math, env)) {
			None(): acc;
			Some(step_sub): {
				// conclusion under fresh_sub then step_sub (= closure's new_exp).
				conc_exp = ruApplySubst(ruApplySubst(ruExp(assertion.infer.prop.exps[0]), fresh_sub), step_sub);
				key = (conc_exp).nodes;
				if (containsSet(st.seen, key)) acc else {
					// Bindings stored for proof building (conclusion itself is
					// authoritative in the stmt; sub/outer get validated when the join builds the proof):
					// outer = original assertion var -> value (fresh_sub then step_sub),
					// sub   = the residual fresh/fact-var bindings.
					effective = ruUnsafeCompose(fresh_sub, step_sub);
					outer = ruFilterSub(effective, \v, __ ->  containsSet(a_vars, v));
					sub   = ruFilterSub(step_sub,  \v, __ -> !containsSet(a_vars, v));
					produced_fact = RuProverExp(
						0, makeVector(0),
						RuStmt(assertion.infer.prop with exps = [conc_exp]),
						makeVector(1), ruNoProverProp
					);
					propA = RuProverProp(
						idxer(), assertion, makeVector(0),
						sub, outer, makeVector(1),
						produced_fact, ref ""
					);
					pushVector(propA.children, fact);
					pushVector(produced_fact.children, propA);
					Pair(
						RuProverForward(
							ruSetIndex(conc_exp, produced_fact, st.index),
							arrayPush(st.front, produced_fact),
							st.hypIndex,
							st.multiHyp,
							insertSet(st.seen, key),
							st.pathIndex
						),
						arrayPush(produced, produced_fact)
					);
				}
			}
		}
	});
}

ruInitProverForwardProved(
	cpremises  : [RuPremise],
	assertions : RuIndex<RuAssertion>,
	math       : RuMath,
	env        : RuEnv
) -> RuProverForward {
	one_hyp_asses = filter(ruIndexValues(assertions), \ass -> length(ass.infer.hyps) == 1);
	hyp_index = fold(one_hyp_asses, ruMakeIndex(), \acc, ass -> {
		h = ass.infer.hyps[0];
		ruSetIndex(ruExp(h.stmt.exps[0]), ass, acc);
	});
	// Multi-hyp (>=2) assertions: index each rule-headed hyp by its expression,
	// paired with its position, as a forward trigger.
	multi_asses = filter(ruIndexValues(assertions), \ass -> length(ass.infer.hyps) >= 2);
	multi_index = fold(multi_asses, ruMakeIndex(), \acc, ass ->
		foldi(ass.infer.hyps, acc, \i, ac, h -> {
			he = ruExp(h.stmt.exps[0]);
			if (ruHypIsBareVar(he)) ac else ruSetIndex(he, RuFwdHyp(ass, i), ac);
		})
	);
	// Each premise seeds a forward "top" carrying a trivial proof variant: a
	// RuProverProofTop hypothesis reference (ruMakeProofTree -> RuProofHyp(ind)).
	// premise.ind is the theorem-hyp index the verifier expects.
	seed_facts = map(cpremises, \p -> {
		sf = RuProverExp(p.ind, makeVector(4), p.stmt, makeVector(0), ruNoProverProp);
		pushVector(sf.proofs, RuProverProofTop(sf, p.stmt, p, ruEmptySubst));
		sf;
	});
	seen0 = fold(seed_facts, makeSet(), \acc, f -> insertSet(acc, (ruExp(f.stmt.exps[0])).nodes));
	idx0  = fold(seed_facts, ruMakeIndex(), \acc, f -> ruSetIndex(ruExp(f.stmt.exps[0]), f, acc));
	RuProverForward(idx0, seed_facts, hyp_index, multi_index, seen0, makeTree());
}

// Add one produced fact to the front: index it, push to the frontier and the
// produced list, mark its key seen.
ruFwdRegister(
	st : RuProverForward, produced : [RuProverExp],
	pf : RuProverExp, conc_exp : RuExp, key : [RuExpNode]
) -> Pair<RuProverForward, [RuProverExp]> {
	Pair(
		RuProverForward(
			ruSetIndex(conc_exp, pf, st.index),
			arrayPush(st.front, pf),
			st.hypIndex, st.multiHyp,
			insertSet(st.seen, key),
			st.pathIndex
		),
		arrayPush(produced, pf)
	);
}

// Root (conclusion) expression of a proof tree.
ruProofTreeRoot(t : RuProofTree) -> RuExp {
	switch (t) {
		RuProofStep(__, __, st): ruExp(st.exps[0]);
		RuProofHyp(__, st):       ruExp(st.exps[0]);
	}
}

// Apply `assertion` to n GIVEN fact E-nodes (one per hypothesis, in order),
// producing the conclusion fact — the same complete application as ruApplyForward
// but with every hypothesis supplied directly (no front search). Used by the
// top-down oracle to replay a proof forward. ruAddProof builds the one consistent
// substitution across all n hypotheses; None if the facts don't fit / aren't
// consistent. (Builds the conclusion's expression + proof substitution.)
ruApplyForwardOn(
	assertion : RuAssertion,
	facts     : [RuProverExp],
	prover_env : RuProverEnv
) -> Maybe<RuProverExp> {
	math = prover_env.math;
	env  = prover_env.env;
	hyps = assertion.infer.hyps;
	n = length(hyps);
	if (length(facts) != n) None() else {
		a_vars = ruAssertion2Vars(assertion);
		fresh_sub = fold(set2array(a_vars), ruEmptySubst, \fs, v ->
			either(ruAdd2Subst(fs, v, RuExp([prover_env.fns.fresher(v)], -1)), fs)
		);
		fresh_hyps = map(hyps, \h -> ruApplySubst(ruExp(h.stmt.exps[0]), fresh_sub));
		conc_tmpl  = ruApplySubst(ruExp(assertion.infer.prop.exps[0]), fresh_sub);
		cnode = RuProverExp(0, makeVector(2), RuStmt(assertion.infer.prop with exps = [conc_tmpl]), makeVector(1), ruNoProverProp);
		prop  = RuProverProp(prover_env.fns.idxer(), assertion, makeVector(4), ruEmptySubst, fresh_sub, makeVector(n), cnode, ref "");
		pushVector(cnode.children, prop);
		hyp_nodes = mapi(hyps, \j, h -> {
			hn = RuProverExp(j, makeVector(4), RuStmt(h.stmt with exps = [fresh_hyps[j]]), makeVector(0), prop);
			pushVector(prop.children, hn);
			hn;
		});
		// Graft each given fact onto its hypothesis (match it to the hyp pattern).
		all_fit = foldi(facts, true, \j, ok, fct -> {
			if (!ok || sizeVector(fct.proofs) == 0) false else
			switch (ruUnifyExps([fresh_hyps[j], ruExp(fct.stmt.exps[0])], ruEmptySubst, math, env)) {
				None(): false;
				Some(sigma): {
					closing = RuStmt(hyp_nodes[j].stmt with exps = [ruApplySubst(fresh_hyps[j], sigma)]);
					gtree = ruApplySubst2ProofNode(sigma, ruMakeProofTree(vector2array(fct.proofs)[0]));
					pushVector(hyp_nodes[j].proofs, RuProverProofForward(hyp_nodes[j], closing, sigma, gtree));
					true;
				}
			}
		});
		if (!all_fit) None() else {
			if (n == 0) {
				// 0-hypothesis assertion (an axiom): trivially proved, as the
				// backward engine does for an arity-0 prop.
				pushVector(prop.proofs, RuProverProofProp(prop, prop.sub, []));
			} else {
				iterVector(hyp_nodes[0].proofs, \g -> ruAddProof(prop, g, prover_env));
			}
			if (sizeVector(prop.proofs) == 0) None() else {
				pp = vector2array(prop.proofs)[0];
				conc = ruProofTreeRoot(ruMakeProofTree(pp));
				conc_stmt = RuStmt(assertion.infer.prop with exps = [conc]);
				pf = RuProverExp(0, makeVector(4), conc_stmt, makeVector(1), ruNoProverProp);
				pushVector(pf.children, prop);
				pushVector(pf.proofs, RuProverProofStmt(pf, conc_stmt, pp.sub, pp));
				Some(pf);
			}
		}
	}
}

// One assertion application, the SAME complete unit for every arity: apply
// `assertion` to its n hypotheses and produce one P-node + one conclusion fact
// E-node holding the obtained expression and the proof (substitution). The
// trigger `fact` discharges hypothesis `trig`; the other hypotheses are
// discharged from the existing fact front. ruAddProof builds the single
// substitution that consistently instantiates the assertion across all n
// hypotheses (its substitution-unification IS the consistency check) — no
// per-arity code, no soundness gate, no caps. Conclusions whose hypotheses are
// not all present as facts simply do not assemble (ruAddProof yields nothing).
ruApplyForward(
	st : RuProverForward, produced : [RuProverExp],
	fact : RuProverExp, fact_exp : RuExp,
	assertion : RuAssertion, trig : int,
	prover_env : RuProverEnv
) -> Pair<RuProverForward, [RuProverExp]> {
	math = prover_env.math;
	env  = prover_env.env;
	hyps = assertion.infer.hyps;
	n = length(hyps);
	a_vars = ruAssertion2Vars(assertion);
	// Freshen the assertion vars to placeholders (disjoint from any fact's vars).
	// Built via ruAdd2Subst (NOT ruMakeFresherSubst): the latter stores each
	// entry's var-set as the ORIGINAL var id, so ruApplySubstVars — used by
	// ruUnsafeCompose inside ruMakeProofTree — won't chase the fresh placeholder
	// into its binding, leaving unresolved placeholders in the conclusion.
	fresh_sub = fold(set2array(a_vars), ruEmptySubst, \fs, v ->
		either(ruAdd2Subst(fs, v, RuExp([prover_env.fns.fresher(v)], -1)), fs)
	);
	fresh_hyps = map(hyps, \h -> ruApplySubst(ruExp(h.stmt.exps[0]), fresh_sub));
	conc_tmpl  = ruApplySubst(ruExp(assertion.infer.prop.exps[0]), fresh_sub);
	// The P-node, anchored at its conclusion E-node. outer = the placeholders,
	// resolved by the children's substitutions inside ruAddProof / ruMakeProofTree;
	// sub = empty.
	cnode = RuProverExp(0, makeVector(2), RuStmt(assertion.infer.prop with exps = [conc_tmpl]), makeVector(1), ruNoProverProp);
	prop  = RuProverProp(prover_env.fns.idxer(), assertion, makeVector(4), ruEmptySubst, fresh_sub, makeVector(n), cnode, ref "");
	pushVector(cnode.children, prop);
	// The n hypothesis E-nodes.
	hyp_nodes = mapi(hyps, \j, h -> {
		hn = RuProverExp(j, makeVector(4), RuStmt(h.stmt with exps = [fresh_hyps[j]]), makeVector(0), prop);
		pushVector(prop.children, hn);
		hn;
	});
	// Discharge each hypothesis from the fact front. Match the trigger first to
	// get sigma, then CONSTRAIN the other hypotheses' searches by sigma (the
	// trigger fixes part of the substitution — exactly as the backward engine
	// creates its hyps with the goal-match binding already applied). This loses
	// no valid application (every one consistent with `fact` at trig agrees with
	// sigma) and keeps the front search tractable. Each discharge grafts the
	// fact's proof onto the hypothesis E-node carrying its full match sub; the
	// grafts all share sigma, so ruAddProof's substitution-unification combines
	// them into the one consistent binding.
	maybeApply(ruUnifyExps([fresh_hyps[trig], fact_exp], ruEmptySubst, math, env), \sigma -> {
		iteri(hyp_nodes, \j, hn -> {
			matches = if (j == trig) {
				[RuUnified(sigma, fact, ruApplySubst(fresh_hyps[trig], sigma))];
			} else {
				map(ruUnifyIndex(ruApplySubst(fresh_hyps[j], sigma), st.index, ruEmptySubst, math, env),
					\u -> RuUnified(ruUnsafeCompose(sigma, u.sub), u.data, u.expr));
			};
			iter(matches, \u -> {
				gfact = u.data; gsub = u.sub;
				if (sizeVector(gfact.proofs) > 0) {
					// One proof per matched fact suffices: downstream only needs the
					// fact derived, and distinct proofs of the SAME fact would only
					// multiply ruAddProof's cartesian without adding reachable
					// conclusions.
					closing = RuStmt(hn.stmt with exps = [ruApplySubst(fresh_hyps[j], gsub)]);
					gtree = ruApplySubst2ProofNode(gsub, ruMakeProofTree(vector2array(gfact.proofs)[0]));
					pushVector(hn.proofs, RuProverProofForward(hn, closing, gsub, gtree));
				}
			});
		});
		// Assemble: ruAddProof builds prop's proof variants (the consistent
		// combinations). Call it per proof of the trigger hypothesis — it reads
		// the other hypotheses' stored proofs and unifies their substitutions.
		iterVector(hyp_nodes[trig].proofs, \g -> ruAddProof(prop, g, prover_env));
	});
	// Each assembled variant is one conclusion fact.
	fold(vector2array(prop.proofs), Pair(st, produced), \acc, pp -> {
		st2 = acc.first; prod2 = acc.second;
		conc = ruProofTreeRoot(ruMakeProofTree(pp));
		key  = (conc).nodes;
		if (containsSet(st2.seen, key)) acc else {
			conc_stmt = RuStmt(assertion.infer.prop with exps = [conc]);
			pf = RuProverExp(0, makeVector(4), conc_stmt, makeVector(1), ruNoProverProp);
			pushVector(pf.children, prop);
			pushVector(pf.proofs, RuProverProofStmt(pf, conc_stmt, pp.sub, pp));
			// Universal join, forward side: this new fact checks the backward front
			// and discharges any matching open backward subgoal.
			ruReverseJoin(pf, prover_env);
			ruFwdRegister(st2, prod2, pf, conc, key);
		}
	});
}

// The POSITIONAL path of a backward node in the proof DAG: the sequence of
// hypothesis indices from the root. Because the oracle expands hyp i of a prop to
// realise proof-DAG child i, this path is exactly the node's proof-DAG position,
// derivable from the PVT structure alone. The completeness-test join (in
// expand.flow) uses it to close a subgoal with the forward fact at the same node.
ruNodePath(h : RuProverHyp) -> [int] {
	switch (h) {
		RuProverRoot(__, __, __):             [];
		RuProverExp(ind, __, __, __, prop):   arrayPush(ruNodePath(prop.parent), ind);
	}
}

// Universal join, forward->backward (symmetric counterpart of the backward splice
// in expand.flow). A newly created forward fact `pf` is matched against the ROOT
// (completing the whole proof through ruBuildRootProofs when it matches the theorem
// statement verbatim) and against the backward front; every open backward subgoal it
// covers is discharged by grafting pf's proof (specialised to the subgoal), feeding
// ruAddProof, and propagating up. Guarded by ruJoinAcyclic. Used by the forward-search
// feature; the completeness-test combined oracle joins positionally at subgoal creation.
ruReverseJoin(pf : RuProverExp, prover_env : RuProverEnv) -> void {
	pf_exp = ruExp(pf.stmt.exps[0]);
	// ROOT JOIN: a forward fact that MATCHES the root statement completes the whole
	// proof. Without this, a pure-forward tactic (e.g. assume-neg(loop(forward, N)))
	// can derive the goal yet never conclude — backwardFront holds only the subgoal
	// E-nodes created by backward Prop expansion (expand.flow:124), so the root itself
	// is never joinable there. MATCH, not unify: σ binds only the fact's vars, so
	// σ·fact = root VERBATIM — the completed proof is of the exact theorem statement
	// (soundness invariant I2), never of a mere common specialization.
	root = prover_env.tree.root;
	if (length(root.stmt.exps) > 0) {
		root_exp = ruExp(root.stmt.exps[0]);
		switch (ruMatchExp(root_exp, pf_exp, prover_env.math, prover_env.env)) {
			None(): {}
			Some(rsigma): {
				if (prover_env.env.conf.verbose >= 4) {
					prover_env.env.out.println("  root-join: fact matches root, acyclic=" + b2s(ruJoinAcyclic(pf, root_exp.nodes)) + " proofs=" + i2s(sizeVector(pf.proofs)));
				} else {};
				if (ruJoinAcyclic(pf, root_exp.nodes)) {
					iterVector(pf.proofs, \pv -> {
						spliced = ruApplySubst2ProofNode(rsigma, ruMakeProofTree(pv));
						fwdProof = RuProverProofForward(root, RuStmt(root.stmt with exps = [root_exp]), rsigma, spliced);
						// Same variant admission as the interior join below (inert by default).
						if (prover_env.fns.keepVariant(fwdProof)) {
							pushVector(root.proofs, fwdProof);
							completed : Vector<RuProverProofHyp> = makeVector(1);
							pushVector(completed, fwdProof);
							ruBuildRootProofs(root, completed, prover_env);
						} else {};
					});
				} else {};
			}
		}
	} else {};
	matches = ruUnifyIndex(pf_exp, ^(prover_env.backwardFront), ruEmptySubst, prover_env.math, prover_env.env);
	iter(matches, \u -> {
		subgoal : RuProverExp = u.data;
		sigma = u.sub;
		// Consult the L2-provided join-admission policy (prover_env.admitJoin,
		// default admit-all): L1 stays calculus-agnostic — WHICH joins are worth
		// grafting (e.g. declining structureless cut-slots) is an L2 selection
		// concern, set by tactics like `ordered`.
		if ((^(prover_env.admitJoin))(pf, subgoal) && ruJoinAcyclic(pf, (ruExp(subgoal.stmt.exps[0])).nodes)) {
			parent = subgoal.parent;
			if (prover_env.env.conf.verbose >= 4) {
				prover_env.env.out.println("  reverse-join: fact " + ruSafeExp2s(pf_exp, prover_env.math.decls.lang)
					+ " -> subgoal " + ruSafeExp2s(ruExp(subgoal.stmt.exps[0]), prover_env.math.decls.lang));
			} else {};
			iterVector(pf.proofs, \pv -> {
				closing = RuStmt(subgoal.stmt with exps = map(subgoal.stmt.exps, \ex -> ruApplySubst(ruExp(ex), sigma)));
				spliced = ruApplySubst2ProofNode(sigma, ruMakeProofTree(pv));
				fwdProof = RuProverProofForward(subgoal, closing, sigma, spliced);
				// Variant admission (inert by default): the completeness-test oracle
				// dedups (a forward graft equal to backward's proof is NOT emitted twice
				// — the ADDITIVE invariant) and bounds the node to `limit`.
				if (prover_env.fns.keepVariant(fwdProof)) {
					pushVector(subgoal.proofs, fwdProof);
					n0 = sizeVector(parent.proofs);
					ruAddProof(parent, fwdProof, prover_env);
					if (prover_env.env.conf.verbose >= 4) {
						prover_env.env.out.println("    graft: parent " + id2s(parent.assertion.info.id)
							+ " proofs " + i2s(n0) + " -> " + i2s(sizeVector(parent.proofs)));
					} else {};
					ruBuildPropProofs(parent, vectorTailFrom(parent.proofs, n0), prover_env);
				} else {};
			});
		}
	});
}

ruExpandForwardProved(
	fwd        : RuProverForward,
	fact       : RuProverExp,
	prover_env : RuProverEnv
) -> Pair<RuProverForward, [RuProverExp]> {
	math = prover_env.math;
	env  = prover_env.env;
	fact_exp = ruExp(fact.stmt.exps[0]);
	// Trigger set: every (assertion, rule-headed-hypothesis-position) the fact can
	// fill. hypIndex covers single-hyp assertions (position 0); multiHyp covers the
	// rule-headed hypotheses of >=2-hyp assertions. Both feed the SAME application.
	single = map(ruUnifyIndex(fact_exp, fwd.hypIndex, ruEmptySubst, math, env), \u -> RuFwdHyp(u.data, 0));
	multi  = map(ruUnifyIndex(fact_exp, fwd.multiHyp, ruEmptySubst, math, env), \u -> u.data);
	// Bound a SINGLE fact's expansion: without this, one fact under a wide scope can
	// trigger dozens of assertions and produce thousands of facts (each an ruAddProof
	// cartesian) in one call — seconds of work that ignores the per-goal budget and
	// starves sibling theorems. Stop applying further triggers once the front index has
	// reached the cap or the timer is over. A LIMIT, completeness-preserving (see
	// ruRunForwardWave): reachable facts within the bound are still all produced.
	size = ruForwardWaveSizeCap(prover_env);
	res = fold(concat(single, multi), Pair(fwd, []), \acc, fh ->
		if (ruIndexDataCount(acc.first.index) >= size || ruTimeIsOver(prover_env.conf.timer)) acc
		else ruApplyForward(acc.first, acc.second, fact, fact_exp, fh.assertion, fh.pos, prover_env)
	);
	if (env.conf.verbose >= 4) {
		env.out.println("  expand: " + ruSafeExp2s(fact_exp, math.decls.lang)
			+ "  => " + strGlue(map(res.second, \pf -> ruSafeExp2s(ruExp(pf.stmt.exps[0]), math.decls.lang)), " | "));
	} else {};
	res;
}

// Walk the derivation: a produced fact's children are its producing props; a
// prop's children are its input facts; recurse into those. Collect the input
// facts' keys (NOT the fact's own — that is the thing being derived).
ruForwardDepKeys(fact : RuProverExp) -> Set<[RuExpNode]> {
	foldVector(fact.children, makeSet(), \acc, prop ->
		foldVector(prop.children, acc, \acc2, input ->
			mergeSets(
				insertSet(acc2, (ruExp(input.stmt.exps[0])).nodes),
				ruForwardDepKeys(input)
			)
		)
	);
}

ruJoinAcyclic(fact : RuProverExp, target_key : [RuExpNode]) -> bool {
	!containsSet(ruForwardDepKeys(fact), target_key);
}

ruForwardFactSound(fact : RuProverExp) -> bool {
	dag = ruJoinAcyclic(fact, (ruExp(fact.stmt.exps[0])).nodes);
	// Premise-grounded: every proof variant's tree bottoms out in RuProofHyp
	// leaves only (premise references) — no dangling / non-premise leaf.
	grounded = foldVector(fact.proofs, true, \acc, pv ->
		acc && ruProofTreeGrounded(ruMakeProofTree(pv))
	);
	dag && grounded;
}

ruProofTreeGrounded(t : RuProofTree) -> bool {
	switch (t) {
		RuProofHyp(ind, __):       ind >= 0;
		RuProofStep(__, kids, __): forall(kids, ruProofTreeGrounded);
	}
}

ruForwardProofSize(fact : RuProverExp) -> int {
	if (sizeVector(fact.proofs) == 0) 0
	else length(ruProofTreeSteps(ruMakeProofTree(vector2array(fact.proofs)[0])));
}

ruMaybeBuildForwardFront(
	prover_env : RuProverEnv,
	task       : RuProverTask,
	assertions : RuIndex<RuAssertion>
) -> void {
	depth = {
		v = lookupTreeDef(task.args, "forward-search-depth", "0");
		if (runtimeValueType(v) == "int") cast(v : flow -> int) else s2i(cast(v : flow -> string));
	};
	if (depth > 0) {
		size = {
			v = lookupTreeDef(task.args, "forward-search-size", "2048");
			if (runtimeValueType(v) == "int") cast(v : flow -> int) else s2i(cast(v : flow -> string));
		};
		// Same const form prover_env.math uses (ruConstProverTask is deterministic),
		// so seeds / proofs live in the prover's variable space.
		c_task = ruConstProverTask(task, prover_env.math);
		fwd0 = ruInitProverForwardProved(c_task.const.premises, assertions, prover_env.math, prover_env.env);
		// Also bounded by the prover's timer (a LIMIT, completeness-preserving): without it
		// this pre-build is UNBUDGETED — per-theorem it can grow `size` facts over the full
		// assertion index and dwarf the prove loop's own time-limit (the forward-search test
		// leg ran minutes per theorem against a 5s budget).
		final_fwd = foldRange(1, depth, fwd0, \fwd, __ ->
			fold(fwd.front, RuProverForward(fwd with front = []), \st, fact ->
				if (ruIndexDataCount(st.index) >= size || ruTimeIsOver(prover_env.conf.timer)) st
				else ruExpandForwardProved(st, fact, prover_env).first
			)
		);
		prover_env.forwardFront := Some(final_fwd);
	}
}

// Build an RuExp for `rule` applied to `args` (prefix form) — mirrors ruEqMkRule but stays in core
// (forward.flow must not import the tactics layer). Used to construct the ¬G / ¬G→X refutation facts.
ruFwdMkRule(rule : int, type : int, args : [RuExp]) -> RuExp {
	argNodes = fold(args, [], \acc, a -> concat(acc, a.nodes));
	RuExp(concat([ruMakeRuleNode(rule, type, length(args), length(argNodes))], argNodes), -1);
}

// Refutation seeding (the `assume-neg` atom, checker-decomposition candidate A): seed the negated-goal
// DEDUCTION facts the install `ruHRefute` uses — `¬G→¬G` (id) and each premise lifted to `¬G→hyp_i` (a1i)
// — so the forward wave can saturate under the assumption ¬G. Once it derives a clash (¬G→φ, ¬G→¬φ) a
// scope `pm2.65i` application yields `¬¬G`, then `ax-mp` with `notnotr` yields `G`, which joins the root.
// All engine-built (the seed proofs are ordinary id/a1i steps; the rest is the ordinary forward wave).
// Const-form (c_task.const), matching the front the wave saturates over. Gated by prover_env.refute.
ruSeedRefuteFront(prover_env : RuProverEnv, c_task : RuConstAny<RuProverTask>, fwd : RuProverForward) -> RuProverForward {
	wff = tp2id_("wff");
	goalExp = ruExp(c_task.const.goal.stmt.exps[0]);
	cls     = c_task.const.goal.stmt.class;
	ng      = ruFwdMkRule(s2id("wn"), wff, [goalExp]);        // ¬G
	mkImp   = \a, b -> ruFwdMkRule(s2id("wi"), wff, [a, b]);
	ngng    = mkImp(ng, ng);
	// (statement exp, engine proof tree) for each seed fact.
	seeds = concat(
		[Pair(ngng, RuProofStep(s2id_("id"), [], RuStmt(cls, [ngng], -1)))],   // ⊢ ¬G→¬G  (id)
		map(c_task.const.premises, \p -> {
			hyp = ruExp(p.stmt.exps[0]);
			imp = mkImp(ng, hyp);
			Pair(imp, RuProofStep(s2id_("a1i"), [RuProofHyp(p.ind, p.stmt)], RuStmt(cls, [imp], -1)));  // hyp_i ⊢ ¬G→hyp_i (a1i)
		})
	);
	fold(seeds, fwd, \st, pr -> {
		impExp = pr.first; key = impExp.nodes;
		if (containsSet(st.seen, key)) st
		else {
			stmt = RuStmt(cls, [impExp], -1);
			sf   = RuProverExp(-1, makeVector(4), stmt, makeVector(0), ruNoProverProp);
			pushVector(sf.proofs, RuProverProofForward(sf, stmt, ruEmptySubst, pr.second));
			(ruFwdRegister(st, [], sf, impExp, key)).first;
		}
	});
}

ruSeedForwardFront(prover_env : RuProverEnv) -> void {
	if (^(prover_env.forwardFront) == None()) {
		// a fresh front has run no wave yet — clear any stale gain from a
		// previous stage's front, or the forward tactic would conclude at once
		prover_env.waveGain := -1;
		task   = prover_env.conf.task;
		c_task = ruConstProverTask(task, prover_env.math);
		// Respect the active SCOPE. When a whitelist is set (e.g. by `scoped(...)`), the
		// forward front derives ONLY from the scoped assertions — the same restriction the
		// backward engine applies via fns.unifyAssertion, so forward and backward search
		// the same rule set. Without it a scoped forward wave would fan out over the whole
		// foundation and explode. Empty whitelist = no restriction (full index, as before).
		wl = ^(prover_env.whitelist);
		asses = if (wl == []) prover_env.assertions else {
			wlset = buildSet(wl);
			fold(filter(ruIndexValues(prover_env.assertions), \a -> containsSet(wlset, a.info.id)),
				ruMakeIndex(), \acc, a -> ruSetIndex(ruExp(a.infer.prop.exps[0]), a, acc));
		};
		fwd0 = ruInitProverForwardProved(c_task.const.premises, asses, prover_env.math, prover_env.env);
		// Seed 0-HYPOTHESIS assertions (axioms: ax-1, exmid, pm3.24, noel, id, …) as
		// always-available forward facts. An exhaustive forward wave never APPLIES a 0-hyp
		// assertion — it has no hypothesis to trigger on — so without this seeding they are
		// unreachable forward; seeding them (each applied to zero facts via ruApplyForwardOn,
		// an engine-built proof) lets forward use e.g. excluded middle. Scoped, so bounded.
		fwd1 = fold(ruIndexValues(asses), fwd0, \st, a ->
			if (length(a.infer.hyps) != 0) st
			else switch (ruApplyForwardOn(a, [], prover_env)) {
				None(): st;
				Some(sf): {
					key = (ruExp(sf.stmt.exps[0])).nodes;
					if (containsSet(st.seen, key)) st
					else (ruFwdRegister(st, [], sf, ruExp(sf.stmt.exps[0]), key)).first;
				}
			}
		);
		// Refutation mode (assume-neg): also seed the ¬G deduction facts, so the wave can
		// saturate under ¬G and derive G via pm2.65i + notnotr. Inert unless prover_env.refute.
		fwd2 = if (^(prover_env.refute)) ruSeedRefuteFront(prover_env, c_task, fwd1) else fwd1;
		// Instantiation mode (the `instantiate` atom): seed each ∀-premise INSTANTIATED at
		// candidate terms (subterms of the goal/premises) — the Mizar Unifier as guided seeding.
		// Also seed 0-hyp IDENTITY schemata (wceq-headed conclusions, e.g. disjdif) instantiated
		// at the same subterms — Mizar's Equate applying its identity base (the Equalizer).
		// Inert unless prover_env.instantiate.
		fwd3 = if (^(prover_env.instantiate)) {
			ruSeedEqNormalize(prover_env, c_task,
				ruSeedIdentityFront(prover_env, c_task, ruSeedInstantiateFront(prover_env, c_task, fwd2), asses), asses);
		} else fwd2;
		prover_env.forwardFront := Some(fwd3);
		// Join-check the SEEDS: only derived facts pass through ruReverseJoin (at
		// creation in ruApplyForward), and the dedup (`seen`) blocks re-derivation —
		// so a seed that IS the goal (e.g. an identity instance matching the root
		// verbatim) would never join. One pass over the initial front covers it.
		iter(fwd3.front, \sf -> ruReverseJoin(sf, prover_env));
	}
}

// ---------------------------------------------------------------------------
// forall-instantiate seeding (the Mizar UNIFIER increment, mizar-tactic-plan):
// for each ∀-premise `∀x φ` and each candidate term t (class-typed subterms of
// the goal and premises — the same candidate source Mizar's Unifier draws on),
// seed the INSTANCE fact φ[t/x] with a hand-constructed spcv proof:
//
//   bi     = the congruence chain  ⊢ (x = t) → (φ ↔ φ[t/x])
//            (structural recursion: sseq1/2, eqeq1/2, eleq1/2 at the atoms;
//             notbid/anbi12d/orbi12d/imbi12d/bibi12d at connectives; biidd
//             for x-free subformulas)
//   setn   = ⊢ t ∈ _V              (vex for setvars, unex for unions)
//   spcv(setn, bi)                  ⊢ (∀x φ → φ[t/x])
//   ax-mp(premise, spcv)            ⊢ φ[t/x]
//
// The same seeding pattern as ruSeedRefuteFront (assume-neg): the combinator
// constructs ordinary proof TREES from foundation lemmas; the kernel verifies
// them in the final proof. The blind wave cannot assemble these chains (the
// schematic congruence facts starve under ground-first ordering and explode
// unguided) — the guided TERM CHOICE here is the L2 selection that Mizar's
// Unifier performs against its eq-classes. Bounded: at most
// ruFwdInstCap candidates per ∀-premise (a LIMIT, completeness-preserving).
// v1 scope: atoms with x in exactly one argument slot; no nested binders over
// x; setness for setvars and ∪-terms — everything else is declined, never
// mis-built.
// ---------------------------------------------------------------------------

RuFwdInstIds(
	wff : int, cls : int, setvar : int,
	wn : int, wi : int, wb : int, wa : int, wo : int, wal : int, wex : int,
	wss : int, wceq : int, wcel : int, cvv : int, cun : int, cin : int, cdif : int,
	sseq1 : int, sseq2 : int, eqeq1 : int, eqeq2 : int, eleq1 : int, eleq2 : int,
	notbid : int, anbi12d : int, orbi12d : int, imbi12d : int, bibi12d : int, biidd : int,
	spcv : int, vex : int, unex : int, inex1 : int, difexi : int, axmp : int
);

ruFwdInstIds() -> RuFwdInstIds {
	RuFwdInstIds(
		tp2id_("wff"), tp2id_("class"), tp2id_("setvar"),
		s2id("wn"), s2id("wi"), s2id("wb"), s2id("wa"), s2id("wo"), s2id("wal"), s2id("wex"),
		s2id("wss"), s2id("wceq"), s2id("wcel"), s2id("cvv"), s2id("cun"), s2id("cin"), s2id("cdif"),
		s2id_("sseq1"), s2id_("sseq2"), s2id_("eqeq1"), s2id_("eqeq2"), s2id_("eleq1"), s2id_("eleq2"),
		s2id_("notbid"), s2id_("anbi12d"), s2id_("orbi12d"), s2id_("imbi12d"), s2id_("bibi12d"), s2id_("biidd"),
		s2id_("spcv"), s2id_("vex"), s2id_("unex"), s2id_("inex1"), s2id_("difexi"), s2id_("ax-mp")
	);
}

// End index (exclusive) of the subexpression starting at i (prefix form).
ruFwdSpan(nodes : [RuExpNode], i : int) -> int {
	switch (nodes[i]) {
		RuVar(__,__): i + 1;
		RuRuleNode(__, al): fold(enumFromTo(1, ruArityLen2Arity(al)), i + 1, \p, __ -> ruFwdSpan(nodes, p));
	}
}

// The bound variable in the CONST task form is a zero-arity RULE node (a frozen
// task var, printed `_x901`), not an RuVar — so occurrence tests and substitution
// work on NODE EQUALITY, representation-agnostically.
ruFwdContainsNode(nodes : [RuExpNode], x : RuExpNode) -> bool {
	exists(nodes, \n -> n == x);
}

// Is this node a setvar-typed atom (an RuVar or a frozen zero-arity const)?
ruFwdIsSetvarNode(n : RuExpNode, setvar : int) -> bool {
	switch (n) {
		RuVar(__, tp): tp == setvar;
		RuRuleNode(idType, al): ruArityLen2Arity(al) == 0 && ruIdType2Type(idType) == setvar;
	}
}

// The congruence chain: Some((φ[t/x], proof of ⊢ ante → (φ ↔ φ[t/x]))), or None
// when the v1 fragment cannot build it (x nested inside an atom argument, under
// a binder, or an unsupported head).
// x = the bare bound-var node (for containment tests); xocc = its CLASS-form
// occurrence slice (the setvar wrapped in the implicit coercion node — `setvar :
// class` materializes as a 1-arity class rule, so x occupies 2 nodes in class slots).
ruFwdBiChain(ids : RuFwdInstIds, ante : RuExp, x : RuExpNode, xocc : [RuExpNode], t : RuExp, body : [RuExpNode], stcl : int) -> Maybe<Pair<RuExp, RuProofTree>> {
	ruFwdChainDbg(ids, body);
	bodyExp = RuExp(body, -1);
	mkStmt = \e : RuExp -> RuStmt(stcl, [e], -1);
	biStmt = \inst : RuExp -> mkStmt(ruFwdMkRule(ids.wi, ids.wff, [ante, ruFwdMkRule(ids.wb, ids.wff, [bodyExp, inst])]));
	if (!ruFwdContainsNode(body, x)) {
		// x-free subformula: ⊢ ante → (φ ↔ φ) by biidd.
		Some(Pair(bodyExp, RuProofStep(ids.biidd, [], biStmt(bodyExp))));
	} else {
		switch (body[0]) {
			RuVar(__,__): None(); // a bare wff atom equal to x is not a wff — unreachable
			RuRuleNode(idType, __): {
				rid = ruIdType2Id(idType);
				if (rid == ids.wn) {
					maybeMap(ruFwdBiChain(ids, ante, x, xocc, t, tail(body), stcl), \c -> {
						inst = ruFwdMkRule(ids.wn, ids.wff, [c.first]);
						Pair(inst, RuProofStep(ids.notbid, [c.second], biStmt(inst)));
					});
				} else if (rid == ids.wi || rid == ids.wa || rid == ids.wo || rid == ids.wb) {
					lend = ruFwdSpan(body, 1);
					l = subrange(body, 1, lend - 1);
					r = subrange(body, lend, length(body) - lend);
					maybeBind(ruFwdBiChain(ids, ante, x, xocc, t, l, stcl), \cl ->
						maybeMap(ruFwdBiChain(ids, ante, x, xocc, t, r, stcl), \cr -> {
							inst = ruFwdMkRule(rid, ids.wff, [cl.first, cr.first]);
							lemma = if (rid == ids.wi) ids.imbi12d else if (rid == ids.wa) ids.anbi12d
								else if (rid == ids.wo) ids.orbi12d else ids.bibi12d;
							Pair(inst, RuProofStep(lemma, [cl.second, cr.second], biStmt(inst)));
						}));
				} else if (rid == ids.wss || rid == ids.wceq || rid == ids.wcel) {
					lend = ruFwdSpan(body, 1);
					a = subrange(body, 1, lend - 1);
					b = subrange(body, lend, length(body) - lend);
					aIsX = a == xocc;
					bIsX = b == xocc;
					if (aIsX && !ruFwdContainsNode(b, x)) {
						inst = ruFwdMkRule(rid, ids.wff, [t, RuExp(b, -1)]);
						lemma = if (rid == ids.wss) ids.sseq1 else if (rid == ids.wceq) ids.eqeq1 else ids.eleq1;
						Some(Pair(inst, RuProofStep(lemma, [], biStmt(inst))));
					} else if (bIsX && !ruFwdContainsNode(a, x)) {
						inst = ruFwdMkRule(rid, ids.wff, [RuExp(a, -1), t]);
						lemma = if (rid == ids.wss) ids.sseq2 else if (rid == ids.wceq) ids.eqeq2 else ids.eleq2;
						Some(Pair(inst, RuProofStep(lemma, [], biStmt(inst))));
					} else None(); // x nested inside a compound argument — v1 declines
				} else None(); // binder over x / unsupported head — v1 declines
			}
		}
	}
}

ruFwdChainDbgOn : ref bool = ref false;
ruFwdChainDbg(ids : RuFwdInstIds, body : [RuExpNode]) -> void {
	if (^ruFwdChainDbgOn) {
		head = switch (body[0]) {
			RuVar(id,__): "var:" + id2s(id);
			RuRuleNode(idType,__): "rule:" + id2s(ruIdType2Id(idType)) + " raw=" + i2s(ruIdType2Id(idType)) + " wi-id=" + i2s(ids.wi);
		}
		println("  biChain: head=" + head + " len=" + i2s(length(body)));
	}
}

// ⊢ t ∈ _V : vex for a setvar; unex for a ∪-term (both args); inex1 for an
// ∩-term and difexi for a ∖-term (first arg only); anything else declined.
ruFwdSetness(ids : RuFwdInstIds, t : [RuExpNode], stcl : int) -> Maybe<RuProofTree> {
	mkCel = \e : [RuExpNode] -> RuStmt(stcl, [ruFwdMkRule(ids.wcel, ids.wff, [RuExp(e, -1), ruFwdMkRule(ids.cvv, ids.cls, [])])], -1);
	if (length(t) == 2 && ruFwdIsSetvarNode(t[1], ids.setvar)) Some(RuProofStep(ids.vex, [], mkCel(t)))
	else switch (t[0]) {
		RuVar(__,__): None();
		RuRuleNode(idType, __): {
			rid = ruIdType2Id(idType);
			if (rid == ids.cun) {
				lend = ruFwdSpan(t, 1);
				a = subrange(t, 1, lend - 1);
				b = subrange(t, lend, length(t) - lend);
				maybeBind(ruFwdSetness(ids, a, stcl), \pa ->
					maybeMap(ruFwdSetness(ids, b, stcl), \pb ->
						RuProofStep(ids.unex, [pa, pb], mkCel(t))));
			} else if (rid == ids.cin || rid == ids.cdif) {
				lend = ruFwdSpan(t, 1);
				a = subrange(t, 1, lend - 1);
				lemma = if (rid == ids.cin) ids.inex1 else ids.difexi;
				maybeMap(ruFwdSetness(ids, a, stcl), \pa ->
					RuProofStep(lemma, [pa], mkCel(t)));
			} else None();
		}
	}
}

// Class-typed candidate terms: all subexpressions of the given expressions whose
// head is class-typed (or a bare setvar), deduped, capped.
ruFwdInstCandidates(ids : RuFwdInstIds, exps : [RuExp], cap : int) -> [[RuExpNode]] {
	collect = \nodes : [RuExpNode] -> {
		doCollect = \i : int -> {
			isCls = switch (nodes[i]) {
				RuVar(__,__): false;
				RuRuleNode(idType, __): ruIdType2Type(idType) == ids.cls;
			};
			if (isCls) [subrange(nodes, i, ruFwdSpan(nodes, i) - i)] else [];
		}
		concatA(mapi(nodes, \i, __ -> doCollect(i)));
	}
	all = concatA(map(exps, \e -> collect(e.nodes)));
	deduped = fold(all, Pair(makeSet(), []), \acc, c ->
		if (containsSet(acc.first, c)) acc
		else Pair(insertSet(acc.first, c), arrayPush(acc.second, c))
	).second;
	take(deduped, cap);
}

ruFwdInstCap(prover_env : RuProverEnv) -> int {
	v = lookupTreeDef(prover_env.conf.task.args, "instantiate-cap", "16");
	if (runtimeValueType(v) == "int") cast(v : flow -> int) else s2i(cast(v : flow -> string));
}

ruSeedInstantiateFront(prover_env : RuProverEnv, c_task : RuConstAny<RuProverTask>, fwd : RuProverForward) -> RuProverForward {
	ids  = ruFwdInstIds();
	stcl = c_task.const.goal.stmt.class;
	cands = ruFwdInstCandidates(ids,
		concat([ruExp(c_task.const.goal.stmt.exps[0])], map(c_task.const.premises, \p -> ruExp(p.stmt.exps[0]))),
		ruFwdInstCap(prover_env));
	ruFwdChainDbgOn := prover_env.env.conf.verbose >= 5;
	if (prover_env.env.conf.verbose >= 4) {
		prover_env.env.out.println("instantiate: candidates=" + i2s(length(cands))
			+ " premises=" + i2s(length(c_task.const.premises))
			+ " wal-premises=" + i2s(length(filter(c_task.const.premises, \p -> {
				e = ruExp(p.stmt.exps[0]);
				switch (e.nodes[0]) {
					RuVar(__,__): false;
					RuRuleNode(idType, __): ruIdType2Id(idType) == ids.wal
						&& ruFwdIsSetvarNode(e.nodes[1], ids.setvar);
				}
			}))));
	} else {};
	fold(c_task.const.premises, fwd, \st, p -> {
		pexp = ruExp(p.stmt.exps[0]);
		switch (pexp.nodes[0]) {
			RuVar(__,__): st;
			RuRuleNode(idType, __): {
				if (ruIdType2Id(idType) != ids.wal) st else {
					xnode = pexp.nodes[1];
					if (!ruFwdIsSetvarNode(xnode, ids.setvar)) st else {
						{
							body = subrange(pexp.nodes, 2, length(pexp.nodes) - 2);
							// The class-form occurrence of x: the implicit setvar->class
							// coercion node followed by x. Find it in the body; a body
							// where x never occurs in class position has nothing to
							// instantiate structurally (v1 declines it wholesale).
							xocc = fold(enumFromTo(0, length(body) - 2), [], \acc, i ->
								if (acc != []) acc
								else switch (body[i]) {
									RuVar(__,__): acc;
									RuRuleNode(idT, al): {
										if (ruArityLen2Arity(al) == 1 && ruIdType2Type(idT) == ids.cls && body[i + 1] == xnode)
											[body[i], body[i + 1]]
										else acc;
									}
								});
							fold(cands, st, \st2, t -> {
								if (xocc == [] || ruFwdContainsNode(t, xnode)) st2 else {
									tExp = RuExp(t, -1);
									ante = ruFwdMkRule(ids.wceq, ids.wff, [RuExp(xocc, -1), tExp]);
									dbg = \msg : string -> if (prover_env.env.conf.verbose >= 4) {
										prover_env.env.out.println("instantiate: t=" + ruSafeExp2s(tExp, prover_env.math.decls.lang) + " " + msg);
									} else {};
									switch (ruFwdBiChain(ids, ante, xnode, xocc, tExp, body, stcl)) {
										None(): { dbg("chain DECLINED"); st2 };
										Some(chain): switch (ruFwdSetness(ids, t, stcl)) {
											None(): { dbg("setness DECLINED"); st2 };
											Some(setn): {
												inst = chain.first;
												key = inst.nodes;
												if (containsSet(st2.seen, key)) st2 else {
													spcvStmt = RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [pexp, inst])], -1);
													spcvTree = RuProofStep(ids.spcv, [setn, chain.second], spcvStmt);
													instTree = RuProofStep(ids.axmp, [RuProofHyp(p.ind, p.stmt), spcvTree], RuStmt(stcl, [inst], -1));
													sf = RuProverExp(-1, makeVector(4), RuStmt(stcl, [inst], -1), makeVector(0), ruNoProverProp);
													pushVector(sf.proofs, RuProverProofForward(sf, RuStmt(stcl, [inst], -1), ruEmptySubst, instTree));
													(ruFwdRegister(st2, [], sf, inst, key)).first;
												}
											}
										}
									}
								}
							});
						}
					}
				}
			}
		}
	});
}

// IDENTITY-INSTANCE seeding (the Equalizer half of the `instantiate` frame): for each
// 0-hypothesis assertion in scope whose conclusion is an EQUALITY (wceq-headed identity
// schema, e.g. disjdif ⊢(A∩(B∖A))=∅) and each class-typed candidate subterm t of the
// goal/premises, MATCH t against the identity's LEFT side; a FULLY-GROUNDING match σ
// seeds the instance σ·(L=R) as a fact whose proof is the one-step assertion instance
// (RuProofStep(identity, [], stmt)) — kernel-verified like any proof. eqcomi in scope
// covers right-side needs by flipping. Bounded by the same candidate cap; dedup by seen.
ruSeedIdentityFront(prover_env : RuProverEnv, c_task : RuConstAny<RuProverTask>, fwd : RuProverForward, asses : RuIndex<RuAssertion>) -> RuProverForward {
	ids  = ruFwdInstIds();
	stcl = c_task.const.goal.stmt.class;
	// Seed equality identities only when the task actually CONTAINS an equality
	// (goal or a premise): for a pure relational task (e.g. a subset goal) the
	// identity instances are junk by construction and starve the useful chains.
	hasEq = exists(concat([ruExp(c_task.const.goal.stmt.exps[0])], map(c_task.const.premises, \pp -> ruExp(pp.stmt.exps[0]))),
		\e -> exists(e.nodes, \n -> switch (n) {
			RuVar(__,__): false;
			RuRuleNode(idT, __): ruIdType2Id(idT) == ids.wceq;
		}));
	if (!hasEq) fwd else {
	cands = ruFwdInstCandidates(ids,
		concat([ruExp(c_task.const.goal.stmt.exps[0])], map(c_task.const.premises, \p -> ruExp(p.stmt.exps[0]))),
		ruFwdInstCap(prover_env));
	// SYMBOL FILTER: admit an identity schema only if every CLASS-typed operation
	// symbol in its conclusion occurs in the task (goal+premises). Instantiating
	// foreign-symbol identities (e.g. the symmetric-difference family into a
	// {intersect, difference}-only goal) only feeds the eqtri quadratic with junk —
	// observed to REGRESS theorems the small base closed. A LIMIT: the plain
	// schematic 0-hyp facts are still seeded regardless, so nothing is lost.
	taskOps = fold(
		concat([ruExp(c_task.const.goal.stmt.exps[0])], map(c_task.const.premises, \pp -> ruExp(pp.stmt.exps[0]))),
		makeSet(), \acc, e -> fold(e.nodes, acc, \ac, n -> switch (n) {
			RuVar(__,__): ac;
			RuRuleNode(idT, __): if (ruIdType2Type(idT) == ids.cls) insertSet(ac, ruIdType2Id(idT)) else ac;
		}));
	idents = filter(ruIndexValues(asses), \a ->
		length(a.infer.hyps) == 0 && {
			cn = (ruExp(a.infer.prop.exps[0])).nodes;
			switch (cn[0]) {
				RuVar(__,__): false;
				RuRuleNode(idT, __): ruIdType2Id(idT) == ids.wceq
					&& forall(cn, \n -> switch (n) {
						RuVar(__,__): true;
						RuRuleNode(idT2, __): ruIdType2Type(idT2) != ids.cls || containsSet(taskOps, ruIdType2Id(idT2));
					});
			}
		});
	fold(idents, fwd, \st, a -> {
		concl = ruExp(a.infer.prop.exps[0]);
		lend  = ruFwdSpan(concl.nodes, 1);
		lhs   = RuExp(subrange(concl.nodes, 1, lend - 1), -1);
		fold(cands, st, \st2, t -> {
			switch (ruMatchExp(RuExp(t, -1), lhs, prover_env.math, prover_env.env)) {
				None(): st2;
				Some(sigma): {
					inst = ruApplySubst(concl, sigma);
					// Require FULL grounding: a leftover schematic var would seed a
					// half-instantiated schema (junk the ground-first ordering exists
					// to avoid). Declined instances stay reachable as the plain 0-hyp
					// schematic fact (seeded by ruSeedForwardFront) — nothing lost.
					ground = !exists(inst.nodes, \n -> switch (n) {
						RuVar(__,__): true;
						RuRuleNode(__,__): false;
					});
					key = inst.nodes;
					if (!ground || containsSet(st2.seen, key)) st2 else {
						tree = RuProofStep(a.info.id, [], RuStmt(stcl, [inst], -1));
						sf = RuProverExp(-1, makeVector(4), RuStmt(stcl, [inst], -1), makeVector(0), ruNoProverProp);
						pushVector(sf.proofs, RuProverProofForward(sf, RuStmt(stcl, [inst], -1), ruEmptySubst, tree));
						(ruFwdRegister(st2, [], sf, inst, key)).first;
					}
				}
			}
		});
	});
	}
}

// ---------------------------------------------------------------------------
// eq-normalize (DIRECTED equality rewriting - the deterministic Equate,
// mizar-tactic-plan): when the GOAL is an equality X = Y, normalize BOTH sides
// by the ORIENTED identity base and, if the normal forms coincide, seed the
// goal fact with the constructed proof (identity instances lifted through
// their contexts by the per-operation congruence inferences, chained by
// eqtri) - the seed-join then closes the root. No search: this is rewriting
// to canonical form, union-find quality, where wave saturation over the
// term-GROWING *eq*i inferences structurally explodes.
//
// Orientation guards (a rule is L -> R):
//   - vars(R) must be a subset of vars(L)  (sound direction);
//   - COMM-shaped rules (|R| = |L|) apply only ORDER-DECREASING (the rewritten
//     subterm strictly decreases in the node order) - no A^B <-> B^A loops;
//   - GROWING rules (|sigma R| > |sigma L|) apply only when ELIMINATING (some
//     class-op of L is absent from R, e.g. dfsymdif3 eliminating symdiff).
// For each identity whose lhs head is a commutative op (cin/cun) a SWAPPED
// variant is added mechanically (proof = eqtri(incom/uncom instance, identity
// instance)) - deterministic coverage instead of AC-matching.
// Rewriting is leftmost-OUTERMOST; a redex under an unliftable context
// (csymdif has no *eq*i inferences) is skipped - outermost-first eliminates
// the symdiff node itself before anything must lift through it.
// ---------------------------------------------------------------------------

RuFwdEqIds(
	eqtri : int, eqcomi : int, eqid : int, incom : int, uncom : int,
	ineq1i : int, ineq2i : int, uneq1i : int, uneq2i : int, difeq1i : int, difeq2i : int,
	cin : int, cun : int, cdif : int, axgen : int, mpbir : int,
	csymdif : int, symdifeq1 : int, symdifeq2 : int
);
ruFwdEqIds() -> RuFwdEqIds {
	RuFwdEqIds(
		s2id_("eqtri"), s2id_("eqcomi"), s2id_("eqid"), s2id_("incom"), s2id_("uncom"),
		s2id_("ineq1i"), s2id_("ineq2i"), s2id_("uneq1i"), s2id_("uneq2i"), s2id_("difeq1i"), s2id_("difeq2i"),
		s2id("cin"), s2id("cun"), s2id("cdif"), s2id_("ax-gen"), s2id_("mpbir"),
		s2id("csymdif"), s2id_("symdifeq1"), s2id_("symdifeq2")
	);
}

// One oriented rewrite rule: lhs/rhs patterns + a proof builder for the
// INSTANCE equality sigma(lhs) = sigma(rhs).
RuFwdEqRule(
	lhs : [RuExpNode],
	rhs : [RuExpNode],
	comm : bool,        // order-decreasing guard applies
	grow : bool,        // |rhs| may exceed |lhs| under sigma
	elim : bool,        // rhs drops a class-op present in lhs
	poly : bool,        // instance-wise POLYNOMIAL-decrease guard applies (distributivity)
	mkProof : (RuExp, RuExp, int) -> RuProofTree  // (instLhs, instRhs, stmtClass)
);

ruFwdClassOps(ids : RuFwdInstIds, nodes : [RuExpNode]) -> Set<int> {
	fold(nodes, makeSet(), \ac, n -> switch (n) {
		RuVar(__,__): ac;
		RuRuleNode(idT, __): if (ruIdType2Type(idT) == ids.cls) insertSet(ac, ruIdType2Id(idT)) else ac;
	});
}

// node-array order for the comm guard: compare by (isVar, id, type) lexicographically.
ruFwdNodeLess(a : [RuExpNode], b : [RuExpNode]) -> bool {
	n = min(length(a), length(b));
	res = fold(enumFromTo(0, n - 1), 0, \st, i ->
		if (st != 0) st else {
			ka = switch (a[i]) { RuVar(id, tp): Pair(id, tp); RuRuleNode(idT, __): Pair(ruIdType2Id(idT) + 1000000000, ruIdType2Type(idT)); };
			kb = switch (b[i]) { RuVar(id, tp): Pair(id, tp); RuRuleNode(idT, __): Pair(ruIdType2Id(idT) + 1000000000, ruIdType2Type(idT)); };
			if (ka.first != kb.first) { if (ka.first < kb.first) -1 else 1 }
			else if (ka.second != kb.second) { if (ka.second < kb.second) -1 else 1 }
			else 0;
		});
	if (res != 0) res < 0 else length(a) < length(b);
}

// Build the oriented rule set from the task-filtered identity schemata.
ruFwdEqRules(ids : RuFwdInstIds, eids : RuFwdEqIds, idents : [RuAssertion], stcl : int) -> [RuFwdEqRule] {
	concatA(map(idents, \a -> {
		concl = ruExp(a.infer.prop.exps[0]);
		lend  = ruFwdSpan(concl.nodes, 1);
		lhs   = subrange(concl.nodes, 1, lend - 1);
		rhs   = subrange(concl.nodes, lend, length(concl.nodes) - lend);
		lvars = fold(lhs, makeSet(), \ac, n -> switch (n) { RuVar(id,__): insertSet(ac, id); RuRuleNode(__,__): ac; });
		rOk   = forall(rhs, \n -> switch (n) { RuVar(id,__): containsSet(lvars, id); RuRuleNode(__,__): true; });
		if (!rOk) [] else {
			lops = ruFwdClassOps(ids, lhs);
			rops = ruFwdClassOps(ids, rhs);
			elim = foldSet(lops, false, \ac, op -> ac || !containsSet(rops, op));
			comm = length(lhs) == length(rhs) && !elim;
			grow = length(rhs) > length(lhs);
			mkP  = \il : RuExp, ir : RuExp, sc : int ->
				RuProofStep(a.info.id, [], RuStmt(sc, [ruFwdMkRule(ruFwdEqIds().eqtri, 0, [])], -1)); // placeholder, replaced below
			// direct rule (proof = the identity instance)
			base = RuFwdEqRule(lhs, rhs, comm, grow, elim, false,
				\il, ir, sc -> RuProofStep(a.info.id, [],
					RuStmt(sc, [ruFwdMkRule(s2id("wceq"), tp2id_("wff"), [il, ir])], -1)));
			// REVERSED variant for a comm-shaped rule (same length, still guarded
			// order-decreasing, so no loops): whichever association/permutation
			// direction decreases is available — e.g. symdifass converges both
			// nestings of (A△B)△C to the lex-min one. Proof = eqcomi(identity).
			reversed = if (!comm) [] else
				[RuFwdEqRule(rhs, lhs, true, false, false, false,
					\il, ir, sc -> {
						wceq = s2id("wceq"); wff = tp2id_("wff");
						RuProofStep(ruFwdEqIds().eqcomi,
							[RuProofStep(a.info.id, [], RuStmt(sc, [ruFwdMkRule(wceq, wff, [ir, il])], -1))],
							RuStmt(sc, [ruFwdMkRule(wceq, wff, [il, ir])], -1));
					})];
			// swapped variant for a commutative lhs head (cin/cun): lhs' = op(b,c) -> rhs,
			// proof = eqtri(comm-instance op(b,c)=op(c,b), identity instance).
			swapped = switch (lhs[0]) {
				RuVar(__,__): [];
				RuRuleNode(idT, __): {
					op = ruIdType2Id(idT);
					if (op != eids.cin && op != eids.cun) [] else {
						aend = ruFwdSpan(lhs, 1);
						la = subrange(lhs, 1, aend - 1);
						lb = subrange(lhs, aend, length(lhs) - aend);
						lhs2 = concat([lhs[0]], concat(lb, la));
						commId = if (op == eids.cin) eids.incom else eids.uncom;
						[RuFwdEqRule(lhs2, rhs, comm, grow, elim, false,
							\il, ir, sc -> {
								// il = op(sb, sa); the comm instance flips it to op(sa, sb) = the identity's lhs instance.
								a2 = ruFwdSpan(il.nodes, 1);
								sb = RuExp(subrange(il.nodes, 1, a2 - 1), -1);
								sa = RuExp(subrange(il.nodes, a2, length(il.nodes) - a2), -1);
								flipped = ruFwdMkRule(op, tp2id_("class"), [sa, sb]);
								wceq = s2id("wceq"); wff = tp2id_("wff");
								commStep = RuProofStep(commId, [], RuStmt(sc, [ruFwdMkRule(wceq, wff, [il, flipped])], -1));
								idStep   = RuProofStep(a.info.id, [], RuStmt(sc, [ruFwdMkRule(wceq, wff, [flipped, ir])], -1));
								RuProofStep(ruFwdEqIds().eqtri, [commStep, idStep], RuStmt(sc, [ruFwdMkRule(wceq, wff, [il, ir])], -1));
							})];
					}
				}
			};
			concat3([base], reversed, swapped);
		}
	}));
}

// Refine the rule set: a GROWING rule survives only as DEFINITION UNFOLDING - its
// lhs-head symbol must not occur in the rhs of any rule with a DIFFERENT lhs head
// (same-headed permuting rules preserve the head count). Then the head count
// strictly decreases under unfolding and never recovers: generic termination,
// no symbol names hardcoded. Without this, mutually-eliminating distributivity
// pairs (drop-union/add-intersect vs drop-intersect/add-union) ping-pong with
// exponential growth.
ruFwdEqRulesChecked(ids : RuFwdInstIds, eids : RuFwdEqIds, idents : [RuAssertion], stcl : int) -> [RuFwdEqRule] {
	raw = ruFwdEqRules(ids, eids, idents, stcl);
	headOf = \r : RuFwdEqRule -> switch (r.lhs[0]) {
		RuVar(__,__): 0;
		RuRuleNode(idT, __): ruIdType2Id(idT);
	};
	// The unfold-order graph: head(r) → each DIFFERENT class-op in r's rhs, over
	// non-comm rules (comm rules permute the same op multiset — introduce nothing).
	// A growing rule is admitted iff its head lies on NO CYCLE: then the head counts
	// decrease lexicographically along the topological order (e.g. df-symdif may
	// reintroduce ∖ under difindir's feet — △ → ∖ is one-way, nothing reintroduces △ —
	// while the mutually-eliminating distributivity pair ∩ ⇄ ∪ stays rejected).
	// Self-edges are ignored, as before: a same-headed unfold (difindir's ∖ → ∖∖)
	// recurses into strictly smaller arguments; the fuel bound backstops it.
	edges = fold(raw, makeTree(), \ac, r ->
		if (r.comm) ac else {
			h = headOf(r);
			if (h == 0) ac
			else setTree(ac, h, mergeSets(lookupTreeDef(ac, h, makeSet()),
				removeSet(ruFwdClassOps(ids, r.rhs), h)));
		});
	onCycle = \h : int -> {
		// DFS: is h reachable from h through `edges`?
		reach = for(Pair(lookupTreeDef(edges, h, makeSet()), true), \st -> st.second, \st -> {
			next = foldSet(st.first, st.first, \ac, k -> mergeSets(ac, lookupTreeDef(edges, k, makeSet())));
			Pair(next, sizeSet(next) != sizeSet(st.first));
		});
		containsSet(reach.first, h);
	};
	checked = filtermap(raw, \r -> {
		if (!r.grow) Some(r) else {
			h = headOf(r);
			if (h != 0 && !onCycle(h)) Some(RuFwdEqRule(r with elim = true))
			// growing rules on an unfold CYCLE (the ∩⇄∪ distributivity pair):
			// admitted with the INSTANCE-WISE polynomial-decrease guard — the
			// classic termination interpretation I(var)=2, I(∩)=I(∖)=a·b,
			// I(∪)=a+b+1 orients ∩-over-∪ distribution strictly downhill while
			// its ping-pong partner (∪-over-∩) never decreases and never fires.
			else Some(RuFwdEqRule(r with poly = true));
		}
	});
	// COMM-FIRST rule order: at each redex the AC-canonicalizing (comm-shaped,
	// order-decreasing) rules are tried before elim/unfold — so e.g. symdifass
	// converges both nestings of a pure △-term BEFORE dfsymdif-unfolding turns
	// them into ∖∪∩ forms that only distributivity could reconcile.
	withSwaps = concat(checked, ruFwdSynthMidSwaps(ids, eids, checked, stcl));
	concat(filter(withSwaps, \r -> r.comm), filter(withSwaps, \r -> !r.comm));
}

// Synthesize the MIDDLE-SWAP rules for every op with both assoc and com in the
// base — the in12/in32 analogues ((AopB)opC → (AopC)opB and Aop(BopC) → Bop(AopC)).
// Greedy order-decreasing rewriting over {com, assoc±} alone has LOCAL MINIMA in
// an AC class (t91: (x7△x9)△x5 has no decreasing move without the middle swap);
// with adjacent transpositions at every level the sorted form is always reachable.
// Proof = eqtri(assoc±, lifted com, assoc∓) — constructed per instance.
ruFwdSynthMidSwaps(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], stcl : int) -> [RuFwdEqRule] {
	wceq = s2id("wceq"); wff = tp2id_("wff");
	isVar3 = \ns : [RuExpNode] -> length(ns) == 1 && (switch (ns[0]) { RuVar(__,__): true; RuRuleNode(__,__): false; });
	headOf = \ns : [RuExpNode] -> switch (ns[0]) { RuVar(__,__): 0; RuRuleNode(idT, __): ruIdType2Id(idT); };
	arg = \ns : [RuExpNode], i : int -> {
		// i-th (1-based) arg slice of a 2-ary node array
		a1e = ruFwdSpan(ns, 1);
		if (i == 1) subrange(ns, 1, a1e - 1) else subrange(ns, a1e, length(ns) - a1e);
	};
	// find per-op assoc ((A.B).C = A.(B.C), distinct plain vars) and com (A.B = B.A)
	find = \pred : (RuFwdEqRule) -> bool -> fold(rules, makeTree(), \ac, r -> {
		h = headOf(r.lhs);
		if (h == 0 || containsKeyTree(ac, h) || !pred(r)) ac else setTree(ac, h, r);
	});
	assocT = find(\r -> {
		h = headOf(r.lhs);
		length(r.lhs) == 5 && length(r.rhs) == 5
		&& headOf(arg(r.lhs, 1)) == h && isVar3(arg(r.lhs, 2))
		&& headOf(arg(r.rhs, 2)) == h && isVar3(arg(r.rhs, 1))
		&& isVar3(arg(arg(r.lhs, 1), 1)) && isVar3(arg(arg(r.lhs, 1), 2))
		&& arg(arg(r.lhs, 1), 1) == arg(r.rhs, 1)
		&& arg(arg(r.lhs, 1), 2) == arg(arg(r.rhs, 2), 1)
		&& arg(r.lhs, 2) == arg(arg(r.rhs, 2), 2);
	});
	comT = find(\r ->
		length(r.lhs) == 3 && length(r.rhs) == 3
		&& isVar3(arg(r.lhs, 1)) && isVar3(arg(r.lhs, 2))
		&& arg(r.lhs, 1) == arg(r.rhs, 2) && arg(r.lhs, 2) == arg(r.rhs, 1));
	// the lifted-com step: ⊢ (x op a) = (x op b) from com ⊢ a = b context (arg 2)
	liftArg2 = \op : int, x : RuExp, from : RuExp, to : RuExp, inner : RuProofTree -> {
		stmt = RuStmt(stcl, [ruFwdMkRule(wceq, wff, [ruFwdMkRule(op, ids.cls, [x, from]), ruFwdMkRule(op, ids.cls, [x, to])])], -1);
		lem = ruFwdLiftLemma(eids, op, 2);
		if (lem != 0) RuProofStep(lem, [inner], stmt)
		else {
			impl = ruFwdLiftImpl(eids, op, 2);
			implStmt = RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [ruFwdProofTreeExp(inner), ruExp(stmt.exps[0])])], -1);
			RuProofStep(ids.axmp, [inner, RuProofStep(impl, [], implStmt)], stmt);
		}
	};
	liftArg1 = \op : int, from : RuExp, to : RuExp, x : RuExp, inner : RuProofTree -> {
		stmt = RuStmt(stcl, [ruFwdMkRule(wceq, wff, [ruFwdMkRule(op, ids.cls, [from, x]), ruFwdMkRule(op, ids.cls, [to, x])])], -1);
		lem = ruFwdLiftLemma(eids, op, 1);
		if (lem != 0) RuProofStep(lem, [inner], stmt)
		else {
			impl = ruFwdLiftImpl(eids, op, 1);
			implStmt = RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [ruFwdProofTreeExp(inner), ruExp(stmt.exps[0])])], -1);
			RuProofStep(ids.axmp, [inner, RuProofStep(impl, [], implStmt)], stmt);
		}
	};
	liftable = \op : int -> ruFwdLiftLemma(eids, op, 1) != 0 || ruFwdLiftImpl(eids, op, 1) != 0;
	foldTree(assocT, [], \op, ar : RuFwdEqRule, acc -> {
		switch (lookupTree(comT, op)) {
			None(): acc;
			Some(cr): if (!liftable(op)) acc else {
				mkOp = \a : RuExp, b : RuExp -> ruFwdMkRule(op, ids.cls, [a, b]);
				assocStep = \a : RuExp, b : RuExp, c : RuExp -> // ⊢ ((a.b).c) = (a.(b.c))
					ar.mkProof(mkOp(mkOp(a, b), c), mkOp(a, mkOp(b, c)), stcl);
				comStep = \a : RuExp, b : RuExp -> cr.mkProof(mkOp(a, b), mkOp(b, a), stcl);
				eqtriStep = \p1 : RuProofTree, p2 : RuProofTree, l : RuExp, r : RuExp ->
					RuProofStep(eids.eqtri, [p1, p2], RuStmt(stcl, [ruFwdMkRule(wceq, wff, [l, r])], -1));
				eqcomiStep = \p : RuProofTree, l : RuExp, r : RuExp ->
					RuProofStep(eids.eqcomi, [p], RuStmt(stcl, [ruFwdMkRule(wceq, wff, [l, r])], -1));
				// pattern vars (reuse assoc's, which are plain distinct RuVars)
				vA = RuExp(arg(ar.rhs, 1), -1); vB = RuExp(arg(arg(ar.rhs, 2), 1), -1); vC = RuExp(arg(arg(ar.rhs, 2), 2), -1);
				splitInst = \il : RuExp, nested : int -> {
					// il = (a.b).c (nested=1) or a.(b.c) (nested=2): extract (a, b, c)
					o = arg(il.nodes, if (nested == 1) 1 else 2);
					x = arg(il.nodes, if (nested == 1) 2 else 1);
					Triple(
						RuExp(if (nested == 1) arg(o, 1) else x, -1),
						RuExp(if (nested == 1) arg(o, 2) else arg(o, 1), -1),
						RuExp(if (nested == 1) x else arg(o, 2), -1));
				};
				// mid32: (A.B).C → (A.C).B  =  assoc ; lift-com(arg2) ; assoc⁻¹
				lhs32 = ar.lhs; // (A.B).C
				rhs32 = concat3([ar.lhs[0], ar.lhs[0]], concat(vA.nodes, vC.nodes), vB.nodes); // (A.C).B
				r32 = RuFwdEqRule(lhs32, rhs32, true, false, false, false, \il, ir, sc -> {
					t = splitInst(il, 1); a = t.first; b = t.second; c = t.third;
					p1 = assocStep(a, b, c);                                     // (a.b).c = a.(b.c)
					p2 = liftArg2(op, a, mkOp(b, c), mkOp(c, b), comStep(b, c)); // a.(b.c) = a.(c.b)
					p12 = eqtriStep(p1, p2, il, mkOp(a, mkOp(c, b)));
					p3 = eqcomiStep(assocStep(a, c, b), mkOp(a, mkOp(c, b)), ir); // a.(c.b) = (a.c).b
					eqtriStep(p12, p3, il, ir);
				});
				// mid12: A.(B.C) → B.(A.C)  =  assoc⁻¹ ; lift-com(arg1) ; assoc
				lhs12 = ar.rhs; // A.(B.C)
				rhs12 = concat3([ar.lhs[0]], vB.nodes, concat([ar.lhs[0]], concat(vA.nodes, vC.nodes))); // B.(A.C)
				r12 = RuFwdEqRule(lhs12, rhs12, true, false, false, false, \il, ir, sc -> {
					t = splitInst(il, 2); a = t.first; b = t.second; c = t.third;
					p1 = eqcomiStep(assocStep(a, b, c), il, mkOp(mkOp(a, b), c)); // a.(b.c) = (a.b).c
					p2 = liftArg1(op, mkOp(a, b), mkOp(b, a), c, comStep(a, b)); // (a.b).c = (b.a).c
					p12 = eqtriStep(p1, p2, il, mkOp(mkOp(b, a), c));
					p3 = assocStep(b, a, c);                                     // (b.a).c = b.(a.c)
					eqtriStep(p12, p3, il, ir);
				});
				concat3(acc, [r32, r12], []);
			}
		}
	});
}

// The congruence lift lemma for rewriting arg `argIdx` of `op` (1-based); 0 = none.
ruFwdLiftLemma(eids : RuFwdEqIds, op : int, argIdx : int) -> int {
	if (op == eids.cin) { if (argIdx == 1) eids.ineq1i else eids.ineq2i }
	else if (op == eids.cun) { if (argIdx == 1) eids.uneq1i else eids.uneq2i }
	else if (op == eids.cdif) { if (argIdx == 1) eids.difeq1i else eids.difeq2i }
	else 0;
}

// Ops with no 1-hyp *eq*i inference form but a 0-hyp IMPLICATION congruence
// ((A=B) → (A op C) = (B op C)): the lift step is then ax-mp(inner, impl-instance).
// csymdif only has symdifeq1/symdifeq2 — this is what makes △ contexts liftable.
ruFwdLiftImpl(eids : RuFwdEqIds, op : int, argIdx : int) -> int {
	if (op == eids.csymdif) { if (argIdx == 1) eids.symdifeq1 else eids.symdifeq2 }
	else 0;
}

ruFwdProofTreeExp(tr : RuProofTree) -> RuExp {
	switch (tr) {
		RuProofStep(__,__,st): ruExp(st.exps[0]);
		RuProofHyp(__,st): ruExp(st.exps[0]);
	}
}

// Path from the term root to position i: [(ancestor position, 1-based arg index)].
ruFwdPathTo(term : [RuExpNode], i : int, pos : int, acc : [Pair<int, int>]) -> Maybe<[Pair<int, int>]> {
	if (pos == i) Some(acc)
	else switch (term[pos]) {
		RuVar(__,__): None();
		RuRuleNode(idT, al): {
			arity = ruArityLen2Arity(al);
			if (arity == 0) None() else {
				found = fold(enumFromTo(1, arity), Pair(pos + 1, None()), \st, k -> {
					switch (st.second) {
						Some(__): st;
						None(): {
							e = ruFwdSpan(term, st.first);
							if (i >= st.first && i < e) Pair(e, Some(Pair(st.first, k))) else Pair(e, None());
						}
					}
				});
				switch (found.second) {
					None(): None();
					Some(ci): ruFwdPathTo(term, i, ci.first, arrayPush(acc, Pair(pos, ci.second)));
				}
			}
		}
	}
}

// The polynomial termination interpretation for the instance-wise guard:
// I(atom) = 2, I(∩) = I(∖) = a·b, I(∪) = a+b+1; any other class op gets the
// monotone-safe (a+1)(b+1)… product. Doubles saturate at +inf, where the
// strict-decrease comparison fails and the rule simply does not apply — safe.
// I(atom) = 3, NOT 2: at 2 the compound-subtrahend unfold difdif2
// (A∖(B∖C) = (A∖B)∪(A∩C), the DNF direction) is blocked at its minimum
// (2·2·2 = 8 < 9 = 2·2+2·2+1) — at 3 it is strictly decreasing for ALL
// instances (a·b·c − a·b − a·c − 1 = a(b(c−1)−c) − 1 ≥ 8 for values ≥ 3)
// while the admitted distribution family's margins only grow and the
// ping-pong partner (∪ over ∩) stays blocked at every atom weight.
ruFwdPolyI(eids : RuFwdEqIds, nodes : [RuExpNode], pos : int) -> Pair<double, int> {
	switch (nodes[pos]) {
		RuVar(__,__): Pair(3.0, pos + 1);
		RuRuleNode(idT, al): {
			arity = ruArityLen2Arity(al);
			if (arity == 0) Pair(3.0, pos + 1)
			else {
				op = ruIdType2Id(idT);
				args = fold(enumFromTo(1, arity), Pair([], pos + 1), \ac, __ -> {
					r = ruFwdPolyI(eids, nodes, ac.second);
					Pair(arrayPush(ac.first, r.first), r.second);
				});
				v = if (arity == 2 && (op == eids.cin || op == eids.cdif)) args.first[0] * args.first[1]
					else if (arity == 2 && op == eids.cun) args.first[0] + args.first[1] + 1.0
					else fold(args.first, 1.0, \p, a -> p * (a + 1.0));
				Pair(v, args.second);
			}
		}
	}
}

// One rewrite attempt at the leftmost-outermost liftable redex.
// Returns Some((new term nodes, proof of term = new term)) or None (normal form).
ruFwdRewriteStep(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], term : [RuExpNode], stcl : int, math : RuMath, env : RuEnv) -> Maybe<Pair<[RuExpNode], RuProofTree>> {
	wceq = s2id("wceq"); wff = tp2id_("wff");
	pathTo = \i : int -> ruFwdPathTo(term, i, 0, []);
	positions = enumFromTo(0, length(term) - 1);
	fold(positions, None(), \found, i ->
		switch (found) {
			Some(__): found;
			None(): {
				send = ruFwdSpan(term, i);
				sub = subrange(term, i, send - i);
				// try rules at this position
				hit = fold(rules, None(), \h, r -> switch (h) {
					Some(__): h;
					None(): switch (ruMatchExp(RuExp(sub, -1), RuExp(r.lhs, -1), math, env)) {
						None(): None();
						Some(sigma): {
							irhs = ruApplySubst(RuExp(r.rhs, -1), sigma);
							okComm = !r.comm || ruFwdNodeLess(irhs.nodes, sub);
							okGrow = !r.grow || r.elim
								|| (r.poly && (ruFwdPolyI(eids, irhs.nodes, 0)).first < (ruFwdPolyI(eids, sub, 0)).first);
							if (!okComm || !okGrow) None()
							else Some(Pair(irhs.nodes, r.mkProof(RuExp(sub, -1), irhs, stcl)));
						}
					}
				});
				switch (hit) {
					None(): None();
					Some(hp) : {
						switch (pathTo(i)) {
							None(): None();
							Some(path): {
								// liftable path check (1-hyp inference OR 0-hyp implication form)
								liftable = forall(path, \pe -> switch (term[pe.first]) {
									RuVar(__,__): false;
									RuRuleNode(idT, __): ruFwdLiftLemma(eids, ruIdType2Id(idT), pe.second) != 0
										|| ruFwdLiftImpl(eids, ruIdType2Id(idT), pe.second) != 0;
								});
								if (!liftable) None() else {
									// Splice the rewritten subtree AND recompute every ancestor's
									// packed LEN by the size delta - node lens are subtree sizes,
									// and stale ancestor lens after a shrinking/growing rewrite
									// produce MALFORMED expressions (verifier walks overshoot)
									// and false normal-form mismatches.
									delta = length(hp.first) - (send - i);
									ancs = buildSet(map(path, \pe -> pe.first));
									newTerm = mapi(concat3(subrange(term, 0, i), hp.first, subrange(term, send, length(term) - send)),
										\j, n -> if (!containsSet(ancs, j)) n else switch (n) {
											RuVar(__,__): n;
											RuRuleNode(idT, al): ruMakeRuleNode(ruIdType2Id(idT), ruIdType2Type(idT),
												ruArityLen2Arity(al), ruArityLen2Len(al) + delta);
										});
									// Lift from the innermost ancestor to the root. Positions
									// BELOW an ancestor are identical in term and newTerm (only
									// the subtree at i changed), so the rewritten ancestor is
									// simply the subtree at the SAME position in newTerm — no
									// splice arithmetic (the previous version built malformed
									// expressions and crashed the verifier).
									tree = fold(reverseA(path), hp.second, \tr, pe -> {
										anc = pe.first; idx = pe.second;
										before = subrange(term, anc, ruFwdSpan(term, anc) - anc);
										after  = subrange(newTerm, anc, ruFwdSpan(newTerm, anc) - anc);
										op = switch (term[anc]) { RuVar(__,__): 0; RuRuleNode(idT,__): ruIdType2Id(idT); };
										lift = ruFwdLiftLemma(eids, op, idx);
										stmt = RuStmt(stcl, [ruFwdMkRule(wceq, wff, [RuExp(before, -1), RuExp(after, -1)])], -1);
										if (lift != 0) RuProofStep(lift, [tr], stmt)
										else {
											// 0-hyp implication congruence: ax-mp(inner, ⊢ inner-eq → ancestor-eq)
											impl = ruFwdLiftImpl(eids, op, idx);
											implStmt = RuStmt(stcl,
												[ruFwdMkRule(ids.wi, ids.wff, [ruFwdProofTreeExp(tr), ruExp(stmt.exps[0])])], -1);
											RuProofStep(ids.axmp, [tr, RuProofStep(impl, [], implStmt)], stmt);
										}
									});
									Some(Pair(newTerm, tree));
								}
							}
						}
					}
				}
			}
		});
}

// Normalize a term: fixpoint of ruFwdRewriteStep (bounded), chaining step proofs by eqtri.
// Returns (normal form, Some(proof of term = nf)) - None proof when already normal.
ruFwdNormalize(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], term0 : [RuExpNode], stcl : int, math : RuMath, env : RuEnv) -> Pair<[RuExpNode], Maybe<RuProofTree>> {
	wceq = s2id("wceq"); wff = tp2id_("wff");
	ruFwdNormalizeRec(ids, eids, filter(rules, \r -> r.comm), rules, term0, term0, None(), 512, stcl, math, env);
}

ruFwdNormalizeRec(ids : RuFwdInstIds, eids : RuFwdEqIds, commRules : [RuFwdEqRule], rules : [RuFwdEqRule], term0 : [RuExpNode], term : [RuExpNode], acc : Maybe<RuProofTree>, fuel : int, stcl : int, math : RuMath, env : RuEnv) -> Pair<[RuExpNode], Maybe<RuProofTree>> {
	wceq = s2id("wceq"); wff = tp2id_("wff");
	if (fuel <= 0 || length(term) > 512) Pair(term, acc)
	else {
		// AC-canonicalize to a GLOBAL fixpoint before any elim/unfold step: comm rules
		// only, at every position, until none applies (each comm step is same-length
		// order-decreasing — a strict lex descent, so this terminates). Per-position
		// comm-first is NOT enough: leftmost-outermost lets a root elim (df-symdif)
		// fire while an inner subterm is still one comm step away from the AC minimum —
		// the two sides of the goal then unfold from DIFFERENT arrangements and never
		// reconcile (t91).
		commStep = ruFwdRewriteStep(ids, eids, commRules, term, stcl, math, env);
		switch (switch (commStep) {
			Some(__): commStep;
			None(): ruFwdRewriteStep(ids, eids, rules, term, stcl, math, env);
		}) {
			None(): Pair(term, acc);
			Some(st): {
				chained = switch (acc) {
					None(): Some(st.second);
					Some(prev): Some(RuProofStep(eids.eqtri, [prev, st.second],
						RuStmt(stcl, [ruFwdMkRule(wceq, wff, [RuExp(term0, -1), RuExp(st.first, -1)])], -1)));
				};
				ruFwdNormalizeRec(ids, eids, commRules, rules, term0, st.first, chained, fuel - 1, stcl, math, env);
			}
		}
	}
}

ruFwdEqDump(lbl : string, t : RuProofTree, d : int, prover_env : RuProverEnv) -> void {
	switch (t) {
		RuProofStep(as, ch, st2): {
			prover_env.env.out.println("  eqnorm" + lbl + " " + i2s(d) + " " + id2s(as) + ": " + ruSafeExp2s(ruExp(st2.exps[0]), prover_env.math.decls.lang));
			iter(ch, \c -> ruFwdEqDump(lbl, c, d + 1, prover_env));
		}
		RuProofHyp(__,__): {};
	}
}

// Strip the ∀-prefix of a CONST-task goal (each bound var is a frozen zero-arity
// setvar node): returns (each ∀-level's full expression, outermost first; the
// quantifier-free body). Each stripped level is re-added around the final proof
// by an ax-gen step — ∀x…(X = Y) is the standard Mizar equality-theorem form.
ruFwdStripWalPrefix(ids : RuFwdInstIds, nodes : [RuExpNode], acc : [[RuExpNode]]) -> Pair<[[RuExpNode]], [RuExpNode]> {
	switch (nodes[0]) {
		RuVar(__,__): Pair(acc, nodes);
		RuRuleNode(idT, __): {
			if (ruIdType2Id(idT) == ids.wal && length(nodes) > 2 && ruFwdIsSetvarNode(nodes[1], ids.setvar)) {
				ruFwdStripWalPrefix(ids, subrange(nodes, 2, length(nodes) - 2), arrayPush(acc, nodes));
			} else Pair(acc, nodes);
		}
	}
}

// SYMBOL CLOSURE for the eq-rule base (deliberately WIDER than ruSeedIdentityFront's
// one-shot filter): an identity is admitted once its LHS class-ops are reachable;
// its RHS ops then become reachable themselves. Definition unfolding legitimately
// INTRODUCES symbols — dfsymdif3 rewrites a △-goal into ∪∖∩ vocabulary the goal
// never mentions, and the ∪-side laws must follow it in. Safe here where it is
// junk in the seeder: rewriting is deterministic (one leftmost-outermost redex per
// step, termination by ruFwdEqRulesChecked), it feeds no wave.
ruFwdCloseIdents(ids : RuFwdInstIds, taskOps : Set<int>, cands : [RuAssertion]) -> [RuAssertion] {
	ops = map(cands, \a -> {
		cn = (ruExp(a.infer.prop.exps[0])).nodes;
		le = ruFwdSpan(cn, 1);
		Pair(ruFwdClassOps(ids, subrange(cn, 1, le - 1)), ruFwdClassOps(ids, subrange(cn, le, length(cn) - le)));
	});
	closed = for(Triple(taskOps, makeSet(), true), \st -> st.third, \st ->
		foldi(cands, Triple(st.first, st.second, false), \i, ac, __ ->
			if (containsSet(ac.second, i)) ac
			else if (foldSet(ops[i].first, true, \sub, op -> sub && containsSet(ac.first, op)))
				Triple(mergeSets(ac.first, ops[i].second), insertSet(ac.second, i), true)
			else ac));
	filtermapi(cands, \i, a -> if (containsSet(closed.second, i)) Some(a) else None());
}

// LEAF FACTS OF THE PREMISES, ∧-FLATTENED: each premise contributes its non-∧
// leaf conjuncts, each with a constructed proof (RuProofHyp + simpli/simpri
// chains). The unss-style ∧-premise forms (t97: ((A∖B)⊆C) ∧ ((B∖A)⊆C)) are
// forward-dead as wave triggers but perfectly usable on the deterministic route.
ruFwdSsConjuncts(ids : RuFwdInstIds, proof : RuProofTree, nodes : [RuExpNode], stcl : int) -> [Pair<RuProofTree, [RuExpNode]>] {
	isWa = switch (nodes[0]) {
		RuVar(__,__): false;
		RuRuleNode(idT, __): ruIdType2Id(idT) == ids.wa;
	};
	if (isWa && length(nodes) >= 3) {
		lend = ruFwdSpan(nodes, 1);
		l = subrange(nodes, 1, lend - 1);
		r = subrange(nodes, lend, length(nodes) - lend);
		concat(
			ruFwdSsConjuncts(ids, RuProofStep(s2id_("simpli"), [proof], RuStmt(stcl, [RuExp(l, -1)], -1)), l, stcl),
			ruFwdSsConjuncts(ids, RuProofStep(s2id_("simpri"), [proof], RuStmt(stcl, [RuExp(r, -1)], -1)), r, stcl)
		);
	} else [Pair(proof, nodes)];
}

ruFwdSsPremises(ids : RuFwdInstIds, premises : [RuPremise], stcl : int) -> [Pair<RuProofTree, [RuExpNode]>] {
	concatA(mapi(premises, \pi, p ->
		ruFwdSsConjuncts(ids, RuProofHyp(pi, p.stmt), (ruExp(p.stmt.exps[0])).nodes, stcl)
	));
}

// THE CLASSIFIED FACT POOLS of a premise/conjunct leaf list: ⊆-facts (bare
// ⊆-literals, the ⊆-half of ⊊-literals via dfpss2, (A∖B)=∅-literals via
// ssdif0), ⊊-facts, and NEGATED literals ¬X with X ∈ {⊆, =, ⊊} (¬-literals
// plus the ≠-half of ⊊-unfolds) — each with a proof in the current mode
// (⊢· bare, ψ→· under a guard). The neg pool is the clash-candidate list:
// proving X against a ¬X fact refutes the guard by pm2.65i.
RuFwdClsFacts(
	ss  : [Pair<RuProofTree, [RuExpNode]>],
	pss : [Pair<RuProofTree, [RuExpNode]>],
	eq0 : [Pair<RuProofTree, [RuExpNode]>], // T=∅ facts; nodes = T
	neg : [Pair<RuProofTree, [RuExpNode]>]  // nodes = X, the ¬ stripped
);

ruFwdBuildClsFacts(ids : RuFwdInstIds, facts : [Pair<RuProofTree, [RuExpNode]>], stcl : int, guard : Maybe<RuExp>) -> RuFwdClsFacts {
	wpss = s2id("wpss");
	wrap = \e : RuExp -> switch (guard) { None(): e; Some(g): ruFwdMkRule(ids.wi, ids.wff, [g, e]); };
	lift = \asId : int, e : RuExp -> {
		bare = RuProofStep(asId, [], RuStmt(stcl, [e], -1));
		switch (guard) {
			None(): bare;
			Some(__): RuProofStep(s2id_("a1i"), [bare], RuStmt(stcl, [wrap(e)], -1));
		}
	};
	mpbi = switch (guard) { None(): s2id_("mpbi"); Some(__): s2id_("mpbid"); };
	mpbir = switch (guard) { None(): s2id_("mpbir"); Some(__): s2id_("mpbird"); };
	simpl = switch (guard) { None(): s2id_("simpli"); Some(__): s2id_("simpld"); };
	simpr = switch (guard) { None(): s2id_("simpri"); Some(__): s2id_("simprd"); };
	empty = [ruMakeRuleNode(s2id("c0"), ids.cls, 0, 0)];
	fold(facts, RuFwdClsFacts([], [], [], []), \ac, f -> {
		nodes = f.second;
		switch (nodes[0]) {
			RuVar(__,__): ac;
			RuRuleNode(idT, __): {
				hid = ruIdType2Id(idT);
				if (hid == ids.wss) RuFwdClsFacts(arrayPush(ac.ss, f), ac.pss, ac.eq0, ac.neg)
				else if (hid == wpss && length(nodes) >= 3) {
					lend = ruFwdSpan(nodes, 1);
					a = subrange(nodes, 1, lend - 1);
					b = subrange(nodes, lend, length(nodes) - lend);
					ssE = ruFwdMkRule(ids.wss, ids.wff, [RuExp(a, -1), RuExp(b, -1)]);
					eqE = ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(a, -1), RuExp(b, -1)]);
					neE = ruFwdMkRule(ids.wn, ids.wff, [eqE]);
					andE = ruFwdMkRule(ids.wa, ids.wff, [ssE, neE]);
					bi = ruFwdMkRule(ids.wb, ids.wff, [RuExp(nodes, -1), andE]);
					pAnd = RuProofStep(mpbi, [f.first, lift(s2id_("dfpss2"), bi)], RuStmt(stcl, [wrap(andE)], -1));
					pSs = RuProofStep(simpl, [pAnd], RuStmt(stcl, [wrap(ssE)], -1));
					pNe = RuProofStep(simpr, [pAnd], RuStmt(stcl, [wrap(neE)], -1));
					RuFwdClsFacts(
						arrayPush(ac.ss, Pair(pSs, ssE.nodes)),
						arrayPush(ac.pss, f),
						ac.eq0,
						arrayPush(ac.neg, Pair(pNe, eqE.nodes)));
				} else if (hid == ids.wceq && length(nodes) >= 3) {
					lend = ruFwdSpan(nodes, 1);
					l = subrange(nodes, 1, lend - 1);
					r = subrange(nodes, lend, length(nodes) - lend);
					if (r == empty) {
						// T = ∅ → the eq0 pool; a difference-shaped T additionally
						// yields the ⊆-fact A⊆B (ssdif0 backward)
						ac1 = RuFwdClsFacts(ac.ss, ac.pss, arrayPush(ac.eq0, Pair(f.first, l)), ac.neg);
						lIsDif = length(l) >= 3 && switch (l[0]) {
							RuVar(__,__): false;
							RuRuleNode(idT2, __): ruIdType2Id(idT2) == ids.cdif;
						};
						if (!lIsDif) ac1 else {
							dend = ruFwdSpan(l, 1);
							la = subrange(l, 1, dend - 1);
							lb = subrange(l, dend, length(l) - dend);
							ssE = ruFwdMkRule(ids.wss, ids.wff, [RuExp(la, -1), RuExp(lb, -1)]);
							bi = ruFwdMkRule(ids.wb, ids.wff, [ssE, RuExp(nodes, -1)]);
							pSs = RuProofStep(mpbir, [f.first, lift(s2id_("ssdif0"), bi)], RuStmt(stcl, [wrap(ssE)], -1));
							RuFwdClsFacts(arrayPush(ac1.ss, Pair(pSs, ssE.nodes)), ac1.pss, ac1.eq0, ac1.neg);
						}
					} else if (l == empty) {
						// ∅ = T → flip into the eq0 pool (eqcomi/eqcomd)
						eqE = ruFwdMkRule(hid, ids.wff, [RuExp(r, -1), RuExp(empty, -1)]);
						eqcom = switch (guard) { None(): s2id_("eqcomi"); Some(__): s2id_("eqcomd"); };
						pFlip = RuProofStep(eqcom, [f.first], RuStmt(stcl, [wrap(eqE)], -1));
						RuFwdClsFacts(ac.ss, ac.pss, arrayPush(ac.eq0, Pair(pFlip, r)), ac.neg);
					} else ac;
				} else if (hid == ids.wn && length(nodes) >= 2) {
					x = subrange(nodes, 1, length(nodes) - 1);
					xOk = switch (x[0]) {
						RuVar(__,__): false;
						RuRuleNode(idT3, __): {
							xh = ruIdType2Id(idT3);
							xh == ids.wss || xh == ids.wceq || xh == wpss || xh == ids.wa;
						}
					};
					if (xOk) RuFwdClsFacts(ac.ss, ac.pss, ac.eq0, arrayPush(ac.neg, Pair(f.first, x))) else ac;
				} else ac;
			}
		}
	});
}

// THE ⊆-CLOSURE (the ssdif0-residue discharge, t97/t110/t117-class): decide
// a ⊆ b by a small syllogism closure — reflexivity, the ∧-flattened ⊆-premises,
// structural shrink on the left (inss1/inss2/difss + sstri), ∪-split on the
// left (unssi), structural growth on the right (ssun1/ssun2 + sstri), and
// transitive chaining THROUGH a premise. The premise channel is the only
// cyclic one — depth-bounded; the structural channels strictly shrink a term.
// DEDUCTION MODE (guard = Some(ψ)): every produced proof proves ψ→X instead
// of X — 0-hyp instances a1i-lift, combiners switch to their d-forms
// (sstri→sstrd, unssi→unssd), and ssPrems must already prove ψ→(A⊆B).
// This is how a Mizar clause ¬(P∧(…∧¬G)) uses its OWN conjuncts as premises.
ruFwdSsClose(ids : RuFwdInstIds, ssPrems : [Pair<RuProofTree, [RuExpNode]>], a : [RuExpNode], b : [RuExpNode], stcl : int, depth : int, guard : Maybe<RuExp>) -> Maybe<RuProofTree> {
	sstri = switch (guard) { None(): s2id_("sstri"); Some(__): s2id_("sstrd"); };
	unssi = switch (guard) { None(): s2id_("unssi"); Some(__): s2id_("unssd"); };
	wss = \x, y -> ruFwdMkRule(ids.wss, ids.wff, [RuExp(x, -1), RuExp(y, -1)]);
	wrap = \e : RuExp -> switch (guard) { None(): e; Some(g): ruFwdMkRule(ids.wi, ids.wff, [g, e]); };
	// a 0-hyp instance ⊢X enters the current mode (a1i-lifted under a guard)
	lift = \asId : int, e : RuExp -> {
		bare = RuProofStep(asId, [], RuStmt(stcl, [e], -1));
		switch (guard) {
			None(): bare;
			Some(__): RuProofStep(s2id_("a1i"), [bare], RuStmt(stcl, [wrap(e)], -1));
		}
	};
	goalE = wss(a, b);
	aIsEmpty = length(a) == 1 && switch (a[0]) {
		RuVar(__,__): false;
		RuRuleNode(idT0, __): ruIdType2Id(idT0) == s2id("c0");
	};
	if (a == b) Some(lift(s2id_("ssid"), goalE))
	else if (aIsEmpty) Some(lift(s2id_("0ss"), goalE)) else {
	direct = fold(ssPrems, None(), \ac, pr -> switch (ac) {
		Some(__): ac;
		None(): {
			pe = pr.second;
			pend = ruFwdSpan(pe, 1);
			if (subrange(pe, 1, pend - 1) == a && subrange(pe, pend, length(pe) - pend) == b)
				Some(pr.first) else None();
		}
	});
	switch (direct) { Some(__): direct; None(): {
	// a ⊆ mid (one structural step) then mid ⊆ b recursively
	viaLeft = \mid : [RuExpNode], pLeft : RuProofTree ->
		maybeMap(ruFwdSsClose(ids, ssPrems, mid, b, stcl, depth, guard),
			\pm -> RuProofStep(sstri, [pLeft, pm], RuStmt(stcl, [wrap(goalE)], -1)));
	structL = switch (a[0]) {
		RuVar(__,__): None();
		RuRuleNode(idT, __): {
			hid = ruIdType2Id(idT);
			if (length(a) < 3) None()
			else {
				lend = ruFwdSpan(a, 1);
				c = subrange(a, 1, lend - 1);
				d = subrange(a, lend, length(a) - lend);
				if (hid == ids.cin) {
					p1 = viaLeft(c, lift(s2id_("inss1"), wss(a, c)));
					switch (p1) { Some(__): p1; None():
						viaLeft(d, lift(s2id_("inss2"), wss(a, d))); }
				} else if (hid == ids.cdif) {
					p1 = viaLeft(c, lift(s2id_("difss"), wss(a, c)));
					switch (p1) { Some(__): p1; None(): {
						// ∖-TRANSPOSITION (difcom: ((C∖D)⊆b) ↔ ((C∖b)⊆D)): the
						// normal form AC-orders subtrahends, so the premise
						// difference may sit transposed ((x5∖x9)∖x7 under
						// (x5∖x7)⊆x9 — t97). Swapping can ping-pong — depth-bounded.
						if (depth <= 0) None() else {
							swapped = (ruFwdMkRule(ids.cdif, ids.cls, [RuExp(c, -1), RuExp(b, -1)])).nodes;
							maybeMap(ruFwdSsClose(ids, ssPrems, swapped, d, stcl, depth - 1, guard), \psw -> {
								bi = ruFwdMkRule(ids.wb, ids.wff, [wss(swapped, d), goalE]);
								mpbi = switch (guard) { None(): s2id_("mpbi"); Some(__): s2id_("mpbid"); };
								RuProofStep(mpbi, [psw, lift(s2id_("difcom"), bi)], RuStmt(stcl, [wrap(goalE)], -1));
							});
						}
					}}
				} else if (hid == ids.cun) {
					maybeBind(ruFwdSsClose(ids, ssPrems, c, b, stcl, depth, guard), \pc ->
						maybeMap(ruFwdSsClose(ids, ssPrems, d, b, stcl, depth, guard), \pd ->
							RuProofStep(unssi, [pc, pd], RuStmt(stcl, [wrap(goalE)], -1))));
				} else None();
			}
		}
	};
	switch (structL) { Some(__): structL; None(): {
	structR = switch (b[0]) {
		RuVar(__,__): None();
		RuRuleNode(idT2, __): {
			bh = ruIdType2Id(idT2);
			if (length(b) < 3) None()
			else if (bh == ids.cun) {
				lend2 = ruFwdSpan(b, 1);
				c2 = subrange(b, 1, lend2 - 1);
				d2 = subrange(b, lend2, length(b) - lend2);
				p1 = maybeMap(ruFwdSsClose(ids, ssPrems, a, c2, stcl, depth, guard), \pac ->
					RuProofStep(sstri, [pac, lift(s2id_("ssun1"), wss(c2, b))], RuStmt(stcl, [wrap(goalE)], -1)));
				switch (p1) { Some(__): p1; None():
					maybeMap(ruFwdSsClose(ids, ssPrems, a, d2, stcl, depth, guard), \pad ->
						RuProofStep(sstri, [pad, lift(s2id_("ssun2"), wss(d2, b))], RuStmt(stcl, [wrap(goalE)], -1))); }
			} else if (bh == ids.cin) {
				// a ⊆ C∩D from BOTH legs (ssin: ((a⊆C)∧(a⊆D)) ↔ (a⊆(C∩D)))
				lend2 = ruFwdSpan(b, 1);
				c2 = subrange(b, 1, lend2 - 1);
				d2 = subrange(b, lend2, length(b) - lend2);
				maybeBind(ruFwdSsClose(ids, ssPrems, a, c2, stcl, depth, guard), \pc ->
					maybeMap(ruFwdSsClose(ids, ssPrems, a, d2, stcl, depth, guard), \pd -> {
						andE = ruFwdMkRule(ids.wa, ids.wff, [wss(a, c2), wss(a, d2)]);
						bi = ruFwdMkRule(ids.wb, ids.wff, [andE, goalE]);
						pairId = switch (guard) { None(): s2id_("pm3.2i"); Some(__): s2id_("jca"); };
						mpbi = switch (guard) { None(): s2id_("mpbi"); Some(__): s2id_("mpbid"); };
						pAnd = RuProofStep(pairId, [pc, pd], RuStmt(stcl, [wrap(andE)], -1));
						RuProofStep(mpbi, [pAnd, lift(s2id_("ssin"), bi)], RuStmt(stcl, [wrap(goalE)], -1));
					}));
			} else None();
		}
	};
	switch (structR) { Some(__): structR; None(): {
	if (depth <= 0) None() else
	fold(ssPrems, None(), \ac, pr -> switch (ac) {
		Some(__): ac;
		None(): {
			pe = pr.second;
			pend = ruFwdSpan(pe, 1);
			pa = subrange(pe, 1, pend - 1);
			pb = subrange(pe, pend, length(pe) - pend);
			if (pa != a) None()
			else maybeMap(ruFwdSsClose(ids, ssPrems, pb, b, stcl, depth - 1, guard),
				\pm -> RuProofStep(sstri, [pr.first, pm], RuStmt(stcl, [wrap(goalE)], -1)));
		}
	});
	}}}}}}}
}

// A = B by ANTISYMMETRY of two ⊆-closures (eqssi/eqssd) — the equality channel
// of the clash driver (t57: x5=x7 from the two ⊊-unfold ⊆-facts; t62: x5=∅
// from x5⊆∅ + 0ss).
ruFwdEqClose(ids : RuFwdInstIds, facts : RuFwdClsFacts, x : [RuExpNode], y : [RuExpNode], stcl : int, guard : Maybe<RuExp>) -> Maybe<RuProofTree> {
	wrap = \e : RuExp -> switch (guard) { None(): e; Some(g): ruFwdMkRule(ids.wi, ids.wff, [g, e]); };
	eqss = switch (guard) { None(): s2id_("eqssi"); Some(__): s2id_("eqssd"); };
	maybeBind(ruFwdSsClose(ids, facts.ss, x, y, stcl, 8, guard), \p1 ->
		maybeMap(ruFwdSsClose(ids, facts.ss, y, x, stcl, 8, guard), \p2 ->
			RuProofStep(eqss, [p1, p2],
				RuStmt(stcl, [wrap(ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(x, -1), RuExp(y, -1)]))], -1))));
}

// A ⊊ B via a ⊊-fact plus ⊆-closure legs: the 0-hyp transitivity implications
// psssstr ((A⊊M)∧(M⊆B) → A⊊B) and sspsstr ((A⊆M)∧(M⊊B) → A⊊B), applied by
// ax-mp (bare) / syl (guarded) to the jca/pm3.2i pair.
ruFwdPssClose(ids : RuFwdInstIds, facts : RuFwdClsFacts, a : [RuExpNode], b : [RuExpNode], stcl : int, guard : Maybe<RuExp>) -> Maybe<RuProofTree> {
	wrap = \e : RuExp -> switch (guard) { None(): e; Some(g): ruFwdMkRule(ids.wi, ids.wff, [g, e]); };
	pairId = switch (guard) { None(): s2id_("pm3.2i"); Some(__): s2id_("jca"); };
	goalE = ruFwdMkRule(s2id("wpss"), ids.wff, [RuExp(a, -1), RuExp(b, -1)]);
	// apply a 0-hyp implication instance ⊢anteE→goalE to a mode proof of anteE
	applyImp = \p : RuProofTree, anteE : RuExp, lemId : int -> {
		inst = RuProofStep(lemId, [], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [anteE, goalE])], -1));
		switch (guard) {
			None(): RuProofStep(ids.axmp, [p, inst], RuStmt(stcl, [goalE], -1));
			Some(__): RuProofStep(s2id_("syl"), [p, inst], RuStmt(stcl, [wrap(goalE)], -1));
		}
	};
	fold(facts.pss, None(), \ac, f -> switch (ac) {
		Some(__): ac;
		None(): {
			fn = f.second;
			lend = ruFwdSpan(fn, 1);
			fa = subrange(fn, 1, lend - 1);
			fb = subrange(fn, lend, length(fn) - lend);
			if (fa == a && fb == b) Some(f.first)
			else if (fa == a) {
				// (a⊊fb) + fb⊆b → psssstr
				maybeMap(ruFwdSsClose(ids, facts.ss, fb, b, stcl, 8, guard), \ps -> {
					ssE = ruFwdMkRule(ids.wss, ids.wff, [RuExp(fb, -1), RuExp(b, -1)]);
					anteE = ruFwdMkRule(ids.wa, ids.wff, [RuExp(fn, -1), ssE]);
					pAnd = RuProofStep(pairId, [f.first, ps], RuStmt(stcl, [wrap(anteE)], -1));
					applyImp(pAnd, anteE, s2id_("psssstr"));
				});
			} else if (fb == b) {
				// a⊆fa + (fa⊊b) → sspsstr
				maybeMap(ruFwdSsClose(ids, facts.ss, a, fa, stcl, 8, guard), \ps -> {
					ssE = ruFwdMkRule(ids.wss, ids.wff, [RuExp(a, -1), RuExp(fa, -1)]);
					anteE = ruFwdMkRule(ids.wa, ids.wff, [ssE, RuExp(fn, -1)]);
					pAnd = RuProofStep(pairId, [ps, f.first], RuStmt(stcl, [wrap(anteE)], -1));
					applyImp(pAnd, anteE, s2id_("sspsstr"));
				});
			} else None();
		}
	});
}

// RESIDUE → ∅ (the ssdif0-route residue discharge): flatten the stalled normal
// form of X∖Y over its ∪-spine; each ∖-piece A∖B collapses to ∅ once the
// ⊆-closure decides A⊆B (mpbi + ssdif0); the spine re-assembles by uneq12i +
// un0 (∅∪∅ = ∅) + eqtri.
ruFwdResidue0(ids : RuFwdInstIds, eids : RuFwdEqIds, ssPrems : [Pair<RuProofTree, [RuExpNode]>], t : [RuExpNode], stcl : int, guard : Maybe<RuExp>) -> Maybe<RuProofTree> {
	wceq = s2id("wceq");
	wrap = \e : RuExp -> switch (guard) { None(): e; Some(g): ruFwdMkRule(ids.wi, ids.wff, [g, e]); };
	lift = \asId : int, e : RuExp -> {
		bare = RuProofStep(asId, [], RuStmt(stcl, [e], -1));
		switch (guard) {
			None(): bare;
			Some(__): RuProofStep(s2id_("a1i"), [bare], RuStmt(stcl, [wrap(e)], -1));
		}
	};
	uneq12i = switch (guard) { None(): s2id_("uneq12i"); Some(__): s2id_("uneq12d"); };
	eqtri = switch (guard) { None(): eids.eqtri; Some(__): s2id_("eqtrd"); };
	mpbi = switch (guard) { None(): s2id_("mpbi"); Some(__): s2id_("mpbid"); };
	empty = [ruMakeRuleNode(s2id("c0"), ids.cls, 0, 0)];
	eqT0 = ruFwdMkRule(wceq, ids.wff, [RuExp(t, -1), RuExp(empty, -1)]);
	switch (t[0]) {
		RuVar(__,__): None();
		RuRuleNode(idT, __): {
			hid = ruIdType2Id(idT);
			if (length(t) < 3) None()
			else {
				lend = ruFwdSpan(t, 1);
				l = subrange(t, 1, lend - 1);
				r = subrange(t, lend, length(t) - lend);
				if (hid == ids.cun) {
					maybeBind(ruFwdResidue0(ids, eids, ssPrems, l, stcl, guard), \pl ->
						maybeMap(ruFwdResidue0(ids, eids, ssPrems, r, stcl, guard), \pr -> {
							e00 = ruFwdMkRule(ids.cun, ids.cls, [RuExp(empty, -1), RuExp(empty, -1)]);
							p1 = RuProofStep(uneq12i, [pl, pr],
								RuStmt(stcl, [wrap(ruFwdMkRule(wceq, ids.wff, [RuExp(t, -1), e00]))], -1));
							p2 = lift(s2id_("un0"), ruFwdMkRule(wceq, ids.wff, [e00, RuExp(empty, -1)]));
							RuProofStep(eqtri, [p1, p2], RuStmt(stcl, [wrap(eqT0)], -1));
						}));
				} else if (hid == ids.cdif) {
					maybeMap(ruFwdSsClose(ids, ssPrems, l, r, stcl, 8, guard), \pss -> {
						ssd = lift(s2id_("ssdif0"),
							ruFwdMkRule(ids.wb, ids.wff, [ruFwdMkRule(ids.wss, ids.wff, [RuExp(l, -1), RuExp(r, -1)]), eqT0]));
						RuProofStep(mpbi, [pss, ssd], RuStmt(stcl, [wrap(eqT0)], -1));
					});
				} else None();
			}
		}
	}
}

// ⊢ X = Y (BARE) from coinciding normal forms: the eqtri/eqcomi assembly of
// the two normalization chains. None = the normal forms differ.
ruFwdEqFromNfs(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], xs : [RuExpNode], ys : [RuExpNode], stcl : int, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	wceq = s2id("wceq");
	nx = ruFwdNormalize(ids, eids, rules, xs, stcl, prover_env.math, prover_env.env);
	ny = ruFwdNormalize(ids, eids, rules, ys, stcl, prover_env.math, prover_env.env);
	if (nx.first != ny.first) None() else {
		eqE = ruFwdMkRule(wceq, ids.wff, [RuExp(xs, -1), RuExp(ys, -1)]);
		Some(switch (nx.second) {
			None(): switch (ny.second) {
				None(): RuProofStep(eids.eqid, [], RuStmt(stcl, [eqE], -1));
				Some(py): RuProofStep(eids.eqcomi, [py], RuStmt(stcl, [eqE], -1));
			}
			Some(px): switch (ny.second) {
				None(): px;
				Some(py): {
					flipped = RuProofStep(eids.eqcomi, [py],
						RuStmt(stcl, [ruFwdMkRule(wceq, ids.wff, [RuExp(nx.first, -1), RuExp(ys, -1)])], -1));
					RuProofStep(eids.eqtri, [px, flipped], RuStmt(stcl, [eqE], -1));
				}
			}
		});
	}
}

// T = ∅ UNDER A GUARD ψ (the disjointness channel, t66/t70/t77/t81/t84-class):
// (i) T normalizes to ∅ outright; (ii) nf(T) coincides with an eq0-fact's term
// (bare chain + eqtrd); (iii) the ∅-COVER: T ⊆ F1∪…∪Fk over ALL eq0-facts by
// the ssdif0 difference-collapse (bare nf, residue ⊆-closure under the guard),
// the union collapses to ∅ by the fact proofs (uneq12d + un0 spine), then
// ss0 ((A⊆∅)→(A=∅)). Irrelevant facts in the cover are harmless: the
// difference distributes (difundi) and the dead factors vanish structurally.
ruFwdEq0Close(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], facts : RuFwdClsFacts,
	psi : RuExp, t : [RuExpNode], stcl : int, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	wceq = s2id("wceq");
	mkImp = \x, y -> ruFwdMkRule(ids.wi, ids.wff, [x, y]);
	a1iLift = \p : RuProofTree, e : RuExp -> RuProofStep(s2id_("a1i"), [p], RuStmt(stcl, [mkImp(psi, e)], -1));
	empty = [ruMakeRuleNode(s2id("c0"), ids.cls, 0, 0)];
	eqT0 = ruFwdMkRule(wceq, ids.wff, [RuExp(t, -1), RuExp(empty, -1)]);
	nd = ruFwdNormalize(ids, eids, rules, t, stcl, prover_env.math, prover_env.env);
	if (nd.first == empty) maybeMap(nd.second, \p -> a1iLift(p, eqT0))
	else {
	direct = fold(facts.eq0, None(), \ac, f -> switch (ac) {
		Some(__): ac;
		None(): maybeMap(ruFwdEqFromNfs(ids, eids, rules, t, f.second, stcl, prover_env), \pTF ->
			RuProofStep(s2id_("eqtrd"), [
				a1iLift(pTF, ruFwdMkRule(wceq, ids.wff, [RuExp(t, -1), RuExp(f.second, -1)])),
				f.first], RuStmt(stcl, [mkImp(psi, eqT0)], -1)));
	});
	switch (direct) { Some(__): direct; None(): {
	if (facts.eq0 == []) None() else {
		// the ∅-cover: assemble U and ψ→(U=∅) left-nested over the pool
		pU0 = fold(tail(facts.eq0), Pair((facts.eq0[0]).first, (facts.eq0[0]).second), \acP, f -> {
			newU = (ruFwdMkRule(ids.cun, ids.cls, [RuExp(acP.second, -1), RuExp(f.second, -1)])).nodes;
			e00 = ruFwdMkRule(ids.cun, ids.cls, [RuExp(empty, -1), RuExp(empty, -1)]);
			p1 = RuProofStep(s2id_("uneq12d"), [acP.first, f.first],
				RuStmt(stcl, [mkImp(psi, ruFwdMkRule(wceq, ids.wff, [RuExp(newU, -1), e00]))], -1));
			p2 = a1iLift(RuProofStep(s2id_("un0"), [],
				RuStmt(stcl, [ruFwdMkRule(wceq, ids.wff, [e00, RuExp(empty, -1)])], -1)),
				ruFwdMkRule(wceq, ids.wff, [e00, RuExp(empty, -1)]));
			Pair(RuProofStep(s2id_("eqtrd"), [p1, p2],
				RuStmt(stcl, [mkImp(psi, ruFwdMkRule(wceq, ids.wff, [RuExp(newU, -1), RuExp(empty, -1)]))], -1)), newU);
		});
		u = pU0.second;
		diff = ruFwdMkRule(ids.cdif, ids.cls, [RuExp(t, -1), RuExp(u, -1)]);
		nd2 = ruFwdNormalize(ids, eids, rules, diff.nodes, stcl, prover_env.math, prover_env.env);
		eqD0 = ruFwdMkRule(wceq, ids.wff, [diff, RuExp(empty, -1)]);
		mD0 = if (nd2.first == empty) maybeMap(nd2.second, \p -> a1iLift(p, eqD0))
			else maybeMap(ruFwdResidue0(ids, eids, facts.ss, nd2.first, stcl, Some(psi)), \p0 ->
				switch (nd2.second) {
					None(): p0;
					Some(pd): RuProofStep(s2id_("eqtrd"), [
						a1iLift(pd, ruFwdMkRule(wceq, ids.wff, [diff, RuExp(nd2.first, -1)])),
						p0], RuStmt(stcl, [mkImp(psi, eqD0)], -1));
				});
		maybeMap(mD0, \pD0 -> {
			ssTU = ruFwdMkRule(ids.wss, ids.wff, [RuExp(t, -1), RuExp(u, -1)]);
			bi = ruFwdMkRule(ids.wb, ids.wff, [ssTU, eqD0]);
			pTU = RuProofStep(s2id_("mpbird"), [pD0,
				a1iLift(RuProofStep(s2id_("ssdif0"), [], RuStmt(stcl, [bi], -1)), bi)],
				RuStmt(stcl, [mkImp(psi, ssTU)], -1));
			ssT0 = ruFwdMkRule(ids.wss, ids.wff, [RuExp(t, -1), RuExp(empty, -1)]);
			pT0 = RuProofStep(s2id_("sseqtrd"), [pTU, pU0.first], RuStmt(stcl, [mkImp(psi, ssT0)], -1));
			RuProofStep(s2id_("syl"), [pT0,
				RuProofStep(s2id_("ss0"), [], RuStmt(stcl, [mkImp(ssT0, eqT0)], -1))],
				RuStmt(stcl, [mkImp(psi, eqT0)], -1));
		});
	}}}}
}

// ψ → X for a single positive literal X — the clash driver's positive side.
// Dispatch on the head: ∧ recurses (jca), ⊊ via the ⊊-closure, = via the
// ∅-channels / antisymmetry, ⊆ via the guarded ⊆-closure, the bare relClose
// (a1i-lifted) and the deduction-form ssdif0 difference-collapse.
ruFwdLitClose(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], asses : RuIndex<RuAssertion>,
	facts : RuFwdClsFacts, bareFacts : RuFwdClsFacts, psi : RuExp, x : [RuExpNode], stcl : int, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	wpss = s2id("wpss");
	mkImp = \e1, e2 -> ruFwdMkRule(ids.wi, ids.wff, [e1, e2]);
	empty = [ruMakeRuleNode(s2id("c0"), ids.cls, 0, 0)];
	psiX = mkImp(psi, RuExp(x, -1));
	switch (x[0]) {
		RuVar(__,__): None();
		RuRuleNode(idT, __): {
			hid = ruIdType2Id(idT);
			if (length(x) < 3) None()
			else {
				lend = ruFwdSpan(x, 1);
				xa = subrange(x, 1, lend - 1);
				xb = subrange(x, lend, length(x) - lend);
				if (hid == ids.wa) {
					maybeBind(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, xa, stcl, prover_env), \p1 ->
						maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, xb, stcl, prover_env), \p2 ->
							RuProofStep(s2id_("jca"), [p1, p2], RuStmt(stcl, [psiX], -1))));
				} else if (hid == wpss) {
					ruFwdPssClose(ids, facts, xa, xb, stcl, Some(psi));
				} else if (hid == ids.wceq) {
					e0 = if (xb == empty) ruFwdEq0Close(ids, eids, rules, facts, psi, xa, stcl, prover_env)
						else if (xa == empty) maybeMap(ruFwdEq0Close(ids, eids, rules, facts, psi, xb, stcl, prover_env), \p ->
							RuProofStep(s2id_("eqcomd"), [p], RuStmt(stcl, [psiX], -1)))
						else None();
					switch (e0) { Some(__): e0; None(): ruFwdEqClose(ids, facts, xa, xb, stcl, Some(psi)); }
				} else if (hid == ids.wss) {
					switch (ruFwdSsClose(ids, facts.ss, xa, xb, stcl, 8, Some(psi))) {
						// (a) directly by the guarded ⊆-closure
						Some(pd): Some(pd);
						None(): switch (ruFwdRelClose(ids, eids, rules, asses, bareFacts, x, stcl, prover_env)) {
							// (b) a ring tautology / closes on the task premises alone
							Some(pb): Some(RuProofStep(s2id_("a1i"), [pb], RuStmt(stcl, [psiX], -1)));
							None(): {
								// (c) ssdif0 in deduction form: nf(X∖Y) bare, the residue
								// discharged under the guard, transported back by mpbird
								diff = ruFwdMkRule(ids.cdif, ids.cls, [RuExp(xa, -1), RuExp(xb, -1)]);
								nd = ruFwdNormalize(ids, eids, rules, diff.nodes, stcl, prover_env.math, prover_env.env);
								eq0 = ruFwdMkRule(s2id("wceq"), ids.wff, [diff, RuExp(empty, -1)]);
								mEq0 = if (nd.first == empty) maybeMap(nd.second, \pd ->
									RuProofStep(s2id_("a1i"), [pd], RuStmt(stcl, [mkImp(psi, eq0)], -1)))
								else maybeMap(ruFwdResidue0(ids, eids, facts.ss, nd.first, stcl, Some(psi)), \p0 ->
									switch (nd.second) {
										None(): p0; // X∖Y == the residue syntactically
										Some(pd): RuProofStep(s2id_("eqtrd"), [
											RuProofStep(s2id_("a1i"), [pd], RuStmt(stcl,
												[mkImp(psi, ruFwdMkRule(s2id("wceq"), ids.wff, [diff, RuExp(nd.first, -1)]))], -1)),
											p0], RuStmt(stcl, [mkImp(psi, eq0)], -1));
									});
								maybeMap(mEq0, \pd0 -> {
									bi = ruFwdMkRule(ids.wb, ids.wff, [RuExp(x, -1), eq0]);
									ssd = RuProofStep(s2id_("a1i"),
										[RuProofStep(s2id_("ssdif0"), [], RuStmt(stcl, [bi], -1))],
										RuStmt(stcl, [mkImp(psi, bi)], -1));
									RuProofStep(s2id_("mpbird"), [pd0, ssd], RuStmt(stcl, [psiX], -1));
								});
							}
						}
					}
				} else None();
			}
		}
	}
}

// A CLAUSE-SHAPED GOAL, closed deterministically: ¬ψ (ψ an ∧-tree of literals
// with at least one refutable one) by pm2.65i of ψ→X against the ψ→¬X
// projection; an ∧ of clauses recurses per conjunct (pm3.2i). t97-class
// (⊆-arithmetic), t57/t62/t105 (⊊-unfolds + antisymmetry), t66/t70/t77-class
// (disjointness) all land here.
ruFwdClauseClose(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], asses : RuIndex<RuAssertion>,
	bareFacts : RuFwdClsFacts, premLeaves : [Pair<RuProofTree, [RuExpNode]>], body : [RuExpNode], stcl : int, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	switch (body[0]) {
		RuVar(__,__): None();
		RuRuleNode(idT, __): {
			hid = ruIdType2Id(idT);
			if (hid == ids.wa && length(body) >= 3) {
				lend = ruFwdSpan(body, 1);
				l = subrange(body, 1, lend - 1);
				r = subrange(body, lend, length(body) - lend);
				maybeBind(ruFwdClauseClose(ids, eids, rules, asses, bareFacts, premLeaves, l, stcl, prover_env), \pl ->
					maybeMap(ruFwdClauseClose(ids, eids, rules, asses, bareFacts, premLeaves, r, stcl, prover_env), \pr ->
						RuProofStep(s2id_("pm3.2i"), [pl, pr], RuStmt(stcl, [RuExp(body, -1)], -1))));
			} else if (hid == ids.wn && length(body) >= 4) {
				inner = subrange(body, 1, length(body) - 1);
				psi = RuExp(inner, -1);
				mkImp = \e1, e2 -> ruFwdMkRule(ids.wi, ids.wff, [e1, e2]);
				conjs = ruFwdConjProjections(ids, psi, inner, None(), stcl);
				lifted : [Pair<RuProofTree, [RuExpNode]>] = map(premLeaves, \pr -> Pair(
					RuProofStep(s2id_("a1i"), [pr.first],
						RuStmt(stcl, [mkImp(psi, RuExp(pr.second, -1))], -1)),
					pr.second));
				facts = ruFwdBuildClsFacts(ids, concat(lifted, conjs), stcl, Some(psi));
				fold(facts.neg, None(), \acc, ng -> switch (acc) {
					Some(__): acc;
					None(): maybeMap(
						ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, ng.second, stcl, prover_env),
						\pg -> RuProofStep(s2id_("pm2.65i"), [pg, ng.first], RuStmt(stcl, [RuExp(body, -1)], -1)));
				});
			} else None();
		}
	}
}

// CONJUNCT PROJECTIONS of a guard ψ: walk ψ's ∧-tree; every leaf conjunct c
// gets a proof of ψ→c (simpl/simpr instances composed by syl). `path` proves
// ψ→cur (None at the root where cur == ψ).
ruFwdConjProjections(ids : RuFwdInstIds, psi : RuExp, cur : [RuExpNode], path : Maybe<RuProofTree>, stcl : int) -> [Pair<RuProofTree, [RuExpNode]>] {
	mkImp = \x, y -> ruFwdMkRule(ids.wi, ids.wff, [x, y]);
	isWa = switch (cur[0]) {
		RuVar(__,__): false;
		RuRuleNode(idT, __): ruIdType2Id(idT) == ids.wa;
	};
	if (isWa && length(cur) >= 3) {
		lend = ruFwdSpan(cur, 1);
		l = subrange(cur, 1, lend - 1);
		r = subrange(cur, lend, length(cur) - lend);
		proj = \part : [RuExpNode], projId : int -> {
			step0 = RuProofStep(projId, [], RuStmt(stcl, [mkImp(RuExp(cur, -1), RuExp(part, -1))], -1));
			switch (path) {
				None(): step0;
				Some(pp): RuProofStep(s2id_("syl"), [pp, step0], RuStmt(stcl, [mkImp(psi, RuExp(part, -1))], -1));
			}
		};
		concat(
			ruFwdConjProjections(ids, psi, l, Some(proj(l, s2id_("simpl"))), stcl),
			ruFwdConjProjections(ids, psi, r, Some(proj(r, s2id_("simpr"))), stcl)
		);
	} else {
		p = switch (path) {
			None(): RuProofStep(s2id_("id"), [], RuStmt(stcl, [mkImp(psi, psi)], -1));
			Some(pp): pp;
		};
		[Pair(p, cur)];
	}
}

ruSeedEqNormalize(prover_env : RuProverEnv, c_task : RuConstAny<RuProverTask>, fwd : RuProverForward, asses : RuIndex<RuAssertion>) -> RuProverForward {
	ids  = ruFwdInstIds();
	eids = ruFwdEqIds();
	stcl = c_task.const.goal.stmt.class;
	goal = ruExp(c_task.const.goal.stmt.exps[0]);
	wceq = s2id("wceq"); wff = tp2id_("wff");
	stripped = ruFwdStripWalPrefix(ids, goal.nodes, []);
	body = stripped.second;
	// re-add the stripped ∀-prefix (innermost quantifier first) and seed the goal fact
	register = \proof0 : RuProofTree -> {
		proof = fold(reverseA(stripped.first), proof0, \pr, qexp ->
			RuProofStep(eids.axgen, [pr], RuStmt(stcl, [RuExp(qexp, -1)], -1)));
		key = goal.nodes;
		if (containsSet(fwd.seen, key)) fwd else {
			sf = RuProverExp(-1, makeVector(4), RuStmt(stcl, [goal], -1), makeVector(0), ruNoProverProp);
			pushVector(sf.proofs, RuProverProofForward(sf, RuStmt(stcl, [goal], -1), ruEmptySubst, proof));
			(ruFwdRegister(fwd, [], sf, goal, key)).first;
		}
	};
	premLeaves = ruFwdSsPremises(ids, c_task.const.premises, stcl);
	bareFacts = ruFwdBuildClsFacts(ids, premLeaves, stcl, None());
	mkRules = \ -> {
		cands = filter(ruIndexValues(asses), \a ->
			length(a.infer.hyps) == 0 && {
				cn = (ruExp(a.infer.prop.exps[0])).nodes;
				switch (cn[0]) {
					RuVar(__,__): false;
					RuRuleNode(idT2, __): ruIdType2Id(idT2) == ids.wceq;
				}
			});
		idents = ruFwdCloseIdents(ids, ruFwdClassOps(ids, goal.nodes), cands);
		rs0 = ruFwdEqRulesChecked(ids, eids, idents, stcl);
		// PREMISE ⊆-RULES: each ⊆-premise A⊆B (∧-flattened — an unss-style
		// conjunction premise contributes each ⊆-conjunct with its simpli/simpri
		// chain) becomes the GROUND rewrite rule A∖B → ∅ (proof = mpbi(prem,
		// ssdif0) — ssdif0: (A⊆B) ↔ ((A∖B)=∅)). This is ⊆-arithmetic under
		// premises done DETERMINISTICALLY: the ssdif0-close's residue (e.g.
		// t117's (x67∩x69)∖x70 under x67⊆x70) transposes until the premise
		// difference surfaces and collapses.
		// Shrinking ground rules — termination/soundness untouched.
		empty0 = [ruMakeRuleNode(s2id("c0"), ids.cls, 0, 0)];
		premRules = map(bareFacts.ss, \prem -> {
			pe = prem.second;
			pend = ruFwdSpan(pe, 1);
			pa = subrange(pe, 1, pend - 1);
			pb = subrange(pe, pend, length(pe) - pend);
			pdiff = ruFwdMkRule(eids.cdif, ids.cls, [RuExp(pa, -1), RuExp(pb, -1)]);
			RuFwdEqRule(pdiff.nodes, empty0, false, false, true,  false,
				\il, ir, sc -> {
					eq0p = ruFwdMkRule(s2id("wceq"), tp2id_("wff"), [il, ir]);
					ssdif0Stp = RuProofStep(s2id_("ssdif0"), [],
						RuStmt(sc, [ruFwdMkRule(ids.wb, ids.wff, [RuExp(pe, -1), eq0p])], -1));
					RuProofStep(s2id_("mpbi"), [prem.first, ssdif0Stp], RuStmt(sc, [eq0p], -1));
				});
		});
		rs = concat(rs0, premRules);
		if (prover_env.env.conf.verbose >= 5) {
			iter(rs, \r -> prover_env.env.out.println("  eqrule"
				+ (if (r.comm) " comm" else if (r.elim) " elim" else " grow") + ": "
				+ ruSafeExp2s(RuExp(r.lhs, -1), prover_env.math.decls.lang) + "  ->  "
				+ ruSafeExp2s(RuExp(r.rhs, -1), prover_env.math.decls.lang)));
		} else {};
		rs;
	};
	switch (body[0]) {
		RuVar(__,__): fwd;
		RuRuleNode(idT, __): {
			hid = ruIdType2Id(idT);
			if (hid == ids.wn && length(body) >= 4) {
				// MIZAR CLAUSE DISCHARGE: the ∀-stripped body is a clause ¬ψ (or an
				// ∧ of clauses) whose "premises" live INSIDE the negated conjunction.
				// ruFwdClauseClose refutes ψ literal against literal: pm2.65i of the
				// deduction-form channels (⊆-closure, ⊊-closure, antisymmetry, the
				// eq0 ∅-cover) against the ψ→¬X projections. Normalization stays
				// BARE (structural identities are 0-hyp; a1i lifts their chains).
				rules = mkRules();
				switch (ruFwdClauseClose(ids, eids, rules, asses, bareFacts, premLeaves, body, stcl, prover_env)) {
					None(): {
						if (prover_env.env.conf.verbose >= 4) {
							prover_env.env.out.println("  clause STALL: no literal discharged under "
								+ ruSafeExp2s(RuExp(body, -1), prover_env.math.decls.lang));
						} else {};
						fwd;
					}
					Some(p): {
						if (prover_env.env.conf.verbose >= 4) {
							prover_env.env.out.println("  clause DISCHARGED (pm2.65i of the d-form closures)");
						} else {};
						register(p);
					}
				}
			}
			// binary heads only — a 0-arity goal head (e.g. ⊤, t115) has no arg
			// slices and ruFwdSpan(body, 1) would index past the array
			else if (hid != ids.wceq && hid != ids.wss && hid != ids.wcel && hid != ids.wb && hid != ids.wa && hid != ids.wi) fwd
			else if (length(body) < 3) fwd
			else {
			lend = ruFwdSpan(body, 1);
			xs = subrange(body, 1, lend - 1);
			ys = subrange(body, lend, length(body) - lend);
			if (hid == ids.wceq) {
				rules = mkRules();
				nx = ruFwdNormalize(ids, eids, rules, xs, stcl, prover_env.math, prover_env.env);
				ny = ruFwdNormalize(ids, eids, rules, ys, stcl, prover_env.math, prover_env.env);
				if (prover_env.env.conf.verbose >= 4) {
					switch (nx.second) { None(): {}; Some(t): ruFwdEqDump("X", t, 0, prover_env); }
					switch (ny.second) { None(): {}; Some(t): ruFwdEqDump("Y", t, 0, prover_env); }
					if (nx.first != ny.first) {
						prover_env.env.out.println("  eqnorm MISMATCH: nfX(" + i2s(length(nx.first)) + ")="
							+ ruSafeExp2s(RuExp(nx.first, -1), prover_env.math.decls.lang)
							+ "  nfY(" + i2s(length(ny.first)) + ")="
							+ ruSafeExp2s(RuExp(ny.first, -1), prover_env.math.decls.lang));
					} else {};
				} else {};
				if (nx.first != ny.first) fwd else {
					if (prover_env.env.conf.verbose >= 4) {
						prover_env.env.out.println("  eqnorm MATCH: seeding goal (seen="
							+ b2s(containsSet(fwd.seen, goal.nodes)) + ")");
					} else {};
					bodyExp = RuExp(body, -1);
					// assemble  X = Y  from  X = N (nx), Y = N (ny)
					proof0 = switch (nx.second) {
						None(): switch (ny.second) {
							None(): RuProofStep(eids.eqid, [], RuStmt(stcl, [bodyExp], -1)); // X == Y syntactically
							Some(py): RuProofStep(eids.eqcomi, [py], RuStmt(stcl, [bodyExp], -1)); // X = N, Y -> N flipped
						}
						Some(px): switch (ny.second) {
							None(): px; // N == Y already
							Some(py): {
								flipped = RuProofStep(eids.eqcomi, [py],
									RuStmt(stcl, [ruFwdMkRule(wceq, wff, [RuExp(nx.first, -1), RuExp(ys, -1)])], -1));
								RuProofStep(eids.eqtri, [px, flipped], RuStmt(stcl, [bodyExp], -1));
							}
						}
					};
					register(proof0);
				}
			} else if (hid == ids.wb || hid == ids.wi) {
				// EXTENSIONALITY WITNESS (the Mizar equality theorems carry the step
				// ∀x (x∈A ↔ x∈B) beside A=B): if both sides are memberships of the
				// SAME element, normalize the two classes — coinciding normal forms
				// give A=B by the eqtri chains, and the biconditional follows by
				// eleq2 ((A=B) → (C∈A ↔ C∈B)) + ax-mp, ∀-wrapped by ax-gen.
				// The ONE-DIRECTIONAL form ∀x (x∈A → x∈B) (t48/t52-class: the
				// membership-implication witness of the same equality) closes as
				// the biconditional's biimpi.
				lend2 = ruFwdSpan(body, 1);
				l = subrange(body, 1, lend2 - 1);
				r = subrange(body, lend2, length(body) - lend2);
				lIsCel = length(l) >= 3 && (switch (l[0]) { RuVar(__,__): false; RuRuleNode(idT2, __): ruIdType2Id(idT2) == ids.wcel; });
				rIsCel = length(r) >= 3 && (switch (r[0]) { RuVar(__,__): false; RuRuleNode(idT3, __): ruIdType2Id(idT3) == ids.wcel; });
				implClause = \ -> {
					// IMPLICATION GOAL φ→χ, φ an ∧-tree of literals (t81-class:
					// (x5∩(x7∖x9))=∅ → (x7∩(x5∖x9))=∅): guard φ, close χ by the
					// literal channels — the result IS the goal implication.
					if (hid != ids.wi) fwd else {
						rules2 = mkRules();
						psiL = RuExp(l, -1);
						mkImp2 = \e1, e2 -> ruFwdMkRule(ids.wi, ids.wff, [e1, e2]);
						conjs2 = ruFwdConjProjections(ids, psiL, l, None(), stcl);
						lifted2 : [Pair<RuProofTree, [RuExpNode]>] = map(premLeaves, \pr -> Pair(
							RuProofStep(s2id_("a1i"), [pr.first],
								RuStmt(stcl, [mkImp2(psiL, RuExp(pr.second, -1))], -1)),
							pr.second));
						facts2 = ruFwdBuildClsFacts(ids, concat(lifted2, conjs2), stcl, Some(psiL));
						switch (ruFwdLitClose(ids, eids, rules2, asses, facts2, bareFacts, psiL, r, stcl, prover_env)) {
							None(): fwd;
							Some(p): register(p);
						}
					}
				};
				if (!lIsCel || !rIsCel) implClause() else {
					elEnd = ruFwdSpan(l, 1);
					el = subrange(l, 1, elEnd - 1);
					aCls = subrange(l, elEnd, length(l) - elEnd);
					elEnd2 = ruFwdSpan(r, 1);
					el2 = subrange(r, 1, elEnd2 - 1);
					bCls = subrange(r, elEnd2, length(r) - elEnd2);
					if (el != el2) implClause() else {
						rules = mkRules();
						na = ruFwdNormalize(ids, eids, rules, aCls, stcl, prover_env.math, prover_env.env);
						nb = ruFwdNormalize(ids, eids, rules, bCls, stcl, prover_env.math, prover_env.env);
						if (na.first != nb.first) implClause() else {
							eqAB = ruFwdMkRule(wceq, wff, [RuExp(aCls, -1), RuExp(bCls, -1)]);
							pEq = switch (na.second) {
								None(): switch (nb.second) {
									None(): RuProofStep(eids.eqid, [], RuStmt(stcl, [eqAB], -1));
									Some(pb): RuProofStep(eids.eqcomi, [pb], RuStmt(stcl, [eqAB], -1));
								}
								Some(pa): switch (nb.second) {
									None(): pa;
									Some(pb): {
										flip = RuProofStep(eids.eqcomi, [pb],
											RuStmt(stcl, [ruFwdMkRule(wceq, wff, [RuExp(na.first, -1), RuExp(bCls, -1)])], -1));
										RuProofStep(eids.eqtri, [pa, flip], RuStmt(stcl, [eqAB], -1));
									}
								}
							};
							bodyExp = RuExp(body, -1);
							biExp = if (hid == ids.wb) bodyExp
								else ruFwdMkRule(ids.wb, ids.wff, [RuExp(l, -1), RuExp(r, -1)]);
							lemStep = RuProofStep(ids.eleq2, [], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [eqAB, biExp])], -1));
							pBi = RuProofStep(ids.axmp, [pEq, lemStep], RuStmt(stcl, [biExp], -1));
							proof0 = if (hid == ids.wb) pBi
								else RuProofStep(s2id_("biimpi"), [pBi], RuStmt(stcl, [bodyExp], -1));
							register(proof0);
						}
					}
				}
			} else if (hid == ids.wss || hid == ids.wcel || hid == ids.wa) {
				rules = mkRules();
				switch (ruFwdRelClose(ids, eids, rules, asses, bareFacts, body, stcl, prover_env)) {
					None(): {
						// an ∧ of CLAUSES (t66-class: the two directions of a
						// biconditional Mizar statement) — per-conjunct pm2.65i
						if (hid != ids.wa) fwd
						else switch (ruFwdClauseClose(ids, eids, rules, asses, bareFacts, premLeaves, body, stcl, prover_env)) {
							None(): fwd;
							Some(p): register(p);
						}
					}
					Some(proof0): register(proof0);
				}
			} else fwd;
			}
		}
	}
}

// REL-NORMALIZE closer: X R Y (R ∈ {⊆, ∈}) — normalize both args by the same
// oriented identity base; if a 0-hyp R-headed schema in scope MATCHES the
// normalized atom (e.g. ssun1 ⊢ A⊆(A∪B); ssid covers NX == NY), close and
// TRANSPORT back through the side equalities:
//   schema:  ⊢ NX R NY
//   sseq1/eleq1 + ax-mp(X=NX) + mpbir:  ⊢ X R NY
//   sseq2/eleq2 + ax-mp(Y=NY) + mpbir:  ⊢ X R Y
// A CONJUNCTION of relations closes recursively per conjunct + pm3.2i assembly
// (the t53-class ∧-of-⊆ steps — e.g. A∖(B∪C)⊆A∖B ∧ A∖(B∪C)⊆A∖C, each conjunct
// difss on the difun1 normal form).
ruFwdRelClose(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], asses : RuIndex<RuAssertion>,
	facts : RuFwdClsFacts, body : [RuExpNode], stcl : int, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	wceq = s2id("wceq"); wff = tp2id_("wff");
	switch (body[0]) {
		RuVar(__,__): None();
		RuRuleNode(idT, __): {
			hid = ruIdType2Id(idT);
			if (length(body) < 3) None()
			else {
				lend = ruFwdSpan(body, 1);
				xs = subrange(body, 1, lend - 1);
				ys = subrange(body, lend, length(body) - lend);
				if (hid == ids.wa) {
					perConj = maybeBind(ruFwdRelClose(ids, eids, rules, asses, facts, xs, stcl, prover_env), \pl ->
						maybeMap(ruFwdRelClose(ids, eids, rules, asses, facts, ys, stcl, prover_env), \pr ->
							RuProofStep(s2id_("pm3.2i"), [pl, pr], RuStmt(stcl, [RuExp(body, -1)], -1))));
					switch (perConj) { Some(__): perConj; None(): {
						// dfpss2-RHS RECOGNIZER (t58-class): a goal (A⊆B) ∧ ¬(A=B) IS
						// the unfolded A⊊B — close by the ⊊-closure + mpbi(dfpss2)
						xsIsSs = length(xs) >= 3 && switch (xs[0]) {
							RuVar(__,__): false;
							RuRuleNode(idT5, __): ruIdType2Id(idT5) == ids.wss;
						};
						ysIsNeq = length(ys) >= 4 && (switch (ys[0]) {
							RuVar(__,__): false;
							RuRuleNode(idT6, __): ruIdType2Id(idT6) == ids.wn;
						}) && (switch (ys[1]) {
							RuVar(__,__): false;
							RuRuleNode(idT7, __): ruIdType2Id(idT7) == ids.wceq;
						});
						if (!xsIsSs || !ysIsNeq) None() else {
							slend = ruFwdSpan(xs, 1);
							sa = subrange(xs, 1, slend - 1);
							sb = subrange(xs, slend, length(xs) - slend);
							eqNodes = subrange(ys, 1, length(ys) - 1);
							elend = ruFwdSpan(eqNodes, 1);
							ea = subrange(eqNodes, 1, elend - 1);
							eb = subrange(eqNodes, elend, length(eqNodes) - elend);
							if (sa != ea || sb != eb) None()
							else maybeMap(ruFwdPssClose(ids, facts, sa, sb, stcl, None()), \pp -> {
								pssE = ruFwdMkRule(s2id("wpss"), ids.wff, [RuExp(sa, -1), RuExp(sb, -1)]);
								bi = ruFwdMkRule(ids.wb, ids.wff, [pssE, RuExp(body, -1)]);
								RuProofStep(s2id_("mpbi"), [pp,
									RuProofStep(s2id_("dfpss2"), [], RuStmt(stcl, [bi], -1))],
									RuStmt(stcl, [RuExp(body, -1)], -1));
							});
						}
					}}
				} else if (hid != ids.wss && hid != ids.wcel) None()
				else {
					nx = ruFwdNormalize(ids, eids, rules, xs, stcl, prover_env.math, prover_env.env);
					ny = ruFwdNormalize(ids, eids, rules, ys, stcl, prover_env.math, prover_env.env);
					nfBody = ruFwdMkRule(hid, ids.wff, [RuExp(nx.first, -1), RuExp(ny.first, -1)]);
					schema = fold(ruIndexValues(asses), None(), \found, a ->
						switch (found) {
							Some(__): found;
							None(): {
								if (length(a.infer.hyps) != 0) None() else {
									concl = ruExp(a.infer.prop.exps[0]);
									hOk = switch (concl.nodes[0]) {
										RuVar(__,__): false;
										RuRuleNode(idT2, __): ruIdType2Id(idT2) == hid;
									};
									if (!hOk) None()
									else switch (ruMatchExp(nfBody, concl, prover_env.math, prover_env.env)) {
										None(): None();
										Some(__): Some(a);
									}
								}
							}
						});
					if (schema == None() && hid == ids.wss) {
						// ⊆ VIA THE DIFFERENCE (ssdif0: (A⊆B) ↔ ((A∖B)=∅)): no schema
						// matched the normalized atom — normalize X∖Y itself; reaching
						// ∅ closes the ⊆ by mpbir. This turns EVERY ⊆-tautology of the
						// ring into eq-normalize's domain (t117-class: the case-split
						// (A∖C) ⊆ (A∖B)∪(A∩(B∖C)) is a difference-collapse, no ∈-cases).
						diff = ruFwdMkRule(eids.cdif, ids.cls, [RuExp(xs, -1), RuExp(ys, -1)]);
						nd = ruFwdNormalize(ids, eids, rules, diff.nodes, stcl, prover_env.math, prover_env.env);
						empty = [ruMakeRuleNode(s2id("c0"), ids.cls, 0, 0)];
						eq0 = ruFwdMkRule(wceq, wff, [diff, RuExp(empty, -1)]);
						// proof of (X∖Y) = ∅: either the nf IS ∅, or the ⊆-CLOSURE
						// RESIDUE DISCHARGE proves every residual ∪-piece P∖Q empty
						// (the rewriting-blocked cases: t117's (x67∩x69)∖x70 under
						// x67⊆x70 — the ∩/∖ transposition is order/poly-blocked, but
						// (x67∩x69)⊆x70 falls to inss1 + the premise + sstri).
						mEq0 = if (nd.first == empty) {
							if (prover_env.env.conf.verbose >= 4) {
								prover_env.env.out.println("  relnorm: X∖Y collapses to ∅ (ssdif0 close)");
							} else {};
							nd.second; // None = diff not literally ∅-headed — unreachable
						} else {
							switch (ruFwdResidue0(ids, eids, facts.ss, nd.first, stcl, None())) {
								None(): {
									if (prover_env.env.conf.verbose >= 4) {
										prover_env.env.out.println("  ssdif0 STALL: nf(X∖Y)="
											+ ruSafeExp2s(RuExp(nd.first, -1), prover_env.math.decls.lang));
									} else {};
									None();
								}
								Some(p0): {
									if (prover_env.env.conf.verbose >= 4) {
										prover_env.env.out.println("  relnorm: ssdif0 residue DISCHARGED by the ⊆-closure: nf(X∖Y)="
											+ ruSafeExp2s(RuExp(nd.first, -1), prover_env.math.decls.lang));
									} else {};
									Some(switch (nd.second) {
										None(): p0; // X∖Y == the residue syntactically
										Some(pd): RuProofStep(eids.eqtri, [pd, p0], RuStmt(stcl, [eq0], -1));
									});
								}
							}
						};
						maybeMap(mEq0, \pd -> {
							bodyExp0 = RuExp(body, -1);
							ssdif0Step = RuProofStep(s2id_("ssdif0"), [],
								RuStmt(stcl, [ruFwdMkRule(ids.wb, ids.wff, [bodyExp0, eq0])], -1));
							RuProofStep(eids.mpbir, [pd, ssdif0Step], RuStmt(stcl, [bodyExp0], -1));
						});
					} else
					maybeMap(schema, \a -> {
						if (prover_env.env.conf.verbose >= 4) {
							prover_env.env.out.println("  relnorm: schema=" + id2s(a.info.id)
								+ " nf=" + ruSafeExp2s(nfBody, prover_env.math.decls.lang));
						} else {};
						sStep = RuProofStep(a.info.id, [], RuStmt(stcl, [nfBody], -1));
						// left transport: ⊢ X R NY from ⊢ NX R NY
						xRny = ruFwdMkRule(hid, ids.wff, [RuExp(xs, -1), RuExp(ny.first, -1)]);
						step1 = switch (nx.second) {
							None(): sStep; // X == NX syntactically
							Some(px): {
								eqX = ruFwdMkRule(wceq, wff, [RuExp(xs, -1), RuExp(nx.first, -1)]);
								bi  = ruFwdMkRule(ids.wb, ids.wff, [xRny, nfBody]);
								lem = if (hid == ids.wss) ids.sseq1 else ids.eleq1;
								lemStep = RuProofStep(lem, [], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [eqX, bi])], -1));
								biStep = RuProofStep(ids.axmp, [px, lemStep], RuStmt(stcl, [bi], -1));
								RuProofStep(eids.mpbir, [sStep, biStep], RuStmt(stcl, [xRny], -1));
							}
						};
						// right transport: ⊢ X R Y from ⊢ X R NY
						bodyExp = RuExp(body, -1);
						switch (ny.second) {
							None(): step1; // Y == NY syntactically
							Some(py): {
								eqY = ruFwdMkRule(wceq, wff, [RuExp(ys, -1), RuExp(ny.first, -1)]);
								bi2 = ruFwdMkRule(ids.wb, ids.wff, [bodyExp, xRny]);
								lem2 = if (hid == ids.wss) ids.sseq2 else ids.eleq2;
								lemStep2 = RuProofStep(lem2, [], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [eqY, bi2])], -1));
								biStep2 = RuProofStep(ids.axmp, [py, lemStep2], RuStmt(stcl, [bi2], -1));
								RuProofStep(eids.mpbir, [step1, biStep2], RuStmt(stcl, [bodyExp], -1));
							}
						};
					});
				}
			}
		}
	}
}

// Cap on total forward facts per wave: once the front index reaches it, stop expanding
// the remaining frontier facts this wave. Mirrors the depth-bounded ruMaybeBuildForwardFront
// (forward-search-size). WITHOUT it a single unguided wave under a wide scope (e.g. checker-scope)
// explodes — running for minutes and consuming the whole prove-command budget, which STARVES the
// other theorems in a sequential run (they never even start). A LIMIT, not a variant discard:
// stopping under a bound is allowed by the completeness invariant (never MISS a reachable proof
// within the bound; giving up past it is fine). Overridable via forward-search-size.
ruForwardWaveSizeCap(prover_env : RuProverEnv) -> int {
	v = lookupTreeDef(prover_env.conf.task.args, "forward-search-size", "512");
	if (runtimeValueType(v) == "int") cast(v : flow -> int) else s2i(cast(v : flow -> string));
}

ruRunForwardWave(prover_env : RuProverEnv) -> bool {
	switch (^(prover_env.forwardFront)) {
		None(): { prover_env.waveGain := 0; false }
		Some(fwd): {
			if (fwd.front == []) { prover_env.waveGain := 0; false }
			else {
				// Bound the wave so it can't explode and starve sibling theorems in a
				// sequential run. Two guards, both checked at COARSE (per-wave / per-fact)
				// granularity so the bounding itself never costs more than the work:
				//   - size: if the front index has already reached the cap, don't run another
				//     wave at all (checked ONCE here — NOT per fact: ruIndexDataCount is O(n),
				//     so a per-fact check made skipping a large wave O(n^2), 40 s+ to skip).
				//   - time: inside the fold, stop expanding once the per-goal timer is over.
				// A LIMIT, not a variant discard: stopping under a bound is allowed by the
				// completeness invariant (never MISS a reachable proof within the bound).
				size = ruForwardWaveSizeCap(prover_env);
				if (ruIndexDataCount(fwd.index) >= size || ruTimeIsOver(prover_env.conf.timer)) {
					// capped/timed out with a non-empty front: the wave is STUCK, not
					// exhausted — report zero gain so the L2 forward tactic concludes
					prover_env.waveGain := 0;
					false;
				} else {
					// Ordered-saturation steering (the `ordered` atom): BEST-FIRST waves.
					// Expand only the ≺-minimal size class of the frontier and DEFER the
					// rest to the next front, so the small saturation core (a shrinking
					// refutation ladder, equality literals) advances wave after wave while
					// term-GROWING congruence junk waits — per-wave sorting alone cannot do
					// this (every wave would still expand its whole junk front before the
					// core's next rung). A pure REORDERING across waves: deferred facts stay
					// in the front and are expanded once the core stops shrinking — nothing
					// is ever discarded (completeness invariant; bounds cut here exactly as
					// they cut a FIFO wave).
					wave = if (^(prover_env.ordered)) {
						// ≺ = (metavar count, term size): GROUND-FIRST, then smallest. Ground
						// facts (task constants — the ¬G deductions, premises, chain literals)
						// carry the actual problem; schematic facts (seeded 0-hyp lemmas and
						// their syl/mpd self-compositions — which can regenerate the whole
						// theory as junk) stay FILL-only until nothing ground is left. The
						// standard ground-first discipline of saturation provers.
						// (A goal-relevance leading key was TRIED and REGRESSED: everything
						// derived from goal-facts contains the goal, so the class stops
						// discriminating while demoting ground-first — the selection-policy
						// iteration for the clash chain's LARGE late rungs is open work.)
						fkey = \f : RuProverExp -> {
							e = ruExp(f.stmt.exps[0]);
							nvars = fold(e.nodes, 0, \n, node -> switch (node) {
								RuVar(__,__): n + 1;
								RuRuleNode(__,__): n;
							});
							nvars * 100000 + length(e.nodes);
						}
						minkey = fold(fwd.front, intMax, \m, f -> min(m, fkey(f)));
						// (An oldest-fact LIVENESS slot — E-prover's age axis — was TRIED for
						// the large late clash rungs and REVERTED: old IMPLICATION facts
						// explode on expansion (1 fact → +1700 via syl/ax-mp fill cartesians)
						// and cap the index in ~16 waves. The right mechanism for the late
						// rungs is the BIDIRECTIONAL meet: a bounded backward bfs registers
						// ¬¬G-style subgoals in backwardFront and the forward-derived fact
						// joins AT CREATION (ruReverseJoin) — no expansion needed. That
						// composition currently HANGS (seq(limited(bfs), ordered(loop(forward)))
						// at 0% CPU) — open engine bug, see mizar-plan-progress.)
						Pair(
							filter(fwd.front, \f -> fkey(f) == minkey),
							filter(fwd.front, \f -> fkey(f) != minkey)
						);
					} else Pair(fwd.front, []);
					new_fwd = fold(wave.first, RuProverForward(fwd with front = wave.second), \st, fact ->
						if (ruTimeIsOver(prover_env.conf.timer)) st
						else ruExpandForwardProved(st, fact, prover_env).first
					);
					if (prover_env.env.conf.verbose >= 3) {
						prover_env.env.out.println(
							"forward wave: front " + i2s(length(fwd.front))
							+ " (expand " + i2s(length(wave.first)) + ") -> " + i2s(length(new_fwd.front))
							+ ", index " + i2s(ruIndexDataCount(new_fwd.index))
							+ (if (^(prover_env.ordered)) " (ordered)" else "")
						);
					} else {};
					prover_env.forwardFront := Some(new_fwd);
					// PROGRESS, not index gain: a wave that expanded anything advances
					// (the front shrinks toward exhaustion even when every derived fact
					// was a duplicate, and `ordered` keeps deferred facts pending) —
					// zero is reserved for the STUCK guards above (cap/timeout)
					prover_env.waveGain := length(wave.first);
					new_fwd.front != [];
				}
			}
		}
	}
}
