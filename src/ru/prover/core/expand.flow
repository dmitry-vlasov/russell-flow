import ru/prover/core/proofs;
import ru/prover/core/forward_closure;
import ru/prover/core/forward;
import ru/prover/core/tree;

export {
	ruExpandHyp(hyp : RuProverHyp, prover_env : RuProverEnv) -> RuProverEnv;
	ruExpandProp(prop : RuProverProp, prover_env : RuProverEnv) -> RuProverEnv;
}

ruExpandHyp(hyp : RuProverHyp, prover_env : RuProverEnv) -> RuProverEnv {
	t1 = ruMakeTimer();
	unified = concat(
		prover_env.fns.unifyAssertion(hyp),
		prover_env.fns.unifyFragment(hyp)
	);
	if (ruOptsString(prover_env.env.conf.opts, "reprove-stats", "") == "1") {
		ruAddStats("unify_assertion", RuStatsRow("unifying " + ruSafeExp2s(ruExp(hyp.stmt.exps[0]), prover_env.math.decls.lang),
			pairs2tree([
				Pair("size", i2d(length(ruExp(hyp.stmt.exps[0]).nodes))), 
				Pair("time", ruTimePassed(t1)), 
				Pair("rets", i2d(length(unified)))
			])
		));
	}
	// Sort most-specific candidates first (more variables bound by unification = tighter fit).
	// Prop IDs reflect insertion order, so TopN beam tactics naturally prefer specific candidates.
	unified_sorted = sortCustom(unified, \u -> ruSubstSize(u.sub), false);
	expanded_leafs = fold(unified_sorted, prover_env.tree.leafs,
		\acc, unif -> {
			assertion = unif.data;
			precedes = ruDeclInfoPreceeds(assertion.info, prover_env.conf.task.info, prover_env.importDependencies);
			if (!precedes) acc else {
				t2 = ruMakeTimer();
				a_vars  = ruAssertion2Vars(unif.data);
				t2_ = ruTimePassed(t2);
				
				t3 = ruMakeTimer();
				fresher = ruMakeFresherSubst(
					foldSet(a_vars, [], \ac, v -> 
						if (ruSubstMapsVar(unif.sub, v.id)) ac else concat(ac, [v])
					), 
					prover_env.fns.fresher
				);
				t3_ = ruTimePassed(t3);
				
				
				t4 = ruMakeTimer();
				s_all = ruUnsafeCompose(unif.sub, fresher);
				t4_ = ruTimePassed(t4);
				
				t5 = ruMakeTimer();
				prop = RuProverProp(
					prover_env.fns.idxer(),
					assertion, makeVector(4), 
					ruFilterSub(s_all, \v,__ -> !containsSet(a_vars, v)),
					ruFilterSub(s_all, \v,__ -> containsSet(a_vars, v)),
					makeVector(ruArity(assertion)),
					hyp,
					ref ""
				);
				prover_env.fns.onProp(prop);
				ruAtomicVectorPush(hyp.children)(prop);
				t5_ = ruTimePassed(t5);
				
				t6 = ruMakeTimer();
				ret = setTree(acc, prop.id, prop);
				t6_ = ruTimePassed(t6);
				
				t = ruTimePassed(t2);
				if (ruOptsString(prover_env.env.conf.opts, "reprove-stats", "") == "1") {
					ruAddStats("add_unified", RuStatsRow("adding " + ruSafeExp2s(ruExp(hyp.stmt.exps[0]), prover_env.math.decls.lang) + " for " + id2s(unif.data.info.id), 
						pairs2tree([
							Pair("size", i2d(ruSubstSize(s_all))), 
							Pair("time",  t), 
							Pair("time2", t2_), 
							Pair("time3", t3_),
							Pair("time4", t4_),
							Pair("time5", t5_),
							Pair("time6", t6_),
							Pair("count", 1.0)
						])
					));
				}
				ret
			}
		}
	);
	RuProverEnv(prover_env with 
		tree = RuProverTree(prover_env.tree with 
			leafs = expanded_leafs, 
			nodes = mergeTree(prover_env.tree.nodes, expanded_leafs)
		)
	);
}

ruExpandProp(prop : RuProverProp, prover_env : RuProverEnv) -> RuProverEnv {
	// Stamp the prop with the DSL atom currently expanding it, so coverage
	// can attribute each node to the tactic responsible.  "?" when the active
	// tactic carries no tag (non-DSL use) — still distinct from "" (unexpanded).
	prop.expanded := switch (^(prover_env.tactic)) {
		Some(t): if (t.tag == "") "?" else t.tag;
		None():  "?";
	};
	if (ruArity(prop.assertion) == 0) {
		pushVector(prop.proofs, RuProverProofProp(prop, prop.sub, []));
		RuProverEnv(prover_env with 
			tree = RuProverTree(prover_env.tree with 
				leafs = removeFromTree(prover_env.tree.leafs, prop.id)
			)
		);
	} else {
		foldi(prop.assertion.infer.hyps, prover_env, \i, acc, h -> {
			exs = map(h.stmt.exps, \e -> ruApplySubst(ruApplySubst(ruExp(e), prop.sub), prop.outer));
			if (!prover_env.fns.admitExp(exs[0])) acc else {
				hyp = RuProverExp(i, makeVector(4), RuStmt(h.stmt with exps = exs), makeVector(0), prop);
				pushVector(prop.children, hyp);
				// Universal join, backward side: register this open backward subgoal
				// in the backward front so a later forward fact can discharge it (the
				// reverse trigger in forward.flow). Only when the bidirectional engine
				// is active (forwardFront installed) — otherwise inert, so pure backward
				// search is byte-identical.
				if (^(prover_env.forwardFront) != None()) {
					prover_env.backwardFront := ruSetIndex(exs[0], hyp, ^(prover_env.backwardFront));
				} else {};
				t1 = ruMakeTimer();
				unified = prover_env.fns.unifyPremise(hyp);
				if (ruOptsString(prover_env.env.conf.opts, "reprove-stats", "") == "1") {
					ruAddStats("unify_premise", RuStatsRow("unifying " + ruSafeExp2s(ruExp(hyp.stmt.exps[0]), prover_env.math.decls.lang), 
						pairs2tree([
							Pair("size", i2d(length(ruExp(hyp.stmt.exps[0]).nodes))), 
							Pair("time", ruTimePassed(t1)), 
							Pair("rets", i2d(length(unified)))
						])
					));
				}
				iter(unified, \unif -> {
					all_exps = mapi(exs, \j, ex_j -> if (j == 0) unif.expr else ruApplySubst(ex_j, unif.sub));
					hypProof = RuProverProofTop(hyp, RuStmt(h.stmt with exps = all_exps), unif.data, unif.sub);
					// Variant admission (inert by default) — dedup + per-node limit.
					if (prover_env.fns.keepVariant(hypProof)) {
						pushVector(hyp.proofs, hypProof);
						ruAddProof(prop, hypProof, acc);
					} else {};
				});
				// Forward-closure splice: any leaf that unifies with a fact in the
				// shallow forward closure can be closed here, without further
				// backward expansion, by splicing the cached witness.
				//
				// Skip depth-0 matches: those are literal premise hits, already
				// covered by unifyPremise above. Adding both would double-count
				// in the proof cartesian product (ruAddProof) and burn time.
				//
				// Cap the number of splices per leaf so the per-prop cartesian
				// product in ruAddProof stays bounded. Each splice creates one
				// more proof for the leaf; with many splices and many siblings,
				// the cartprod size explodes quickly.
				fwd_unified_all = filter(prover_env.fns.unifyClosure(hyp), \u -> {
					switch (u.data.witness) {
						RuFwPremise(__):           false;
						RuFwApply(__,__,__,__):    true;
					}
				});
				// Prefer shallowest splices first: they produce the smallest proof
				// subtrees, keeping ruAddProof's cartesian product manageable. The
				// cap then trims the long tail without dropping the best candidates.
				fwd_sorted = sortCustom(fwd_unified_all, \u -> u.data.depth, true);
				fwd_cap = 4;
				fwd_unified = if (length(fwd_sorted) > fwd_cap) take(fwd_sorted, fwd_cap) else fwd_sorted;
				if (fwd_unified != []) {
					iter(fwd_unified, \unif -> {
						all_exps = mapi(exs, \j, ex_j -> if (j == 0) unif.expr else ruApplySubst(ex_j, unif.sub));
						closing_stmt = RuStmt(h.stmt with exps = all_exps);
						spliced = ruSpliceForwardWitness(unif.data.witness, closing_stmt, unif.sub, prover_env.math);
						fwdProof = RuProverProofForward(hyp, closing_stmt, unif.sub, spliced);
						// Variant admission (inert by default) — dedup + per-node limit.
						if (prover_env.fns.keepVariant(fwdProof)) {
							pushVector(hyp.proofs, fwdProof);
							ruAddProof(prop, fwdProof, acc);
						} else {};
					});
				}
					// Dynamic forward-front interior join. When a proof-carrying
					// forward front is installed (forward-search-depth > 0), close this
					// leaf with a forward-derived, ENGINE-BUILT proof: match the leaf
					// against the front's facts, and for each match graft the forward
					// node's proof (ruMakeProofTree of its variant, specialised to the
					// leaf by the match sub) as an ordinary RuProverProofForward, fed to
					// ruAddProof exactly like the static-closure splice above. Guarded by
					// ruJoinAcyclic so a forward derivation that depends on this very
					// leaf can never close it (no self-supporting cycle). Inert (None)
					// when no front is installed -- the engine is then unchanged.
					maybeApply(^(prover_env.forwardFront), \front -> {
						leaf_key = (ruExp(hyp.stmt.exps[0])).nodes;
						leaf_exp = ruExp(hyp.stmt.exps[0]);
						// POSITIONAL join when the path index is populated (completeness
						// test): the single forward fact derived at THIS leaf's proof-DAG
						// path (ruNodePath) — exact correspondence, no spurious unifiers.
						// Otherwise (forward-search feature) fall back to the shallowest
						// unifying facts (capped), keyed on proof size.
						fwd_join = if (sizeTree(front.pathIndex) > 0) {
							switch (lookupTree(front.pathIndex, ruNodePath(hyp))) {
								None(): [];
								Some(fact): eitherMap(
									ruUnifyExps([leaf_exp, ruExp(fact.stmt.exps[0])], ruEmptySubst, prover_env.math, prover_env.env),
									\s -> [RuUnified(s, fact, ruApplySubst(leaf_exp, s))], []
								);
							}
						} else {
							fwd_join_all = ruUnifyIndex(leaf_exp, front.index, ruEmptySubst, prover_env.math, prover_env.env);
							fwd_join_sorted = sortCustom(fwd_join_all, \u -> ruForwardProofSize(u.data), true);
							if (length(fwd_join_sorted) > 4) take(fwd_join_sorted, 4) else fwd_join_sorted;
						};
						iter(fwd_join, \u -> {
							fwd_node = u.data;
							if (ruJoinAcyclic(fwd_node, leaf_key)) {
								all_exps = mapi(exs, \j, ex_j -> if (j == 0) u.expr else ruApplySubst(ex_j, u.sub));
								closing_stmt = RuStmt(h.stmt with exps = all_exps);
								iterVector(fwd_node.proofs, \pv -> {
									spliced = ruApplySubst2ProofNode(u.sub, ruMakeProofTree(pv));
									fwdProof = RuProverProofForward(hyp, closing_stmt, u.sub, spliced);
									// Variant admission (inert by default): dedup so a forward interior-join graft
									// equal to backward's proof is NOT emitted twice (ADDITIVE),
									// and bound the node to `limit`.
									if (prover_env.fns.keepVariant(fwdProof)) {
										pushVector(hyp.proofs, fwdProof);
										ruAddProof(prop, fwdProof, acc);
									} else {};
								});
							}
						});
					});
				t2 = ruMakeTimer();
				// Meet-in-the-middle (positional join only): if the exact forward fact
				// for this leaf already closed it (the interior join above put a proof on it), do NOT
				// also expand it backward — that would prove the same node twice and
				// break the additive invariant. Gated on a populated pathIndex, so pure
				// backward and the (unification-based) forward-search feature are
				// unchanged. Leaves the forward front doesn't cover are expanded as usual.
				//
				// Why this can't drop a reachable proof (it is NOT a beam cut): a populated
				// pathIndex means the completeness-test combined oracle, where the forward
				// fact at this path is the leaf's TRUE positional subproof — lifted from the
				// very proof being reconstructed (ruCombinedDerive), matched by exact path
				// identity, one fact per node. So the close is never a speculative commitment
				// to one of several proofs; it is THE subproof of this node. There is no
				// "other backward expansion of this node that might have worked instead", so
				// skipping it loses nothing. (If the global assembly still fails, the fault is
				// in a sibling/ancestor, which re-expanding this node could not fix.) In the
				// real prover the pathIndex is empty, this is inert, and forward stays purely
				// additive — it only ADDS proof variants, never suppresses backward expansion.
				closed_by_fwd = eitherMap(^(prover_env.forwardFront),
					\front -> sizeTree(front.pathIndex) > 0 && sizeVector(hyp.proofs) > 0, false);
				ret = if (closed_by_fwd) acc else ruExpandHyp(hyp, acc);
				if (ruOptsString(prover_env.env.conf.opts, "reprove-stats", "") == "1") {
					ruAddStats("ruExpandHyp", RuStatsRow("expanding " + ruSafeExp2s(ruExp(hyp.stmt.exps[0]), prover_env.math.decls.lang), 
						pairs2tree([
							Pair("time", ruTimePassed(t2)), 
							Pair("count", 1.0)
						])
					));
				}
				ret
			}
		});
	}
}
