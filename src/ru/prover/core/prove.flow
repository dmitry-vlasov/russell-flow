import ru/prover/core/expand;

export {
	ruInitProver(
		task : RuProverTask,
		math : RuMath,
		env : RuEnv,
		asses : RuIndex<RuAssertion>,
		ms_time_limit : double
	) -> RuProverEnv;

	ruProve(prover_env : RuProverEnv) -> RuProverEnv;
	// Sequential variant: avoids nested-concurrency issues when called inside
	// an already-parallel context (e.g. ruMapFnComm per-theorem workers).
	ruProveSequential(prover_env : RuProverEnv) -> RuProverEnv;
	ruProveProp(prop : RuProverProp, prover_env : RuProverEnv) -> RuProverEnv;
	// One sequential backward round (the body of ruProveSequential without the
	// recursion): pull the next batch of props from the tactic, expand them, merge.
	// Returns the new env and whether anything was expanded. For drivers (e.g. the
	// combined oracle) that interleave backward rounds with forward derivation.
	ruProveOneRound(prover_env : RuProverEnv) -> Pair<RuProverEnv, bool>;
}

ruInitProver(
	task : RuProverTask,
	math : RuMath,
	env : RuEnv,
	asses : RuIndex<RuAssertion>,
	ms_time_limit : double
) -> RuProverEnv {
	prover_env = ruInitProverEnv(task, math, env, asses, ms_time_limit);
	prover_env.tactic := Some(prover_env.conf.task.tactic);
	ruMaybeBuildForwardFront(prover_env, task, asses);
	ruExpandHyp(prover_env.tree.root, prover_env);
}

ruProveProp(prop : RuProverProp, prover_env : RuProverEnv) -> RuProverEnv {
	t1 = ruMakeTimer();
	env1 = ruExpandProp(prop, prover_env);
	if (ruOptsString(prover_env.env.conf.opts, "reprove-stats", "") == "1") {
		ruAddStats("ruExpandProp", RuStatsRow("expanding " + id2s(prop.assertion.info.id),
			pairs2tree([
				Pair("time", ruTimePassed(t1)),
				Pair("count", 1.0)
			])
		));
	}
	t2 = ruMakeTimer();
	ruBuildPropProofs(prop, prop.proofs, env1);
	if (ruOptsString(prover_env.env.conf.opts, "reprove-stats", "") == "1") {
		ruAddStats("ruBuildPropProofs", RuStatsRow("building proofs for " + id2s(prop.assertion.info.id),
			pairs2tree([
				Pair("time", ruTimePassed(t2)),
				Pair("count", 1.0)
			])
		));
	}
	env1;
}

// Resolves the current tactic's next actionable step: Switch swaps the tactic and
// retries; Done clears the tactic and reports RuTacticExpand([]) (the "stop"
// signal); Expand / ExpandForward pass through. Returns Pair(updated env, step)
// where step is always RuTacticExpand(leafs) (backward) or RuTacticExpandForward()
// (advance the forward front one wave). An empty Expand([]) means stop.
ruRunTacticStep(prover_env : RuProverEnv) -> Pair<RuProverEnv, RuProverTacticStep> {
	// a task argument (reprove max-props=N) first, then the conf option
	max_props_s = switch (lookupTree(prover_env.conf.task.args, "max-props")) {
		Some(v): ruScValue2s(v);
		None(): ruOptsString(prover_env.env.conf.opts, "max-props", "");
	};
	max_props = if (max_props_s == "") 0 else s2i(max_props_s);
	if (max_props > 0 && ^(prover_env.propCount) > max_props) {
		// The candidate budget is exhausted: give up (a resource limit, reported by reprove).
		if (!^(prover_env.budgetOver) && prover_env.env.conf.verbose >= 3) {
			prover_env.env.out.println("  candidate budget exhausted: " + i2s(^(prover_env.propCount)) + " props > max-props=" + i2s(max_props) + " — giving up");
		} else {};
		prover_env.budgetOver := true;
		Pair(prover_env, RuTacticExpand([]));
	} else
	switch (^(prover_env.tactic)) {
		Some(tactic): {
			t_step = ruMakeTimer();
			step = tactic.step(prover_env.tree);
			if (ruOptsString(prover_env.env.conf.opts, "reprove-stats", "") == "1") {
				ruAddStats("tactic-step", RuStatsRow(tactic.tag, pairs2tree([
					Pair("time", ruTimePassed(t_step)), Pair("count", 1.0),
					Pair("rets", switch (step) { RuTacticExpand(ls): i2d(length(ls)); default: 0.0; }),
					Pair("size", i2d(sizeTree(prover_env.tree.leafs)))
				])));
			}
			switch (step) {
				RuTacticDone(): {
					if (prover_env.env.conf.verbose >= 4) {
						prover_env.env.out.println("  tactic step DONE (prove stops): " + tactic.toString);
					} else {};
					prover_env.tactic := None();
					Pair(prover_env, RuTacticExpand([]));
				}
				RuTacticSwitch(next): {
					prover_env.tactic := Some(next);
					// honor a stage-entry root-reexpand request BEFORE stepping the
					// new tactic — its bfs must see the re-offered frontier
					ruRunTacticStep(ruMaybeReexpandRoot(prover_env));
				}
				RuTacticExpand(leafs):    Pair(prover_env, RuTacticExpand(leafs));
				RuTacticExpandForward():  Pair(prover_env, RuTacticExpandForward());
			}
		}
		None(): Pair(prover_env, RuTacticExpand([]));
	}
}

// Expand a batch of backward leafs and merge the results back into the tree,
// respecting the current tactic's keep_expanding budget. `parallel` picks
// ruConcurrent (top-level) vs ruSequential (nested / one-round). Shared by all
// three drive loops so the expansion body stays in one place.
ruExpandLeafsInto(env_after_step : RuProverEnv, to_expand : [RuProverProp], parallel : bool) -> RuProverEnv {
	to_expand_removed = fold(to_expand, env_after_step.tree.leafs, \acc, prop ->
		removeFromTree(acc, prop.id)
	);
	env1 = RuProverEnv(env_after_step with
		tree = RuProverTree(env_after_step.tree with leafs = to_expand_removed)
	);
	// This round's new props are collected here by ruExpandHyp (shared ref, atomic push).
	clearVector(env1.roundProps);
	workers = map(to_expand, \prop -> \env2 ->
		switch (^(env1.tactic)) {
			Some(tac): if (tac.keep_expanding(env1.tree)) ruProveProp(prop, RuProverEnv(env1 with env = env2)) else env1;
			None(): env1;
		}
	);
	env1_expanded = if (parallel) ruConcurrent(workers, env1.env) else ruSequential(workers, env1.env);
	tm = ruMakeTimer();
	// A worker's tree differs from env1's only by the props it created (the expanded
	// props were already removed above), so the round's result is env1 + roundProps.
	fresh = vector2array(env1.roundProps);
	clearVector(env1.roundProps);
	merged = RuProverEnv(env1 with
		tree = RuProverTree(env1.tree with
			leafs = fold(fresh, env1.tree.leafs, \acc, p -> setTree(acc, p.id, p)),
			nodes = fold(fresh, env1.tree.nodes, \acc, p -> setTree(acc, p.id, p))
		)
	);
	if (ruOptsString(env1.env.conf.opts, "reprove-stats", "") == "1") {
		ruAddStats("ruExpandLeafsInto-merge", RuStatsRow("merging round results",
			pairs2tree([Pair("time", ruTimePassed(tm)), Pair("count", 1.0), Pair("leafs", i2d(sizeTree(merged.tree.leafs)))])));
	}
	merged;
}

ruProve(prover_env : RuProverEnv) -> RuProverEnv {
	ruProveRec(prover_env, false);
}

// STAGE-LOCAL BACKWARD FRONTIER (see env.flow rootReexpand): an or-else stage
// entry requests a root re-expansion under ITS whitelist; the loops honor it
// here, before the next tactic step, so the stage's bfs sees its own frontier.
ruMaybeReexpandRoot(prover_env : RuProverEnv) -> RuProverEnv {
	if (^(prover_env.rootReexpand)) {
		prover_env.rootReexpand := false;
		env1 = ruExpandHyp(prover_env.tree.root, prover_env);
		if (prover_env.env.conf.verbose >= 4) {
			prover_env.env.out.println("  root-reexpand: leafs " + i2s(sizeTree(prover_env.tree.leafs)) + " -> " + i2s(sizeTree(env1.tree.leafs)));
		} else {};
		env1;
	} else prover_env;
}

ruProveRec(prover_env0 : RuProverEnv, dry : bool) -> RuProverEnv {
	prover_env = ruMaybeReexpandRoot(prover_env0);
	to_expand0 = filtermap(^(prover_env.toExpand), \ind ->
		lookupTree(prover_env.tree.leafs, ind)
	);
	prover_env.toExpand := [];
	if (length(to_expand0) > 0) {
		ruProveRec(ruExpandLeafsInto(prover_env, to_expand0, true), false);
	} else {
		step_res = ruRunTacticStep(prover_env);
		env_a    = step_res.first;
		switch (step_res.second) {
			RuTacticExpand(leafs):
				if (leafs == []) env_a
				else ruProveRec(ruExpandLeafsInto(env_a, leafs, true), false);
			// A forward wave is one L1 round: advance the front; if it produced new
			// facts (and no proof yet), loop back to the tactic for the next round.
			// A DRY wave must NOT end the prove loop outright: the tactic gets one
			// more consult so a combinator can conclude (Done) or switch to its
			// next alternative — otherwise a wave stage drying inside an or-else
			// silently aborts every later stage (measured: the eq-first pipeline
			// collapsed 79→26 because def-close never ran; the batch-vs-alone gap
			// had the same cause — checker-eq never ran behind checker-mizar's dry
			// wave). Two consecutive dry rounds terminate: a bare `forward` atom
			// that keeps requesting waves on a dry front must not spin.
			RuTacticExpandForward():
				if (ruRunForwardWave(env_a)) ruProveRec(env_a, false)
				else if (!dry) ruProveRec(env_a, true)
				else env_a;
			RuTacticSwitch(__): env_a;   // resolved inside ruRunTacticStep — unreachable
			RuTacticDone():     env_a;   // resolved inside ruRunTacticStep — unreachable
		}
	}
}

ruProveOneRound(prover_env : RuProverEnv) -> Pair<RuProverEnv, bool> {
	ruProveOneRoundRec(prover_env, false);
}

ruProveOneRoundRec(prover_env0 : RuProverEnv, dry : bool) -> Pair<RuProverEnv, bool> {
	prover_env = ruMaybeReexpandRoot(prover_env0);
	to_expand0 = filtermap(^(prover_env.toExpand), \ind ->
		lookupTree(prover_env.tree.leafs, ind)
	);
	prover_env.toExpand := [];
	if (length(to_expand0) > 0) {
		Pair(ruExpandLeafsInto(prover_env, to_expand0, false), true);
	} else {
		step_res = ruRunTacticStep(prover_env);
		env_a    = step_res.first;
		switch (step_res.second) {
			RuTacticExpand(leafs):
				if (leafs == []) Pair(env_a, false)
				else Pair(ruExpandLeafsInto(env_a, leafs, false), true);
			// dry wave: re-consult the tactic once (see ruProveRec) — a combinator
			// must get the chance to switch stages; two dry rounds terminate.
			RuTacticExpandForward():
				if (ruRunForwardWave(env_a)) Pair(env_a, true)
				else if (!dry) ruProveOneRoundRec(env_a, true)
				else Pair(env_a, false);
			RuTacticSwitch(__): Pair(env_a, false);   // unreachable
			RuTacticDone():     Pair(env_a, false);   // unreachable
		}
	}
}

ruProveSequential(prover_env : RuProverEnv) -> RuProverEnv {
	ruProveSequentialRec(prover_env, false);
}

ruProveSequentialRec(prover_env0 : RuProverEnv, dry : bool) -> RuProverEnv {
	prover_env = ruMaybeReexpandRoot(prover_env0);
	to_expand0 = filtermap(^(prover_env.toExpand), \ind ->
		lookupTree(prover_env.tree.leafs, ind)
	);
	prover_env.toExpand := [];
	if (length(to_expand0) > 0) {
		ruProveSequentialRec(ruExpandLeafsInto(prover_env, to_expand0, false), false);
	} else {
		step_res = ruRunTacticStep(prover_env);
		env_a    = step_res.first;
		switch (step_res.second) {
			RuTacticExpand(leafs):
				if (leafs == []) env_a
				else ruProveSequentialRec(ruExpandLeafsInto(env_a, leafs, false), false);
			// dry wave: re-consult the tactic once (see ruProveRec) — a combinator
			// must get the chance to switch stages; two dry rounds terminate.
			RuTacticExpandForward():
				if (ruRunForwardWave(env_a)) ruProveSequentialRec(env_a, false)
				else if (!dry) ruProveSequentialRec(env_a, true)
				else env_a;
			RuTacticSwitch(__): env_a;   // unreachable
			RuTacticDone():     env_a;   // unreachable
		}
	}
}
