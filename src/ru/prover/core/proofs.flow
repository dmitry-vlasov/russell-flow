import base/util/util;
import ru/prover/core/env;
import ru/prover/core/fragment;
import ru/unify/prod;
import ru/verify/math;
import ru/util/src2s;

export {
	ruAddProof(prop : RuProverProp, hypProof : RuProverProofHyp, prover_env : RuProverEnv) -> void;
	ruBuildPropProofs(prop : RuProverProp, proofs : Vector<RuProverProofProp>, prover_env : RuProverEnv) -> void;
	ruBuildExpProofs(hyp : RuProverExp, proofs : Vector<RuProverProofHyp>, prover_env : RuProverEnv) -> void;
	// The one completion path: a proof variant reaching the ROOT is handed to fns.onProof.
	// Exported for the forward ROOT JOIN (ruReverseJoin): a forward fact that matches the
	// root statement completes the proof through this same path.
	ruBuildRootProofs(root : RuProverRoot, proofs : Vector<RuProverProofHyp>, prover_env : RuProverEnv) -> void;
}

// Canonical, language-free key for a substitution: serialises each var->exp
// binding using raw numeric ids only (never id2s, which crashes on constified
// vars). Used to deduplicate proofs that compose to the same substitution.
ruProofSubKey(s : RuSubst) -> string {
	strGlue(sort(map(hashMapValues(s.map), \se ->
		i2s(se.var.id) + "=" + strGlue(map(se.exp.nodes, \n -> switch (n) {
			RuRuleNode(it, al): "r" + i2s(it) + "_" + i2s(al);
			RuVar(vid, __):     "v" + i2s(vid);
		}), ",")
	)), "|")
}

// Product size from which ruAddProof switches from exhaustive row enumeration to the
// matrix unifier (ruUnifySubsProd). Config `unify-prod-threshold` overrides the default
// 64 — a diagnostic knob: raising it very high disables the matrix path.
ruUnifyProdThreshold(prover_env : RuProverEnv) -> int {
	v = ruOptsString(prover_env.env.conf.opts, "unify-prod-threshold", "");
	if (v == "") 64 else s2i(v);
}

ruAddProof(prop : RuProverProp, hypProof : RuProverProofHyp, prover_env : RuProverEnv) -> void {
	if (sizeVector(prop.children) == ruArity(prop.assertion)) {
		prod = CartProd(map(vector2array(prop.children), \hyp ->
			if (hyp == hypProof.node) [RuSubData(hypProof.sub, hypProof)] else
			// hyp.proofs is written under synchronizedUnaryFn(hyp.proofs, …) in
			// ruBuildPropProofs; read under the same lock to avoid a data race that
			// causes null entries in the snapshot and a subsequent NPE in map.
			map(synchronizedUnaryFn(hyp.proofs, vector2array)(hyp.proofs), \p -> RuSubData(p.sub, p))
		));
		size = sizeCartProd(prod);
		unified = if (size == 0) {
			[];
		} else if (size == 1) {
			row = map(prod.sets, \s -> s[0]);
			eitherMap(
				ruUnifySubs(map(row, \p -> p.sub), prover_env.math, prover_env.env),
				\s -> [RuSubData(s, map(row, \hp -> hp.data))], 
				[]
			);
		} else if (size < ruUnifyProdThreshold(prover_env)) {
			filtermapCartProd(prod, \row -> 
				maybeMap(
					ruUnifySubs(map(row, \hp -> hp.sub), prover_env.math, prover_env.env),
					\s -> RuSubData(s, map(row, \hp -> hp.data))
				)
			);
		} else {
			matrix_res = ruUnifySubsProd(
				prod, prover_env.fns.admitExp,
				prover_env.math, prover_env.env
			);
			// Diagnostic: `unify-prod-check=1` runs the exhaustive enumeration too and reports a
			// matrix result that is SMALLER (the matrix unifier dropping a solution). Costly on
			// big products — for small failing theorems only.
			if (ruOptsString(prover_env.env.conf.opts, "unify-prod-check", "") == "1") {
				exhaustive = filtermapCartProd(prod, \row ->
					maybeMap(
						ruUnifySubs(map(row, \hp -> hp.sub), prover_env.math, prover_env.env),
						\s -> RuSubData(s, map(row, \hp -> hp.data))
					)
				);
				ex_keys = buildSet(map(exhaustive, \r -> ruProofSubKey(r.sub)));
				mx_keys = buildSet(map(matrix_res, \r -> ruProofSubKey(r.sub)));
				prover_env.env.out.println("prod-check at " + id2s(prop.assertion.info.id) + ": size " + i2s(size) +
					" exhaustive " + i2s(length(exhaustive)) + "/" + i2s(sizeSet(ex_keys)) + " distinct, matrix " + i2s(length(matrix_res)) + "/" + i2s(sizeSet(mx_keys)) + " distinct" +
					(if (ex_keys == mx_keys) "" else "  <-- DIFFERENT SOLUTION SETS"));
				if (ex_keys != mx_keys) {
					prover_env.env.out.println("UNIFY-PROD MISMATCH at " + id2s(prop.assertion.info.id) + ": product size " + i2s(size) +
						", exhaustive solutions " + i2s(length(exhaustive)) + ", matrix solutions " + i2s(length(matrix_res)) + "\n" +
						strIndent(ruUnifyProdSubs2s(prod, prover_env.math)) + "\n  exhaustive unifiers:\n" +
						strGlue(map(exhaustive, \r -> strIndent(strIndent(ruSubst2s(r.sub, prover_env.math)))), "\n  ----\n") +
						"\n  matrix unifiers:\n" +
						strGlue(map(matrix_res, \r -> strIndent(strIndent(ruSubst2s(r.sub, prover_env.math)))), "\n  ----\n"));
				} else {};
			} else {};
			matrix_res;

			/*new_proofs1 = ruAddProofDirect(prod, prop, prover_env);
			direct_time = ruTimePassed(t_direct);
			checked = ruCheckAddProofEquals(new_proofs, new_proofs1, prover_env);
			if (!checked.first) {
				//ruUnifyProdSubs2s(prod : [[RuSubData<?>]], math : RuMath) -> string;
				subs = map(vector2array(prop.children), \hyp ->
					if (hyp == hypProof.node) [RuSubData(hypProof.sub, hypProof)] else 
					map(vector2array(hyp.proofs), \p -> RuSubData(p.sub, p))
				);
				if (checked.second != []) {
					print ln("ERR HYPS:\n" + 
						strIndent(strGlue(mapi(checked.second, \i, hyp -> 
							"hyp_" + i2s(i) + ":\n" + strIndent(ruSubst2s(hyp.sub, prover_env.math))
						), "\n"))
					);
				}
				debug_unify_subs := true;
				msub = ruUnifySubs(map(checked.second, \hp -> hp.sub), prover_env.math, prover_env.env);
				maybeApply(msub, \sub -> print ln("ruUnifySubs: SUB:\n" + ruSubst2s(sub, prover_env.math)));
				debug_unify_subs := false;

				print ln("REPROVING: " + id2s(prover_env.conf.task.info.id) + ", time limit: " + ruTime2s(prover_env.conf.timer.limit) + "\n" +
					"MATRIX:\n" + ruUnifyProdSubs2s(subs, prover_env.math)
				);
				print ln("ruAddProof: " + id2s(prop.assertion.info.id) + " size=" + i2s(size) + ", added: " + i2s(length(new_proofs)));
				debug_unify_subs_prod := true;
				ruAddProofLarge(prop, hypProof, prover_env);
				fail("ERROR");
			}*/
		}
		// Verifier-style consistency check (see ruMergeSubst): when the
		// verifier later replays this proof, it re-derives σ per hypothesis
		// via strict one-way matching and merges with strict equality. If the
		// prover's bidirectional unifier accepted a candidate whose extra
		// bindings don't fully propagate into the children's stored stmts,
		// the verifier rejects — and the search keeps generating more such
		// candidates, causing the imbi1d-class OOM. Filter here using the
		// same primitives (ruMatchExp + ruMergeSubst) the verifier uses, so
		// only candidates the verifier will actually accept survive.
		check_consistent = \theta : RuSubst, children_data : [RuProverProofHyp] -> {
			n_hyps = length(prop.assertion.infer.hyps);
			n_kids = length(children_data);
			if (n_hyps != n_kids) Some(ruEmptySubst) else {
				foldi(prop.assertion.infer.hyps, Some(ruEmptySubst), \i, acc, hyp -> {
					maybeBind(acc, \acc_sub -> {
						// Match the way the verifier will: pristine assertion-hyp
						// pattern on the right (its vars are what get bound);
						// the child's stmt as the verifier will see it (theta
						// applied) on the left. Pre-substituting theta into the
						// pattern would over-constrain — it eliminates ass vars
						// that the verifier would have happily bound during
						// matching, causing false rejects.
						expected = ruExp(hyp.stmt.exps[0]);
						actual   = ruApplySubst(ruExp(children_data[i].stmt.exps[0]), theta);
						maybeBind(
							ruMatchExp(actual, expected, prover_env.math, prover_env.env),
							\sigma_i -> ruMergeSubst(acc_sub, sigma_i)
						);
					});
				});
			}
		};
		new_proofs = filtermap(unified,
			\unif -> maybeBind(ruCompose(prop.sub, unif.sub), \theta ->
				// The assertion's $d are over ITS variables, which live in prop.outer (bound
				// ones to expressions, unbound ones to fresh vars) — theta's domain is the
				// goal's variables. Checking theta alone never found a binding and never
				// fired, so $d-violating variants propagated to the root and failed only at
				// reconstruction (nfcvf via nfnaew). Compose as ruMakeProofTree does.
				if (ruVariantStepDisjs(ruUnsafeCompose(prop.outer, theta), prop.assertion.infer.vars.disjs, prover_env.fns.unconst) == None()) None() else
				if (check_consistent(theta, unif.data) == None()) None() else {
					Some(RuProverProofProp(prop, theta, unif.data));
				}
			)
		);
		// Deduplicate by resulting substitution AND disjoint-variable requirements.
		// Distinct child proof-subtree selections that compose to the SAME theta give the
		// same parent statement (ruBuildPropProofs builds it purely from proof.sub), so
		// keeping more than one per theta only multiplies combinatorially up the tree —
		// EXCEPT that two such variants can differ in the $d conditions their steps need
		// (equcoms: the stored proof's equcomi vs the alternative equcomiv, same theta;
		// dedup kept equcomiv, the single root proof then failed the theorem's $d check —
		// a completeness loss found by the oracle test with others=-1). So variants with
		// equal theta are merged only when their $d requirements are equal too; the $d
		// set is computed only on a theta collision. Seed with the props already stored
		// so re-entrant calls stay deduped.
		seen : ref Tree<string, [RuProverProofProp]> = ref makeTree();
		iterVector(prop.proofs, \p : RuProverProofProp -> {
			seen := treePushToArrayValue(^seen, ruProofSubKey(p.sub), p);
		});
		iter(new_proofs, \p : RuProverProofProp -> {
			k = ruProofSubKey(p.sub);
			same : [RuProverProofProp] = lookupTreeDef(^seen, k, []);
			dup : bool = if (same == []) false else {
				switch (ruProofVariantDisjs(p, prover_env)) {
					None(): false;
					Some(dn): exists(same, \q : RuProverProofProp -> switch (ruProofVariantDisjs(q, prover_env)) {
						Some(dq): ruEqualDisjs(dn, dq);
						None():   false;
					});
				}
			}
			if (!dup) {
				seen := treePushToArrayValue(^seen, k, p);
				pushVector(prop.proofs, p);
			} else if (prover_env.env.conf.verbose >= 4) {
				prover_env.env.out.println("  dedup: merged a variant of " + id2s(prop.assertion.info.id) + " (same theta and $d), children: " +
					strGlue(map(p.children, \ch -> switch (ch) {
						RuProverProofStmt(__,__,__, c): id2s(c.node.assertion.info.id);
						RuProverProofTop(__,__,__,__): "premise";
						RuProverProofForward(__,__,__,__): "forward";
					}), ", ") + "; $d new={" + eitherMap(ruProofVariantDisjs(p, prover_env), ruDisjs2s, "?") + "} kept={" +
					strGlue(map(same, \q -> eitherMap(ruProofVariantDisjs(q, prover_env), ruDisjs2s, "?")), " / ") + "}" +
					"; outer of child0: " + switch (p.children[0]) {
						RuProverProofStmt(__,__,__, c): ruSubst2s(c.node.outer, prover_env.math) + " theta: " + ruSubst2s(c.sub, prover_env.math);
						default: "-";
					});
			} else {};
		});
	}
}

// The disjoint-variable conditions a proof variant needs: each applied assertion's $d
// instantiated by that step's substitution, over the whole variant subtree. None when the
// variant contains a forward splice (its $d are not derived here) — such variants are
// never merged with others. Only computed on a theta collision in ruAddProof.
ruProofVariantDisjs(p : RuProverProof, prover_env : RuProverEnv) -> Maybe<Set<RuDisj>> {
	switch (p) {
		RuProverProofTop(__,__,__,__): Some(makeSet());
		RuProverProofStmt(__,__,__, child): ruProofVariantDisjs(child, prover_env);
		RuProverProofForward(__,__,__,__): None();
		RuProverProofProp(node, theta, children): {
			own = ruVariantStepDisjs(ruUnsafeCompose(node.outer, theta), node.assertion.infer.vars.disjs, prover_env.fns.unconst);
			fold(children, own, \acc, ch -> maybeBind(acc, \a ->
				maybeMap(ruProofVariantDisjs(ch, prover_env), \d -> mergeSets(a, d))
			));
		}
	}
}

// One step's $d under its full substitution (outer composed with theta): None on a
// violation (the two sides share a variable), else the inherent $d pairs the step
// imposes on the variables of the goal. The theorem's variables are CONSTIFIED inside
// the engine, so they must be un-constified first — ruComputeDisjs on the raw
// expressions sees no variables at all and reports nothing (equcomiv's $d x y under
// x:=_y, y:=_x came out EMPTY, and so did nfcd's violated $d A y under A:=y).
ruVariantStepDisjs(composed : RuSubst, disjs : Set<RuDisj>, unconst : (RuExp) -> RuExp) -> Maybe<Set<RuDisj>> {
	foldSet(disjs, Some(makeSet()), \acc, disj -> maybeBind(acc, \a -> {
		e1_vars = ruExp2Vars(unconst(ruLookupSubstDef(composed, disj.v1)));
		e2_vars = ruExp2Vars(unconst(ruLookupSubstDef(composed, disj.v2)));
		if (!isEmptySet(intersectSets(e1_vars, e2_vars))) None() else {
			Some(foldSet(e1_vars, a, \a1, v1 -> foldSet(e2_vars, a1, \a2, v2 ->
				if (v1.id < v2.id) insertSet(a2, RuDisj(v1, v2)) else
				if (v2.id < v1.id) insertSet(a2, RuDisj(v2, v1)) else a2
			)));
		}
	}));
}

ruBuildPropProofs(prop : RuProverProp, proofs : Vector<RuProverProofProp>, prover_env : RuProverEnv) -> void {
	parent = prop.parent;
	new_proofs = synchronizedUnaryFn(parent.proofs, \proofs_ : Vector<RuProverProofProp> -> {
		n = sizeVector(parent.proofs);
		iterVector(proofs_, \proof -> {
			stmt_proof = RuProverProofStmt(
				parent,
				RuStmt(parent.stmt with
					exps = map(parent.stmt.exps, \ex -> ruApplySubst(ruExp(ex), proof.sub))
				),
				proof.sub,
				proof
			);
			// Variant admission (inert by default): dedup + per-node limit under the
			// completeness-test oracle, so backward propagation cannot pile duplicate
			// or over-limit variants onto this E-node.
			if (prover_env.fns.keepVariant(stmt_proof)) pushVector(parent.proofs, stmt_proof) else {};
		});
		vectorTailFrom(parent.proofs, n);
	})(proofs);
	switch (parent) {
		RuProverExp(__,__,ex,__,__): 
			ruBuildExpProofs(parent, new_proofs, prover_env);
		RuProverRoot(__,__,__):
			ruBuildRootProofs(parent, new_proofs, prover_env);
	}
}

ruBuildExpProofs(hyp : RuProverExp, proofs : Vector<RuProverProofHyp>, prover_env : RuProverEnv) -> void {
	parent = hyp.parent;
	new_proofs = synchronizedUnaryFn(parent.proofs, \proofs_ : Vector<RuProverProofHyp> -> {
		n = sizeVector(parent.proofs);
		iterVector(proofs, \proof -> ruAddProof(parent, proof, prover_env));
		vectorTailFrom(parent.proofs, n);
	})(proofs);
	ruBuildPropProofs(parent, new_proofs, prover_env);
}

ruBuildRootProofs(root : RuProverRoot, proofs : Vector<RuProverProofHyp>, prover_env : RuProverEnv) -> void {
	iterVector(proofs, \proof_ : RuProverProofHyp ->
		prover_env.fns.onProof(
			ruInlineFragments(
				ruMakeProofTree(proof_),
				prover_env.fragmentTrees,
				prover_env.math,
				prover_env.env
			)
		)
	);
}

ruCheckAddProofEquals(proofs1 : [RuSubData<[RuProverProofHyp]>], proofs2 : [RuSubData<[RuProverProofHyp]>], env : RuProverEnv) -> Pair<bool, [RuProverProofHyp]> {
	ret = ref true;
	err = ref [];
	if (length(proofs1) != length(proofs2)) {
		env.env.out.println("length(proofs1)=" + i2s(length(proofs1)) + " !=  length(proofs2)=" + i2s(length(proofs2)));
		ret := false;
	}
	iter(proofs1, \proof1 -> {
		switch (find(proofs2, \proof2 -> proof1.data == proof2.data)) {
			Some(proof2): {
				if (ruSubsAreSim(proof1.sub, proof2.sub) == None()) {
					env.env.out.println(
						"Subs differ:\n" + 
							strIndent(ruSubsDiff2s(proof1.sub, proof2.sub, env.math)) + "\n" +
						"sub1:\n" + strIndent(ruSubst2s(proof1.sub, env.math)) + "\n" + 
						"sub2:\n" + strIndent(ruSubst2s(proof2.sub, env.math))
					);
					ret := false;
					err := proof1.data;
				}
			}
			None(): {
				env.env.out.println("is absent(A):\n" + ruRuSubDataRuProverProofHyp2s(proof1, env));
				ret := false;
				err := proof1.data;
			}
		}
	});
	iter(proofs2, \proof2 -> 
		switch (find(proofs1, \proof1 -> proof1.data == proof2.data)) {
			Some(__): { }
			None(): {
				env.env.out.println("is absent (B):\n" + ruRuSubDataRuProverProofHyp2s(proof2, env));
				ret := false;
			}
		}
	);
	Pair(^ret, ^err);
}

ruCheckAddProofContains(proof1 : RuSubData<[RuProverProofHyp]>, proofs2 : [RuSubData<[RuProverProofHyp]>], env : RuProverEnv) -> bool {
	find(proofs2, \proof2 -> ruCheckAddProofAreEqual(proof1, proof2, env)) != None();
}

ruCheckAddProofAreEqual(proof1 : RuSubData<[RuProverProofHyp]>, proof2 : RuSubData<[RuProverProofHyp]>, env : RuProverEnv) -> bool {
	proof1 == proof2;
}

ruRuSubDataRuProverProofHyp2s(sub_data: RuSubData<[RuProverProofHyp]>, env : RuProverEnv) -> string {
	"data:\n" + 
		strIndent(superglue(sub_data.data, \hyp -> 
			ruProofTree2s(ruMakeProofTree(hyp), env.math), "\n"
		)) +
	"sub:\n" + 
		strIndent(ruSubst2s(sub_data.sub, env.math));
}
