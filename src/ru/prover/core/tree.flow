import ru/subst;
import ru/proof_tree;

export {
	ruMakeProofTree(proof : RuProverProof) -> RuProofTree;
	// Apply a substitution to every statement in a proof tree (used to specialise
	// a forward-derived proof to a backward leaf at the interior join).
	ruApplySubst2ProofNode(s : RuSubst, n : RuProofTree) -> RuProofTree;

	RuProverProof ::= RuProverProofHyp, RuProverProofProp;
	RuProverProofHyp ::= RuProverProofTop, RuProverProofStmt, RuProverProofForward;
		RuProverProofTop(
			node : RuProverHyp,
			stmt : RuStmt,
			premise : RuPremise,
			sub  : RuSubst,
		);
		RuProverProofStmt(
			node  : RuProverHyp,
			stmt  : RuStmt,
			sub   : RuSubst,
			child : RuProverProofProp,
		);
		// Closure-splice proof. Used when an open leaf unifies with a fact in
		// the shallow forward closure: instead of recursing backward, we splice
		// the fact's witness (rebuilt as a RuProofTree at insertion time) as
		// the leaf's sub-proof. The `proof` field already has σ_match composed
		// throughout — ruMakeProofTree just returns it.
		RuProverProofForward(
			node  : RuProverHyp,
			stmt  : RuStmt,
			sub   : RuSubst,
			proof : RuProofTree,
		);
		RuProverProofProp(
			node      : RuProverProp,
			sub       : RuSubst,
			children  : [RuProverProofHyp],
			// Memo of ruProofVariantDisjs (proofs.flow): the $d this variant needs. None =
			// not computed yet; Some(None) = not derivable (a forward splice inside).
			disjs     : ref Maybe<Maybe<Set<RuDisj>>>,
			// Memo of ruProofSubKey(sub) ("" = not computed): the dedup in ruAddProof rebuilt
			// the key of every stored variant on every call — quadratic per node under a
			// variant explosion (dffi3: 132 of 150 summed seconds).
			key       : ref string,
		);

	RuProverNode ::= RuProverHyp, RuProverProp;
	RuProverHyp ::= RuProverExp, RuProverRoot;
		RuProverProp(
			id        : int,
			assertion : RuAssertion,
			proofs    : Vector<RuProverProofProp>,
			// The raw unifier of the goal against the assertion's conclusion (from the index).
			// A CANDIDATE prop keeps only this: the split into `sub` (goal variables ->
			// expressions) and `outer` (assertion variables -> expressions / fresh variables)
			// is computed ONCE, when the prop is expanded (ruPropSubs) — a goal matches
			// ~1,800 assertions on set.mm and only the selected ones are ever expanded, so
			// splitting and renaming every candidate eagerly cost 4 substitutions and fresh
			// variables per candidate: millions per big theorem, out of heap on set.mm.
			unif      : RuSubst,
			split     : ref Maybe<Pair<RuSubst, RuSubst>>,
			children  : Vector<RuProverExp>,
			parent    : RuProverHyp,
			// "" until expanded; once expanded, the tag of the DSL atom that
			// expanded this prop (e.g. "spr", "bounded-bfs", "?" if untagged).
			expanded  : ref string,
			// The proof-variant dedup table of this prop (ruAddProof), kept across calls:
			// theta hash -> the distinct thetas seen, one representative each.
			dedup     : ref Tree<string, [RuThetaGroup]>
		);
		// One distinct theta among a prop's proof variants: a representative, the members
		// (same theta, pairwise different $d needs) and their $d keys, computed lazily on
		// the first collision.
		RuThetaGroup(
			rep     : RuProverProofProp,
			members : ref [RuProverProofProp],
			dkeys   : ref Maybe<Set<string>>
		);
		RuProverExp(
			ind      : int,
			proofs   : Vector<RuProverProofHyp>,
			stmt     : RuStmt,
			children : Vector<RuProverProp>,
			parent   : RuProverProp
		);
		RuProverRoot(
			proofs   : Vector<RuProverProofHyp>,
			stmt     : RuStmt,
			children : Vector<RuProverProp>
		);

	RuProverNodeSnapshot(
		proofs   : int,
		expanded : bool
	);
	RuProverTreeSnapshot(
		tree : Tree<int, RuProverNodeSnapshot>,
		root : RuProverNodeSnapshot
	);
	RuProverTreeDiff(
		nodes : [RuProverProp],
		root : Maybe<RuProverRoot>
	);

	RuProverTree(
		leafs : Tree<int, RuProverProp>,
		nodes : Tree<int, RuProverProp>,
		root  : RuProverRoot,
		proofs : ref [RuProof],
	);

	ruProverNode2s(node : RuProverNode, math : RuMath) -> string;
	ruProverTree2s(node : RuProverNode, math : RuMath, small : bool) -> string;
	ruProverNode2json(node : RuProverNode, math : RuMath, conf : RuConf) -> Json;
	ruProverTreeDiff2json(diff : RuProverTreeDiff, math : RuMath, conf : RuConf) -> Json;
	ruProverTree2json(node : RuProverTree, math : RuMath, conf : RuConf) -> Json;
	ruSizeProverTree(node : RuProverNode) -> int;

	ruProverNode2Snapshot(node : RuProverNode) -> RuProverNodeSnapshot;
	ruProverTree2Snapshot(tree : RuProverTree) -> RuProverTreeSnapshot;
	ruProverTreeDiff(snap : RuProverTreeSnapshot, tree : RuProverTree) -> RuProverTreeDiff;

	ruNoProverHyp = RuProverRoot(makeVector(0), ruNoStmt, makeVector(0));
	ruNoProverProp = RuProverProp(-1, ruNoAxiom, makeVector(0), ruEmptySubst, ref Some(Pair(ruEmptySubst, ruEmptySubst)), makeVector(0), ruNoProverHyp, ref "", ref makeTree());

	// The (sub, outer) split of a prop, computed on first use with the env's fresher.
	ruPropSubs(prop : RuProverProp, fresher : (RuVar) -> RuVar) -> Pair<RuSubst, RuSubst>;
	ruPropSub(prop : RuProverProp, fresher : (RuVar) -> RuVar) -> RuSubst;
	ruPropOuter(prop : RuProverProp, fresher : (RuVar) -> RuVar) -> RuSubst;
	// The split of an EXPANDED prop (already computed); crashes on a candidate.
	ruPropSubsForced(prop : RuProverProp) -> Pair<RuSubst, RuSubst>;

	ruProverTreeDepth(tree : RuProverTree) -> int;
	ruProverTreeSize(tree : RuProverTree) -> int;

	ruShowProverTreePath(tree : RuProverTree, path : [string], math : RuMath) -> string;


	ruTreeIsProved(tree : RuProverTree) -> bool;
	ruProverEnvProof(tree : RuProverTree) -> Maybe<RuProof>;
}

ruSizeProverTree(node : RuProverNode) -> int {
	1 + switch (node) {
		RuProverProp(__,__,__,__,__, children,__,__,__): foldVector(children, 0, \ac, ch -> ac + ruSizeProverTree(ch));
		RuProverExp(__,__,__, children,__): foldVector(children, 0, \ac, ch -> ac + ruSizeProverTree(ch));
		RuProverRoot(__,__, children): foldVector(children, 0, \ac, ch -> ac + ruSizeProverTree(ch));
	}
}

ruApplySubst2ProofNode(s : RuSubst, n : RuProofTree) {
	switch (n) {
		RuProofStep(ass, children, stmt):
			RuProofStep(
				ass, 
				map(children, \ch -> ruApplySubst2ProofNode(s, ch)), 
				RuStmt(stmt with
					exps = map(stmt.exps, \ex -> ruApplySubst(ruExp(ex), s))
				)
			);
		RuProofHyp(h, stmt): 
			RuProofHyp(h, RuStmt(stmt with exps = map(stmt.exps, \ex -> ruApplySubst(ruExp(ex), s))));
	}
}

ruMakeProofTree(proof : RuProverProof) -> RuProofTree {
	switch (proof) {
		RuProverProofTop(node, stmt, hyp, sub): RuProofHyp(hyp.ind, stmt);
		RuProverProofStmt(node, stmt, sub, child): ruMakeProofTree(child);
		RuProverProofForward(node, stmt, sub, spliced): spliced;
		RuProverProofProp(node, sub, children, __, __): {
			// Build the step stmt. Strategy depends on whether this is the ROOT-level step:
			// - ROOT (parent is RuProverRoot): use the root's stmt directly. The root stmt is
			//   c_task.const.goal (const-form of th.infer.prop) which has the correct types.
			//   After external unconst this equals th.infer.prop exactly, satisfying ruEqualStmts.
			// - Non-ROOT (parent is RuProverExp): use node.assertion.infer.prop with the
			//   composed substitution ruUnsafeCompose(node.outer, sub). node.outer maps
			//   assertion vars (e.g. xX→[VEV,_x_const]) and sub (theta) maps prover vars.
			//   ruUnsafeCompose chains them so ph4→ph4_1→(\not _ph2), preserving correct
			//   types (e.g. [VP,[VEV,x]] where assertion prop uses [VP,xX]:Pattern).
			step_stmt = switch (node.parent) {
				RuProverRoot(__, s1, __): {
					// s1 is already const-form of th.infer.prop — use it directly.
					RuStmt(s1 with exps = map(s1.exps, \ex -> ruApplySubst(ruExp(ex), sub)));
				}
				RuProverExp(__,__,__,__,__): {
					composed_sub = ruUnsafeCompose(ruPropSubsForced(node).second, sub);
					RuStmt(node.assertion.infer.prop with
						exps = map(node.assertion.infer.prop.exps, \ex -> ruApplySubst(ruExp(ex), composed_sub))
					);
				}
			};
			RuProofStep(
				node.assertion.info.id,
				map(children, \ch -> ruApplySubst2ProofNode(sub, ruMakeProofTree(ch))),
				step_stmt,
			);
		}
	}
}

ruProverNode2s(node : RuProverNode, math : RuMath) -> string {
	switch (node) {
		RuProverProp(id, ass, proofs, unif, spl, children, parent, expanded, __):
			"Prop<" + 
				"id=" + i2s(id) + ", " +
				"ass=" + id2s(ass.info.id) + ", " + 
				"proofs_num=" + i2s(sizeVector(proofs)) + ", " + 
				"children_num=" + i2s(sizeVector(children)) + ", " + 
				"expanded=" + ^expanded +
			">" + 
			(if (sizeVector(proofs) == 0) "" else
				"\n" + strIndent(strGlue(map(vector2array(proofs), \p -> ruProofTree2s(ruMakeProofTree(p), math)), "\n"))
			);
		RuProverExp(ind, proofs, expr, children, parent):
			"Hyp<" + "ind=" + i2s(ind) + ", " +"expr=" + ru2s(expr, math) + ", proofs_num=" + i2s(sizeVector(proofs)) + ", children num:" + i2s(sizeVector(children)) + ">" + 
			(if (sizeVector(proofs) == 0) "" else
				"\n" + strIndent(strGlue(map(vector2array(proofs), \p -> ruProofTree2s(ruMakeProofTree(p), math)), "\n"))
			);
		RuProverRoot(proofs, expr, children):
			"Root<" + "expr=" + ru2s(expr, math) + ", proofs_num=" + i2s(sizeVector(proofs)) + ", children num:" + i2s(sizeVector(children)) + ">" + 
			(if (sizeVector(proofs) == 0) "" else
				"\n" + strIndent(strGlue(map(vector2array(proofs), \p -> ruProofTree2s(ruMakeProofTree(p), math)), "\n"))
			);
	}
}

ruProverTree2s(node : RuProverNode, math : RuMath, small : bool) -> string {
	get_proofs = \n -> switch (n) {
		RuProverProp(id, ass, proofs, unif, spl, children, parent, expanded, __): proofs;
		RuProverExp(ind, proofs, expr, children, parent): proofs;
		RuProverRoot(proofs, expr, children): proofs;
	}
	ruProverNode2s(node, math) + 
	(if (sizeVector(node.children) == 0) "" else {
		all_children : [RuProverNode] = switch (node) {
			RuProverProp(id, ass, proofs, unif, spl, children, parent, expanded, __): vector2array(children);
			RuProverExp(ind, proofs, expr, children, parent): vector2array(children);
			RuProverRoot(proofs, expr, children): vector2array(children);
		}
		//all_children = vector2array(node.children);
		cildren_to_output = 
			if (!small || sizeVector(get_proofs(node)) == 0) all_children else 
			filter(all_children, \ch -> sizeVector(get_proofs(ch)) > 0);
		"\n" + strIndent(
			strGlue(
				map(cildren_to_output, \ch -> ruProverTree2s(ch, math, small)), 
				//map(vector2array(node.children), \ch -> ruProverTree2s(ch, math)), 
				"\n"
			)
		)
	});
}

ruProverNode2json(node : RuProverNode, math : RuMath, conf : RuConf) -> Json {
	maxlen = s2i(ruOptsString(conf.opts, "maxlen-expr", "32"));
	switch (node) {
		RuProverProp(ind, ass, proofs, unif, spl, children, parent, expanded, __): {
			// an expanded prop shows its goal-side substitution; a candidate its raw unifier
			sub = switch (^spl) { Some(p): p.first; None(): unif; };
			expr = ruApplySubst(ruExp(parent.stmt.exps[0]), sub);
			tooltip = ru2s(ass, math);
			JsonObject([
				Pair("id", JsonDouble(i2d(ind))),
				Pair("assertion", JsonString(id2s(ass.info.id))),
				Pair("proofs", JsonArray(map(vector2array(proofs), \proof ->
					JsonString(ru2sWrapExp(
							ruApplySubst(expr, proof.sub), 
							math, \s -> ruIndentBrackets(s, maxlen)
					))
				))),
				Pair("children", JsonArray(map(vector2array(children), \ch -> ruProverNode2json(ch, math, conf)))),
				Pair("grand", JsonDouble(i2d(
					switch (parent) {
						RuProverExp(__,__,__,__,grand): grand.id;
						RuProverRoot(__,__,__): -1;
					}
				))),
				Pair("expanded", JsonBool(^expanded != "")),
			Pair("expanded_by", JsonString(^expanded)),
				Pair("tooltip", JsonString(tooltip)),
			]);
		}
		RuProverExp(ind, proofs, expr, children, parent): {
			expr_plain = ru2sWrapExp(expr, math, idfn);
			expr_multyline = ru2sWrapExp(expr, math, \s -> ruIndentBrackets(s, maxlen));
			JsonObject([
				Pair("ind", JsonDouble(i2d(ind))),
				Pair("expr_plain", JsonString(expr_plain)),
				Pair("expr_multyline", JsonString(expr_multyline)),
				Pair("proofs", JsonArray(map(vector2array(proofs), \proof -> 
					JsonString(ru2sWrapExp(
							proof.stmt, 
							math, \s -> ruIndentBrackets(s, maxlen)
					))
				))),
				Pair("children", JsonArray(map(vector2array(children), \ch -> JsonDouble(i2d(ch.id))))),
				Pair("parent", JsonDouble(i2d(parent.id))),
				Pair("tooltip", JsonString(expr_multyline)),
			]);
		}
		RuProverRoot(proofs, expr, children): {
			expr_plain = ru2sWrapExp(expr, math, idfn);
			expr_multyline = ru2sWrapExp(expr, math, \s -> ruIndentBrackets(s, maxlen));
			JsonObject([
				Pair("expr_plain", JsonString(expr_plain)),
				Pair("expr_multyline", JsonString(expr_multyline)),
				Pair("proofs", JsonArray(map(vector2array(proofs), \root -> {
					tree = ruMakeProofTree(root);
					linear = ruMakeLinearProof(tree);
					//steps = map(linear, \step -> RuStep(step with expr = prover_env.fns.unconst(step.expr)));
					proof = RuProof(ruEmptyVarsDisjs, linear, -1);
					JsonString(ru2sWrapExp(
							proof, 
							math, \s -> ruIndentBrackets(s, maxlen)
					));
				}))),
				Pair("children", JsonArray(map(vector2array(children), \ch -> JsonDouble(i2d(ch.id))))),
				Pair("tooltip", JsonString(expr_multyline)),
			]);
		}
	}
}

ruProverTree2json(tree : RuProverTree, math : RuMath, conf : RuConf) -> Json {
	JsonObject([
		Pair("nodes", JsonArray(map(getTreeValues(tree.nodes), \leaf -> ruProverNode2json(leaf, math, conf)))),
		Pair("root", ruProverNode2json(tree.root, math, conf)),
	]);
}

ruProverTreeDiff2json(diff : RuProverTreeDiff, math : RuMath, conf : RuConf) -> Json {
	nodes_json = JsonArray(map(diff.nodes, \leaf -> ruProverNode2json(leaf, math, conf)));
	switch (diff.root) {
		Some(root): {
			JsonObject([
				Pair("nodes", nodes_json),
				Pair("root", ruProverNode2json(root, math, conf))
			]);
		}
		None(): {
			JsonObject([
				Pair("nodes", nodes_json),
			]);
		}
	}
}

ruProverNode2Snapshot(node : RuProverNode) -> RuProverNodeSnapshot {
	switch (node) {
		RuProverProp(__,__,proofs,__,__,__,__,expanded, __): RuProverNodeSnapshot(sizeVector(proofs), ^expanded != "");
		RuProverExp(__,proofs,__,__,__): RuProverNodeSnapshot(sizeVector(proofs), true);
		RuProverRoot(proofs,__,__): RuProverNodeSnapshot(sizeVector(proofs), true);
	}
}

ruProverTree2Snapshot(tree : RuProverTree) -> RuProverTreeSnapshot {
	RuProverTreeSnapshot(
		mapTree(tree.nodes, ruProverNode2Snapshot),
		ruProverNode2Snapshot(tree.root)
	);
}

ruProverTreeDiff(snap : RuProverTreeSnapshot, tree : RuProverTree) -> RuProverTreeDiff {
	RuProverTreeDiff(
		filter(getTreeValues(tree.nodes), \n ->
			switch (lookupTree(snap.tree, n.id)) {
				Some(s): s != ruProverNode2Snapshot(n);
				None(): true;
			}
		),
		if (snap.root != ruProverNode2Snapshot(tree.root)) Some(tree.root) else None()
	);
}

ruProverTreeDepth(tree : RuProverTree) -> int {
	ruDoProverTreeDepth(tree.root, 0);
}

// Child lists are appended by CONCURRENT expansion workers while a tactic (the `limited`
// combinator's keep_expanding) measures the depth from inside a worker: an unlocked fold
// could read a slot the writer had reserved but not yet filled (a NullPointerException in
// test/all step 2). Snapshot each list under the same lock the writers take.
ruDoProverTreeDepth(node : RuProverNode, depth : int) -> int {
	kids : [RuProverNode] = switch (node) {
		RuProverProp(__,__,__,__,__, children,__,__,__): map(ruVectorSnapshot(children), \c -> cast(c : RuProverExp -> RuProverNode));
		RuProverExp(__,__,__, children,__): map(ruVectorSnapshot(children), \c -> cast(c : RuProverProp -> RuProverNode));
		RuProverRoot(__,__, children): map(ruVectorSnapshot(children), \c -> cast(c : RuProverProp -> RuProverNode));
	};
	fold(kids, depth, \acc, n -> {
		d = ruDoProverTreeDepth(n, depth + 1);
		if (d > depth) d else acc;
	});
}

ruVectorSnapshot(v : Vector<?>) -> [?] {
	synchronizedUnaryFn(v, vector2array)(v);
}

ruProverTreeSize(tree : RuProverTree) -> int {
	sizeTree(tree.nodes);
}

ruShowProverTreePath(tree : RuProverTree, path : [string], math : RuMath) -> string {
	ruDoShowProverTreePath(tree.root, path, math, "");
}

ruDoShowProverTreePath(node : RuProverNode, path : [string], math : RuMath, acc0 : string) -> string {
	if (length(path) == 0) acc0 else {
		acc = if (acc0 == "") path[0] + ": " else acc0 + "\n" + path[0] + ": ";
		switch (node) {
			RuProverExp(ind,__,__,children,__): {
				switch (find(vector2array(children), \ch -> id2s(ch.assertion.info.id) == path[0])) {
					Some(prop): {
						ruDoShowProverTreePath(prop, tail(path), math, acc + ruProverNode2s(prop, math));
					}
					None(): acc + "<NOT PRESSENT: " + path[0] + ">";
				}
			}
			RuProverProp(ind,__,__,__,__,children,__,__,__): {
				switch (find(vector2array(children), \ch -> ch.ind == s2i(path[0]))) {
					Some(hyp): {
						ruDoShowProverTreePath(hyp, tail(path), math, acc + ruProverNode2s(hyp, math));
					}
					None(): acc + "<NOT PRESSENT: " + path[0] + ">";
				}
			}
			RuProverRoot(__,__,children): {
				switch (find(vector2array(children), \ch -> id2s(ch.assertion.info.id) == path[0])) {
					Some(prop): {
						ruDoShowProverTreePath(prop, tail(path), math, acc + ruProverNode2s(prop, math));
					}
					None(): acc + "<NOT PRESSENT: " + path[0] + ">";
				}
			}
		}
	}
}

ruTreeIsProved(tree : RuProverTree) -> bool {
	length(^(tree.proofs)) > 0;
}

ruProverEnvProof(tree : RuProverTree) -> Maybe<RuProof> {
	proofs = ^(tree.proofs);
	if (length(proofs) == 0) None() else {
		Some(fold(tail(proofs), proofs[0], \acc, proof -> 
			if (length(proof.steps) < length(acc.steps)) proof else acc
		));
	}
}


ruPropSubs(prop : RuProverProp, fresher : (RuVar) -> RuVar) -> Pair<RuSubst, RuSubst> {
	switch (^(prop.split)) {
		Some(p): p;
		None(): {
			a_vars = ruAssertion2Vars(prop.assertion);
			fresh = ruMakeFresherSubst(
				foldSet(a_vars, [], \ac, v -> if (ruSubstMapsVar(prop.unif, v.id)) ac else concat(ac, [v])),
				fresher
			);
			s_all = ruUnsafeCompose(prop.unif, fresh);
			p = Pair(
				ruFilterSub(s_all, \v,__ -> !containsSet(a_vars, v)),
				ruFilterSub(s_all, \v,__ -> containsSet(a_vars, v))
			);
			prop.split := Some(p);
			p;
		}
	}
}

ruPropSub(prop : RuProverProp, fresher : (RuVar) -> RuVar) -> RuSubst {
	ruPropSubs(prop, fresher).first;
}

ruPropOuter(prop : RuProverProp, fresher : (RuVar) -> RuVar) -> RuSubst {
	ruPropSubs(prop, fresher).second;
}

ruPropSubsForced(prop : RuProverProp) -> Pair<RuSubst, RuSubst> {
	switch (^(prop.split)) {
		Some(p): p;
		None(): {
			ruCrash("ruPropSubsForced: the prop " + i2s(prop.id) + " (" + id2s(prop.assertion.info.id) + ") was not expanded");
			Pair(ruEmptySubst, ruEmptySubst);
		}
	}
}
