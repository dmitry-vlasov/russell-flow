import ru/prover/tactics/rule_table;
import ru/prover/core/forward;
import ru/prover/core/proofs;
import ru/prover/core/env;
import ru/subst;
import base/ids;

// ---------------------------------------------------------------------------
// THE GENERIC APPLIER (L2) — P2 of the rule-table plan.
//
// One guarded closer applies ANY table rule instead of a per-family channel:
// the goal literal is matched against a rule's conclusion, the remaining
// antecedents are solved left-to-right — a still-open (non-ground) antecedent
// is completed against the pooled facts (that is the trans-chaining "find the
// middle B"), a ground one recurses into the full literal closer — and the
// application is assembled in DEDUCTION form automatically:
//   combiner (n-hyp rule)   → one step of its shape-matched d-form companion
//   0-hyp implication chain → instance + syl/mpd folding under the guard ψ
//   0-hyp direct match      → instance + a1i-lift
// Rules whose d-form is a HOLE, or with DV conditions (either form), are
// skipped — exactly the cases info/rule-table reports.
//
// Behind table-closer=1 (default OFF): with the flag off nothing here runs,
// so all floors are untouched. Selection is deterministic first-success (the
// channel discipline); recursion shares the literal closer's memo and cycle
// guard through the `close` callback. L1 law: core/ never imports this file.
// ---------------------------------------------------------------------------

export {
	// table-closer=1 turns the generic applier on.
	ruTableCloserOn(prover_env : RuProverEnv) -> bool;

	// Prove ψ→x from the pooled guarded facts (each: proof of ψ→atom, atom nodes)
	// by applying table rules. `close` re-enters the full literal closer
	// (memoized, cycle-guarded) for ground subgoals.
	ruTableClose(pool : [Pair<RuProofTree, [RuExpNode]>], psi : RuExp, x : [RuExpNode],
		stcl : int, depth : int, close : ([RuExpNode], int) -> Maybe<RuProofTree>,
		prover_env : RuProverEnv) -> Maybe<RuProofTree>;
}

ruTableCloserOn(prover_env : RuProverEnv) -> bool {
	ruOptsString(prover_env.env.conf.opts, "table-closer", "") == "1";
}

// ---- the application index -----------------------------------------------------
//
// A table rule unpacked for application, keyed by the head of `concl` (what the
// goal is matched against); `antes` are solved by ruTcSolve:
//   RuTcComb  (nhyps>0): antes = the hyp patterns, applyId = the d-form companion
//   RuTcChain (nhyps==0): the prop peeled A1→(A2→…→C) one level at a time — one
//                         entry per peel depth (0 = direct match + a1i)
//   RuTcBiL/R (0-hyp ⊢L↔R): goal matches L (resp. R), antes = [the other side],
//                         concluded by mpbird (resp. mpbid) over the a1i-lifted instance
RuTcKind ::= RuTcComb, RuTcChain, RuTcBiL, RuTcBiR;
	RuTcComb(); RuTcChain(); RuTcBiL(); RuTcBiR();
RuTcEntry(assId : int, applyId : int, kind : RuTcKind, antes : [RuExp], concl : RuExp, ext : bool);
// Entries with a binary-atom conclusion whose FIRST argument is rule-headed are
// sub-indexed by (conclHead, arg0Head): a goal whose lhs head differs can never
// match them (identity entries — 547 under wceq — stop flooding every = literal).
// Var-lhs / non-binary conclusions go to the anyArg bucket, tried for every goal
// of that head.
RuTcIndex(byPair : Tree<Pair<int, int>, [RuTcEntry]>, anyArg : Tree<int, [RuTcEntry]>);

// EXTENDED ENTRIES (bicond unfolds + ∧-antecedent implications) — MEASURED OFF:
// they duplicate routes the dispatcher already tries (sstr repeats the sstri
// combiner, the ssdif0 bicond repeats the dispatcher's own ssdif0 route), and on
// FAILING goals every redundant route re-pays its full recursion — zfmisc lost
// 6-8 theorems to the fixed wall-clock stage slices with them on. Turn back on
// only together with per-goal attempt budgets (the ⊊/eq0 family switches need
// them); the solver capabilities (∧-split, bare-var guard) stay — they are
// inert without entries that use them. History: −7 without budgets; −7 with
// budgets+dedup (bi subgoals re-entered the FULL closer); −1 with the CHEAP
// mode but still shadowing the hot ⊆/= heads (t85 squeezed at any budget).
// THE INDEX RULE (replace-not-shadow, structurally): extended entries are
// admitted ONLY for heads in ruTcExtendedHeads — the heads whose channel
// family has switched to the table. A head joins the list when its family is
// deleted, never before.
ruTcExtendedEntries = true;
ruTcExtendedHeads() -> Set<int> { buildSet([s2id("wpss"), s2id("wceq"), s2id("wne"), s2id("wcel")]) }

ruTcIndexCache : ref [Pair<int, RuTcIndex>] = ref [];

ruTcIndex(math : RuMath) -> RuTcIndex {
	n = sizeTree(math.decls.assertions);
	c = ^ruTcIndexCache;
	if (c != [] && c[0].first == n) c[0].second else {
		idx = ruTcBuild(math);
		ruTcIndexCache := [Pair(n, idx)];
		idx;
	}
}

ruTcInfer(a : RuAssertion) -> RuInference {
	switch (a) {
		RuAxiom(__, i): i; RuCong(__, i): i; RuTheorem(__, i, __, __): i; RuDef(__, i, __, __): i;
	}
}

ruTcHead(e : RuExp) -> int {
	switch (e.nodes[0]) { RuRuleNode(it, __): ruIdType2Id(it); RuVar(__, __): -1; }
}

ruTcBuild(math : RuMath) -> RuTcIndex {
	table = ruRuleTable(math);
	wiId = s2id("wi");
	// pass 1: the combiner matrix keys — an imp-and rule duplicating one is skipped.
	// Gated: this scan costs real time INSIDE the first theorem's stage slice
	// (the index builds lazily), and only the extended entries consume it.
	combKeys = fold(if (ruTcExtendedEntries) table.all else [], makeSet(), \ks, r ->
		if (r.nhyps == 0 || r.hasDisjs) ks
		else switch (lookupTree(math.decls.assertions, r.assId)) {
			None(): ks;
			Some(ass): {
				inf = ruTcInfer(ass);
				insertSet(ks, ruRtCanonKey(arrayPush(map(inf.hyps, \h -> ruExp(h.stmt.exps[0])), ruExp(inf.prop.exps[0]))));
			}
		});
	byHead = fold(table.all, RuTcAcc(makeTree(), makeTree()), \acc, r -> {
		if (r.hasDisjs) acc   // DV-carrying rules are P2-skipped (the applier declares no DVs)
		else if (!ruTcExtendedEntries && (r.role == RuRoleImpAnd() || r.role == RuRoleCondFact())) acc
		else if (ruTcExtendedEntries && r.role == RuRoleImpAnd()
			&& (ruTcImpAndDup(math, r, combKeys) || !containsSet(ruTcExtendedHeads(), r.head))) acc
		else if (ruTcExtendedEntries && r.role == RuRoleCondFact()
			&& !containsSet(ruTcExtendedHeads(), r.head)) acc
		else switch (lookupTree(math.decls.assertions, r.assId)) {
			None(): acc;
			Some(ass): {
				inf = ruTcInfer(ass);
				prop = ruExp(inf.prop.exps[0]);
				hyps = map(inf.hyps, \h -> ruExp(h.stmt.exps[0]));
				if (r.nhyps > 0) {
					// combiner: needs a DV-free d-form companion
					switch (r.dform) {
						RuDFormFound(did): switch (lookupTree(math.decls.assertions, did)) {
							None(): acc;
							Some(dass): if (!isEmptySet((ruTcInfer(dass)).vars.disjs)) acc
								else ruTcPush(acc, RuTcEntry(r.assId, did, RuTcComb(), hyps, prop, false));
						}
						default: acc;
					}
				} else {
					// 0-hyp: one entry per wi-peel depth (0..3), conclusion rule-headed
					ac1 = ruTcPeel(r.assId, [], prop, acc, wiId, r.role == RuRoleImpAnd() || r.role == RuRoleCondFact());
					// ⊢ cond → (L ↔ R): the CONDITIONAL BICOND (eleq1-class atom
					// congruences) — goal matches a side; antes = [cond, other side];
					// assembly = syl the condition through the instance, then mpbid/mpbird.
					// Same gating as plain biconds: matched-side head must be in the gate.
					ac1b = if (ruTcExtendedEntries && ruTcHead(prop) == wiId && ruInArity(prop) == 2) {
						wpa = ruInArgs(prop);
						cond = wpa[0];
						cbi = wpa[1];
						if (ruTcHead(cond) >= 0 && ruTcHead(cond) != wiId
							&& ruTcHead(cbi) == s2id("wb") && ruInArity(cbi) == 2) {
							cba = ruInArgs(cbi);
							walId0 = s2id("wal"); wexId0 = s2id("wex");
							hs0 = ruTcExtendedHeads();
							binder0 = \sd : RuExp -> ruTcHead(sd) == walId0 || ruTcHead(sd) == wexId0;
							if (ruTcHead(cba[0]) >= 0 && ruTcHead(cba[1]) >= 0
								&& ruTcHead(cba[0]) != ruTcHead(cba[1])) {
								ac1x = if (binder0(cba[1]) || !containsSet(hs0, ruTcHead(cba[0]))) ac1
									else ruTcPush(ac1, RuTcEntry(r.assId, r.assId, RuTcBiL(), [cond, cba[1]], cba[0], true));
								if (binder0(cba[0]) || !containsSet(hs0, ruTcHead(cba[1]))) ac1x
								else ruTcPush(ac1x, RuTcEntry(r.assId, r.assId, RuTcBiR(), [cond, cba[0]], cba[1], true));
							} else ac1;
						} else ac1;
					} else ac1;
					// ⊢ L ↔ R additionally applies as an unfold in both directions
					// (goal = one side, prove the other, mpbird/mpbid) — dfpss2, velsn.
					// A BINDER-headed side (df-ss/dfcleq's ∀-form) is excluded: recursing
					// into a pointwise ∀-subgoal on every ⊆/= literal fails SLOWLY and
					// burned the zfmisc stage slices (−7 theorems); the extensionality
					// machinery owns that route, not the literal closer.
					if (ruTcExtendedEntries && ruTcHead(prop) == s2id("wb") && ruInArity(prop) == 2) {
						pa = ruInArgs(prop);
						walId = s2id("wal"); wexId = s2id("wex");
						hs = ruTcExtendedHeads();
						binder = \s : RuExp -> ruTcHead(s) == walId || ruTcHead(s) == wexId;
						if (ruTcHead(pa[0]) >= 0 && ruTcHead(pa[1]) >= 0
							// symmetric biconds (eqcom: both sides same head) would emit
							// self-head flip entries — flips are the pool closure's job
							&& ruTcHead(pa[0]) != ruTcHead(pa[1])) {
							ac2 = if (binder(pa[1]) || !containsSet(hs, ruTcHead(pa[0]))) ac1b
								else ruTcPush(ac1b, RuTcEntry(r.assId, r.assId, RuTcBiL(), [pa[1]], pa[0], true));
							if (binder(pa[0]) || !containsSet(hs, ruTcHead(pa[1]))) ac2
							else ruTcPush(ac2, RuTcEntry(r.assId, r.assId, RuTcBiR(), [pa[0]], pa[1], true));
						} else ac1b;
					} else ac1b;
				}
			}
		}
	});
	// bicond unfolds are the expensive tail (a recursive subgoal per attempt) —
	// try direct/chain/combiner entries first, bi entries last (per bucket)
	biLast = \es : [RuTcEntry] -> concat(filter(es, \e -> !ruTcIsBi(e)), filter(es, ruTcIsBi));
	RuTcIndex(mapTree(byHead.byPair, biLast), mapTree(byHead.anyArg, biLast));
}

// Is this ∧-antecedent implication a duplicate of an existing combiner?
// (P1 ∧ P2) → C duplicates the combiner P1, P2 ⊢ C — same canonical matrix.
ruTcImpAndDup(math : RuMath, r : RuTableRule, combKeys : Set<string>) -> bool {
	switch (lookupTree(math.decls.assertions, r.assId)) {
		None(): false;
		Some(ass): {
			prop = ruExp((ruTcInfer(ass)).prop.exps[0]);
			if (ruTcHead(prop) != s2id("wi") || ruInArity(prop) != 2) false
			else {
				pa = ruInArgs(prop);
				if (ruTcHead(pa[0]) != s2id("wa") || ruInArity(pa[0]) != 2) false
				else containsSet(combKeys, ruRtCanonKey(arrayPush(ruInArgs(pa[0]), pa[1])));
			}
		}
	}
}

RuTcAcc(byPair : Tree<Pair<int, int>, [RuTcEntry]>, anyArg : Tree<int, [RuTcEntry]>);

ruTcPush(acc : RuTcAcc, e : RuTcEntry) -> RuTcAcc {
	h = ruTcHead(e.concl);
	if (h < 0) acc
	else {
		argHead = if (ruInArity(e.concl) == 2) ruTcHead((ruInArgs(e.concl))[0]) else -1;
		if (argHead >= 0) RuTcAcc(
			setTree(acc.byPair, Pair(h, argHead), arrayPush(lookupTreeDef(acc.byPair, Pair(h, argHead), []), e)),
			acc.anyArg)
		else RuTcAcc(acc.byPair,
			setTree(acc.anyArg, h, arrayPush(lookupTreeDef(acc.anyArg, h, []), e)));
	}
}

// Peel the implication chain of a 0-hyp rule: emit an entry at every depth —
// depth 0 is the direct match, each further level moves one antecedent out.
ruTcPeel(assId : int, antes : [RuExp], concl : RuExp, acc : RuTcAcc, wiId : int, ext : bool) -> RuTcAcc {
	ac1 = ruTcPush(acc, RuTcEntry(assId, assId, RuTcChain(), antes, concl, ext));
	if (length(antes) >= 3 || ruTcHead(concl) != wiId || ruInArity(concl) != 2) ac1
	else {
		ca = ruInArgs(concl);
		ruTcPeel(assId, arrayPush(antes, ca[0]), ca[1], ac1, wiId, ext);
	}
}

// ---- the closer ------------------------------------------------------------------

ruTcGround(e : RuExp) -> bool {
	!exists(e.nodes, \n -> switch (n) { RuVar(__, __): true; RuRuleNode(__, __): false; });
}

// THE PER-GOAL ATTEMPT BUDGET (the P3 cost law): the applier's failure mode is
// not wrong proofs but unbounded spend on FAILING goals — every entry can fan
// into pool enumeration × recursion with nothing but the per-theorem timer to
// stop it, and redundant routes re-pay that fan (zfmisc −6..−8 measured). One
// weighted budget per ruTableClose invocation caps the fan: 1 per matched entry
// attempt, 1 per pool-completion branch, 4 per recursion into the full closer.
// A bounded work budget on L2 selection — not a variant cap; completeness law intact.
ruTcAttemptBudget = 256;   // 64 truncated t85 (the 11k-call theorem); 256 measured safe

ruTableClose(pool : [Pair<RuProofTree, [RuExpNode]>], psi : RuExp, x : [RuExpNode],
	stcl : int, depth : int, close : ([RuExpNode], int) -> Maybe<RuProofTree>,
	prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	budget = ref ruTcAttemptBudget;
	ruTcClose(pool, psi, x, stcl, depth, close, budget, false, prover_env);
}

// THE CHEAP RECURSION MODE (cheap=true): subgoals of EXTENDED entries never
// re-enter the channel battery — each such re-entry is a fresh unbounded cost
// unit that made the extended entries lose 7 zfmisc theorems even under the
// budget. In cheap mode a subgoal is solved from the pool, the direct/chain/
// combiner entries, and nothing else; bi entries are skipped (no bi-in-bi
// ping-pong), and the budget is SHARED with the caller, so one top-level goal
// still spends at most one budget.
ruTcClose(pool : [Pair<RuProofTree, [RuExpNode]>], psi : RuExp, x : [RuExpNode],
	stcl : int, depth : int, close : ([RuExpNode], int) -> Maybe<RuProofTree>,
	budget : ref int, cheap : bool, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	if (depth <= 0 || ruTimeIsOver(prover_env.conf.timer)) None()
	else switch (x[0]) {
		RuVar(__, __): None();
		RuRuleNode(idT, __): {
			// a pooled fact verbatim — the channels' "premise fact" base case
			direct = fold(pool, None(), \ac : Maybe<RuProofTree>, f -> switch (ac) {
				Some(__): ac;
				None(): if (f.second == x) Some(f.first) else None();
			});
			switch (direct) {
				Some(__): direct;
				None(): {
					// a pooled BICOND fact with one side == the goal: close the other side,
					// conclude by mpbird/mpbid — generic for every head (the ↔-transport)
					wbId0 = s2id("wb");
					poolBi = if (cheap || depth <= 0) None() else fold(pool, None(), \acB : Maybe<RuProofTree>, f -> switch (acB) {
						Some(__): acB;
						None(): {
							fn = f.second;
							isBiF = length(fn) >= 3 && switch (fn[0]) {
								RuVar(__,__): false;
								RuRuleNode(idTf, __): ruIdType2Id(idTf) == wbId0;
							};
							if (!isBiF) None() else {
								fargs = ruInArgs(RuExp(fn, -1));
								fl = fargs[0].nodes;
								fr = fargs[1].nodes;
								if (fl == x) maybeMap(close(fr, depth - 1), \pr ->
									RuProofStep(s2id_("mpbird"), [pr, f.first],
										RuStmt(stcl, [ruFwdMkRule(s2id("wi"), tp2id_("wff"), [psi, RuExp(x, -1)])], -1)))
								else if (fr == x) maybeMap(close(fl, depth - 1), \pl ->
									RuProofStep(s2id_("mpbid"), [pl, f.first],
										RuStmt(stcl, [ruFwdMkRule(s2id("wi"), tp2id_("wff"), [psi, RuExp(x, -1)])], -1)))
								else None();
							}
						}
					});
					switch (poolBi) {
					Some(__): poolBi;
					None(): {
					idx = ruTcIndex(prover_env.math);
					h = ruIdType2Id(idT);
					goal0 = RuExp(x, -1);
					argHead = if (ruInArity(goal0) == 2) ruTcHead((ruInArgs(goal0))[0]) else -1;
					specific = if (argHead >= 0) lookupTreeDef(idx.byPair, Pair(h, argHead), []) else [];
					entries0 = concat(specific, lookupTreeDef(idx.anyArg, h, []));
					entries = if (cheap) filter(entries0, \e -> !ruTcIsBi(e)) else entries0;
					fold(entries, None(), \ac : Maybe<RuProofTree>, e -> switch (ac) {
						Some(__): ac;
						None(): if (^budget <= 0) None()
							else ruTcApply(e, pool, psi, goal0, stcl, depth, close, budget, cheap, prover_env);
					});
				}
				}
				}
			}
		}
	}
}

ruTcIsBi(e : RuTcEntry) -> bool {
	switch (e.kind) { RuTcBiL(): true; RuTcBiR(): true; default: false; }
}

ruTcApply(e : RuTcEntry, pool : [Pair<RuProofTree, [RuExpNode]>], psi : RuExp, goal : RuExp,
	stcl : int, depth : int, close : ([RuExpNode], int) -> Maybe<RuProofTree>,
	budget : ref int, cheap : bool, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	math = prover_env.math;
	env = prover_env.env;
	switch (ruMatchExp(goal, e.concl, math, env)) {
		None(): None();
		Some(sub0): {
			budget := ^budget - 1;
			// EXTENDED-origin entries (bi + imp-and) solve their subgoals in CHEAP mode
			// (pool + table only, shared budget); once cheap, always cheap
			cheapSolve = cheap || e.ext || ruTcIsBi(e);
			switch (ruTcSolve(e.antes, 0, sub0, [], pool, psi, stcl, depth, close, budget, cheapSolve, prover_env)) {
			None(): None();
			Some(solved): {
				children = solved.first;
				sub = solved.second;
				wff = tp2id_("wff");
				mkImp = \a, b -> ruFwdMkRule(s2id("wi"), wff, [a, b]);
				psiGoal = mkImp(psi, goal);
				instAntes = map(e.antes, \a -> ruApplySubst(a, sub));
				res = switch (e.kind) {
					RuTcComb(): {
						// one step of the d-form companion: children are ψ→Hᵢ in matrix order
						Some(RuProofStep(e.applyId, children, RuStmt(stcl, [psiGoal], -1)));
					}
					RuTcChain(): if (!forall(instAntes, ruTcGround)) None()   // an unbound rule var survived
					else {
						// rests[i] = the instantiated A_{i+1}→(…→C) tail after consuming i antecedents
						k = length(instAntes);
						rests = fold(reverseA(instAntes), [goal], \acc, a -> arrayPush(acc, mkImp(a, acc[length(acc) - 1])));
						restAt = \i : int -> rests[k - i];
						inst = RuProofStep(e.assId, [], RuStmt(stcl, [restAt(0)], -1));
						if (k == 0) Some(RuProofStep(s2id_("a1i"), [inst], RuStmt(stcl, [psiGoal], -1)))
						else {
							// syl for the first antecedent, mpd for the rest, all under ψ
							first = RuProofStep(s2id_("syl"), [children[0], inst],
								RuStmt(stcl, [mkImp(psi, restAt(1))], -1));
							Some(fold(enumFromTo(1, k - 1), first, \cur, i ->
								RuProofStep(s2id_("mpd"), [children[i], cur],
									RuStmt(stcl, [mkImp(psi, restAt(i + 1))], -1))));
						}
					}
					RuTcBiL(): ruTcBiStep(e, true, instAntes, children, goal, psi, psiGoal, stcl, math, env);
					RuTcBiR(): ruTcBiStep(e, false, instAntes, children, goal, psi, psiGoal, stcl, math, env);
				};
				if (isSome(res) && prover_env.env.conf.verbose >= 5) {
					kind2s = switch (e.kind) {
						RuTcComb(): " via " + id2s(e.applyId);
						RuTcChain(): "";
						RuTcBiL(): " [bi<-]";
						RuTcBiR(): " [bi->]";
					};
					prover_env.env.out.println("    tblClose: " + id2s(e.assId) + kind2s
						+ " -> " + ruSafeExp2s(goal, math.decls.lang));
				} else {};
				res;
			}
			}
		}
	}
}

// The bicond-unfold step. Plain bicond (1 antecedent): the goal matched one side
// of ⊢L↔R, children[0] proves ψ→(other side); the instance is a1i-lifted and
// mpbird (goal = L) / mpbid (goal = R) concludes. CONDITIONAL bicond
// (2 antecedents, ⊢cond→(L↔R)): children[0] proves ψ→cond, syl carries it
// through the instance to ψ→(L↔R), then children[1] concludes as above.
ruTcBiStep(e : RuTcEntry, goalIsLhs : bool, instAntes : [RuExp], children : [RuProofTree],
	goal : RuExp, psi : RuExp, psiGoal : RuExp, stcl : int, math : RuMath, env : RuEnv) -> Maybe<RuProofTree> {
	n = length(children);
	if (!forall(instAntes, ruTcGround) || n < 1 || n > 2 || n != length(instAntes)) None()
	else {
		wff = tp2id_("wff");
		mkImp = \a, b -> ruFwdMkRule(s2id("wi"), wff, [a, b]);
		other = instAntes[n - 1];
		bi = if (goalIsLhs) ruFwdMkRule(s2id("wb"), wff, [goal, other])
			else ruFwdMkRule(s2id("wb"), wff, [other, goal]);
		biStep = if (n == 1) RuProofStep(s2id_("a1i"),
				[RuProofStep(e.assId, [], RuStmt(stcl, [bi], -1))],
				RuStmt(stcl, [mkImp(psi, bi)], -1))
			else RuProofStep(s2id_("syl"), [children[0],
				RuProofStep(e.assId, [], RuStmt(stcl, [mkImp(instAntes[0], bi)], -1))],
				RuStmt(stcl, [mkImp(psi, bi)], -1));
		mp = if (goalIsLhs) s2id_("mpbird") else s2id_("mpbid");
		Some(RuProofStep(mp, [children[n - 1], biStep], RuStmt(stcl, [psiGoal], -1)));
	}
}

// Solve the antecedents left-to-right, backtracking over pool choices:
// a ∧-antecedent splits into its conjuncts (rebuilt by jca under the guard);
// non-ground → complete against a pooled fact (extends the substitution);
// ground → the pool verbatim, else the full literal closer (depth-damped).
// The antecedent worklist keeps (original index, pattern): a non-ground antecedent
// that cannot pool-match yet is DEFERRED to the back once (ssel states A⊆B before
// C∈A, but only the el-conjunct binds A) — children are reassembled in original
// positions afterwards (combiner/chain assembly depends on statement order).
ruTcSolve(antes : [RuExp], i0 : int, sub0 : RuSubst, children0 : [RuProofTree],
	pool : [Pair<RuProofTree, [RuExpNode]>], psi : RuExp, stcl : int, depth : int,
	close : ([RuExpNode], int) -> Maybe<RuProofTree>,
	budget : ref int, cheap : bool, prover_env : RuProverEnv) -> Maybe<Pair<[RuProofTree], RuSubst>> {
	switch (ruTcSolveW(mapi(antes, \ix, a -> Pair(ix, a)), sub0, makeTree(), 0, pool, psi, stcl, depth, close, budget, cheap, prover_env)) {
		None(): None();
		Some(solvedW): Some(Pair(map(enumFromTo(0, length(antes) - 1), \ix -> lookupTreeDef(solvedW.first, ix, RuProofHyp(-1, RuStmt(-1, [], -1)))), solvedW.second));
	}
}

ruTcSolveW(work : [Pair<int, RuExp>], sub : RuSubst, solved : Tree<int, RuProofTree>, defers : int,
	pool : [Pair<RuProofTree, [RuExpNode]>], psi : RuExp, stcl : int, depth : int,
	close : ([RuExpNode], int) -> Maybe<RuProofTree>,
	budget : ref int, cheap : bool, prover_env : RuProverEnv) -> Maybe<Pair<Tree<int, RuProofTree>, RuSubst>> {
	if (work == []) Some(Pair(solved, sub))
	else if (^budget <= 0) None()
	else {
		item = work[0];
		rest = tail(work);
		p = ruApplySubst(item.second, sub);
		waSplit = ruTcHead(p) == s2id("wa") && ruInArity(p) == 2;
		if (waSplit) {
			// (P ∧ Q): solve the conjuncts as sub-antecedents (P may bind vars Q needs),
			// then rebuild the conjunction by jca under the guard
			pa = ruInArgs(p);
			switch (ruTcSolve(pa, 0, sub, [], pool, psi, stcl, depth, close, budget, cheap, prover_env)) {
				None(): None();
				Some(cs): {
					if (length(cs.first) != 2) None()
					else {
						sub2 = cs.second;
						wff = tp2id_("wff");
						andE = ruApplySubst(p, sub2);
						pAnd = RuProofStep(s2id_("jca"), cs.first,
							RuStmt(stcl, [ruFwdMkRule(s2id("wi"), wff, [psi, andE])], -1));
						ruTcSolveW(rest, sub2, setTree(solved, item.first, pAnd), defers, pool, psi, stcl, depth, close, budget, cheap, prover_env);
					}
				}
			}
		} else if (ruTcGround(p)) {
			direct = fold(pool, None(), \ac : Maybe<RuProofTree>, f -> switch (ac) {
				Some(__): ac;
				None(): if (f.second == p.nodes) Some(f.first) else None();
			});
			child = switch (direct) {
				Some(__): direct;
				None(): if (cheap) {
					budget := ^budget - 1;   // cheap recursion: pool + table only, shared budget
					if (^budget < 0) None()
					else ruTcClose(pool, psi, p.nodes, stcl, depth - 2, close, budget, true, prover_env);
				} else {
					budget := ^budget - 4;   // a recursion into the full closer is the expensive step
					if (^budget < 0) None() else close(p.nodes, depth - 2);
				}
			};
			switch (child) {
				None(): None();
				Some(c): ruTcSolveW(rest, sub, setTree(solved, item.first, c), defers, pool, psi, stcl, depth, close, budget, cheap, prover_env);
			}
		} else if (ruTcHead(p) < 0) None()
		// ^ a bare-var pattern would match EVERY pool fact — the applier never guesses
		// instantiations for propositional metavariables (the zfmisc −7 cost bomb)
		else {
			// backtracking fold: first pool fact that matches AND lets the rest solve
			res = fold(pool, None(), \ac : Maybe<Pair<Tree<int, RuProofTree>, RuSubst>>, f -> switch (ac) {
				Some(__): ac;
				None(): switch (ruMatchExp(RuExp(f.second, -1), p, prover_env.math, prover_env.env)) {
					None(): None();
					Some(s2): switch (ruMergeSubst(sub, s2)) {
						None(): None();
						Some(sub2): {
							budget := ^budget - 1;   // each pool-completion branch is one attempt
							if (^budget < 0) None()
							else ruTcSolveW(rest, sub2, setTree(solved, item.first, f.first), defers, pool, psi, stcl, depth, close, budget, cheap, prover_env);
						}
					}
				}
			});
			switch (res) {
				Some(__): res;
				// DEFER once: a later antecedent may bind this one's variables
				None(): if (rest == [] || defers >= length(work)) None()
					else ruTcSolveW(arrayPush(rest, item), sub, solved, defers + 1, pool, psi, stcl, depth, close, budget, cheap, prover_env);
			}
		}
	}
}
