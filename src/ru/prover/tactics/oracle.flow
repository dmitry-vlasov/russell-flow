import ds/vector;
import ru/prover/core/prove;
import ru/prover/core/controls;
import ru/proof_tree;

export {
	// THE ORACLE TEST TACTIC — a pure Level-2 node selector.
	//
	// The theorem's own stored proof tree is the oracle. Each step the tactic walks that
	// tree against the proof-variant tree, matching props by ASSERTION ID and nothing
	// else, and selects for expansion:
	//   - every unexpanded prop that lies on the stored proof (the oracle's nodes), and
	//   - up to `others` unexpanded props per subgoal that do NOT lie on it (its
	//     alternatives). An alternative is expanded ONCE and never followed further.
	//     others = -1: all alternatives of every subgoal on the path.
	// Everything else is the ordinary engine, unhooked: unification against the whole
	// assertion index (no whitelist), premise matching, proof propagation, the
	// disjoint-variable check. A theorem this tactic cannot reprove is an engine finding.
	//
	// `mapping` (prop id -> the stored proof step it realizes) is filled by the walk. It
	// is shared with ruOracleFilterPremises (hyps=1) and read by the evaluators
	// (eval-ranking, eval-tactic). `hyps` only labels the tactic: the filter itself is
	// installed by the caller (ruDslBuildOracle) on the prover env.
	ruOracleTactic(
		theorem : RuTheorem,
		math    : RuMath,
		mapping : ref Tree<int, RuProofStep>,
		others  : int,
		hyps    : bool,
		env     : RuEnv
	) -> RuProverTactic;

	// hyps=1: the oracle also chooses the hypothesis at a premise leaf. A FILTER over the
	// ENGINE's own premise unifications: at a subgoal the stored proof closes by hypothesis
	// `ind`, keep only the unifications with that hypothesis; at a subgoal the stored proof
	// proves by a step, or off the oracle path, keep none. It never constructs a
	// unification. Without it (hyps=0) every unifiable hypothesis is admitted everywhere —
	// the premise-choice explosion is then the engine's to carry.
	ruOracleFilterPremises(
		unify   : (RuProverHyp) -> [RuUnified<RuPremise>],
		mapping : ref Tree<int, RuProofStep>
	) -> (RuProverHyp) -> [RuUnified<RuPremise>];

	// The assertion the stored proof applies at a subgoal; None off the oracle path or at
	// a premise leaf. For evaluators that rank the engine's candidates against the oracle.
	ruOracleStepAssertion(hyp : RuProverHyp, root : RuProofStep, mapping : ref Tree<int, RuProofStep>) -> Maybe<int>;
}

ruOracleTactic(theorem : RuTheorem, math : RuMath, mapping : ref Tree<int, RuProofStep>, others : int, hyps : bool, env : RuEnv) -> RuProverTactic {
	proof = ruTheoremProofTree(theorem, math);
	label = "oracle(others=" + i2s(others) + ", hyps=" + (if (hyps) "1" else "0") + ")";
	RuProverTactic(label, "oracle",
		\tree -> {
			selected = ruOracleWalk(proof, vector2array(tree.root.children), tree, mapping, others, []);
			if (selected == []) RuTacticDone() else RuTacticExpand(selected);
		},
		ruTreeNotProved
	);
}

// The alternatives of one subgoal: its props NOT carrying the oracle's assertion
// (`oracle_ass` = -1 at a premise leaf: every prop there is an alternative). A prop is in
// `leafs` exactly while it is unexpanded. others < 0: all unexpanded alternatives.
// Otherwise the budget is a TOTAL per subgoal: the alternatives already expanded count
// against it, so each alternative is expanded once and the per-subgoal count never
// exceeds `others` over the whole run.
ruOracleAlternatives(cands : [RuProverProp], oracle_ass : int, others : int, leafs : Tree<int, RuProverProp>) -> [RuProverProp] {
	alts  = filter(cands, \p -> p.assertion.info.id != oracle_ass);
	fresh = filter(alts, \p -> containsKeyTree(leafs, p.id));
	if (others < 0) fresh else {
		done = length(alts) - length(fresh);
		take(fresh, max(0, others - done));
	}
}

// Walk the stored proof against the PVT. `props` are the props of the subgoal that `step`
// proves (the children of one E-node); those carrying the step's assertion are on the
// oracle path. An unexpanded path prop is selected; an expanded one is descended into,
// subgoal by subgoal. Each subgoal also contributes its alternatives (see above).
ruOracleWalk(step : RuProofStep, props : [RuProverProp], tree : RuProverTree, mapping : ref Tree<int, RuProofStep>, others : int, acc : [RuProverProp]) -> [RuProverProp] {
	matches = filter(props, \p -> p.assertion.info.id == step.assertion);
	acc1 = concat(acc, ruOracleAlternatives(props, step.assertion, others, tree.leafs));
	fold(matches, acc1, \ac, m -> {
		if (!containsKeyTree(^mapping, m.id)) {
			mapping := setTree(^mapping, m.id, step);
		}
		if (containsKeyTree(tree.leafs, m.id)) concat(ac, [m]) else {
			exps = vector2array(m.children);
			foldi(step.children, ac, \i, ac2, child -> {
				if (i >= length(exps)) ac2 else {
					cands = vector2array(exps[i].children);
					switch (child) {
						RuProofStep(__,__,__): ruOracleWalk(child, cands, tree, mapping, others, ac2);
						RuProofHyp(__,__):     concat(ac2, ruOracleAlternatives(cands, -1, others, tree.leafs));
					}
				}
			});
		}
	});
}

ruOracleFilterPremises(unify : (RuProverHyp) -> [RuUnified<RuPremise>], mapping : ref Tree<int, RuProofStep>) -> (RuProverHyp) -> [RuUnified<RuPremise>] {
	\hyp -> switch (hyp) {
		RuProverExp(i, __, __, __, parent): {
			switch (lookupTree(^mapping, parent.id)) {
				Some(step): {
					if (i >= length(step.children)) [] else {
						switch (step.children[i]) {
							RuProofHyp(ind, __):   filter(unify(hyp), \u -> u.data.ind == ind);
							RuProofStep(__,__,__): [];
						}
					}
				}
				None(): [];
			}
		}
		RuProverRoot(__,__,__): unify(hyp);
	}
}

ruOracleStepAssertion(hyp : RuProverHyp, root : RuProofStep, mapping : ref Tree<int, RuProofStep>) -> Maybe<int> {
	switch (hyp) {
		RuProverRoot(__,__,__): Some(root.assertion);
		RuProverExp(i, __, __, __, parent): {
			switch (lookupTree(^mapping, parent.id)) {
				Some(step): {
					if (i >= length(step.children)) None() else {
						switch (step.children[i]) {
							RuProofStep(a, __, __): Some(a);
							RuProofHyp(__, __):     None();
						}
					}
				}
				None(): None();
			}
		}
	}
}
