import ru/prover/tactics/kalmar;
import ru/prover/tactics/unfold;
import ru/prover/core/controls;
import ru/proof_tree;
import ru/subst;
import ru/util/exp;
import ru/util/src2s;
import ru/verify/math;
import base/ids;
import ds/set;

// The EQUALIZER — the polynomial layer that makes the prop closer scale. Kalmár is exponential in
// the number of atoms; the unfold facts are BICONDITIONALS (P ↔ RHS), so instead of handing them to
// Kalmár as extra atoms, we use them as REWRITE rules: rewrite the goal's compound membership atoms
// away by biconditional congruence (notbii/anbi12i/orbi12i/imbi12i/bibi12i + bitri), a LINEAR chain,
// reducing the goal to the BASE atoms (memberships in variables). Kalmár then runs on that small
// residual. A reflexive residual (X ↔ X) closes by biid. This both fixes the perf blowup for the
// common case and is the equality-congruence step (equality hyps become ↔ facts via eleq, next).
// See [[project_mizar_import]] B-step-2.

export {
	// The equalizer-assisted prop closer as a tactic: unfold → rewrite the goal to base atoms (with a
	// congruence proof goal ↔ goal') → Kalmár on hyps ⊢ goal' → combine via mpbir. None when not
	// (propositionally, after rewriting) entailed. Replaces the plain unfold+Kalmár path.
	ruEqualizerPropTactic(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int,
		hyps : [RuExp], goal : RuExp) -> Maybe<RuProverTactic>;

	// The DIRECTED part of the equalizer, exposed for the open-residual `checker` tactic: unfold the
	// goal's compound membership atoms + rewrite it to base atoms by linear biconditional congruence.
	// Returns (residual goal', Some(proof of goal ↔ goal')) when anything rewrote, else (goal, None).
	// No Kalmár — the residual is left for a bounded BFS to close.
	ruEqualizerRewrite(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int,
		hyps : [RuExp], goal : RuExp) -> Pair<RuExp, Maybe<RuProofTree>>;

	// Strip a leading chain of universal quantifiers (wal): returns (matrix, count).
	ruStripForall(e : RuExp) -> Pair<RuExp, int>;

	// All assertion ids occurring in a proof tree (to whitelist a follow-proof replay).
	ruProofTreeAssertions(t : RuProofTree) -> [int];
}

// A proven biconditional fact P ↔ rhs (P a compound membership atom; `proof` proves the biconditional).
RuEqzFact(rhs : RuPForm, proof : RuProofTree);

ruEqzStmt(ctx : RuKEmitCtx, l : RuPForm, r : RuPForm) -> RuStmt {
	RuStmt(ctx.stmtClass, [ruKForm2Exp(ctx, RuPIff(l, r))], -1);
}

// ---- biconditional congruence rewrite --------------------------------------
// rewrite(form) = (form', proof of (form ↔ form')) where every compound atom with a fact has been
// replaced by its (recursively rewritten) RHS. `visiting` guards against (acyclic, but be safe) loops.
ruEqzRw(ctx : RuKEmitCtx, facts : Tree<string, RuEqzFact>, visiting : Set<string>, form : RuPForm) -> Pair<RuPForm, RuProofTree> {
	cong1 = \lemma, child, l, r -> RuProofStep(s2id_(lemma), [child], ruEqzStmt(ctx, l, r));
	cong2 = \lemma, c1, c2, l, r -> RuProofStep(s2id_(lemma), [c1, c2], ruEqzStmt(ctx, l, r));
	switch (form) {
		RuPAtom(k):
			switch (lookupTree(facts, k)) {
				None(): Pair(form, RuProofStep(s2id_("biid"), [], ruEqzStmt(ctx, form, form)));   // A ↔ A
				Some(fact):
					if (containsSet(visiting, k)) Pair(form, RuProofStep(s2id_("biid"), [], ruEqzStmt(ctx, form, form)))
					else {
						rhsRw = ruEqzRw(ctx, facts, insertSet(visiting, k), fact.rhs);   // (rhs', rhs ↔ rhs')
						form2 = rhsRw.first;
						// P ↔ form2 : the fact (P ↔ rhs) then, if rhs rewrote further, bitri with (rhs ↔ form2).
						proof = if (fact.rhs == form2) fact.proof
							else RuProofStep(s2id_("bitri"), [fact.proof, rhsRw.second], ruEqzStmt(ctx, form, form2));
						Pair(form2, proof);
					}
			}
		RuPNot(a): { r = ruEqzRw(ctx, facts, visiting, a); Pair(RuPNot(r.first), cong1("notbii", r.second, form, RuPNot(r.first))); }
		RuPAnd(a, b): { ra = ruEqzRw(ctx, facts, visiting, a); rb = ruEqzRw(ctx, facts, visiting, b); f2 = RuPAnd(ra.first, rb.first); Pair(f2, cong2("anbi12i", ra.second, rb.second, form, f2)); }
		RuPOr(a, b):  { ra = ruEqzRw(ctx, facts, visiting, a); rb = ruEqzRw(ctx, facts, visiting, b); f2 = RuPOr(ra.first, rb.first);  Pair(f2, cong2("orbi12i", ra.second, rb.second, form, f2)); }
		RuPImp(a, b): { ra = ruEqzRw(ctx, facts, visiting, a); rb = ruEqzRw(ctx, facts, visiting, b); f2 = RuPImp(ra.first, rb.first); Pair(f2, cong2("imbi12i", ra.second, rb.second, form, f2)); }
		RuPIff(a, b): { ra = ruEqzRw(ctx, facts, visiting, a); rb = ruEqzRw(ctx, facts, visiting, b); f2 = RuPIff(ra.first, rb.first); Pair(f2, cong2("bibi12i", ra.second, rb.second, form, f2)); }
		RuPTrue():  Pair(form, RuProofStep(s2id_("biid"), [], ruEqzStmt(ctx, form, form)));
		RuPFalse(): Pair(form, RuProofStep(s2id_("biid"), [], ruEqzStmt(ctx, form, form)));
	}
}

// ---- equality facts (eleq1/eleq2) ------------------------------------------
// An equality hypothesis `a = b` lets a membership atom be rewritten across the equality: from
// `a=b` and `eleq1/eleq2` derive the biconditional `(t∈a) ↔ (t∈b)` (or `(a∈s)↔(b∈s)`), proven by
// ax-mp with the hypothesis. These join the Kalmár assembly as PROVEN premises (the equality
// analogue of unfold facts). Closes gaps like `a=b, x∈a ⊢ x∈b`.

ruEqSpan(nodes : [RuExpNode], i : int) -> int {
	switch (nodes[i]) {
		RuVar(__, __): i + 1;
		RuRuleNode(__, al): fold(enumFromTo(1, ruArityLen2Arity(al)), i + 1, \p, __ -> ruEqSpan(nodes, p));
	}
}
ruEqHead(e : RuExp) -> int {
	if (e.nodes == []) -1 else switch (e.nodes[0]) { RuRuleNode(it, __): ruIdType2Id(it); RuVar(__, __): -1; };
}
// the two argument subexprs of a binary-rooted expression (root at 0, args at 1 and span(1)).
ruEqArgs(e : RuExp) -> Pair<RuExp, RuExp> {
	nodes = e.nodes;
	m = ruEqSpan(nodes, 1);
	Pair(RuExp(subrange(nodes, 1, m - 1), -1), RuExp(subrange(nodes, m, length(nodes) - m), -1));
}
ruEqKey(e : RuExp) -> string {
	strGlue(map(e.nodes, \n -> switch (n) { RuRuleNode(it, __): "R" + i2s(ruIdType2Id(it)); RuVar(id, t): "V" + i2s(id) + "#" + i2s(t); }), ",");
}
// all `( t ∈ S )` subtrees of an expression.
ruEqMembAtoms(e : RuExp, wcelId : int) -> [RuExp] {
	nodes = e.nodes;
	filtermap(enumFromTo(0, length(nodes) - 1), \i ->
		if (switch (nodes[i]) { RuRuleNode(it, __): ruIdType2Id(it) == wcelId; RuVar(__, __): false; })
			Some(RuExp(subrange(nodes, i, ruEqSpan(nodes, i) - i), -1)) else None());
}

RuEqHyp(idx : int, hyp : RuExp, a : RuExp, b : RuExp);

// Build an expression `rule(args...)` (prefix nodes; len = children-node count, the ruKForm2Nodes
// convention the verifier accepts). Used to construct the eleq instance expressions directly.
ruEqMkRule(rule : int, wff : int, args : [RuExp]) -> RuExp {
	argNodes = concatA(map(args, \a -> a.nodes));
	RuExp(concat([ruMakeRuleNode(rule, wff, length(args), length(argNodes))], argNodes), -1);
}

// Relation-fact context: ids + the equality/subset hypotheses to derive facts from.
RuEqCtx(stmtClass : int, wcelId : int, wbId : int, wiId : int, wff : int,
	eleq1Id : int, eleq2Id : int, sselId : int, eqs : [RuEqHyp], sss : [RuEqHyp]);

ruEqualityFacts(em : RuEnvMath, stmtClass : int, hyps : [RuExp], goal : RuExp) -> [Pair<RuExp, RuProofTree>] {
	wceqId = s2id("wceq"); wssId = s2id("wss"); wcelId = s2id("wcel");
	rel = \rid -> filtermapi(hyps, \i, h -> if (ruEqHead(h) != rid) None() else { ar = ruEqArgs(h); Some(RuEqHyp(i, h, ar.first, ar.second)); });
	eqs = rel(wceqId);   // `a = b` hypotheses
	sss = rel(wssId);    // `a ⊆ b` hypotheses
	if (eqs == [] && sss == []) []
	else {
		c = RuEqCtx(stmtClass, wcelId, s2id("wb"), s2id("wi"), tp2id_("wff"),
			s2id_("eleq1"), s2id_("eleq2"), s2id_("ssel"), eqs, sss);
		atoms = concatA(map(arrayPush(hyps, goal), \e -> ruEqMembAtoms(e, wcelId)));
		// Iterate to a fixpoint: a derived fact `(t∈X)→(t∈Y)` exposes the atom `t∈Y`, which may
		// trigger further facts (e.g. ⊆-transitivity element-chasing X⊆Y, Y⊆Z, t∈X ⊢ t∈Z).
		ruEqFactLoop(c, atoms, makeTree(), 8);
	}
}

// One pass: every relation-fact derivable from the given atoms (deduped by the caller).
ruEqGenPass(c : RuEqCtx, atoms : [RuExp]) -> [Pair<RuExp, RuProofTree>] {
	// a fact `factExp` (biconditional or implication) proven by ax-mp(rel-hyp, lemmaId-instance),
	// the instance being the directly-constructed `(rel-hyp) → factExp`.
	mk = \relHyp : RuEqHyp, lemmaId, factExp -> {
		impl  = ruEqMkRule(c.wiId, c.wff, [relHyp.hyp, factExp]);
		proof = RuProofStep(s2id_("ax-mp"), [
			RuProofHyp(relHyp.idx, RuStmt(c.stmtClass, [relHyp.hyp], -1)),
			RuProofStep(lemmaId, [], RuStmt(c.stmtClass, [impl], -1))
		], RuStmt(c.stmtClass, [factExp], -1));
		Pair(factExp, proof);
	};
	memb = \t, s -> ruEqMkRule(c.wcelId, c.wff, [t, s]);
	eqRaw = concatA(map(c.eqs, \eq ->
		filtermap(atoms, \atom -> {
			ar = ruEqArgs(atom); elem = ar.first; set = ar.second;
			ka = ruEqKey(eq.a); kb = ruEqKey(eq.b);
			if (ruEqKey(set) == ka || ruEqKey(set) == kb)             // equality in the SET position → eleq2
				Some(mk(eq, c.eleq2Id, ruEqMkRule(c.wbId, c.wff, [memb(elem, eq.a), memb(elem, eq.b)])))
			else if (ruEqKey(elem) == ka || ruEqKey(elem) == kb)      // equality in the ELEMENT position → eleq1
				Some(mk(eq, c.eleq1Id, ruEqMkRule(c.wbId, c.wff, [memb(eq.a, set), memb(eq.b, set)])))
			else None();
		})
	));
	// `X ⊆ Y` + `t ∈ X` → the implication fact `(t∈X) → (t∈Y)` via ssel.
	ssRaw = concatA(map(c.sss, \ss ->
		filtermap(atoms, \atom -> {
			ar = ruEqArgs(atom); elem = ar.first; set = ar.second;
			if (ruEqKey(set) == ruEqKey(ss.a)) Some(mk(ss, c.sselId, ruEqMkRule(c.wiId, c.wff, [memb(elem, ss.a), memb(elem, ss.b)])))
			else None();
		})
	));
	concat(eqRaw, ssRaw);
}

ruEqFactLoop(c : RuEqCtx, atoms : [RuExp], seen : Tree<string, Pair<RuExp, RuProofTree>>, fuel : int) -> [Pair<RuExp, RuProofTree>] {
	newf = filter(ruEqGenPass(c, atoms), \f -> !containsKeyTree(seen, ruEqKey(f.first)));
	if (newf == [] || fuel <= 0) getTreeValues(seen)
	else {
		seen1    = fold(newf, seen, \acc, f -> setTree(acc, ruEqKey(f.first), f));
		newAtoms = concatA(map(newf, \f -> ruEqMembAtoms(f.first, c.wcelId)));   // atoms exposed by the new facts
		ruEqFactLoop(c, concat(atoms, newAtoms), seen1, fuel - 1);
	}
}

// ---- orchestration ---------------------------------------------------------
ruEqualizerPropTactic(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int, hyps : [RuExp], goal : RuExp) -> Maybe<RuProverTactic> {
	gh = ruEqHead(goal);
	// B1: a ⊆ / = GOAL reduces to a membership subgoal over a FRESH setvar via ssriv/eqriv
	// (`(x∈A→x∈B) ⊢ A⊆B`, `(x∈A↔x∈B) ⊢ A=B`), proven recursively by the equalizer. The fresh var's
	// disjoint provisos are carried in the injected proof (ruNormalizeTheoremVarsDisjs only keeps,
	// never synthesises them).
	if (gh == s2id("wss") || gh == s2id("wceq")) ruEqualizerGoalRel(em, conn, wff, stmtClass, hyps, goal, gh == s2id("wss"))
	else maybeMap(ruEqualizerProve(em, conn, wff, stmtClass, hyps, goal),
		\tree -> ruKalmarDirectTactic(RuProof(ruEmptyVarsDisjs, ruMakeLinearProof(tree), -1)));
}

// All distinct variables (by id) occurring in the given expressions.
ruEqVarsOf(exps : [RuExp]) -> [RuVar] {
	getTreeValues(fold(exps, makeTree(), \acc, e -> fold(e.nodes, acc, \a, n ->
		switch (n) { RuVar(id, t): setTree(a, id, RuVar(id, t)); RuRuleNode(__, __): a; })));
}

ruEqFreshSetvar(used : Set<int>, setvarT : int, i : int) -> RuVar {
	nm = "eqz_v" + i2s(i);
	id = s2id(nm);
	if (containsSet(used, id)) ruEqFreshSetvar(used, setvarT, i + 1) else RuVar(id, setvarT);
}

// Goal-side ⊆/= : prove `A⊆B` / `A=B` from the membership subgoal over a fresh setvar.
ruEqualizerGoalRel(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int, hyps : [RuExp], goal : RuExp, isSubset : bool) -> Maybe<RuProverTactic> {
	ar = ruEqArgs(goal); a = ar.first; b = ar.second;
	wcelId = s2id("wcel"); wiId = s2id("wi"); wbId = s2id("wb"); setvarT = tp2id_("setvar"); classT = tp2id_("class");
	tvars = ruEqVarsOf(arrayPush(hyps, goal));
	fresh = ruEqFreshSetvar(buildSet(map(tvars, \v -> v.id)), setvarT, 0);
	// the element in a membership atom is a CLASS; a setvar must be coerced via the setvar→class
	// super-rule (ruSuperTypeName), matching how the parser/substitution represent `setvar ∈ class`.
	cvNode = ruMakeRuleNode(ruSuperTypeName(classT, setvarT), classT, 1, 1);
	freshExp = RuExp([cvNode, fresh], -1);
	memb = \s -> ruEqMkRule(wcelId, wff, [freshExp, s]);
	subgoal = if (isSubset) ruEqMkRule(wiId, wff, [memb(a), memb(b)]) else ruEqMkRule(wbId, wff, [memb(a), memb(b)]);
	switch (ruEqualizerProve(em, conn, wff, stmtClass, hyps, subgoal)) {
		None(): None();
		Some(subTree): {
			lemmaId  = if (isSubset) s2id_("ssriv") else s2id_("eqriv");
			goalTree = RuProofStep(lemmaId, [subTree], RuStmt(stmtClass, [goal], -1));
			// fresh setvar + disjoint(fresh, v) for every theorem var v (covers ssriv/eqriv's provisos).
			varsTree = fold(arrayPush(tvars, fresh), makeTree(), \acc, v -> setTree(acc, v.id, v));
			disjs    = buildSet(map(tvars, \v -> RuDisj(fresh, v)));
			Some(ruKalmarDirectTactic(RuProof(RuVarsDisjs(varsTree, disjs), ruMakeLinearProof(goalTree), -1)));
		}
	}
}

ruEqualizerProve(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int, hyps : [RuExp], goal : RuExp) -> Maybe<RuProofTree> {
	facts = ruUnfoldFacts(em.math, em.env, stmtClass, arrayPush(hyps, goal));
	// atom→subtree nodes over goal + hyps + every fact's biconditional, so ruKForm2Exp can rebuild
	// any atom that appears after rewriting.
	atomNodes = fold(concat(hyps, map(facts, \f -> f.first)), ruPAtomNodes(conn, goal), \acc, e -> mergeTree(acc, ruPAtomNodes(conn, e)));
	ctx = RuKEmitCtx(conn, wff, stmtClass, atomNodes, makeTree());
	// factMap: compound-atom key → (rewritten-to RHS, proof of the biconditional).
	factMap = fold(facts, makeTree(), \acc, f -> {
		switch (ruPAtomize(conn, f.first)) {   // f.first = ( P ↔ RHS )
			RuPIff(lhs, rhs): switch (lhs) { RuPAtom(k): setTree(acc, k, RuEqzFact(rhs, f.second)); default: acc; };
			default: acc;
		}
	});
	goalForm = ruPAtomize(conn, goal);
	rw       = ruEqzRw(ctx, factMap, makeSet(), goalForm);   // (goal', goal ↔ goal')
	goalForm2 = rw.first;
	goal2Exp  = ruKForm2Exp(ctx, goalForm2);
	// Equality hyps -> proven biconditional premises (eleq1/eleq2), added to the Kalmár assembly as
	// extra hyps at indices [|hyps|, |hyps|+|eqFacts|) and spliced with their ax-mp proofs.
	// Pass the unfold facts' biconditionals too: their RHS exposes membership atoms (e.g. x∈A, x∈B
	// from x∈(A∪B)) that the relation facts (eleq/ssel) must see to fire. They are wb-headed, so the
	// wceq/wss relation-hyp filter ignores them — they contribute atoms only.
	eqFacts    = ruEqualityFacts(em, stmtClass, concat(hyps, map(facts, \f -> f.first)), goal);
	eqFactExps = map(eqFacts, \f -> f.first);
	mkResidual = \ -> maybeMap(
		ruKalmarSkeleton(conn, wff, stmtClass, concat(hyps, eqFactExps), goal2Exp),
		\tree -> ruUnfoldSplice(tree, length(hyps), map(eqFacts, \f -> f.second))
	);
	// Prove the residual goal' over the (now base-atom) signature. A reflexive ↔ closes by biid.
	residual : Maybe<RuProofTree> = switch (goalForm2) {
		RuPIff(a, b): if (a == b) Some(RuProofStep(s2id_("biid"), [], RuStmt(stmtClass, [goal2Exp], -1))) else mkResidual();
		default: mkResidual();
	};
	switch (residual) {
		None(): None();
		Some(goal2Tree): {
			// goal from goal' (residual) and (goal ↔ goal') via mpbir: ps, (ph↔ps) ⊢ ph.
			full = if (goalForm2 == goalForm) goal2Tree   // nothing rewritten: residual already proves goal
				else RuProofStep(s2id_("mpbir"), [goal2Tree, rw.second], RuStmt(stmtClass, [ruKForm2Exp(ctx, goalForm)], -1));
			switch (full) {
				RuProofStep(__, __, __): Some(full);
				RuProofHyp(__, __): None();
			}
		}
	}
}

// ---- directed structure for the open-residual `checker` tactic --------------

ruEqualizerRewrite(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int, hyps : [RuExp], goal : RuExp) -> Pair<RuExp, Maybe<RuProofTree>> {
	facts = ruUnfoldFacts(em.math, em.env, stmtClass, arrayPush(hyps, goal));
	atomNodes = fold(concat(hyps, map(facts, \f -> f.first)), ruPAtomNodes(conn, goal),
		\acc, e -> mergeTree(acc, ruPAtomNodes(conn, e)));
	ctx = RuKEmitCtx(conn, wff, stmtClass, atomNodes, makeTree());
	factMap = fold(facts, makeTree(), \acc, f ->
		switch (ruPAtomize(conn, f.first)) {                 // f.first = ( P ↔ RHS )
			RuPIff(lhs, rhs): switch (lhs) { RuPAtom(k): setTree(acc, k, RuEqzFact(rhs, f.second)); default: acc; };
			default: acc;
		});
	goalForm = ruPAtomize(conn, goal);
	rw       = ruEqzRw(ctx, factMap, makeSet(), goalForm);   // (goal', goal ↔ goal')
	goal2Exp = ruKForm2Exp(ctx, rw.first);
	if (rw.first == goalForm) Pair(goal2Exp, None())         // nothing rewrote: residual = goal
	else Pair(goal2Exp, Some(rw.second));
}

ruStripForall(e : RuExp) -> Pair<RuExp, int> {
	if (ruEqHead(e) == s2id("wal")) {
		m    = ruEqSpan(e.nodes, 1);                          // end of the bound-var subtree
		body = RuExp(subrange(e.nodes, m, length(e.nodes) - m), -1);
		r    = ruStripForall(body);
		Pair(r.first, r.second + 1);
	} else Pair(e, 0);
}

ruProofTreeAssertions(t : RuProofTree) -> [int] {
	switch (t) {
		RuProofHyp(__, __): [];
		RuProofStep(ass, children, __): concat([ass], concatA(map(children, ruProofTreeAssertions)));
	}
}
