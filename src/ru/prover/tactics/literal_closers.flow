import ru/prover/core/forward;
import ru/prover/core/env;
import ru/prover/core/proofs;
import ru/prover/core/util;
import ru/prover/tactics/table_closer;

// ---------------------------------------------------------------------------
// THE LITERAL-CLOSER LIBRARY (L2): every theory-specific piece of the forward
// engine lives HERE, not in core/ — the refutation/instantiate/identity seed
// fronts, the Equalizer (oriented eq-rules + normalize), the classified fact
// pools and the literal/clause closers, the congruence chains. It reaches the
// engine ONLY through the seed-hook registry (ruRegisterForwardSeedHook) and
// the exported general primitives (ruFwdRegister/ruApplyForwardOn/
// ruReverseJoin/ruFwdMkRule). Core stays theory-free (the L1/L2 law).
// ---------------------------------------------------------------------------

export {
	// Install the library's seed hooks (idempotent) — called by the tactic
	// builders (dsl.flow) before any prove.
	ruInstallLiteralClosers() -> void;
}

// MEASUREMENT SWITCH (no-literal-closers=1): turn OFF the hand-written literal-channel
// battery (the clause/bare literal closers) while leaving the GENERAL machinery — refute
// front, instantiate front, identity/eq-normalize seeding, forward saturation, backward
// bfs, the Hilbert certificate emitter — untouched. Lets us measure how much coverage the
// general procedure carries on its own, which is the number that should be going UP.
ruLitClosersOff(prover_env : RuProverEnv) -> bool {
	ruOptsString(prover_env.env.conf.opts, "no-literal-closers", "") == "1";
}

ruInstallLiteralClosers() -> void {
	ruRegisterForwardSeedHook("refute", \pe, ct, fw, ass ->
		if (^(pe.refute)) ruSeedRefuteFront(pe, ct, fw) else fw);
	ruRegisterForwardSeedHook("instantiate", \pe, ct, fw, ass ->
		if (^(pe.instantiate))
			ruSeedEqNormalize(pe, ct, ruSeedIdentityFront(pe, ct, ruSeedInstantiateFront(pe, ct, fw), ass), ass)
		else fw);
}


// Refutation seeding (the `assume-neg` atom, checker-decomposition candidate A): seed the negated-goal
// DEDUCTION facts the install `ruHRefute` uses — `¬G→¬G` (id) and each premise lifted to `¬G→hyp_i` (a1i)
// — so the forward wave can saturate under the assumption ¬G. Once it derives a clash (¬G→φ, ¬G→¬φ) a
// scope `pm2.65i` application yields `¬¬G`, then `ax-mp` with `notnotr` yields `G`, which joins the root.
// All engine-built (the seed proofs are ordinary id/a1i steps; the rest is the ordinary forward wave).
// Const-form (c_task.const), matching the front the wave saturates over. Gated by prover_env.refute.
ruSeedRefuteFront(prover_env : RuProverEnv, c_task : RuConstAny<RuProverTask>, fwd : RuProverForward) -> RuProverForward {
	wff = tp2id_("wff");
	goalExp = ruExp(c_task.const.goal.stmt.exps[0]);
	cls     = c_task.const.goal.stmt.class;
	ng      = ruFwdMkRule(s2id("wn"), wff, [goalExp]);        // ¬G
	mkImp   = \a, b -> ruFwdMkRule(s2id("wi"), wff, [a, b]);
	ngng    = mkImp(ng, ng);
	// (statement exp, engine proof tree) for each seed fact.
	seeds = concat(
		[Pair(ngng, RuProofStep(s2id_("id"), [], RuStmt(cls, [ngng], -1)))],   // ⊢ ¬G→¬G  (id)
		map(c_task.const.premises, \p -> {
			hyp = ruExp(p.stmt.exps[0]);
			imp = mkImp(ng, hyp);
			Pair(imp, RuProofStep(s2id_("a1i"), [RuProofHyp(p.ind, p.stmt)], RuStmt(cls, [imp], -1)));  // hyp_i ⊢ ¬G→hyp_i (a1i)
		})
	);
	fold(seeds, fwd, \st, pr -> {
		impExp = pr.first; key = impExp.nodes;
		if (containsSet(st.seen, key)) st
		else {
			stmt = RuStmt(cls, [impExp], -1);
			sf   = RuProverExp(-1, makeVector(4), stmt, makeVector(0), ruNoProverProp);
			pushVector(sf.proofs, RuProverProofForward(sf, stmt, ruEmptySubst, pr.second));
			(ruFwdRegister(st, [], sf, impExp, key)).first;
		}
	});
}

// ---------------------------------------------------------------------------
// forall-instantiate seeding (the Mizar UNIFIER increment, mizar-tactic-plan):
// for each ∀-premise `∀x φ` and each candidate term t (class-typed subterms of
// the goal and premises — the same candidate source Mizar's Unifier draws on),
// seed the INSTANCE fact φ[t/x] with a hand-constructed spcv proof:
//
//   bi     = the congruence chain  ⊢ (x = t) → (φ ↔ φ[t/x])
//            (structural recursion: sseq1/2, eqeq1/2, eleq1/2 at the atoms;
//             notbid/anbi12d/orbi12d/imbi12d/bibi12d at connectives; biidd
//             for x-free subformulas)
//   setn   = ⊢ t ∈ _V              (vex for setvars, unex for unions)
//   spcv(setn, bi)                  ⊢ (∀x φ → φ[t/x])
//   ax-mp(premise, spcv)            ⊢ φ[t/x]
//
// The same seeding pattern as ruSeedRefuteFront (assume-neg): the combinator
// constructs ordinary proof TREES from foundation lemmas; the kernel verifies
// them in the final proof. The blind wave cannot assemble these chains (the
// schematic congruence facts starve under ground-first ordering and explode
// unguided) — the guided TERM CHOICE here is the L2 selection that Mizar's
// Unifier performs against its eq-classes. Bounded: at most
// ruFwdInstCap candidates per ∀-premise (a LIMIT, completeness-preserving).
// v1 scope: atoms with x in exactly one argument slot; no nested binders over
// x; setness for setvars and ∪-terms — everything else is declined, never
// mis-built.
// ---------------------------------------------------------------------------

RuFwdInstIds(
	wff : int, cls : int, setvar : int,
	wn : int, wi : int, wb : int, wa : int, wo : int, wal : int, wex : int,
	wss : int, wceq : int, wcel : int, cvv : int, cun : int, cin : int, cdif : int,
	sseq1 : int, sseq2 : int, eqeq1 : int, eqeq2 : int, eleq1 : int, eleq2 : int,
	notbid : int, anbi12d : int, orbi12d : int, imbi12d : int, bibi12d : int, biidd : int,
	spcv : int, vex : int, unex : int, inex1 : int, difexi : int, axmp : int
);

ruFwdInstIds() -> RuFwdInstIds {
	RuFwdInstIds(
		tp2id_("wff"), tp2id_("class"), tp2id_("setvar"),
		s2id("wn"), s2id("wi"), s2id("wb"), s2id("wa"), s2id("wo"), s2id("wal"), s2id("wex"),
		s2id("wss"), s2id("wceq"), s2id("wcel"), s2id("cvv"), s2id("cun"), s2id("cin"), s2id("cdif"),
		s2id_("sseq1"), s2id_("sseq2"), s2id_("eqeq1"), s2id_("eqeq2"), s2id_("eleq1"), s2id_("eleq2"),
		s2id_("notbid"), s2id_("anbi12d"), s2id_("orbi12d"), s2id_("imbi12d"), s2id_("bibi12d"), s2id_("biidd"),
		s2id_("spcv"), s2id_("vex"), s2id_("unex"), s2id_("inex1"), s2id_("difexi"), s2id_("ax-mp")
	);
}

// End index (exclusive) of the subexpression starting at i (prefix form).
ruFwdSpan(nodes : [RuExpNode], i : int) -> int {
	switch (nodes[i]) {
		RuVar(__,__): i + 1;
		RuRuleNode(__, al): fold(enumFromTo(1, ruArityLen2Arity(al)), i + 1, \p, __ -> ruFwdSpan(nodes, p));
	}
}

// The bound variable in the CONST task form is a zero-arity RULE node (a frozen
// task var, printed `_x901`), not an RuVar — so occurrence tests and substitution
// work on NODE EQUALITY, representation-agnostically.
ruFwdContainsNode(nodes : [RuExpNode], x : RuExpNode) -> bool {
	exists(nodes, \n -> n == x);
}

// Is this node a setvar-typed atom (an RuVar or a frozen zero-arity const)?
ruFwdIsSetvarNode(n : RuExpNode, setvar : int) -> bool {
	switch (n) {
		RuVar(__, tp): tp == setvar;
		RuRuleNode(idType, al): ruArityLen2Arity(al) == 0 && ruIdType2Type(idType) == setvar;
	}
}

// The CLASS congruence chain: Some((c[t/x], proof of ⊢ ante → (c = c[t/x]))),
// or None on an unsupported class head. The d-form set.mm congruences
// (ineq12d/uneq12d/difeq12d/xpeq12d/preq12d/opeq12d; sneqd/pweqd/unieqd/inteqd)
// thread ante through the structural recursion; `id` closes the x-leaf itself
// (ante IS (x = t)) and eqidd the x-free leaves. This is what lets the atom
// chain instantiate x NESTED inside a class argument ((x∩B)=∅ at x:=t,
// t80-class) instead of declining.
ruFwdClsChain(ids : RuFwdInstIds, ante : RuExp, x : RuExpNode, xocc : [RuExpNode], t : RuExp, term : [RuExpNode], stcl : int) -> Maybe<Pair<RuExp, RuProofTree>> {
	termExp = RuExp(term, -1);
	mkEqStmt = \l : RuExp, r : RuExp -> RuStmt(stcl,
		[ruFwdMkRule(ids.wi, ids.wff, [ante, ruFwdMkRule(ids.wceq, ids.wff, [l, r])])], -1);
	if (term == xocc) {
		Some(Pair(t, RuProofStep(s2id_("id"), [], mkEqStmt(termExp, t))));
	} else if (!ruFwdContainsNode(term, x)) {
		Some(Pair(termExp, RuProofStep(s2id_("eqidd"), [], mkEqStmt(termExp, termExp))));
	} else {
		switch (term[0]) {
			RuVar(__,__): None();
			RuRuleNode(idType, __): {
				rid = ruIdType2Id(idType);
				bin = \lemma : string -> {
					lend = ruFwdSpan(term, 1);
					a = subrange(term, 1, lend - 1);
					b = subrange(term, lend, length(term) - lend);
					maybeBind(ruFwdClsChain(ids, ante, x, xocc, t, a, stcl), \ca ->
						maybeMap(ruFwdClsChain(ids, ante, x, xocc, t, b, stcl), \cb -> {
							inst = ruFwdMkRule(rid, ids.cls, [ca.first, cb.first]);
							Pair(inst, RuProofStep(s2id_(lemma), [ca.second, cb.second], mkEqStmt(termExp, inst)));
						}));
				};
				un = \lemma : string -> {
					a = subrange(term, 1, length(term) - 1);
					maybeMap(ruFwdClsChain(ids, ante, x, xocc, t, a, stcl), \ca -> {
						inst = ruFwdMkRule(rid, ids.cls, [ca.first]);
						Pair(inst, RuProofStep(s2id_(lemma), [ca.second], mkEqStmt(termExp, inst)));
					});
				};
				if (rid == ids.cin) bin("ineq12d")
				else if (rid == ids.cun) bin("uneq12d")
				else if (rid == ids.cdif) bin("difeq12d")
				else if (rid == s2id("cxp")) bin("xpeq12d")
				else if (rid == s2id("cpr")) bin("preq12d")
				else if (rid == s2id("cop")) bin("opeq12d")
				else if (rid == s2id("csn")) un("sneqd")
				else if (rid == s2id("cpw")) un("pweqd")
				else if (rid == s2id("cuni")) un("unieqd")
				else if (rid == s2id("cint")) un("inteqd")
				else None();
			}
		}
	}
}

// The congruence chain: Some((φ[t/x], proof of ⊢ ante → (φ ↔ φ[t/x]))), or None
// when the v1 fragment cannot build it (x nested inside an atom argument, under
// a binder, or an unsupported head).
// x = the bare bound-var node (for containment tests); xocc = its CLASS-form
// occurrence slice (the setvar wrapped in the implicit coercion node — `setvar :
// class` materializes as a 1-arity class rule, so x occupies 2 nodes in class slots).
ruFwdBiChain(ids : RuFwdInstIds, ante : RuExp, x : RuExpNode, xocc : [RuExpNode], t : RuExp, body : [RuExpNode], stcl : int) -> Maybe<Pair<RuExp, RuProofTree>> {
	ruFwdChainDbg(ids, body);
	bodyExp = RuExp(body, -1);
	mkStmt = \e : RuExp -> RuStmt(stcl, [e], -1);
	biStmt = \inst : RuExp -> mkStmt(ruFwdMkRule(ids.wi, ids.wff, [ante, ruFwdMkRule(ids.wb, ids.wff, [bodyExp, inst])]));
	if (!ruFwdContainsNode(body, x)) {
		// x-free subformula: ⊢ ante → (φ ↔ φ) by biidd.
		Some(Pair(bodyExp, RuProofStep(ids.biidd, [], biStmt(bodyExp))));
	} else {
		switch (body[0]) {
			RuVar(__,__): None(); // a bare wff atom equal to x is not a wff — unreachable
			RuRuleNode(idType, __): {
				rid = ruIdType2Id(idType);
				if (rid == ids.wn) {
					maybeMap(ruFwdBiChain(ids, ante, x, xocc, t, tail(body), stcl), \c -> {
						inst = ruFwdMkRule(ids.wn, ids.wff, [c.first]);
						Pair(inst, RuProofStep(ids.notbid, [c.second], biStmt(inst)));
					});
				} else if (rid == ids.wi || rid == ids.wa || rid == ids.wo || rid == ids.wb) {
					lend = ruFwdSpan(body, 1);
					l = subrange(body, 1, lend - 1);
					r = subrange(body, lend, length(body) - lend);
					maybeBind(ruFwdBiChain(ids, ante, x, xocc, t, l, stcl), \cl ->
						maybeMap(ruFwdBiChain(ids, ante, x, xocc, t, r, stcl), \cr -> {
							inst = ruFwdMkRule(rid, ids.wff, [cl.first, cr.first]);
							lemma = if (rid == ids.wi) ids.imbi12d else if (rid == ids.wa) ids.anbi12d
								else if (rid == ids.wo) ids.orbi12d else ids.bibi12d;
							Pair(inst, RuProofStep(lemma, [cl.second, cr.second], biStmt(inst)));
						}));
				} else if (rid == ids.wal && length(body) > 2 && ruFwdIsSetvarNode(body[1], ids.setvar)
					&& body[1] != x && !ruFwdContainsNode(t.nodes, body[1])) {
					// ∀w INNER, w ≠ x, w ∉ t: recurse under the binder and join by
					// albid (Ⅎ w ante supplied by nfv — ante = (x=t) is w-free, the
					// kernel checks the DV) — the 2-var Mizar rules ∀u∀v¬(…) and the
					// ∀-wrapped definitional biconds (d10 trivial) instantiate
					// through this case
					wv = body[1];
					inner = subrange(body, 2, length(body) - 2);
					maybeMap(ruFwdBiChain(ids, ante, x, xocc, t, inner, stcl), \ci -> {
						instW = ruFwdMkRule(ids.wal, ids.wff, [RuExp([wv], -1), ci.first]);
						pNf = RuProofStep(s2id_("nfv"), [],
							RuStmt(stcl, [ruFwdMkRule(s2id("wnf"), ids.wff, [RuExp([wv], -1), ante])], -1));
						Pair(instW, RuProofStep(s2id_("albid"), [pNf, ci.second], biStmt(instW)));
					});
				} else if (rid == ids.wss || rid == ids.wceq || rid == ids.wcel) {
					lend = ruFwdSpan(body, 1);
					a = subrange(body, 1, lend - 1);
					b = subrange(body, lend, length(body) - lend);
					aIsX = a == xocc;
					bIsX = b == xocc;
					if (aIsX && !ruFwdContainsNode(b, x)) {
						inst = ruFwdMkRule(rid, ids.wff, [t, RuExp(b, -1)]);
						lemma = if (rid == ids.wss) ids.sseq1 else if (rid == ids.wceq) ids.eqeq1 else ids.eleq1;
						Some(Pair(inst, RuProofStep(lemma, [], biStmt(inst))));
					} else if (bIsX && !ruFwdContainsNode(a, x)) {
						inst = ruFwdMkRule(rid, ids.wff, [RuExp(a, -1), t]);
						lemma = if (rid == ids.wss) ids.sseq2 else if (rid == ids.wceq) ids.eqeq2 else ids.eleq2;
						Some(Pair(inst, RuProofStep(lemma, [], biStmt(inst))));
					} else {
						// x nested inside a compound argument: the CLASS congruence
						// chain rebuilds each side, the atom joins by the 12d forms
						// ((x∩B)=∅ at x:=t, t80-class)
						maybeBind(ruFwdClsChain(ids, ante, x, xocc, t, a, stcl), \ca ->
							maybeMap(ruFwdClsChain(ids, ante, x, xocc, t, b, stcl), \cb -> {
								inst = ruFwdMkRule(rid, ids.wff, [ca.first, cb.first]);
								lemma = if (rid == ids.wss) s2id_("sseq12d")
									else if (rid == ids.wceq) s2id_("eqeq12d") else s2id_("eleq12d");
								Pair(inst, RuProofStep(lemma, [ca.second, cb.second], biStmt(inst)));
							}));
					}
				} else {
					// GENERIC ARTICLE ATOM R(a1..an) (a pr_*/fn_* application — never a
					// binder): x occurs as exactly ONE whole arg slice, the rest x-free.
					// The lemma is the per-slot d-form congruence AXIOM <rule>_cong<i>d
					// the article emits with its signature (the →-form the chain needs;
					// the i-form congruence's equality hyps are bare and cannot feed it).
					rname = id2s(rid);
					atomOk = startsWith(rname, "pr_") || startsWith(rname, "fn_");
					arity2 = switch (body[0]) { RuVar(__,__): 0; RuRuleNode(__, al2): ruArityLen2Arity(al2); };
					if (!atomOk || arity2 == 0) None() else {
						args = fold(enumFromTo(1, arity2), Pair([], 1), \acA : Pair<[Pair<int, int>], int>, __ -> {
							e = ruFwdSpan(body, acA.second);
							Pair(arrayPush(acA.first, Pair(acA.second, e)), e);
						}).first;
						slices = map(args, \ar -> subrange(body, ar.first, ar.second - ar.first));
						hits = filter(enumFromTo(0, arity2 - 1), \k -> slices[k] == xocc);
						othersFree = forall(enumFromTo(0, arity2 - 1), \k ->
							slices[k] == xocc || !ruFwdContainsNode(slices[k], x));
						if (length(hits) != 1 || !othersFree) None() else {
							slot = hits[0];
							inst = ruFwdMkRule(rid, ids.wff,
								mapi(slices, \k, s -> if (k == slot) t else RuExp(s, -1)));
							lemma = s2id_(rname + "_cong" + i2s(slot + 1) + "d");
							Some(Pair(inst, RuProofStep(lemma, [], biStmt(inst))));
						}
					}
				}
			}
		}
	}
}

ruFwdChainDbgOn : ref bool = ref false;
ruFwdChainDbg(ids : RuFwdInstIds, body : [RuExpNode]) -> void {
	if (^ruFwdChainDbgOn) {
		head = switch (body[0]) {
			RuVar(id,__): "var:" + id2s(id);
			RuRuleNode(idType,__): "rule:" + id2s(ruIdType2Id(idType)) + " raw=" + i2s(ruIdType2Id(idType)) + " wi-id=" + i2s(ids.wi);
		}
		println("  biChain: head=" + head + " len=" + i2s(length(body)));
	}
}

// ⊢ t ∈ _V : vex for a setvar; unex for a ∪-term (both args); inex1 for an
// ∩-term and difexi for a ∖-term (first arg only); anything else declined.
ruFwdSetness(ids : RuFwdInstIds, t : [RuExpNode], stcl : int) -> Maybe<RuProofTree> {
	mkCel = \e : [RuExpNode] -> RuStmt(stcl, [ruFwdMkRule(ids.wcel, ids.wff, [RuExp(e, -1), ruFwdMkRule(ids.cvv, ids.cls, [])])], -1);
	if (length(t) == 2 && ruFwdIsSetvarNode(t[1], ids.setvar)) Some(RuProofStep(ids.vex, [], mkCel(t)))
	else switch (t[0]) {
		RuVar(__,__): None();
		RuRuleNode(idType, __): {
			rid = ruIdType2Id(idType);
			if (rid == ids.cun) {
				lend = ruFwdSpan(t, 1);
				a = subrange(t, 1, lend - 1);
				b = subrange(t, lend, length(t) - lend);
				maybeBind(ruFwdSetness(ids, a, stcl), \pa ->
					maybeMap(ruFwdSetness(ids, b, stcl), \pb ->
						RuProofStep(ids.unex, [pa, pb], mkCel(t))));
			} else if (rid == ids.cin || rid == ids.cdif) {
				lend = ruFwdSpan(t, 1);
				a = subrange(t, 1, lend - 1);
				lemma = if (rid == ids.cin) ids.inex1 else ids.difexi;
				maybeMap(ruFwdSetness(ids, a, stcl), \pa ->
					RuProofStep(lemma, [pa], mkCel(t)));
			} else if (rid == s2id("csn") || rid == s2id("cpr") || rid == s2id("cop")) {
				// enumerations and Kuratowski pairs are sets UNCONDITIONALLY
				// (snex/prex/opex, 0-hyp) — the class-element enum channels
				// (elpr/eltp/elsng) need this setness (t134-class)
				lemma = if (rid == s2id("csn")) s2id_("snex")
					else if (rid == s2id("cpr")) s2id_("prex") else s2id_("opex");
				Some(RuProofStep(lemma, [], mkCel(t)));
			} else None();
		}
	}
}

// Class-typed candidate terms: all subexpressions of the given expressions whose
// head is class-typed (or a bare setvar), deduped, capped.
ruFwdInstCandidates(ids : RuFwdInstIds, exps : [RuExp], cap : int) -> [[RuExpNode]] {
	collect = \nodes : [RuExpNode] -> {
		doCollect = \i : int -> {
			isCls = switch (nodes[i]) {
				RuVar(__,__): false;
				RuRuleNode(idType, __): ruIdType2Type(idType) == ids.cls;
			};
			if (isCls) [subrange(nodes, i, ruFwdSpan(nodes, i) - i)] else [];
		}
		concatA(mapi(nodes, \i, __ -> doCollect(i)));
	}
	all = concatA(map(exps, \e -> collect(e.nodes)));
	deduped = fold(all, Pair(makeSet(), []), \acc, c ->
		if (containsSet(acc.first, c)) acc
		else Pair(insertSet(acc.first, c), arrayPush(acc.second, c))
	).second;
	take(deduped, cap);
}

ruFwdInstCap(prover_env : RuProverEnv) -> int {
	v = lookupTreeDef(prover_env.conf.task.args, "instantiate-cap", "16");
	if (runtimeValueType(v) == "int") cast(v : flow -> int) else s2i(cast(v : flow -> string));
}

ruSeedInstantiateFront(prover_env : RuProverEnv, c_task : RuConstAny<RuProverTask>, fwd : RuProverForward) -> RuProverForward {
	ids  = ruFwdInstIds();
	stcl = c_task.const.goal.stmt.class;
	cands = ruFwdInstCandidates(ids,
		concat([ruExp(c_task.const.goal.stmt.exps[0])], map(c_task.const.premises, \p -> ruExp(p.stmt.exps[0]))),
		ruFwdInstCap(prover_env));
	ruFwdChainDbgOn := prover_env.env.conf.verbose >= 5;
	if (prover_env.env.conf.verbose >= 4) {
		prover_env.env.out.println("instantiate: candidates=" + i2s(length(cands))
			+ " premises=" + i2s(length(c_task.const.premises))
			+ " wal-premises=" + i2s(length(filter(c_task.const.premises, \p -> {
				e = ruExp(p.stmt.exps[0]);
				switch (e.nodes[0]) {
					RuVar(__,__): false;
					RuRuleNode(idType, __): ruIdType2Id(idType) == ids.wal
						&& ruFwdIsSetvarNode(e.nodes[1], ids.setvar);
				}
			}))));
	} else {};
	fold(c_task.const.premises, fwd, \st, p -> {
		pexp = ruExp(p.stmt.exps[0]);
		switch (pexp.nodes[0]) {
			RuVar(__,__): st;
			RuRuleNode(idType, __): {
				if (ruIdType2Id(idType) != ids.wal) st else {
					xnode = pexp.nodes[1];
					if (!ruFwdIsSetvarNode(xnode, ids.setvar)) st else {
						{
							body = subrange(pexp.nodes, 2, length(pexp.nodes) - 2);
							// The class-form occurrence of x: the implicit setvar->class
							// coercion node followed by x. Find it in the body; a body
							// where x never occurs in class position has nothing to
							// instantiate structurally (v1 declines it wholesale).
							xocc = fold(enumFromTo(0, length(body) - 2), [], \acc, i ->
								if (acc != []) acc
								else switch (body[i]) {
									RuVar(__,__): acc;
									RuRuleNode(idT, al): {
										if (ruArityLen2Arity(al) == 1 && ruIdType2Type(idT) == ids.cls && body[i + 1] == xnode)
											[body[i], body[i + 1]]
										else acc;
									}
								});
							fold(cands, st, \st2, t -> {
								if (xocc == [] || ruFwdContainsNode(t, xnode)) st2 else {
									tExp = RuExp(t, -1);
									ante = ruFwdMkRule(ids.wceq, ids.wff, [RuExp(xocc, -1), tExp]);
									dbg = \msg : string -> if (prover_env.env.conf.verbose >= 4) {
										prover_env.env.out.println("instantiate: t=" + ruSafeExp2s(tExp, prover_env.math.decls.lang) + " " + msg);
									} else {};
									switch (ruFwdBiChain(ids, ante, xnode, xocc, tExp, body, stcl)) {
										None(): { dbg("chain DECLINED"); st2 };
										Some(chain): switch (ruFwdSetness(ids, t, stcl)) {
											None(): { dbg("setness DECLINED"); st2 };
											Some(setn): {
												inst = chain.first;
												key = inst.nodes;
												if (containsSet(st2.seen, key)) st2 else {
													spcvStmt = RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [pexp, inst])], -1);
													spcvTree = RuProofStep(ids.spcv, [setn, chain.second], spcvStmt);
													instTree = RuProofStep(ids.axmp, [RuProofHyp(p.ind, p.stmt), spcvTree], RuStmt(stcl, [inst], -1));
													sf = RuProverExp(-1, makeVector(4), RuStmt(stcl, [inst], -1), makeVector(0), ruNoProverProp);
													pushVector(sf.proofs, RuProverProofForward(sf, RuStmt(stcl, [inst], -1), ruEmptySubst, instTree));
													(ruFwdRegister(st2, [], sf, inst, key)).first;
												}
											}
										}
									}
								}
							});
						}
					}
				}
			}
		}
	});
}

// IDENTITY-INSTANCE seeding (the Equalizer half of the `instantiate` frame): for each
// 0-hypothesis assertion in scope whose conclusion is an EQUALITY (wceq-headed identity
// schema, e.g. disjdif ⊢(A∩(B∖A))=∅) and each class-typed candidate subterm t of the
// goal/premises, MATCH t against the identity's LEFT side; a FULLY-GROUNDING match σ
// seeds the instance σ·(L=R) as a fact whose proof is the one-step assertion instance
// (RuProofStep(identity, [], stmt)) — kernel-verified like any proof. eqcomi in scope
// covers right-side needs by flipping. Bounded by the same candidate cap; dedup by seen.
ruSeedIdentityFront(prover_env : RuProverEnv, c_task : RuConstAny<RuProverTask>, fwd : RuProverForward, asses : RuIndex<RuAssertion>) -> RuProverForward {
	ids  = ruFwdInstIds();
	stcl = c_task.const.goal.stmt.class;
	// Seed equality identities only when the task actually CONTAINS an equality
	// (goal or a premise): for a pure relational task (e.g. a subset goal) the
	// identity instances are junk by construction and starve the useful chains.
	hasEq = exists(concat([ruExp(c_task.const.goal.stmt.exps[0])], map(c_task.const.premises, \pp -> ruExp(pp.stmt.exps[0]))),
		\e -> exists(e.nodes, \n -> switch (n) {
			RuVar(__,__): false;
			RuRuleNode(idT, __): ruIdType2Id(idT) == ids.wceq;
		}));
	if (!hasEq) fwd else {
	cands = ruFwdInstCandidates(ids,
		concat([ruExp(c_task.const.goal.stmt.exps[0])], map(c_task.const.premises, \p -> ruExp(p.stmt.exps[0]))),
		ruFwdInstCap(prover_env));
	// SYMBOL FILTER: admit an identity schema only if every CLASS-typed operation
	// symbol in its conclusion occurs in the task (goal+premises). Instantiating
	// foreign-symbol identities (e.g. the symmetric-difference family into a
	// {intersect, difference}-only goal) only feeds the eqtri quadratic with junk —
	// observed to REGRESS theorems the small base closed. A LIMIT: the plain
	// schematic 0-hyp facts are still seeded regardless, so nothing is lost.
	taskOps = fold(
		concat([ruExp(c_task.const.goal.stmt.exps[0])], map(c_task.const.premises, \pp -> ruExp(pp.stmt.exps[0]))),
		makeSet(), \acc, e -> fold(e.nodes, acc, \ac, n -> switch (n) {
			RuVar(__,__): ac;
			RuRuleNode(idT, __): if (ruIdType2Type(idT) == ids.cls) insertSet(ac, ruIdType2Id(idT)) else ac;
		}));
	idents = filter(ruIndexValues(asses), \a ->
		length(a.infer.hyps) == 0 && {
			cn = (ruExp(a.infer.prop.exps[0])).nodes;
			switch (cn[0]) {
				RuVar(__,__): false;
				RuRuleNode(idT, __): ruIdType2Id(idT) == ids.wceq
					&& forall(cn, \n -> switch (n) {
						RuVar(__,__): true;
						RuRuleNode(idT2, __): ruIdType2Type(idT2) != ids.cls || containsSet(taskOps, ruIdType2Id(idT2));
					});
			}
		});
	fold(idents, fwd, \st, a -> {
		concl = ruExp(a.infer.prop.exps[0]);
		lend  = ruFwdSpan(concl.nodes, 1);
		lhs   = RuExp(subrange(concl.nodes, 1, lend - 1), -1);
		fold(cands, st, \st2, t -> {
			switch (ruMatchExp(RuExp(t, -1), lhs, prover_env.math, prover_env.env)) {
				None(): st2;
				Some(sigma): {
					inst = ruApplySubst(concl, sigma);
					// Require FULL grounding: a leftover schematic var would seed a
					// half-instantiated schema (junk the ground-first ordering exists
					// to avoid). Declined instances stay reachable as the plain 0-hyp
					// schematic fact (seeded by ruSeedForwardFront) — nothing lost.
					ground = !exists(inst.nodes, \n -> switch (n) {
						RuVar(__,__): true;
						RuRuleNode(__,__): false;
					});
					key = inst.nodes;
					if (!ground || containsSet(st2.seen, key)) st2 else {
						tree = RuProofStep(a.info.id, [], RuStmt(stcl, [inst], -1));
						sf = RuProverExp(-1, makeVector(4), RuStmt(stcl, [inst], -1), makeVector(0), ruNoProverProp);
						pushVector(sf.proofs, RuProverProofForward(sf, RuStmt(stcl, [inst], -1), ruEmptySubst, tree));
						(ruFwdRegister(st2, [], sf, inst, key)).first;
					}
				}
			}
		});
	});
	}
}

// ---------------------------------------------------------------------------
// eq-normalize (DIRECTED equality rewriting - the deterministic Equate,
// mizar-tactic-plan): when the GOAL is an equality X = Y, normalize BOTH sides
// by the ORIENTED identity base and, if the normal forms coincide, seed the
// goal fact with the constructed proof (identity instances lifted through
// their contexts by the per-operation congruence inferences, chained by
// eqtri) - the seed-join then closes the root. No search: this is rewriting
// to canonical form, union-find quality, where wave saturation over the
// term-GROWING *eq*i inferences structurally explodes.
//
// Orientation guards (a rule is L -> R):
//   - vars(R) must be a subset of vars(L)  (sound direction);
//   - COMM-shaped rules (|R| = |L|) apply only ORDER-DECREASING (the rewritten
//     subterm strictly decreases in the node order) - no A^B <-> B^A loops;
//   - GROWING rules (|sigma R| > |sigma L|) apply only when ELIMINATING (some
//     class-op of L is absent from R, e.g. dfsymdif3 eliminating symdiff).
// For each identity whose lhs head is a commutative op (cin/cun) a SWAPPED
// variant is added mechanically (proof = eqtri(incom/uncom instance, identity
// instance)) - deterministic coverage instead of AC-matching.
// Rewriting is leftmost-OUTERMOST; a redex under an unliftable context
// (csymdif has no *eq*i inferences) is skipped - outermost-first eliminates
// the symdiff node itself before anything must lift through it.
// ---------------------------------------------------------------------------

RuFwdEqIds(
	eqtri : int, eqcomi : int, eqid : int, incom : int, uncom : int,
	ineq1i : int, ineq2i : int, uneq1i : int, uneq2i : int, difeq1i : int, difeq2i : int,
	cin : int, cun : int, cdif : int, axgen : int, mpbir : int,
	csymdif : int, symdifeq1 : int, symdifeq2 : int,
	cxp : int, xpeq1i : int, xpeq2i : int,
	cpw : int, pweqi : int, cuni : int, unieqi : int, cop : int, opeq1i : int, opeq2i : int
);
ruFwdEqIds() -> RuFwdEqIds {
	RuFwdEqIds(
		s2id_("eqtri"), s2id_("eqcomi"), s2id_("eqid"), s2id_("incom"), s2id_("uncom"),
		s2id_("ineq1i"), s2id_("ineq2i"), s2id_("uneq1i"), s2id_("uneq2i"), s2id_("difeq1i"), s2id_("difeq2i"),
		s2id("cin"), s2id("cun"), s2id("cdif"), s2id_("ax-gen"), s2id_("mpbir"),
		s2id("csymdif"), s2id_("symdifeq1"), s2id_("symdifeq2"),
		s2id("cxp"), s2id_("xpeq1i"), s2id_("xpeq2i"),
		s2id("cpw"), s2id_("pweqi"), s2id("cuni"), s2id_("unieqi"), s2id("cop"), s2id_("opeq1i"), s2id_("opeq2i")
	);
}

// One oriented rewrite rule: lhs/rhs patterns + a proof builder for the
// INSTANCE equality sigma(lhs) = sigma(rhs).
RuFwdEqRule(
	lhs : [RuExpNode],
	rhs : [RuExpNode],
	comm : bool,        // order-decreasing guard applies
	grow : bool,        // |rhs| may exceed |lhs| under sigma
	elim : bool,        // rhs drops a class-op present in lhs
	poly : bool,        // instance-wise POLYNOMIAL-decrease guard applies (distributivity)
	mkProof : (RuExp, RuExp, int) -> RuProofTree  // (instLhs, instRhs, stmtClass)
);

ruFwdClassOps(ids : RuFwdInstIds, nodes : [RuExpNode]) -> Set<int> {
	fold(nodes, makeSet(), \ac, n -> switch (n) {
		RuVar(__,__): ac;
		RuRuleNode(idT, __): if (ruIdType2Type(idT) == ids.cls) insertSet(ac, ruIdType2Id(idT)) else ac;
	});
}

// node-array order for the comm guard: compare by (isVar, id, type) lexicographically.
ruFwdNodeLess(a : [RuExpNode], b : [RuExpNode]) -> bool {
	n = min(length(a), length(b));
	res = fold(enumFromTo(0, n - 1), 0, \st, i ->
		if (st != 0) st else {
			ka = switch (a[i]) { RuVar(id, tp): Pair(id, tp); RuRuleNode(idT, __): Pair(ruIdType2Id(idT) + 1000000000, ruIdType2Type(idT)); };
			kb = switch (b[i]) { RuVar(id, tp): Pair(id, tp); RuRuleNode(idT, __): Pair(ruIdType2Id(idT) + 1000000000, ruIdType2Type(idT)); };
			if (ka.first != kb.first) { if (ka.first < kb.first) -1 else 1 }
			else if (ka.second != kb.second) { if (ka.second < kb.second) -1 else 1 }
			else 0;
		});
	if (res != 0) res < 0 else length(a) < length(b);
}

// Build the oriented rule set from the task-filtered identity schemata.
ruFwdEqRules(ids : RuFwdInstIds, eids : RuFwdEqIds, idents : [RuAssertion], stcl : int) -> [RuFwdEqRule] {
	concatA(map(idents, \a -> {
		concl = ruExp(a.infer.prop.exps[0]);
		lend  = ruFwdSpan(concl.nodes, 1);
		lhs   = subrange(concl.nodes, 1, lend - 1);
		rhs   = subrange(concl.nodes, lend, length(concl.nodes) - lend);
		lvars = fold(lhs, makeSet(), \ac, n -> switch (n) { RuVar(id,__): insertSet(ac, id); RuRuleNode(__,__): ac; });
		rOk   = forall(rhs, \n -> switch (n) { RuVar(id,__): containsSet(lvars, id); RuRuleNode(__,__): true; });
		if (!rOk) [] else {
			lops = ruFwdClassOps(ids, lhs);
			rops = ruFwdClassOps(ids, rhs);
			elim = foldSet(lops, false, \ac, op -> ac || !containsSet(rops, op));
			comm = length(lhs) == length(rhs) && !elim;
			grow = length(rhs) > length(lhs);
			mkP  = \il : RuExp, ir : RuExp, sc : int ->
				RuProofStep(a.info.id, [], RuStmt(sc, [ruFwdMkRule(ruFwdEqIds().eqtri, 0, [])], -1)); // placeholder, replaced below
			// direct rule (proof = the identity instance)
			base = RuFwdEqRule(lhs, rhs, comm, grow, elim, false,
				\il, ir, sc -> RuProofStep(a.info.id, [],
					RuStmt(sc, [ruFwdMkRule(s2id("wceq"), tp2id_("wff"), [il, ir])], -1)));
			// REVERSED variant for a comm-shaped rule (same length, still guarded
			// order-decreasing, so no loops): whichever association/permutation
			// direction decreases is available — e.g. symdifass converges both
			// nestings of (A△B)△C to the lex-min one. Proof = eqcomi(identity).
			reversed = if (!comm) [] else
				[RuFwdEqRule(rhs, lhs, true, false, false, false,
					\il, ir, sc -> {
						wceq = s2id("wceq"); wff = tp2id_("wff");
						RuProofStep(ruFwdEqIds().eqcomi,
							[RuProofStep(a.info.id, [], RuStmt(sc, [ruFwdMkRule(wceq, wff, [ir, il])], -1))],
							RuStmt(sc, [ruFwdMkRule(wceq, wff, [il, ir])], -1));
					})];
			// swapped variant for a commutative lhs head (cin/cun): lhs' = op(b,c) -> rhs,
			// proof = eqtri(comm-instance op(b,c)=op(c,b), identity instance).
			swapped = switch (lhs[0]) {
				RuVar(__,__): [];
				RuRuleNode(idT, __): {
					op = ruIdType2Id(idT);
					if (op != eids.cin && op != eids.cun) [] else {
						aend = ruFwdSpan(lhs, 1);
						la = subrange(lhs, 1, aend - 1);
						lb = subrange(lhs, aend, length(lhs) - aend);
						lhs2 = concat([lhs[0]], concat(lb, la));
						commId = if (op == eids.cin) eids.incom else eids.uncom;
						[RuFwdEqRule(lhs2, rhs, comm, grow, elim, false,
							\il, ir, sc -> {
								// il = op(sb, sa); the comm instance flips it to op(sa, sb) = the identity's lhs instance.
								a2 = ruFwdSpan(il.nodes, 1);
								sb = RuExp(subrange(il.nodes, 1, a2 - 1), -1);
								sa = RuExp(subrange(il.nodes, a2, length(il.nodes) - a2), -1);
								flipped = ruFwdMkRule(op, tp2id_("class"), [sa, sb]);
								wceq = s2id("wceq"); wff = tp2id_("wff");
								commStep = RuProofStep(commId, [], RuStmt(sc, [ruFwdMkRule(wceq, wff, [il, flipped])], -1));
								idStep   = RuProofStep(a.info.id, [], RuStmt(sc, [ruFwdMkRule(wceq, wff, [flipped, ir])], -1));
								RuProofStep(ruFwdEqIds().eqtri, [commStep, idStep], RuStmt(sc, [ruFwdMkRule(wceq, wff, [il, ir])], -1));
							})];
					}
				}
			};
			concat3([base], reversed, swapped);
		}
	}));
}

// Refine the rule set: a GROWING rule survives only as DEFINITION UNFOLDING - its
// lhs-head symbol must not occur in the rhs of any rule with a DIFFERENT lhs head
// (same-headed permuting rules preserve the head count). Then the head count
// strictly decreases under unfolding and never recovers: generic termination,
// no symbol names hardcoded. Without this, mutually-eliminating distributivity
// pairs (drop-union/add-intersect vs drop-intersect/add-union) ping-pong with
// exponential growth.
ruFwdEqRulesChecked(ids : RuFwdInstIds, eids : RuFwdEqIds, idents : [RuAssertion], stcl : int) -> [RuFwdEqRule] {
	raw = ruFwdEqRules(ids, eids, idents, stcl);
	headOf = \r : RuFwdEqRule -> switch (r.lhs[0]) {
		RuVar(__,__): 0;
		RuRuleNode(idT, __): ruIdType2Id(idT);
	};
	// The unfold-order graph: head(r) → each DIFFERENT class-op in r's rhs, over
	// non-comm rules (comm rules permute the same op multiset — introduce nothing).
	// A growing rule is admitted iff its head lies on NO CYCLE: then the head counts
	// decrease lexicographically along the topological order (e.g. df-symdif may
	// reintroduce ∖ under difindir's feet — △ → ∖ is one-way, nothing reintroduces △ —
	// while the mutually-eliminating distributivity pair ∩ ⇄ ∪ stays rejected).
	// Self-edges are ignored, as before: a same-headed unfold (difindir's ∖ → ∖∖)
	// recurses into strictly smaller arguments; the fuel bound backstops it.
	edges = fold(raw, makeTree(), \ac, r ->
		if (r.comm) ac else {
			h = headOf(r);
			if (h == 0) ac
			else setTree(ac, h, mergeSets(lookupTreeDef(ac, h, makeSet()),
				removeSet(ruFwdClassOps(ids, r.rhs), h)));
		});
	onCycle = \h : int -> {
		// DFS: is h reachable from h through `edges`?
		reach = for(Pair(lookupTreeDef(edges, h, makeSet()), true), \st -> st.second, \st -> {
			next = foldSet(st.first, st.first, \ac, k -> mergeSets(ac, lookupTreeDef(edges, k, makeSet())));
			Pair(next, sizeSet(next) != sizeSet(st.first));
		});
		containsSet(reach.first, h);
	};
	checked = filtermap(raw, \r -> {
		if (!r.grow) Some(r) else {
			h = headOf(r);
			if (h != 0 && !onCycle(h)) Some(RuFwdEqRule(r with elim = true))
			// growing rules on an unfold CYCLE (the ∩⇄∪ distributivity pair):
			// admitted with the INSTANCE-WISE polynomial-decrease guard — the
			// classic termination interpretation I(var)=2, I(∩)=I(∖)=a·b,
			// I(∪)=a+b+1 orients ∩-over-∪ distribution strictly downhill while
			// its ping-pong partner (∪-over-∩) never decreases and never fires.
			else Some(RuFwdEqRule(r with poly = true));
		}
	});
	// COMM-FIRST rule order: at each redex the AC-canonicalizing (comm-shaped,
	// order-decreasing) rules are tried before elim/unfold — so e.g. symdifass
	// converges both nestings of a pure △-term BEFORE dfsymdif-unfolding turns
	// them into ∖∪∩ forms that only distributivity could reconcile.
	withSwaps = concat(checked, ruFwdSynthMidSwaps(ids, eids, checked, stcl));
	concat(filter(withSwaps, \r -> r.comm), filter(withSwaps, \r -> !r.comm));
}

// Synthesize the MIDDLE-SWAP rules for every op with both assoc and com in the
// base — the in12/in32 analogues ((AopB)opC → (AopC)opB and Aop(BopC) → Bop(AopC)).
// Greedy order-decreasing rewriting over {com, assoc±} alone has LOCAL MINIMA in
// an AC class (t91: (x7△x9)△x5 has no decreasing move without the middle swap);
// with adjacent transpositions at every level the sorted form is always reachable.
// Proof = eqtri(assoc±, lifted com, assoc∓) — constructed per instance.
ruFwdSynthMidSwaps(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], stcl : int) -> [RuFwdEqRule] {
	wceq = s2id("wceq"); wff = tp2id_("wff");
	isVar3 = \ns : [RuExpNode] -> length(ns) == 1 && (switch (ns[0]) { RuVar(__,__): true; RuRuleNode(__,__): false; });
	headOf = \ns : [RuExpNode] -> switch (ns[0]) { RuVar(__,__): 0; RuRuleNode(idT, __): ruIdType2Id(idT); };
	arg = \ns : [RuExpNode], i : int -> {
		// i-th (1-based) arg slice of a 2-ary node array
		a1e = ruFwdSpan(ns, 1);
		if (i == 1) subrange(ns, 1, a1e - 1) else subrange(ns, a1e, length(ns) - a1e);
	};
	// find per-op assoc ((A.B).C = A.(B.C), distinct plain vars) and com (A.B = B.A)
	find = \pred : (RuFwdEqRule) -> bool -> fold(rules, makeTree(), \ac, r -> {
		h = headOf(r.lhs);
		if (h == 0 || containsKeyTree(ac, h) || !pred(r)) ac else setTree(ac, h, r);
	});
	assocT = find(\r -> {
		h = headOf(r.lhs);
		length(r.lhs) == 5 && length(r.rhs) == 5
		&& headOf(arg(r.lhs, 1)) == h && isVar3(arg(r.lhs, 2))
		&& headOf(arg(r.rhs, 2)) == h && isVar3(arg(r.rhs, 1))
		&& isVar3(arg(arg(r.lhs, 1), 1)) && isVar3(arg(arg(r.lhs, 1), 2))
		&& arg(arg(r.lhs, 1), 1) == arg(r.rhs, 1)
		&& arg(arg(r.lhs, 1), 2) == arg(arg(r.rhs, 2), 1)
		&& arg(r.lhs, 2) == arg(arg(r.rhs, 2), 2);
	});
	comT = find(\r ->
		length(r.lhs) == 3 && length(r.rhs) == 3
		&& isVar3(arg(r.lhs, 1)) && isVar3(arg(r.lhs, 2))
		&& arg(r.lhs, 1) == arg(r.rhs, 2) && arg(r.lhs, 2) == arg(r.rhs, 1));
	// the lifted-com step: ⊢ (x op a) = (x op b) from com ⊢ a = b context (arg 2)
	liftArg2 = \op : int, x : RuExp, from : RuExp, to : RuExp, inner : RuProofTree -> {
		stmt = RuStmt(stcl, [ruFwdMkRule(wceq, wff, [ruFwdMkRule(op, ids.cls, [x, from]), ruFwdMkRule(op, ids.cls, [x, to])])], -1);
		lem = ruFwdLiftLemma(eids, op, 2);
		if (lem != 0) RuProofStep(lem, [inner], stmt)
		else {
			impl = ruFwdLiftImpl(eids, op, 2);
			implStmt = RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [ruFwdProofTreeExp(inner), ruExp(stmt.exps[0])])], -1);
			RuProofStep(ids.axmp, [inner, RuProofStep(impl, [], implStmt)], stmt);
		}
	};
	liftArg1 = \op : int, from : RuExp, to : RuExp, x : RuExp, inner : RuProofTree -> {
		stmt = RuStmt(stcl, [ruFwdMkRule(wceq, wff, [ruFwdMkRule(op, ids.cls, [from, x]), ruFwdMkRule(op, ids.cls, [to, x])])], -1);
		lem = ruFwdLiftLemma(eids, op, 1);
		if (lem != 0) RuProofStep(lem, [inner], stmt)
		else {
			impl = ruFwdLiftImpl(eids, op, 1);
			implStmt = RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [ruFwdProofTreeExp(inner), ruExp(stmt.exps[0])])], -1);
			RuProofStep(ids.axmp, [inner, RuProofStep(impl, [], implStmt)], stmt);
		}
	};
	liftable = \op : int -> ruFwdLiftLemma(eids, op, 1) != 0 || ruFwdLiftImpl(eids, op, 1) != 0;
	foldTree(assocT, [], \op, ar : RuFwdEqRule, acc -> {
		switch (lookupTree(comT, op)) {
			None(): acc;
			Some(cr): if (!liftable(op)) acc else {
				mkOp = \a : RuExp, b : RuExp -> ruFwdMkRule(op, ids.cls, [a, b]);
				assocStep = \a : RuExp, b : RuExp, c : RuExp -> // ⊢ ((a.b).c) = (a.(b.c))
					ar.mkProof(mkOp(mkOp(a, b), c), mkOp(a, mkOp(b, c)), stcl);
				comStep = \a : RuExp, b : RuExp -> cr.mkProof(mkOp(a, b), mkOp(b, a), stcl);
				eqtriStep = \p1 : RuProofTree, p2 : RuProofTree, l : RuExp, r : RuExp ->
					RuProofStep(eids.eqtri, [p1, p2], RuStmt(stcl, [ruFwdMkRule(wceq, wff, [l, r])], -1));
				eqcomiStep = \p : RuProofTree, l : RuExp, r : RuExp ->
					RuProofStep(eids.eqcomi, [p], RuStmt(stcl, [ruFwdMkRule(wceq, wff, [l, r])], -1));
				// pattern vars (reuse assoc's, which are plain distinct RuVars)
				vA = RuExp(arg(ar.rhs, 1), -1); vB = RuExp(arg(arg(ar.rhs, 2), 1), -1); vC = RuExp(arg(arg(ar.rhs, 2), 2), -1);
				splitInst = \il : RuExp, nested : int -> {
					// il = (a.b).c (nested=1) or a.(b.c) (nested=2): extract (a, b, c)
					o = arg(il.nodes, if (nested == 1) 1 else 2);
					x = arg(il.nodes, if (nested == 1) 2 else 1);
					Triple(
						RuExp(if (nested == 1) arg(o, 1) else x, -1),
						RuExp(if (nested == 1) arg(o, 2) else arg(o, 1), -1),
						RuExp(if (nested == 1) x else arg(o, 2), -1));
				};
				// mid32: (A.B).C → (A.C).B  =  assoc ; lift-com(arg2) ; assoc⁻¹
				lhs32 = ar.lhs; // (A.B).C
				rhs32 = concat3([ar.lhs[0], ar.lhs[0]], concat(vA.nodes, vC.nodes), vB.nodes); // (A.C).B
				r32 = RuFwdEqRule(lhs32, rhs32, true, false, false, false, \il, ir, sc -> {
					t = splitInst(il, 1); a = t.first; b = t.second; c = t.third;
					p1 = assocStep(a, b, c);                                     // (a.b).c = a.(b.c)
					p2 = liftArg2(op, a, mkOp(b, c), mkOp(c, b), comStep(b, c)); // a.(b.c) = a.(c.b)
					p12 = eqtriStep(p1, p2, il, mkOp(a, mkOp(c, b)));
					p3 = eqcomiStep(assocStep(a, c, b), mkOp(a, mkOp(c, b)), ir); // a.(c.b) = (a.c).b
					eqtriStep(p12, p3, il, ir);
				});
				// mid12: A.(B.C) → B.(A.C)  =  assoc⁻¹ ; lift-com(arg1) ; assoc
				lhs12 = ar.rhs; // A.(B.C)
				rhs12 = concat3([ar.lhs[0]], vB.nodes, concat([ar.lhs[0]], concat(vA.nodes, vC.nodes))); // B.(A.C)
				r12 = RuFwdEqRule(lhs12, rhs12, true, false, false, false, \il, ir, sc -> {
					t = splitInst(il, 2); a = t.first; b = t.second; c = t.third;
					p1 = eqcomiStep(assocStep(a, b, c), il, mkOp(mkOp(a, b), c)); // a.(b.c) = (a.b).c
					p2 = liftArg1(op, mkOp(a, b), mkOp(b, a), c, comStep(a, b)); // (a.b).c = (b.a).c
					p12 = eqtriStep(p1, p2, il, mkOp(mkOp(b, a), c));
					p3 = assocStep(b, a, c);                                     // (b.a).c = b.(a.c)
					eqtriStep(p12, p3, il, ir);
				});
				concat3(acc, [r32, r12], []);
			}
		}
	});
}

// The congruence lift lemma for rewriting arg `argIdx` of `op` (1-based); 0 = none.
ruFwdLiftLemma(eids : RuFwdEqIds, op : int, argIdx : int) -> int {
	if (op == eids.cin) { if (argIdx == 1) eids.ineq1i else eids.ineq2i }
	else if (op == eids.cun) { if (argIdx == 1) eids.uneq1i else eids.uneq2i }
	else if (op == eids.cdif) { if (argIdx == 1) eids.difeq1i else eids.difeq2i }
	else if (op == eids.cxp) { if (argIdx == 1) eids.xpeq1i else eids.xpeq2i }
	else if (op == eids.cpw) eids.pweqi
	else if (op == eids.cuni) eids.unieqi
	else if (op == eids.cop) { if (argIdx == 1) eids.opeq1i else eids.opeq2i }
	else 0;
}

// Ops with no 1-hyp *eq*i inference form but a 0-hyp IMPLICATION congruence
// ((A=B) → (A op C) = (B op C)): the lift step is then ax-mp(inner, impl-instance).
// csymdif only has symdifeq1/symdifeq2 — this is what makes △ contexts liftable.
ruFwdLiftImpl(eids : RuFwdEqIds, op : int, argIdx : int) -> int {
	if (op == eids.csymdif) { if (argIdx == 1) eids.symdifeq1 else eids.symdifeq2 }
	else 0;
}

ruFwdProofTreeExp(tr : RuProofTree) -> RuExp {
	switch (tr) {
		RuProofStep(__,__,st): ruExp(st.exps[0]);
		RuProofHyp(__,st): ruExp(st.exps[0]);
	}
}

// Path from the term root to position i: [(ancestor position, 1-based arg index)].
ruFwdPathTo(term : [RuExpNode], i : int, pos : int, acc : [Pair<int, int>]) -> Maybe<[Pair<int, int>]> {
	if (pos == i) Some(acc)
	else switch (term[pos]) {
		RuVar(__,__): None();
		RuRuleNode(idT, al): {
			arity = ruArityLen2Arity(al);
			if (arity == 0) None() else {
				found = fold(enumFromTo(1, arity), Pair(pos + 1, None()), \st, k -> {
					switch (st.second) {
						Some(__): st;
						None(): {
							e = ruFwdSpan(term, st.first);
							if (i >= st.first && i < e) Pair(e, Some(Pair(st.first, k))) else Pair(e, None());
						}
					}
				});
				switch (found.second) {
					None(): None();
					Some(ci): ruFwdPathTo(term, i, ci.first, arrayPush(acc, Pair(pos, ci.second)));
				}
			}
		}
	}
}

// The polynomial termination interpretation for the instance-wise guard:
// I(atom) = 2, I(∩) = I(∖) = a·b, I(∪) = a+b+1; any other class op gets the
// monotone-safe (a+1)(b+1)… product. Doubles saturate at +inf, where the
// strict-decrease comparison fails and the rule simply does not apply — safe.
// I(atom) = 3, NOT 2: at 2 the compound-subtrahend unfold difdif2
// (A∖(B∖C) = (A∖B)∪(A∩C), the DNF direction) is blocked at its minimum
// (2·2·2 = 8 < 9 = 2·2+2·2+1) — at 3 it is strictly decreasing for ALL
// instances (a·b·c − a·b − a·c − 1 = a(b(c−1)−c) − 1 ≥ 8 for values ≥ 3)
// while the admitted distribution family's margins only grow and the
// ping-pong partner (∪ over ∩) stays blocked at every atom weight.
ruFwdPolyI(eids : RuFwdEqIds, nodes : [RuExpNode], pos : int) -> Pair<double, int> {
	switch (nodes[pos]) {
		RuVar(__,__): Pair(3.0, pos + 1);
		RuRuleNode(idT, al): {
			arity = ruArityLen2Arity(al);
			if (arity == 0) Pair(3.0, pos + 1)
			else {
				op = ruIdType2Id(idT);
				args = fold(enumFromTo(1, arity), Pair([], pos + 1), \ac, __ -> {
					r = ruFwdPolyI(eids, nodes, ac.second);
					Pair(arrayPush(ac.first, r.first), r.second);
				});
				v = if (arity == 2 && (op == eids.cin || op == eids.cdif)) args.first[0] * args.first[1]
					else if (arity == 2 && op == eids.cun) args.first[0] + args.first[1] + 1.0
					else fold(args.first, 1.0, \p, a -> p * (a + 1.0));
				Pair(v, args.second);
			}
		}
	}
}

// One rewrite attempt at the leftmost-outermost liftable redex.
// Returns Some((new term nodes, proof of term = new term)) or None (normal form).
ruFwdRewriteStep(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], term : [RuExpNode], stcl : int, math : RuMath, env : RuEnv) -> Maybe<Pair<[RuExpNode], RuProofTree>> {
	wceq = s2id("wceq"); wff = tp2id_("wff");
	pathTo = \i : int -> ruFwdPathTo(term, i, 0, []);
	positions = enumFromTo(0, length(term) - 1);
	fold(positions, None(), \found, i ->
		switch (found) {
			Some(__): found;
			None(): {
				send = ruFwdSpan(term, i);
				sub = subrange(term, i, send - i);
				// try rules at this position
				hit = fold(rules, None(), \h, r -> switch (h) {
					Some(__): h;
					None(): switch (ruMatchExp(RuExp(sub, -1), RuExp(r.lhs, -1), math, env)) {
						None(): None();
						Some(sigma): {
							irhs = ruApplySubst(RuExp(r.rhs, -1), sigma);
							okComm = !r.comm || ruFwdNodeLess(irhs.nodes, sub);
							okGrow = !r.grow || r.elim
								|| (r.poly && (ruFwdPolyI(eids, irhs.nodes, 0)).first < (ruFwdPolyI(eids, sub, 0)).first);
							if (!okComm || !okGrow) None()
							else Some(Pair(irhs.nodes, r.mkProof(RuExp(sub, -1), irhs, stcl)));
						}
					}
				});
				switch (hit) {
					None(): None();
					Some(hp) : {
						switch (pathTo(i)) {
							None(): None();
							Some(path): {
								// liftable path check (1-hyp inference OR 0-hyp implication form)
								liftable = forall(path, \pe -> switch (term[pe.first]) {
									RuVar(__,__): false;
									RuRuleNode(idT, __): ruFwdLiftLemma(eids, ruIdType2Id(idT), pe.second) != 0
										|| ruFwdLiftImpl(eids, ruIdType2Id(idT), pe.second) != 0;
								});
								if (!liftable) None() else {
									// Splice the rewritten subtree AND recompute every ancestor's
									// packed LEN by the size delta - node lens are subtree sizes,
									// and stale ancestor lens after a shrinking/growing rewrite
									// produce MALFORMED expressions (verifier walks overshoot)
									// and false normal-form mismatches.
									delta = length(hp.first) - (send - i);
									ancs = buildSet(map(path, \pe -> pe.first));
									newTerm = mapi(concat3(subrange(term, 0, i), hp.first, subrange(term, send, length(term) - send)),
										\j, n -> if (!containsSet(ancs, j)) n else switch (n) {
											RuVar(__,__): n;
											RuRuleNode(idT, al): ruMakeRuleNode(ruIdType2Id(idT), ruIdType2Type(idT),
												ruArityLen2Arity(al), ruArityLen2Len(al) + delta);
										});
									// Lift from the innermost ancestor to the root. Positions
									// BELOW an ancestor are identical in term and newTerm (only
									// the subtree at i changed), so the rewritten ancestor is
									// simply the subtree at the SAME position in newTerm — no
									// splice arithmetic (the previous version built malformed
									// expressions and crashed the verifier).
									tree = fold(reverseA(path), hp.second, \tr, pe -> {
										anc = pe.first; idx = pe.second;
										before = subrange(term, anc, ruFwdSpan(term, anc) - anc);
										after  = subrange(newTerm, anc, ruFwdSpan(newTerm, anc) - anc);
										op = switch (term[anc]) { RuVar(__,__): 0; RuRuleNode(idT,__): ruIdType2Id(idT); };
										lift = ruFwdLiftLemma(eids, op, idx);
										stmt = RuStmt(stcl, [ruFwdMkRule(wceq, wff, [RuExp(before, -1), RuExp(after, -1)])], -1);
										if (lift != 0) RuProofStep(lift, [tr], stmt)
										else {
											// 0-hyp implication congruence: ax-mp(inner, ⊢ inner-eq → ancestor-eq)
											impl = ruFwdLiftImpl(eids, op, idx);
											implStmt = RuStmt(stcl,
												[ruFwdMkRule(ids.wi, ids.wff, [ruFwdProofTreeExp(tr), ruExp(stmt.exps[0])])], -1);
											RuProofStep(ids.axmp, [tr, RuProofStep(impl, [], implStmt)], stmt);
										}
									});
									Some(Pair(newTerm, tree));
								}
							}
						}
					}
				}
			}
		});
}

// Normalize a term: fixpoint of ruFwdRewriteStep (bounded), chaining step proofs by eqtri.
// Returns (normal form, Some(proof of term = nf)) - None proof when already normal.
ruFwdNormalize(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], term0 : [RuExpNode], stcl : int, math : RuMath, env : RuEnv) -> Pair<[RuExpNode], Maybe<RuProofTree>> {
	wceq = s2id("wceq"); wff = tp2id_("wff");
	ruFwdNormalizeRec(ids, eids, filter(rules, \r -> r.comm), rules, term0, term0, None(), 512, stcl, math, env);
}

ruFwdNormalizeRec(ids : RuFwdInstIds, eids : RuFwdEqIds, commRules : [RuFwdEqRule], rules : [RuFwdEqRule], term0 : [RuExpNode], term : [RuExpNode], acc : Maybe<RuProofTree>, fuel : int, stcl : int, math : RuMath, env : RuEnv) -> Pair<[RuExpNode], Maybe<RuProofTree>> {
	wceq = s2id("wceq"); wff = tp2id_("wff");
	if (fuel <= 0 || length(term) > 512) Pair(term, acc)
	else {
		// AC-canonicalize to a GLOBAL fixpoint before any elim/unfold step: comm rules
		// only, at every position, until none applies (each comm step is same-length
		// order-decreasing — a strict lex descent, so this terminates). Per-position
		// comm-first is NOT enough: leftmost-outermost lets a root elim (df-symdif)
		// fire while an inner subterm is still one comm step away from the AC minimum —
		// the two sides of the goal then unfold from DIFFERENT arrangements and never
		// reconcile (t91).
		commStep = ruFwdRewriteStep(ids, eids, commRules, term, stcl, math, env);
		switch (switch (commStep) {
			Some(__): commStep;
			None(): ruFwdRewriteStep(ids, eids, rules, term, stcl, math, env);
		}) {
			None(): Pair(term, acc);
			Some(st): {
				chained = switch (acc) {
					None(): Some(st.second);
					Some(prev): Some(RuProofStep(eids.eqtri, [prev, st.second],
						RuStmt(stcl, [ruFwdMkRule(wceq, wff, [RuExp(term0, -1), RuExp(st.first, -1)])], -1)));
				};
				ruFwdNormalizeRec(ids, eids, commRules, rules, term0, st.first, chained, fuel - 1, stcl, math, env);
			}
		}
	}
}

ruFwdEqDump(lbl : string, t : RuProofTree, d : int, prover_env : RuProverEnv) -> void {
	switch (t) {
		RuProofStep(as, ch, st2): {
			prover_env.env.out.println("  eqnorm" + lbl + " " + i2s(d) + " " + id2s(as) + ": " + ruSafeExp2s(ruExp(st2.exps[0]), prover_env.math.decls.lang));
			iter(ch, \c -> ruFwdEqDump(lbl, c, d + 1, prover_env));
		}
		RuProofHyp(__,__): {};
	}
}

// Strip the ∀-prefix of a CONST-task goal (each bound var is a frozen zero-arity
// setvar node): returns (each ∀-level's full expression, outermost first; the
// quantifier-free body). Each stripped level is re-added around the final proof
// by an ax-gen step — ∀x…(X = Y) is the standard Mizar equality-theorem form.
ruFwdStripWalPrefix(ids : RuFwdInstIds, nodes : [RuExpNode], acc : [[RuExpNode]]) -> Pair<[[RuExpNode]], [RuExpNode]> {
	switch (nodes[0]) {
		RuVar(__,__): Pair(acc, nodes);
		RuRuleNode(idT, __): {
			if (ruIdType2Id(idT) == ids.wal && length(nodes) > 2 && ruFwdIsSetvarNode(nodes[1], ids.setvar)) {
				ruFwdStripWalPrefix(ids, subrange(nodes, 2, length(nodes) - 2), arrayPush(acc, nodes));
			} else Pair(acc, nodes);
		}
	}
}

// SYMBOL CLOSURE for the eq-rule base (deliberately WIDER than ruSeedIdentityFront's
// one-shot filter): an identity is admitted once its LHS class-ops are reachable;
// its RHS ops then become reachable themselves. Definition unfolding legitimately
// INTRODUCES symbols — dfsymdif3 rewrites a △-goal into ∪∖∩ vocabulary the goal
// never mentions, and the ∪-side laws must follow it in. Safe here where it is
// junk in the seeder: rewriting is deterministic (one leftmost-outermost redex per
// step, termination by ruFwdEqRulesChecked), it feeds no wave.
ruFwdCloseIdents(ids : RuFwdInstIds, taskOps : Set<int>, cands : [RuAssertion]) -> [RuAssertion] {
	ops = map(cands, \a -> {
		cn = (ruExp(a.infer.prop.exps[0])).nodes;
		le = ruFwdSpan(cn, 1);
		Pair(ruFwdClassOps(ids, subrange(cn, 1, le - 1)), ruFwdClassOps(ids, subrange(cn, le, length(cn) - le)));
	});
	closed = for(Triple(taskOps, makeSet(), true), \st -> st.third, \st ->
		foldi(cands, Triple(st.first, st.second, false), \i, ac, __ ->
			if (containsSet(ac.second, i)) ac
			else if (foldSet(ops[i].first, true, \sub, op -> sub && containsSet(ac.first, op)))
				Triple(mergeSets(ac.first, ops[i].second), insertSet(ac.second, i), true)
			else ac));
	filtermapi(cands, \i, a -> if (containsSet(closed.second, i)) Some(a) else None());
}

// LEAF FACTS OF THE PREMISES, ∧-FLATTENED: each premise contributes its non-∧
// leaf conjuncts, each with a constructed proof (RuProofHyp + simpli/simpri
// chains). The unss-style ∧-premise forms (t97: ((A∖B)⊆C) ∧ ((B∖A)⊆C)) are
// forward-dead as wave triggers but perfectly usable on the deterministic route.
ruFwdSsConjuncts(ids : RuFwdInstIds, proof : RuProofTree, nodes : [RuExpNode], stcl : int) -> [Pair<RuProofTree, [RuExpNode]>] {
	isWa = switch (nodes[0]) {
		RuVar(__,__): false;
		RuRuleNode(idT, __): ruIdType2Id(idT) == ids.wa;
	};
	if (isWa && length(nodes) >= 3) {
		lend = ruFwdSpan(nodes, 1);
		l = subrange(nodes, 1, lend - 1);
		r = subrange(nodes, lend, length(nodes) - lend);
		concat(
			ruFwdSsConjuncts(ids, RuProofStep(s2id_("simpli"), [proof], RuStmt(stcl, [RuExp(l, -1)], -1)), l, stcl),
			ruFwdSsConjuncts(ids, RuProofStep(s2id_("simpri"), [proof], RuStmt(stcl, [RuExp(r, -1)], -1)), r, stcl)
		);
	} else [Pair(proof, nodes)];
}

ruFwdSsPremises(ids : RuFwdInstIds, premises : [RuPremise], stcl : int) -> [Pair<RuProofTree, [RuExpNode]>] {
	concatA(mapi(premises, \pi, p ->
		ruFwdSsConjuncts(ids, RuProofHyp(pi, p.stmt), (ruExp(p.stmt.exps[0])).nodes, stcl)
	));
}

// THE CLASSIFIED FACT POOLS of a premise/conjunct leaf list, each fact carrying
// a proof in the current mode (⊢· bare, ψ→· under a guard):
//   ss  — ⊆-facts (bare literals, the ⊆-half of dfpss2 ⊊-unfolds, (A∖B)=∅ via
//         ssdif0, both halves of every equality via eqimss/eqimss2, and the
//         df-ss fold of a ∀x(x∈A→x∈B) literal)
//   pss — ⊊-facts;  eq0 — T=∅ facts;  ors — ∨-facts (the case-split sources)
//   el  — membership facts x∈T, with compound T UNFOLDED through the el-biconds
//         (elun→ors, elin→two els, eldif→el+¬el, elsymdif→¬↔, velsn→x=y)
//   bi  — ↔-facts;  eqs — ALL equality facts (element-transport sources)
//   neg — negated literals ¬X, X ∈ {⊆,=,⊊,∧,∨,∈,↔}: the clash-candidate pool
//         (an ∃x(x∈T) literal lands here as ¬(T=∅) via neq0; a ∀x(x∈A↔x∈B)
//         literal folds to the equality A=B via dfcleq)
// The uniform (ψ→atom proof, atom nodes) pool for the table closer: the classified
// pools re-flattened; neg entries rebuilt to their ¬-atom form, eq0 entries (which
// store just the set T) rebuilt to the T=∅ equality they stand for.
ruFwdTcPool(ids : RuFwdInstIds, facts : RuFwdClsFacts) -> [Pair<RuProofTree, [RuExpNode]>] {
	emptyE = RuExp([ruMakeRuleNode(s2id("c0"), ids.cls, 0, 0)], -1);
	concatA([
		facts.ss, facts.pss, facts.el, facts.bi, facts.eqs, facts.ors,
		map(facts.neg, \f -> Pair(f.first, ruFwdMkRule(ids.wn, ids.wff, [RuExp(f.second, -1)]).nodes)),
		map(facts.eq0, \f -> Pair(f.first, ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(f.second, -1), emptyE]).nodes))
	]);
}

RuFwdClsFacts(
	ss  : [Pair<RuProofTree, [RuExpNode]>],
	pss : [Pair<RuProofTree, [RuExpNode]>],
	eq0 : [Pair<RuProofTree, [RuExpNode]>],
	ors : [Pair<RuProofTree, [RuExpNode]>],
	el  : [Pair<RuProofTree, [RuExpNode]>],
	bi  : [Pair<RuProofTree, [RuExpNode]>],
	eqs : [Pair<RuProofTree, [RuExpNode]>],
	neg : [Pair<RuProofTree, [RuExpNode]>]
);

ruFwdEmptyClsFacts = RuFwdClsFacts([], [], [], [], [], [], [], []);

ruFwdBuildClsFacts(ids : RuFwdInstIds, asses : RuIndex<RuAssertion>, fresher : (RuVar) -> RuVar, facts : [Pair<RuProofTree, [RuExpNode]>], stcl : int, guard : Maybe<RuExp>) -> RuFwdClsFacts {
	base = fold(facts, ruFwdEmptyClsFacts, \ac, f -> ruFwdClassifyFact(ids, f, stcl, guard, ac, 4));
	// CROSS-DERIVATION (one bounded pass, no fixpoint): an el-fact x∈u whose set u
	// equals — by a pooled eqs-fact, either orientation — an ENUMERATION/ordered-pair
	// term T transports through eleq2 to x∈T and re-classifies: the derived fact then
	// cascades through velsn/velpr/veltp (and the vdfop Kuratowski unfold) into the
	// equality/case-split facts the pools otherwise miss (zfmisc_1 t93-class:
	// x26∈x24 + x24=〈x5,x8〉 → the (x26={x5}) ∨ (x26={x5,x8}) ors-fact).
	wrap = \e : RuExp -> switch (guard) { None(): e; Some(g): ruFwdMkRule(ids.wi, ids.wff, [g, e]) };
	enumHead = \n : [RuExpNode] -> switch (n[0]) {
		RuVar(__,__): false;
		RuRuleNode(idT, __): {
			h = ruIdType2Id(idT);
			h == s2id("csn") || h == s2id("cpr") || h == s2id("ctp") || h == s2id("cop");
		}
	};
	crossed = fold(base.el, base, \ac, f -> {
		fn = f.second;
		flend = ruFwdSpan(fn, 1);
		x = subrange(fn, 1, flend - 1);
		u = subrange(fn, flend, length(fn) - flend);
		fold(base.eqs, ac, \ac2, q -> {
			qn = q.second;
			qend = ruFwdSpan(qn, 1);
			l = subrange(qn, 1, qend - 1);
			r = subrange(qn, qend, length(qn) - qend);
			target = if (u == l && enumHead(r)) r else if (u == r && enumHead(l)) l else [];
			if (target == []) ac2
			else {
				dE = ruFwdMkRule(ids.wcel, ids.wff, [RuExp(x, -1), RuExp(target, -1)]);
				if (exists(ac2.el, \g -> g.second == dE.nodes)) ac2
				else {
					biE = ruFwdMkRule(ids.wb, ids.wff, [
						ruFwdMkRule(ids.wcel, ids.wff, [RuExp(x, -1), RuExp(l, -1)]),
						ruFwdMkRule(ids.wcel, ids.wff, [RuExp(x, -1), RuExp(r, -1)])]);
					inst = RuProofStep(s2id_("eleq2"), [], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [RuExp(qn, -1), biE])], -1));
					pBi = switch (guard) {
						None(): RuProofStep(ids.axmp, [q.first, inst], RuStmt(stcl, [biE], -1));
						Some(__): RuProofStep(s2id_("syl"), [q.first, inst], RuStmt(stcl, [wrap(biE)], -1));
					};
					mpId = if (u == l) (switch (guard) { None(): s2id_("mpbi"); Some(__): s2id_("mpbid"); })
						else (switch (guard) { None(): s2id_("mpbir"); Some(__): s2id_("mpbird"); });
					pD = RuProofStep(mpId, [f.first, pBi], RuStmt(stcl, [wrap(dE)], -1));
					ruFwdClassifyFact(ids, Pair(pD, dE.nodes), stcl, guard, ac2, 4);
				}
			}
		});
	});
	// PRODUCT-⊆ DECOMPOSITION (also one bounded pass): a pooled (A×B)⊆(C×D)
	// with a pooled nonemptiness ¬((A×B)=∅) decomposes through ssxpb
	// ((A×B)≠∅ → ((A×B)⊆(C×D) ↔ (A⊆C)∧(B⊆D))) into the factor ⊆-facts —
	// set.mm has discharged the witness/∃-elim argument once and for all
	// (t114-class: x17×x18 ⊆ x22×x23 + ¬(x17×x18=∅) → x17⊆x22, x18⊆x23).
	empty = [ruMakeRuleNode(s2id("c0"), ids.cls, 0, 0)];
	cxpId = s2id("cxp");
	isXp = \e : [RuExpNode] -> length(e) >= 3 && switch (e[0]) {
		RuVar(__,__): false;
		RuRuleNode(idT9, __): ruIdType2Id(idT9) == cxpId;
	};
	prodded = fold(crossed.ss, crossed, \ac, sf -> {
		sn = sf.second;
		slend = ruFwdSpan(sn, 1);
		u = subrange(sn, 1, slend - 1);
		v = subrange(sn, slend, length(sn) - slend);
		if (!isXp(u) || !isXp(v)) ac else {
			eqU0 = ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(u, -1), RuExp(empty, -1)]);
			mNe = fold(ac.neg, None(), \acN, nf -> switch (acN) {
				Some(__): acN;
				None(): if (nf.second == eqU0.nodes) Some(nf.first) else None();
			});
			switch (mNe) {
				None(): ac;
				Some(pn): {
					aend = ruFwdSpan(u, 1);
					ua = subrange(u, 1, aend - 1);
					ub = subrange(u, aend, length(u) - aend);
					vend = ruFwdSpan(v, 1);
					vc = subrange(v, 1, vend - 1);
					vd = subrange(v, vend, length(v) - vend);
					neE = ruFwdMkRule(s2id("wne"), ids.wff, [RuExp(u, -1), RuExp(empty, -1)]);
					biNeE = ruFwdMkRule(ids.wb, ids.wff, [neE, ruFwdMkRule(ids.wn, ids.wff, [eqU0])]);
					dfneInst = RuProofStep(s2id_("df-ne"), [], RuStmt(stcl, [biNeE], -1));
					pNe = switch (guard) {
						None(): RuProofStep(s2id_("mpbir"), [pn, dfneInst], RuStmt(stcl, [neE], -1));
						Some(g): RuProofStep(s2id_("mpbird"), [pn,
							RuProofStep(s2id_("a1i"), [dfneInst], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [g, biNeE])], -1))],
							RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [g, neE])], -1));
					};
					andE = ruFwdMkRule(ids.wa, ids.wff, [
						ruFwdMkRule(ids.wss, ids.wff, [RuExp(ua, -1), RuExp(vc, -1)]),
						ruFwdMkRule(ids.wss, ids.wff, [RuExp(ub, -1), RuExp(vd, -1)])]);
					biE = ruFwdMkRule(ids.wb, ids.wff, [RuExp(sn, -1), andE]);
					sxInst = RuProofStep(s2id_("ssxpb"), [], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [neE, biE])], -1));
					pBi = switch (guard) {
						None(): RuProofStep(ids.axmp, [pNe, sxInst], RuStmt(stcl, [biE], -1));
						Some(g): RuProofStep(s2id_("syl"), [pNe, sxInst], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [g, biE])], -1));
					};
					pAnd = switch (guard) {
						None(): RuProofStep(s2id_("mpbi"), [sf.first, pBi], RuStmt(stcl, [andE], -1));
						Some(g): RuProofStep(s2id_("mpbid"), [sf.first, pBi], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [g, andE])], -1));
					};
					ruFwdClassifyFact(ids, Pair(pAnd, andE.nodes), stcl, guard, ac, 4);
				}
			}
		}
	});
	// ---- THE RULE-FIRING TAIL (Mizar's Unifier over the pools) ----
	// (D) DEFINITIONAL pr_-ATOM UNFOLD: a pooled article-predicate atom fact
	// (pr_trivial T) finds its definitional axiom ∀v((pr_X v) ↔ B(v)) in the
	// FULL index, spcv-instantiates it at T (the albid binder case carries the
	// chain under B's own ∀s) and mpbi yields the mode fact B(T) — a ∀∀-rule
	// the instantiation rounds below fire (t130-132: d10 trivial)
	prAtoms = filter(facts, \f0 -> switch (f0.second[0]) {
		RuVar(__,__): false;
		RuRuleNode(idTp0, al0): ruArityLen2Arity(al0) == 1 && startsWith(id2s(ruIdType2Id(idTp0)), "pr_");
	});
	defRules : [Pair<RuProofTree, [RuExpNode]>] = if (prAtoms == []) [] else fold(prAtoms, [], \acD, f0 -> {
		fn0 = f0.second;
		rid0 = switch (fn0[0]) { RuVar(__,__): -1; RuRuleNode(idTp1, __): ruIdType2Id(idTp1); };
		tArg = subrange(fn0, 1, length(fn0) - 1);
		mAx = fold(ruIndexValues(asses), None(), \acA, a -> switch (acA) {
			Some(__): acA;
			None(): {
				if (length(a.infer.hyps) != 0) None() else {
					an = (ruExp(a.infer.prop.exps[0])).nodes;
					ok0 = length(an) > 4 && (switch (an[0]) {
						RuVar(__,__): false;
						RuRuleNode(idTa0, __): ruIdType2Id(idTa0) == ids.wal;
					}) && ruFwdIsSetvarNode(an[1], ids.setvar) && (switch (an[2]) {
						RuVar(__,__): false;
						RuRuleNode(idTb0, __): ruIdType2Id(idTb0) == ids.wb;
					});
					if (!ok0) None() else {
						vN = an[1];
						wbBody = subrange(an, 2, length(an) - 2);
						lend9 = ruFwdSpan(wbBody, 1);
						lhs9 = subrange(wbBody, 1, lend9 - 1);
						lhsOk = length(lhs9) == 3 && (switch (lhs9[0]) {
							RuVar(__,__): false;
							RuRuleNode(idTl9, __): ruIdType2Id(idTl9) == rid0;
						}) && lhs9[2] == vN;
						if (!lhsOk) None() else Some(Pair(a, an));
					}
				}
			}
		});
		switch (mAx) {
			None(): acD;
			Some(ax): {
				// FRESHEN the axiom's vars (RuVar → fresh RuVar, the wave's own
				// convention) so the instantiated statements never collide with
				// task or sibling-instance vars
				anMap = fold(ax.second, makeTree(), \acM, n9 -> switch (n9) {
					RuVar(vid9, vtp9): if (containsKeyTree(acM, vid9)) acM else setTree(acM, vid9, fresher(RuVar(vid9, vtp9)));
					RuRuleNode(__,__): acM;
				});
				an = map(ax.second, \n9 -> switch (n9) {
					RuVar(vid9, __): lookupTreeDef(anMap, vid9, n9);
					RuRuleNode(__,__): n9;
				});
				vN = an[1];
				wbBody = subrange(an, 2, length(an) - 2);
				lend9 = ruFwdSpan(wbBody, 1);
				xocc9 = subrange(wbBody, 1 + 1, 2); // the coercion+v slice inside the atom
				tExp9 = RuExp(tArg, -1);
				ante9 = ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(xocc9, -1), tExp9]);
				switch (ruFwdBiChain(ids, ante9, vN, xocc9, tExp9, wbBody, stcl)) {
					None(): acD;
					Some(ch9): switch (ruFwdSetness(ids, tArg, stcl)) {
						None(): acD;
						Some(setn9): {
							spcv9 = RuProofStep(ids.spcv, [setn9, ch9.second],
								RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [RuExp(an, -1), ch9.first])], -1));
							pBi9 = RuProofStep(ids.axmp, [
								RuProofStep(ax.first.info.id, [], RuStmt(stcl, [RuExp(an, -1)], -1)), spcv9],
								RuStmt(stcl, [ch9.first], -1));
							// ch9.first = (atom(T) ↔ B(T)); extract B(T), mpbi with the mode fact
							cn9 = ch9.first.nodes;
							cend9 = ruFwdSpan(cn9, 1);
							rhs9 = subrange(cn9, cend9, length(cn9) - cend9);
							biArg9 = switch (guard) {
								None(): pBi9;
								Some(g9): RuProofStep(s2id_("a1i"), [pBi9],
									RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [g9, ch9.first])], -1));
							};
							mpbi9 = switch (guard) { None(): s2id_("mpbi"); Some(__): s2id_("mpbid"); };
							wrap9 = \e9 : RuExp -> switch (guard) { None(): e9; Some(g9b): ruFwdMkRule(ids.wi, ids.wff, [g9b, e9]); };
							pRule9 = RuProofStep(mpbi9, [f0.first, biArg9],
								RuStmt(stcl, [wrap9(RuExp(rhs9, -1))], -1));
							arrayPush(acD, Pair(pRule9, rhs9));
						}
					}
				}
			}
		}
	});
	// (R) ∀-RULE FIRING at pool elements, TWO rounds (∀u∀v rules instantiate
	// outer-then-inner): a ∀-fact with a (v∈A)→P body keeps the exact el-MATCH
	// + MP fast path; ANY other ∀-body instantiates at every pooled element
	// (deduped, capped) and the result classifies in — a derived ∀-fact rides
	// to the next round. Deterministic, timer-free (the pool and cap bound it).
	elems9 = take(fold(prodded.el, [], \acE9, ef9 -> {
		e9end = ruFwdSpan(ef9.second, 1);
		e9 = subrange(ef9.second, 1, e9end - 1);
		if (contains(acE9, e9)) acE9 else arrayPush(acE9, e9);
	}), 8);
	instAt9 = \wfP : RuProofTree, wn0 : [RuExpNode], tS : [RuExpNode] -> {
		xnode9 = wn0[1];
		wbody9 = subrange(wn0, 2, length(wn0) - 2);
		xoccF = fold(enumFromTo(0, length(wbody9) - 2), [], \accO, i9 ->
			if (accO != []) accO
			else switch (wbody9[i9]) {
				RuVar(__,__): accO;
				RuRuleNode(idTo9, alo9): {
					if (ruArityLen2Arity(alo9) == 1 && ruIdType2Type(idTo9) == ids.cls && wbody9[i9 + 1] == xnode9)
						[wbody9[i9], wbody9[i9 + 1]]
					else accO;
				}
			});
		if (xoccF == [] || ruFwdContainsNode(tS, xnode9)) None() else {
			tE9 = RuExp(tS, -1);
			anteI = ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(xoccF, -1), tE9]);
			switch (ruFwdBiChain(ids, anteI, xnode9, xoccF, tE9, wbody9, stcl)) {
				None(): None();
				Some(chI): switch (ruFwdSetness(ids, tS, stcl)) {
					None(): None();
					Some(setnI): {
						spcvI = RuProofStep(ids.spcv, [setnI, chI.second],
							RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [RuExp(wn0, -1), chI.first])], -1));
						pI = switch (guard) {
							None(): RuProofStep(ids.axmp, [wfP, spcvI], RuStmt(stcl, [chI.first], -1));
							Some(gI): RuProofStep(s2id_("syl"), [wfP, spcvI],
								RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [gI, chI.first])], -1));
						};
						Some(Pair(pI, chI.first.nodes));
					}
				}
			}
		}
	};
	procRound = \fsR : [Pair<RuProofTree, [RuExpNode]>], acR0 : RuFwdClsFacts -> fold(fsR, Pair(acR0, []), \accR : Pair<RuFwdClsFacts, [Pair<RuProofTree, [RuExpNode]>]>, wf -> {
		wn0 = wf.second;
		walOk = length(wn0) > 2 && (switch (wn0[0]) {
			RuVar(__,__): false;
			RuRuleNode(idTw, __): ruIdType2Id(idTw) == ids.wal;
		}) && ruFwdIsSetvarNode(wn0[1], ids.setvar);
		if (!walOk) accR else {
			xnode = wn0[1];
			wbody = subrange(wn0, 2, length(wn0) - 2);
			wiOk = length(wbody) >= 3 && switch (wbody[0]) {
				RuVar(__,__): false;
				RuRuleNode(idTi, __): ruIdType2Id(idTi) == ids.wi;
			};
			celGuard = if (!wiOk) [] else {
				glend = ruFwdSpan(wbody, 1);
				gl = subrange(wbody, 1, glend - 1);
				celOk = length(gl) >= 4 && (switch (gl[0]) {
					RuVar(__,__): false;
					RuRuleNode(idTc, __): ruIdType2Id(idTc) == ids.wcel;
				}) && ruFwdSpan(gl, 1) == 3 && gl[2] == xnode;
				if (!celOk) [] else {
					ga = subrange(gl, 3, length(gl) - 3);
					if (ruFwdContainsNode(ga, xnode)) [] else ga;
				}
			};
			if (celGuard != []) {
				// the (v∈A)→P fast path: fire ONLY at el-matches (t∈A), MP away the guard
				acWi = fold(accR.first.el, accR.first, \ac2, ef -> {
					en = ef.second;
					eend = ruFwdSpan(en, 1);
					et = subrange(en, 1, eend - 1);
					ea = subrange(en, eend, length(en) - eend);
					if (ea != celGuard) ac2 else switch (instAt9(wf.first, wn0, et)) {
						None(): ac2;
						Some(instP): {
							pn = instP.second;
							pend2 = ruFwdSpan(pn, 1);
							pInst = subrange(pn, pend2, length(pn) - pend2);
							wrapG = \e2 : RuExp -> switch (guard) { None(): e2; Some(g): ruFwdMkRule(ids.wi, ids.wff, [g, e2]); };
							mpG = switch (guard) { None(): ids.axmp; Some(__): s2id_("mpd"); };
							pP = RuProofStep(mpG, [ef.first, instP.first], RuStmt(stcl, [wrapG(RuExp(pInst, -1))], -1));
							ruFwdClassifyFact(ids, Pair(pP, pInst), stcl, guard, ac2, 4);
						}
					}
				});
				Pair(acWi, accR.second);
			} else {
				// the GENERAL path: instantiate at every pooled element
				fold(elems9, accR, \accG, e9 -> switch (instAt9(wf.first, wn0, e9)) {
					None(): accG;
					Some(instP): {
						derivedWal = length(instP.second) > 2 && (switch (instP.second[0]) {
							RuVar(__,__): false;
							RuRuleNode(idTd9, __): ruIdType2Id(idTd9) == ids.wal;
						});
						if (derivedWal) Pair(accG.first, arrayPush(accG.second, instP))
						else Pair(ruFwdClassifyFact(ids, instP, stcl, guard, accG.first, 4), accG.second);
					}
				});
			}
		}
	});
	r1 = procRound(concat(facts, defRules), prodded);
	r2 = procRound(r1.second, r1.first);
	r2.first;
}

// Classify ONE fact into the pools, recursively adding the facts DERIVABLE from
// it by one definitional unfold (el-biconds, dfpss2, ssdif0, df-ss, dfcleq,
// neq0, ioran…). `depth` bounds the unfold recursion.
ruFwdClassifyFact(ids : RuFwdInstIds, f : Pair<RuProofTree, [RuExpNode]>, stcl : int, guard : Maybe<RuExp>, ac : RuFwdClsFacts, depth : int) -> RuFwdClsFacts {
	wpss = s2id("wpss");
	wceq = s2id("wceq");
	csn  = s2id("csn");
	wrap = \e : RuExp -> switch (guard) { None(): e; Some(g): ruFwdMkRule(ids.wi, ids.wff, [g, e]); };
	lift = \asId : int, e : RuExp -> {
		bare = RuProofStep(asId, [], RuStmt(stcl, [e], -1));
		switch (guard) {
			None(): bare;
			Some(__): RuProofStep(s2id_("a1i"), [bare], RuStmt(stcl, [wrap(e)], -1));
		}
	};
	mpbi  = switch (guard) { None(): s2id_("mpbi");  Some(__): s2id_("mpbid");  };
	mpbir = switch (guard) { None(): s2id_("mpbir"); Some(__): s2id_("mpbird"); };
	mtbi  = switch (guard) { None(): s2id_("mtbi");  Some(__): s2id_("mtbid");  };
	simpl = switch (guard) { None(): s2id_("simpli"); Some(__): s2id_("simpld"); };
	simpr = switch (guard) { None(): s2id_("simpri"); Some(__): s2id_("simprd"); };
	empty = [ruMakeRuleNode(s2id("c0"), ids.cls, 0, 0)];
	// apply a bicond instance ⊢(cur ↔ D) to the mode fact of cur — mode proof of D
	fwdBi = \pf : RuProofTree, curE : RuExp, biId : int, dE : RuExp -> {
		inst = lift(biId, ruFwdMkRule(ids.wb, ids.wff, [curE, dE]));
		RuProofStep(mpbi, [pf, inst], RuStmt(stcl, [wrap(dE)], -1));
	};
	rec = \pf : RuProofTree, nn : [RuExpNode], acc : RuFwdClsFacts ->
		if (depth <= 0) acc
		else ruFwdClassifyFact(ids, Pair(pf, nn), stcl, guard, acc, depth - 1);
	nodes = f.second;
	switch (nodes[0]) {
		RuVar(__,__): ac;
		RuRuleNode(idT, __): {
			hid = ruIdType2Id(idT);
			if (hid == ids.wss) {
				ac0w = RuFwdClsFacts(ac with ss = arrayPush(ac.ss, f));
				// an ENUMERATION on the left ({v}⊆B, {u,v}⊆B, {u,v,w}⊆B with setvar
				// elements) yields the member el-facts through the vsnss/vprss/vtpss
				// biconditionals (zfmisc_1's equality-extraction class: the derived
				// els then unfold on through velsn/velpr into equality facts)
				lend0 = ruFwdSpan(nodes, 1);
				la = subrange(nodes, 1, lend0 - 1);
				lb = subrange(nodes, lend0, length(nodes) - lend0);
				lh = switch (la[0]) { RuVar(__,__): -1; RuRuleNode(idTe, __): ruIdType2Id(idTe); };
				rh = switch (lb[0]) { RuVar(__,__): -1; RuRuleNode(idTr, __): ruIdType2Id(idTr); };
				// A ⊆ (B∪C) transposes to the ∖-fact (A∖B)⊆C (ssundif) — the
				// ∖-algebra piece the ∉-premise theorems chain through
				// (t135/t138-class: X⊆(Y∪{v}) → (X∖Y)⊆{v})
				acU = if (rh != ids.cun || length(lb) < 3) ac0w else {
					rend = ruFwdSpan(lb, 1);
					rb = subrange(lb, 1, rend - 1);
					rc = subrange(lb, rend, length(lb) - rend);
					difE = ruFwdMkRule(ids.cdif, ids.cls, [RuExp(la, -1), RuExp(rb, -1)]);
					ssE = ruFwdMkRule(ids.wss, ids.wff, [difE, RuExp(rc, -1)]);
					pSsU = RuProofStep(mpbi, [f.first,
						lift(s2id_("ssundif"), ruFwdMkRule(ids.wb, ids.wff, [RuExp(nodes, -1), ssE]))],
						RuStmt(stcl, [wrap(ssE)], -1));
					acU1 = rec(pSsU, ssE.nodes, ac0w);
					// … and the COMMUTED child (A∖C)⊆B (uncom + sseq2 fold to
					// A⊆(C∪B), then ssundif) — t135-class: X⊆(Y∪{v}) needs
					// (X∖{v})⊆Y, the ∖ by the OTHER factor
					unCE = ruFwdMkRule(ids.cun, ids.cls, [RuExp(rc, -1), RuExp(rb, -1)]);
					ssCE = ruFwdMkRule(ids.wss, ids.wff, [RuExp(la, -1), unCE]);
					eqUnE = ruFwdMkRule(wceq, ids.wff, [RuExp(lb, -1), unCE]);
					biUnBare = RuProofStep(ids.axmp, [
						RuProofStep(s2id_("uncom"), [], RuStmt(stcl, [eqUnE], -1)),
						RuProofStep(ids.sseq2, [], RuStmt(stcl,
							[ruFwdMkRule(ids.wi, ids.wff, [eqUnE, ruFwdMkRule(ids.wb, ids.wff, [RuExp(nodes, -1), ssCE])])], -1))],
						RuStmt(stcl, [ruFwdMkRule(ids.wb, ids.wff, [RuExp(nodes, -1), ssCE])], -1));
					biUnArg = switch (guard) {
						None(): biUnBare;
						Some(__): RuProofStep(s2id_("a1i"), [biUnBare],
							RuStmt(stcl, [wrap(ruFwdMkRule(ids.wb, ids.wff, [RuExp(nodes, -1), ssCE]))], -1));
					};
					pSsC = RuProofStep(mpbi, [f.first, biUnArg], RuStmt(stcl, [wrap(ssCE)], -1));
					difCE = ruFwdMkRule(ids.cdif, ids.cls, [RuExp(la, -1), RuExp(rc, -1)]);
					ssE2 = ruFwdMkRule(ids.wss, ids.wff, [difCE, RuExp(rb, -1)]);
					pSsU2 = RuProofStep(mpbi, [pSsC,
						lift(s2id_("ssundif"), ruFwdMkRule(ids.wb, ids.wff, [ssCE, ssE2]))],
						RuStmt(stcl, [wrap(ssE2)], -1));
					rec(pSsU2, ssE2.nodes, acU1);
				};
				// (A∪B) ⊆ C decomposes into both factor ⊆-facts (unss, mpbir on the
				// ∧-side) — recursed, so a {x11}-RHS factor cascades on into the
				// sssn case split (t37-class)
				acV = if (lh != ids.cun || length(la) < 3) acU else {
					aend = ruFwdSpan(la, 1);
					ua = subrange(la, 1, aend - 1);
					ub = subrange(la, aend, length(la) - aend);
					andEu = ruFwdMkRule(ids.wa, ids.wff, [
						ruFwdMkRule(ids.wss, ids.wff, [RuExp(ua, -1), RuExp(lb, -1)]),
						ruFwdMkRule(ids.wss, ids.wff, [RuExp(ub, -1), RuExp(lb, -1)])]);
					pAndU = RuProofStep(mpbir, [f.first,
						lift(s2id_("unss"), ruFwdMkRule(ids.wb, ids.wff, [andEu, RuExp(nodes, -1)]))],
						RuStmt(stcl, [wrap(andEu)], -1));
					rec(pAndU, andEu.nodes, acU);
				};
				// A ⊆ {t} splits to the case fact (A=∅) ∨ (A={t}) (sssn) — the
				// singleton-decomposition source (t58/t37-class). SETVAR A only: an
				// enumeration LHS ({b,c}⊆{a}) makes a junk case-split whose ∨-elim
				// cost blew the enumset1 floor (t86_enumset1, 8s→15s)
				ac1 = if (rh != csn || length(lb) < 2 || !(length(la) == 2 && ruFwdIsSetvarNode(la[1], ids.setvar))) acV else {
					orE = ruFwdMkRule(ids.wo, ids.wff, [
						ruFwdMkRule(wceq, ids.wff, [RuExp(la, -1), RuExp(empty, -1)]),
						ruFwdMkRule(wceq, ids.wff, [RuExp(la, -1), RuExp(lb, -1)])]);
					pOrS = RuProofStep(mpbi, [f.first,
						lift(s2id_("sssn"), ruFwdMkRule(ids.wb, ids.wff, [RuExp(nodes, -1), orE]))],
						RuStmt(stcl, [wrap(orE)], -1));
					rec(pOrS, orE.nodes, acV);
				};
				mkElOf = \v : [RuExpNode] -> ruFwdMkRule(ids.wcel, ids.wff, [RuExp(v, -1), RuExp(lb, -1)]);
				if (lh == csn && length(la) == 3) {
					v = subrange(la, 1, 2);
					dE = mkElOf(v);
					pEl = RuProofStep(mpbir, [f.first,
						lift(s2id_("vsnss"), ruFwdMkRule(ids.wb, ids.wff, [dE, RuExp(nodes, -1)]))],
						RuStmt(stcl, [wrap(dE)], -1));
					rec(pEl, dE.nodes, ac1);
				} else if (lh == s2id("cpr") && length(la) == 5) {
					u = subrange(la, 1, 2);
					v = subrange(la, 3, 2);
					andE = ruFwdMkRule(ids.wa, ids.wff, [mkElOf(u), mkElOf(v)]);
					pAnd = RuProofStep(mpbir, [f.first,
						lift(s2id_("vprss"), ruFwdMkRule(ids.wb, ids.wff, [andE, RuExp(nodes, -1)]))],
						RuStmt(stcl, [wrap(andE)], -1));
					rec(pAnd, andE.nodes, ac1);
				} else if (lh == s2id("ctp") && length(la) == 7) {
					u = subrange(la, 1, 2);
					v = subrange(la, 3, 2);
					w = subrange(la, 5, 2);
					andE = ruFwdMkRule(ids.wa, ids.wff, [
						ruFwdMkRule(ids.wa, ids.wff, [mkElOf(u), mkElOf(v)]), mkElOf(w)]);
					pAnd = RuProofStep(mpbir, [f.first,
						lift(s2id_("vtpss"), ruFwdMkRule(ids.wb, ids.wff, [andE, RuExp(nodes, -1)]))],
						RuStmt(stcl, [wrap(andE)], -1));
					rec(pAnd, andE.nodes, ac1);
				} else ac1;
			}
			else if (hid == ids.wb && length(nodes) >= 3) RuFwdClsFacts(ac with bi = arrayPush(ac.bi, f))
			else if (hid == ids.wo && length(nodes) >= 3) RuFwdClsFacts(ac with ors = arrayPush(ac.ors, f))
			else if (hid == ids.wa && length(nodes) >= 3) {
				// derived unfolds can produce ∧ — split and recurse
				lend = ruFwdSpan(nodes, 1);
				l = subrange(nodes, 1, lend - 1);
				r = subrange(nodes, lend, length(nodes) - lend);
				pl = RuProofStep(simpl, [f.first], RuStmt(stcl, [wrap(RuExp(l, -1))], -1));
				pr = RuProofStep(simpr, [f.first], RuStmt(stcl, [wrap(RuExp(r, -1))], -1));
				rec(pr, r, rec(pl, l, ac));
			}
			else if (hid == wpss && length(nodes) >= 3) {
				lend = ruFwdSpan(nodes, 1);
				a = subrange(nodes, 1, lend - 1);
				b = subrange(nodes, lend, length(nodes) - lend);
				ssE = ruFwdMkRule(ids.wss, ids.wff, [RuExp(a, -1), RuExp(b, -1)]);
				eqE = ruFwdMkRule(wceq, ids.wff, [RuExp(a, -1), RuExp(b, -1)]);
				neE = ruFwdMkRule(ids.wn, ids.wff, [eqE]);
				andE = ruFwdMkRule(ids.wa, ids.wff, [ssE, neE]);
				pAnd = fwdBi(f.first, RuExp(nodes, -1), s2id_("dfpss2"), andE);
				pSs = RuProofStep(simpl, [pAnd], RuStmt(stcl, [wrap(ssE)], -1));
				pNe = RuProofStep(simpr, [pAnd], RuStmt(stcl, [wrap(neE)], -1));
				ac1 = RuFwdClsFacts(ac with pss = arrayPush(ac.pss, f));
				ac2 = RuFwdClsFacts(ac1 with ss = arrayPush(ac1.ss, Pair(pSs, ssE.nodes)));
				RuFwdClsFacts(ac2 with neg = arrayPush(ac2.neg, Pair(pNe, eqE.nodes)));
			}
			else if (hid == wceq && length(nodes) >= 3) {
				lend = ruFwdSpan(nodes, 1);
				l = subrange(nodes, 1, lend - 1);
				r = subrange(nodes, lend, length(nodes) - lend);
				// every equality contributes BOTH ⊆-facts (eqimss/eqimss2)
				applyImpF = \pf : RuProofTree, anteE : RuExp, lemId : int, conclE : RuExp -> {
					inst = RuProofStep(lemId, [], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [anteE, conclE])], -1));
					switch (guard) {
						None(): RuProofStep(ids.axmp, [pf, inst], RuStmt(stcl, [conclE], -1));
						Some(__): RuProofStep(s2id_("syl"), [pf, inst], RuStmt(stcl, [wrap(conclE)], -1));
					}
				};
				eqE0 = RuExp(nodes, -1);
				ss1E = ruFwdMkRule(ids.wss, ids.wff, [RuExp(l, -1), RuExp(r, -1)]);
				ss2E = ruFwdMkRule(ids.wss, ids.wff, [RuExp(r, -1), RuExp(l, -1)]);
				// RECURSE the two derived ⊆-facts through the classifier — an
				// enumeration equality ({x}={y,z}) then cascades into member
				// el-facts and on into element equalities (zfmisc_1 t4-class)
				ac1 = rec(applyImpF(f.first, eqE0, s2id_("eqimss2"), ss2E), ss2E.nodes,
					rec(applyImpF(f.first, eqE0, s2id_("eqimss"), ss1E), ss1E.nodes,
						RuFwdClsFacts(ac with eqs = arrayPush(ac.eqs, f))));
				if (r == empty) {
					// T = ∅ → the eq0 pool; a ∖-shaped T also gives A⊆B (ssdif0 backward)
					ac2p = RuFwdClsFacts(ac1 with eq0 = arrayPush(ac1.eq0, Pair(f.first, l)));
					// an ∩-shaped T=∅ also derives the eqs-fact (A∖B)=A (disjdif2)
					// — its eqimss ⊆-halves give the A⊆(A∖B) link the ⊆-closure
					// chains through (t135-class: x16⊆(x16∖{x5}) under x5∉x16)
					lIsIn = length(l) >= 3 && switch (l[0]) {
						RuVar(__,__): false;
						RuRuleNode(idT2i, __): ruIdType2Id(idT2i) == ids.cin;
					};
					// SETVAR A only — an enumeration A ({x1}∩{x12})=∅ makes junk
					// A⊆(A∖B) chain-premises that bloat ssClose (the enumset1 floor)
					lIsInV = lIsIn && ruFwdSpan(l, 1) == 3 && ruFwdIsSetvarNode(l[2], ids.setvar);
					ac2 = if (!lIsInV) ac2p else {
						iend = ruFwdSpan(l, 1);
						ia = subrange(l, 1, iend - 1);
						ib = subrange(l, iend, length(l) - iend);
						difIE = ruFwdMkRule(ids.cdif, ids.cls, [RuExp(ia, -1), RuExp(ib, -1)]);
						eqDE = ruFwdMkRule(wceq, ids.wff, [difIE, RuExp(ia, -1)]);
						pDd = applyImpF(f.first, eqE0, s2id_("disjdif2"), eqDE);
						// pushed DIRECTLY (eqs + the A⊆(A∖B) half via eqimss2) — a
						// full classify recursion here cascades through vsnss/eldif
						// on singleton A and blows the slice (the t19/t22 lesson)
						ssDE = ruFwdMkRule(ids.wss, ids.wff, [RuExp(ia, -1), difIE]);
						pSsD = applyImpF(pDd, eqDE, s2id_("eqimss2"), ssDE);
						ac2a = RuFwdClsFacts(ac2p with eqs = arrayPush(ac2p.eqs, Pair(pDd, eqDE.nodes)));
						RuFwdClsFacts(ac2a with ss = arrayPush(ac2a.ss, Pair(pSsD, ssDE.nodes)));
					};
					lIsDif = length(l) >= 3 && switch (l[0]) {
						RuVar(__,__): false;
						RuRuleNode(idT2, __): ruIdType2Id(idT2) == ids.cdif;
					};
					if (!lIsDif) ac2 else {
						dend = ruFwdSpan(l, 1);
						la = subrange(l, 1, dend - 1);
						lb = subrange(l, dend, length(l) - dend);
						ssE = ruFwdMkRule(ids.wss, ids.wff, [RuExp(la, -1), RuExp(lb, -1)]);
						pSs = RuProofStep(mpbir, [f.first,
							lift(s2id_("ssdif0"), ruFwdMkRule(ids.wb, ids.wff, [ssE, eqE0]))],
							RuStmt(stcl, [wrap(ssE)], -1));
						RuFwdClsFacts(ac2 with ss = arrayPush(ac2.ss, Pair(pSs, ssE.nodes)));
					}
				} else if (l == empty) {
					eqE = ruFwdMkRule(wceq, ids.wff, [RuExp(r, -1), RuExp(empty, -1)]);
					eqcom = switch (guard) { None(): s2id_("eqcomi"); Some(__): s2id_("eqcomd"); };
					pFlip = RuProofStep(eqcom, [f.first], RuStmt(stcl, [wrap(eqE)], -1));
					RuFwdClsFacts(ac1 with eq0 = arrayPush(ac1.eq0, Pair(pFlip, r)));
				} else ac1;
			}
			else if (hid == ids.wcel && length(nodes) >= 3) {
				lend = ruFwdSpan(nodes, 1);
				x = subrange(nodes, 1, lend - 1);
				t = subrange(nodes, lend, length(nodes) - lend);
				curE = RuExp(nodes, -1);
				ac1e = RuFwdClsFacts(ac with el = arrayPush(ac.el, f));
				// a setvar membership v∈B also contributes the singleton ⊆-fact
				// {v}⊆B (vsnss) — pushed DIRECTLY (no recursion: its classification
				// would only re-derive v∈B) so the ⊆-closure can chain through it
				// (t138-class: x13∈x15 → {x13}⊆x15 → (x14∪{x13})⊆x15 by unssi)
				ac1 = if (length(x) != 2 || !ruFwdIsSetvarNode(x[1], ids.setvar)
					|| !(length(t) == 2 && ruFwdIsSetvarNode(t[1], ids.setvar))
					|| exists(ac1e.ss, \g0 -> g0.second == (ruFwdMkRule(ids.wss, ids.wff, [ruFwdMkRule(csn, ids.cls, [RuExp(x, -1)]), RuExp(t, -1)])).nodes)) ac1e else {
					snEx = ruFwdMkRule(csn, ids.cls, [RuExp(x, -1)]);
					ssEx = ruFwdMkRule(ids.wss, ids.wff, [snEx, RuExp(t, -1)]);
					pSnSs = RuProofStep(mpbi, [f.first,
						lift(s2id_("vsnss"), ruFwdMkRule(ids.wb, ids.wff, [ruFwdMkRule(ids.wcel, ids.wff, [RuExp(x, -1), RuExp(t, -1)]), ssEx]))],
						RuStmt(stcl, [wrap(ssEx)], -1));
					RuFwdClsFacts(ac1e with ss = arrayPush(ac1e.ss, Pair(pSnSs, ssEx.nodes)));
				};
				th = switch (t[0]) { RuVar(__,__): -1; RuRuleNode(idT3, __): ruIdType2Id(idT3); };
				if (length(t) < 2) ac1
				else {
					tend = if (length(t) >= 3) ruFwdSpan(t, 1) else 1;
					tb = if (length(t) >= 3) subrange(t, 1, tend - 1) else [];
					tc = if (length(t) >= 3) subrange(t, tend, length(t) - tend) else [];
					mkEl = \cl : [RuExpNode] -> ruFwdMkRule(ids.wcel, ids.wff, [RuExp(x, -1), RuExp(cl, -1)]);
					if (th == ids.cun && tb != []) {
						dE = ruFwdMkRule(ids.wo, ids.wff, [mkEl(tb), mkEl(tc)]);
						rec(fwdBi(f.first, curE, s2id_("elun"), dE), dE.nodes, ac1);
					} else if (th == ids.cin && tb != []) {
						dE = ruFwdMkRule(ids.wa, ids.wff, [mkEl(tb), mkEl(tc)]);
						rec(fwdBi(f.first, curE, s2id_("elin"), dE), dE.nodes, ac1);
					} else if (th == ids.cdif && tb != []) {
						dE = ruFwdMkRule(ids.wa, ids.wff, [mkEl(tb), ruFwdMkRule(ids.wn, ids.wff, [mkEl(tc)])]);
						rec(fwdBi(f.first, curE, s2id_("eldif"), dE), dE.nodes, ac1);
					} else if (th == s2id("csymdif") && tb != []) {
						dE = ruFwdMkRule(ids.wn, ids.wff, [ruFwdMkRule(ids.wb, ids.wff, [mkEl(tb), mkEl(tc)])]);
						rec(fwdBi(f.first, curE, s2id_("elsymdif"), dE), dE.nodes, ac1);
					} else if (th == csn && length(x) == 2 && length(t) >= 2) {
						// x ∈ {A}: velsn needs a SETVAR element (a 2-node coercion slice)
						sy = subrange(t, 1, length(t) - 1);
						dE = ruFwdMkRule(wceq, ids.wff, [RuExp(x, -1), RuExp(sy, -1)]);
						rec(fwdBi(f.first, curE, s2id_("velsn"), dE), dE.nodes, ac1);
					} else if (th == s2id("cpr") && length(x) == 2 && tb != []) {
						// x ∈ {A,B} ↔ (x=A) ∨ (x=B)  (velpr, miz_aux)
						dE = ruFwdMkRule(ids.wo, ids.wff, [
							ruFwdMkRule(wceq, ids.wff, [RuExp(x, -1), RuExp(tb, -1)]),
							ruFwdMkRule(wceq, ids.wff, [RuExp(x, -1), RuExp(tc, -1)])]);
						rec(fwdBi(f.first, curE, s2id_("velpr"), dE), dE.nodes, ac1);
					} else if (th == s2id("cpw") && length(t) >= 2) {
						// x ∈ 𝒫A ↔ x ⊆ A  (velpw; x is a setvar slice, A = t's arg)
						pa = subrange(t, 1, length(t) - 1);
						if (length(x) != 2) ac1 else {
							dE = ruFwdMkRule(ids.wss, ids.wff, [RuExp(x, -1), RuExp(pa, -1)]);
							rec(fwdBi(f.first, curE, s2id_("velpw"), dE), dE.nodes, ac1);
						}
					} else if (th == s2id("cxp") && length(t) >= 3 && (switch (x[0]) {
							RuVar(__,__): false;
							RuRuleNode(idTo, __): ruIdType2Id(idTo) == s2id("cop");
						}) && length(x) >= 3) {
						// 〈a,b〉 ∈ (C ×. D) ↔ (a∈C) ∧ (b∈D)  (opelxp)
						oend = ruFwdSpan(x, 1);
						oa = subrange(x, 1, oend - 1);
						ob = subrange(x, oend, length(x) - oend);
						cend = ruFwdSpan(t, 1);
						tc1 = subrange(t, 1, cend - 1);
						td1 = subrange(t, cend, length(t) - cend);
						andE = ruFwdMkRule(ids.wa, ids.wff, [
							ruFwdMkRule(ids.wcel, ids.wff, [RuExp(oa, -1), RuExp(tc1, -1)]),
							ruFwdMkRule(ids.wcel, ids.wff, [RuExp(ob, -1), RuExp(td1, -1)])]);
						rec(fwdBi(f.first, curE, s2id_("opelxp"), andE), andE.nodes, ac1);
					} else if (th == s2id("ctp") && length(x) == 2 && length(t) >= 4) {
						// x ∈ {A,B,C} ↔ ((x=A) ∨ (x=B)) ∨ (x=C)  (veltp, miz_aux)
						e1 = ruFwdSpan(t, 1);
						e2 = ruFwdSpan(t, e1);
						ta = subrange(t, 1, e1 - 1);
						tb3 = subrange(t, e1, e2 - e1);
						tc3 = subrange(t, e2, length(t) - e2);
						dE = ruFwdMkRule(ids.wo, ids.wff, [
							ruFwdMkRule(ids.wo, ids.wff, [
								ruFwdMkRule(wceq, ids.wff, [RuExp(x, -1), RuExp(ta, -1)]),
								ruFwdMkRule(wceq, ids.wff, [RuExp(x, -1), RuExp(tb3, -1)])]),
							ruFwdMkRule(wceq, ids.wff, [RuExp(x, -1), RuExp(tc3, -1)])]);
						rec(fwdBi(f.first, curE, s2id_("veltp"), dE), dE.nodes, ac1);
					} else if (th == s2id("cop") && length(x) == 2 && tb != [] && length(tb) == 2 && length(tc) == 2) {
						// x ∈ 〈a,b〉 with SETVAR components: Kuratowski-unfold the pair
						// through vdfop (〈a,b〉 = {{a},{a,b}}, 0-hyp aux instance) +
						// eleq2, then recurse — the derived x ∈ {{a},{a,b}} cascades
						// through velpr into the (x={a}) ∨ (x={a,b}) case-split fact
						// (zfmisc_1 t93-class: x26 ∈ x24 = 〈x5,x8〉)
						snE = ruFwdMkRule(csn, ids.cls, [RuExp(tb, -1)]);
						prInE = ruFwdMkRule(s2id("cpr"), ids.cls, [RuExp(tb, -1), RuExp(tc, -1)]);
						prE = ruFwdMkRule(s2id("cpr"), ids.cls, [snE, prInE]);
						eqE = ruFwdMkRule(wceq, ids.wff, [RuExp(t, -1), prE]);
						dE = mkEl(prE.nodes);
						biE = ruFwdMkRule(ids.wb, ids.wff, [curE, dE]);
						pEq = RuProofStep(s2id_("vdfop"), [], RuStmt(stcl, [eqE], -1));
						pBi = RuProofStep(ids.axmp, [pEq,
							RuProofStep(s2id_("eleq2"), [], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [eqE, biE])], -1))],
							RuStmt(stcl, [biE], -1));
						biArg = switch (guard) {
							None(): pBi;
							Some(__): RuProofStep(s2id_("a1i"), [pBi], RuStmt(stcl, [wrap(biE)], -1));
						};
						rec(RuProofStep(mpbi, [f.first, biArg], RuStmt(stcl, [wrap(dE)], -1)), dE.nodes, ac1);
					} else ac1;
				}
			}
			else if (hid == ids.wn && length(nodes) >= 2) {
				xn = subrange(nodes, 1, length(nodes) - 1);
				xOk = switch (xn[0]) {
					RuVar(__,__): false;
					RuRuleNode(idT4, __): {
						xh = ruIdType2Id(idT4);
						xh == ids.wss || xh == wceq || xh == wpss || xh == ids.wa || xh == ids.wo || xh == ids.wcel || xh == ids.wb;
					}
				};
				ac0n = if (xOk) RuFwdClsFacts(ac with neg = arrayPush(ac.neg, Pair(f.first, xn))) else ac;
				// ¬(x∈T) derives the singleton disjointness (T∩{x})=∅ (disjsn) —
				// recursed into the eq0 pool, whence mkRules turns it into the
				// T∖{x}→T / {x}∖T→{x} companion rewrite rules (t117/t121/t135-class:
				// the ∉-premise ∖-algebra)
				isCel0 = length(xn) >= 3 && switch (xn[0]) {
					RuVar(__,__): false;
					RuRuleNode(idT5b, __): ruIdType2Id(idT5b) == ids.wcel;
				};
				ac0 = if (!isCel0) ac0n else {
					lend0d = ruFwdSpan(xn, 1);
					xd = subrange(xn, 1, lend0d - 1);
					td = subrange(xn, lend0d, length(xn) - lend0d);
					snEd = ruFwdMkRule(csn, ids.cls, [RuExp(xd, -1)]);
					inEd = ruFwdMkRule(ids.cin, ids.cls, [RuExp(td, -1), snEd]);
					eq0Ed = ruFwdMkRule(wceq, ids.wff, [inEd, RuExp(empty, -1)]);
					pD = RuProofStep(mpbir, [f.first,
						lift(s2id_("disjsn"), ruFwdMkRule(ids.wb, ids.wff, [eq0Ed, RuExp(nodes, -1)]))],
						RuStmt(stcl, [wrap(eq0Ed)], -1));
					rec(pD, eq0Ed.nodes, ac0n);
				};
				// ¬¬a strips to a (notnotri/notnotrd), recursed — the ∨-elim
				// branch guards of a disguised-∨ (ianor below) arrive as double
				// negations
				isNn2 = length(xn) >= 2 && switch (xn[0]) {
					RuVar(__,__): false;
					RuRuleNode(idTn2, __): ruIdType2Id(idTn2) == ids.wn;
				};
				ac0nn = if (!isNn2) ac0 else {
					inner2 = subrange(xn, 1, length(xn) - 1);
					nnr2 = switch (guard) { None(): s2id_("notnotri"); Some(__): s2id_("notnotrd"); };
					pInner2 = RuProofStep(nnr2, [f.first], RuStmt(stcl, [wrap(RuExp(inner2, -1))], -1));
					rec(pInner2, inner2, ac0);
				};
				// ¬(Y∧Z) with a ¬-headed conjunct is a DISGUISED ∨ — ianor
				// unfolds it to (¬Y ∨ ¬Z), an ors case-split source (t118-class:
				// the translator's n-way ∨ arrives as ¬(¬a ∧ (¬b ∧ …))). A
				// positive-conjunct ¬∧ stays in the neg pool alone (a blanket
				// unfold would re-blow the t37-class clause budgets)
				isAnd2 = length(xn) >= 3 && switch (xn[0]) {
					RuVar(__,__): false;
					RuRuleNode(idTa2, __): ruIdType2Id(idTa2) == ids.wa;
				};
				ac0i = if (!isAnd2) ac0nn else {
					yend2 = ruFwdSpan(xn, 1);
					y2 = subrange(xn, 1, yend2 - 1);
					z2 = subrange(xn, yend2, length(xn) - yend2);
					isNegH = \e2 : [RuExpNode] -> switch (e2[0]) {
						RuVar(__,__): false;
						RuRuleNode(idTh2, __): ruIdType2Id(idTh2) == ids.wn;
					};
					if (!isNegH(y2) && !isNegH(z2)) ac0nn else {
						orE2 = ruFwdMkRule(ids.wo, ids.wff, [
							ruFwdMkRule(ids.wn, ids.wff, [RuExp(y2, -1)]),
							ruFwdMkRule(ids.wn, ids.wff, [RuExp(z2, -1)])]);
						pOr2 = RuProofStep(mpbi, [f.first,
							lift(s2id_("ianor"), ruFwdMkRule(ids.wb, ids.wff, [RuExp(nodes, -1), orE2]))],
							RuStmt(stcl, [wrap(orE2)], -1));
						rec(pOr2, orE2.nodes, ac0nn);
					}
				};
				// a ≠ of two setvars derives the singleton disjointness
				// ({a}∩{b})=∅ (df-ne backward + disjsn2) — recursed into the eq0
				// pool, whence mkRules turns it into ground rewrite rules
				// (zfmisc t11/t14/t17/t23-class)
				isVeq = length(xn) == 5 && (switch (xn[0]) {
					RuVar(__,__): false;
					RuRuleNode(idTq, __): ruIdType2Id(idTq) == wceq;
				}) && length(subrange(xn, 1, ruFwdSpan(xn, 1) - 1)) == 2;
				ac1 = if (!isVeq) ac0i else {
					va = subrange(xn, 1, 2);
					vb = subrange(xn, 3, 2);
					neE = ruFwdMkRule(s2id("wne"), ids.wff, [RuExp(va, -1), RuExp(vb, -1)]);
					pNe = RuProofStep(mpbir, [f.first,
						lift(s2id_("df-ne"), ruFwdMkRule(ids.wb, ids.wff, [neE, RuExp(nodes, -1)]))],
						RuStmt(stcl, [wrap(neE)], -1));
					snab = ruFwdMkRule(ids.cin, ids.cls, [
						ruFwdMkRule(s2id("csn"), ids.cls, [RuExp(va, -1)]),
						ruFwdMkRule(s2id("csn"), ids.cls, [RuExp(vb, -1)])]);
					eq0E = ruFwdMkRule(wceq, ids.wff, [snab, RuExp(empty, -1)]);
					inst = RuProofStep(s2id_("disjsn2"), [],
						RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [neE, eq0E])], -1));
					pDisj = switch (guard) {
						None(): RuProofStep(ids.axmp, [pNe, inst], RuStmt(stcl, [eq0E], -1));
						Some(__): RuProofStep(s2id_("syl"), [pNe, inst], RuStmt(stcl, [wrap(eq0E)], -1));
					};
					rec(pDisj, eq0E.nodes, ac0i);
				};
				// negated-membership unfolds
				isCel = length(xn) >= 3 && switch (xn[0]) {
					RuVar(__,__): false;
					RuRuleNode(idT5, __): ruIdType2Id(idT5) == ids.wcel;
				};
				if (!isCel) ac1 else {
					lend = ruFwdSpan(xn, 1);
					x = subrange(xn, 1, lend - 1);
					t = subrange(xn, lend, length(xn) - lend);
					curE = RuExp(xn, -1);
					th = switch (t[0]) { RuVar(__,__): -1; RuRuleNode(idT6, __): ruIdType2Id(idT6); };
					tend = if (length(t) >= 3) ruFwdSpan(t, 1) else 1;
					tb = if (length(t) >= 3) subrange(t, 1, tend - 1) else [];
					tc = if (length(t) >= 3) subrange(t, tend, length(t) - tend) else [];
					mkEl = \cl : [RuExpNode] -> ruFwdMkRule(ids.wcel, ids.wff, [RuExp(x, -1), RuExp(cl, -1)]);
					if (th == ids.cun && tb != []) {
						// ¬(x∈(B∪C)) → ¬(el∨el) (mtbi+elun) → ¬el ∧ ¬el (ioran), recursed
						orE = ruFwdMkRule(ids.wo, ids.wff, [mkEl(tb), mkEl(tc)]);
						pNo = RuProofStep(mtbi, [f.first,
							lift(s2id_("elun"), ruFwdMkRule(ids.wb, ids.wff, [curE, orE]))],
							RuStmt(stcl, [wrap(ruFwdMkRule(ids.wn, ids.wff, [orE]))], -1));
						andE = ruFwdMkRule(ids.wa, ids.wff, [
							ruFwdMkRule(ids.wn, ids.wff, [mkEl(tb)]),
							ruFwdMkRule(ids.wn, ids.wff, [mkEl(tc)])]);
						pAnd = RuProofStep(mpbi, [pNo,
							lift(s2id_("ioran"), ruFwdMkRule(ids.wb, ids.wff, [ruFwdMkRule(ids.wn, ids.wff, [orE]), andE]))],
							RuStmt(stcl, [wrap(andE)], -1));
						rec(pAnd, andE.nodes, ac1);
					} else if (th == s2id("csymdif") && tb != []) {
						// ¬(x∈(B△C)) → ¬¬(el↔el) → the ↔-fact
						biE = ruFwdMkRule(ids.wb, ids.wff, [mkEl(tb), mkEl(tc)]);
						nbiE = ruFwdMkRule(ids.wn, ids.wff, [biE]);
						pNo = RuProofStep(mtbi, [f.first,
							lift(s2id_("elsymdif"), ruFwdMkRule(ids.wb, ids.wff, [curE, nbiE]))],
							RuStmt(stcl, [wrap(ruFwdMkRule(ids.wn, ids.wff, [nbiE]))], -1));
						nnr = switch (guard) { None(): s2id_("notnotri"); Some(__): s2id_("notnotrd"); };
						pBi = RuProofStep(nnr, [pNo], RuStmt(stcl, [wrap(biE)], -1));
						rec(pBi, biE.nodes, ac1);
					} else if (th == csn && length(x) == 2) {
						// ¬(x∈{A}) → ¬(x=A)
						sy = subrange(t, 1, length(t) - 1);
						eqE = ruFwdMkRule(wceq, ids.wff, [RuExp(x, -1), RuExp(sy, -1)]);
						pNo = RuProofStep(mtbi, [f.first,
							lift(s2id_("velsn"), ruFwdMkRule(ids.wb, ids.wff, [curE, eqE]))],
							RuStmt(stcl, [wrap(ruFwdMkRule(ids.wn, ids.wff, [eqE]))], -1));
						rec(pNo, (ruFwdMkRule(ids.wn, ids.wff, [eqE])).nodes, ac1);
					} else if (th == s2id("cpr") && length(x) == 2 && tb != []) {
						// ¬(x∈{A,B}) → ¬(x=A) ∧ ¬(x=B) (mtbi+velpr, then ioran)
						orE = ruFwdMkRule(ids.wo, ids.wff, [
							ruFwdMkRule(wceq, ids.wff, [RuExp(x, -1), RuExp(tb, -1)]),
							ruFwdMkRule(wceq, ids.wff, [RuExp(x, -1), RuExp(tc, -1)])]);
						pNo = RuProofStep(mtbi, [f.first,
							lift(s2id_("velpr"), ruFwdMkRule(ids.wb, ids.wff, [curE, orE]))],
							RuStmt(stcl, [wrap(ruFwdMkRule(ids.wn, ids.wff, [orE]))], -1));
						andE = ruFwdMkRule(ids.wa, ids.wff, [
							ruFwdMkRule(ids.wn, ids.wff, [ruFwdMkRule(wceq, ids.wff, [RuExp(x, -1), RuExp(tb, -1)])]),
							ruFwdMkRule(ids.wn, ids.wff, [ruFwdMkRule(wceq, ids.wff, [RuExp(x, -1), RuExp(tc, -1)])])]);
						pAnd = RuProofStep(mpbi, [pNo,
							lift(s2id_("ioran"), ruFwdMkRule(ids.wb, ids.wff, [ruFwdMkRule(ids.wn, ids.wff, [orE]), andE]))],
							RuStmt(stcl, [wrap(andE)], -1));
						rec(pAnd, andE.nodes, ac1);
					} else ac1;
				}
			}
			else if (hid == ids.wal && length(nodes) > 2 && ruFwdIsSetvarNode(nodes[1], ids.setvar)) {
				// ∀v body — fold (v∈A → v∈B) to A⊆B (df-ss) and (v∈A ↔ v∈B) to A=B (dfcleq)
				v = nodes[1];
				body = subrange(nodes, 2, length(nodes) - 2);
				bh = switch (body[0]) { RuVar(__,__): -1; RuRuleNode(idT7, __): ruIdType2Id(idT7); };
				if ((bh != ids.wi && bh != ids.wb) || length(body) < 3) ac
				else {
					bend = ruFwdSpan(body, 1);
					bl = subrange(body, 1, bend - 1);
					br = subrange(body, bend, length(body) - bend);
					isElOf = \e : [RuExpNode] -> length(e) >= 4 && (switch (e[0]) {
						RuVar(__,__): false;
						RuRuleNode(idT8, __): ruIdType2Id(idT8) == ids.wcel;
					}) && length(subrange(e, 1, ruFwdSpan(e, 1) - 1)) == 2 && e[2] == v;
					if (!isElOf(bl) || !isElOf(br)) ac
					else {
						aCl = subrange(bl, 3, length(bl) - 3);
						bCl = subrange(br, 3, length(br) - 3);
						if (ruFwdContainsNode(aCl, v) || ruFwdContainsNode(bCl, v)) ac
						else if (bh == ids.wi) {
							ssE = ruFwdMkRule(ids.wss, ids.wff, [RuExp(aCl, -1), RuExp(bCl, -1)]);
							pSs = RuProofStep(mpbir, [f.first,
								lift(s2id_("df-ss"), ruFwdMkRule(ids.wb, ids.wff, [ssE, RuExp(nodes, -1)]))],
								RuStmt(stcl, [wrap(ssE)], -1));
							rec(pSs, ssE.nodes, ac);
						} else {
							eqE = ruFwdMkRule(wceq, ids.wff, [RuExp(aCl, -1), RuExp(bCl, -1)]);
							pEq = RuProofStep(mpbir, [f.first,
								lift(s2id_("dfcleq"), ruFwdMkRule(ids.wb, ids.wff, [eqE, RuExp(nodes, -1)]))],
								RuStmt(stcl, [wrap(eqE)], -1));
							rec(pEq, eqE.nodes, ac);
						}
					}
				}
			}
			else if (hid == ids.wex && length(nodes) > 2 && ruFwdIsSetvarNode(nodes[1], ids.setvar)) {
				// ∃v (v∈T) → a pooled ¬(T=∅) fact (neq0)
				v = nodes[1];
				body = subrange(nodes, 2, length(nodes) - 2);
				isCel = length(body) >= 4 && switch (body[0]) {
					RuVar(__,__): false;
					RuRuleNode(idT9, __): ruIdType2Id(idT9) == ids.wcel;
				};
				if (!isCel || body[2] != v) ac
				else {
					t = subrange(body, 3, length(body) - 3);
					if (ruFwdContainsNode(t, v)) ac
					else {
						eqE = ruFwdMkRule(wceq, ids.wff, [RuExp(t, -1), RuExp(empty, -1)]);
						neE = ruFwdMkRule(ids.wn, ids.wff, [eqE]);
						pNe = RuProofStep(mpbir, [f.first,
							lift(s2id_("neq0"), ruFwdMkRule(ids.wb, ids.wff, [neE, RuExp(nodes, -1)]))],
							RuStmt(stcl, [wrap(neE)], -1));
						RuFwdClsFacts(ac with neg = arrayPush(ac.neg, Pair(pNe, eqE.nodes)));
					}
				}
			}
			else ac;
		}
	}
}

// THE ⊆-CLOSURE (the ssdif0-residue discharge, t97/t110/t117-class): decide
// a ⊆ b by a small syllogism closure — reflexivity, the ∧-flattened ⊆-premises,
// structural shrink on the left (inss1/inss2/difss + sstri), ∪-split on the
// left (unssi), structural growth on the right (ssun1/ssun2 + sstri), and
// transitive chaining THROUGH a premise. The premise channel is the only
// cyclic one — depth-bounded; the structural channels strictly shrink a term.
// DEDUCTION MODE (guard = Some(ψ)): every produced proof proves ψ→X instead
// of X — 0-hyp instances a1i-lift, combiners switch to their d-forms
// (sstri→sstrd, unssi→unssd), and ssPrems must already prove ψ→(A⊆B).
// This is how a Mizar clause ¬(P∧(…∧¬G)) uses its OWN conjuncts as premises.
ruFwdSsClose(ids : RuFwdInstIds, facts : RuFwdClsFacts, a : [RuExpNode], b : [RuExpNode], stcl : int, depth : int, guard : Maybe<RuExp>, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	ruFwdSsCloseP(ids, facts, a, b, stcl, depth, guard, [], prover_env);
}

// The path-carrying body: the VISITED-PATH guard prunes revisits of the same
// (a, b) subgoal along one branch — without it the premise/structural channel
// product ping-pongs (a ⊆ (a∖c) ⟸ shrink ⟸ a ⊆ (a∖c) …) and one ⊆-goal
// burns 10^7 calls once the pools carry the ∖-algebra facts (the t19 lesson;
// same cure as litClose's cycle guard).
ruFwdSsCloseP(ids : RuFwdInstIds, facts : RuFwdClsFacts, a : [RuExpNode], b : [RuExpNode], stcl : int, depth : int, guard : Maybe<RuExp>, path0 : [Pair<[RuExpNode], [RuExpNode]>], prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	if (ruTimeIsOver(prover_env.conf.timer) || contains(path0, Pair(a, b))) None() else {
	path = arrayPush(path0, Pair(a, b));
	ssPrems = facts.ss;
	if (prover_env.env.conf.verbose >= 6) {
		prover_env.env.out.println("    ssClose d=" + i2s(depth) + ": "
			+ ruSafeExp2s(RuExp(a, -1), prover_env.math.decls.lang) + "  ⊆?  "
			+ ruSafeExp2s(RuExp(b, -1), prover_env.math.decls.lang));
	} else {};
	sstri = switch (guard) { None(): s2id_("sstri"); Some(__): s2id_("sstrd"); };
	unssi = switch (guard) { None(): s2id_("unssi"); Some(__): s2id_("unssd"); };
	wss = \x, y -> ruFwdMkRule(ids.wss, ids.wff, [RuExp(x, -1), RuExp(y, -1)]);
	wrap = \e : RuExp -> switch (guard) { None(): e; Some(g): ruFwdMkRule(ids.wi, ids.wff, [g, e]); };
	// a 0-hyp instance ⊢X enters the current mode (a1i-lifted under a guard)
	lift = \asId : int, e : RuExp -> {
		bare = RuProofStep(asId, [], RuStmt(stcl, [e], -1));
		switch (guard) {
			None(): bare;
			Some(__): RuProofStep(s2id_("a1i"), [bare], RuStmt(stcl, [wrap(e)], -1));
		}
	};
	goalE = wss(a, b);
	aIsEmpty = length(a) == 1 && switch (a[0]) {
		RuVar(__,__): false;
		RuRuleNode(idT0, __): ruIdType2Id(idT0) == s2id("c0");
	};
	if (a == b) Some(lift(s2id_("ssid"), goalE))
	else if (aIsEmpty) Some(lift(s2id_("0ss"), goalE)) else {
	direct = fold(ssPrems, None(), \ac, pr -> switch (ac) {
		Some(__): ac;
		None(): {
			pe = pr.second;
			pend = ruFwdSpan(pe, 1);
			if (subrange(pe, 1, pend - 1) == a && subrange(pe, pend, length(pe) - pend) == b)
				Some(pr.first) else None();
		}
	});
	switch (direct) { Some(__): direct; None(): {
	// a ⊆ mid (one structural step) then mid ⊆ b recursively
	viaLeft = \mid : [RuExpNode], pLeft : RuProofTree ->
		maybeMap(ruFwdSsCloseP(ids, facts, mid, b, stcl, depth, guard, path, prover_env),
			\pm -> RuProofStep(sstri, [pLeft, pm], RuStmt(stcl, [wrap(goalE)], -1)));
	structL = switch (a[0]) {
		RuVar(__,__): None();
		RuRuleNode(idT, __): {
			hid = ruIdType2Id(idT);
			if (length(a) < 3) None()
			else {
				lend = ruFwdSpan(a, 1);
				c = subrange(a, 1, lend - 1);
				d = subrange(a, lend, length(a) - lend);
				if (hid == ids.cin) {
					p1 = viaLeft(c, lift(s2id_("inss1"), wss(a, c)));
					switch (p1) { Some(__): p1; None():
						viaLeft(d, lift(s2id_("inss2"), wss(a, d))); }
				} else if (hid == ids.cdif) {
					p1 = viaLeft(c, lift(s2id_("difss"), wss(a, c)));
					switch (p1) { Some(__): p1; None(): {
						// ∖-TRANSPOSITION (difcom: ((C∖D)⊆b) ↔ ((C∖b)⊆D)): the
						// normal form AC-orders subtrahends, so the premise
						// difference may sit transposed ((x5∖x9)∖x7 under
						// (x5∖x7)⊆x9 — t97). Swapping can ping-pong — depth-bounded.
						if (depth <= 0) None() else {
							swapped = (ruFwdMkRule(ids.cdif, ids.cls, [RuExp(c, -1), RuExp(b, -1)])).nodes;
							maybeMap(ruFwdSsCloseP(ids, facts, swapped, d, stcl, depth - 1, guard, path, prover_env), \psw -> {
								bi = ruFwdMkRule(ids.wb, ids.wff, [wss(swapped, d), goalE]);
								mpbi = switch (guard) { None(): s2id_("mpbi"); Some(__): s2id_("mpbid"); };
								RuProofStep(mpbi, [psw, lift(s2id_("difcom"), bi)], RuStmt(stcl, [wrap(goalE)], -1));
							});
						}
					}}
				} else if (hid == ids.cun) {
					maybeBind(ruFwdSsCloseP(ids, facts, c, b, stcl, depth, guard, path, prover_env), \pc ->
						maybeMap(ruFwdSsCloseP(ids, facts, d, b, stcl, depth, guard, path, prover_env), \pd ->
							RuProofStep(unssi, [pc, pd], RuStmt(stcl, [wrap(goalE)], -1))));
				} else if (hid == s2id("csymdif")) {
					// △-LEFT: unfold a = C△D to (C∪D)∖(C∩D) (dfsymdif3), recurse,
					// transport back through sseq1 (t107-class)
					if (depth <= 0) None() else {
						a2 = (ruFwdMkRule(ids.cdif, ids.cls, [
							ruFwdMkRule(ids.cun, ids.cls, [RuExp(c, -1), RuExp(d, -1)]),
							ruFwdMkRule(ids.cin, ids.cls, [RuExp(c, -1), RuExp(d, -1)])])).nodes;
						maybeMap(ruFwdSsCloseP(ids, facts, a2, b, stcl, depth - 1, guard, path, prover_env), \pr2 -> {
							eqA = ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(a, -1), RuExp(a2, -1)]);
							pEq = RuProofStep(s2id_("dfsymdif3"), [], RuStmt(stcl, [eqA], -1));
							biE = ruFwdMkRule(ids.wb, ids.wff, [goalE, wss(a2, b)]);
							pBi = RuProofStep(ids.axmp, [pEq,
								RuProofStep(ids.sseq1, [], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [eqA, biE])], -1))],
								RuStmt(stcl, [biE], -1));
							switch (guard) {
								None(): RuProofStep(s2id_("mpbir"), [pr2, pBi], RuStmt(stcl, [goalE], -1));
								Some(__): RuProofStep(s2id_("mpbird"), [pr2,
									RuProofStep(s2id_("a1i"), [pBi], RuStmt(stcl, [wrap(biE)], -1))],
									RuStmt(stcl, [wrap(goalE)], -1));
							}
						});
					}
				} else None();
			}
		}
	};
	switch (structL) { Some(__): structL; None(): {
	structR = switch (b[0]) {
		RuVar(__,__): None();
		RuRuleNode(idT2, __): {
			bh = ruIdType2Id(idT2);
			if (length(b) < 3) None()
			else if (bh == ids.cun) {
				lend2 = ruFwdSpan(b, 1);
				c2 = subrange(b, 1, lend2 - 1);
				d2 = subrange(b, lend2, length(b) - lend2);
				p1 = maybeMap(ruFwdSsCloseP(ids, facts, a, c2, stcl, depth, guard, path, prover_env), \pac ->
					RuProofStep(sstri, [pac, lift(s2id_("ssun1"), wss(c2, b))], RuStmt(stcl, [wrap(goalE)], -1)));
				switch (p1) { Some(__): p1; None():
					maybeMap(ruFwdSsCloseP(ids, facts, a, d2, stcl, depth, guard, path, prover_env), \pad ->
						RuProofStep(sstri, [pad, lift(s2id_("ssun2"), wss(d2, b))], RuStmt(stcl, [wrap(goalE)], -1))); }
			} else if (bh == ids.cin) {
				// a ⊆ C∩D from BOTH legs (ssin: ((a⊆C)∧(a⊆D)) ↔ (a⊆(C∩D)))
				lend2 = ruFwdSpan(b, 1);
				c2 = subrange(b, 1, lend2 - 1);
				d2 = subrange(b, lend2, length(b) - lend2);
				maybeBind(ruFwdSsCloseP(ids, facts, a, c2, stcl, depth, guard, path, prover_env), \pc ->
					maybeMap(ruFwdSsCloseP(ids, facts, a, d2, stcl, depth, guard, path, prover_env), \pd -> {
						andE = ruFwdMkRule(ids.wa, ids.wff, [wss(a, c2), wss(a, d2)]);
						bi = ruFwdMkRule(ids.wb, ids.wff, [andE, goalE]);
						pairId = switch (guard) { None(): s2id_("pm3.2i"); Some(__): s2id_("jca"); };
						mpbi = switch (guard) { None(): s2id_("mpbi"); Some(__): s2id_("mpbid"); };
						pAnd = RuProofStep(pairId, [pc, pd], RuStmt(stcl, [wrap(andE)], -1));
						RuProofStep(mpbi, [pAnd, lift(s2id_("ssin"), bi)], RuStmt(stcl, [wrap(goalE)], -1));
					}));
			} else if (bh == ids.cdif) {
				// a ⊆ C∖D from a⊆C and a pooled (a∩D)=∅ fact (reldisj:
				// (A⊆C) → (((A∩B)=∅) ↔ (A⊆(C∖B)))) — the disjointness leg
				lend2 = ruFwdSpan(b, 1);
				c2 = subrange(b, 1, lend2 - 1);
				d2 = subrange(b, lend2, length(b) - lend2);
				inAD = (ruFwdMkRule(ids.cin, ids.cls, [RuExp(a, -1), RuExp(d2, -1)])).nodes;
				mE0 = fold(facts.eq0, None(), \acE, f -> switch (acE) {
					Some(__): acE;
					None(): if (f.second == inAD) Some(f.first) else None();
				});
				maybeBind(mE0, \p0 ->
					maybeMap(ruFwdSsCloseP(ids, facts, a, c2, stcl, depth, guard, path, prover_env), \p1 -> {
						emptyE = RuExp([ruMakeRuleNode(s2id("c0"), ids.cls, 0, 0)], -1);
						eq0E = ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(inAD, -1), emptyE]);
						biE = ruFwdMkRule(ids.wb, ids.wff, [eq0E, goalE]);
						inst = RuProofStep(s2id_("reldisj"), [],
							RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [wss(a, c2), biE])], -1));
						switch (guard) {
							None(): {
								pBi = RuProofStep(ids.axmp, [p1, inst], RuStmt(stcl, [biE], -1));
								RuProofStep(s2id_("mpbi"), [p0, pBi], RuStmt(stcl, [goalE], -1));
							}
							Some(__): {
								pBi = RuProofStep(s2id_("syl"), [p1, inst], RuStmt(stcl, [wrap(biE)], -1));
								RuProofStep(s2id_("mpbid"), [p0, pBi], RuStmt(stcl, [wrap(goalE)], -1));
							}
						}
					}));
			} else if (bh == s2id("csymdif")) {
				// △-RIGHT: unfold b = C△D to (C∪D)∖(C∩D), recurse (the reldisj
				// channel then consumes the ∖), transport through sseq2
				if (depth <= 0) None() else {
					lend2 = ruFwdSpan(b, 1);
					c2 = subrange(b, 1, lend2 - 1);
					d2 = subrange(b, lend2, length(b) - lend2);
					b2 = (ruFwdMkRule(ids.cdif, ids.cls, [
						ruFwdMkRule(ids.cun, ids.cls, [RuExp(c2, -1), RuExp(d2, -1)]),
						ruFwdMkRule(ids.cin, ids.cls, [RuExp(c2, -1), RuExp(d2, -1)])])).nodes;
					maybeMap(ruFwdSsCloseP(ids, facts, a, b2, stcl, depth - 1, guard, path, prover_env), \pr2 -> {
						eqB = ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(b, -1), RuExp(b2, -1)]);
						pEq = RuProofStep(s2id_("dfsymdif3"), [], RuStmt(stcl, [eqB], -1));
						biE = ruFwdMkRule(ids.wb, ids.wff, [goalE, wss(a, b2)]);
						pBi = RuProofStep(ids.axmp, [pEq,
							RuProofStep(ids.sseq2, [], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [eqB, biE])], -1))],
							RuStmt(stcl, [biE], -1));
						switch (guard) {
							None(): RuProofStep(s2id_("mpbir"), [pr2, pBi], RuStmt(stcl, [goalE], -1));
							Some(__): RuProofStep(s2id_("mpbird"), [pr2,
								RuProofStep(s2id_("a1i"), [pBi], RuStmt(stcl, [wrap(biE)], -1))],
								RuStmt(stcl, [wrap(goalE)], -1));
						}
					});
				}
			} else None();
		}
	};
	switch (structR) { Some(__): structR; None(): {
	// STRUCTURAL MONOTONICITY over same-headed compounds (the cxp/𝒫/⋃ family,
	// t95/t96/t119 · t67/t69 · t77): (A×C)⊆(B×D) from A⊆B ∧ C⊆D (xpss12),
	// 𝒫A⊆𝒫B from A⊆B (sspw), ⋃A⊆⋃B from A⊆B (uniss) — 0-hyp implication
	// forms: bare = ax-mp, guarded = syl. Plus pwuni (a ⊆ 𝒫⋃a, the t82 axis)
	// as a direct instance. Strictly shrinking (recursion on proper subterms).
	mono = {
		ha = switch (a[0]) { RuVar(__,__): -1; RuRuleNode(idTa, __): ruIdType2Id(idTa); };
		hb = switch (b[0]) { RuVar(__,__): -1; RuRuleNode(idTb, __): ruIdType2Id(idTb); };
		mkMp = \pHyp : RuProofTree, hypE : RuExp, instId : int -> {
			inst = RuProofStep(instId, [], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [hypE, goalE])], -1));
			switch (guard) {
				None():   RuProofStep(ids.axmp, [pHyp, inst], RuStmt(stcl, [goalE], -1));
				Some(__): RuProofStep(s2id_("syl"), [pHyp, inst], RuStmt(stcl, [wrap(goalE)], -1));
			}
		};
		pwuniB = if (length(b) != length(a) + 2 || hb != s2id("cpw")) false
			else {
				u = subrange(b, 1, length(b) - 1);
				switch (u[0]) { RuVar(__,__): false; RuRuleNode(idTu, __):
					ruIdType2Id(idTu) == s2id("cuni") && subrange(u, 1, length(u) - 1) == a; };
			};
		if (pwuniB) Some(lift(s2id_("pwuni"), goalE))
		else if (ha < 0 || ha != hb) None()
		else if (ha == s2id("cxp") && length(a) >= 3 && length(b) >= 3) {
			aend = ruFwdSpan(a, 1);
			aa = subrange(a, 1, aend - 1);
			ac2 = subrange(a, aend, length(a) - aend);
			bend = ruFwdSpan(b, 1);
			ba = subrange(b, 1, bend - 1);
			bd = subrange(b, bend, length(b) - bend);
			maybeBind(ruFwdSsCloseP(ids, facts, aa, ba, stcl, depth, guard, path, prover_env), \p1 ->
				maybeMap(ruFwdSsCloseP(ids, facts, ac2, bd, stcl, depth, guard, path, prover_env), \p2 -> {
					andE = ruFwdMkRule(ids.wa, ids.wff, [wss(aa, ba), wss(ac2, bd)]);
					pairId = switch (guard) { None(): s2id_("pm3.2i"); Some(__): s2id_("jca"); };
					pAnd = RuProofStep(pairId, [p1, p2], RuStmt(stcl, [wrap(andE)], -1));
					mkMp(pAnd, andE, s2id_("xpss12"));
				}));
		} else if ((ha == s2id("cpw") || ha == s2id("cuni")) && length(a) >= 2 && length(b) >= 2) {
			aArg = subrange(a, 1, length(a) - 1);
			bArg = subrange(b, 1, length(b) - 1);
			maybeMap(ruFwdSsCloseP(ids, facts, aArg, bArg, stcl, depth, guard, path, prover_env), \p1 ->
				mkMp(p1, wss(aArg, bArg), if (ha == s2id("cpw")) s2id_("sspw") else s2id_("uniss")));
		} else None();
	};
	switch (mono) { Some(__): mono; None(): {
	if (depth <= 0) None() else
	fold(ssPrems, None(), \ac, pr -> switch (ac) {
		Some(__): ac;
		None(): {
			pe = pr.second;
			pend = ruFwdSpan(pe, 1);
			pa = subrange(pe, 1, pend - 1);
			pb = subrange(pe, pend, length(pe) - pend);
			if (pa == a) maybeMap(ruFwdSsCloseP(ids, facts, pb, b, stcl, depth - 1, guard, path, prover_env),
				\pm -> RuProofStep(sstri, [pr.first, pm], RuStmt(stcl, [wrap(goalE)], -1)))
			// VIA-FACT: a ⊆ pa (structurally) ∘ the fact ∘ pb ⊆ b — chains a
			// constructed middle through a pooled ⊆-fact ({y} ⊆ ({x}∪{y}) ⊆ {x},
			// t8_zfmisc_1-class). HEAVILY depth-damped (-4): each level branches
			// over the whole pool × two recursive legs — undamped it explodes
			// exponentially and burns the stage budget inside the closure.
			else if (depth < 4) None()
			else maybeBind(ruFwdSsCloseP(ids, facts, a, pa, stcl, depth - 4, guard, path, prover_env), \pIn -> {
				pMid = RuProofStep(sstri, [pIn, pr.first],
					RuStmt(stcl, [wrap(wss(a, pb))], -1));
				if (pb == b) Some(pMid)
				else maybeMap(ruFwdSsCloseP(ids, facts, pb, b, stcl, depth - 4, guard, path, prover_env),
					\pOut -> RuProofStep(sstri, [pMid, pOut], RuStmt(stcl, [wrap(goalE)], -1)));
			});
		}
	});
	}}}}}}}}}
	}
}

// A = B by ANTISYMMETRY of two ⊆-closures (eqssi/eqssd) — the equality channel
// of the clash driver (t57: x5=x7 from the two ⊊-unfold ⊆-facts; t62: x5=∅
// from x5⊆∅ + 0ss).
ruFwdEqClose(ids : RuFwdInstIds, facts : RuFwdClsFacts, x : [RuExpNode], y : [RuExpNode], stcl : int, guard : Maybe<RuExp>, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	wrap = \e : RuExp -> switch (guard) { None(): e; Some(g): ruFwdMkRule(ids.wi, ids.wff, [g, e]); };
	eqss = switch (guard) { None(): s2id_("eqssi"); Some(__): s2id_("eqssd"); };
	maybeBind(ruFwdSsClose(ids, facts, x, y, stcl, 8, guard, prover_env), \p1 ->
		maybeMap(ruFwdSsClose(ids, facts, y, x, stcl, 8, guard, prover_env), \p2 ->
			RuProofStep(eqss, [p1, p2],
				RuStmt(stcl, [wrap(ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(x, -1), RuExp(y, -1)]))], -1))));
}

// A ⊊ B via a ⊊-fact plus ⊆-closure legs: the 0-hyp transitivity implications
// psssstr ((A⊊M)∧(M⊆B) → A⊊B) and sspsstr ((A⊆M)∧(M⊊B) → A⊊B), applied by
// ax-mp (bare) / syl (guarded) to the jca/pm3.2i pair.
ruFwdPssClose(ids : RuFwdInstIds, facts : RuFwdClsFacts, a : [RuExpNode], b : [RuExpNode], stcl : int, guard : Maybe<RuExp>, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	wrap = \e : RuExp -> switch (guard) { None(): e; Some(g): ruFwdMkRule(ids.wi, ids.wff, [g, e]); };
	pairId = switch (guard) { None(): s2id_("pm3.2i"); Some(__): s2id_("jca"); };
	goalE = ruFwdMkRule(s2id("wpss"), ids.wff, [RuExp(a, -1), RuExp(b, -1)]);
	// apply a 0-hyp implication instance ⊢anteE→goalE to a mode proof of anteE
	applyImp = \p : RuProofTree, anteE : RuExp, lemId : int -> {
		inst = RuProofStep(lemId, [], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [anteE, goalE])], -1));
		switch (guard) {
			None(): RuProofStep(ids.axmp, [p, inst], RuStmt(stcl, [goalE], -1));
			Some(__): RuProofStep(s2id_("syl"), [p, inst], RuStmt(stcl, [wrap(goalE)], -1));
		}
	};
	fold(facts.pss, None(), \ac, f -> switch (ac) {
		Some(__): ac;
		None(): {
			fn = f.second;
			lend = ruFwdSpan(fn, 1);
			fa = subrange(fn, 1, lend - 1);
			fb = subrange(fn, lend, length(fn) - lend);
			if (fa == a && fb == b) Some(f.first)
			else if (fa == a) {
				// (a⊊fb) + fb⊆b → psssstr
				maybeMap(ruFwdSsClose(ids, facts, fb, b, stcl, 8, guard, prover_env), \ps -> {
					ssE = ruFwdMkRule(ids.wss, ids.wff, [RuExp(fb, -1), RuExp(b, -1)]);
					anteE = ruFwdMkRule(ids.wa, ids.wff, [RuExp(fn, -1), ssE]);
					pAnd = RuProofStep(pairId, [f.first, ps], RuStmt(stcl, [wrap(anteE)], -1));
					applyImp(pAnd, anteE, s2id_("psssstr"));
				});
			} else if (fb == b) {
				// a⊆fa + (fa⊊b) → sspsstr
				maybeMap(ruFwdSsClose(ids, facts, a, fa, stcl, 8, guard, prover_env), \ps -> {
					ssE = ruFwdMkRule(ids.wss, ids.wff, [RuExp(a, -1), RuExp(fa, -1)]);
					anteE = ruFwdMkRule(ids.wa, ids.wff, [ssE, RuExp(fn, -1)]);
					pAnd = RuProofStep(pairId, [ps, f.first], RuStmt(stcl, [wrap(anteE)], -1));
					applyImp(pAnd, anteE, s2id_("sspsstr"));
				});
			} else None();
		}
	});
}

// RESIDUE → ∅ (the ssdif0-route residue discharge): flatten the stalled normal
// form of X∖Y over its ∪-spine; each ∖-piece A∖B collapses to ∅ once the
// ⊆-closure decides A⊆B (mpbi + ssdif0); the spine re-assembles by uneq12i +
// un0 (∅∪∅ = ∅) + eqtri.
ruFwdResidue0(ids : RuFwdInstIds, eids : RuFwdEqIds, facts : RuFwdClsFacts, t : [RuExpNode], stcl : int, guard : Maybe<RuExp>, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	wceq = s2id("wceq");
	wrap = \e : RuExp -> switch (guard) { None(): e; Some(g): ruFwdMkRule(ids.wi, ids.wff, [g, e]); };
	lift = \asId : int, e : RuExp -> {
		bare = RuProofStep(asId, [], RuStmt(stcl, [e], -1));
		switch (guard) {
			None(): bare;
			Some(__): RuProofStep(s2id_("a1i"), [bare], RuStmt(stcl, [wrap(e)], -1));
		}
	};
	uneq12i = switch (guard) { None(): s2id_("uneq12i"); Some(__): s2id_("uneq12d"); };
	eqtri = switch (guard) { None(): eids.eqtri; Some(__): s2id_("eqtrd"); };
	mpbi = switch (guard) { None(): s2id_("mpbi"); Some(__): s2id_("mpbid"); };
	empty = [ruMakeRuleNode(s2id("c0"), ids.cls, 0, 0)];
	eqT0 = ruFwdMkRule(wceq, ids.wff, [RuExp(t, -1), RuExp(empty, -1)]);
	switch (t[0]) {
		RuVar(__,__): None();
		RuRuleNode(idT, __): {
			hid = ruIdType2Id(idT);
			if (length(t) < 3) None()
			else {
				lend = ruFwdSpan(t, 1);
				l = subrange(t, 1, lend - 1);
				r = subrange(t, lend, length(t) - lend);
				if (hid == ids.cun) {
					maybeBind(ruFwdResidue0(ids, eids, facts, l, stcl, guard, prover_env), \pl ->
						maybeMap(ruFwdResidue0(ids, eids, facts, r, stcl, guard, prover_env), \pr -> {
							e00 = ruFwdMkRule(ids.cun, ids.cls, [RuExp(empty, -1), RuExp(empty, -1)]);
							p1 = RuProofStep(uneq12i, [pl, pr],
								RuStmt(stcl, [wrap(ruFwdMkRule(wceq, ids.wff, [RuExp(t, -1), e00]))], -1));
							p2 = lift(s2id_("un0"), ruFwdMkRule(wceq, ids.wff, [e00, RuExp(empty, -1)]));
							RuProofStep(eqtri, [p1, p2], RuStmt(stcl, [wrap(eqT0)], -1));
						}));
				} else if (hid == ids.cdif) {
					maybeMap(ruFwdSsClose(ids, facts, l, r, stcl, 8, guard, prover_env), \pss -> {
						ssd = lift(s2id_("ssdif0"),
							ruFwdMkRule(ids.wb, ids.wff, [ruFwdMkRule(ids.wss, ids.wff, [RuExp(l, -1), RuExp(r, -1)]), eqT0]));
						RuProofStep(mpbi, [pss, ssd], RuStmt(stcl, [wrap(eqT0)], -1));
					});
				} else {
					// any other piece: a pooled T=∅ fact matching it verbatim
					fold(facts.eq0, None(), \ac, f -> switch (ac) {
						Some(__): ac;
						None(): if (f.second == t) Some(f.first) else None();
					});
				}
			}
		}
	}
}

// ⊢ X = Y (BARE) from coinciding normal forms: the eqtri/eqcomi assembly of
// the two normalization chains. None = the normal forms differ.
ruFwdEqFromNfs(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], xs : [RuExpNode], ys : [RuExpNode], stcl : int, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	wceq = s2id("wceq");
	nx = ruFwdNormalize(ids, eids, rules, xs, stcl, prover_env.math, prover_env.env);
	ny = ruFwdNormalize(ids, eids, rules, ys, stcl, prover_env.math, prover_env.env);
	if (nx.first != ny.first) None() else {
		eqE = ruFwdMkRule(wceq, ids.wff, [RuExp(xs, -1), RuExp(ys, -1)]);
		Some(switch (nx.second) {
			None(): switch (ny.second) {
				None(): RuProofStep(eids.eqid, [], RuStmt(stcl, [eqE], -1));
				Some(py): RuProofStep(eids.eqcomi, [py], RuStmt(stcl, [eqE], -1));
			}
			Some(px): switch (ny.second) {
				None(): px;
				Some(py): {
					flipped = RuProofStep(eids.eqcomi, [py],
						RuStmt(stcl, [ruFwdMkRule(wceq, ids.wff, [RuExp(nx.first, -1), RuExp(ys, -1)])], -1));
					RuProofStep(eids.eqtri, [px, flipped], RuStmt(stcl, [eqE], -1));
				}
			}
		});
	}
}

// ψ→(T = T[A := R]) — the GUARDED CONGRUENCE lift of ψ→(A = R) at every
// occurrence of A in T over the ∩/∪/∖ spine (ineq1d/ineq2d, uneq1d/uneq2d,
// difeq1d/difeq2d; both-side rewrites eqtrd-composed). None = A does not
// occur (or sits under an unliftable operator).
ruFwdGuardedSubst(ids : RuFwdInstIds, psi : RuExp, pEq : RuProofTree, a : [RuExpNode], rr : [RuExpNode], t : [RuExpNode], stcl : int) -> Maybe<Pair<RuProofTree, [RuExpNode]>> {
	mkImp = \e1, e2 -> ruFwdMkRule(ids.wi, ids.wff, [e1, e2]);
	wceq = s2id("wceq");
	if (t == a) Some(Pair(pEq, rr))
	else switch (t[0]) {
		RuVar(__,__): None();
		RuRuleNode(idT, __): {
			hid = ruIdType2Id(idT);
			// the UNARY spine (𝒫/⋃, pweqd/unieqd) — one recursive leg, no eqtrd merge
			if ((hid == s2id("cpw") || hid == s2id("cuni")) && length(t) >= 2) {
				arg = subrange(t, 1, length(t) - 1);
				op1u = if (hid == s2id("cpw")) s2id_("pweqd") else s2id_("unieqd");
				maybeMap(ruFwdGuardedSubst(ids, psi, pEq, a, rr, arg, stcl), \pa -> {
					t1 = (ruFwdMkRule(hid, ids.cls, [RuExp(pa.second, -1)])).nodes;
					Pair(RuProofStep(op1u, [pa.first],
						RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [psi,
							ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(t, -1), RuExp(t1, -1)])])], -1)), t1);
				});
			}
			else if (length(t) < 3 || (hid != ids.cin && hid != ids.cun && hid != ids.cdif && hid != s2id("cxp"))) None()
			else {
				lend = ruFwdSpan(t, 1);
				l = subrange(t, 1, lend - 1);
				r = subrange(t, lend, length(t) - lend);
				op1d = if (hid == ids.cin) s2id_("ineq1d") else if (hid == ids.cun) s2id_("uneq1d")
					else if (hid == s2id("cxp")) s2id_("xpeq1d") else s2id_("difeq1d");
				op2d = if (hid == ids.cin) s2id_("ineq2d") else if (hid == ids.cun) s2id_("uneq2d")
					else if (hid == s2id("cxp")) s2id_("xpeq2d") else s2id_("difeq2d");
				mkOp = \x, y -> (ruFwdMkRule(hid, ids.cls, [RuExp(x, -1), RuExp(y, -1)])).nodes;
				mL = ruFwdGuardedSubst(ids, psi, pEq, a, rr, l, stcl);
				mR = ruFwdGuardedSubst(ids, psi, pEq, a, rr, r, stcl);
				switch (mL) {
					None(): switch (mR) {
						None(): None();
						Some(pr2): {
							t2 = mkOp(l, pr2.second);
							Some(Pair(RuProofStep(op2d, [pr2.first],
								RuStmt(stcl, [mkImp(psi, ruFwdMkRule(wceq, ids.wff, [RuExp(t, -1), RuExp(t2, -1)]))], -1)), t2));
						}
					}
					Some(pl): {
						t1 = mkOp(pl.second, r);
						p1 = RuProofStep(op1d, [pl.first],
							RuStmt(stcl, [mkImp(psi, ruFwdMkRule(wceq, ids.wff, [RuExp(t, -1), RuExp(t1, -1)]))], -1));
						switch (mR) {
							None(): Some(Pair(p1, t1));
							Some(pr2): {
								t2 = mkOp(pl.second, pr2.second);
								p2 = RuProofStep(op2d, [pr2.first],
									RuStmt(stcl, [mkImp(psi, ruFwdMkRule(wceq, ids.wff, [RuExp(t1, -1), RuExp(t2, -1)]))], -1));
								Some(Pair(RuProofStep(s2id_("eqtrd"), [p1, p2],
									RuStmt(stcl, [mkImp(psi, ruFwdMkRule(wceq, ids.wff, [RuExp(t, -1), RuExp(t2, -1)]))], -1)), t2));
							}
						}
					}
				}
			}
		}
	}
}

// T = ∅ UNDER A GUARD ψ (the disjointness channel, t66/t70/t77/t81/t84-class):
// (i) T normalizes to ∅ outright; (ii) nf(T) coincides with an eq0-fact's term
// (bare chain + eqtrd); (iii) the ∅-COVER: T ⊆ F1∪…∪Fk over ALL eq0-facts by
// the ssdif0 difference-collapse (bare nf, residue ⊆-closure under the guard),
// the union collapses to ∅ by the fact proofs (uneq12d + un0 spine), then
// ss0 ((A⊆∅)→(A=∅)). Irrelevant facts in the cover are harmless: the
// difference distributes (difundi) and the dead factors vanish structurally.
ruFwdEq0Close(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], facts : RuFwdClsFacts,
	psi : RuExp, t : [RuExpNode], stcl : int, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	wceq = s2id("wceq");
	mkImp = \x, y -> ruFwdMkRule(ids.wi, ids.wff, [x, y]);
	a1iLift = \p : RuProofTree, e : RuExp -> RuProofStep(s2id_("a1i"), [p], RuStmt(stcl, [mkImp(psi, e)], -1));
	empty = [ruMakeRuleNode(s2id("c0"), ids.cls, 0, 0)];
	eqT0 = ruFwdMkRule(wceq, ids.wff, [RuExp(t, -1), RuExp(empty, -1)]);
	nd = ruFwdNormalize(ids, eids, rules, t, stcl, prover_env.math, prover_env.env);
	if (nd.first == empty) maybeMap(nd.second, \p -> a1iLift(p, eqT0))
	else {
	direct = fold(facts.eq0, None(), \ac, f -> switch (ac) {
		Some(__): ac;
		None(): maybeMap(ruFwdEqFromNfs(ids, eids, rules, t, f.second, stcl, prover_env), \pTF ->
			RuProofStep(s2id_("eqtrd"), [
				a1iLift(pTF, ruFwdMkRule(wceq, ids.wff, [RuExp(t, -1), RuExp(f.second, -1)])),
				f.first], RuStmt(stcl, [mkImp(psi, eqT0)], -1)));
	});
	switch (direct) { Some(__): direct; None(): {
	cover = if (facts.eq0 == []) None() else {
		// the ∅-cover: assemble U and ψ→(U=∅) left-nested over the pool
		pU0 = fold(tail(facts.eq0), Pair((facts.eq0[0]).first, (facts.eq0[0]).second), \acP, f -> {
			newU = (ruFwdMkRule(ids.cun, ids.cls, [RuExp(acP.second, -1), RuExp(f.second, -1)])).nodes;
			e00 = ruFwdMkRule(ids.cun, ids.cls, [RuExp(empty, -1), RuExp(empty, -1)]);
			p1 = RuProofStep(s2id_("uneq12d"), [acP.first, f.first],
				RuStmt(stcl, [mkImp(psi, ruFwdMkRule(wceq, ids.wff, [RuExp(newU, -1), e00]))], -1));
			p2 = a1iLift(RuProofStep(s2id_("un0"), [],
				RuStmt(stcl, [ruFwdMkRule(wceq, ids.wff, [e00, RuExp(empty, -1)])], -1)),
				ruFwdMkRule(wceq, ids.wff, [e00, RuExp(empty, -1)]));
			Pair(RuProofStep(s2id_("eqtrd"), [p1, p2],
				RuStmt(stcl, [mkImp(psi, ruFwdMkRule(wceq, ids.wff, [RuExp(newU, -1), RuExp(empty, -1)]))], -1)), newU);
		});
		u = pU0.second;
		diff = ruFwdMkRule(ids.cdif, ids.cls, [RuExp(t, -1), RuExp(u, -1)]);
		nd2 = ruFwdNormalize(ids, eids, rules, diff.nodes, stcl, prover_env.math, prover_env.env);
		eqD0 = ruFwdMkRule(wceq, ids.wff, [diff, RuExp(empty, -1)]);
		mD0 = if (nd2.first == empty) maybeMap(nd2.second, \p -> a1iLift(p, eqD0))
			else maybeMap(ruFwdResidue0(ids, eids, facts, nd2.first, stcl, Some(psi), prover_env), \p0 ->
				switch (nd2.second) {
					None(): p0;
					Some(pd): RuProofStep(s2id_("eqtrd"), [
						a1iLift(pd, ruFwdMkRule(wceq, ids.wff, [diff, RuExp(nd2.first, -1)])),
						p0], RuStmt(stcl, [mkImp(psi, eqD0)], -1));
				});
		maybeMap(mD0, \pD0 -> {
			ssTU = ruFwdMkRule(ids.wss, ids.wff, [RuExp(t, -1), RuExp(u, -1)]);
			bi = ruFwdMkRule(ids.wb, ids.wff, [ssTU, eqD0]);
			pTU = RuProofStep(s2id_("mpbird"), [pD0,
				a1iLift(RuProofStep(s2id_("ssdif0"), [], RuStmt(stcl, [bi], -1)), bi)],
				RuStmt(stcl, [mkImp(psi, ssTU)], -1));
			ssT0 = ruFwdMkRule(ids.wss, ids.wff, [RuExp(t, -1), RuExp(empty, -1)]);
			pT0 = RuProofStep(s2id_("sseqtrd"), [pTU, pU0.first], RuStmt(stcl, [mkImp(psi, ssT0)], -1));
			RuProofStep(s2id_("syl"), [pT0,
				RuProofStep(s2id_("ss0"), [], RuStmt(stcl, [mkImp(ssT0, eqT0)], -1))],
				RuStmt(stcl, [mkImp(psi, eqT0)], -1));
		});
	};
	switch (cover) { Some(__): cover; None(): {
	// (v) SINGLETON DISJOINTNESS: {a}∩{b} = ∅ from a pooled ψ→¬(a=b)
	// (df-ne backward + disjsn2) — t11/t14_zfmisc_1-class
	disj = {
		th5 = switch (t[0]) { RuVar(__,__): -1; RuRuleNode(idT5, __): ruIdType2Id(idT5); };
		if (th5 != ids.cin || length(t) < 3) None() else {
			lend5 = ruFwdSpan(t, 1);
			l5 = subrange(t, 1, lend5 - 1);
			r5 = subrange(t, lend5, length(t) - lend5);
			isSn = \e : [RuExpNode] -> length(e) >= 2 && switch (e[0]) {
				RuVar(__,__): false;
				RuRuleNode(idT6, __): ruIdType2Id(idT6) == s2id("csn");
			};
			if (!isSn(l5) || !isSn(r5)) None() else {
				sa = subrange(l5, 1, length(l5) - 1);
				sb = subrange(r5, 1, length(r5) - 1);
				eqabE = ruFwdMkRule(wceq, ids.wff, [RuExp(sa, -1), RuExp(sb, -1)]);
				mNe = fold(facts.neg, None(), \acN, f -> switch (acN) {
					Some(__): acN;
					None(): if (f.second == eqabE.nodes) Some(f.first) else None();
				});
				maybeMap(mNe, \pn -> {
					neE = ruFwdMkRule(s2id("wne"), ids.wff, [RuExp(sa, -1), RuExp(sb, -1)]);
					biE = ruFwdMkRule(ids.wb, ids.wff, [neE, ruFwdMkRule(ids.wn, ids.wff, [eqabE])]);
					pNe2 = RuProofStep(s2id_("mpbird"), [pn,
						a1iLift(RuProofStep(s2id_("df-ne"), [], RuStmt(stcl, [biE], -1)), biE)],
						RuStmt(stcl, [mkImp(psi, neE)], -1));
					inst = RuProofStep(s2id_("disjsn2"), [], RuStmt(stcl, [mkImp(neE, eqT0)], -1));
					RuProofStep(s2id_("syl"), [pNe2, inst], RuStmt(stcl, [mkImp(psi, eqT0)], -1));
				});
			}
		}
	};
	switch (disj) { Some(__): disj; None(): {
	// (vi) PRODUCT DISJOINTNESS: T = (A×C)∩(B×D) closes to ∅ once one factor
	// pair is disjoint — xpdisj1 ((A∩B)=∅) / xpdisj2 ((C∩D)=∅), the factor
	// equality closed by THIS channel recursively (t108-class: {x5}∩{x8}=∅
	// arrives by the (v) singleton route and feeds xpdisj1)
	xpd = {
		cxpId = s2id("cxp");
		isXp = \e : [RuExpNode] -> length(e) >= 3 && switch (e[0]) {
			RuVar(__,__): false;
			RuRuleNode(idT7, __): ruIdType2Id(idT7) == cxpId;
		};
		th6 = switch (t[0]) { RuVar(__,__): -1; RuRuleNode(idT8, __): ruIdType2Id(idT8); };
		if (th6 != ids.cin || length(t) < 3) None() else {
			lend6 = ruFwdSpan(t, 1);
			l6 = subrange(t, 1, lend6 - 1);
			r6 = subrange(t, lend6, length(t) - lend6);
			if (!isXp(l6) || !isXp(r6)) None() else {
				aend = ruFwdSpan(l6, 1);
				a6 = subrange(l6, 1, aend - 1);
				c6 = subrange(l6, aend, length(l6) - aend);
				bend = ruFwdSpan(r6, 1);
				b6 = subrange(r6, 1, bend - 1);
				d6 = subrange(r6, bend, length(r6) - bend);
				tryD = \u1 : [RuExpNode], u2 : [RuExpNode], lem : string -> {
					u12 = ruFwdMkRule(ids.cin, ids.cls, [RuExp(u1, -1), RuExp(u2, -1)]);
					maybeMap(ruFwdEq0Close(ids, eids, rules, facts, psi, u12.nodes, stcl, prover_env), \p12 -> {
						eq12 = ruFwdMkRule(wceq, ids.wff, [u12, RuExp(empty, -1)]);
						RuProofStep(s2id_("syl"), [p12,
							RuProofStep(s2id_(lem), [], RuStmt(stcl, [mkImp(eq12, eqT0)], -1))],
							RuStmt(stcl, [mkImp(psi, eqT0)], -1));
					});
				};
				m1 = tryD(a6, b6, "xpdisj1");
				switch (m1) { Some(__): m1; None(): tryD(c6, d6, "xpdisj2"); }
			}
		}
	};
	switch (xpd) { Some(__): xpd; None(): {
		// (iv) df-ss SUBSTITUTION (the guarded-congruence route, t107-class):
		// a guard ⊆-fact A⊆B gives ψ→(A=(A∩B)) (dfss2); substitute it into T
		// and normalize — nf(T[A:=A∩B]) = ∅ closes ψ→(T=∅) by eqtrd.
		fold(facts.ss, None(), \acS, sf -> switch (acS) {
			Some(__): acS;
			None(): {
				sn = sf.second;
				slend = ruFwdSpan(sn, 1);
				sA = subrange(sn, 1, slend - 1);
				sB = subrange(sn, slend, length(sn) - slend);
				aInB = (ruFwdMkRule(ids.cin, ids.cls, [RuExp(sA, -1), RuExp(sB, -1)])).nodes;
				eqInA = ruFwdMkRule(wceq, ids.wff, [RuExp(aInB, -1), RuExp(sA, -1)]);
				biS = ruFwdMkRule(ids.wb, ids.wff, [RuExp(sn, -1), eqInA]);
				pInA = RuProofStep(s2id_("mpbid"), [sf.first,
					a1iLift(RuProofStep(s2id_("dfss2"), [], RuStmt(stcl, [biS], -1)), biS)],
					RuStmt(stcl, [mkImp(psi, eqInA)], -1));
				pEq = RuProofStep(s2id_("eqcomd"), [pInA],
					RuStmt(stcl, [mkImp(psi, ruFwdMkRule(wceq, ids.wff, [RuExp(sA, -1), RuExp(aInB, -1)]))], -1));
				maybeBind(ruFwdGuardedSubst(ids, psi, pEq, sA, aInB, t, stcl), \sub -> {
					t2 = sub.second;
					nd2 = ruFwdNormalize(ids, eids, rules, t2, stcl, prover_env.math, prover_env.env);
					if (prover_env.env.conf.verbose >= 6) {
						prover_env.env.out.println("    eq0 subst: t2="
							+ ruSafeExp2s(RuExp(t2, -1), prover_env.math.decls.lang)
							+ "  nf=" + ruSafeExp2s(RuExp(nd2.first, -1), prover_env.math.decls.lang));
					} else {};
					// nf(t2) = ∅ outright, or its ∪-residue discharges by the ⊆-closure
					mNf0 = if (nd2.first == empty) maybeMap(nd2.second, \p2 ->
							a1iLift(p2, ruFwdMkRule(wceq, ids.wff, [RuExp(t2, -1), RuExp(empty, -1)])))
						else maybeMap(ruFwdResidue0(ids, eids, facts, nd2.first, stcl, Some(psi), prover_env), \p0 ->
							switch (nd2.second) {
								None(): p0; // t2 == the nf syntactically
								Some(p2): RuProofStep(s2id_("eqtrd"), [
									a1iLift(p2, ruFwdMkRule(wceq, ids.wff, [RuExp(t2, -1), RuExp(nd2.first, -1)])),
									p0], RuStmt(stcl, [mkImp(psi, ruFwdMkRule(wceq, ids.wff, [RuExp(t2, -1), RuExp(empty, -1)]))], -1));
							});
					// edge: t2 == ∅ syntactically — ψ→(t=∅) is sub.first itself
					if (t2 == empty) Some(sub.first)
					else maybeMap(mNf0, \pT20 ->
						RuProofStep(s2id_("eqtrd"), [sub.first, pT20], RuStmt(stcl, [mkImp(psi, eqT0)], -1)));
				});
			}
		});
	}}
	}}
	}}
	}}}
}

// Parse the Mizar product-∃ ¬-goal's BODY (the part under the leading ¬):
// ∀u∀v¬(…) over either conjunct order — (u∈B) ∧ ((v∈C) ∧ (a=〈u,v〉)) or
// (a=〈u,v〉) ∧ ((u∈B) ∧ (v∈C)) — giving Some(Pair([a, B, C], bridge-lemma)).
// The binders must be setvars in exactly the pattern positions, free in none
// of a/B/C.
ruFwdMizProdExParse(ids : RuFwdInstIds, y : [RuExpNode]) -> Maybe<Pair<[[RuExpNode]], string>> {
	isHead = \nd : RuExpNode, w : int -> switch (nd) {
		RuVar(__,__): false;
		RuRuleNode(iH, __): ruIdType2Id(iH) == w;
	};
	ok0 = length(y) > 5 && isHead(y[0], ids.wal) && ruFwdIsSetvarNode(y[1], ids.setvar)
		&& isHead(y[2], ids.wal) && ruFwdIsSetvarNode(y[3], ids.setvar) && isHead(y[4], ids.wn);
	if (!ok0) None() else {
		u = y[1];
		v = y[3];
		body = subrange(y, 5, length(y) - 5);
		if (length(body) < 3 || !isHead(body[0], ids.wa)) None() else {
			e1 = ruFwdSpan(body, 1);
			c1 = subrange(body, 1, e1 - 1);
			rest = subrange(body, e1, length(body) - e1);
			if (length(rest) < 3 || !isHead(rest[0], ids.wa)) None() else {
				e2 = ruFwdSpan(rest, 1);
				c2 = subrange(rest, 1, e2 - 1);
				c3 = subrange(rest, e2, length(rest) - e2);
				// c1 = (u∈B), c2 = (v∈C), c3 = (a=〈u,v〉)
				celOf = \c : [RuExpNode], w : RuExpNode -> {
					okc = length(c) > 3 && isHead(c[0], ids.wcel);
					if (!okc) None() else {
						ee = ruFwdSpan(c, 1);
						el = subrange(c, 1, ee - 1);
						if (length(el) == 2 && el[1] == w) Some(subrange(c, ee, length(c) - ee)) else None();
					}
				};
				eqOf = \c : [RuExpNode] -> {
					okq = length(c) >= 3 && isHead(c[0], s2id("wceq"));
					if (!okq) None() else {
						e3 = ruFwdSpan(c, 1);
						aT = subrange(c, 1, e3 - 1);
						opT = subrange(c, e3, length(c) - e3);
						if (length(opT) == 5 && isHead(opT[0], s2id("cop")) && opT[2] == u && opT[4] == v)
							Some(aT) else None();
					}
				};
				checkDv = \aT : [RuExpNode], bT : [RuExpNode], cT : [RuExpNode], lemma : string ->
					if (!ruFwdContainsNode(aT, u) && !ruFwdContainsNode(aT, v)
						&& !ruFwdContainsNode(bT, u) && !ruFwdContainsNode(bT, v)
						&& !ruFwdContainsNode(cT, u) && !ruFwdContainsNode(cT, v))
						Some(Pair([aT, bT, cT], lemma)) else None();
				// order 1 (elxpmiz):  (u∈B) ∧ ((v∈C) ∧ (a=〈u,v〉))
				o1 = maybeBind(celOf(c1, u), \bT -> maybeBind(celOf(c2, v), \cT ->
					maybeBind(eqOf(c3), \aT -> checkDv(aT, bT, cT, "elxpmiz"))));
				switch (o1) { Some(__): o1; None():
					// order 2 (elxpmiz2): (a=〈u,v〉) ∧ ((u∈B) ∧ (v∈C))
					maybeBind(eqOf(c1), \aT -> maybeBind(celOf(c2, u), \bT ->
						maybeBind(celOf(c3, v), \cT -> checkDv(aT, bT, cT, "elxpmiz2"))));
				}
			}
		}
	}
}

// ψ → X for a single positive literal X — the clash driver's positive side.
// Dispatch on the head: ∧ recurses (jca), ∨ by disjunct intro (orcd/olcd) or
// the oran route, ¬Y from the neg pool / the nel02 empty-set route / clause
// refutation (imnani), ↔ from the bi pool or impbid of the two iman-route
// directions, ∈ from the el pool / ⊆-transport (ssel) / ↔- and =-transport
// (mpbid, eleq1) / definitional intro (elun/elin/eldif/elsymdif/velsn),
// ⊊ via the ⊊-closure / dfpss2-intro, = via the ∅-channels / antisymmetry,
// ⊆ via the guarded ⊆-closure, bare relClose and the ssdif0 collapse.
// `depth` bounds all synthetic-clause / transport recursion.
// MEMO WRAPPER. The channel battery below is a DETERMINISTIC dfs: the same (goal,
// guard, depth) over the same pools always yields the same result — but dozens of
// channels reach the same subgoal by different routes, so the raw dfs re-derived every
// FAILING subgoal again and again (zfmisc t85: 11000 calls behind 231 distinct goals)
// and spent its whole stage slice doing it. The memo lives for ONE closure entry, so
// the pools — a function of the guard, which is part of the key — are fixed for its
// lifetime. The cycle-guard rejection is NOT cached: it is a property of the current
// path, not of the goal, and caching it would poison that goal for every other path.
ruFwdLitClose(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], asses : RuIndex<RuAssertion>,
	facts : RuFwdClsFacts, bareFacts : RuFwdClsFacts, psi : RuExp, x : [RuExpNode], stcl : int, depth : int, path0 : [[RuExpNode]], memo : ref Tree<Pair<[RuExpNode], Pair<[RuExpNode], int>>, Maybe<RuProofTree>>, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	if (contains(path0, x)) None() else {
		key = Pair(x, Pair(psi.nodes, depth));
		switch (lookupTree(^memo, key)) {
			Some(hit): hit;
			None(): {
				res0 = ruFwdLitCloseDfs(ids, eids, rules, asses, facts, bareFacts, psi, x, stcl, depth, path0, memo, prover_env);
				// THE GENERIC APPLIER (table-closer=1, P2 of the rule-table plan): a FALLBACK
				// after the channel battery — table-first cost the fixed wall-clock stage
				// slice and lost provable theorems (the t19 lesson). Its subgoal recursion
				// re-enters this closer (same memo, path extended), so the table and the
				// channels compose. Flag off = no-op.
				res = switch (res0) {
					Some(__): res0;
					None(): if (!ruTableCloserOn(prover_env)) None()
						else ruTableClose(ruFwdTcPool(ids, facts), psi, x, stcl, depth,
							\x2, d2 -> ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, x2, stcl, d2, arrayPush(path0, x), memo, prover_env),
							prover_env);
				};
				memo := setTree(^memo, key, res);
				res;
			}
		}
	}
}

ruFwdLitCloseDfs(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], asses : RuIndex<RuAssertion>,
	facts : RuFwdClsFacts, bareFacts : RuFwdClsFacts, psi : RuExp, x : [RuExpNode], stcl : int, depth : int, path0 : [[RuExpNode]], memo : ref Tree<Pair<[RuExpNode], Pair<[RuExpNode], int>>, Maybe<RuProofTree>>, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	// CYCLE GUARD: inverse channel pairs (x=y ⟸ x∈{y} ⟸ x=y …) ping-pong
	// forever without it, burning the whole depth budget on one loop.
	// TIMER GUARD: the recursive channel product (∨-elim × pool rebuilds) can
	// explode combinatorially — a closer that ignores the per-theorem timer
	// starves every SIBLING theorem of the sequential batch's shared pool
	// (the t19 lesson; giving up under a limit is sound, missing one is not)
	if (contains(path0, x) || ruTimeIsOver(prover_env.conf.timer)) None() else {
	path = arrayPush(path0, x);
	wpss = s2id("wpss");
	mkImp = \e1, e2 -> ruFwdMkRule(ids.wi, ids.wff, [e1, e2]);
	empty = [ruMakeRuleNode(s2id("c0"), ids.cls, 0, 0)];
	psiX = mkImp(psi, RuExp(x, -1));
	if (prover_env.env.conf.verbose >= 6) {
		prover_env.env.out.println("  litClose depth=" + i2s(depth) + ": "
			+ ruSafeExp2s(RuExp(x, -1), prover_env.math.decls.lang)
			+ " len=" + i2s(length(x)) + " hid=" + (switch (x[0]) { RuVar(__,__): "var"; RuRuleNode(idTz, __): id2s(ruIdType2Id(idTz)); }));
	} else {};
	switch (x[0]) {
		RuVar(__,__): None();
		RuRuleNode(idT, __): {
			hid = ruIdType2Id(idT);
			if (hid == ids.wn && length(x) >= 2) {
				y = subrange(x, 1, length(x) - 1);
				// (a) a pooled ¬-fact verbatim
				direct = fold(facts.neg, None(), \ac, f -> switch (ac) {
					Some(__): ac;
					None(): if (f.second == y) Some(f.first) else None();
				});
				switch (direct) { Some(__): direct; None(): {
				// (b) ¬(x∈T) with a pooled T=∅ fact — the nel02 route
				yIsCel = length(y) >= 3 && switch (y[0]) {
					RuVar(__,__): false;
					RuRuleNode(idTa, __): ruIdType2Id(idTa) == ids.wcel;
				};
				nel = if (!yIsCel) None() else {
					ylend = ruFwdSpan(y, 1);
					yEl = subrange(y, 1, ylend - 1);
					yT = subrange(y, ylend, length(y) - ylend);
					fold(facts.eq0, None(), \ac, qf -> switch (ac) {
						Some(__): ac;
						None(): if (qf.second != yT) None() else {
							eqE = ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(yT, -1), RuExp(empty, -1)]);
							inst = RuProofStep(s2id_("nel02"), [],
								RuStmt(stcl, [mkImp(eqE, ruFwdMkRule(ids.wn, ids.wff, [RuExp(y, -1)]))], -1));
							Some(RuProofStep(s2id_("syl"), [qf.first, inst], RuStmt(stcl, [psiX], -1)));
						}
					});
				};
				switch (nel) { Some(__): nel; None(): {
				// (b2) NONEMPTINESS BY WITNESS (t110-class: ¬((X×Y)=∅)): y = (T=∅) —
				// close ψ→(w∈T) for a witness w and conclude by n0i ((B∈A)→¬(A=∅)).
				// Candidates: every pooled el ELEMENT, and every PAIR ⟨a,b⟩ of pooled
				// elements when a cxp is in sight (T itself or its eqs-image) — the
				// =-transport/product-intro channels do the real work of w∈T.
				yIsEq0 = length(y) >= 3 && (switch (y[0]) {
						RuVar(__,__): false;
						RuRuleNode(idTe, __): ruIdType2Id(idTe) == s2id("wceq");
					}) && {
						elend = ruFwdSpan(y, 1);
						subrange(y, elend, length(y) - elend) == empty;
					};
				ne0w = if (!yIsEq0 || depth <= 0) None() else {
					tlend = ruFwdSpan(y, 1);
					tT = subrange(y, 1, tlend - 1);
					isCxpHead = \nds : [RuExpNode] -> switch (nds[0]) {
						RuVar(__,__): false;
						RuRuleNode(idTc, __): ruIdType2Id(idTc) == s2id("cxp");
					};
					cxpNear = isCxpHead(tT) || exists(facts.eqs, \f2 -> {
						f2n = f2.second;
						f2end = ruFwdSpan(f2n, 1);
						fu2 = subrange(f2n, 1, f2end - 1);
						fv2 = subrange(f2n, f2end, length(f2n) - f2end);
						(fu2 == tT && isCxpHead(fv2)) || (fv2 == tT && isCxpHead(fu2));
					});
					baseW = map(facts.el, \f2 -> {
						f2n = f2.second;
						subrange(f2n, 1, ruFwdSpan(f2n, 1) - 1);
					});
					// pair witnesses are the expensive tail — cap 4 elements (16 pairs)
					// and HEAVY depth-damp -4 on every attempt (the 104→99 batch
					// regression: undamped attempts starved the t105-t115 neighbors)
					pairsW = if (!cxpNear || depth < 4) [] else {
						bs = take(baseW, 4);
						concatA(map(bs, \a2 -> map(bs, \b2 ->
							(ruFwdMkRule(s2id("cop"), ids.cls, [RuExp(a2, -1), RuExp(b2, -1)])).nodes)));
					};
					fold(concat(baseW, pairsW), None(), \acW, w -> switch (acW) {
						Some(__): acW;
						None(): {
							celWT = ruFwdMkRule(ids.wcel, ids.wff, [RuExp(w, -1), RuExp(tT, -1)]);
							maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi,
								celWT.nodes, stcl, depth - 4, path, memo, prover_env), \pEl -> {
								inst = RuProofStep(s2id_("n0i"), [],
									RuStmt(stcl, [mkImp(celWT, RuExp(x, -1))], -1));
								RuProofStep(s2id_("syl"), [pEl, inst], RuStmt(stcl, [psiX], -1));
							});
						}
					});
				};
				switch (ne0w) { Some(__): ne0w; None(): {
				// (b3) THE MIZAR PRODUCT-∃ GOAL: ¬∀u∀v¬((u∈B) ∧ ((v∈C) ∧ (a=〈u,v〉)))
				// — the translator's ¬∀∀¬ rendering of 'ex u,v st u in B & v in C &
				// a = [u,v]' (t84/t85-class). Close ψ→(a∈(B×C)) recursively and
				// finish by the elxpmiz bridge (miz_aux: elxp reordered + 2exnaln).
				exg = if (depth <= 0) None() else
					maybeBind(ruFwdMizProdExParse(ids, y), \abcL -> {
						abc = abcL.first;
						celE = ruFwdMkRule(ids.wcel, ids.wff, [RuExp(abc[0], -1),
							ruFwdMkRule(s2id("cxp"), ids.cls, [RuExp(abc[1], -1), RuExp(abc[2], -1)])]);
						maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, celE.nodes, stcl, depth - 1, path, memo, prover_env), \pEl -> {
							inst = RuProofStep(s2id_(abcL.second), [], RuStmt(stcl, [mkImp(celE, RuExp(x, -1))], -1));
							RuProofStep(s2id_("syl"), [pEl, inst], RuStmt(stcl, [psiX], -1));
						});
					});
				switch (exg) { Some(__): exg; None(): {
					// (c) refute the ψ∧Y clause, export by imnani
					if (depth <= 0) None() else {
						synth = ruFwdMkRule(ids.wn, ids.wff,
							[ruFwdMkRule(ids.wa, ids.wff, [psi, RuExp(y, -1)])]);
						maybeMap(ruFwdClauseClose(ids, eids, rules, asses, bareFacts, [], synth.nodes, stcl, depth - 1, path, memo, prover_env),
							\pc -> RuProofStep(s2id_("imnani"), [pc], RuStmt(stcl, [psiX], -1)));
					}
				}}
				}}
				}}
				}}
			}
			else if (length(x) < 3) None()
			else {
				lend = ruFwdSpan(x, 1);
				xa = subrange(x, 1, lend - 1);
				xb = subrange(x, lend, length(x) - lend);
				if (hid == ids.wa) {
					maybeBind(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, xa, stcl, depth, path, memo, prover_env), \p1 ->
						maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, xb, stcl, depth, path, memo, prover_env), \p2 ->
							RuProofStep(s2id_("jca"), [p1, p2], RuStmt(stcl, [psiX], -1))));
				} else if (hid == ids.wo) {
					p1 = maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, xa, stcl, depth, path, memo, prover_env),
						\p -> RuProofStep(s2id_("orcd"), [p], RuStmt(stcl, [psiX], -1)));
					switch (p1) { Some(__): p1; None(): {
					p2 = maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, xb, stcl, depth, path, memo, prover_env),
						\p -> RuProofStep(s2id_("olcd"), [p], RuStmt(stcl, [psiX], -1)));
					switch (p2) { Some(__): p2; None(): {
						// the oran route: ψ→¬(¬a∧¬b) by refuting ψ∧(¬a∧¬b)
						if (depth <= 0) None() else {
							nn = ruFwdMkRule(ids.wa, ids.wff, [
								ruFwdMkRule(ids.wn, ids.wff, [RuExp(xa, -1)]),
								ruFwdMkRule(ids.wn, ids.wff, [RuExp(xb, -1)])]);
							synth = ruFwdMkRule(ids.wn, ids.wff, [ruFwdMkRule(ids.wa, ids.wff, [psi, nn])]);
							maybeMap(ruFwdClauseClose(ids, eids, rules, asses, bareFacts, [], synth.nodes, stcl, depth - 1, path, memo, prover_env), \pc -> {
								pNeg = RuProofStep(s2id_("imnani"), [pc],
									RuStmt(stcl, [mkImp(psi, ruFwdMkRule(ids.wn, ids.wff, [nn]))], -1));
								bi = ruFwdMkRule(ids.wb, ids.wff, [RuExp(x, -1), ruFwdMkRule(ids.wn, ids.wff, [nn])]);
								biStep = RuProofStep(s2id_("a1i"),
									[RuProofStep(s2id_("oran"), [], RuStmt(stcl, [bi], -1))],
									RuStmt(stcl, [mkImp(psi, bi)], -1));
								RuProofStep(s2id_("mpbird"), [pNeg, biStep], RuStmt(stcl, [psiX], -1));
							});
						}
					}}
					}}
				} else if (hid == ids.wi) {
					// ψ→(p→q) by the iman route: refute ψ∧(p∧¬q), export by
					// imnani + the iman biconditional
					if (depth <= 0) None() else {
						nn = ruFwdMkRule(ids.wa, ids.wff, [RuExp(xa, -1),
							ruFwdMkRule(ids.wn, ids.wff, [RuExp(xb, -1)])]);
						synth = ruFwdMkRule(ids.wn, ids.wff, [ruFwdMkRule(ids.wa, ids.wff, [psi, nn])]);
						maybeMap(ruFwdClauseClose(ids, eids, rules, asses, bareFacts, [], synth.nodes, stcl, depth - 1, path, memo, prover_env), \pc -> {
							pNeg = RuProofStep(s2id_("imnani"), [pc],
								RuStmt(stcl, [mkImp(psi, ruFwdMkRule(ids.wn, ids.wff, [nn]))], -1));
							bi = ruFwdMkRule(ids.wb, ids.wff, [RuExp(x, -1), ruFwdMkRule(ids.wn, ids.wff, [nn])]);
							biStep = RuProofStep(s2id_("a1i"),
								[RuProofStep(s2id_("iman"), [], RuStmt(stcl, [bi], -1))],
								RuStmt(stcl, [mkImp(psi, bi)], -1));
							RuProofStep(s2id_("mpbird"), [pNeg, biStep], RuStmt(stcl, [psiX], -1));
						});
					}
				} else if (hid == ids.wb) {
					// (a) a pooled ↔-fact, either orientation
					flipN = (ruFwdMkRule(ids.wb, ids.wff, [RuExp(xb, -1), RuExp(xa, -1)])).nodes;
					direct = fold(facts.bi, None(), \ac, f -> switch (ac) {
						Some(__): ac;
						None():
							if (f.second == x) Some(f.first)
							else if (f.second == flipN) Some(RuProofStep(s2id_("bicomd"), [f.first], RuStmt(stcl, [psiX], -1)))
							else None();
					});
					switch (direct) { Some(__): direct; None(): {
						// (b) impbid of the two directions, each by the iman route
						if (depth <= 0) None() else {
							dir = \pp : [RuExpNode], qq : [RuExpNode] -> {
								nn = ruFwdMkRule(ids.wa, ids.wff, [RuExp(pp, -1),
									ruFwdMkRule(ids.wn, ids.wff, [RuExp(qq, -1)])]);
								synth = ruFwdMkRule(ids.wn, ids.wff, [ruFwdMkRule(ids.wa, ids.wff, [psi, nn])]);
								maybeMap(ruFwdClauseClose(ids, eids, rules, asses, bareFacts, [], synth.nodes, stcl, depth - 1, path, memo, prover_env), \pc -> {
									pNeg = RuProofStep(s2id_("imnani"), [pc],
										RuStmt(stcl, [mkImp(psi, ruFwdMkRule(ids.wn, ids.wff, [nn]))], -1));
									impE = mkImp(RuExp(pp, -1), RuExp(qq, -1));
									bi = ruFwdMkRule(ids.wb, ids.wff, [impE, ruFwdMkRule(ids.wn, ids.wff, [nn])]);
									biStep = RuProofStep(s2id_("a1i"),
										[RuProofStep(s2id_("iman"), [], RuStmt(stcl, [bi], -1))],
										RuStmt(stcl, [mkImp(psi, bi)], -1));
									RuProofStep(s2id_("mpbird"), [pNeg, biStep], RuStmt(stcl, [mkImp(psi, impE)], -1));
								});
							};
							maybeBind(dir(xa, xb), \d1 ->
								maybeMap(dir(xb, xa), \d2 ->
									RuProofStep(s2id_("impbid"), [d1, d2], RuStmt(stcl, [psiX], -1))));
						}
					}}
				} else if (hid == ids.wcel) {
					// (a) pooled el-fact verbatim
					direct = fold(facts.el, None(), \ac, f -> switch (ac) {
						Some(__): ac;
						None(): if (f.second == x) Some(f.first) else None();
					});
					switch (direct) { Some(__): direct; None(): {
					// (a2) CLASS-ELEMENT enumeration target: A∈{B}/{B,C}/{B,C,D} with a
					// COMPOUND A unfolds through elsng/elpr/eltp (setness by
					// snex/prex/opex) into the equality disjunction, closed
					// recursively (t134-class: {x5} ∈ {{x5},{x5,x8}})
					tbh = switch (xb[0]) { RuVar(__,__): -1; RuRuleNode(idTb2, __): ruIdType2Id(idTb2); };
					mkEq2 = \ee : [RuExpNode] -> ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(xa, -1), RuExp(ee, -1)]);
					enumEl = \dE : RuExp, biId : int ->
						maybeBind(ruFwdSetness(ids, xa, stcl), \setn ->
							maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, dE.nodes, stcl, depth - 1, path, memo, prover_env), \pd ->
								RuProofStep(s2id_("mpbird"), [pd,
									RuProofStep(s2id_("a1i"),
										[RuProofStep(biId, [setn], RuStmt(stcl, [ruFwdMkRule(ids.wb, ids.wff, [RuExp(x, -1), dE])], -1))],
										RuStmt(stcl, [mkImp(psi, ruFwdMkRule(ids.wb, ids.wff, [RuExp(x, -1), dE]))], -1))],
									RuStmt(stcl, [psiX], -1))));
					aE2 = if (depth <= 0 || length(xa) == 2) None()
						else if (tbh == s2id("csn") && length(xb) >= 2)
							enumEl(mkEq2(subrange(xb, 1, length(xb) - 1)), s2id_("elsng"))
						else if (tbh == s2id("cpr") && length(xb) >= 3) {
							bend2 = ruFwdSpan(xb, 1);
							enumEl(ruFwdMkRule(ids.wo, ids.wff, [
								mkEq2(subrange(xb, 1, bend2 - 1)),
								mkEq2(subrange(xb, bend2, length(xb) - bend2))]), s2id_("elpr"));
						} else if (tbh == s2id("ctp") && length(xb) >= 4) {
							b1e = ruFwdSpan(xb, 1);
							b2e = ruFwdSpan(xb, b1e);
							enumEl(ruFwdMkRule(ids.wo, ids.wff, [
								ruFwdMkRule(ids.wo, ids.wff, [
									mkEq2(subrange(xb, 1, b1e - 1)),
									mkEq2(subrange(xb, b1e, b2e - b1e))]),
								mkEq2(subrange(xb, b2e, length(xb) - b2e))]), s2id_("eltp"));
						} else None();
					switch (aE2) { Some(__): aE2; None(): {
					// (a3) ∪.-INTRO (elunii): goal A∈∪.C — a pooled el-fact w∈C
					// with A∈w closed recursively (t134-class: {x5}∈∪.x16 through
					// w = 〈x5,x8〉)
					a3 = if (depth <= 0 || tbh != s2id("cuni") || length(xb) < 2) None() else {
						ua3 = subrange(xb, 1, length(xb) - 1);
						fold(facts.el, None(), \acU3, fw3 -> switch (acU3) {
							Some(__): acU3;
							None(): {
								wn3 = fw3.second;
								w3end = ruFwdSpan(wn3, 1);
								w3 = subrange(wn3, 1, w3end - 1);
								c3 = subrange(wn3, w3end, length(wn3) - w3end);
								if (c3 != ua3) None()
								else maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi,
									(ruFwdMkRule(ids.wcel, ids.wff, [RuExp(xa, -1), RuExp(w3, -1)])).nodes, stcl, depth - 1, path, memo, prover_env), \pIn3 -> {
									andE3 = ruFwdMkRule(ids.wa, ids.wff, [
										ruFwdMkRule(ids.wcel, ids.wff, [RuExp(xa, -1), RuExp(w3, -1)]), RuExp(wn3, -1)]);
									pAnd3 = RuProofStep(s2id_("jca"), [pIn3, fw3.first], RuStmt(stcl, [mkImp(psi, andE3)], -1));
									inst3 = RuProofStep(s2id_("elunii"), [], RuStmt(stcl, [mkImp(andE3, RuExp(x, -1))], -1));
									RuProofStep(s2id_("syl"), [pAnd3, inst3], RuStmt(stcl, [psiX], -1));
								});
							}
						});
					};
					switch (a3) { Some(__): a3; None(): {
					// (a4) Kuratowski TARGET: goal A∈〈a,b〉 rewrites through vdfop
					// (〈a,b〉 = {{a},{a,b}}) + eleq2 and recurses
					a4 = if (depth <= 0 || tbh != s2id("cop") || length(xb) < 3) None() else {
						o4end = ruFwdSpan(xb, 1);
						oa4 = subrange(xb, 1, o4end - 1);
						ob4 = subrange(xb, o4end, length(xb) - o4end);
						if (length(oa4) != 2 || length(ob4) != 2) None() else {
							snE4 = ruFwdMkRule(s2id("csn"), ids.cls, [RuExp(oa4, -1)]);
							prIn4 = ruFwdMkRule(s2id("cpr"), ids.cls, [RuExp(oa4, -1), RuExp(ob4, -1)]);
							prE4 = ruFwdMkRule(s2id("cpr"), ids.cls, [snE4, prIn4]);
							dE4 = ruFwdMkRule(ids.wcel, ids.wff, [RuExp(xa, -1), prE4]);
							eqE4 = ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(xb, -1), prE4]);
							biE4 = ruFwdMkRule(ids.wb, ids.wff, [RuExp(x, -1), dE4]);
							pBi4 = RuProofStep(ids.axmp, [
								RuProofStep(s2id_("vdfop"), [], RuStmt(stcl, [eqE4], -1)),
								RuProofStep(s2id_("eleq2"), [], RuStmt(stcl, [mkImp(eqE4, biE4)], -1))],
								RuStmt(stcl, [biE4], -1));
							maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, dE4.nodes, stcl, depth - 1, path, memo, prover_env), \pd4 ->
								RuProofStep(s2id_("mpbird"), [pd4,
									RuProofStep(s2id_("a1i"), [pBi4], RuStmt(stcl, [mkImp(psi, biE4)], -1))],
									RuStmt(stcl, [psiX], -1)));
						}
					};
					switch (a4) { Some(__): a4; None(): {
					// (b) ⊆-transport: a pooled el-fact xa∈A with A ⊆ xb (ssel)
					viaSs = fold(facts.el, None(), \ac, f -> switch (ac) {
						Some(__): ac;
						None(): {
							fn = f.second;
							flend = ruFwdSpan(fn, 1);
							fEl = subrange(fn, 1, flend - 1);
							fT = subrange(fn, flend, length(fn) - flend);
							if (fEl != xa || fT == xb) None()
							else maybeMap(ruFwdSsClose(ids, facts, fT, xb, stcl, 8, Some(psi), prover_env), \pss -> {
								ssE = ruFwdMkRule(ids.wss, ids.wff, [RuExp(fT, -1), RuExp(xb, -1)]);
								impE = mkImp(RuExp(fn, -1), RuExp(x, -1));
								inst = RuProofStep(s2id_("ssel"), [], RuStmt(stcl, [mkImp(ssE, impE)], -1));
								pImp = RuProofStep(s2id_("syl"), [pss, inst], RuStmt(stcl, [mkImp(psi, impE)], -1));
								RuProofStep(s2id_("mpd"), [f.first, pImp], RuStmt(stcl, [psiX], -1));
							});
						}
					});
					switch (viaSs) { Some(__): viaSs; None(): {
					// (b2) x∈T from {x}⊆T (vsnss backward) — the ⊆-closure's via-fact
					// channel reaches memberships with no pooled el-fact (t8-class:
					// y∈{x} via {y} ⊆ {x}∪{y} ⊆ {x})
					viaSn = if (length(xa) != 2) None() else {
						snE = ruFwdMkRule(s2id("csn"), ids.cls, [RuExp(xa, -1)]);
						maybeMap(ruFwdSsClose(ids, facts, snE.nodes, xb, stcl, 8, Some(psi), prover_env), \pss -> {
							biE = ruFwdMkRule(ids.wb, ids.wff, [RuExp(x, -1),
								ruFwdMkRule(ids.wss, ids.wff, [snE, RuExp(xb, -1)])]);
							RuProofStep(s2id_("mpbird"), [pss,
								RuProofStep(s2id_("a1i"), [RuProofStep(s2id_("vsnss"), [], RuStmt(stcl, [biE], -1))],
									RuStmt(stcl, [mkImp(psi, biE)], -1))], RuStmt(stcl, [psiX], -1));
						});
					};
					switch (viaSn) { Some(__): viaSn; None(): {
					if (depth <= 0) None() else {
					// (c) ↔-transport: a pooled bi-fact with one side == x
					viaBi = fold(facts.bi, None(), \ac, f -> switch (ac) {
						Some(__): ac;
						None(): {
							fn = f.second;
							flend = ruFwdSpan(fn, 1);
							fl = subrange(fn, 1, flend - 1);
							fr = subrange(fn, flend, length(fn) - flend);
							if (fl == x) maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, fr, stcl, depth - 1, path, memo, prover_env),
								\pr -> RuProofStep(s2id_("mpbird"), [pr, f.first], RuStmt(stcl, [psiX], -1)))
							else if (fr == x) maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, fl, stcl, depth - 1, path, memo, prover_env),
								\pl -> RuProofStep(s2id_("mpbid"), [pl, f.first], RuStmt(stcl, [psiX], -1)))
							else None();
						}
					});
					switch (viaBi) { Some(__): viaBi; None(): {
					// (d) =-transport: an equality fact u=v moves the element (eleq1)
					viaEq = fold(facts.eqs, None(), \ac, f -> switch (ac) {
						Some(__): ac;
						None(): {
							fn = f.second;
							flend = ruFwdSpan(fn, 1);
							fu = subrange(fn, 1, flend - 1);
							fv = subrange(fn, flend, length(fn) - flend);
							biE = ruFwdMkRule(ids.wb, ids.wff, [
								ruFwdMkRule(ids.wcel, ids.wff, [RuExp(fu, -1), RuExp(xb, -1)]),
								ruFwdMkRule(ids.wcel, ids.wff, [RuExp(fv, -1), RuExp(xb, -1)])]);
							mkTrans = \other : [RuExpNode], useMpbid : bool ->
								maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi,
									(ruFwdMkRule(ids.wcel, ids.wff, [RuExp(other, -1), RuExp(xb, -1)])).nodes, stcl, depth - 1, path, memo, prover_env), \po -> {
									inst = RuProofStep(ids.eleq1, [], RuStmt(stcl, [mkImp(RuExp(fn, -1), biE)], -1));
									pBi = RuProofStep(s2id_("syl"), [f.first, inst], RuStmt(stcl, [mkImp(psi, biE)], -1));
									RuProofStep(if (useMpbid) s2id_("mpbid") else s2id_("mpbird"), [po, pBi], RuStmt(stcl, [psiX], -1));
								});
							// SET-side transport (eleq2): the equality moves the goal's SET —
							// close x∈other recursively, transport back (t93-class step 4:
							// x5∈x26 under the case-fact x26={x5} → x5∈{x5} by vsnid)
							mkTransSet = \other : [RuExpNode], useMpbid : bool -> {
								biE2 = ruFwdMkRule(ids.wb, ids.wff, [
									ruFwdMkRule(ids.wcel, ids.wff, [RuExp(xa, -1), RuExp(fu, -1)]),
									ruFwdMkRule(ids.wcel, ids.wff, [RuExp(xa, -1), RuExp(fv, -1)])]);
								maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi,
									(ruFwdMkRule(ids.wcel, ids.wff, [RuExp(xa, -1), RuExp(other, -1)])).nodes, stcl, depth - 1, path, memo, prover_env), \po -> {
									inst = RuProofStep(s2id_("eleq2"), [], RuStmt(stcl, [mkImp(RuExp(fn, -1), biE2)], -1));
									pBi = RuProofStep(s2id_("syl"), [f.first, inst], RuStmt(stcl, [mkImp(psi, biE2)], -1));
									RuProofStep(if (useMpbid) s2id_("mpbid") else s2id_("mpbird"), [po, pBi], RuStmt(stcl, [psiX], -1));
								});
							};
							if (fu == xa) mkTrans(fv, false)       // have v∈T, want u∈T: mpbird
							else if (fv == xa) mkTrans(fu, true)   // have u∈T, want v∈T: mpbid
							else if (fu == xb) mkTransSet(fv, false)      // goal x∈fu: close x∈fv, mpbird
							else if (fv == xb) mkTransSet(fu, true)       // goal x∈fv: close x∈fu, mpbid
							else None();
						}
					});
					switch (viaEq) { Some(__): viaEq; None(): {
					// (d2) PRODUCT TRANSPORT (t92-class): the goal SET xb is a FACTOR of a
					// pooled product equality/inclusion (A×B) = (C×D) / (A×B) ⊆ (C×D) —
					// ride an ordered pair through the fact: opelxpi intro on the U-side
					// (x plus a WITNESS w for the other factor; w = x first — the square
					// case — else a pooled el-fact of that factor), eleq2/ssel transport,
					// opelxp elim + simpld/simprd projection on the V-side.
					viaXp = {
						cxpId = s2id("cxp");
						mEl = \el : [RuExpNode], ts : [RuExpNode] -> ruFwdMkRule(ids.wcel, ids.wff, [RuExp(el, -1), RuExp(ts, -1)]);
						fnEq = \a2 : [RuExpNode], b2 : [RuExpNode] ->
							ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(a2, -1), RuExp(b2, -1)]);
						tryFact = \un : [RuExpNode], vn : [RuExpNode], pf : RuProofTree, isEq : bool -> {
							vh = switch (vn[0]) { RuVar(__,__): -1; RuRuleNode(iv, __): ruIdType2Id(iv); };
							uh = switch (un[0]) { RuVar(__,__): -1; RuRuleNode(iu, __): ruIdType2Id(iu); };
							if (vh != cxpId || uh != cxpId || length(vn) < 3 || length(un) < 3) None() else {
								vend = ruFwdSpan(vn, 1);
								vc = subrange(vn, 1, vend - 1);
								vd = subrange(vn, vend, length(vn) - vend);
								uend = ruFwdSpan(un, 1);
								ua = subrange(un, 1, uend - 1);
								ub = subrange(un, uend, length(un) - uend);
								frst = vc == xb;
								scnd = vd == xb;
								if (!frst && !scnd) None() else {
									needSet = if (frst) ua else ub;   // where x must live in U
									otherU  = if (frst) ub else ua;   // the witness's U-factor
									otherV  = if (frst) vd else vc;   // the witness's V-factor
									maybeBind(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi,
										(mEl(xa, needSet)).nodes, stcl, depth - 1, path, memo, prover_env), \px -> {
										// witness candidates: x itself, pooled el-facts w ∈ otherU
										// DIRECTLY, then every pooled ELEMENT w recursively — its
										// w∈otherU may itself need a transport (t110's x8∈x23
										// through the OTHER factor of the same product equality)
										wcands : [Pair<[RuExpNode], () -> Maybe<RuProofTree>>] = concatA([
											[Pair(xa, \ -> ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi,
												(mEl(xa, otherU)).nodes, stcl, depth - 1, path, memo, prover_env))],
											filtermap(facts.el, \f2 -> {
												f2n = f2.second;
												f2end = ruFwdSpan(f2n, 1);
												if (subrange(f2n, f2end, length(f2n) - f2end) == otherU)
													Some(Pair(subrange(f2n, 1, f2end - 1), \ -> Some(f2.first)))
												else None();
											}),
											// HEAVILY depth-damped (-4, the via-fact lesson): each
											// recursive witness attempt re-enters the whole channel
											// stack — undamped it starved the t105-t115 neighbors
											// (the 104→99 batch regression, alone-vs-batch). DEDUPED:
											// skip x itself and elements whose direct set==otherU —
											// both already tried above
											if (depth < 4) [] else filtermap(facts.el, \f2 -> {
												f2n = f2.second;
												w2 = subrange(f2n, 1, ruFwdSpan(f2n, 1) - 1);
												wset = subrange(f2n, ruFwdSpan(f2n, 1), length(f2n) - ruFwdSpan(f2n, 1));
												if (w2 == xa || wset == otherU) None()
												else Some(Pair(w2, \ -> ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi,
													(mEl(w2, otherU)).nodes, stcl, depth - 4, path, memo, prover_env)));
											})]);
										fold(wcands, None(), \acW, wc -> switch (acW) {
											Some(__): acW;
											None(): maybeMap(wc.second(), \pw -> {
												w = wc.first;
												pairE = ruFwdMkRule(s2id("cop"), ids.cls,
													if (frst) [RuExp(xa, -1), RuExp(w, -1)] else [RuExp(w, -1), RuExp(xa, -1)]);
												andU = if (frst) ruFwdMkRule(ids.wa, ids.wff, [mEl(xa, ua), mEl(w, ub)])
													else ruFwdMkRule(ids.wa, ids.wff, [mEl(w, ua), mEl(xa, ub)]);
												celU = ruFwdMkRule(ids.wcel, ids.wff, [pairE, RuExp(un, -1)]);
												celV = ruFwdMkRule(ids.wcel, ids.wff, [pairE, RuExp(vn, -1)]);
												pAnd = RuProofStep(s2id_("jca"), if (frst) [px, pw] else [pw, px],
													RuStmt(stcl, [mkImp(psi, andU)], -1));
												instI = RuProofStep(s2id_("opelxpi"), [],
													RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [andU, celU])], -1));
												pU = RuProofStep(s2id_("syl"), [pAnd, instI], RuStmt(stcl, [mkImp(psi, celU)], -1));
												pV = if (isEq) {
													biT = ruFwdMkRule(ids.wb, ids.wff, [celU, celV]);
													instT = RuProofStep(ids.eleq2, [],
														RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [fnEq(un, vn), biT])], -1));
													pBiT = RuProofStep(s2id_("syl"), [pf, instT], RuStmt(stcl, [mkImp(psi, biT)], -1));
													RuProofStep(s2id_("mpbid"), [pU, pBiT], RuStmt(stcl, [mkImp(psi, celV)], -1));
												} else {
													impT = ruFwdMkRule(ids.wi, ids.wff, [celU, celV]);
													instT = RuProofStep(s2id_("ssel"), [],
														RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff,
															[ruFwdMkRule(ids.wss, ids.wff, [RuExp(un, -1), RuExp(vn, -1)]), impT])], -1));
													pImpT = RuProofStep(s2id_("syl"), [pf, instT], RuStmt(stcl, [mkImp(psi, impT)], -1));
													RuProofStep(s2id_("mpd"), [pU, pImpT], RuStmt(stcl, [mkImp(psi, celV)], -1));
												};
												andV = if (frst) ruFwdMkRule(ids.wa, ids.wff, [mEl(xa, vc), mEl(w, vd)])
													else ruFwdMkRule(ids.wa, ids.wff, [mEl(w, vc), mEl(xa, vd)]);
												biV = ruFwdMkRule(ids.wb, ids.wff, [celV, andV]);
												instE = RuProofStep(s2id_("a1i"),
													[RuProofStep(s2id_("opelxp"), [], RuStmt(stcl, [biV], -1))],
													RuStmt(stcl, [mkImp(psi, biV)], -1));
												pAndV = RuProofStep(s2id_("mpbid"), [pV, instE], RuStmt(stcl, [mkImp(psi, andV)], -1));
												RuProofStep(if (frst) s2id_("simpld") else s2id_("simprd"), [pAndV],
													RuStmt(stcl, [psiX], -1));
											});
										});
									});
								}
							}
						};
						if (depth <= 0) None() else {
							overEqs = fold(facts.eqs, None(), \acF, f -> switch (acF) {
								Some(__): acF;
								None(): {
									fn2 = f.second;
									f2end = ruFwdSpan(fn2, 1);
									fu2 = subrange(fn2, 1, f2end - 1);
									fv2 = subrange(fn2, f2end, length(fn2) - f2end);
									// both orientations: U=V transports either way (flip via eqcomd)
									p1 = tryFact(fu2, fv2, f.first, true);
									switch (p1) { Some(__): p1; None():
										tryFact(fv2, fu2,
											RuProofStep(s2id_("eqcomd"), [f.first],
												RuStmt(stcl, [mkImp(psi, fnEq(fv2, fu2))], -1)), true); }
								}
							});
							switch (overEqs) { Some(__): overEqs; None():
								fold(facts.ss, None(), \acF2, f -> switch (acF2) {
									Some(__): acF2;
									None(): {
										fn3 = f.second;
										f3end = ruFwdSpan(fn3, 1);
										tryFact(subrange(fn3, 1, f3end - 1), subrange(fn3, f3end, length(fn3) - f3end), f.first, false);
									}
								}); }
						}
					};
					switch (viaXp) { Some(__): viaXp; None(): {
					// (e0) SELF-MEMBERSHIP: v ∈ {…v…} for a setvar argument of an
					// enumeration (vsnid / vprid1/2 / vtpid1/2/3 — 0-hyp aux instances)
					th0 = switch (xb[0]) { RuVar(__,__): -1; RuRuleNode(idTb0, __): ruIdType2Id(idTb0); };
					selfIx = if (length(xa) != 2) -1
						else if (th0 == s2id("csn") && length(xb) == 3 && subrange(xb, 1, 2) == xa) 0
						else if (th0 == s2id("cpr") && length(xb) == 5) {
							if (subrange(xb, 1, 2) == xa) 0 else if (subrange(xb, 3, 2) == xa) 1 else -1;
						}
						else if (th0 == s2id("ctp") && length(xb) == 7) {
							if (subrange(xb, 1, 2) == xa) 0 else if (subrange(xb, 3, 2) == xa) 1
							else if (subrange(xb, 5, 2) == xa) 2 else -1;
						}
						else -1;
					if (selfIx >= 0) {
						selfId = if (th0 == s2id("csn")) s2id_("vsnid")
							else if (th0 == s2id("cpr")) (if (selfIx == 0) s2id_("vprid1") else s2id_("vprid2"))
							else (if (selfIx == 0) s2id_("vtpid1") else if (selfIx == 1) s2id_("vtpid2") else s2id_("vtpid3"));
						Some(RuProofStep(s2id_("a1i"),
							[RuProofStep(selfId, [], RuStmt(stcl, [RuExp(x, -1)], -1))],
							RuStmt(stcl, [psiX], -1)));
					} else {
					// (e) definitional intro by the head of T
					th = switch (xb[0]) { RuVar(__,__): -1; RuRuleNode(idTb, __): ruIdType2Id(idTb); };
					mkEl = \cl : [RuExpNode] -> ruFwdMkRule(ids.wcel, ids.wff, [RuExp(xa, -1), RuExp(cl, -1)]);
					intro = \dE : RuExp, biId : int ->
						maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, dE.nodes, stcl, depth, path, memo, prover_env), \pd -> {
							biStep = RuProofStep(s2id_("a1i"),
								[RuProofStep(biId, [], RuStmt(stcl, [ruFwdMkRule(ids.wb, ids.wff, [RuExp(x, -1), dE])], -1))],
								RuStmt(stcl, [mkImp(psi, ruFwdMkRule(ids.wb, ids.wff, [RuExp(x, -1), dE]))], -1));
							RuProofStep(s2id_("mpbird"), [pd, biStep], RuStmt(stcl, [psiX], -1));
						});
					if (length(xb) >= 3 && (th == ids.cun || th == ids.cin || th == ids.cdif || th == s2id("csymdif"))) {
						tend = ruFwdSpan(xb, 1);
						tb = subrange(xb, 1, tend - 1);
						tc = subrange(xb, tend, length(xb) - tend);
						if (th == ids.cun) intro(ruFwdMkRule(ids.wo, ids.wff, [mkEl(tb), mkEl(tc)]), s2id_("elun"))
						else if (th == ids.cin) intro(ruFwdMkRule(ids.wa, ids.wff, [mkEl(tb), mkEl(tc)]), s2id_("elin"))
						else if (th == ids.cdif) intro(ruFwdMkRule(ids.wa, ids.wff, [mkEl(tb), ruFwdMkRule(ids.wn, ids.wff, [mkEl(tc)])]), s2id_("eldif"))
						else intro(ruFwdMkRule(ids.wn, ids.wff, [ruFwdMkRule(ids.wb, ids.wff, [mkEl(tb), mkEl(tc)])]), s2id_("elsymdif"));
					} else if (th == s2id("csn") && length(xa) == 2 && length(xb) >= 2) {
						sy = subrange(xb, 1, length(xb) - 1);
						intro(ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(xa, -1), RuExp(sy, -1)]), s2id_("velsn"));
					} else if (th == s2id("cpr") && length(xa) == 2 && length(xb) >= 3) {
						pend = ruFwdSpan(xb, 1);
						pa = subrange(xb, 1, pend - 1);
						pb = subrange(xb, pend, length(xb) - pend);
						intro(ruFwdMkRule(ids.wo, ids.wff, [
							ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(xa, -1), RuExp(pa, -1)]),
							ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(xa, -1), RuExp(pb, -1)])]), s2id_("velpr"));
					} else if (th == s2id("ctp") && length(xa) == 2 && length(xb) >= 4) {
						e1 = ruFwdSpan(xb, 1);
						e2 = ruFwdSpan(xb, e1);
						ta = subrange(xb, 1, e1 - 1);
						tb3 = subrange(xb, e1, e2 - e1);
						tc3 = subrange(xb, e2, length(xb) - e2);
						intro(ruFwdMkRule(ids.wo, ids.wff, [
							ruFwdMkRule(ids.wo, ids.wff, [
								ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(xa, -1), RuExp(ta, -1)]),
								ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(xa, -1), RuExp(tb3, -1)])]),
							ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(xa, -1), RuExp(tc3, -1)])]), s2id_("veltp"));
					} else if (th == s2id("cpw") && length(xa) == 2 && length(xb) >= 2) {
						pa = subrange(xb, 1, length(xb) - 1);
						intro(ruFwdMkRule(ids.wss, ids.wff, [RuExp(xa, -1), RuExp(pa, -1)]), s2id_("velpw"));
					} else if (th == s2id("cxp") && length(xb) >= 3 && (switch (xa[0]) {
							RuVar(__,__): false;
							RuRuleNode(idTo2, __): ruIdType2Id(idTo2) == s2id("cop");
						}) && length(xa) >= 3) {
						oend = ruFwdSpan(xa, 1);
						oa = subrange(xa, 1, oend - 1);
						ob = subrange(xa, oend, length(xa) - oend);
						cend = ruFwdSpan(xb, 1);
						tc1 = subrange(xb, 1, cend - 1);
						td1 = subrange(xb, cend, length(xb) - cend);
						intro(ruFwdMkRule(ids.wa, ids.wff, [
							ruFwdMkRule(ids.wcel, ids.wff, [RuExp(oa, -1), RuExp(tc1, -1)]),
							ruFwdMkRule(ids.wcel, ids.wff, [RuExp(ob, -1), RuExp(td1, -1)])]), s2id_("opelxp"));
					} else if (th == s2id("cuni") && length(xb) >= 2) {
						// (e2) ∪.-INTRO: x ∈ ∪.C from a pooled el-fact ψ→(x∈B) whose set is
						// itself a member — ψ→(B∈C) closed recursively — via elunii
						// (((A∈B) ∧ (B∈C)) → (A∈∪.C)), joined under the guard by jca+syl
						// (t93-class: x26 ∈ ∪.x16 from x26∈x24, x24∈x16)
						uc = subrange(xb, 1, length(xb) - 1);
						fold(facts.el, None(), \acU, f -> switch (acU) {
							Some(__): acU;
							None(): {
								fn = f.second;
								flend = ruFwdSpan(fn, 1);
								fEl = subrange(fn, 1, flend - 1);
								fB = subrange(fn, flend, length(fn) - flend);
								if (fEl != xa || fB == uc) None()
								else {
									bcE = ruFwdMkRule(ids.wcel, ids.wff, [RuExp(fB, -1), RuExp(uc, -1)]);
									maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, bcE.nodes, stcl, depth - 1, path, memo, prover_env), \pbc -> {
										andE = ruFwdMkRule(ids.wa, ids.wff, [RuExp(fn, -1), bcE]);
										pAnd = RuProofStep(s2id_("jca"), [f.first, pbc], RuStmt(stcl, [mkImp(psi, andE)], -1));
										inst = RuProofStep(s2id_("elunii"), [], RuStmt(stcl, [mkImp(andE, RuExp(x, -1))], -1));
										RuProofStep(s2id_("syl"), [pAnd, inst], RuStmt(stcl, [psiX], -1));
									});
								}
							}
						});
					} else {
						// (e3) NORMALIZE-TRANSPORT: goal x∈T and a pooled el-fact x∈S whose
						// sets share an eq-normal form — assemble S=T from the two
						// normalization proofs (eqtri/eqcomi) and transport by eleq2
						// (t113-class: x∈((A∩B)×(C∩D)) from x∈((A×C)∩(B×D)) via inxp,
						// which is already in the eq-rule scope)
						e3 = if (length(xb) < 3) None() else {
							nT = ruFwdNormalize(ids, eids, rules, xb, stcl, prover_env.math, prover_env.env);
							fold(facts.el, None(), \acN3, f -> switch (acN3) {
								Some(__): acN3;
								None(): {
									fn = f.second;
									flend = ruFwdSpan(fn, 1);
									fEl = subrange(fn, 1, flend - 1);
									fB = subrange(fn, flend, length(fn) - flend);
									if (fEl != xa || fB == xb) None()
									else {
										nS = ruFwdNormalize(ids, eids, rules, fB, stcl, prover_env.math, prover_env.env);
										if (nS.first != nT.first) None()
										else {
											eqE = ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(fB, -1), RuExp(xb, -1)]);
											mEq = switch (nS.second) {
												None(): switch (nT.second) {
													None(): None();
													Some(pt): Some(RuProofStep(eids.eqcomi, [pt], RuStmt(stcl, [eqE], -1)));
												}
												Some(ps): switch (nT.second) {
													None(): Some(ps);
													Some(pt): Some(RuProofStep(eids.eqtri, [ps,
														RuProofStep(eids.eqcomi, [pt], RuStmt(stcl, [ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(nT.first, -1), RuExp(xb, -1)])], -1))],
														RuStmt(stcl, [eqE], -1)));
												}
											};
											maybeMap(mEq, \pEq -> {
												biE3 = ruFwdMkRule(ids.wb, ids.wff, [RuExp(fn, -1), RuExp(x, -1)]);
												pBi3 = RuProofStep(ids.axmp, [pEq,
													RuProofStep(s2id_("eleq2"), [], RuStmt(stcl, [mkImp(eqE, biE3)], -1))],
													RuStmt(stcl, [biE3], -1));
												RuProofStep(s2id_("mpbid"), [f.first,
													RuProofStep(s2id_("a1i"), [pBi3], RuStmt(stcl, [mkImp(psi, biE3)], -1))],
													RuStmt(stcl, [psiX], -1));
											});
										}
									}
								}
							});
						};
						switch (e3) { Some(__): e3; None(): {
						// (f) ∨-ELIM by jaod: a pooled case-split fact whose disjuncts are
						// EQUALITIES pinning the goal's SET (S=A ∨ S=B, the velpr/vdfop
						// cascade shape) or its ELEMENT (x=a ∨ x=b) — close the goal under
						// each branch's transported form (eleq2/eleq1 + biimprd + com12),
						// assemble ψ→((a∨b)→G) by jaod, discharge with the ∨-fact by mpd
						// (t93-class step 4: x5∈x26 under (x26={x5}) ∨ (x26={x5,x8}))
						viaOrEq = if (depth <= 0) None() else
						fold(facts.ors, None(), \acO, orf -> switch (acO) {
							Some(__): acO;
							None(): {
								on = orf.second;
								olend = ruFwdSpan(on, 1);
								oa = subrange(on, 1, olend - 1);
								ob = subrange(on, olend, length(on) - olend);
								parseEq = \d : [RuExpNode] -> {
									eqOk = length(d) >= 3 && switch (d[0]) {
										RuVar(__,__): false;
										RuRuleNode(idTd, __): ruIdType2Id(idTd) == s2id("wceq");
									};
									if (!eqOk) None() else {
										dend = ruFwdSpan(d, 1);
										Some(Pair(subrange(d, 1, dend - 1), subrange(d, dend, length(d) - dend)));
									}
								};
								maybeBind(parseEq(oa), \ea -> maybeBind(parseEq(ob), \eb -> {
									mkBranch = \dq : [RuExpNode], bGoal : RuExp, biLem : int, biE : RuExp ->
										maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, bGoal.nodes, stcl, depth - 1, path, memo, prover_env), \pg -> {
											inst = RuProofStep(biLem, [], RuStmt(stcl, [mkImp(RuExp(dq, -1), biE)], -1));
											pImp = RuProofStep(s2id_("biimprd"), [inst], RuStmt(stcl, [mkImp(RuExp(dq, -1), mkImp(bGoal, RuExp(x, -1)))], -1));
											pCom = RuProofStep(s2id_("com12"), [pImp], RuStmt(stcl, [mkImp(bGoal, mkImp(RuExp(dq, -1), RuExp(x, -1)))], -1));
											RuProofStep(s2id_("syl"), [pg, pCom], RuStmt(stcl, [mkImp(psi, mkImp(RuExp(dq, -1), RuExp(x, -1)))], -1));
										});
									branch = \e : Pair<[RuExpNode],[RuExpNode]>, dq : [RuExpNode] ->
										if (e.first == xb) {
											bGoal = ruFwdMkRule(ids.wcel, ids.wff, [RuExp(xa, -1), RuExp(e.second, -1)]);
											mkBranch(dq, bGoal, s2id_("eleq2"), ruFwdMkRule(ids.wb, ids.wff, [RuExp(x, -1), bGoal]));
										} else if (e.first == xa) {
											bGoal = ruFwdMkRule(ids.wcel, ids.wff, [RuExp(e.second, -1), RuExp(xb, -1)]);
											mkBranch(dq, bGoal, s2id_("eleq1"), ruFwdMkRule(ids.wb, ids.wff, [RuExp(x, -1), bGoal]));
										} else None();
									maybeBind(branch(ea, oa), \p1 ->
										maybeMap(branch(eb, ob), \p2 -> {
											pJ = RuProofStep(s2id_("jaod"), [p1, p2], RuStmt(stcl, [mkImp(psi, mkImp(RuExp(on, -1), RuExp(x, -1)))], -1));
											RuProofStep(s2id_("mpd"), [orf.first, pJ], RuStmt(stcl, [psiX], -1));
										}));
								}));
							}
						});
						switch (viaOrEq) { Some(__): viaOrEq; None(): {
						// (f2) hoisted to ruFwdOrElimClose — shared with the ⊆-target branch
						ruFwdOrElimClose(ids, eids, rules, asses, facts, bareFacts, psi, x, stcl, depth, path0, memo, prover_env);
						}}
						}}
					}
					}
					}}
					}}
					}
					}}
					}}
					}}
					}}
					}}}}}}
				} else if (hid == wpss) {
					// THE TABLE APPLIER on the ⊊-family (P3, family 3): psssstr/sspsstr as
					// imp-and entries (∧-antecedent by pool completion + jca), dfpss2 as a
					// bicond entry (subgoal (⊆ ∧ ¬=) via the ∧-split, mpbird back) — wpss is
					// the first head admitted to ruTcExtendedHeads. Channel FIRST (its fast
					// path fed t22's slice; table-first swapped t22 for t98), table as the
					// fallback — it still captures what the channel misses (t98), and the
					// channel + its neg-FLIP block get deleted once the flip is generic.
					pt = ruFwdPssClose(ids, facts, xa, xb, stcl, Some(psi), prover_env);
					switch (pt) { Some(__): pt; None(): {
					tpt = ruTableClose(ruFwdTcPool(ids, facts), psi, x, stcl, depth,
						\xT, dT -> ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, xT, stcl, dT, path, memo, prover_env),
						prover_env);
					switch (tpt) { Some(__): tpt; None(): {
						// dfpss2-INTRO: ψ→(a⊆b) + a pooled ψ→¬(a=b) (either orientation,
						// flipped through eqcom/con3i) give ψ→(a⊊b)
						eqE = ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(xa, -1), RuExp(xb, -1)]);
						eqFl = ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(xb, -1), RuExp(xa, -1)]);
						neE = ruFwdMkRule(ids.wn, ids.wff, [eqE]);
						mNe = fold(facts.neg, None(), \ac, f -> switch (ac) {
							Some(__): ac;
							None():
								if (f.second == eqE.nodes) Some(f.first)
								else if (f.second == eqFl.nodes) {
									biE = ruFwdMkRule(ids.wb, ids.wff, [eqE, eqFl]);
									imE = ruFwdMkRule(ids.wi, ids.wff, [eqE, eqFl]);
									cnE = ruFwdMkRule(ids.wi, ids.wff, [ruFwdMkRule(ids.wn, ids.wff, [eqFl]), neE]);
									pIm = RuProofStep(s2id_("biimpi"),
										[RuProofStep(s2id_("eqcom"), [], RuStmt(stcl, [biE], -1))],
										RuStmt(stcl, [imE], -1));
									pCn = RuProofStep(s2id_("con3i"), [pIm], RuStmt(stcl, [cnE], -1));
									Some(RuProofStep(s2id_("syl"), [f.first, pCn], RuStmt(stcl, [mkImp(psi, neE)], -1)));
								}
								else None();
						});
						maybeBind(mNe, \pn ->
							maybeMap(ruFwdSsClose(ids, facts, xa, xb, stcl, 8, Some(psi), prover_env), \ps -> {
								ssE = ruFwdMkRule(ids.wss, ids.wff, [RuExp(xa, -1), RuExp(xb, -1)]);
								rhsE = ruFwdMkRule(ids.wa, ids.wff, [ssE, neE]);
								pAnd = RuProofStep(s2id_("jca"), [ps, pn], RuStmt(stcl, [mkImp(psi, rhsE)], -1));
								bi = ruFwdMkRule(ids.wb, ids.wff, [RuExp(x, -1), rhsE]);
								biStep = RuProofStep(s2id_("a1i"),
									[RuProofStep(s2id_("dfpss2"), [], RuStmt(stcl, [bi], -1))],
									RuStmt(stcl, [mkImp(psi, bi)], -1));
								RuProofStep(s2id_("mpbird"), [pAnd, biStep], RuStmt(stcl, [psiX], -1));
							}));
					}}
					}}
				} else if (hid == s2id("wceq")) {
					if (xa == xb) Some(RuProofStep(s2id_("eqidd"), [], RuStmt(stcl, [psiX], -1))) else {
					if (prover_env.env.conf.verbose >= 6) {
						prover_env.env.out.println("      wceq case: target=" + ruSafeExp2s(RuExp(x, -1), prover_env.math.decls.lang)
							+ " eqs=[" + strGlue(map(facts.eqs, \ff -> ruSafeExp2s(RuExp(ff.second, -1), prover_env.math.decls.lang)), " | ") + "]");
					} else {};
					e0 = if (xb == empty) ruFwdEq0Close(ids, eids, rules, facts, psi, xa, stcl, prover_env)
						else if (xa == empty) maybeMap(ruFwdEq0Close(ids, eids, rules, facts, psi, xb, stcl, prover_env), \p ->
							RuProofStep(s2id_("eqcomd"), [p], RuStmt(stcl, [psiX], -1)))
						else None();
					switch (e0) { Some(__): e0; None(): {
						// pooled equality fact (either orientation)
						flipN = (ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(xb, -1), RuExp(xa, -1)])).nodes;
						direct = fold(facts.eqs, None(), \ac, f -> switch (ac) {
							Some(__): ac;
							None():
								if (f.second == x) Some(f.first)
								else if (f.second == flipN) Some(RuProofStep(s2id_("eqcomd"), [f.first], RuStmt(stcl, [psiX], -1)))
								else None();
						});
						switch (direct) { Some(__): direct; None(): {
						// (f) TRANSITIVITY over the eqs pool: a=b from a=m (either
						// orientation) and a recursive m=b (t5_zfmisc_1: x9=x10 from
						// the derived x9=x5, x10=x5)
						trans = if (depth <= 0) None() else fold(facts.eqs, None(), \acT, f -> switch (acT) {
							Some(__): acT;
							None(): {
								fn = f.second;
								flend = ruFwdSpan(fn, 1);
								fu = subrange(fn, 1, flend - 1);
								fv = subrange(fn, flend, length(fn) - flend);
								mkTr = \pAm : RuProofTree, m : [RuExpNode] ->
									maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi,
										(ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(m, -1), RuExp(xb, -1)])).nodes, stcl, depth - 1, path, memo, prover_env), \pmb ->
										RuProofStep(s2id_("eqtrd"), [pAm, pmb], RuStmt(stcl, [psiX], -1)));
								if (fu == xa && fv != xb) mkTr(f.first, fv)
								else if (fv == xa && fu != xb) mkTr(
									RuProofStep(s2id_("eqcomd"), [f.first],
										RuStmt(stcl, [mkImp(psi, ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(xa, -1), RuExp(fu, -1)]))], -1)), fu)
								else None();
							}
						});
						switch (trans) { Some(__): trans; None(): {
						// (g) ELEMENT equality via singleton membership: x=y from x∈{y}
						// or y∈{x} (velsn extraction) when both sides are setvar slices
						csn0 = s2id("csn");
						extr = if (depth <= 0 || length(xa) != 2 || length(xb) != 2) None() else {
							snYE = ruFwdMkRule(csn0, ids.cls, [RuExp(xb, -1)]);
							e1 = maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi,
								(ruFwdMkRule(ids.wcel, ids.wff, [RuExp(xa, -1), snYE])).nodes, stcl, depth - 1, path, memo, prover_env), \pe -> {
								biE = ruFwdMkRule(ids.wb, ids.wff, [ruFwdMkRule(ids.wcel, ids.wff, [RuExp(xa, -1), snYE]), RuExp(x, -1)]);
								RuProofStep(s2id_("mpbid"), [pe,
									RuProofStep(s2id_("a1i"), [RuProofStep(s2id_("velsn"), [], RuStmt(stcl, [biE], -1))],
										RuStmt(stcl, [mkImp(psi, biE)], -1))], RuStmt(stcl, [psiX], -1));
							});
							switch (e1) { Some(__): e1; None(): {
								snXE = ruFwdMkRule(csn0, ids.cls, [RuExp(xa, -1)]);
								flipE = ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(xb, -1), RuExp(xa, -1)]);
								maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi,
									(ruFwdMkRule(ids.wcel, ids.wff, [RuExp(xb, -1), snXE])).nodes, stcl, depth - 1, path, memo, prover_env), \pe -> {
									biE = ruFwdMkRule(ids.wb, ids.wff, [ruFwdMkRule(ids.wcel, ids.wff, [RuExp(xb, -1), snXE]), flipE]);
									pFl = RuProofStep(s2id_("mpbid"), [pe,
										RuProofStep(s2id_("a1i"), [RuProofStep(s2id_("velsn"), [], RuStmt(stcl, [biE], -1))],
											RuStmt(stcl, [mkImp(psi, biE)], -1))], RuStmt(stcl, [mkImp(psi, flipE)], -1));
									RuProofStep(s2id_("eqcomd"), [pFl], RuStmt(stcl, [psiX], -1));
								});
							}}
						};
						switch (extr) { Some(__): extr; None(): {
						// antisymmetry through the FULL literal prover (litClose-wss has
						// the enumeration channels ssClose lacks — t21_zfmisc_1)
						anti = if (depth <= 0) None() else
							maybeBind(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi,
								(ruFwdMkRule(ids.wss, ids.wff, [RuExp(xa, -1), RuExp(xb, -1)])).nodes, stcl, depth - 1, path, memo, prover_env), \p1 ->
								maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi,
									(ruFwdMkRule(ids.wss, ids.wff, [RuExp(xb, -1), RuExp(xa, -1)])).nodes, stcl, depth - 1, path, memo, prover_env), \p2 ->
									RuProofStep(s2id_("eqssd"), [p1, p2], RuStmt(stcl, [psiX], -1))));
						switch (anti) { Some(__): anti; None(): {
						// P3 NOTE (family-2 attempt REVERTED): replacing this SsClose-legged
						// retry with the table cost zfmisc −7 — the site sits in the hot loop
						// of every equality literal, and on FAILING goals the table's
						// eqtri-chaining re-enters the closer per pooled equality. This retry
						// goes away when the NF-eq/eqs family switches with real cost control.
						eqc = ruFwdEqClose(ids, facts, xa, xb, stcl, Some(psi), prover_env);
						switch (eqc) { Some(__): eqc; None():
							// (h) neg-∧ unit resolution over the clause pool
							fold(facts.neg, None(), \acRz, nfz -> switch (acRz) {
								Some(__): acRz;
								None(): ruFwdNegAndResolve(ids, eids, rules, asses, facts, bareFacts, psi, x, nfz.first, nfz.second, stcl, depth, path, memo, prover_env);
							});
						}
						}}
						}}
						}}
						}}
					}}
					}
				} else if (hid == ids.wss) {
					// (a0) an ENUMERATION on the left: {v}⊆B / {u,v}⊆B / {u,v,w}⊆B
					// close from the member els (vsnss/vprss/vtpss backward)
					lh = switch (xa[0]) { RuVar(__,__): -1; RuRuleNode(idTe, __): ruIdType2Id(idTe); };
					mkElOf = \v : [RuExpNode] -> ruFwdMkRule(ids.wcel, ids.wff, [RuExp(v, -1), RuExp(xb, -1)]);
					enumSs = \dE : RuExp, biId : int ->
						maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, dE.nodes, stcl, depth, path, memo, prover_env), \pd ->
							RuProofStep(s2id_("mpbid"), [pd,
								RuProofStep(s2id_("a1i"),
									[RuProofStep(biId, [], RuStmt(stcl, [ruFwdMkRule(ids.wb, ids.wff, [dE, RuExp(x, -1)])], -1))],
									RuStmt(stcl, [mkImp(psi, ruFwdMkRule(ids.wb, ids.wff, [dE, RuExp(x, -1)]))], -1))],
								RuStmt(stcl, [psiX], -1)));
					a0 = if (lh == s2id("csn") && length(xa) == 3)
							enumSs(mkElOf(subrange(xa, 1, 2)), s2id_("vsnss"))
						else if (lh == s2id("cpr") && length(xa) == 5)
							enumSs(ruFwdMkRule(ids.wa, ids.wff, [mkElOf(subrange(xa, 1, 2)), mkElOf(subrange(xa, 3, 2))]), s2id_("vprss"))
						else if (lh == s2id("ctp") && length(xa) == 7)
							enumSs(ruFwdMkRule(ids.wa, ids.wff, [
								ruFwdMkRule(ids.wa, ids.wff, [mkElOf(subrange(xa, 1, 2)), mkElOf(subrange(xa, 3, 2))]),
								mkElOf(subrange(xa, 5, 2))]), s2id_("vtpss"))
						else None();
					switch (a0) { Some(__): a0; None(): {
					// (a1) eqs-TRANSPORT: a pooled ψ→(a=E) (either orientation) turns
					// the goal a⊆b into E⊆b (eqsstrd) — the ∨-elim branch guards
					// x24=E feed the enumeration channels this way (t118-class)
					a1 = if (depth <= 0) None() else fold(facts.eqs, None(), \acE1, fe1 -> switch (acE1) {
						Some(__): acE1;
						None(): {
							en1 = fe1.second;
							e1end = ruFwdSpan(en1, 1);
							eu1 = subrange(en1, 1, e1end - 1);
							ev1 = subrange(en1, e1end, length(en1) - e1end);
							tryVia = \pEq : RuProofTree, eE : [RuExpNode] ->
								if (eE == xa) None() // a = a, no progress
								else maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi,
									(ruFwdMkRule(ids.wss, ids.wff, [RuExp(eE, -1), RuExp(xb, -1)])).nodes, stcl, depth - 1, path, memo, prover_env), \pSs1 ->
									RuProofStep(s2id_("eqsstrd"), [pEq, pSs1], RuStmt(stcl, [psiX], -1)));
							if (eu1 == xa) tryVia(fe1.first, ev1)
							else if (ev1 == xa) tryVia(
								RuProofStep(s2id_("eqcomd"), [fe1.first], RuStmt(stcl,
									[mkImp(psi, ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(xa, -1), RuExp(eu1, -1)]))], -1)), eu1)
							else None();
						}
					});
					switch (a1) { Some(__): a1; None():
					// (a) THE TABLE APPLIER instead of the hand-written ⊆-closure (P3 of the
					// rule-table plan, family 1): refl/shrink/grow/trans/intro over ⊆ are
					// applied from the scanned table (sstri→sstrd etc.), via-fact chaining
					// through the pool, subgoals re-entering the full closer. ruFwdSsClose
					// remains only for its internal callers until their families switch.
					switch (ruTableClose(ruFwdTcPool(ids, facts), psi, x, stcl, depth,
						\xT, dT -> ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, xT, stcl, dT, path, memo, prover_env),
						prover_env)) {
						Some(pd): Some(pd);
						None(): switch (ruFwdRelClose(ids, eids, rules, asses, bareFacts, x, stcl, prover_env)) {
							// (b) a ring tautology / closes on the task premises alone
							Some(pb): Some(RuProofStep(s2id_("a1i"), [pb], RuStmt(stcl, [psiX], -1)));
							None(): {
								// (c) ssdif0 in deduction form: nf(X∖Y) bare, the residue
								// discharged under the guard, transported back by mpbird
								diff = ruFwdMkRule(ids.cdif, ids.cls, [RuExp(xa, -1), RuExp(xb, -1)]);
								nd = ruFwdNormalize(ids, eids, rules, diff.nodes, stcl, prover_env.math, prover_env.env);
								eq0 = ruFwdMkRule(s2id("wceq"), ids.wff, [diff, RuExp(empty, -1)]);
								mEq0 = if (nd.first == empty) maybeMap(nd.second, \pd ->
									RuProofStep(s2id_("a1i"), [pd], RuStmt(stcl, [mkImp(psi, eq0)], -1)))
								else maybeMap(ruFwdResidue0(ids, eids, facts, nd.first, stcl, Some(psi), prover_env), \p0 ->
									switch (nd.second) {
										None(): p0; // X∖Y == the residue syntactically
										Some(pd): RuProofStep(s2id_("eqtrd"), [
											RuProofStep(s2id_("a1i"), [pd], RuStmt(stcl,
												[mkImp(psi, ruFwdMkRule(s2id("wceq"), ids.wff, [diff, RuExp(nd.first, -1)]))], -1)),
											p0], RuStmt(stcl, [mkImp(psi, eq0)], -1));
									});
								cSs = maybeMap(mEq0, \pd0 -> {
									bi = ruFwdMkRule(ids.wb, ids.wff, [RuExp(x, -1), eq0]);
									ssd = RuProofStep(s2id_("a1i"),
										[RuProofStep(s2id_("ssdif0"), [], RuStmt(stcl, [bi], -1))],
										RuStmt(stcl, [mkImp(psi, bi)], -1));
									RuProofStep(s2id_("mpbird"), [pd0, ssd], RuStmt(stcl, [psiX], -1));
								});
								switch (cSs) { Some(__): cSs; None():
									// (f2) fallback: case-split the ⊆-goal on a pooled ∨-fact
									// (t118-class: the disguised 8-way enumeration ∨)
									ruFwdOrElimClose(ids, eids, rules, asses, facts, bareFacts, psi, x, stcl, depth, path0, memo, prover_env);
								}
							}
						}
					}
					}
					}}
				} else None();
			}
		}
	}
	}
}

// (f2) GENERAL ∨-ELIM under GUARD EXTENSION as a SHARED closer (hoisted from
// the ∈-target branch of litClose; also the last fallback of the ⊆-target
// branch — t118-class disguised n-way ∨ arrives on a ⊆-goal). Depth −1 per
// split, gate <2: the used ∨-fact is CONSUMED and the ianor children are
// well-founded, the timer guard bounds the budget — an 8-way ∨ needs 7 splits.
ruFwdOrElimClose(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], asses : RuIndex<RuAssertion>,
	facts : RuFwdClsFacts, bareFacts : RuFwdClsFacts, psi : RuExp, x : [RuExpNode], stcl : int, depth : int, path0 : [[RuExpNode]], memo : ref Tree<Pair<[RuExpNode], Pair<[RuExpNode], int>>, Maybe<RuProofTree>>, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	mkImp = \e1, e2 -> ruFwdMkRule(ids.wi, ids.wff, [e1, e2]);
	empty = [ruMakeRuleNode(s2id("c0"), ids.cls, 0, 0)];
	psiX = mkImp(psi, RuExp(x, -1));
	if (prover_env.env.conf.verbose >= 6) {
		prover_env.env.out.println("    orElim d=" + i2s(depth) + " ors=[" + strGlue(map(facts.ors, \ff -> ruSafeExp2s(RuExp(ff.second, -1), prover_env.math.decls.lang)), " | ") + "]");
	} else {};
	// (f2) GENERAL ∨-ELIM under GUARD EXTENSION: for a pooled case-split
	// fact ψ→(a∨b) with ARBITRARY disjuncts, close the goal under each
	// branch guard ψ∧d — every pooled fact ψ→X weakens to (ψ∧d)→X by
	// adantr (bodies unchanged, so pool classification carries over),
	// the disjunct itself joins by simpr and is classified in, and the
	// used ∨-fact is CONSUMED (no re-splitting; nested splits ride the
	// remaining ors at depth-2). The same goal is legitimately re-proved
	// under the stronger guard, so the recursion passes path0 (without
	// this goal). Reassembled by ex + jaod, discharged by mpd
	// (t94-class: x5∈x21 under a ∨ of product ⊆-facts, each branch
	// closing by the (d2) product transport).
	if (depth < 1) None() else
	foldi(facts.ors, None(), \i2, acO2, orf2 -> switch (acO2) {
		Some(__): acO2;
		None(): {
			on2 = orf2.second;
			o2lend = ruFwdSpan(on2, 1);
			oa2 = subrange(on2, 1, o2lend - 1);
			ob2 = subrange(on2, o2lend, length(on2) - o2lend);
			// CANONICAL PIVOT ORDER: a branch inherits only the ∨-facts AFTER this one.
			// Case-splitting is commutative, so every SET of splits stays reachable (taken
			// in index order); only the n! PERMUTATIONS of the same set are pruned.
			others = subrange(facts.ors, i2 + 1, length(facts.ors) - i2 - 1);
			mkBranch2 = \dq : [RuExpNode] -> {
				psi2 = ruFwdMkRule(ids.wa, ids.wff, [psi, RuExp(dq, -1)]);
				wk = \p : Pair<RuProofTree, [RuExpNode]>, bodyE : RuExp ->
					Pair(RuProofStep(s2id_("adantr"), [p.first], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [psi2, bodyE])], -1)), p.second);
				wkW = \p : Pair<RuProofTree, [RuExpNode]> -> wk(p, RuExp(p.second, -1));
				wkFacts = RuFwdClsFacts(
					map(facts.ss, wkW), map(facts.pss, wkW),
					map(facts.eq0, \p -> wk(p, ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(p.second, -1), RuExp(empty, -1)]))),
					map(others, wkW), map(facts.el, wkW), map(facts.bi, wkW), map(facts.eqs, wkW),
					map(facts.neg, \p -> wk(p, ruFwdMkRule(ids.wn, ids.wff, [RuExp(p.second, -1)]))));
				pD = RuProofStep(s2id_("simpr"), [], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [psi2, RuExp(dq, -1)])], -1));
				branchFacts = ruFwdClassifyFact(ids, Pair(pD, dq), stcl, Some(psi2), wkFacts, 4);
				maybeMap(ruFwdLitClose(ids, eids, rules, asses, branchFacts, bareFacts, psi2, x, stcl, depth - 1, path0, memo, prover_env), \pg ->
					RuProofStep(s2id_("ex"), [pg], RuStmt(stcl, [mkImp(psi, mkImp(RuExp(dq, -1), RuExp(x, -1)))], -1)));
			};
			maybeBind(mkBranch2(oa2), \pa2 ->
				maybeMap(mkBranch2(ob2), \pb2 -> {
					pJ2 = RuProofStep(s2id_("jaod"), [pa2, pb2], RuStmt(stcl, [mkImp(psi, mkImp(RuExp(on2, -1), RuExp(x, -1)))], -1));
					RuProofStep(s2id_("mpd"), [orf2.first, pJ2], RuStmt(stcl, [psiX], -1));
				}));
		}
	});
}

// (h) NEG-∧ UNIT RESOLUTION (the Mizar clause firing): a pooled clause fact
// ψ→¬(c1∧(c2∧…∧¬x)) whose every ci closes recursively discharges to ψ→x —
// sylibr(imnan) turns ψ→¬(c∧R) into ψ→(c→¬R), mpd peels c, the terminal
// ψ→¬¬x strips by notnotrd (t130-132: the spcv-instantiated d10 trivial rule
// ¬((a∈X)∧((b∈X)∧¬(a=b))) resolves against the pooled memberships).
ruFwdNegAndResolve(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], asses : RuIndex<RuAssertion>,
	facts : RuFwdClsFacts, bareFacts : RuFwdClsFacts, psi : RuExp, x : [RuExpNode], pCur : RuProofTree, rN : [RuExpNode], stcl : int, depth : int, path : [[RuExpNode]], memo : ref Tree<Pair<[RuExpNode], Pair<[RuExpNode], int>>, Maybe<RuProofTree>>, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	// pCur proves ψ→¬R (R = rN); terminal R == ¬x
	mkImp = \e1, e2 -> ruFwdMkRule(ids.wi, ids.wff, [e1, e2]);
	negX = ruFwdMkRule(ids.wn, ids.wff, [RuExp(x, -1)]);
	if (prover_env.env.conf.verbose >= 6) {
		prover_env.env.out.println("      reso d=" + i2s(depth) + " R=" + ruSafeExp2s(RuExp(rN, -1), prover_env.math.decls.lang)
			+ " x=" + ruSafeExp2s(RuExp(x, -1), prover_env.math.decls.lang));
	} else {};
	if (rN == negX.nodes) {
		Some(RuProofStep(s2id_("notnotrd"), [pCur], RuStmt(stcl, [mkImp(psi, RuExp(x, -1))], -1)));
	} else {
		isAnd = length(rN) >= 3 && switch (rN[0]) {
			RuVar(__,__): false;
			RuRuleNode(idTr, __): ruIdType2Id(idTr) == ids.wa;
		};
		if (!isAnd || depth <= 0) None() else {
			cend = ruFwdSpan(rN, 1);
			c = subrange(rN, 1, cend - 1);
			r2 = subrange(rN, cend, length(rN) - cend);
			nr2 = ruFwdMkRule(ids.wn, ids.wff, [RuExp(r2, -1)]);
			imnanInst = RuProofStep(s2id_("imnan"), [],
				RuStmt(stcl, [ruFwdMkRule(ids.wb, ids.wff, [mkImp(RuExp(c, -1), nr2),
					ruFwdMkRule(ids.wn, ids.wff, [RuExp(rN, -1)])])], -1));
			pPeel = RuProofStep(s2id_("sylibr"), [pCur, imnanInst],
				RuStmt(stcl, [mkImp(psi, mkImp(RuExp(c, -1), nr2))], -1));
			maybeBind(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, c, stcl, depth - 1, path, memo, prover_env), \pc ->
				ruFwdNegAndResolve(ids, eids, rules, asses, facts, bareFacts, psi, x,
					RuProofStep(s2id_("mpd"), [pc, pPeel], RuStmt(stcl, [mkImp(psi, nr2)], -1)),
					r2, stcl, depth - 1, path, memo, prover_env));
		}
	}
}

// A CLAUSE-SHAPED GOAL, closed deterministically: ¬ψ (ψ an ∧-tree of literals
// with at least one refutable one) by pm2.65i of ψ→X against the ψ→¬X
// projection; an ∧ of clauses recurses per conjunct (pm3.2i). t97-class
// (⊆-arithmetic), t57/t62/t105 (⊊-unfolds + antisymmetry), t66/t70/t77-class
// (disjointness) all land here.
ruFwdClauseClose(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], asses : RuIndex<RuAssertion>,
	bareFacts : RuFwdClsFacts, premLeaves : [Pair<RuProofTree, [RuExpNode]>], body : [RuExpNode], stcl : int, depth : int, path0 : [[RuExpNode]], memo : ref Tree<Pair<[RuExpNode], Pair<[RuExpNode], int>>, Maybe<RuProofTree>>, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	if (contains(path0, body) || ruTimeIsOver(prover_env.conf.timer)) None() else {
	path = arrayPush(path0, body);
	if (prover_env.env.conf.verbose >= 5) {
		prover_env.env.out.println("  clauseClose depth=" + i2s(depth) + ": "
			+ ruSafeExp2s(RuExp(body, -1), prover_env.math.decls.lang));
	} else {};
	switch (body[0]) {
		RuVar(__,__): None();
		RuRuleNode(idT, __): {
			hid = ruIdType2Id(idT);
			if (hid == ids.wa && length(body) >= 3) {
				lend = ruFwdSpan(body, 1);
				l = subrange(body, 1, lend - 1);
				r = subrange(body, lend, length(body) - lend);
				maybeBind(ruFwdClauseClose(ids, eids, rules, asses, bareFacts, premLeaves, l, stcl, depth, path, memo, prover_env), \pl ->
					maybeMap(ruFwdClauseClose(ids, eids, rules, asses, bareFacts, premLeaves, r, stcl, depth, path, memo, prover_env), \pr ->
						RuProofStep(s2id_("pm3.2i"), [pl, pr], RuStmt(stcl, [RuExp(body, -1)], -1))));
			} else if (hid == ids.wi && length(body) >= 3) {
				lend = ruFwdSpan(body, 1);
				l = subrange(body, 1, lend - 1);
				r = subrange(body, lend, length(body) - lend);
				rIsNeg = length(r) >= 2 && switch (r[0]) {
					RuVar(__,__): false;
					RuRuleNode(idT4, __): ruIdType2Id(idT4) == ids.wn;
				};
				if (rIsNeg) {
					// φ→¬χ: refute the clause φ∧χ, export by imnani (t69-class)
					chi = subrange(r, 1, length(r) - 1);
					synth = ruFwdMkRule(ids.wn, ids.wff,
						[ruFwdMkRule(ids.wa, ids.wff, [RuExp(l, -1), RuExp(chi, -1)])]);
					maybeMap(ruFwdClauseClose(ids, eids, rules, asses, bareFacts, premLeaves, synth.nodes, stcl, depth, path, memo, prover_env),
						\pc -> RuProofStep(s2id_("imnani"), [pc], RuStmt(stcl, [RuExp(body, -1)], -1)));
				} else {
					// φ→χ, χ positive: guard on the antecedent, close the literal —
					// the result IS the goal implication (t81-class)
					psi = RuExp(l, -1);
					mkImp = \e1, e2 -> ruFwdMkRule(ids.wi, ids.wff, [e1, e2]);
					conjs = ruFwdConjProjections(ids, psi, l, None(), stcl);
					lifted : [Pair<RuProofTree, [RuExpNode]>] = map(premLeaves, \pr -> Pair(
						RuProofStep(s2id_("a1i"), [pr.first],
							RuStmt(stcl, [mkImp(psi, RuExp(pr.second, -1))], -1)),
						pr.second));
					facts = ruFwdBuildClsFacts(ids, prover_env.assertions, prover_env.fns.fresher, concat(lifted, conjs), stcl, Some(psi));
					ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, r, stcl, depth, path, memo, prover_env);
				}
			} else if (hid == ids.wb && length(body) >= 3) {
				// a BARE biconditional: impbii of the two implication directions,
				// each closed by the wi case (guard on its antecedent) — t28-class
				lend = ruFwdSpan(body, 1);
				l = subrange(body, 1, lend - 1);
				r = subrange(body, lend, length(body) - lend);
				d1E = ruFwdMkRule(ids.wi, ids.wff, [RuExp(l, -1), RuExp(r, -1)]);
				d2E = ruFwdMkRule(ids.wi, ids.wff, [RuExp(r, -1), RuExp(l, -1)]);
				maybeBind(ruFwdClauseClose(ids, eids, rules, asses, bareFacts, premLeaves, d1E.nodes, stcl, depth, path, memo, prover_env), \p1 ->
					maybeMap(ruFwdClauseClose(ids, eids, rules, asses, bareFacts, premLeaves, d2E.nodes, stcl, depth, path, memo, prover_env), \p2 ->
						RuProofStep(s2id_("impbii"), [p1, p2], RuStmt(stcl, [RuExp(body, -1)], -1))));
			} else if (hid == ids.wo && length(body) >= 3) {
				lend = ruFwdSpan(body, 1);
				l = subrange(body, 1, lend - 1);
				r = subrange(body, lend, length(body) - lend);
				p1 = maybeMap(ruFwdClauseClose(ids, eids, rules, asses, bareFacts, premLeaves, l, stcl, depth, path, memo, prover_env),
					\p -> RuProofStep(s2id_("orci"), [p], RuStmt(stcl, [RuExp(body, -1)], -1)));
				switch (p1) { Some(__): p1; None(): {
				p2 = maybeMap(ruFwdClauseClose(ids, eids, rules, asses, bareFacts, premLeaves, r, stcl, depth, path, memo, prover_env),
					\p -> RuProofStep(s2id_("olci"), [p], RuStmt(stcl, [RuExp(body, -1)], -1)));
				switch (p2) { Some(__): p2; None(): {
					// the oran route: ⊢(a∨b) from refuting ¬a∧¬b (t104 dir 1)
					if (depth <= 0) None() else {
						nn = ruFwdMkRule(ids.wa, ids.wff, [
							ruFwdMkRule(ids.wn, ids.wff, [RuExp(l, -1)]),
							ruFwdMkRule(ids.wn, ids.wff, [RuExp(r, -1)])]);
						synth = ruFwdMkRule(ids.wn, ids.wff, [nn]);
						maybeMap(ruFwdClauseClose(ids, eids, rules, asses, bareFacts, premLeaves, synth.nodes, stcl, depth - 1, path, memo, prover_env), \pc -> {
							bi = ruFwdMkRule(ids.wb, ids.wff, [RuExp(body, -1), synth]);
							RuProofStep(s2id_("mpbir"), [pc,
								RuProofStep(s2id_("oran"), [], RuStmt(stcl, [bi], -1))],
								RuStmt(stcl, [RuExp(body, -1)], -1));
						});
					}
				}}
				}}
			} else if (hid == ids.wn && length(body) >= 2) {
				// >= 2, not >= 4: ¬⊤ (the translator's absurdity marker on a
				// refutation fragment with contradictory hyps, t90-class) enters
				// with ψ = ⊤ — the guard rides along and the premise clash
				// concludes via the same pm2.65i
				inner = subrange(body, 1, length(body) - 1);
				psi = RuExp(inner, -1);
				mkImp = \e1, e2 -> ruFwdMkRule(ids.wi, ids.wff, [e1, e2]);
				conjs = ruFwdConjProjections(ids, psi, inner, None(), stcl);
				lifted : [Pair<RuProofTree, [RuExpNode]>] = map(premLeaves, \pr -> Pair(
					RuProofStep(s2id_("a1i"), [pr.first],
						RuStmt(stcl, [mkImp(psi, RuExp(pr.second, -1))], -1)),
					pr.second));
				facts = ruFwdBuildClsFacts(ids, prover_env.assertions, prover_env.fns.fresher, concat(lifted, conjs), stcl, Some(psi));
				if (prover_env.env.conf.verbose >= 6) {
					prover_env.env.out.println("    pools: ss=" + i2s(length(facts.ss)) + " eq0=" + i2s(length(facts.eq0))
						+ " el=" + i2s(length(facts.el)) + " bi=" + i2s(length(facts.bi)) + " eqs=" + i2s(length(facts.eqs))
						+ " ors=" + i2s(length(facts.ors))
						+ " neg=[" + strGlue(map(facts.neg, \nf -> ruSafeExp2s(RuExp(nf.second, -1), prover_env.math.decls.lang)), " | ") + "]");
				} else {};
				refuted = fold(facts.neg, None(), \acc, ng -> switch (acc) {
					Some(__): acc;
					None(): maybeMap(
						ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, ng.second, stcl, depth, path, memo, prover_env),
						\pg -> RuProofStep(s2id_("pm2.65i"), [pg, ng.first], RuStmt(stcl, [RuExp(body, -1)], -1)));
				});
				// EL-CLASH: an element of a pooled el-fact provably belongs to a
				// pooled-empty T — pm2.65i against the nel02 consequence (t5-class)
				elClash = \ -> {
					if (depth <= 0) None() else {
					empty0 = [ruMakeRuleNode(s2id("c0"), ids.cls, 0, 0)];
					elems = fold(facts.el, [], \acE, f -> {
						elend = ruFwdSpan(f.second, 1);
						e = subrange(f.second, 1, elend - 1);
						if (contains(acE, e)) acE else arrayPush(acE, e);
					});
					fold(facts.eq0, None(), \acQ, qf -> switch (acQ) {
						Some(__): acQ;
						None(): fold(elems, None(), \acX, xe -> switch (acX) {
							Some(__): acX;
							None(): {
								celE = ruFwdMkRule(ids.wcel, ids.wff, [RuExp(xe, -1), RuExp(qf.second, -1)]);
								maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psi, celE.nodes, stcl, depth - 1, path, memo, prover_env), \pg -> {
									eqE = ruFwdMkRule(s2id("wceq"), ids.wff, [RuExp(qf.second, -1), RuExp(empty0, -1)]);
									inst = RuProofStep(s2id_("nel02"), [],
										RuStmt(stcl, [mkImp(eqE, ruFwdMkRule(ids.wn, ids.wff, [celE]))], -1));
									pNeg = RuProofStep(s2id_("syl"), [qf.first, inst],
										RuStmt(stcl, [mkImp(psi, ruFwdMkRule(ids.wn, ids.wff, [celE]))], -1));
									RuProofStep(s2id_("pm2.65i"), [pg, pNeg], RuStmt(stcl, [RuExp(body, -1)], -1));
								});
							}
						});
					});
					}
				};
				switch (refuted) { Some(__): refuted; None(): {
					clashed = elClash();
					switch (clashed) { Some(__): clashed; None(): {
					// ∨-ELIMINATION (depth-bounded case split, t104 dir 2): refute the
					// clause under each disjunct of a pooled ∨-fact; ioran re-assembles
					// ψ→¬(a∨b), which clashes with the fact by pm2.65i.
					if (depth <= 0) None() else
					fold(facts.ors, None(), \acc2, orf -> switch (acc2) {
						Some(__): acc2;
						None(): {
							on = orf.second;
							olend = ruFwdSpan(on, 1);
							oa = subrange(on, 1, olend - 1);
							ob = subrange(on, olend, length(on) - olend);
							synthA = ruFwdMkRule(ids.wn, ids.wff, [ruFwdMkRule(ids.wa, ids.wff, [psi, RuExp(oa, -1)])]);
							synthB = ruFwdMkRule(ids.wn, ids.wff, [ruFwdMkRule(ids.wa, ids.wff, [psi, RuExp(ob, -1)])]);
							maybeBind(ruFwdClauseClose(ids, eids, rules, asses, bareFacts, premLeaves, synthA.nodes, stcl, depth - 1, path, memo, prover_env), \pa ->
								maybeMap(ruFwdClauseClose(ids, eids, rules, asses, bareFacts, premLeaves, synthB.nodes, stcl, depth - 1, path, memo, prover_env), \pb -> {
									nnA = ruFwdMkRule(ids.wn, ids.wff, [RuExp(oa, -1)]);
									nnB = ruFwdMkRule(ids.wn, ids.wff, [RuExp(ob, -1)]);
									qa = RuProofStep(s2id_("imnani"), [pa], RuStmt(stcl, [mkImp(psi, nnA)], -1));
									qb = RuProofStep(s2id_("imnani"), [pb], RuStmt(stcl, [mkImp(psi, nnB)], -1));
									nnAB = ruFwdMkRule(ids.wa, ids.wff, [nnA, nnB]);
									pj = RuProofStep(s2id_("jca"), [qa, qb], RuStmt(stcl, [mkImp(psi, nnAB)], -1));
									noOr = ruFwdMkRule(ids.wn, ids.wff, [RuExp(on, -1)]);
									bi = ruFwdMkRule(ids.wb, ids.wff, [noOr, nnAB]);
									biStep = RuProofStep(s2id_("a1i"),
										[RuProofStep(s2id_("ioran"), [], RuStmt(stcl, [bi], -1))],
										RuStmt(stcl, [mkImp(psi, bi)], -1));
									pno = RuProofStep(s2id_("mpbird"), [pj, biStep], RuStmt(stcl, [mkImp(psi, noOr)], -1));
									RuProofStep(s2id_("pm2.65i"), [orf.first, pno], RuStmt(stcl, [RuExp(body, -1)], -1));
								}));
						}
					});
				}}
				}}
			} else None();
		}
	}
	}
}

// A BARE positive goal closed through the guarded literal prover: guard
// ψ = the ∧ of ALL premises (right-nested), prove ψ→G by the literal
// channels, discharge with the pm3.2i premise assembly + ax-mp — the
// hypothesis-theorem counterpart of the clause discharge (t8-class:
// x8∈(x5∖{x7}) from ⊊/∈/∉ hypotheses).
ruFwdBareLitClose(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], asses : RuIndex<RuAssertion>,
	bareFacts : RuFwdClsFacts, premLeaves : [Pair<RuProofTree, [RuExpNode]>], goal : [RuExpNode], stcl : int, depth : int, memo : ref Tree<Pair<[RuExpNode], Pair<[RuExpNode], int>>, Maybe<RuProofTree>>, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	path : [[RuExpNode]] = [];
	if (premLeaves == []) None()
	else {
		n = length(premLeaves);
		// ψ = h1 ∧ (h2 ∧ (… hn)), assembled right-to-left with its pm3.2i proof
		last = premLeaves[n - 1];
		assembled = fold(enumFromTo(1, n - 1), Pair(last.first, last.second), \acP, i -> {
			pl = premLeaves[n - 1 - i];
			andN = (ruFwdMkRule(ids.wa, ids.wff, [RuExp(pl.second, -1), RuExp(acP.second, -1)])).nodes;
			Pair(RuProofStep(s2id_("pm3.2i"), [pl.first, acP.first], RuStmt(stcl, [RuExp(andN, -1)], -1)), andN);
		});
		psiE = RuExp(assembled.second, -1);
		conjs = ruFwdConjProjections(ids, psiE, assembled.second, None(), stcl);
		facts = ruFwdBuildClsFacts(ids, prover_env.assertions, prover_env.fns.fresher, conjs, stcl, Some(psiE));
		resBare = maybeMap(ruFwdLitClose(ids, eids, rules, asses, facts, bareFacts, psiE, goal, stcl, depth, path, memo, prover_env), \pg ->
			RuProofStep(ids.axmp, [assembled.first, pg], RuStmt(stcl, [RuExp(goal, -1)], -1)));
		if (prover_env.env.conf.verbose >= 6) {
			prover_env.env.out.println("  bareLit EXIT " + ruSafeExp2s(RuExp(goal, -1), prover_env.math.decls.lang)
				+ " -> " + (switch (resBare) { Some(__): "SOME"; None(): "none"; }));
		} else {};
		resBare;
	}
}

// CONJUNCT PROJECTIONS of a guard ψ: walk ψ's ∧-tree; every leaf conjunct c
// gets a proof of ψ→c (simpl/simpr instances composed by syl). `path` proves
// ψ→cur (None at the root where cur == ψ).
ruFwdConjProjections(ids : RuFwdInstIds, psi : RuExp, cur : [RuExpNode], path : Maybe<RuProofTree>, stcl : int) -> [Pair<RuProofTree, [RuExpNode]>] {
	mkImp = \x, y -> ruFwdMkRule(ids.wi, ids.wff, [x, y]);
	isWa = switch (cur[0]) {
		RuVar(__,__): false;
		RuRuleNode(idT, __): ruIdType2Id(idT) == ids.wa;
	};
	if (isWa && length(cur) >= 3) {
		lend = ruFwdSpan(cur, 1);
		l = subrange(cur, 1, lend - 1);
		r = subrange(cur, lend, length(cur) - lend);
		proj = \part : [RuExpNode], projId : int -> {
			step0 = RuProofStep(projId, [], RuStmt(stcl, [mkImp(RuExp(cur, -1), RuExp(part, -1))], -1));
			switch (path) {
				None(): step0;
				Some(pp): RuProofStep(s2id_("syl"), [pp, step0], RuStmt(stcl, [mkImp(psi, RuExp(part, -1))], -1));
			}
		};
		concat(
			ruFwdConjProjections(ids, psi, l, Some(proj(l, s2id_("simpl"))), stcl),
			ruFwdConjProjections(ids, psi, r, Some(proj(r, s2id_("simpr"))), stcl)
		);
	} else {
		p = switch (path) {
			None(): RuProofStep(s2id_("id"), [], RuStmt(stcl, [mkImp(psi, psi)], -1));
			Some(pp): pp;
		};
		[Pair(p, cur)];
	}
}

ruSeedEqNormalize(prover_env : RuProverEnv, c_task : RuConstAny<RuProverTask>, fwd : RuProverForward, asses : RuIndex<RuAssertion>) -> RuProverForward {
	ids  = ruFwdInstIds();
	eids = ruFwdEqIds();
	stcl = c_task.const.goal.stmt.class;
	goal = ruExp(c_task.const.goal.stmt.exps[0]);
	wceq = s2id("wceq"); wff = tp2id_("wff");
	stripped = ruFwdStripWalPrefix(ids, goal.nodes, []);
	body = stripped.second;
	// re-add the stripped ∀-prefix (innermost quantifier first) and seed the goal fact
	register = \proof0 : RuProofTree -> {
		proof = fold(reverseA(stripped.first), proof0, \pr, qexp ->
			RuProofStep(eids.axgen, [pr], RuStmt(stcl, [RuExp(qexp, -1)], -1)));
		key = goal.nodes;
		if (containsSet(fwd.seen, key)) fwd else {
			sf = RuProverExp(-1, makeVector(4), RuStmt(stcl, [goal], -1), makeVector(0), ruNoProverProp);
			pushVector(sf.proofs, RuProverProofForward(sf, RuStmt(stcl, [goal], -1), ruEmptySubst, proof));
			(ruFwdRegister(fwd, [], sf, goal, key)).first;
		}
	};
	premLeaves = ruFwdSsPremises(ids, c_task.const.premises, stcl);
	bareFacts = ruFwdBuildClsFacts(ids, prover_env.assertions, prover_env.fns.fresher, premLeaves, stcl, None());
	mkRules = \ -> {
		cands = filter(ruIndexValues(asses), \a ->
			length(a.infer.hyps) == 0 && {
				cn = (ruExp(a.infer.prop.exps[0])).nodes;
				switch (cn[0]) {
					RuVar(__,__): false;
					RuRuleNode(idT2, __): ruIdType2Id(idT2) == ids.wceq;
				}
			});
		// task ops = GOAL ∪ PREMISES: eq-normalize rewrites premise-derived terms
		// too (t90: the neg-pool's (X×Y)=∅ under a case branch's X=∅ needs 0xp/in0,
		// whose ops the ¬∀∀¬-shaped goal itself never mentions — goal-only seeding
		// left them out of the rule base and the collapse stalled at (X∩∅)×Y)
		// … plus the CORE algebra ops (∩/∪/∖/∅) unconditionally: the channels
		// themselves construct them (the df-ss substitution route builds A∩B, the
		// ∅-cover builds ∪-chains), so their collapse rules (in0/un0/…) must be in
		// the base even when neither goal nor premises mention the op
		coreOps = fold([eids.cin, eids.cun, eids.cdif, s2id("c0")], ruFwdClassOps(ids, goal.nodes), \acC, op -> insertSet(acC, op));
		taskOps = fold(premLeaves, coreOps, \acOps, pl ->
			mergeSets(acOps, ruFwdClassOps(ids, pl.second)));
		idents = ruFwdCloseIdents(ids, taskOps, cands);
		rs0 = ruFwdEqRulesChecked(ids, eids, idents, stcl);
		// PREMISE ⊆-RULES: each ⊆-premise A⊆B (∧-flattened — an unss-style
		// conjunction premise contributes each ⊆-conjunct with its simpli/simpri
		// chain) becomes the GROUND rewrite rule A∖B → ∅ (proof = mpbi(prem,
		// ssdif0) — ssdif0: (A⊆B) ↔ ((A∖B)=∅)). This is ⊆-arithmetic under
		// premises done DETERMINISTICALLY: the ssdif0-close's residue (e.g.
		// t117's (x67∩x69)∖x70 under x67⊆x70) transposes until the premise
		// difference surfaces and collapses.
		// Shrinking ground rules — termination/soundness untouched.
		empty0 = [ruMakeRuleNode(s2id("c0"), ids.cls, 0, 0)];
		premRules = map(bareFacts.ss, \prem -> {
			pe = prem.second;
			pend = ruFwdSpan(pe, 1);
			pa = subrange(pe, 1, pend - 1);
			pb = subrange(pe, pend, length(pe) - pend);
			pdiff = ruFwdMkRule(eids.cdif, ids.cls, [RuExp(pa, -1), RuExp(pb, -1)]);
			RuFwdEqRule(pdiff.nodes, empty0, false, false, true,  false,
				\il, ir, sc -> {
					eq0p = ruFwdMkRule(s2id("wceq"), tp2id_("wff"), [il, ir]);
					ssdif0Stp = RuProofStep(s2id_("ssdif0"), [],
						RuStmt(sc, [ruFwdMkRule(ids.wb, ids.wff, [RuExp(pe, -1), eq0p])], -1));
					RuProofStep(s2id_("mpbi"), [prem.first, ssdif0Stp], RuStmt(sc, [eq0p], -1));
				});
		});
		// EVERY pooled T=∅ fact (premise or derived — incl. the ≠-derived
		// singleton disjointness) becomes the ground rewrite rule T→∅; a
		// T = A∩B additionally yields the disjoint-difference companions
		// A∖B→A and B∖A→B (disjdif2, the flipped side through incom+eqtri) —
		// the zfmisc t17/t23 Equalizer pieces ({x,y}∖{y} normalizes to {x}
		// through df-pr/difundir/difid/un0 + the companion).
		eq0Rules = concatA(map(bareFacts.eq0, \qf -> {
			tN = qf.second;
			eq0E = ruFwdMkRule(s2id("wceq"), tp2id_("wff"), [RuExp(tN, -1), RuExp(empty0, -1)]);
			base = RuFwdEqRule(tN, empty0, false, false, true, false, \__, __2, sc -> qf.first);
			th9 = switch (tN[0]) { RuVar(__,__): -1; RuRuleNode(idT9, __): ruIdType2Id(idT9); };
			if (th9 != ids.cin || length(tN) < 3) [base] else {
				dend = ruFwdSpan(tN, 1);
				da = subrange(tN, 1, dend - 1);
				db = subrange(tN, dend, length(tN) - dend);
				difAB = ruFwdMkRule(eids.cdif, ids.cls, [RuExp(da, -1), RuExp(db, -1)]);
				difBA = ruFwdMkRule(eids.cdif, ids.cls, [RuExp(db, -1), RuExp(da, -1)]);
				eqABA = ruFwdMkRule(s2id("wceq"), tp2id_("wff"), [difAB, RuExp(da, -1)]);
				eqBAB = ruFwdMkRule(s2id("wceq"), tp2id_("wff"), [difBA, RuExp(db, -1)]);
				pAB = RuProofStep(ids.axmp, [qf.first,
					RuProofStep(s2id_("disjdif2"), [], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [eq0E, eqABA])], -1))],
					RuStmt(stcl, [eqABA], -1));
				inBA = ruFwdMkRule(ids.cin, ids.cls, [RuExp(db, -1), RuExp(da, -1)]);
				eqInBA0 = ruFwdMkRule(s2id("wceq"), tp2id_("wff"), [inBA, RuExp(empty0, -1)]);
				pInBA = RuProofStep(eids.eqtri, [
					RuProofStep(eids.incom, [], RuStmt(stcl, [ruFwdMkRule(s2id("wceq"), tp2id_("wff"), [inBA, RuExp(tN, -1)])], -1)),
					qf.first], RuStmt(stcl, [eqInBA0], -1));
				pBA = RuProofStep(ids.axmp, [pInBA,
					RuProofStep(s2id_("disjdif2"), [], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [eqInBA0, eqBAB])], -1))],
					RuStmt(stcl, [eqBAB], -1));
				[base,
					RuFwdEqRule(difAB.nodes, da, false, false, true, false, \__, __2, sc -> pAB),
					RuFwdEqRule(difBA.nodes, db, false, false, true, false, \__, __2, sc -> pBA)];
			}
		}));
		rs = concatA([rs0, premRules, eq0Rules]);
		if (prover_env.env.conf.verbose >= 5) {
			iter(rs, \r -> prover_env.env.out.println("  eqrule"
				+ (if (r.comm) " comm" else if (r.elim) " elim" else " grow") + ": "
				+ ruSafeExp2s(RuExp(r.lhs, -1), prover_env.math.decls.lang) + "  ->  "
				+ ruSafeExp2s(RuExp(r.rhs, -1), prover_env.math.decls.lang)));
		} else {};
		rs;
	};
	// DIRECT AXIOM MATCH: a 0-hyp assertion whose statement σ-matches the WHOLE
	// (unstripped) goal closes it in one step — the axiomatic article statements
	// (t3_tarski = ax-reg-mizar) and verbatim identity instances. Deterministic;
	// the install-side reconstruction re-checks the DV conditions. Consults the
	// FULL index, not the scope whitelist: the scope discipline guards the WAVE
	// against fan-out, and a verbatim one-step root match cannot explode.
	axMatch = fold(ruIndexValues(prover_env.assertions), None(), \acA, a -> switch (acA) {
		Some(__): acA;
		None(): {
			if (length(a.infer.hyps) != 0) None()
			else switch (ruMatchExp(goal, ruExp(a.infer.prop.exps[0]), prover_env.math, prover_env.env)) {
				None(): None();
				Some(__): Some(a);
			}
		}
	});
	if (prover_env.env.conf.verbose >= 5) {
		prover_env.env.out.println("  seedEqNorm: body=" + ruSafeExp2s(RuExp(body, -1), prover_env.math.decls.lang)
			+ " head=" + (switch (body[0]) { RuVar(__,__): "var"; RuRuleNode(idTz, __): id2s(ruIdType2Id(idTz)); })
			+ " axMatch=" + (switch (axMatch) { Some(a2): id2s(a2.info.id); None(): "-"; }));
	} else {};
	switch (axMatch) {
		Some(a): {
			if (prover_env.env.conf.verbose >= 4) {
				prover_env.env.out.println("  direct axiom match: " + id2s(a.info.id));
			} else {};
			key = goal.nodes;
			if (containsSet(fwd.seen, key)) fwd else {
				sf = RuProverExp(-1, makeVector(4), RuStmt(stcl, [goal], -1), makeVector(0), ruNoProverProp);
				pushVector(sf.proofs, RuProverProofForward(sf, RuStmt(stcl, [goal], -1), ruEmptySubst,
					RuProofStep(a.info.id, [], RuStmt(stcl, [goal], -1))));
				(ruFwdRegister(fwd, [], sf, goal, key)).first;
			}
		}
		None():
	switch (body[0]) {
		RuVar(__,__): fwd;
		RuRuleNode(idT, __): {
			hid = ruIdType2Id(idT);
			if (hid == s2id("wtru") && length(body) == 1) {
				// ∀…⊤ — the trivial root-sort statement (t1_tarski): ⊤ by tru,
				// the ∀-prefix re-added by register's ax-gen wrap
				register(RuProofStep(s2id_("tru"), [], RuStmt(stcl, [RuExp(body, -1)], -1)));
			}
			else if (hid == ids.wn && length(body) >= 2) {
				// >= 2, not >= 4: ¬⊤ (the absurdity marker on a refutation
				// fragment with contradictory hyps, t90-class) rides the same
				// discharge with ψ = ⊤
				// MIZAR CLAUSE DISCHARGE: the ∀-stripped body is a clause ¬ψ (or an
				// ∧ of clauses) whose "premises" live INSIDE the negated conjunction.
				// ruFwdClauseClose refutes ψ literal against literal: pm2.65i of the
				// deduction-form channels (⊆-closure, ⊊-closure, antisymmetry, the
				// eq0 ∅-cover) against the ψ→¬X projections. Normalization stays
				// BARE (structural identities are 0-hyp; a1i lifts their chains).
				rules = mkRules();
				switch ((if (ruLitClosersOff(prover_env)) None() else ruFwdClauseClose(ids, eids, rules, asses, bareFacts, premLeaves, body, stcl, 6, [], ref makeTree(), prover_env))) {
					None(): {
						// the ¬-goal may be a POSITIVE claim in disguise — ¬(T=∅) is
						// nonemptiness (t110's step 1), closable by the bare-premise
						// literal route (guard on the ∧ of hyps → litClose, where the
						// witness channel lives) though its clause REFUTATION is
						// semantically hopeless (T=∅ does not force a factor empty).
						// ONLY for that shape — a blanket retry would re-burn every
						// failing ¬-clause's budget (the 104→99 batch lesson).
						isNe0 = length(body) >= 5 && (switch (body[1]) {
							RuVar(__,__): false;
							RuRuleNode(idTn, __): ruIdType2Id(idTn) == wceq;
						}) && body[length(body) - 1] == ruMakeRuleNode(s2id("c0"), ids.cls, 0, 0);
						// the Mizar product-∃ shape ¬∀u∀v¬(…〈u,v〉…) is likewise a positive
						// claim (t84/85-class) — its (b3) elxpmiz channel lives in litClose;
						// the shape check is exact, so no other failing ¬-clause re-burns
						isProdEx = isSome(ruFwdMizProdExParse(ids, subrange(body, 1, length(body) - 1)));
						bare = if (!isNe0 && !isProdEx) None()
							else (if (ruLitClosersOff(prover_env)) None() else ruFwdBareLitClose(ids, eids, rules, asses, bareFacts, premLeaves, body, stcl, 6, ref makeTree(), prover_env));
						switch (bare) {
							Some(pb): {
								if (prover_env.env.conf.verbose >= 4) {
									prover_env.env.out.println("  ¬-goal closed by the BARE literal route");
								} else {};
								register(pb);
							}
							None(): {
								if (prover_env.env.conf.verbose >= 4) {
									prover_env.env.out.println("  clause STALL: no literal discharged under "
										+ ruSafeExp2s(RuExp(body, -1), prover_env.math.decls.lang));
								} else {};
								fwd;
							}
						}
					}
					Some(p): {
						if (prover_env.env.conf.verbose >= 4) {
							prover_env.env.out.println("  clause DISCHARGED (pm2.65i of the d-form closures)");
						} else {};
						register(p);
					}
				}
			}
			// binary heads only — a 0-arity goal head (e.g. ⊤, t115) has no arg
			// slices and ruFwdSpan(body, 1) would index past the array
			else if (hid != ids.wceq && hid != ids.wss && hid != ids.wcel && hid != ids.wb && hid != ids.wa && hid != ids.wi && hid != ids.wo) fwd
			else if (length(body) < 3) fwd
			else {
			lend = ruFwdSpan(body, 1);
			xs = subrange(body, 1, lend - 1);
			ys = subrange(body, lend, length(body) - lend);
			if (hid == ids.wceq) {
				rules = mkRules();
				nx = ruFwdNormalize(ids, eids, rules, xs, stcl, prover_env.math, prover_env.env);
				ny = ruFwdNormalize(ids, eids, rules, ys, stcl, prover_env.math, prover_env.env);
				if (prover_env.env.conf.verbose >= 4) {
					switch (nx.second) { None(): {}; Some(t): ruFwdEqDump("X", t, 0, prover_env); }
					switch (ny.second) { None(): {}; Some(t): ruFwdEqDump("Y", t, 0, prover_env); }
					if (nx.first != ny.first) {
						prover_env.env.out.println("  eqnorm MISMATCH: nfX(" + i2s(length(nx.first)) + ")="
							+ ruSafeExp2s(RuExp(nx.first, -1), prover_env.math.decls.lang)
							+ "  nfY(" + i2s(length(ny.first)) + ")="
							+ ruSafeExp2s(RuExp(ny.first, -1), prover_env.math.decls.lang));
					} else {};
				} else {};
				// POINTWISE EXTENSIONALITY from a ∀-premise (t2_xboole_0-class: a
				// hypothesis ∀v BODY that pins A=B elementwise): prove the bare
				// implication BODY → ((v∈A)↔(v∈B)) through the clause machinery
				// (guard = BODY), splice with spi(hyp), ax-gen the frozen v back,
				// and close A=B by dfcleq. Eigenvar legality: v must not occur in
				// any OTHER premise, nor in A/B (dfcleq's DV).
				pointwise = \ -> fold(premLeaves, None(), \acP, pl -> switch (acP) {
					Some(__): acP;
					None(): {
						pn = pl.second;
						isWal = length(pn) > 2 && (switch (pn[0]) {
							RuVar(__,__): false;
							RuRuleNode(idTw, __): ruIdType2Id(idTw) == ids.wal;
						}) && ruFwdIsSetvarNode(pn[1], ids.setvar);
						if (!isWal) None() else {
							v = pn[1];
							hypBody = subrange(pn, 2, length(pn) - 2);
							vFreeElsewhere = exists(premLeaves, \o -> o != pl && ruFwdContainsNode(o.second, v));
							if (vFreeElsewhere || ruFwdContainsNode(xs, v) || ruFwdContainsNode(ys, v)) None()
							else {
								// v's CLASS-form occurrence slice: the implicit setvar→class
								// coercion node followed by v, extracted from the body
								vSlice = fold(enumFromTo(0, length(hypBody) - 2), [], \accV, i ->
									if (accV != []) accV
									else switch (hypBody[i]) {
										RuVar(__,__): accV;
										RuRuleNode(idTc, al): {
											if (ruArityLen2Arity(al) == 1 && ruIdType2Type(idTc) == ids.cls && hypBody[i + 1] == v)
												[hypBody[i], hypBody[i + 1]]
											else accV;
										}
									});
								if (vSlice == []) None() else {
								biE = ruFwdMkRule(ids.wb, ids.wff, [
									ruFwdMkRule(ids.wcel, ids.wff, [RuExp(vSlice, -1), RuExp(xs, -1)]),
									ruFwdMkRule(ids.wcel, ids.wff, [RuExp(vSlice, -1), RuExp(ys, -1)])]);
								impE = ruFwdMkRule(ids.wi, ids.wff, [RuExp(hypBody, -1), biE]);
								maybeMap((if (ruLitClosersOff(prover_env)) None() else ruFwdClauseClose(ids, eids, rules, asses, bareFacts, [], impE.nodes, stcl, 5, [], ref makeTree(), prover_env)), \pImp -> {
									pBody = RuProofStep(s2id_("spi"), [pl.first], RuStmt(stcl, [RuExp(hypBody, -1)], -1));
									pBi = RuProofStep(ids.axmp, [pBody, pImp], RuStmt(stcl, [biE], -1));
									allE = ruFwdMkRule(ids.wal, ids.wff, [RuExp([v], -1), biE]);
									pAll = RuProofStep(eids.axgen, [pBi], RuStmt(stcl, [allE], -1));
									RuProofStep(eids.mpbir, [pAll,
										RuProofStep(s2id_("dfcleq"), [],
											RuStmt(stcl, [ruFwdMkRule(ids.wb, ids.wff, [RuExp(body, -1), allE])], -1))],
										RuStmt(stcl, [RuExp(body, -1)], -1));
								});
								}
							}
						}
					}
				});
				if (nx.first != ny.first) {
					switch (pointwise()) {
						Some(p): register(p);
						None(): switch ((if (ruLitClosersOff(prover_env)) None() else ruFwdBareLitClose(ids, eids, rules, asses, bareFacts, premLeaves, body, stcl, 6, ref makeTree(), prover_env))) {
							// the BARE-PREMISE route: equality goals of hypothesis
							// theorems (t4_zfmisc_1: {x}={y,z} ⊢ x=y — the derived
							// member equalities close it through the eqs pool)
							Some(p2): register(p2);
							None(): fwd;
						}
					}
				} else {
					if (prover_env.env.conf.verbose >= 4) {
						prover_env.env.out.println("  eqnorm MATCH: seeding goal (seen="
							+ b2s(containsSet(fwd.seen, goal.nodes)) + ")");
					} else {};
					bodyExp = RuExp(body, -1);
					// assemble  X = Y  from  X = N (nx), Y = N (ny)
					proof0 = switch (nx.second) {
						None(): switch (ny.second) {
							None(): RuProofStep(eids.eqid, [], RuStmt(stcl, [bodyExp], -1)); // X == Y syntactically
							Some(py): RuProofStep(eids.eqcomi, [py], RuStmt(stcl, [bodyExp], -1)); // X = N, Y -> N flipped
						}
						Some(px): switch (ny.second) {
							None(): px; // N == Y already
							Some(py): {
								flipped = RuProofStep(eids.eqcomi, [py],
									RuStmt(stcl, [ruFwdMkRule(wceq, wff, [RuExp(nx.first, -1), RuExp(ys, -1)])], -1));
								RuProofStep(eids.eqtri, [px, flipped], RuStmt(stcl, [bodyExp], -1));
							}
						}
					};
					register(proof0);
				}
			} else if (hid == ids.wb || hid == ids.wi) {
				// EXTENSIONALITY WITNESS (the Mizar equality theorems carry the step
				// ∀x (x∈A ↔ x∈B) beside A=B): if both sides are memberships of the
				// SAME element, normalize the two classes — coinciding normal forms
				// give A=B by the eqtri chains, and the biconditional follows by
				// eleq2 ((A=B) → (C∈A ↔ C∈B)) + ax-mp, ∀-wrapped by ax-gen.
				// The ONE-DIRECTIONAL form ∀x (x∈A → x∈B) (t48/t52-class: the
				// membership-implication witness of the same equality) closes as
				// the biconditional's biimpi.
				lend2 = ruFwdSpan(body, 1);
				l = subrange(body, 1, lend2 - 1);
				r = subrange(body, lend2, length(body) - lend2);
				lIsCel = length(l) >= 3 && (switch (l[0]) { RuVar(__,__): false; RuRuleNode(idT2, __): ruIdType2Id(idT2) == ids.wcel; });
				rIsCel = length(r) >= 3 && (switch (r[0]) { RuVar(__,__): false; RuRuleNode(idT3, __): ruIdType2Id(idT3) == ids.wcel; });
				implClause = \ -> {
					// IMPLICATION GOAL φ→χ (t81: guard on the antecedent; t69:
					// negated consequent via the clause + imnani) — the wi case
					// of ruFwdClauseClose handles both shapes.
					if (hid != ids.wi && hid != ids.wb) fwd else {
						rules2 = mkRules();
						switch ((if (ruLitClosersOff(prover_env)) None() else ruFwdClauseClose(ids, eids, rules2, asses, bareFacts, premLeaves, body, stcl, 6, [], ref makeTree(), prover_env))) {
							None(): fwd;
							Some(p): register(p);
						}
					}
				};
				if (!lIsCel || !rIsCel) implClause() else {
					elEnd = ruFwdSpan(l, 1);
					el = subrange(l, 1, elEnd - 1);
					aCls = subrange(l, elEnd, length(l) - elEnd);
					elEnd2 = ruFwdSpan(r, 1);
					el2 = subrange(r, 1, elEnd2 - 1);
					bCls = subrange(r, elEnd2, length(r) - elEnd2);
					if (el != el2) implClause() else {
						rules = mkRules();
						na = ruFwdNormalize(ids, eids, rules, aCls, stcl, prover_env.math, prover_env.env);
						nb = ruFwdNormalize(ids, eids, rules, bCls, stcl, prover_env.math, prover_env.env);
						if (na.first != nb.first) implClause() else {
							eqAB = ruFwdMkRule(wceq, wff, [RuExp(aCls, -1), RuExp(bCls, -1)]);
							pEq = switch (na.second) {
								None(): switch (nb.second) {
									None(): RuProofStep(eids.eqid, [], RuStmt(stcl, [eqAB], -1));
									Some(pb): RuProofStep(eids.eqcomi, [pb], RuStmt(stcl, [eqAB], -1));
								}
								Some(pa): switch (nb.second) {
									None(): pa;
									Some(pb): {
										flip = RuProofStep(eids.eqcomi, [pb],
											RuStmt(stcl, [ruFwdMkRule(wceq, wff, [RuExp(na.first, -1), RuExp(bCls, -1)])], -1));
										RuProofStep(eids.eqtri, [pa, flip], RuStmt(stcl, [eqAB], -1));
									}
								}
							};
							bodyExp = RuExp(body, -1);
							biExp = if (hid == ids.wb) bodyExp
								else ruFwdMkRule(ids.wb, ids.wff, [RuExp(l, -1), RuExp(r, -1)]);
							lemStep = RuProofStep(ids.eleq2, [], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [eqAB, biExp])], -1));
							pBi = RuProofStep(ids.axmp, [pEq, lemStep], RuStmt(stcl, [biExp], -1));
							proof0 = if (hid == ids.wb) pBi
								else RuProofStep(s2id_("biimpi"), [pBi], RuStmt(stcl, [bodyExp], -1));
							register(proof0);
						}
					}
				}
			} else if (hid == ids.wss || hid == ids.wcel || hid == ids.wa || hid == ids.wo) {
				rules = mkRules();
				switch (ruFwdRelClose(ids, eids, rules, asses, bareFacts, body, stcl, prover_env)) {
					None(): {
						// an ∧ of CLAUSES (t66-class) — per-conjunct pm2.65i; else the
						// BARE-PREMISE route (guard on the ∧ of hypotheses, t8-class)
						cl = if (hid != ids.wa && hid != ids.wo) None()
							else (if (ruLitClosersOff(prover_env)) None() else ruFwdClauseClose(ids, eids, rules, asses, bareFacts, premLeaves, body, stcl, 6, [], ref makeTree(), prover_env));
						switch (cl) {
							Some(p): register(p);
							None(): switch ((if (ruLitClosersOff(prover_env)) None() else ruFwdBareLitClose(ids, eids, rules, asses, bareFacts, premLeaves, body, stcl, 8, ref makeTree(), prover_env))) {
								None(): fwd;
								Some(p2): register(p2);
							}
						}
					}
					Some(proof0): register(proof0);
				}
			} else fwd;
			}
		}
	}
	}
}

// REL-NORMALIZE closer: X R Y (R ∈ {⊆, ∈}) — normalize both args by the same
// oriented identity base; if a 0-hyp R-headed schema in scope MATCHES the
// normalized atom (e.g. ssun1 ⊢ A⊆(A∪B); ssid covers NX == NY), close and
// TRANSPORT back through the side equalities:
//   schema:  ⊢ NX R NY
//   sseq1/eleq1 + ax-mp(X=NX) + mpbir:  ⊢ X R NY
//   sseq2/eleq2 + ax-mp(Y=NY) + mpbir:  ⊢ X R Y
// A CONJUNCTION of relations closes recursively per conjunct + pm3.2i assembly
// (the t53-class ∧-of-⊆ steps — e.g. A∖(B∪C)⊆A∖B ∧ A∖(B∪C)⊆A∖C, each conjunct
// difss on the difun1 normal form).
ruFwdRelClose(ids : RuFwdInstIds, eids : RuFwdEqIds, rules : [RuFwdEqRule], asses : RuIndex<RuAssertion>,
	facts : RuFwdClsFacts, body : [RuExpNode], stcl : int, prover_env : RuProverEnv) -> Maybe<RuProofTree> {
	wceq = s2id("wceq"); wff = tp2id_("wff");
	switch (body[0]) {
		RuVar(__,__): None();
		RuRuleNode(idT, __): {
			hid = ruIdType2Id(idT);
			if (length(body) < 3) None()
			else {
				lend = ruFwdSpan(body, 1);
				xs = subrange(body, 1, lend - 1);
				ys = subrange(body, lend, length(body) - lend);
				if (hid == ids.wa) {
					perConj = maybeBind(ruFwdRelClose(ids, eids, rules, asses, facts, xs, stcl, prover_env), \pl ->
						maybeMap(ruFwdRelClose(ids, eids, rules, asses, facts, ys, stcl, prover_env), \pr ->
							RuProofStep(s2id_("pm3.2i"), [pl, pr], RuStmt(stcl, [RuExp(body, -1)], -1))));
					switch (perConj) { Some(__): perConj; None(): {
						// dfpss2-RHS RECOGNIZER (t58-class): a goal (A⊆B) ∧ ¬(A=B) IS
						// the unfolded A⊊B — close by the ⊊-closure + mpbi(dfpss2)
						xsIsSs = length(xs) >= 3 && switch (xs[0]) {
							RuVar(__,__): false;
							RuRuleNode(idT5, __): ruIdType2Id(idT5) == ids.wss;
						};
						ysIsNeq = length(ys) >= 4 && (switch (ys[0]) {
							RuVar(__,__): false;
							RuRuleNode(idT6, __): ruIdType2Id(idT6) == ids.wn;
						}) && (switch (ys[1]) {
							RuVar(__,__): false;
							RuRuleNode(idT7, __): ruIdType2Id(idT7) == ids.wceq;
						});
						if (!xsIsSs || !ysIsNeq) None() else {
							slend = ruFwdSpan(xs, 1);
							sa = subrange(xs, 1, slend - 1);
							sb = subrange(xs, slend, length(xs) - slend);
							eqNodes = subrange(ys, 1, length(ys) - 1);
							elend = ruFwdSpan(eqNodes, 1);
							ea = subrange(eqNodes, 1, elend - 1);
							eb = subrange(eqNodes, elend, length(eqNodes) - elend);
							if (sa != ea || sb != eb) None()
							else maybeMap(ruFwdPssClose(ids, facts, sa, sb, stcl, None(), prover_env), \pp -> {
								pssE = ruFwdMkRule(s2id("wpss"), ids.wff, [RuExp(sa, -1), RuExp(sb, -1)]);
								bi = ruFwdMkRule(ids.wb, ids.wff, [pssE, RuExp(body, -1)]);
								RuProofStep(s2id_("mpbi"), [pp,
									RuProofStep(s2id_("dfpss2"), [], RuStmt(stcl, [bi], -1))],
									RuStmt(stcl, [RuExp(body, -1)], -1));
							});
						}
					}}
				} else if (hid != ids.wss && hid != ids.wcel) None()
				else {
					nx = ruFwdNormalize(ids, eids, rules, xs, stcl, prover_env.math, prover_env.env);
					ny = ruFwdNormalize(ids, eids, rules, ys, stcl, prover_env.math, prover_env.env);
					nfBody = ruFwdMkRule(hid, ids.wff, [RuExp(nx.first, -1), RuExp(ny.first, -1)]);
					schema = fold(ruIndexValues(asses), None(), \found, a ->
						switch (found) {
							Some(__): found;
							None(): {
								if (length(a.infer.hyps) != 0) None() else {
									concl = ruExp(a.infer.prop.exps[0]);
									hOk = switch (concl.nodes[0]) {
										RuVar(__,__): false;
										RuRuleNode(idT2, __): ruIdType2Id(idT2) == hid;
									};
									if (!hOk) None()
									else switch (ruMatchExp(nfBody, concl, prover_env.math, prover_env.env)) {
										None(): None();
										Some(__): Some(a);
									}
								}
							}
						});
					if (schema == None() && hid == ids.wss) {
						// ⊆ VIA THE DIFFERENCE (ssdif0: (A⊆B) ↔ ((A∖B)=∅)): no schema
						// matched the normalized atom — normalize X∖Y itself; reaching
						// ∅ closes the ⊆ by mpbir. This turns EVERY ⊆-tautology of the
						// ring into eq-normalize's domain (t117-class: the case-split
						// (A∖C) ⊆ (A∖B)∪(A∩(B∖C)) is a difference-collapse, no ∈-cases).
						diff = ruFwdMkRule(eids.cdif, ids.cls, [RuExp(xs, -1), RuExp(ys, -1)]);
						nd = ruFwdNormalize(ids, eids, rules, diff.nodes, stcl, prover_env.math, prover_env.env);
						empty = [ruMakeRuleNode(s2id("c0"), ids.cls, 0, 0)];
						eq0 = ruFwdMkRule(wceq, wff, [diff, RuExp(empty, -1)]);
						// proof of (X∖Y) = ∅: either the nf IS ∅, or the ⊆-CLOSURE
						// RESIDUE DISCHARGE proves every residual ∪-piece P∖Q empty
						// (the rewriting-blocked cases: t117's (x67∩x69)∖x70 under
						// x67⊆x70 — the ∩/∖ transposition is order/poly-blocked, but
						// (x67∩x69)⊆x70 falls to inss1 + the premise + sstri).
						mEq0 = if (nd.first == empty) {
							if (prover_env.env.conf.verbose >= 4) {
								prover_env.env.out.println("  relnorm: X∖Y collapses to ∅ (ssdif0 close)");
							} else {};
							nd.second; // None = diff not literally ∅-headed — unreachable
						} else {
							switch (ruFwdResidue0(ids, eids, facts, nd.first, stcl, None(), prover_env)) {
								None(): {
									if (prover_env.env.conf.verbose >= 4) {
										prover_env.env.out.println("  ssdif0 STALL: nf(X∖Y)="
											+ ruSafeExp2s(RuExp(nd.first, -1), prover_env.math.decls.lang));
									} else {};
									None();
								}
								Some(p0): {
									if (prover_env.env.conf.verbose >= 4) {
										prover_env.env.out.println("  relnorm: ssdif0 residue DISCHARGED by the ⊆-closure: nf(X∖Y)="
											+ ruSafeExp2s(RuExp(nd.first, -1), prover_env.math.decls.lang));
									} else {};
									Some(switch (nd.second) {
										None(): p0; // X∖Y == the residue syntactically
										Some(pd): RuProofStep(eids.eqtri, [pd, p0], RuStmt(stcl, [eq0], -1));
									});
								}
							}
						};
						maybeMap(mEq0, \pd -> {
							bodyExp0 = RuExp(body, -1);
							ssdif0Step = RuProofStep(s2id_("ssdif0"), [],
								RuStmt(stcl, [ruFwdMkRule(ids.wb, ids.wff, [bodyExp0, eq0])], -1));
							RuProofStep(eids.mpbir, [pd, ssdif0Step], RuStmt(stcl, [bodyExp0], -1));
						});
					} else
					maybeMap(schema, \a -> {
						if (prover_env.env.conf.verbose >= 4) {
							prover_env.env.out.println("  relnorm: schema=" + id2s(a.info.id)
								+ " nf=" + ruSafeExp2s(nfBody, prover_env.math.decls.lang));
						} else {};
						sStep = RuProofStep(a.info.id, [], RuStmt(stcl, [nfBody], -1));
						// left transport: ⊢ X R NY from ⊢ NX R NY
						xRny = ruFwdMkRule(hid, ids.wff, [RuExp(xs, -1), RuExp(ny.first, -1)]);
						step1 = switch (nx.second) {
							None(): sStep; // X == NX syntactically
							Some(px): {
								eqX = ruFwdMkRule(wceq, wff, [RuExp(xs, -1), RuExp(nx.first, -1)]);
								bi  = ruFwdMkRule(ids.wb, ids.wff, [xRny, nfBody]);
								lem = if (hid == ids.wss) ids.sseq1 else ids.eleq1;
								lemStep = RuProofStep(lem, [], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [eqX, bi])], -1));
								biStep = RuProofStep(ids.axmp, [px, lemStep], RuStmt(stcl, [bi], -1));
								RuProofStep(eids.mpbir, [sStep, biStep], RuStmt(stcl, [xRny], -1));
							}
						};
						// right transport: ⊢ X R Y from ⊢ X R NY
						bodyExp = RuExp(body, -1);
						switch (ny.second) {
							None(): step1; // Y == NY syntactically
							Some(py): {
								eqY = ruFwdMkRule(wceq, wff, [RuExp(ys, -1), RuExp(ny.first, -1)]);
								bi2 = ruFwdMkRule(ids.wb, ids.wff, [bodyExp, xRny]);
								lem2 = if (hid == ids.wss) ids.sseq2 else ids.eleq2;
								lemStep2 = RuProofStep(lem2, [], RuStmt(stcl, [ruFwdMkRule(ids.wi, ids.wff, [eqY, bi2])], -1));
								biStep2 = RuProofStep(ids.axmp, [py, lemStep2], RuStmt(stcl, [bi2], -1));
								RuProofStep(eids.mpbir, [step1, biStep2], RuStmt(stcl, [bodyExp], -1));
							}
						};
					});
				}
			}
		}
	}
}

// Cap on total forward facts per wave: once the front index reaches it, stop expanding
// the remaining frontier facts this wave. Mirrors the depth-bounded ruMaybeBuildForwardFront
// (forward-search-size). WITHOUT it a single unguided wave under a wide scope (e.g. checker-scope)
// explodes — running for minutes and consuming the whole prove-command budget, which STARVES the
// other theorems in a sequential run (they never even start). A LIMIT, not a variant discard:
// stopping under a bound is allowed by the completeness invariant (never MISS a reachable proof
// within the bound; giving up past it is fine). Overridable via forward-search-size.
