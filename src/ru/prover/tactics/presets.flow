import ru/prover/tactics/refiners;

// PRESETS — named COMPOSITIONS of the primitive tactic vocabulary, NOT atoms. A preset is pure sugar:
// it expands to a tactic-DSL STRING built only from atoms/combinators/guides/realizers, which the DSL
// then parses and builds like any other tactic. Presets live here (separate from the atom dispatch in
// dsl.flow) precisely because they are not primary building blocks — they are convenient recipes over
// them. Each expansion is a pure (args -> string) function with no dependency on the build machinery,
// so this file does not import dsl.flow (dsl.flow imports this one and supplies the parse+build glue).
//
// The single member today is `def-close`. Add future recipes here the same way (a name in
// ruPresetNames + a *Expansion function), and a `presets`-category doc entry in dsl.flow.

export {
	// Names dispatched as presets (expanded, not built directly). dsl.flow checks this set.
	ruPresetNames() -> [string];

	// def-close == try the residual-refiner guide, falling back to its De Morgan (nnf) variant:
	//   or-else( replay(refine(<refiners>,         budget)),
	//            replay(refine(<refiners>, nnf=on, budget)) )
	// or-else builds the nnf=on alternative ONLY if the nnf=off one finishes without a proof, so the
	// expensive second guide-build is lazy — matching the old hand-written gbOn gate, now lossless via
	// the combinator. `closerStr` is "" or a pre-serialized ", closer=<tactic>" suffix.
	ruDefCloseExpansion(md : int, ms : int, tl : int, closerStr : string) -> string;
}

ruPresetNames() -> [string] { ["def-close"] }

ruDefCloseExpansion(md : int, ms : int, tl : int, closerStr : string) -> string {
	refiners = strGlue(ruRefinerNames(), ", ");   // "strip-forall, rel-intro, eq-rewrite"
	budget   = "max-depth=" + i2s(md) + ", max-size=" + i2s(ms) + ", time-limit=" + i2s(tl) + closerStr;
	off = "replay(refine(" + refiners + ", " + budget + "))";
	on  = "replay(refine(" + refiners + ", nnf=on, " + budget + "))";
	"or-else(" + off + ", " + on + ")";
}
