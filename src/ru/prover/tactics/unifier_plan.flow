import ru/prover/tactics/equalizer_plan;

// THE UNIFIER PLANNER — decision core (planner-executor architecture).
//
// Transcribed from the original Mizar checker (~/dev/system/kernel/):
//   checker.pas   InferenceChecker: PreCheck normalizes premises ∧ ¬conclusion into
//                 DNF over literals; EVERY disjunct must be refuted (Contr > 0).
//   equalizer.pas Equate builds eq-classes from the disjunct's positive equalities;
//                 ContradictionVerify refutes by reflexivity (Contr 19) or by a
//                 PosBas/NegBas literal clash modulo classes (Contr 20).
//   unifier.pas   Unification: for each UNIVERSAL premise P, Verify(P) strips the
//                 quantifiers into FREE unification variables, normalizes ¬P into
//                 clauses (NormalizeAsFalse), computes per signed literal the
//                 InstCollection — the set of partial substitutions
//                 freeVar -> eq-class under which the basis FORCES that literal
//                 (COMPInstAsTrue/AsFalse: match against PosBas/NegBas modulo
//                 eq-classes, UNITrm descends through per-functor occurrence
//                 lists) — and MEETS them across the clause (JoinInstList). A
//                 nonempty meet = an instance of P false against the basis =
//                 contradiction (Contr 45). Premise PAIRS (Contr 47) and the
//                 Fraenkel cases (48/49) are NOT transcribed in this first cut.
//
// The mapping into our context: the theorem's ∀-stripped goal matrix, negated, is
// conjoined with the hypotheses and normalized to DNF — each disjunct is one ground
// literal set (one PreCheck case). Eq-classes over the disjunct come from the EXISTING
// proof-producing congruence closure (congruence.flow). Universal premises are the
// ∀-closed cited assertions, their matrices' vars the free unification variables; the
// InstCollection lattice is transcribed directly (substitutions are partial maps
// var -> eq-class representative key; UnionWith = OR with dedup, JoinWith = AND by
// compatible merge, Top = the empty substitution, Bottom = the empty collection).
//
// This module is the PLANNER'S BRAIN only: it decides and records WHAT refutes each
// disjunct (premise + binding); it never touches the PVT and builds no proofs. The
// deterministic generator comes on top of the decision (the Equalizer pattern).
//
// KNOWN v1 INCOMPLETENESS (each a measured Mizar feature, deferred):
//  - ground subterms of a premise pattern are compared by KEY, not registered into the
//    DAG first (Mizar YTerm-registers them; unknown-term reprs are their own keys);
//  - no premise pairs (Contr 47), no Fraenkel (48/49), no arithmetic requirements;
//  - inner-quantified subformulas are OPAQUE atoms, matched structurally modulo
//    classes (Mizar standardizes bound vars; we require same binder skeleton).

export {
	RuUnfPlan(
		provable  : bool,
		disjuncts : int,           // PreCheck cases (DNF disjuncts of hyps ∧ ¬goal)
		refuted   : int,           // how many of them closed
		premises  : int,           // universal premises offered
		overflow  : bool,          // a cap fired — verdict only "not decided"
		cases : [RuUnfCase]        // one per refuted disjunct, in DNF order
	);

	// One decided case — THE PLANNER ARTIFACT (three-layer architecture): the
	// disjunct's ground literals PLUS how it was refuted. The completeness law:
	// the record must be rich enough for the completer to REPLAY without search.
	RuUnfCase(lits : [RuUnfLit], refutation : RuUnfRefutation);

	// How one disjunct was refuted — the generator's replay currency.
	RuUnfRefutation ::= RuUnfByContradiction, RuUnfByReflexivity, RuUnfByAtomClash, RuUnfByPremise, RuUnfByPair;
		// complementary literal pair, syntactic (PreCheck-trivial)
		RuUnfByContradiction(lit : RuExp);
		// ¬(l = r) with l ~ r in the closure (Contr 19)
		RuUnfByReflexivity(l : RuExp, r : RuExp);
		// A and ¬A' with A ~ A' modulo classes (Contr 20)
		RuUnfByAtomClash(pos : RuExp, neg : RuExp);
		// an instance of universal premise assId is false against the basis (Contr 45):
		// bind maps the premise's matrix vars to eq-class REPRESENTATIVE terms
		RuUnfByPremise(assId : int, bind : Tree<int, RuExp>);
		// a PAIR of premise instances is jointly false (Contr 47, resolution-lite):
		// the two instances contain a complementary literal pair that unifies, and
		// every remaining literal is forced against the basis. May pair a premise
		// WITH ITSELF (two instances). Replay = both σP instances as facts — the
		// complementary pair clashes syntactically after instantiation.
		RuUnfByPair(assId1 : int, bind1 : Tree<int, RuExp>,
			assId2 : int, bind2 : Tree<int, RuExp>);

	// A signed ground literal of a disjunct.
	RuUnfLit(pos : bool, atom : RuExp);

	// A universal premise: the ∀-stripped matrix (any wff shape, EXCLUDING plain
	// equalities — those are the Equalizer's fragment) and its matrix vars.
	// charShape marks a membership CHARACTERIZATION (bicond with a ∈-headed lhs,
	// the elpr/elsn/elun family) — the A-map reuse keeps these in the FOUNDATION
	// under set.mm names, so by-lists never cite them; admit them like defs.
	RuUnfPremise(assId : int, matrix : RuExp, vars : [int], foundational : bool,
		charShape : bool);

	// Every ∀-closed 0-hyp non-equality assertion PRECEDING the theorem (the
	// reachability law). The caller narrows by the by-list (the probe does).
	ruUnfScopePremises(math : RuMath, env : RuEnv, thInfo : RuDeclInfo) -> [RuUnfPremise];

	// pair-loop diagnostics: (entries, unified candidate pairs, refutations)
	ruUnfPairStats : ref Triple<int, int, int>;

	// Decide `goal` (a possibly ∀-closed wff) from the hyps + universal premises.
	ruUnfPlanDecide(math : RuMath, env : RuEnv, stmtClass : int,
		prems : [RuUnfPremise], hyps : [RuExp], goal : RuExp,
		maxClauses : int, maxSubsts : int, budgetMs : double) -> RuUnfPlan;
}

// ---- caps (Mizar's LatOvfl analogues) ---------------------------------------

ruUnfMaxLitsPerClause = 32;

// ---- DNF over literals ------------------------------------------------------

// DNF of e (pos) / ¬e (neg) as clauses of signed literals; None = the clause cap
// fired. Inner-quantified subformulas and unknown heads are ATOMS.
ruUnfDnf(e : RuExp, pos : bool, maxClauses : int) -> Maybe<[[RuUnfLit]]> {
	ruUnfDnfX(e, pos, maxClauses, ref [], ref makeSet());
}

// The standardizing DNF (Mizar RemoveIntQuantifier): a binder in EXISTENTIAL
// position — ¬∀xφ (≡ ∃x¬φ) or ∃xφ — strips into a FRESH free variable, recorded
// in `fresh`: a unification var on the premise side, a Skolem constant on the
// basis side. Universal-position binders stay OPAQUE atoms. A re-bound or
// non-simple binder var bails to opaque (no renaming machinery in v2).
ruUnfDnfX(e : RuExp, pos : bool, maxClauses : int, fresh : ref [int],
	bound : ref Set<int>) -> Maybe<[[RuUnfLit]]> {
	h = ruInHead(e);
	ar = ruInArity(e);
	args = \ -> ruInArgs(e);
	prod = \dl : Maybe<[[RuUnfLit]]>, dr : Maybe<[[RuUnfLit]]> ->
		maybeBind(dl, \l -> maybeBind(dr, \r ->
			if (length(l) * length(r) > maxClauses) None()
			else {
				// an OVERSIZED clause must fail the WHOLE normalization (overflow),
				// never be dropped: a dropped clause is a case silently claimed
				// refuted — the planner then declares provable on a truncated case
				// set (the census exposed vacuous disjuncts=0 decisions)
				built = map(l, \cl -> map(r, \cr -> concat(cl, cr)));
				if (exists(built, \row -> exists(row, \cls ->
						length(cls) > ruUnfMaxLitsPerClause))) None()
				else Some(concatA(built));
			}));
	sum = \dl : Maybe<[[RuUnfLit]]>, dr : Maybe<[[RuUnfLit]]> ->
		maybeBind(dl, \l -> maybeBind(dr, \r ->
			if (length(l) + length(r) > maxClauses) None() else Some(concat(l, r))));
	rec = \x : RuExp, p : bool -> ruUnfDnfX(x, p, maxClauses, fresh, bound);
	if (h == s2id("wn") && ar == 1) rec((args())[0], !pos)
	else if (h == s2id("wa") && ar == 2) {
		a = (args())[0]; b = (args())[1];
		if (pos) prod(rec(a, true), rec(b, true))
		else sum(rec(a, false), rec(b, false));
	} else if (h == s2id("wo") && ar == 2) {
		a = (args())[0]; b = (args())[1];
		if (pos) sum(rec(a, true), rec(b, true))
		else prod(rec(a, false), rec(b, false));
	} else if (h == s2id("wi") && ar == 2) {
		a = (args())[0]; b = (args())[1];
		if (pos) sum(rec(a, false), rec(b, true))
		else prod(rec(a, true), rec(b, false));
	} else if (h == s2id("wb") && ar == 2) {
		a = (args())[0]; b = (args())[1];
		if (pos) sum(
			prod(rec(a, true), rec(b, true)),
			prod(rec(a, false), rec(b, false)))
		else sum(
			prod(rec(a, true), rec(b, false)),
			prod(rec(a, false), rec(b, true)));
	} else if ((h == s2id("wal") && ar == 2 && !pos)
			|| (h == s2id("wex") && ar == 2 && pos)) {
		// existential position: strip the binder into a fresh free var
		bv = (args())[0];
		v = if (length(bv.nodes) == 1) ruEqzVarAt(bv.nodes, 0) else -1;
		if (v < 0 || containsSet(^bound, v)) Some([[RuUnfLit(pos, e)]])
		else {
			bound := insertSet(^bound, v);
			fresh := arrayPush(^fresh, v);
			rec((args())[1], pos);
		}
	} else Some([[RuUnfLit(pos, e)]]);
}

// ---- the substitution lattice (InstCollection) ------------------------------
//
// A substitution is a partial map matrixVar -> eq-class representative key.
// A collection is an array of substitutions: [] = Bottom, [empty map] = Top.

ruUnfTop() -> [Tree<int, string>] { [makeTree()] }

ruUnfSubKey(s : Tree<int, string>) -> string {
	foldTree(s, "", \k, v, acc -> acc + i2s(k) + ":" + v + ";");
}

// AND: pairwise compatible merge (Mizar JoinWith / JoinAtom)
ruUnfJoin(a : [Tree<int, string>], b : [Tree<int, string>], maxSubsts : int,
	ovfl : ref bool) -> [Tree<int, string>] {
	merged = fold(a, Pair([], makeSet()), \acc : Pair<[Tree<int, string>], Set<string>>, s1 ->
		fold(b, acc, \ac, s2 -> {
			if (length(ac.first) >= maxSubsts) { ovfl := true; ac; }
			else switch (fold(tree2pairs(s2), Some(s1), \m : Maybe<Tree<int, string>>, p ->
				maybeBind(m, \t -> switch (lookupTree(t, p.first)) {
					Some(v0): if (v0 == p.second) Some(t) else None();
					None(): Some(setTree(t, p.first, p.second));
				}))) {
				None(): ac;
				Some(m): {
					k = ruUnfSubKey(m);
					if (containsSet(ac.second, k)) ac
					else Pair(arrayPush(ac.first, m), insertSet(ac.second, k));
				}
			}
		}));
	merged.first;
}

// OR: union with dedup (Mizar UnionWith; the antichain absorption is skipped —
// dedup + the cap bound the collection instead)
ruUnfUnion(a : [Tree<int, string>], b : [Tree<int, string>], maxSubsts : int,
	ovfl : ref bool) -> [Tree<int, string>] {
	fold(b, Pair(a, buildSet(map(a, ruUnfSubKey))), \acc : Pair<[Tree<int, string>], Set<string>>, s -> {
		k = ruUnfSubKey(s);
		if (containsSet(acc.second, k)) acc
		else if (length(acc.first) >= maxSubsts) { ovfl := true; acc; }
		else Pair(arrayPush(acc.first, s), insertSet(acc.second, k));
	}).first;
}

// ---- the per-disjunct basis -------------------------------------------------

RuUnfBasis(
	st       : RuCongSt,                  // eq-classes over the disjunct's equalities
	members  : Tree<string, [RuExp]>,     // class representative key -> member terms
	reprTerm : Tree<string, RuExp>,       // representative key -> one member (readout)
	posAtoms : [RuExp],                   // non-equality atoms asserted true
	negAtoms : [RuExp],                   // non-equality atoms asserted false
	negEqs   : [Pair<RuExp, RuExp>],      // sides of negative equalities
	classTp  : int,
	coId     : int,
	maxSubsts : int,
	ovfl     : ref bool
);

ruUnfIsClassNode(n : RuExpNode, classTp : int) -> bool {
	switch (n) {
		RuVar(__, tp): tp == classTp;
		RuRuleNode(idT, __): ruIdType2Type(idT) == classTp;
	}
}

// maximal class-typed subterm slices of a wff
ruUnfClassTerms(e : RuExp, classTp : int) -> [RuExp] {
	ruUnfDoClassTerms(e.nodes, 0, length(e.nodes), classTp, []);
}

ruUnfDoClassTerms(nodes : [RuExpNode], i : int, end : int, classTp : int, acc : [RuExp]) -> [RuExp] {
	if (i >= end) acc
	else if (ruUnfIsClassNode(nodes[i], classTp)) {
		span = ruEqzSpan(nodes, i);
		ruUnfDoClassTerms(nodes, i + span, end, classTp, arrayPush(acc, RuExp(subrange(nodes, i, span), -1)));
	} else ruUnfDoClassTerms(nodes, i + 1, end, classTp, acc);
}

ruUnfIsEq(e : RuExp) -> bool { ruInHead(e) == s2id("wceq") && ruInArity(e) == 2 }

ruUnfMakeBasis(math : RuMath, env : RuEnv, stmtClass : int, lits : [RuUnfLit],
	maxSubsts : int) -> RuUnfBasis {
	classTp = tp2id_("class");
	coId = ruEqzCoercionId(math, env);
	rules = ruCongRulesCached(math);
	posEqs = filter(lits, \l -> l.pos && ruUnfIsEq(l.atom));
	facts = mapi(posEqs, \i, l -> Pair(RuProofHyp(i, RuStmt(stmtClass, [l.atom], -1)), l.atom));
	terms = fold(lits, [], \acc, l -> concat(acc, ruUnfClassTerms(l.atom, classTp)));
	st = ruCongClose(rules, facts, terms, stmtClass, math, env);
	// class-membership index over the closure's whole universe
	grouped = foldTree(^(st.terms), Pair(makeTree(), makeTree()),
		\k, t, acc : Pair<Tree<string, [RuExp]>, Tree<string, RuExp>> -> {
			r = ruCongRepr(st, t);
			Pair(setTree(acc.first, r, arrayPush(lookupTreeDef(acc.first, r, []), t)),
				if (containsKeyTree(acc.second, r)) acc.second else setTree(acc.second, r, t));
		});
	RuUnfBasis(st, grouped.first, grouped.second,
		filtermap(lits, \l -> if (l.pos && !ruUnfIsEq(l.atom)) Some(l.atom) else None()),
		filtermap(lits, \l -> if (!l.pos && !ruUnfIsEq(l.atom)) Some(l.atom) else None()),
		filtermap(lits, \l -> if (!l.pos && ruUnfIsEq(l.atom)) {
			ss = ruInArgs(l.atom);
			Some(Pair(ss[0], ss[1]));
		} else None()),
		classTp, coId, maxSubsts, ref false);
}

// ---- matching modulo eq-classes (UNITrm) ------------------------------------

// substitutions under which pattern CAN denote the class `classKey`
ruUnfMatchClass(b : RuUnfBasis, pat : [RuExpNode], patVars : Set<int>,
	classKey : string) -> [Tree<int, string>] {
	ground = !exists(pat, \n -> switch (n) {
		RuVar(id, __): containsSet(patVars, id);
		RuRuleNode(__, __): false;
	});
	if (ground) {
		if (ruCongRepr(b.st, RuExp(pat, -1)) == classKey) ruUnfTop() else [];
	} else {
		bindable =
			if (length(pat) == 1) ruEqzVarAt(pat, 0)
			else if (length(pat) == 2 && ruEqzIsCoercionAt(pat, 0, b.coId)) ruEqzVarAt(pat, 1)
			else -1;
		if (bindable >= 0 && containsSet(patVars, bindable))
			[setTree(makeTree(), bindable, classKey)]
		else {
			// structured pattern: descend through every same-head member of the class
			// (Mizar's per-functor EqList occurrence walk)
			members = lookupTreeDef(b.members, classKey, []);
			fold(members, [], \acc, m ->
				if (length(m.nodes) == 0 || !ruEqzSameNode(pat[0], m.nodes[0])) acc
				else {
					pArgs = ruInArgs(RuExp(pat, -1));
					mArgs = ruInArgs(m);
					if (length(pArgs) != length(mArgs)) acc
					else {
						joined = foldi(pArgs, ruUnfTop(), \i, ac, pa ->
							if (ac == []) ac
							else ruUnfJoin(ac,
								ruUnfMatchClass(b, pa.nodes, patVars, ruCongRepr(b.st, mArgs[i])),
								b.maxSubsts, b.ovfl));
						ruUnfUnion(acc, joined, b.maxSubsts, b.ovfl);
					}
				});
		}
	}
}

// wff-level structural match modulo classes: class-term boundaries delegate to
// ruUnfMatchClass; everything above them must agree node by node (opaque atoms
// with binders included — same skeleton, class holes modulo classes)
ruUnfMatchModC(b : RuUnfBasis, pat : [RuExpNode], patVars : Set<int>,
	term : [RuExpNode]) -> [Tree<int, string>] {
	if (length(pat) == 0 || length(term) == 0) []
	else if (ruUnfIsClassNode(pat[0], b.classTp)) {
		if (!ruUnfIsClassNode(term[0], b.classTp)) []
		else ruUnfMatchClass(b, pat, patVars, ruCongRepr(b.st, RuExp(term, -1)));
	} else {
		switch (pat[0]) {
			RuVar(vid, __): {
				// a bare setvar at a non-class position (a binder slot of an opaque
				// atom): only a bare var can stand in
				if (containsSet(patVars, vid)) {
					if (length(term) == 1 && ruEqzVarAt(term, 0) >= 0)
						[setTree(makeTree(), vid, ruCongRepr(b.st, RuExp(term, -1)))]
					else [];
				} else if (length(term) == 1 && term[0] == pat[0]) ruUnfTop() else [];
			}
			RuRuleNode(__, __): {
				if (!ruEqzSameNode(pat[0], term[0])) []
				else {
					pArgs = ruInArgs(RuExp(pat, -1));
					tArgs = ruInArgs(RuExp(term, -1));
					if (length(pArgs) != length(tArgs)) []
					else foldi(pArgs, ruUnfTop(), \i, ac, pa ->
						if (ac == []) ac
						else ruUnfJoin(ac, ruUnfMatchModC(b, pa.nodes, patVars, tArgs[i].nodes),
							b.maxSubsts, b.ovfl));
				}
			}
		}
	}
}

// ---- literal evaluators (COMPInstAsFalse / COMPInstAsTrue) ------------------

// substitutions under which the basis FORCES the literal's atom TRUE
ruUnfForcedTrue(b : RuUnfBasis, atom : RuExp, patVars : Set<int>) -> [Tree<int, string>] {
	if (ruUnfIsEq(atom)) {
		ss = ruInArgs(atom);
		// σl ~ σr: both sides denote ONE class (UnifyReflexive's shape)
		foldTree(b.members, [], \classKey, __, acc ->
			ruUnfUnion(acc,
				ruUnfJoin(
					ruUnfMatchClass(b, ss[0].nodes, patVars, classKey),
					ruUnfMatchClass(b, ss[1].nodes, patVars, classKey),
					b.maxSubsts, b.ovfl),
				b.maxSubsts, b.ovfl));
	} else {
		h = ruInHead(atom);
		fold(b.posAtoms, [], \acc, ba ->
			if (ruInHead(ba) != h) acc
			else ruUnfUnion(acc, ruUnfMatchModC(b, atom.nodes, patVars, ba.nodes),
				b.maxSubsts, b.ovfl));
	}
}

// substitutions under which the basis FORCES the literal's atom FALSE
ruUnfForcedFalse(b : RuUnfBasis, atom : RuExp, patVars : Set<int>) -> [Tree<int, string>] {
	if (ruUnfIsEq(atom)) {
		ss = ruInArgs(atom);
		// σ(l) in class(a), σ(r) in class(b) for a recorded ¬(a = b), both orientations
		fold(b.negEqs, [], \acc, ne -> {
			ka = ruCongRepr(b.st, ne.first);
			kb = ruCongRepr(b.st, ne.second);
			acc1 = ruUnfUnion(acc,
				ruUnfJoin(
					ruUnfMatchClass(b, ss[0].nodes, patVars, ka),
					ruUnfMatchClass(b, ss[1].nodes, patVars, kb),
					b.maxSubsts, b.ovfl),
				b.maxSubsts, b.ovfl);
			ruUnfUnion(acc1,
				ruUnfJoin(
					ruUnfMatchClass(b, ss[0].nodes, patVars, kb),
					ruUnfMatchClass(b, ss[1].nodes, patVars, ka),
					b.maxSubsts, b.ovfl),
				b.maxSubsts, b.ovfl);
		});
	} else {
		h = ruInHead(atom);
		fold(b.negAtoms, [], \acc, ba ->
			if (ruInHead(ba) != h) acc
			else ruUnfUnion(acc, ruUnfMatchModC(b, atom.nodes, patVars, ba.nodes),
				b.maxSubsts, b.ovfl));
	}
}

// ---- the per-premise Verify (Contr 45) --------------------------------------

// a nonempty substitution set under which an instance of the premise is FALSE
// against the basis; None = no clash
ruUnfVerifyPremise(b : RuUnfBasis, p : RuUnfPremise, maxClauses : int) -> Maybe<Tree<int, string>> {
	// fresh vars from standardized inner binders (∃-position) are unification
	// vars too — Mizar's ExGenerators; they need no grounding (an unbound one
	// means the clause is forced for an arbitrary witness)
	freshR : ref [int] = ref [];
	dnfM = ruUnfDnfX(p.matrix, false, maxClauses, freshR, ref buildSet(p.vars));
	patVars = buildSet(concat(p.vars, ^freshR));
	switch (dnfM) {
		None(): { b.ovfl := true; None(); }
		Some(clauses): fold(clauses, None(), \found, clause ->
			if (isSome(found)) found
			else {
				met = fold(clause, ruUnfTop(), \acc, lit ->
					if (acc == []) acc
					else {
						forced = if (lit.pos) ruUnfForcedTrue(b, lit.atom, patVars)
							else ruUnfForcedFalse(b, lit.atom, patVars);
						ruUnfJoin(acc, forced, b.maxSubsts, b.ovfl);
					});
				// only substitutions that ground EVERY matrix var stand (a partial
				// instance is not a premise instance)
				full = filter(met, \s -> forall(p.vars, \v -> containsKeyTree(s, v)));
				if (full == []) found else Some(full[0]);
			})
	}
}

// ---- the per-disjunct refutation --------------------------------------------

ruUnfRefuteDisjunct(math : RuMath, env : RuEnv, stmtClass : int, prems : [RuUnfPremise],
	lits : [RuUnfLit], maxClauses : int, maxSubsts : int, timer : RuTimer,
	ovflOut : ref bool) -> Maybe<RuUnfRefutation> {
	// PreCheck-trivial: complementary syntactic pair
	posKeys = buildSet(filtermap(lits, \l -> if (l.pos) Some(l.atom.nodes) else None()));
	trivial = find(lits, \l -> !l.pos && containsSet(posKeys, l.atom.nodes));
	switch (trivial) {
		Some(l): Some(RuUnfByContradiction(l.atom));
		None(): {
			b = ruUnfMakeBasis(math, env, stmtClass, lits, maxSubsts);
			// Contr 19: ¬(l = r) with l ~ r
			refl = find(b.negEqs, \ne -> ruCongEqual(b.st, ne.first, ne.second));
			res = switch (refl) {
				Some(ne): Some(RuUnfByReflexivity(ne.first, ne.second));
				None(): {
					// Contr 20: A vs ¬A' modulo classes (ground modC match, no vars)
					clash = fold(b.posAtoms, None(), \acc, pa ->
						if (isSome(acc)) acc
						else fold(b.negAtoms, acc, \ac, na ->
							if (isSome(ac)) ac
							else if (ruInHead(pa) != ruInHead(na)) ac
							else if (ruUnfMatchModC(b, pa.nodes, makeSet(), na.nodes) != [])
								Some(RuUnfByAtomClash(pa, na))
							else ac));
					switch (clash) {
						Some(__): clash;
						None(): {
							// Contr 45: one universal premise clashes
							c45 = fold(prems, None(), \acc, p ->
								if (isSome(acc) || ruTimeIsOver(timer)) acc
								else switch (ruUnfVerifyPremise(b, p, maxClauses)) {
									None(): acc;
									Some(s): {
										bt = foldTree(s, makeTree(), \v, k, bt0 ->
											switch (lookupTree(b.reprTerm, k)) {
												Some(t): setTree(bt0, v, t);
												None(): bt0;
											});
										// MIZAR TYPE FIDELITY (the velpr trap): a SETVAR
										// LOCUS (matrix var that is NOT a ∀-binder of the
										// original assertion) can only take a plain
										// (coerced) var — an ill-typed substitution makes
										// an unbuildable instance; SKIP the premise so the
										// loop reaches its class-metavar twin (elpr).
										if (ruUnfBindTyped(math, env, p, bt)) Some(RuUnfByPremise(p.assId, bt))
										else acc;
									}
								});
							switch (c45) {
								Some(__): c45;
								None():
									// Contr 47: a PAIR of premises clashes jointly
									// (resolution-lite; Mizar's UNIVPair loop)
									ruUnfPairs(math, env, b, prems, maxClauses, timer);
							}
						}
					}
				}
			}
			ovflOut := ^ovflOut || ^(b.ovfl);
			res;
		}
	}
}

// ---- the decision -----------------------------------------------------------

ruUnfPlanDecide(math : RuMath, env : RuEnv, stmtClass : int,
	prems : [RuUnfPremise], hyps : [RuExp], goal : RuExp,
	maxClauses : int, maxSubsts : int, budgetMs : double) -> RuUnfPlan {
	timer = ruMakeLimitedTimer(budgetMs);
	matrix = ruEqzStripAlls(goal);
	// disjuncts = DNF(¬matrix ∧ hyps) — Mizar PreCheck's normal form. One SHARED
	// binder set across goal + hyps: ∃-position binders strip into Skolem
	// CONSTANTS, and a reused binder name must bail to opaque, not alias two
	// distinct witnesses.
	skBound : ref Set<int> = ref makeSet();
	skFresh : ref [int] = ref [];
	dnfM = fold(hyps, ruUnfDnfX(matrix, false, maxClauses, skFresh, skBound), \acc, h ->
		maybeBind(acc, \cls -> maybeBind(ruUnfDnfX(ruEqzStripAlls(h), true, maxClauses, skFresh, skBound), \hc ->
			if (length(cls) * length(hc) > maxClauses) None()
			else Some(concatA(map(cls, \cl -> map(hc, \hcl -> concat(cl, hcl))))))));
	switch (dnfM) {
		None(): RuUnfPlan(false, 0, 0, length(prems), true, []);
		Some(disjuncts): {
			ovfl = ref false;
			refs = fold(disjuncts, Pair([], true), \acc : Pair<[RuUnfCase], bool>, d ->
				if (!acc.second || ruTimeIsOver(timer)) Pair(acc.first, false)
				else switch (ruUnfRefuteDisjunct(math, env, stmtClass, prems, d,
						maxClauses, maxSubsts, timer, ovfl)) {
					None(): Pair(acc.first, false);
					Some(r): Pair(arrayPush(acc.first, RuUnfCase(d, r)), true);
				});
			RuUnfPlan(refs.second && length(refs.first) == length(disjuncts),
				length(disjuncts), length(refs.first), length(prems),
				^ovfl || ruTimeIsOver(timer), refs.first);
		}
	}
}

// ---- scope premises ---------------------------------------------------------

ruUnfScopePremises(math : RuMath, env : RuEnv, thInfo : RuDeclInfo) -> [RuUnfPremise] {
	imported = ruVerifyImportedMap(math, env);
	isFoundation = \src : int -> switch (lookupTree(math.sources, src)) {
		Some(sc): { m = sc.info.module; m == "miz_set" || endsWith(m, "/miz_set"); }
		None(): true;
	}
	filtermap(getTreeValues(math.decls.assertions), \ass -> {
		inf = ruEqzInfer(ass);
		info = ruEqzInfo(ass);
		// setness-only hyps (T ∈ _V) are admissible side conditions — the elpr
		// family carries them; the executor discharges them mechanically
		hypsOk = forall(inf.hyps, \h -> h.stmt.exps != []
			&& ruEqzIsSetnessHyp(ruExp(h.stmt.exps[0])));
		if (!hypsOk || inf.prop.exps == []) None()
		else if (!ruDeclInfoPreceeds(info, thInfo, imported)) None()
		else {
			matrix = ruEqzStripAlls(ruExp(inf.prop.exps[0]));
			// plain equalities are the Equalizer's premise fragment — the Unifier
			// works the rest (implications, biconds, memberships, predicates)
			if (ruUnfIsEq(matrix)) None()
			else {
				vars = fold(matrix.nodes, makeSet(), \acc, n -> switch (n) {
					RuVar(id, __): insertSet(acc, id);
					RuRuleNode(__, __): acc;
				});
				charShape = ruInHead(matrix) == s2id("wb") && ruInArity(matrix) == 2
					&& ruInHead((ruInArgs(matrix))[0]) == s2id("wcel");
				if (isEmptySet(vars)) None()
				else Some(RuUnfPremise(info.id, matrix, set2array(vars),
					isFoundation(info.src), charShape));
			}
		}
	});
}

// Is the bind WELL-TYPED for the premise? Every SETVAR matrix var that is a
// LOCUS of the original assertion (not one of its leading ∀-binders — those
// instantiate at class terms via instTerm legally) must be bound to a plain
// (coerced) var. Synthetic prior-step premises have no assertion entry: all
// their matrix vars are stripped ∀-binders — always legal.
ruUnfBindTyped(math : RuMath, env : RuEnv, p : RuUnfPremise, bt : Tree<int, RuExp>) -> bool {
	switch (lookupTree(math.decls.assertions, p.assId)) {
		None(): true;
		Some(ass): {
			inf = ruEqzInfer(ass);
			if (inf.prop.exps == []) true
			else {
				coId = ruEqzCoercionId(math, env);
				setvarT = tp2id_("setvar");
				walId = s2id("wal");
				// leading ∀-binder var ids of the original prop
				binders = for(Pair(ruExp(inf.prop.exps[0]), makeSet()), \st : Pair<RuExp, Set<int>> ->
						ruInHead(st.first) == walId && ruInArity(st.first) == 2
						&& length(((ruInArgs(st.first))[0]).nodes) == 1,
					\st -> {
						args = ruInArgs(st.first);
						Pair(args[1], insertSet(st.second, ruEqzVarAt((args[0]).nodes, 0)));
					}).second;
				// matrix var types
				tps = fold(p.matrix.nodes, makeTree(), \a, n -> switch (n) {
					RuVar(vid, vtp): setTree(a, vid, vtp);
					RuRuleNode(__, __): a;
				});
				plainVar = \nodes : [RuExpNode] ->
					if (length(nodes) == 1) ruEqzVarAt(nodes, 0) >= 0
					else length(nodes) == 2 && ruEqzIsCoercionAt(nodes, 0, coId)
						&& ruEqzVarAt(nodes, 1) >= 0;
				foldTree(bt, true, \v, t, acc -> acc
					&& (containsSet(binders, v)
						|| lookupTreeDef(tps, v, -1) != setvarT
						|| plainVar(t.nodes)));
			}
		}
	}
}

// ---- Contr 47: premise pairs (unifier.pas Unification's UNIVPair loop) ------

// The var-id offset distinguishing the SECOND copy's variables (a premise may
// pair with itself — two independent instances).
ruUnfPairOffset = 1073741824;

// diagnostics: pair-loop entries / candidate pairs unified / refutations found
ruUnfPairStats : ref Triple<int, int, int> = ref Triple(0, 0, 0);

// Bilateral structural unification modulo eq-classes: like ruUnfMatchModC but
// with pattern vars on BOTH sides — at a class boundary the two sides must
// denote ONE common class (enumerated; var-var pairs unify through it).
ruUnfUnifyModC(b : RuUnfBasis, pat1 : [RuExpNode], patVars : Set<int>,
	pat2 : [RuExpNode]) -> [Tree<int, string>] {
	if (length(pat1) == 0 || length(pat2) == 0) []
	else if (ruUnfIsClassNode(pat1[0], b.classTp) && ruUnfIsClassNode(pat2[0], b.classTp))
		foldTree(b.members, [], \classKey, __, acc ->
			ruUnfUnion(acc,
				ruUnfJoin(
					ruUnfMatchClass(b, pat1, patVars, classKey),
					ruUnfMatchClass(b, pat2, patVars, classKey),
					b.maxSubsts, b.ovfl),
				b.maxSubsts, b.ovfl))
	else {
		switch (pat1[0]) {
			RuVar(__, __):
				// non-class (binder-slot) positions: identical nodes only in v1
				if (length(pat1) == 1 && length(pat2) == 1 && ruEqzSameNode(pat1[0], pat2[0]))
					ruUnfTop() else [];
			RuRuleNode(__, __): {
				if (!ruEqzSameNode(pat1[0], pat2[0])) []
				else {
					args1 = ruInArgs(RuExp(pat1, -1));
					args2 = ruInArgs(RuExp(pat2, -1));
					if (length(args1) != length(args2)) []
					else foldi(args1, ruUnfTop(), \i, ac, a1 ->
						if (ac == []) ac
						else ruUnfJoin(ac, ruUnfUnifyModC(b, a1.nodes, patVars, args2[i].nodes),
							b.maxSubsts, b.ovfl));
				}
			}
		}
	}
}

// The pair loop: for each premise pair (i, j >= i — self-pairs included), the
// second copy's vars offset; both matrices normalized AS FALSE to ONE clause
// each (the v1 shape gate); across the two clauses EXACTLY ONE complementary
// same-head literal pair must unify (Mizar's <=1 limit), and every remaining
// literal of both clauses must be forced against the basis. Structural gates:
// premise count <= 24, single-clause DNFs.
ruUnfPairs(math : RuMath, env : RuEnv, b : RuUnfBasis, prems0 : [RuUnfPremise],
	maxClauses : int, timer : RuTimer) -> Maybe<RuUnfRefutation> {
	// Mizar's UNIV is the BASIS's universal statements — small by construction.
	// With a narrow (by-cited) scope, pair everything; in wholesale mode pair
	// only the synthetic prior-step ∀-premises (ids outside the assertion
	// index) — the closest analog of "universal statements present in PosBas".
	prems = if (length(prems0) <= 24) prems0
		else filter(prems0, \p -> !containsKeyTree(math.decls.assertions, p.assId));
	if (length(prems) > 24) None()
	else {
		ruUnfPairStats := Triple((^ruUnfPairStats).first + 1, (^ruUnfPairStats).second, (^ruUnfPairStats).third);
		shift = \e : RuExp, vs : [int] -> RuExp(map(e.nodes, \n -> switch (n) {
			RuVar(vid, vtp): if (contains(vs, vid)) RuVar(vid + ruUnfPairOffset, vtp) else n;
			RuRuleNode(__, __): n;
		}), e.pos);
		clauseOf = \m : RuExp -> switch (ruUnfDnf(m, false, maxClauses)) {
			Some(cls): if (length(cls) == 1) Some(cls[0]) else None();
			None(): None();
		};
		foldi(prems, None(), \i, accI : Maybe<RuUnfRefutation>, p1 ->
			if (isSome(accI) || ruTimeIsOver(timer)) accI
			else switch (clauseOf(p1.matrix)) {
				None(): accI;
				Some(c1): fold(enumFromTo(i, length(prems) - 1), accI, \accJ : Maybe<RuUnfRefutation>, j ->
					if (isSome(accJ) || ruTimeIsOver(timer)) accJ
					else {
						p2 = prems[j];
						switch (clauseOf(shift(p2.matrix, p2.vars))) {
							None(): accJ;
							Some(c2): {
								patVars = buildSet(concat(p1.vars, map(p2.vars, \v -> v + ruUnfPairOffset)));
								// complementary same-head literal pairs across the clauses
								cands = fold(enumFromTo(0, length(c1) - 1), [], \ca : [Triple<int, int, [Tree<int, string>]>], ai ->
									fold(enumFromTo(0, length(c2) - 1), ca, \ca2, bi -> {
										la = c1[ai]; lb = c2[bi];
										if (la.pos == lb.pos || ruInHead(la.atom) != ruInHead(lb.atom)) ca2
										else {
											sh = ^ruUnfPairStats;
											ruUnfPairStats := Triple(sh.first, sh.second + 1, sh.third);
											u = ruUnfUnifyModC(b, la.atom.nodes, patVars, lb.atom.nodes);
											if (u == []) ca2 else arrayPush(ca2, Triple(ai, bi, u));
										}
									}));
								if (length(cands) != 1) accJ   // Mizar's exactly-one limit
								else {
									cand = cands[0];
									// join with every remaining literal, both clauses
									rem = concat(
										filtermap(mapi(c1, \ai, l -> Pair(ai, l)), \pr ->
											if (pr.first == cand.first) None() else Some(pr.second)),
										filtermap(mapi(c2, \bi, l -> Pair(bi, l)), \pr ->
											if (pr.first == cand.second) None() else Some(pr.second)));
									met = fold(rem, cand.third, \ac, lit ->
										if (ac == []) ac
										else ruUnfJoin(ac,
											if (lit.pos) ruUnfForcedTrue(b, lit.atom, patVars)
											else ruUnfForcedFalse(b, lit.atom, patVars),
											b.maxSubsts, b.ovfl));
									allVars = concat(p1.vars, map(p2.vars, \v -> v + ruUnfPairOffset));
									full = filter(met, \sub -> forall(allVars, \v -> containsKeyTree(sub, v)));
									if (full == []) accJ
									else {
										sub = full[0];
										mkBind = \vs : [int], off : int ->
											fold(vs, makeTree(), \bt, v ->
												switch (lookupTree(sub, v + off)) {
													None(): bt;
													Some(k): switch (lookupTree(b.reprTerm, k)) {
														Some(t): setTree(bt, v, t);
														None(): bt;
													}
												});
										bind1 = mkBind(p1.vars, 0);
										bind2 = mkBind(p2.vars, ruUnfPairOffset);
										if (ruUnfBindTyped(math, env, p1, bind1)
											&& ruUnfBindTyped(math, env, p2, bind2)) {
											s1 = ^ruUnfPairStats;
											ruUnfPairStats := Triple(s1.first, s1.second, s1.third + 1);
											Some(RuUnfByPair(p1.assId, bind1, p2.assId, bind2));
										} else accJ;
									}
								}
							}
						}
					});
			});
	}
}
