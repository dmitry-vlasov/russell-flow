import ru/prover/tactics/unifier_plan;
import ru/prover/tactics/unifier_complete;
import ru/prover/tactics/instantiate;
import ru/prover/tactics/unfold;
import ru/prover/tactics/hilbert;

// THE UNIFIER DIRECT GENERATOR (v1) — proofs for the planner's decisions, on the
// Equalizer's assembly-first pattern: NO proof search on any path.
//
// A decided step's refutations name the universal premises and their bindings
// (RuUnfByPremise). Constructively: the premise INSTANCES σP plus the step's
// basis facts entail the goal matrix PROPOSITIONALLY (the refutation showed
// basis ∧ ¬goal ∧ σP inconsistent), so:
//   facts   = basis literals (leaf-indexed into the REAL premise list)
//           + σP instances (assertion application over class metavars, setness
//             side hyps discharged mechanically, then the spcv/instTerm chain
//             per bound setvar, ax-mp-folded);
//   glue    = the COMPLETE propositional certificate (1 s wall);
//   closure = ruUnfoldSplice replaces the certificate's fact leaves with the
//             real proofs; ax-gen re-quantifies a ∀-closed goal.
// Declines are SAFE (no proof — the step just stays open): unbound binders stop
// the instantiation chain early (the remaining ∀ stays a fact as-is), Skolem-
// dependent decisions fail the certificate (its facts are the UNSTRIPPED hyps).

export {
	// basis: (fact expression, its index in the REAL premise list the enclosing
	// proof verifies against). stepPrems: synthetic ∀-premise assIds (prior
	// steps offered as universal premises) -> (real premise index, the ∀-closed
	// step expression).
	ruUnfStepProof(math : RuMath, env : RuEnv, stmtClass : int, plan : RuUnfPlan,
		basis : [Pair<RuExp, int>], stepPrems : Tree<int, Pair<int, RuExp>>,
		goal : RuExp) -> Maybe<Pair<RuProofTree, Set<RuDisj>>>;
}

ruUnfStepProof(math : RuMath, env : RuEnv, stmtClass : int, plan : RuUnfPlan,
	basis : [Pair<RuExp, int>], stepPrems : Tree<int, Pair<int, RuExp>>,
	goal : RuExp) -> Maybe<Pair<RuProofTree, Set<RuDisj>>> {
	matrix = ruEqzStripAlls(goal);
	instsM = fold(map(plan.cases, \c -> c.refutation), Some([]), \accM : Maybe<[Triple<RuExp, RuProofTree, Set<RuDisj>>]>, r ->
		maybeBind(accM, \acc -> switch (r) {
			RuUnfByPremise(assId, bind):
				maybeMap(ruUnfPremInstance(math, env, stmtClass, assId, bind, basis, stepPrems),
					\p -> arrayPush(acc, p));
			default: Some(acc);
		}));
	switch (instsM) {
		None(): None();
		Some(insts): {
			// dedup instances (several disjuncts may use the same one)
			uinsts = fold(insts, Pair([], makeSet()), \acc : Pair<[Triple<RuExp, RuProofTree, Set<RuDisj>>], Set<[RuExpNode]>>, t ->
				if (containsSet(acc.second, t.first.nodes)) acc
				else Pair(arrayPush(acc.first, t), insertSet(acc.second, t.first.nodes))).first;
			// SKOLEM DISCHARGE (Mizar's ∃-hyp opening, the S4 pattern): an ∃-headed
			// basis fact contributes its STRIPPED body — the certificate proves the
			// implication chain (body_1 → … → goal), then exlimiv per binder
			// (innermost first, DV(consequent, x)) and ax-mp against the ∃-hyp leaf
			// discharge each antecedent
			wffT = tp2id_("wff");
			exCands = filtermap(basis, \b ->
				if (ruInHead(b.first) != s2id("wex")) None()
				else {
					sb = ruUnfStripExes(b.first);
					if (sb.first == []) None() else Some(Triple(sb.first, sb.second, b));
				});
			// exlimiv DV guard: a binder var that occurs free in the goal matrix or
			// in another ∃-fact's stripped body lands in the discharge consequent,
			// where exlimiv demands disjointness — such a fact stays a PLAIN
			// (unstripped) basis fact instead (proved articles reuse var names
			// across steps, so the collision is common there)
			varIds = \e : RuExp -> fold(e.nodes, makeSet(), \a : Set<int>, n -> switch (n) {
				RuVar(vid, __): insertSet(a, vid);
				RuRuleNode(__, __): a;
			});
			matrixVarIds = varIds(matrix);
			candBinderIds = map(exCands, \xf -> fold(xf.first, makeSet(), \a : Set<int>, n -> switch (n) {
				RuVar(vid, __): insertSet(a, vid);
				RuRuleNode(__, __): a;
			}));
			candBodyIds = map(exCands, \xf -> varIds(xf.second));
			exFacts = filtermapi(exCands, \i, xf -> {
				clash = !isEmptySet(intersectSets(candBinderIds[i], matrixVarIds))
					|| foldi(exCands, false, \j, acc, __ -> acc || (j != i
						&& (!isEmptySet(intersectSets(candBinderIds[i], candBodyIds[j]))
							|| !isEmptySet(intersectSets(candBinderIds[i], candBinderIds[j])))));
				if (clash) None() else Some(xf);
			});
			exKeys = buildSet(map(exFacts, \xf -> xf.third.second));
			plain = filter(basis, \b -> !containsSet(exKeys, b.second));
			certGoal = fold(reverseA(exFacts), matrix, \acc, xf ->
				ruFwdMkRule(s2id("wi"), wffT, [xf.second, acc]));
			facts = concat(map(plain, \b -> b.first), map(uinsts, \t -> t.first));
			factProofs = concat(
				map(plain, \b -> RuProofHyp(b.second, RuStmt(stmtClass, [b.first], -1))),
				map(uinsts, \t -> t.second));
			em = RuEnvMath(math, env);
			conn = ruPConnectives();
			// goal == a fact verbatim: a bare hyp-leaf tree linearizes to an
			// EMPTY step list — wrap in notnoti/notnotri (the two cancel)
			mkRooted = \tr : RuProofTree -> switch (tr) {
				RuProofHyp(__, __): {
					nn = ruFwdMkRule(s2id("wn"), wffT,
						[ruFwdMkRule(s2id("wn"), wffT, [certGoal])]);
					RuProofStep(s2id("notnotri"),
						[RuProofStep(s2id("notnoti"), [tr],
							RuStmt(stmtClass, [nn], -1))],
						RuStmt(stmtClass, [certGoal], -1));
				}
				RuProofStep(__, __, __): tr;
			};
			// THE COMPLETER (three-layer architecture): fixed fragments from the
			// plan's recorded reasons — no search. TRANSITIONAL ORDER: the searching
			// glue still runs FIRST — completer-first was measured to cost slice
			// borderliners (zfmisc off=1 89→88/87, t64/t125: the tableau attempt +
			// bigger proof objects tax every step under wall-clock slices); the
			// completer catches the glue's DECLINES, so coverage only grows at zero
			// cost. The order flips (and the glue call dies) when the catalog covers
			// ByPremise + transport ([[planner-executor-architecture]]).
			completer = \ -> {
				cm = if (exFacts != []) None()
					else {
						v1 = if (uinsts != []) None()
							else ruUnfCompleteProof(stmtClass, wffT, plan, basis, matrix);
						switch (v1) {
							Some(t): Some(t);
							None(): ruUnfCompleteTableau(math, env, stmtClass, wffT, plan, basis,
								map(uinsts, \t -> Pair(t.first, t.second)), matrix);
						}
					};
				switch (cm) {
					None(): None();
					Some(ct): {
						if (env.conf.verbose >= 4) {
							env.out.println("      unf-completer: hit (glue declined)");
						} else {};
						Some(Pair(ruEqzGenWrap(goal, mkRooted(ct), stmtClass),
							fold(uinsts, makeSet(), \a, t -> mergeSets(a, t.third))));
					}
				}
			};
			// fo = the scanned atom-congruence table: the glue proof may transport
			// atoms across present equality facts (the t85-class steps close modulo
			// the congruence class the DECISION already used)
			switch (ruHilbertPropProofTimedTop(em, conn, wffT, stmtClass, facts, certGoal, 1000.0, Some(ruInAtomCongsCached(math)))) {
				None(): completer();
				Some(cert): {
					spliced = ruUnfoldSplice(cert.first, 0, factProofs);
					rooted = mkRooted(spliced);
					dvs0 = fold(uinsts, cert.second.disjs, \acc, t -> mergeSets(acc, t.third));
					// discharge the ∃-antecedents, outermost first
					dvsR = ref dvs0;
					discharged = fold(exFacts, Pair(rooted, certGoal), \cur : Pair<RuProofTree, RuExp>, xf -> {
						rest = (ruInArgs(cur.second))[1];
						restVars = fold(rest.nodes, makeSet(), \a, n -> switch (n) {
							RuVar(id, tp): insertSet(a, RuVar(id, tp));
							RuRuleNode(__, __): a;
						});
						impl = foldi(reverseA(xf.first), Pair(cur.first, xf.second), \bi, ac : Pair<RuProofTree, RuExp>, xv -> {
							ante = ruFwdMkRule(s2id("wex"), wffT, [RuExp([xv], -1), ac.second]);
							dvsR := fold(set2array(restVars), ^dvsR, \a, rv ->
								switch (xv) {
									RuVar(vid, vtp): insertSet(a, RuDisj(rv, RuVar(vid, vtp)));
									RuRuleNode(__, __): a;
								});
							Pair(RuProofStep(s2id("exlimiv"), [ac.first],
								RuStmt(stmtClass, [ruFwdMkRule(s2id("wi"), wffT, [ante, rest])], -1)),
								ante);
						});
						Pair(RuProofStep(s2id("ax-mp"), [
								RuProofHyp(xf.third.second, RuStmt(stmtClass, [xf.third.first], -1)),
								impl.first],
							RuStmt(stmtClass, [rest], -1)),
							rest);
					});
					Some(Pair(ruEqzGenWrap(goal, discharged.first, stmtClass), ^dvsR));
				}
			}
		}
	}
}

// strip the leading ∃-binders: ([binder var NODES, outermost first], the body)
ruUnfStripExes(e : RuExp) -> Pair<[RuExpNode], RuExp> {
	if (ruInHead(e) == s2id("wex") && ruInArity(e) == 2) {
		args = ruInArgs(e);
		if (length((args[0]).nodes) != 1) Pair([], e)
		else {
			inner = ruUnfStripExes(args[1]);
			Pair(concat([(args[0]).nodes[0]], inner.first), inner.second);
		}
	} else Pair([], e);
}

// The σP fact: base = a prior ∀-step's hyp leaf, or the assertion applied over
// its CLASS metavars (setness hyps discharged); then the ∀-chain instantiated
// binder by binder at the bound terms, ax-mp against instTerm's implication.
ruUnfPremInstance(math : RuMath, env : RuEnv, stmtClass : int, assId : int,
	bind : Tree<int, RuExp>, basis : [Pair<RuExp, int>],
	stepPrems : Tree<int, Pair<int, RuExp>>) -> Maybe<Triple<RuExp, RuProofTree, Set<RuDisj>>> {
	coId = ruEqzCoercionId(math, env);
	baseM = switch (lookupTree(stepPrems, assId)) {
		Some(bi): {
			e = bi.second;
			Some(Triple(e, RuProofHyp(bi.first, RuStmt(stmtClass, [e], -1)), makeSet()));
		}
		None(): switch (lookupTree(math.decls.assertions, assId)) {
			None(): None();
			Some(ass): {
				inf = ruEqzInfer(ass);
				if (inf.prop.exps == []) None()
				else {
					p0 = ruExp(inf.prop.exps[0]);
					binders = ruUnfBinders(p0);
					// SIMULTANEOUS LOCI RENAMING (the eqz t62 lesson): article premises
					// reuse the theorem's own var NAMES (∀x5∀x7 … instantiated at x5) —
					// instTerm rightly declines when the bound var occurs in the term.
					// Binder vars bound to PLAIN (coerced) vars are renamed in the ONE
					// 0-ref application (1-node slices keep the body coercion), then
					// stripped by sp; class-term-valued binders stay for instTerm.
					plainVarOf = \sl : [RuExpNode] ->
						if (length(sl) == 1) ruEqzVarAt(sl, 0)
						else if (length(sl) == 2 && ruEqzIsCoercionAt(sl, 0, coId)) ruEqzVarAt(sl, 1)
						else -1;
					p0VarIds = fold(p0.nodes, makeSet(), \a, n -> switch (n) {
						RuVar(id, __): insertSet(a, id);
						RuRuleNode(__, __): a;
					});
					renamed0 = filtermap(binders, \v -> switch (lookupTree(bind, v)) {
						None(): None();
						Some(t): {
							tv = plainVarOf(t.nodes);
							if (tv < 0) None() else Some(Pair(v, tv));
						}
					});
					// capture guard: a target either IS its own binder (identity) or a
					// name foreign to the whole premise; targets pairwise distinct
					renameOk = sizeSet(buildSet(map(renamed0, \r -> r.second))) == length(renamed0)
						&& forall(renamed0, \r -> r.second == r.first
							|| !containsSet(p0VarIds, r.second));
					renamed = if (renameOk) renamed0 else [];
					renamedSet = buildSet(map(renamed, \r -> r.first));
					setvarT = tp2id_("setvar");
					classBind = foldTree(bind, fold(renamed, makeTree(), \a, r ->
							setTree(a, r.first, [RuVar(r.second, setvarT)])), \v, t, acc ->
						if (contains(binders, v)) acc else setTree(acc, v, t.nodes));
					switch (ruEqzApply(p0.nodes, classBind, coId)) {
						None(): None();
						Some(instNodes): {
							inst0 = RuExp(instNodes, -1);
							reg = ruSetnessRegistry(math);
							hypProofs = fold(inf.hyps, Some([]), \hacc : Maybe<[RuProofTree]>, hyp ->
								maybeBind(hacc, \harr ->
									if (hyp.stmt.exps == []) None()
									else switch (ruEqzApply((ruExp(hyp.stmt.exps[0])).nodes, classBind, coId)) {
										None(): None();
										Some(hn): {
											he = RuExp(hn, -1);
											if (ruInHead(he) != s2id("wcel")) None()
											else maybeMap(
												ruSetnessProof2(reg, (ruInArgs(he))[0], stmtClass, math, env),
												\p -> arrayPush(harr, p));
										}
									}));
							// the strip plan, binder by binder: None = sp (renamed),
							// Some(t) = instTerm; the plan ends at the first unbound binder
							acts = fold(binders, Pair([], true), \ac : Pair<[Maybe<RuExp>], bool>, v ->
								if (!ac.second) ac
								else if (containsSet(renamedSet, v))
									Pair(arrayPush(ac.first, None()), true)
								else switch (lookupTree(bind, v)) {
									None(): Pair(ac.first, false);
									Some(t): Pair(arrayPush(ac.first, Some(t)), true);
								}).first;
							maybeBind(hypProofs, \hp -> ruUnfInstChain(math, env, stmtClass,
								Triple(inst0, RuProofStep(assId, hp, RuStmt(stmtClass, [inst0], -1)),
									makeSet()), acts));
						}
					}
				}
			}
		}
	}
	switch (lookupTree(stepPrems, assId)) {
		// a prior-step ∀-fact: no renaming machinery — instantiate what instTerm can
		Some(__): maybeBind(baseM, \base -> ruUnfInstChainBind(math, env, stmtClass, base, bind));
		None(): baseM;
	}
}

// strip chain over a prior-step ∀-fact: consult the bind per leading binder
ruUnfInstChainBind(math : RuMath, env : RuEnv, stmtClass : int,
	cur : Triple<RuExp, RuProofTree, Set<RuDisj>>,
	bind : Tree<int, RuExp>) -> Maybe<Triple<RuExp, RuProofTree, Set<RuDisj>>> {
	e = cur.first;
	if (ruInHead(e) != s2id("wal") || ruInArity(e) != 2) Some(cur)
	else {
		args = ruInArgs(e);
		v = if (length((args[0]).nodes) == 1) ruEqzVarAt((args[0]).nodes, 0) else -1;
		if (v < 0) Some(cur)
		else switch (lookupTree(bind, v)) {
			None(): Some(cur);
			Some(t): switch (ruInForallInstTerm(math, env, stmtClass, e, t)) {
				None(): None();
				Some(it): ruUnfInstChainBind(math, env, stmtClass,
					Triple(it.first,
						RuProofStep(s2id("ax-mp"), [cur.second, it.second],
							RuStmt(stmtClass, [it.first], -1)),
						mergeSets(cur.third, it.third)),
					bind);
			}
		}
	}
}

// outermost-first ∀-binder var ids of a ∀-closed expression
ruUnfBinders(e : RuExp) -> [int] {
	if (ruInHead(e) == s2id("wal") && ruInArity(e) == 2) {
		args = ruInArgs(e);
		v = if (length((args[0]).nodes) == 1) ruEqzVarAt((args[0]).nodes, 0) else -1;
		if (v < 0) [] else concat([v], ruUnfBinders(args[1]));
	} else [];
}

// strip chain by explicit plan: None = sp-strip a RENAMED binder (the target is
// already in place from the simultaneous application), Some(t) = instTerm at t
ruUnfInstChain(math : RuMath, env : RuEnv, stmtClass : int,
	cur : Triple<RuExp, RuProofTree, Set<RuDisj>>,
	acts : [Maybe<RuExp>]) -> Maybe<Triple<RuExp, RuProofTree, Set<RuDisj>>> {
	e = cur.first;
	if (acts == [] || ruInHead(e) != s2id("wal") || ruInArity(e) != 2) Some(cur)
	else {
		rest = (ruInArgs(e))[1];
		wffT = tp2id_("wff");
		switch (acts[0]) {
			None(): {
				impl = ruFwdMkRule(s2id("wi"), wffT, [e, rest]);
				ruUnfInstChain(math, env, stmtClass,
					Triple(rest,
						RuProofStep(s2id("ax-mp"), [cur.second,
							RuProofStep(s2id("sp"), [], RuStmt(stmtClass, [impl], -1))],
							RuStmt(stmtClass, [rest], -1)),
						cur.third),
					tail(acts));
			}
			Some(t): switch (ruInForallInstTerm(math, env, stmtClass, e, t)) {
				None(): None();
				Some(it): ruUnfInstChain(math, env, stmtClass,
					Triple(it.first,
						RuProofStep(s2id("ax-mp"), [cur.second, it.second],
							RuStmt(stmtClass, [it.first], -1)),
						mergeSets(cur.third, it.third)),
					tail(acts));
			}
		}
	}
}
