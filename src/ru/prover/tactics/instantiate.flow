import ru/prover/tactics/unfold;
import ru/prover/core/forward;
import ru/subst;
import ru/util/exp;
import ru/util/src2s;
import ru/verify/math;
import base/ids;
import ds/set;

// ---------------------------------------------------------------------------
// BOUNDED QUANTIFIER INSTANTIATION — the phase Mizar calls the UNIFIER (L2, general).
//
// Mizar's `by`-checker does not search for instantiations: it instantiates the universal
// facts it has at the TERMS THAT OCCUR in the problem, boundedly, and hands the resulting
// ground literals to the propositional/equality machinery. We had no such phase at all, and
// it sits upstream of three of the four remaining failure classes on the general path:
//   - the ∅-family: a hypothesis `X = ∅` unfolds (eq0) to `∀v ¬(v ∈ X)` and is USELESS until
//     someone instantiates it at the terms in the goal (zfmisc t15: `({x5}∖{x8}) = ∅ ⊢ x5 ∈ {x8}`
//     needs exactly the instance at x5);
//   - the enumeration ∈-goals, which reduce to equalities only after such an instance;
//   - the refutations, which need the decided literal set the instances produce.
//
// THE RULE IS THE FOUNDATION'S OWN (spcv):
//     A ∈ _V ,  (x = A) → (φ ↔ ψ)   ⊢   (∀x φ → ψ)
// so an instance needs two things, and BOTH are derived mechanically, nothing hand-listed:
//   (1) SETNESS of the term — ruSetnessProof (unfold.flow), scanned from the 38 `T ∈ _V` lemmas;
//   (2) the SUBSTITUTION CONGRUENCE `(x = A) → (φ ↔ φ[A/x])`, built here by structural recursion
//       over φ from two mechanically-scanned tables:
//         - ATOM congruences, implication form:  (a = b) → (P(…a…) ↔ P(…b…))   [eleq1/eleq2/
//           eqeq1/eqeq2/sseq1/sseq2/…] — same structural test as the term congruences in
//           congruence.flow: same predicate head, differing in exactly ONE argument, which is
//           the antecedent's variable;
//         - CONNECTIVE congruences, deduction form:  (χ→(a↔b)), (χ→(c↔d)) ⊢ (χ→(F(a,c) ↔ F(b,d)))
//           [notbid/anbi12d/orbi12d/imbi12d/bibi12d].
//
// BOUNDED, as in Mizar: candidate terms are the setvars OCCURRING in the goal and premises,
// deduped and capped. No search, no unification — the terms are given by the problem.
//
// A φ with a nested BINDER is declined (albid needs a non-freeness side condition); Mizar
// instantiates the matrix too, so that is the next increment, not a special case.
// ---------------------------------------------------------------------------

export {
	// THE MIZAR SATURATION over the premises, one bounded pass, everything mechanical:
	//  (1) EMPTINESS AS A FIRST-CLASS LITERAL: a premise `X = ∅` carries its whole content in the
	//      ∀-form eq0 gives it — `∀v ¬(v ∈ X)` — but the eq0 unfold only fired REACTIVELY (when the
	//      goal already contained that ∀-atom), so the ∅-hypotheses were inert. Derive the ∀-form
	//      for every such premise, with a FRESH bound var (eq0 requires DV(A x)).
	//  (2) BOUNDED INSTANTIATION: every ∀-shaped premise (given or derived) instantiated at the
	//      setvars OCCURRING in the problem, via spcv, declaring spcv's DV provisos and declining
	//      when the bound var survives in the result.
	//  (3) REFLEXIVITY: `t = t` (equid) for every candidate — the literal `x=x` that instances'
	//      normalized forms bottom out on.
	// `hyps` carry their own proofs (a leaf for a real hypothesis, the derivation tree for a
	// derived one), so the returned facts are self-contained up to real-hyp leaves.
	// Returns the facts and the DV provisos their proofs require.
	ruInSaturate(math : RuMath, env : RuEnv, stmtClass : int,
		hyps : [Pair<RuProofTree, RuExp>], goal : RuExp, cap : int) -> Pair<[Pair<RuExp, RuProofTree>], Set<RuDisj>>;

	// An atom congruence `(a = b) → (P(…a…) ↔ P(…b…))`, keyed by the predicate head —
	// exported for the Hilbert emitter's PER-BRANCH equality transport (a case-split
	// branch's equality fact moves the other branch facts across it; mizar-complete-plan).
	RuInAtomCong(lemmaId : int, prop : RuExp, lhs : RuExp, rhs : RuExp, va : RuVar, vb : RuVar);
	ruInAtomCongsCached(math : RuMath) -> Tree<int, [RuInAtomCong]>;

	// S4b — ∃-GOAL WITNESS OPTIONS (the other half of skolemization): for a goal `∃x φ`,
	// each candidate term t occurring in the problem yields (ψ = φ[t/x], assemble, DV):
	// prove ψ and assemble(pf) concludes `∃x φ` by spcev (setness(t) + the substitution
	// congruence (x=t)→(φ↔ψ), both built mechanically). Candidates smallest-first, capped.
	RuInExWitness(subgoal : RuExp, assemble : (RuProofTree) -> RuProofTree, disjs : Set<RuDisj>);
	ruInExGoalWitnesses(math : RuMath, env : RuEnv, stmtClass : int, goal : RuExp, hyps : [RuExp], cap : int) -> [RuInExWitness];

	// S4c — RELATIONAL ∃-FORMS (the ELIM dual of the ∀-form scan): every premise matching a
	// scanned `R(A…) ↔ ∃x φ` bicond (eluni-shaped) derives its ∃-form `∃v φ[v/x]` (fresh
	// eigenvariable v, mpbi; DV(u, v) per premise var u) — which the residual's premise-side
	// skolemization then opens.
	ruInRelExistsFacts(math : RuMath, env : RuEnv, stmtClass : int, tabs : RuInTables,
		hyps : [Pair<RuProofTree, RuExp>], used : Set<int>, setvarT : int) -> Pair<[Pair<RuProofTree, RuExp>], Set<RuDisj>>;

	// S4c — GOAL-SIDE WITNESS IMPLICATIONS (the INTRO dual): when the goal is ∃-shaped or
	// matches a rel-∃ lhs, each witness candidate t yields the PROVED implication premise
	// `φ[t/x] → goal` (spcev chain; biimpri+syl across the bicond when the goal was matched,
	// not bare ∃). These join the saturated premise set, so the ordinary closers and the
	// certificate see the ∃-introduction propositionally.
	ruInExGoalImps(math : RuMath, env : RuEnv, stmtClass : int, goal : RuExp, hyps : [Pair<RuProofTree, RuExp>], cap : int) -> Pair<[Pair<RuExp, RuProofTree>], Set<RuDisj>>;
}

// TABLE CACHE. The three scans below walk the whole assertion index (~9800 on miz_set), and the
// residual closer calls this phase for EVERY goal — rebuilding them per call cost enough time that
// theorems which close as a single probe missed their stage slice in a whole-article run. Keyed by
// the index size, which is fixed for the duration of a run.
RuInTables(atoms : Tree<int, [RuInAtomCong]>, conns : Tree<int, RuInConnCong>, setness : Tree<int, [RuSetLemma]>,
	enums : Tree<int, [RuInEnumRule]>, rels : Tree<int, [RuInRelForall]>, exs : Tree<int, [RuInRelForall]>);
ruInTablesCache : ref [Pair<int, RuInTables>] = ref [];

ruInTables(math : RuMath) -> RuInTables {
	n = sizeTree(math.decls.assertions);
	c = ^ruInTablesCache;
	if (c != [] && c[0].first == n) c[0].second else ruInBuildTables(math, n);
}

ruInBuildTables(math : RuMath, n : int) -> RuInTables {
	t = RuInTables(ruInAtomCongs(math), ruInConnCongs(math), ruSetnessRegistry(math), ruInEnumRules(math),
		ruInRelForalls(math), ruInRelBinders(math, s2id("wex")));
	ruInTablesCache := [Pair(n, t)];
	t;
}


// ---- shared expression helpers ---------------------------------------------

ruInSpan(nodes : [RuExpNode], i : int) -> int {
	switch (nodes[i]) {
		RuVar(__, __): i + 1;
		RuRuleNode(__, al): fold(enumFromTo(1, ruArityLen2Arity(al)), i + 1, \pos, __ -> ruInSpan(nodes, pos));
	}
}

ruInHead(e : RuExp) -> int {
	switch (e.nodes[0]) { RuRuleNode(it, __): ruIdType2Id(it); RuVar(__, __): -1; }
}

ruInArity(e : RuExp) -> int {
	switch (e.nodes[0]) { RuRuleNode(__, al): ruArityLen2Arity(al); RuVar(__, __): 0; }
}

ruInArgs(e : RuExp) -> [RuExp] {
	nodes = e.nodes;
	fold(enumFromTo(1, ruInArity(e)), Pair(1, []), \acc, __ -> {
		end = ruInSpan(nodes, acc.first);
		Pair(end, arrayPush(acc.second, RuExp(subrange(nodes, acc.first, end - acc.first), -1)));
	}).second;
}

ruInInfer(a : RuAssertion) -> RuInference {
	switch (a) {
		RuAxiom(__, i): i; RuCong(__, i): i; RuTheorem(__, i, __, __): i; RuDef(__, i, __, __): i;
	}
}

ruInId(a : RuAssertion) -> int {
	switch (a) {
		RuAxiom(i, __): i.id; RuCong(i, __): i.id; RuTheorem(i, __, __, __): i.id; RuDef(i, __, __, __): i.id;
	}
}

ruInContains(e : RuExp, n : RuExpNode) -> bool { exists(e.nodes, \m -> m == n) }

// ---- the two mechanical congruence tables ----------------------------------

// The atom-congruence table via the shared table cache (for external per-branch callers).
ruInAtomCongsCached(math : RuMath) -> Tree<int, [RuInAtomCong]> {
	(ruInTables(math)).atoms;
}

// (a = b) → (P(…a…) ↔ P(…b…)) : keyed by the PREDICATE head (struct exported above).
ruInAtomCongs(math : RuMath) -> Tree<int, [RuInAtomCong]> {
	wiId = s2id("wi"); wbId = s2id("wb"); wceqId = s2id("wceq");
	fold(getTreeValues(math.decls.assertions), makeTree(), \acc, ass -> {
		inf = ruInInfer(ass);
		if (length(inf.hyps) != 0 || !isEmptySet(inf.vars.disjs)) acc else {
			prop = ruExp(inf.prop.exps[0]);
			if (ruInHead(prop) != wiId || ruInArity(prop) != 2) acc else {
				pa = ruInArgs(prop);
				ante = pa[0]; concl = pa[1];
				// antecedent must be an equality of two plain vars
				if (ruInHead(ante) != wceqId || ruInArity(ante) != 2) acc else {
					aa = ruInArgs(ante);
					switch (aa[0].nodes[0]) {
						RuRuleNode(__, __): acc;
						RuVar(ida, tpa): switch (aa[1].nodes[0]) {
							RuRuleNode(__, __): acc;
							RuVar(idb, tpb): {
								if (length(aa[0].nodes) != 1 || length(aa[1].nodes) != 1 || ida == idb) acc
								else if (ruInHead(concl) != wbId || ruInArity(concl) != 2) acc
								else {
									ca = ruInArgs(concl);
									l = ca[0]; r = ca[1];
									// same predicate head, differing in EXACTLY one argument = (va | vb)
									if (ruInHead(l) < 0 || ruInHead(l) != ruInHead(r) || ruInArity(l) != ruInArity(r) || ruInArity(l) == 0) acc
									else {
										la = ruInArgs(l); ra = ruInArgs(r);
										diffs = filter(enumFromTo(0, length(la) - 1), \i -> la[i].nodes != ra[i].nodes);
										if (length(diffs) != 1) acc else {
											i = diffs[0];
											va = RuVar(ida, tpa); vb = RuVar(idb, tpb);
											if (la[i].nodes != [va] || ra[i].nodes != [vb]) acc
											else {
												cur = lookupTreeDef(acc, ruInHead(l), []);
												setTree(acc, ruInHead(l), arrayPush(cur, RuInAtomCong(ruInId(ass), prop, l, r, va, vb)));
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	});
}

// (χ→(a↔b)), (χ→(c↔d)) ⊢ (χ→(F(a,c) ↔ F(b,d))) : keyed by the CONNECTIVE head F.
RuInConnCong(lemmaId : int, arity : int);

ruInConnCongs(math : RuMath) -> Tree<int, RuInConnCong> {
	wiId = s2id("wi"); wbId = s2id("wb");
	fold(getTreeValues(math.decls.assertions), makeTree(), \acc, ass -> {
		inf = ruInInfer(ass);
		nh = length(inf.hyps);
		if (nh == 0 || nh > 2 || !isEmptySet(inf.vars.disjs)) acc else {
			prop = ruExp(inf.prop.exps[0]);
			hyps = map(inf.hyps, \h -> ruExp(h.stmt.exps[0]));
			// every hyp: (χ → (p ↔ q)) with p,q distinct wff VARS; same χ throughout
			parts = filtermap(hyps, \h ->
				if (ruInHead(h) != wiId || ruInArity(h) != 2) None() else {
					ha = ruInArgs(h);
					bi = ha[1];
					if (ruInHead(bi) != wbId || ruInArity(bi) != 2) None() else {
						ba = ruInArgs(bi);
						isVar = \e -> length(e.nodes) == 1 && (switch (e.nodes[0]) { RuVar(__,__): true; RuRuleNode(__,__): false; });
						if (!isVar(ba[0]) || !isVar(ba[1])) None() else Some(Triple(ha[0], ba[0], ba[1]));
					}
				});
			if (length(parts) != nh) acc else {
				chi = parts[0].first;
				if (!forall(parts, \p -> p.first.nodes == chi.nodes)) acc
				else if (ruInHead(prop) != wiId || ruInArity(prop) != 2) acc
				else {
					pa = ruInArgs(prop);
					if (pa[0].nodes != chi.nodes) acc else {
						concl = pa[1];
						if (ruInHead(concl) != wbId || ruInArity(concl) != 2) acc else {
							ca = ruInArgs(concl);
							l = ca[0]; r = ca[1];
							// F(p1..pn) ↔ F(q1..qn), in the hyps' order
							ls = ruInArgs(l); rs = ruInArgs(r);
							ok = ruInHead(l) >= 0 && ruInHead(l) == ruInHead(r)
								&& length(ls) == nh && length(rs) == nh
								&& forall(enumFromTo(0, nh - 1), \i -> ls[i].nodes == parts[i].second.nodes && rs[i].nodes == parts[i].third.nodes);
							if (!ok) acc
							else if (containsKeyTree(acc, ruInHead(l))) acc   // first wins, deterministic
							else setTree(acc, ruInHead(l), RuInConnCong(ruInId(ass), nh));
						}
					}
				}
			}
		}
	});
}

// ---- the definitional-membership table (snid/prid1/prid2/tpid1-3 by SHAPE) --

// A lemma `v ∈ T(…v…)` (optionally under a setness hyp `v ∈ _V`): applying it at an
// enumeration term occurring in the problem yields the term's definitional membership
// fact — the ground literal Mizar's Equalizer knows for every enumerated set.
//   lemmaId    the assertion; prop its statement; tvars the constructor's arg vars in order;
//   argPos     which constructor arg is the member; hasSetness whether a `v ∈ _V` hyp
//              must be discharged (by the recursive setness prover).
RuInEnumRule(lemmaId : int, prop : RuExp, tvars : [RuVar], argPos : int, hasSetness : bool);

// Mechanical scan (nothing hand-listed): 0/1-hyp assertions, no DV, whose prop is
// `v ∈ T(v1…vn)` with v and every vi a plain class var, the vi distinct, v = v_argPos,
// and the hyp (when present) exactly `v ∈ _V`. On miz_set this finds snid, prid1/prid2,
// tpid1/tpid2/tpid3 — and any future enumeration constructor's lemma of the same shape.
ruInEnumRules(math : RuMath) -> Tree<int, [RuInEnumRule]> {
	wcelId = s2id("wcel");
	asVar = \e : RuExp -> if (length(e.nodes) != 1) None() else switch (e.nodes[0]) {
		RuVar(id, tp): Some(RuVar(id, tp));
		RuRuleNode(__, __): None();
	};
	fold(getTreeValues(math.decls.assertions), makeTree(), \acc, ass -> {
		inf = ruInInfer(ass);
		nh = length(inf.hyps);
		if (nh > 1 || !isEmptySet(inf.vars.disjs)) acc else {
			prop = ruExp(inf.prop.exps[0]);
			if (ruInHead(prop) != wcelId || ruInArity(prop) != 2) acc else {
				pa = ruInArgs(prop);
				switch (asVar(pa[0])) {
					None(): acc;
					Some(v): {
						t = pa[1];
						th = ruInHead(t);
						if (th < 0 || ruInArity(t) == 0) acc else {
							targs = map(ruInArgs(t), asVar);
							if (!forall(targs, isSome)) acc else {
								tvars = map(targs, \m -> either(m, ruNoVar));
								distinct = sizeSet(buildSet(map(tvars, \tv -> tv.id))) == length(tvars);
								pos = findiDef(tvars, \tv -> tv.id == v.id, -1);
								hypOk = nh == 0 || {
									h = ruExp(inf.hyps[0].stmt.exps[0]);
									ruInHead(h) == wcelId && ruInArity(h) == 2
										&& (ruInArgs(h))[0].nodes == pa[0].nodes
										&& ruInHead((ruInArgs(h))[1]) == s2id("cvv");
								};
								if (!distinct || pos < 0 || !hypOk) acc
								else {
									cur = lookupTreeDef(acc, th, []);
									setTree(acc, th, arrayPush(cur, RuInEnumRule(ruInId(ass), prop, tvars, pos, nh == 1)));
								}
							}
						}
					}
				}
			}
		}
	});
}

// ---- the substitution congruence (x = A) → (φ ↔ φ[A/x]) --------------------

RuInSubst(result : RuExp, proof : RuProofTree);

// `ante` = the equality (x = A) as an expression; `x` the bound var node; `t` the term A.
ruInSubstChain(atoms : Tree<int, [RuInAtomCong]>, conns : Tree<int, RuInConnCong>, biidd : int, wbId : int,
	ante : RuExp, x : RuExpNode, t : RuExp, phi : RuExp, stcl : int, math : RuMath, env : RuEnv) -> Maybe<RuInSubst> {
	mkImp = \a : RuExp, b : RuExp -> ruFwdMkRule(s2id("wi"), tp2id_("wff"), [a, b]);
	mkBi  = \a : RuExp, b : RuExp -> ruFwdMkRule(wbId, tp2id_("wff"), [a, b]);
	// φ does not mention x: (x=A) → (φ ↔ φ), by biidd (a1i of biid)
	if (!ruInContains(phi, x)) {
		Some(RuInSubst(phi, RuProofStep(biidd, [], RuStmt(stcl, [mkImp(ante, mkBi(phi, phi))], -1))));
	} else {
		head = ruInHead(phi);
		// a CONNECTIVE: recurse into the arguments, recombine with the deduction-form congruence
		switch (lookupTree(conns, head)) {
			Some(cc): {
				args = ruInArgs(phi);
				if (length(args) != cc.arity) None()
				else {
					subs = map(args, \a -> ruInSubstChain(atoms, conns, biidd, wbId, ante, x, t, a, stcl, math, env));
					if (!forall(subs, isSome)) None()
					else {
						rs = map(subs, \s -> either(s, RuInSubst(phi, RuProofHyp(0, ruNoStmt))));
						phi2 = ruFwdMkRule(head, tp2id_("wff"), map(rs, \r -> r.result));
						Some(RuInSubst(phi2, RuProofStep(cc.lemmaId, map(rs, \r -> r.proof),
							RuStmt(stcl, [mkImp(ante, mkBi(phi, phi2))], -1))));
					}
				}
			}
			// an ATOM mentioning x: rewrite the argument(s) that are x, one at a time
			None(): ruInSubstAtom(atoms, ante, x, t, phi, stcl, math, env);
		}
	}
}

// An atom P(…x…): apply the (a=b)→(P(a)↔P(b)) rule at each argument position that IS x.
// (Deeper occurrences — x inside a compound argument — are declined: they need the TERM
// congruences, which is the next increment.)
ruInSubstAtom(atoms : Tree<int, [RuInAtomCong]>, ante : RuExp, x : RuExpNode, t : RuExp,
	phi : RuExp, stcl : int, math : RuMath, env : RuEnv) -> Maybe<RuInSubst> {
	head = ruInHead(phi);
	args = ruInArgs(phi);
	// positions holding exactly x (as a bare node, possibly under a class coercion)
	posOf = filter(enumFromTo(0, length(args) - 1), \i -> args[i].nodes == [x] || (length(args[i].nodes) == 2 && args[i].nodes[1] == x));
	if (posOf == []) None()
	else fold(posOf, Some(RuInSubst(phi, ruNoProofTree)), \acc : Maybe<RuInSubst>, i -> switch (acc) {
		None(): None();
		Some(cur): {
			curPhi = cur.result;
			fold(lookupTreeDef(atoms, head, []), None(), \found : Maybe<RuInSubst>, r -> switch (found) {
				Some(__): found;
				None(): {
					// match the rule's LHS against the current atom, then bind vb to the term.
					// The rule must transport x ITSELF: its va metavar has to have matched the
					// bare/coerced x — eleq1 also matches (x5 ∈ x) structurally (va := x5), and
					// picking it transports the WRONG argument (the caller then discards the
					// result on the x-survival check: lost coverage for every arg-1 position).
					switch (ruMatchExp(curPhi, r.lhs, math, env)) {
						None(): None();
						Some(sub0): if (!(switch (lookupHashMap(sub0.map, r.va.id)) {
							None(): false;
							Some(se): se.exp.nodes == [x] || (length(se.exp.nodes) == 2 && se.exp.nodes[1] == x);
						})) None() else {
							m = copyHashMap(sub0.map);
							setHashMap(m, r.vb.id, RuSubExpr(r.vb, t, ruExpVarIdsHashSet(t)));
							sub = RuSubst(m);
							phi2 = ruApplySubst(r.rhs, sub);
							inst = ruApplySubst(r.prop, sub);
							step = RuProofStep(r.lemmaId, [], RuStmt(stcl, [inst], -1));
							// chain with what we already have (first position: the step IS the chain)
							switch (cur.proof) {
								RuProofHyp(__, __): Some(RuInSubst(phi2, step));
								RuProofStep(__, __, __): None();   // multi-position: declined (rare; needs bitrd)
							}
						}
					}
				}
			});
		}
	});
}

// ---- the phase ------------------------------------------------------------

// Candidate terms, Mizar-style: the setvars that OCCUR in the goal and the premises. No search —
// the problem supplies them. Deduped, capped.
// Candidates are ALL the class-typed TERMS occurring in the goal and premises — Mizar
// instantiates at the terms the problem mentions, not only at its variables. This includes the
// coerced setvar occurrences (the 2-node [unary class rule, setvar] slices — a bare setvar is
// NOT a candidate: the setness lemmas and congruences take the coerced form) and the compound
// terms ({x5}, (A∪B), …) whose setness the recursive setness prover discharges (snex/prex/
// inex1/…). Nothing is harvested by name. SMALLEST FIRST, deduped, capped: the small terms are
// the workhorses (variables, singletons), and under a cap the big products must not crowd
// them out.
ruInCandidates(goal : RuExp, hyps : [Pair<RuProofTree, RuExp>], setvarT : int, cap : int) -> [RuExp] {
	clsT = tp2id_("class");
	collect = \e : RuExp -> {
		n = e.nodes;
		filtermap(enumFromTo(0, length(n) - 1), \i -> switch (n[i]) {
			RuVar(__, __): None();
			RuRuleNode(idT, __): {
				if (ruIdType2Type(idT) != clsT) None()
				else Some(RuExp(subrange(n, i, ruInSpan(n, i) - i), -1));
			}
		});
	};
	// GOAL-DIRECTED breadth (Mizar's unifier is goal-driven): setvar candidates come from the
	// whole problem — they are the workhorses and cheap — but COMPOUND candidates only from the
	// GOAL. Problem-wide compounds multiplied every residual's premise set and starved the
	// general path's slices (zfmisc general 98 -> 92) without adding a single closure there.
	isSetvar = \c : RuExp -> length(c.nodes) == 2 && (switch (c.nodes[1]) { RuVar(__, __): true; RuRuleNode(__, __): false; });
	all = concat(collect(goal), filter(concatA(map(hyps, \h -> collect(h.second))), isSetvar));
	deduped = fold(all, [], \acc, c -> if (exists(acc, \a -> a.nodes == c.nodes)) acc else arrayPush(acc, c));
	rank = \c : RuExp -> if (isSetvar(c)) length(c.nodes) else 1000 + length(c.nodes);
	take(mergeSort(deduped, \a, b -> rank(a) - rank(b)), cap);
}

ruInVarsOf(e : RuExp) -> [RuVar] {
	fold(e.nodes, [], \acc, n -> switch (n) {
		RuVar(id, tp): if (exists(acc, \v -> v.id == id)) acc else arrayPush(acc, RuVar(id, tp));
		RuRuleNode(__, __): acc;
	});
}

ruInFreshSetvar(used : Set<int>, setvarT : int, i : int) -> RuVar {
	id = s2id("inst_v" + i2s(i));
	if (containsSet(used, id)) ruInFreshSetvar(used, setvarT, i + 1) else RuVar(id, setvarT);
}

// ---- the relational ∀-form table (S1 of the completion plan) ----------------

// A definitional bicond `R(A…) ↔ ∀x φ(x, A…)`: applying it to a matching premise and
// mpbi-ing yields the premise's ∀-FORM — the scheme the Unifier instantiates. Without
// this, a ⊆/=-shaped premise is INVISIBLE to instantiation (only literal ∀-premises and
// `X = ∅` used to contribute; eq0 was the hand-picked special case this scan subsumes).
RuInRelForall(lemmaId : int, prop : RuExp, lhs : RuExp, xVar : RuVar);

// Mechanical scan: 0-hyp assertions (definitions included — df-ss) whose prop is
// `lhs ↔ ∀x body`, lhs a bare atom (rule-headed; every arg a single node — a plain class
// var or a 0-ary constant like ∅; the vars distinct; x not among them). On miz_set this
// finds df-ss (⊆), dfcleq (=), eq0 (=∅) — and any future relation's ∀-bicond of the same
// shape. DV provisos are declared at APPLICATION: DV(u, fresh v) for every premise var u
// (the instantiated superset of the lemma's disjointed(A x, B x, …); v is fresh, so the
// provisos hold trivially in the theorem context).
ruInRelForalls(math : RuMath) -> Tree<int, [RuInRelForall]> {
	ruInRelBinders(math, s2id("wal"));
}

// The shared shape scan behind the ∀-form (S1) and ∃-form (S4c) tables: 0-hyp assertions
// `R(A…) ↔ <binder> x φ` with a relation-headed lhs over distinct bare metavars.
ruInRelBinders(math : RuMath, walId : int) -> Tree<int, [RuInRelForall]> {
	ruInRelBinders2(math, walId, walId == s2id("wal"));
}

// bareArgs=true (the measured ∀-scan): lhs args must be single-node metavars.
// bareArgs=false (the ∃-scan): lhs may be any LINEAR pattern (distinct vars) — eluni's
// lhs (A ∈ ∪. B) has a compound arg and still matches one-directionally.
ruInRelBinders2(math : RuMath, walId : int, bareArgs : bool) -> Tree<int, [RuInRelForall]> {
	wbId = s2id("wb");
	fold(getTreeValues(math.decls.assertions), makeTree(), \acc, ass -> {
		inf = ruInInfer(ass);
		if (length(inf.hyps) != 0) acc else {
			prop = ruExp(inf.prop.exps[0]);
			if (ruInHead(prop) != wbId || ruInArity(prop) != 2) acc else {
				pa = ruInArgs(prop);
				lhs = pa[0]; rhs = pa[1];
				if (ruInHead(rhs) != walId || ruInArity(rhs) != 2) acc else {
					xE = (ruInArgs(rhs))[0];
					xOk = length(xE.nodes) == 1 && (switch (xE.nodes[0]) { RuVar(__, __): true; RuRuleNode(__, __): false; });
					argOk = \e : RuExp -> length(e.nodes) == 1;
					largs = ruInArgs(lhs);
					lvars = if (bareArgs) fold(largs, [], \vs, a -> switch (a.nodes[0]) {
						RuVar(id, __): arrayPush(vs, id);
						RuRuleNode(__, __): vs;
					}) else fold(lhs.nodes, [], \vs, n -> switch (n) {
						RuVar(id, __): arrayPush(vs, id);
						RuRuleNode(__, __): vs;
					});
					// the ∃-scan takes only STRUCTURE-DECOMPOSING unfolds: some lhs arg compound
					// (eluni's ∪.B — else df-clel matches every ∈-premise and floods the
					// saturation) and a binder-free body (the certificate is propositional).
					rbody = (ruInArgs(rhs))[1];
					binderIds = [s2id("wal"), s2id("wex")];
					exOk = bareArgs || (
						exists(largs, \a -> length(a.nodes) > 1)
						&& !exists(rbody.nodes, \n -> switch (n) {
							RuVar(__, __): false;
							RuRuleNode(idT, __): contains(binderIds, ruIdType2Id(idT));
						}));
					ok = xOk && exOk && ruInHead(lhs) >= 0 && ruInArity(lhs) >= 1
						&& (!bareArgs || forall(largs, argOk))
						&& sizeSet(buildSet(lvars)) == length(lvars)
						&& (switch (xE.nodes[0]) { RuVar(id, __): !contains(lvars, id); RuRuleNode(__, __): false; });
					if (!ok) acc else {
						xVar = switch (xE.nodes[0]) { RuVar(id, tp): RuVar(id, tp); RuRuleNode(__, __): ruNoVar; };
						cur = lookupTreeDef(acc, ruInHead(lhs), []);
						setTree(acc, ruInHead(lhs), arrayPush(cur, RuInRelForall(ruInId(ass), prop, lhs, xVar)));
					}
				}
			}
		}
	});
}

// (1) RELATIONAL ∀-FORMS: every premise matching a scanned `R(A…) ↔ ∀x φ` bicond derives
// its ∀-form `∀v φ[v/x]` (fresh v; DV(u, v) per premise var u) — the Unifier's scheme pool.
ruInRelForallFacts(math : RuMath, env : RuEnv, stmtClass : int, tabs : RuInTables,
	hyps : [Pair<RuProofTree, RuExp>], used : Set<int>, setvarT : int) -> Pair<[Pair<RuProofTree, RuExp>], Set<RuDisj>> {
	fold(hyps, Pair([], makeSet()), \acc : Pair<[Pair<RuProofTree, RuExp>], Set<RuDisj>>, h ->
		fold(lookupTreeDef(tabs.rels, ruInHead(h.second), []), acc, \ac, r ->
			switch (ruMatchExp(h.second, r.lhs, math, env)) {
				None(): ac;
				Some(sub0): {
					v = ruInFreshSetvar(used, setvarT, 0);
					vE = RuExp([RuVar(v.id, v.type)], -1);
					m = copyHashMap(sub0.map);
					setHashMap(m, r.xVar.id, RuSubExpr(r.xVar, vE, ruExpVarIdsHashSet(vE)));
					inst = ruApplySubst(r.prop, RuSubst(m));   // R(X…) ↔ ∀v φ[v/x, X…]
					forallF = (ruInArgs(inst))[1];
					pBi  = RuProofStep(r.lemmaId, [], RuStmt(stmtClass, [inst], -1));
					pAll = RuProofStep(s2id_("mpbi"), [h.first, pBi], RuStmt(stmtClass, [forallF], -1));
					dvs = fold(ruInVarsOf(h.second), ac.second, \ds, u -> insertSet(ds, RuDisj(u, v)));
					Pair(arrayPush(ac.first, Pair(pAll, forallF)), dvs);
				}
			}));
}

ruInRelExistsFacts(math : RuMath, env : RuEnv, stmtClass : int, tabs : RuInTables,
	hyps : [Pair<RuProofTree, RuExp>], used : Set<int>, setvarT : int) -> Pair<[Pair<RuProofTree, RuExp>], Set<RuDisj>> {
	fold(hyps, Pair([], makeSet()), \acc : Pair<[Pair<RuProofTree, RuExp>], Set<RuDisj>>, h ->
		if (length(acc.first) >= 4) acc
		else fold(lookupTreeDef(tabs.exs, ruInHead(h.second), []), acc, \ac, r ->
			switch (ruMatchExp(h.second, r.lhs, math, env)) {
				None(): ac;
				Some(sub0): {
					v = ruInFreshSetvar(used, setvarT, 1);
					vE = RuExp([RuVar(v.id, v.type)], -1);
					m = copyHashMap(sub0.map);
					setHashMap(m, r.xVar.id, RuSubExpr(r.xVar, vE, ruExpVarIdsHashSet(vE)));
					inst = ruApplySubst(r.prop, RuSubst(m));   // R(X…) ↔ ∃v φ[v/x, X…]
					exF = (ruInArgs(inst))[1];
					pBi = RuProofStep(r.lemmaId, [], RuStmt(stmtClass, [inst], -1));
					pEx = RuProofStep(s2id_("mpbi"), [h.first, pBi], RuStmt(stmtClass, [exF], -1));
					dvs = fold(ruInVarsOf(h.second), ac.second, \ds, u -> insertSet(ds, RuDisj(u, v)));
					Pair(arrayPush(ac.first, Pair(pEx, exF)), dvs);
				}
			}));
}

// (3) reflexivity `t = t` per candidate, by equid.
ruInReflFacts(math : RuMath, env : RuEnv, stmtClass : int, cands : [RuExp]) -> [Pair<RuExp, RuProofTree>] {
	equidId = s2id_("equid");
	switch (lookupTree(math.decls.assertions, equidId)) {
		None(): [];
		Some(ass): {
			prop = ruExp((ruInInfer(ass)).prop.exps[0]);       // (x = x)
			xv = fold(prop.nodes, ruNoVar, \acc, n -> switch (n) { RuVar(id, tp): if (acc == ruNoVar) RuVar(id, tp) else acc; RuRuleNode(__, __): acc; });
			if (xv == ruNoVar) [] else filtermap(cands, \t -> {
				// equid's var is SETVAR-typed: only a coerced-setvar candidate yields a refl fact
				if (length(t.nodes) != 2) None()
				else switch (t.nodes[1]) {
					RuRuleNode(__, __): None();
					RuVar(__, __): {
						bare = RuExp([t.nodes[1]], -1);
						m = makeHashMap(idfn);
						setHashMap(m, xv.id, RuSubExpr(xv, bare, ruExpVarIdsHashSet(bare)));
						inst = ruApplySubst(prop, RuSubst(m));
						Some(Pair(inst, RuProofStep(equidId, [], RuStmt(stmtClass, [inst], -1))));
					}
				}
			});
		}
	}
}

// (4) DEFINITIONAL ENUMERATION MEMBERSHIPS: for every enumeration term {a}/{a,b}/{a,b,c}
// occurring in the problem, derive its element memberships (a ∈ {a,b} …) by the scanned
// enum-rule table — foundation lemmas (snid/prid1/…), setness hyp discharged recursively.
// These are the ground literals Mizar's Equalizer holds definitionally for enumerated sets.
ruInEnumFacts(math : RuMath, env : RuEnv, stmtClass : int, tabs : RuInTables,
	hyps : [Pair<RuProofTree, RuExp>], goal : RuExp) -> [Pair<RuExp, RuProofTree>] {
	// every rule-headed subterm whose head has enum rules, from the WHOLE problem
	collect = \e : RuExp -> {
		n = e.nodes;
		filtermap(enumFromTo(0, length(n) - 1), \i -> switch (n[i]) {
			RuVar(__, __): None();
			RuRuleNode(idT, __): {
				if (!containsKeyTree(tabs.enums, ruIdType2Id(idT))) None()
				else Some(RuExp(subrange(n, i, ruInSpan(n, i) - i), -1));
			}
		});
	};
	all = concatA(map(arrayPush(map(hyps, \h -> h.second), goal), collect));
	terms = take(fold(all, [], \acc, t -> if (exists(acc, \a -> a.nodes == t.nodes)) acc else arrayPush(acc, t)), 8);
	fold(terms, [], \acc, t -> {
		targs = ruInArgs(t);
		fold(lookupTreeDef(tabs.enums, ruInHead(t), []), acc, \ac, r -> {
			if (length(targs) != length(r.tvars)) ac else {
				m = makeHashMap(idfn);
				iteri(r.tvars, \i, tv -> setHashMap(m, tv.id, RuSubExpr(tv, targs[i], ruExpVarIdsHashSet(targs[i]))));
				inst = ruApplySubst(r.prop, RuSubst(m));
				if (exists(ac, \f -> f.first.nodes == inst.nodes)) ac
				else {
					stmt = RuStmt(stmtClass, [inst], -1);
					if (!r.hasSetness) arrayPush(ac, Pair(inst, RuProofStep(r.lemmaId, [], stmt)))
					else switch (ruSetnessProof2(tabs.setness, targs[r.argPos], stmtClass, math, env)) {
						None(): ac;
						Some(setn): arrayPush(ac, Pair(inst, RuProofStep(r.lemmaId, [setn], stmt)));
					}
				}
			}
		});
	});
}

// (5) EQUALITY TRANSPORT — the Equalizer's atom merge: for every premise ground equality
// (X = Y) (and its eqcomi flip) and every atom fact F holding X at a congruence position,
// derive F[Y/X] via the scanned atom congruences (eleq1/eleq2/sseq1/… — one ax-mp + mpbi).
// One bounded round: enough to move a definitional membership across the premise equality
// (x9 ∈ {x9,x10} + {x5}={x9,x10} → x9 ∈ {x5}, the t4-class step).
ruInTransport(math : RuMath, env : RuEnv, stmtClass : int, tabs : RuInTables,
	hyps : [Pair<RuProofTree, RuExp>], facts : [Pair<RuExp, RuProofTree>]) -> [Pair<RuExp, RuProofTree>] {
	wceqId = s2id("wceq");
	eqcomi = s2id_("eqcomi");
	axmp   = s2id_("ax-mp");
	mpbi   = s2id_("mpbi");
	eqHyps0 = filter(hyps, \h -> ruInHead(h.second) == wceqId && ruInArity(h.second) == 2);
	eqs = concatA(map(eqHyps0, \h -> {
		sides = ruInArgs(h.second);
		if (sides[0].nodes == sides[1].nodes) [] else {
			flipped = ruFwdMkRule(wceqId, tp2id_("wff"), [sides[1], sides[0]]);
			[Triple(h.first, sides[0], sides[1]),
			 Triple(RuProofStep(eqcomi, [h.first], RuStmt(stmtClass, [flipped], -1)), sides[1], sides[0])];
		}
	}));
	if (eqs == []) [] else {
		// transport ONLY the derived facts (the enum memberships), NOT the premise atoms:
		// premise-atom transport multiplies junk on enum-free problems (every ⊆/=-premise ×
		// every congruence rule), and each junk fact is then eqss-normalized downstream —
		// measured to starve the def-close stage out of theorems it closed in 1s (t104).
		// For an enum-free problem `facts` is empty and this whole phase is a no-op.
		pool = facts;
		known = \fs : [Pair<RuExp, RuProofTree>], e : RuExp ->
			exists(hyps, \h -> h.second.nodes == e.nodes) || exists(pool, \p -> p.first.nodes == e.nodes)
			|| exists(fs, \p -> p.first.nodes == e.nodes);
		fold(pool, [], \acc, f -> if (length(acc) >= 16) acc else
			fold(eqs, acc, \ac, eq -> if (length(ac) >= 16) ac else
				fold(lookupTreeDef(tabs.atoms, ruInHead(f.first), []), ac, \a, r -> switch (ruMatchExp(f.first, r.lhs, math, env)) {
					None(): a;
					Some(sub0): {
						va = lookupHashMap(sub0.map, r.va.id);
						vaIsX = switch (va) { Some(se): se.exp.nodes == eq.second.nodes; None(): false; };
						if (!vaIsX) a else {
							m = copyHashMap(sub0.map);
							setHashMap(m, r.vb.id, RuSubExpr(r.vb, eq.third, ruExpVarIdsHashSet(eq.third)));
							sub = RuSubst(m);
							f2 = ruApplySubst(r.rhs, sub);
							if (f2.nodes == f.first.nodes || known(a, f2)) a
							else {
								inst = ruApplySubst(r.prop, sub);            // (X=Y) → (F ↔ F')
								bi = (ruInArgs(inst))[1];                    // (F ↔ F')
								pInst = RuProofStep(r.lemmaId, [], RuStmt(stmtClass, [inst], -1));
								pBi = RuProofStep(axmp, [eq.first, pInst], RuStmt(stmtClass, [bi], -1));
								arrayPush(a, Pair(f2, RuProofStep(mpbi, [f.second, pBi], RuStmt(stmtClass, [f2], -1))));
							}
						}
					}
				})));
	}
}

// One witness intro: ψ = φ[t/x], with pImp proving (ψ → ∃xφ) by spcev.
RuInExIntro(psi : RuExp, imp : RuExp, pImp : RuProofTree, disjs : Set<RuDisj>);

// The shared witness core over a BARE ∃-goal `∃x φ`: for each candidate term t of the
// problem, the substitution congruence (x=t)→(φ↔ψ) + setness(t) give spcev's premises,
// so pImp : (ψ → ∃xφ). Candidates smallest-first, capped.
ruInExIntros(math : RuMath, env : RuEnv, stmtClass : int, exGoal : RuExp, hyps : [RuExp], cap : int) -> [RuInExIntro] {
	wexId   = s2id("wex");
	wbId    = s2id("wb");
	wceqId  = s2id("wceq");
	setvarT = tp2id_("setvar");
	spcev   = s2id_("spcev");
	biidd   = s2id_("biidd");
	tabs    = ruInTables(math);
	if (ruInHead(exGoal) != wexId || ruInArity(exGoal) != 2) [] else {
		ga = ruInArgs(exGoal);
		xE = ga[0]; body = ga[1];
		if (length(xE.nodes) != 1) [] else {
			x = xE.nodes[0];
			xVar = switch (x) { RuVar(id, tp): RuVar(id, tp); RuRuleNode(__, __): RuVar(-1, setvarT); };
			// the coerced occurrence of x inside the body (as in the spcv loop)
			bn = body.nodes;
			coerceIdx = fold(enumFromTo(0, length(bn) - 2), -1, \ci, i ->
				if (ci >= 0) ci
				else switch (bn[i]) {
					RuVar(__, __): ci;
					RuRuleNode(idT, al): if (ruArityLen2Arity(al) == 1 && ruIdType2Type(idT) == tp2id_("class") && bn[i + 1] == x) i else ci;
				});
			if (coerceIdx < 0) {
				if (env.conf.verbose >= 5) { env.out.println("    exIntros: no coerced occurrence of x in body=" + ru2s(body, math)); } else {};
				[];
			} else {
				xC = RuExp([bn[coerceIdx], x], -1);
				cands = ruInCandidates(exGoal, map(hyps, \h -> Pair(ruNoProofTree, h)), setvarT, cap);
				if (env.conf.verbose >= 5) { env.out.println("    exIntros: body=" + ru2s(body, math) + " cands=" + strGlue(map(cands, \c -> ru2s(c, math)), " | ")); } else {};
				filtermap(cands, \t ->
					if (t.nodes == xC.nodes) None()
					else {
						ante = ruFwdMkRule(wceqId, tp2id_("wff"), [xC, t]);
						switch (ruInSubstChain(tabs.atoms, tabs.conns, biidd, wbId, ante, x, t, body, stmtClass, math, env)) {
							None(): {
								if (env.conf.verbose >= 5) { env.out.println("    exIntros: subst-chain FAILED for t=" + ru2s(t, math)); } else {};
								None();
							}
							Some(sc): {
								if (ruInContains(sc.result, x)) {
									if (env.conf.verbose >= 5) { env.out.println("    exIntros: x SURVIVES in psi=" + ru2s(sc.result, math) + " for t=" + ru2s(t, math)); } else {};
									None();
								}
								else switch (ruSetnessProof2(tabs.setness, t, stmtClass, math, env)) {
									None(): {
										if (env.conf.verbose >= 5) { env.out.println("    exIntros: setness FAILED for t=" + ru2s(t, math)); } else {};
										None();
									}
									Some(setn): {
										imp = ruFwdMkRule(s2id("wi"), tp2id_("wff"), [sc.result, exGoal]);   // (ψ → ∃xφ)
										pImp = RuProofStep(spcev, [setn, sc.proof], RuStmt(stmtClass, [imp], -1));
										dvs = fold(concat(ruInVarsOf(t), ruInVarsOf(sc.result)), makeSet(), \ds, u ->
											if (u.id == xVar.id) ds else insertSet(ds, RuDisj(u, xVar)));
										Some(RuInExIntro(sc.result, imp, pImp, dvs));
									}
								}
							}
						}
					});
			}
		}
	}
}

ruInExGoalWitnesses(math : RuMath, env : RuEnv, stmtClass : int, goal : RuExp, hyps : [RuExp], cap : int) -> [RuInExWitness] {
	map(ruInExIntros(math, env, stmtClass, goal, hyps, cap), \w ->
		RuInExWitness(w.psi,
			\pf -> RuProofStep(s2id_("ax-mp"), [pf, w.pImp], RuStmt(stmtClass, [goal], -1)),
			w.disjs));
}

// Does `c` occur as a contiguous node slice of some hyp? (An ∃-premise's body atoms are
// slices of the premise, so witnesses drawn from under a binder pass too.)
ruInSliceOccurs(hypExps : [RuExp], c : RuExp) -> bool {
	cn = c.nodes;
	lc = length(cn);
	exists(hypExps, \h -> {
		hn = h.nodes;
		exists(enumFromTo(0, length(hn) - lc), \i ->
			fold(enumFromTo(0, lc - 1), true, \eq, j -> eq && hn[i + j] == cn[j]));
	});
}

ruInSplitAnds(waId : int, e : RuExp) -> [RuExp] {
	if (ruInHead(e) != waId || ruInArity(e) != 2) [e]
	else concatA(map(ruInArgs(e), \a -> ruInSplitAnds(waId, a)));
}

ruInExGoalImps(math : RuMath, env : RuEnv, stmtClass : int, goal : RuExp, hyps : [Pair<RuProofTree, RuExp>], cap : int) -> Pair<[Pair<RuExp, RuProofTree>], Set<RuDisj>> {
	wexId   = s2id("wex");
	waId    = s2id("wa");
	setvarT = tp2id_("setvar");
	hypExps = map(hyps, \h -> h.second);
	// RELEVANCE (the unifier discipline): keep only intros whose ψ-conjuncts all occur in the
	// premises — junk witnesses inflate the certificate's atom count for nothing.
	relevant = \ws : [RuInExIntro] -> {
		kept = take(filter(ws, \w ->
			forall(ruInSplitAnds(waId, w.psi), \c -> ruInSliceOccurs(hypExps, c))), cap);
		if (env.conf.verbose >= 4) {
			env.out.println("  exImps: goal=" + ru2s(goal, math) + " intros=" + i2s(length(ws)) + " kept=" + i2s(length(kept)) +
				(if (kept == []) (if (ws == []) "" else " dropped-first-psi=" + ru2s(ws[0].psi, math)) else " first=" + ru2s(kept[0].imp, math)));
		} else {};
		kept;
	};
	if (ruInHead(goal) == wexId) {
		// bare ∃-goal: the intro implication IS (ψ → goal)
		intros = relevant(ruInExIntros(math, env, stmtClass, goal, hypExps, cap * 2));
		fold(intros, Pair([], makeSet()), \acc, w ->
			Pair(arrayPush(acc.first, Pair(w.imp, w.pImp)), mergeSets(acc.second, w.disjs)));
	} else {
		// goal matching a rel-∃ lhs: rewrite across the bicond (fresh binder v), then bridge
		// each intro (ψ → ∃vφ') to (ψ → goal) by syl with biimpri of the bicond instance.
		tabs = ruInTables(math);
		used = fold(arrayPush(hypExps, goal), makeSet(), \acc, e ->
			fold(e.nodes, acc, \a, n -> switch (n) { RuVar(id, __): insertSet(a, id); RuRuleNode(__, __): a; }));
		fold(lookupTreeDef(tabs.exs, ruInHead(goal), []), Pair([], makeSet()), \acc : Pair<[Pair<RuExp, RuProofTree>], Set<RuDisj>>, r ->
			if (acc.first != []) acc   // first matching scheme wins
			else switch (ruMatchExp(goal, r.lhs, math, env)) {
				None(): acc;
				Some(sub0): {
					v = ruInFreshSetvar(used, setvarT, 2);
					vE = RuExp([RuVar(v.id, v.type)], -1);
					m = copyHashMap(sub0.map);
					setHashMap(m, r.xVar.id, RuSubExpr(r.xVar, vE, ruExpVarIdsHashSet(vE)));
					inst = ruApplySubst(r.prop, RuSubst(m));   // goal ↔ ∃v φ'
					exF = (ruInArgs(inst))[1];
					pBi = RuProofStep(r.lemmaId, [], RuStmt(stmtClass, [inst], -1));
					impBk = ruFwdMkRule(s2id("wi"), tp2id_("wff"), [exF, goal]);
					pBk = RuProofStep(s2id_("biimpri"), [pBi], RuStmt(stmtClass, [impBk], -1));   // (∃vφ' → goal)
					dvsBi = fold(ruInVarsOf(goal), makeSet(), \ds, u -> insertSet(ds, RuDisj(u, v)));
					intros = relevant(ruInExIntros(math, env, stmtClass, exF, hypExps, cap * 2));
					if (intros == []) acc else
					fold(intros, Pair(acc.first, mergeSets(acc.second, dvsBi)), \ac, w -> {
						impG = ruFwdMkRule(s2id("wi"), tp2id_("wff"), [w.psi, goal]);
						pG = RuProofStep(s2id_("syl"), [w.pImp, pBk], RuStmt(stmtClass, [impG], -1));
						Pair(arrayPush(ac.first, Pair(impG, pG)), mergeSets(ac.second, w.disjs));
					});
				}
			});
	}
}

ruInSaturate(math : RuMath, env : RuEnv, stmtClass : int,
	hyps : [Pair<RuProofTree, RuExp>], goal : RuExp, cap : int) -> Pair<[Pair<RuExp, RuProofTree>], Set<RuDisj>> {
	walId   = s2id("wal");
	wbId    = s2id("wb");
	wceqId  = s2id("wceq");
	setvarT = tp2id_("setvar");
	spcv    = s2id_("spcv");
	biidd   = s2id_("biidd");
	tabs    = ruInTables(math);
	cands   = ruInCandidates(goal, hyps, setvarT, cap);
	used    = fold(arrayPush(map(hyps, \h -> h.second), goal), makeSet(), \acc, e ->
		fold(e.nodes, acc, \a, n -> switch (n) { RuVar(id, __): insertSet(a, id); RuRuleNode(__, __): a; }));
	// (1) relational ∀-forms (⊆ via df-ss, = via dfcleq, =∅ via eq0 — one shape scan)
	emp = ruInRelForallFacts(math, env, stmtClass, tabs, hyps, used, setvarT);
	// (6) relational ∃-forms: ELIM facts (∃v φ from an eluni-shaped premise — the premise-side
	// skolemization opens them) and the goal-side witness IMPLICATIONS (ψ → goal), both S4c.
	exElim = ruInRelExistsFacts(math, env, stmtClass, tabs, hyps, used, setvarT);
	exFacts = map(exElim.first, \f -> Pair(f.second, f.first));
	exImps = ruInExGoalImps(math, env, stmtClass, goal, hyps, 4);
	// (4) definitional enumeration memberships, (5) their transport across premise equalities
	enumFacts = ruInEnumFacts(math, env, stmtClass, tabs, hyps, goal);
	moved = ruInTransport(math, env, stmtClass, tabs, hyps, enumFacts);
	eqlz = concat(enumFacts, moved);
	// (2) the ∀-pool: given ∀-premises + derived ∀-forms; instantiate at every candidate.
	// SMALLEST SCHEMES FIRST (the ground-first principle — the eq0-forms ¬(v∈X) are the
	// workhorses) and the fold STOPS BUILDING once the instance cap is reached: with the
	// relational forms every ⊆/= premise now contributes a scheme, and building the whole
	// pool×candidates product before capping starved the full-stack slices (126 → 124).
	// An EMPTY pool with NO equalizer facts means the whole pass has nothing to do — return
	// nothing at all (the refl facts alone never close anything and their downstream
	// normalization is pure cost).
	pool0 = concat(filter(hyps, \h -> ruInHead(h.second) == walId && ruInArity(h.second) == 2), emp.first);
	pool = mergeSort(pool0, \a, b -> length(a.second.nodes) - length(b.second.nodes));
	if (pool == [] && eqlz == [] && exFacts == [] && exImps.first == []) Pair([], makeSet()) else {
	instAcc = fold(pool, Pair([], emp.second), \acc : Pair<[Pair<RuExp, RuProofTree>], Set<RuDisj>>, h -> {
		pa = ruInArgs(h.second);
		xE = pa[0]; body = pa[1];
		if (length(acc.first) >= 8 || length(xE.nodes) != 1) acc else {
			x = xE.nodes[0];
			xVar = switch (x) { RuVar(id, tp): RuVar(id, tp); RuRuleNode(__, __): RuVar(-1, setvarT); };
			// the coercion node for x, harvested from the ∀-body's own coerced occurrence of it
			// (the candidate can no longer supply it — it may be a compound term)
			bn = body.nodes;
			coerceIdx = fold(enumFromTo(0, length(bn) - 2), -1, \ci, i ->
				if (ci >= 0) ci
				else switch (bn[i]) {
					RuVar(__, __): ci;
					RuRuleNode(idT, al): if (ruArityLen2Arity(al) == 1 && ruIdType2Type(idT) == tp2id_("class") && bn[i + 1] == x) i else ci;
				});
			if (coerceIdx < 0) acc   // x never occurs in a class position — nothing to substitute at
			else {
			xC = RuExp([bn[coerceIdx], x], -1);
			fold(cands, acc, \acc2, t ->
				if (length(acc2.first) >= 8 || t.nodes == xC.nodes) acc2   // cap reached / bound-var no-op
				else {
					// the antecedent (x = A): x in its coerced (class) form, A the candidate term
					ante = ruFwdMkRule(wceqId, tp2id_("wff"), [xC, t]);
					switch (ruInSubstChain(tabs.atoms, tabs.conns, biidd, wbId, ante, x, t, body, stmtClass, math, env)) {
						None(): acc2;
						Some(sc): {
							// spcv's DV: disjointed(A x, ps x) — decline if x survives in the result
							if (ruInContains(sc.result, x)) acc2
							else switch (ruSetnessProof2(tabs.setness, t, stmtClass, math, env)) {
								None(): acc2;
								Some(setn): {
									imp = ruFwdMkRule(s2id("wi"), tp2id_("wff"), [h.second, sc.result]);
									pImp = RuProofStep(spcv, [setn, sc.proof], RuStmt(stmtClass, [imp], -1));
									pInst = RuProofStep(s2id_("ax-mp"), [h.first, pImp], RuStmt(stmtClass, [sc.result], -1));
									dvs = fold(concat(ruInVarsOf(t), ruInVarsOf(sc.result)), acc2.second, \ds, u ->
										if (u.id == xVar.id) ds else insertSet(ds, RuDisj(u, xVar)));
									Pair(arrayPush(acc2.first, Pair(sc.result, pInst)), dvs);
								}
							}
						}
					}
				});
			}
		}
	});
	// (3) reflexivity facts — ONLY for the schemes whose normalized instances bottom out on
	// them: real ∀-premises and the ∅-class forms (eq0: ¬(v∈X) normalizes into (x=x)-shaped
	// subgoals). The RELATIONAL schemes (df-ss/dfcleq) do not need them, and un-gating refl
	// on every ⊆/=-premise residual taxed the full-stack slices (8 junk t=t premises each:
	// 126 → 125 measured against a same-day control).
	hasForallPremise = exists(hyps, \h -> ruInHead(h.second) == walId && ruInArity(h.second) == 2);
	hasZeroaryScheme = exists(hyps, \h ->
		exists(lookupTreeDef(tabs.rels, ruInHead(h.second), []), \r ->
			exists(ruInArgs(r.lhs), \a -> length(a.nodes) == 1 && (switch (a.nodes[0]) { RuRuleNode(__, __): true; RuVar(__, __): false; }))
			&& isSome(ruMatchExp(h.second, r.lhs, math, env))));
	refl = if (!hasForallPremise && !hasZeroaryScheme) [] else ruInReflFacts(math, env, stmtClass, cands);
	// TOTAL-INSTANCE CAP: candidates are smallest-first, so the cap keeps the workhorse
	// instances (variables, singletons) and sheds the big-product tail. Without it the
	// pool x candidates product multiplied the per-instance normalization cost and starved
	// the general path's slices (zfmisc general 98 -> 92 when compounds landed uncapped).
	Pair(concatA([eqlz, take(instAcc.first, 8), refl, exFacts, exImps.first]),
		mergeSets(mergeSets(instAcc.second, exElim.second), exImps.second));
	}
}
