import ru/prover/core/controls;
import ru/prover/core/tree;

// `bfs` is the pure, unbounded frontier expander. There is no `bounded-bfs`/`top-n-bfs` here any more —
// bound it by composing with the `limited` combinator: limited(bfs, size=N, depth=D, batch=16) is the
// strict delta-bounded BFS; batch=n gives a top-n beam.
export {
	ruBreadthFirstTactic : RuProverTactic;
	// `forward`: the direction-orthogonal mirror of `bfs`. Each round it asks the
	// engine to advance the whole forward front by one wave (RuTacticExpandForward);
	// the engine (ruProve) owns the wave and its joins. Stops when a proof is found
	// (a join reached the root) or the front stops producing new facts. Bound it by
	// composing with `limited` (wall-clock granularity is one wave). See forward.flow.
	ruForwardTactic : RuProverTactic;
	ruGiveupTactic : RuProverTactic;
	ruDefaultTactic : RuProverTactic = ruBreadthFirstTactic;
}

ruBreadthFirstTactic = RuProverTactic("bfs", "bfs",
	\tree ->
		if (length(^(tree.proofs)) > 0) RuTacticDone()
		else RuTacticExpand(getTreeValues(tree.leafs)),
	ruTreeNotProved
);

ruForwardTactic = RuProverTactic("forward", "forward",
	\tree ->
		if (length(^(tree.proofs)) > 0) RuTacticDone()
		else RuTacticExpandForward(),
	ruTreeNotProved
);

ruGiveupTactic = ruDoneTactic;
