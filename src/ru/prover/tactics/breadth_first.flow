import ru/prover/core/controls;
import ru/prover/core/tree;

export {
	ruBreadthFirstTactic : RuProverTactic;
	ruGiveupTactic : RuProverTactic;
	ruDefaultTactic : RuProverTactic = ruBreadthFirstTactic;
	ruBoundedBFSTactic(max_depth : int, max_size : int) -> RuProverTactic;
	// BFS beam: expands only the top-n leaves per round, in tree-insertion order — which reflects
	// unification specificity, since expand.flow sorts unified candidates by substitution size.
	// (Absorbed the former `uq`/unif-quality tactic, an exact duplicate apart from two safety guards.)
	ruTopNBFSTactic(n : int, max_depth : int, max_size : int) -> RuProverTactic;
}

ruBreadthFirstTactic = RuProverTactic("bfs", "bfs",
	\tree ->
		if (length(^(tree.proofs)) > 0) RuTacticDone()
		else RuTacticExpand(getTreeValues(tree.leafs)),
	ruTreeNotProved
);

ruGiveupTactic = ruDoneTactic;

ruBoundedBFSTactic(max_depth : int, max_size : int) -> RuProverTactic {
	keep = ruDeltaKeepExpanding(max_depth, max_size);
	RuProverTactic("bounded-bfs(" + i2s(max_depth) + ", " + i2s(max_size) + ")", "bounded-bfs",
		// Return at most ruSearchBatch leafs per round (the rest stay in tree.leafs, re-offered next
		// round) so the max_size cap re-checked by `keep` stays strict — no frontier×branching overshoot.
		\tree -> if (!keep(tree)) RuTacticDone() else RuTacticExpand(take(getTreeValues(tree.leafs), ruSearchBatch)),
		keep
	);
}

ruTopNBFSTactic(n : int, max_depth : int, max_size : int) -> RuProverTactic {
	keep = ruDeltaKeepExpanding(max_depth, max_size);
	RuProverTactic("top-n-bfs(" + i2s(n) + ", " + i2s(max_depth) + ", " + i2s(max_size) + ")", "top-n-bfs",
		// Done on a spent budget, n<=0, or an empty frontier (the latter two folded in from the former
		// `uq` tactic — without the empty-frontier guard the engine could spin on RuTacticExpand([])).
		\tree -> if (n <= 0 || !keep(tree)) RuTacticDone()
			else {
				picked = take(getTreeValues(tree.leafs), n);
				if (picked == []) RuTacticDone() else RuTacticExpand(picked);
			},
		keep
	);
}
