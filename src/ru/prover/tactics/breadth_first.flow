import ru/prover/core/controls;
import ru/prover/core/tree;
import ru/prover/tactics/combinators;

export {
	ruBreadthFirstTactic : RuProverTactic;
	ruGiveupTactic : RuProverTactic;
	ruDefaultTactic : RuProverTactic = ruBreadthFirstTactic;
	ruBoundedBFSTactic(max_depth : int, max_size : int) -> RuProverTactic;
	// BFS beam: expands only the top-n leaves per round, in tree-insertion order — which reflects
	// unification specificity, since expand.flow sorts unified candidates by substitution size.
	// (Absorbed the former `uq`/unif-quality tactic, an exact duplicate apart from two safety guards.)
	ruTopNBFSTactic(n : int, max_depth : int, max_size : int) -> RuProverTactic;
}

ruBreadthFirstTactic = RuProverTactic("bfs", "bfs",
	\tree ->
		if (length(^(tree.proofs)) > 0) RuTacticDone()
		else RuTacticExpand(getTreeValues(tree.leafs)),
	ruTreeNotProved
);

ruGiveupTactic = ruDoneTactic;

// INTERNAL helper — NOT a DSL atom (the `bounded-bfs` atom was removed; write `limited(bfs, …)` in the
// DSL). The standard strict delta-bounded BFS used by the def-close closer / apply / prove defaults:
// `limited(bfs, size=max_size, depth=max_depth, batch=ruSearchBatch)` — paced one ruSearchBatch/round so
// the size cap holds without frontier×branching overshoot. Prints (and re-parses) as the limited(…) it is.
ruBoundedBFSTactic(max_depth : int, max_size : int) -> RuProverTactic {
	ruLimitedTactic(ruBreadthFirstTactic, 0.0, 0, 0, max_size, max_depth, ruSearchBatch);
}

// INTERNAL helper — NOT a DSL atom. A BFS beam of width n: `limited(bfs, size=max_size, depth=max_depth,
// batch=n)` (the n most-specifically-unified leaves per round, since the frontier is pre-sorted by
// substitution size). Used by eval-tactic's `bfs-top` mode.
ruTopNBFSTactic(n : int, max_depth : int, max_size : int) -> RuProverTactic {
	ruLimitedTactic(ruBreadthFirstTactic, 0.0, 0, 0, max_size, max_depth, n);
}
