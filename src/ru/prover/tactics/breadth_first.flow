import ru/prover/core/controls;
import ru/prover/core/tree;
import ru/prover/tactics/combinators;

export {
	ruBreadthFirstTactic : RuProverTactic;
	ruGiveupTactic : RuProverTactic;
	ruDefaultTactic : RuProverTactic = ruBreadthFirstTactic;
	ruBoundedBFSTactic(max_depth : int, max_size : int) -> RuProverTactic;
	// BFS beam: expands only the top-n leaves per round, in tree-insertion order — which reflects
	// unification specificity, since expand.flow sorts unified candidates by substitution size.
	// (Absorbed the former `uq`/unif-quality tactic, an exact duplicate apart from two safety guards.)
	ruTopNBFSTactic(n : int, max_depth : int, max_size : int) -> RuProverTactic;
}

ruBreadthFirstTactic = RuProverTactic("bfs", "bfs",
	\tree ->
		if (length(^(tree.proofs)) > 0) RuTacticDone()
		else RuTacticExpand(getTreeValues(tree.leafs)),
	ruTreeNotProved
);

ruGiveupTactic = ruDoneTactic;

// Sugar for `limited(bfs, size=max_size, depth=max_depth, batch=ruSearchBatch)`: strict delta-bounded
// BFS, paced one ruSearchBatch per round so the size cap holds without frontier×branching overshoot.
// The mechanism now lives in ONE place (ruLimitedTactic); this just relabels it `bounded-bfs(...)`.
ruBoundedBFSTactic(max_depth : int, max_size : int) -> RuProverTactic {
	base = ruLimitedTactic(ruBreadthFirstTactic, 0.0, 0, 0, max_size, max_depth, ruSearchBatch);
	RuProverTactic("bounded-bfs(" + i2s(max_depth) + ", " + i2s(max_size) + ")", "bounded-bfs", base.step, base.keep_expanding);
}

// Sugar for `limited(bfs, size=max_size, depth=max_depth, batch=n)`: a BFS beam of width n (the n
// most-specifically-unified leaves per round, since the frontier is pre-sorted by substitution size).
ruTopNBFSTactic(n : int, max_depth : int, max_size : int) -> RuProverTactic {
	base = ruLimitedTactic(ruBreadthFirstTactic, 0.0, 0, 0, max_size, max_depth, n);
	RuProverTactic("top-n-bfs(" + i2s(n) + ", " + i2s(max_depth) + ", " + i2s(max_size) + ")", "top-n-bfs", base.step, base.keep_expanding);
}
