import ru/prover/core/env;
import ru/prover/core/prove;
import ru/prover/core/expand;
import ru/prover/core/task;
import ru/prover/core/controls;
import ru/prover/tactics/breadth_first;
import ru/prover/tactics/combinators;
import ru/prover/tactics/equalizer;
import ru/prover/tactics/unfold;
import ru/prover/tactics/instantiate;
import ru/prover/tactics/congruence;
import ru/prover/tactics/hilbert;
import ru/prover/tactics/propositional;
import ru/prover/tactics/closer;
import ru/prover/tactics/board;
import ru/prover/tactics/rule_table;
import ru/prover/tactics/type_table;
import ru/prover/tactics/scope_file;
import ru/prover/tactics/deduction;
import ru/prover/core/declines;
import ru/unify/index;
import ru/proof_tree;
import ru/verify/math;
import base/ids;

// The concrete goal-refinement PHASES (refiners) + the residual closer. Each refiner is an orthogonal
// unit (strip-forall, eq-rewrite, …); add new ones here and register them in ruRefinerByName /
// ruRefinerNames to make them available to `refine(...)`. The generic refinement combinator
// (RuRefiner / ruRefine) lives in combinators.flow; the thin DSL builders (`refine(...)`, `checker`)
// live in dsl.flow. Dependency flows one way: dsl -> refiners -> combinators (mirroring how seq is wired).

export {
	// The limited propositional-lemma scope the residual BFS may use (kept small on purpose).
	ruCheckerPropScope() -> [int];

	// The DECOMPOSED lemma-set scopes (checker decomposition): orthogonal named rule sets that,
	// together, give the ENGINE the same power the install `hilbert` emitter has off-engine — so a
	// scoped bidirectional search (forward saturation + backward structural, meeting at a refutation
	// join) reproduces the emitter's proofs law-abidingly. Each is the exact lemma family the emitter
	// (hilbert.flow) uses for that role. Exposed as named scopes via ruNamedScope in dsl.flow.
	ruCheckerRefuteScope() -> [int];   // refutation clash: ¬¬-elim, reductio, ex-falso, falsum, deneg
	ruCheckerExmidScope()  -> [int];   // classical case-split: excluded middle + ∨-elim
	ruCheckerBridgeScope() -> [int];   // first-order ⊆/=/∈ bridge: ssriv/ssrdv/sseld/eleq2 …
	ruCheckerUnfoldScope() -> [int];   // membership-over-operation unfold: elun/elin/eldif/velpw/velsn/noel
	ruMizarNormalizeScope() -> [int];  // forward NNF of ¬G under its antecedent: simplim/conax1, simpl/simpr, pm2.45/pm2.46, notnotr + syl/mpd (mizar-tactic-plan P3)
	ruMizarExistsScope()    -> [int];  // on-engine skolemization: sp/exlimiv/eximi + composers; eigenvar DV rides ordinary application (mizar-tactic-plan P4)
	ruMizarClusterScope()   -> [int];  // forward cluster rounding-up: sstri/sseli, the fact-side dual of bridge-scope's goal reductions (mizar-tactic-plan P5)
	ruMizarClashScope()     -> [int];  // the refutational collision only: pm2.65i + notnotri (Mizar's SetContr; mizar-tactic-plan P6)
	ruMizarCongruenceScope() -> [int]; // the Equalizer: eqtri/eqcomi/ineq*i + identity schemata (disjdif/difid/difin/incom) instantiated at subterms (mizar-tactic-plan)
	ruMizarRelnormScope()    -> [int]; // rel-normalize ⊆-schemata (ssid/ssun1/...); ONLY for the narrow checker-eq stage — junk with sstri in the checker-mizar union
	ruMizarElScope()         -> [int]; // membership-unfold refutation (∈-class): guarded chains under assume-neg's ¬G antecedent — el-biconds + d-form/syllogism composers; ONLY for the narrow checker-el stage
	// The FULL checker scope = prop ∪ bridge ∪ unfold ∪ refute ∪ exmid — the complete rule set a scoped
	// bidirectional search needs to stand in for the Mizar-style `by`-checker.
	ruCheckerFullScope()   -> [int];

	// Prove `hyps ⊢ goal` with the residual CLOSER tactic, restricted to `scope`, returning the found
	// proof TREE. A self-contained prover run on a CONCRETE goal — no free witness variable ever reaches
	// search. `mkCloser` is a THUNK producing a fresh closer tactic per call (the closer carries internal
	// ref-snapshots — e.g. bounded-bfs's delta limit — that must not leak across residual sub-proves).
// An ∃-premise candidate for the residual's skolemization: the ∃-expression, the premise index
// it replaces (-1 for an on-demand ELIM derivation), the minor proof discharging it, its DVs.
RuExPremCand(prem : RuExp, exclude : int, minor : RuProofTree, disjs : Set<RuDisj>);

// Remap a certificate's hypothesis leaves from SUBSET positions to the original premise indices.
ruInRemapLeaves(t : RuProofTree, subset : [int]) -> RuProofTree {
	switch (t) {
		RuProofHyp(i, stmt): if (i >= 0 && i < length(subset)) RuProofHyp(subset[i], stmt) else t;
		RuProofStep(ass, cs, stmt): RuProofStep(ass, map(cs, \c -> ruInRemapLeaves(c, subset)), stmt);
	}
}

	// THE RESIDUAL DECISION CACHE (board artifact "residual.verdicts"): the or-else
	// stage cascade re-enters the residual ~5x per prove step with identical
	// (goal, premises, config) — memoize the verdict, successes AND failures.
	// COMPLETENESS RULE: a failure short-circuits a re-run ONLY when the recorded
	// run was budget-independent (no wall-clock gate fired, truncated=false);
	// truncated failures are recorded but never honored — the caller re-runs.
	RuResidualVerdict ::= RuResidualProved, RuResidualFailed;
		RuResidualProved(result : RuRefineResult);
		RuResidualFailed(truncated : bool, budget : double);
	// The memo handle: the board plus the caller's config fingerprint (scope name,
	// depth/size/time budgets, nnf, closer AST) — goal nodes complete the key.
	RuResidualMemo(board : RuTacticBoard, fingerprint : string);

	// The default closer is bounded-bfs; any search strategy over `scope` can be substituted.
	ruCheckerResidual(math : RuMath, env : RuEnv, info : RuDeclInfo, stmtClass : int,
		hyps : [RuExp], goal : RuExp, scope : [int], mkCloser : () -> RuProverTactic, limit : double, nnf : bool, precedes : (int) -> bool,
		memo : Maybe<RuResidualMemo>) -> Maybe<RuRefineResult>;

	// The orthogonal Checker phases, as refiners, + the name registry that `refine(...)` resolves against.
	// `nnf` toggles De Morgan in the eq-rewrite canon pass (checker tries false then true). `precedes(aid)`
	// = does assertion aid precede the theorem — eq-rewrite uses it to decline precedence-violating guides.
	ruStripForallRefiner(stmtClass : int, precedes : (int) -> bool, setTerms : Set<string>) -> RuRefiner;
	ruEqRewriteRefiner(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int, hyps : [RuExp], nnf : bool, precedes : (int) -> bool) -> RuRefiner;
	ruRefinerByName(name : string, em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int, hyps : [RuExp], nnf : bool, precedes : (int) -> bool) -> Maybe<RuRefiner>;
	ruRefinerNames() -> [string];
}

ruCheckerPropScope() -> [int] {
	map(["mpbi", "mpbir", "biimpi", "biimpri", "ax-mp", "syl", "jca", "simpl", "simpr",
		"pm3.2i", "pm3.24", "exmid", "id", "con2i", "notnotr", "pm2.21i", "jaoi", "orcd", "olcd",
		// ∨-INTRODUCTION for a BARE goal. The scope had only the DEDUCTION forms (orcd/olcd:
		// ψ→ph ⊢ ψ→(ph∨ps)), so a residual like `x11 = x5 ⊢ (x11 = x8) ∨ (x11 = x5)` — what every
		// enumeration-membership step reduces to once elpr unfolds `x ∈ {a,b}` to `(x=a)∨(x=b)` —
		// had no rule to close it and failed one step from the end (zfmisc t1/t7/t15/t19-class).
		"orc", "olc", "orci", "olci",
		"pm2.21", "imp", "ex", "biid", "mtbi", "mtbir", "sylib", "sylibr", "con3i", "notnoti",
		// empty-set membership: lets the closer discharge `x∈∅` antecedents (noel: ¬(x∈∅)), so e.g.
		// `∅⊆X` (rel-intro → `v∈∅ → v∈X`) closes via pm2.21(noel). Unblocks t2/t3_xboole_1, etc.
		"noel",
		// ⊆-relation lemmas: for goals where ⊆ stays intact (head ¬/→/∧, so rel-intro passes through) —
		// transitivity (sstr/sstr2), union/intersection monotonicity, reflexivity. Lets the closer prove
		// the implication/negated-conjunction ⊆ class (t1 transitivity, t11/t18 implications, t12/t14, …)
		// that Phase-1 refutation flagged as valid. (The `=`-via-membership tautology class still needs
		// the refutation certificate; this is the engine-route slice.)
		"sstr", "sstr2", "ssun1", "ssun2", "unss", "inss", "ssrin", "ssid", "ssin1", "ssin2",
		// difference monotonicity: sscon (A⊆B → (C∖B)⊆(C∖A), anti-monotone in the
		// subtrahend — with ssun1 via ax-mp it closes the A∖(B∪C)⊆A∖B conjuncts of
		// t53-class steps) and ssdif (A⊆B → (A∖C)⊆(B∖C), monotone in the minuend).
		"sscon", "ssdif"], s2id_);
}

// --- decomposed checker scopes (the exact lemma families the hilbert emitter uses per role) ---
// Refutation clash: assume ¬G, derive a contradiction, conclude G. ¬¬-elim (notnotr), reductio
// (pm2.65i / pm2.65 / mto / mt / con*), ex-falso (pm2.21 / pm2.21i), falsum (falim), deneg (iman/imnan).
ruCheckerRefuteScope() -> [int] {
	// notnotri (1-hyp ¬¬φ ⊢ φ) is the FORWARD-triggerable ¬¬-elim: the 0-hyp notnotr + ax-mp
	// route is trigger-blind once the schematic notnotr fact has been expanded (a ¬¬G fact
	// derived later only fits ax-mp's bare-metavar slot, which never triggers).
	map(["notnotr", "notnotri", "notnoti", "pm2.65i", "pm2.65", "pm2.21", "pm2.21i", "pm2.24", "falim",
		"con2i", "con3i", "con1i", "con4i", "mto", "mt2", "mt3", "iman", "imnan", "nsyl", "nsyl3"], s2id_);
}
// FORWARD NNF of the negated goal under the ¬G antecedent (Mizar's PreCheck step, mizar-tactic-plan
// P3): 0-hyp decomposition facts — simplim/conax1 for ¬(a→b) (⊢¬(φ→ψ)→φ and ⊢¬(φ→ψ)→¬ψ; NOT simprim,
// whose ⊢¬(φ→¬ψ)→ψ form cannot strip an ATOMIC consequent), simpl/simpr for a∧b, pm2.45/pm2.46 for
// ¬(a∨b), notnotr for ¬¬a — composed by the deduction combinators syl/mpd. Normalization comes
// AFTER the assume-neg pivot: the frame seeds ¬G raw, these lemmas decompose it in-wave. Elimination
// only (refutation needs no introductions, which are forward-dead: bare-metavar hyps never trigger).
// TODO ¬(a∧b) needs the imnan biconditional route (mpbi machinery) — deferred.
ruMizarNormalizeScope() -> [int] {
	// ¬(a∧b) rides the ianor biconditional (¬(φ∧ψ)↔(¬φ∨¬ψ)) + sylib (2-hyp, both rule-headed:
	// trigger χ→¬(a∧b), fill the ianor fact → χ→(¬a∨¬b)); jaod is the deduction ∨-elim that
	// case-splits the resulting disjunction under the ¬G antecedent.
	map(["syl", "mpd", "notnotr", "simplim", "conax1", "simpl", "simpr", "pm2.45", "pm2.46",
		// ¬(a∧b): imnani (1-hyp, ¬(φ∧ψ) ⊢ φ→¬ψ) is the BARE-fact eliminator — its trigger is
		// the fact itself, so it never starves (the ianor/mpbi route waits on the SCHEMATIC
		// ianor fact's expansion, which ground-first rightly defers — on a big front forever).
		// sylib+ianor still serve IMPLICATION facts χ→¬(a∧b); jaod case-splits ∨ under ¬G.
		// simpli/simpri: the 1-hyp BARE-∧ eliminators (an ∧-premise fact splits on its own
		// trigger; the 0-hyp simpl/simpr facts are schematic and starve under ground-first).
		"imnani", "ianor", "sylib", "mpbi", "jaod", "simpli", "simpri"], s2id_);
}
// ON-ENGINE SKOLEMIZATION (Mizar's PreCheck existential step, mizar-tactic-plan P4): the "Skolem
// constant" is the free setvar exposed by sp (∀-elim, ⊢∀xφ→φ); exlimiv (φ→ψ ⊢ ∃xφ→ψ, DV(ψ,x))
// discharges it soundly — the eigenvariable's DV rides ordinary assertion application (ruCheckDisjs
// in ruAddProof) and is checked by the verifier. eximi (∃-monotone) covers nested rebuilding;
// ax-mp/syl/mpd compose. Pure data — no engine change (see the mizar-decision-gap memory).
ruMizarExistsScope() -> [int] {
	// spi (1-hyp ∀xφ ⊢ φ) is the FORWARD-triggerable ∀-elim: the GROUND ∀-fact itself is the
	// trigger. The 0-hyp sp route needs the SCHEMATIC sp fact expanded, which ground-first
	// ordering rightly defers behind ground facts — same lesson as notnotri vs notnotr.
	// NO eximi: it is an ∃-INTRODUCTION — a junk factory in the wave (it ∃-wraps every
	// implication fact; the t14 trace showed it) and refutation needs eliminations only.
	// TODO (the Unifier, next increment): spv/spcv/vtoclg instantiate a ∀-fact at a SCHEMATIC
	// setvar / class term — I1-clean "strip to a variable" — but their (x=A)→(φ↔ψ) hypothesis
	// needs forward CONGRUENCE saturation (eleq/sseq chains) to feed it. See mizar-plan-progress.
	map(["sp", "spi", "exlimiv", "ax-mp", "syl", "mpd"], s2id_);
}
// CLUSTER ROUNDING-UP, forward (Mizar's adjective saturation, mizar-tactic-plan P5): propagate
// facts up ⊆ — transitivity (sstri, 2-hyp inference) and membership (sseli — in THIS corpus a
// 1-hyp form A⊆B ⊢ ((C∈A)→(C∈B)) emitting a schematic implication, so ax-mp/syl must ride along
// to consume it against the ∈-facts; check the STATEMENT, not the set.mm name). ∧-bundled theorem
// forms are forward-dead (∧-intro never triggers). Deliberately tiny: the ⊆/=/∈ GOAL-side
// reductions live in bridge-scope (rel-intro backward); this is the FACT-side dual.
ruMizarClusterScope() -> [int] {
	// NO unssi/unssd/eqsstri (tried for the t97-class ⊆-arithmetic): the
	// schematic ⊆-composers junk small waves — measured: they broke the
	// 08_instantiate meet. ⊆-arithmetic under premises belongs to the
	// DETERMINISTIC route (the ssdif0 premise-rules in eq-normalize).
	map(["sstri", "sseli", "ax-mp", "syl", "mpd"], s2id_);
}
// The refutational COLLISION only (Mizar's SetContr, mizar-tactic-plan P6): pm2.65i turns a clash
// (¬G→φ, ¬G→¬φ) into ¬¬G, notnotri concludes G. DELIBERATELY tiny — the wider refute-scope's
// contraposition family (con*i, mto/mt*, nsyl*, notnoti) serves the BACKWARD residual; saturated
// forward it is a GROUND-junk factory (¬¬-wrapping, contrapositives) that buries the ladder in
// same-key facts the ground-first ordering cannot separate. Mizar's Equate DETECTS contradiction;
// it does not saturate contrapositives.
ruMizarClashScope() -> [int] {
	map(["pm2.65i", "notnotri"], s2id_);
}
// THE EQUALIZER, forward (Mizar's Equate, mizar-tactic-plan equality increment): set-algebra
// equality reasoning. The 0-hyp wceq-headed members (disjdif/difid/difin/incom) are IDENTITY
// SCHEMATA — the `instantiate` frame seeds their instances at goal/premise subterms (an
// ordinary one-step assertion instance, ruSeedIdentityFront); eqtri/eqcomi (transitivity/
// symmetry) and ineq1i/ineq2i (∩-congruence) compose the ground equality facts in-wave.
ruMizarCongruenceScope() -> [int] {
	map([
		// composition: transitivity/symmetry + per-operation congruence inferences
		"eqtri", "eqcomi", "ineq1i", "ineq2i", "uneq1i", "uneq2i", "difeq1i", "difeq2i",
		// the xboole identity base (0-hyp wceq schemata — the instantiation targets):
		// comm/assoc/idempotence, absorption, ∅-units, difference laws, distributivity,
		// and dfsymdif3 which ELIMINATES △ into ∪∩∖.
		"incom", "uncom", "unidm", "inidm", "unass", "inass", "unabs", "inabs",
		"dif0", "un0", "in0", "difid", "difin", "difdif", "undif", "disjdif",
		// NO difun1 (A∖(B∪C) = (A∖B)∖C): as an elim it OUTCOMPETES difundi's
		// ∩-normal form, and its ∖∖-form serves only ONE subtrahend order — it
		// broke t53's difundi+inss1/inss2 route (measured; t99's ∖∖-chains come
		// from distribution and don't need it)
		// the ∖-algebra simplification family (the ring-NF increment, driven by the
		// nf-MISMATCH diagnostics on t94/t98/t111): difabs ((A∖B)∖B = A∖B) and
		// undif1/undif2 ((A∖B)∪B = A∪B / A∪(B∖A) = A∪B) collapse the residues the
		// df-symdif unfolding leaves; indif (A∩(A∖B) = A∖B) and the comm-shaped
		// ∩/∖-transposes indif1/indif2/indifcom ((A∖C)∩B ⇄ (A∩B)∖C) pull ∖
		// outermost so the AC order can align both sides (t111-class)
		"difabs", "undif1", "undif2", "indif", "indif1", "indif2", "indifcom",
		// difin0 ((A∩B)∖B = ∅) kills the empty pieces the ∖∪∖-DNF spawns;
		// inundif ((A∩B)∪(A∖B) = A) and undifabs (A∪(A∖B) = A) MERGE the
		// partition back — the factoring direction oriented rewriting can hold
		// (the t93/t95 nfY = (A∖B)∪((B∖A)∪(A∩B)) three-part partition of A∪B)
		"difin0", "inundif", "undifabs",
		// dif32 ((A∖B)∖C = (A∖C)∖B, comm-shaped): AC-canonicalizes the ∖-subtrahend
		// order so both sides' ∖∖-chains align (t99); difin0b ((A∩B)∖A = ∅,
		// hand-authored in miz_aux.ru — the mirror of difin0, which leftmost-
		// outermost matching against the AC-canonical ∩ order also needs)
		"dif32", "difin0b",
		// more miz_aux kills + THE PARTITION BRIDGE: difabsb ((A∖B)∖A = ∅),
		// inabsb ((A∩B)∩B = A∩B — the duplicate the order-decreasing assoc
		// rules can't make adjacent), 0dif (∅∖A = ∅), and unpart3
		// ((A∖B)∪((B∖A)∪(A∩B)) = A∪B — the exact arrangement the △-unfold's
		// canonical nf takes; greedy regrouping can't reach the inundif redex)
		"difabsb", "inabsb", "0dif", "unpart3",
		// difdif2 (A∖(B∖C) = (A∖B)∪(A∩C)): the compound-subtrahend DNF unfold —
		// admissible under the instance-wise poly guard once I(atom)=3 (t94/t95
		// disjoint residues, t102's ∖∖-compound subtrahends)
		"difdif2",
		"indi", "indir", "undi", "undir", "difundi", "difundir", "difindi", "difindir",
		// df-symdif (△ = (A∖B)∪(B∖A), the DEFINITION form) is the △-eliminator,
		// NOT dfsymdif3 ((A∪B)∖(A∩B)): the ∖∪∖ normal forms are the ones the
		// ⊆-schemata (ssun1 …) and the difference laws can consume (t96, t92, t100)
		"symdifcom", "symdif0", "symdifid", "df-symdif", "symdifass",
		// THE ENUMERATION LAYER (zfmisc_1): df-pr/df-tp unfold {A,B}/{A,B,C}
		// into ∪-of-singletons so the ∖/∩-algebra applies; sneqi/preq1i/preq2i
		// are the congruence lifts INTO enumeration arguments; difprsn2/
		// difprsnss cover the pair∖singleton residues the unfolds leave
		"df-pr", "df-tp", "sneqi", "preq1i", "preq2i", "difprsn2", "difprsnss",
		// THE CXP LAYER (zfmisc_1 t95-t114): xpeq1i/xpeq2i are the congruence
		// lifts INTO ×-arguments; the distribution family pushes × over ∪/∩/∖
		// (xpundir/xpundi/xpindir/xpindi/difxp1/difxp2 — all acyclic unfolds:
		// no rule reintroduces cxp, so ruFwdEqRulesChecked admits them
		// elim-style); inxp is comm-shaped (7=7 nodes) and rides the
		// order-decreasing guard — with id(cin) < id(cxp) (definition order in
		// miz_set.ru) its firing direction AGREES with the xpindi/xpindir
		// distribution NF. NO difxp ((C×D)∖(A×B) DNF): its rhs reintroduces
		// cxp AND cun under a cdif head — it puts cxp on an unfold cycle and
		// downgrades the whole layer to poly guards that block it (t103 stays
		// a straggler; it needs the A∖B = A∖(A∩B) factoring anyway)
		"xpeq1i", "xpeq2i", "xpundir", "xpundi", "xpindi", "xpindir", "inxp",
		"difxp1", "difxp2",
		// THE ⋃/𝒫/pair LAYER (the bool/union A-map alignment): pweqi/unieqi/
		// opeq1i/opeq2i are the congruence lifts into 𝒫/⋃/〈,〉 arguments;
		// uniun distributes ⋃ over ∪ (acyclic unfold — nothing reintroduces
		// cuni); unipr/unisn eliminate ⋃ over enumerations (⋃{A,B} = A∪B,
		// ⋃{A} = A)
		"pweqi", "unieqi", "opeq1i", "opeq2i", "uniun", "unipr", "unisn",
		// the ∅-collapse companions of the new layers (t90-class refutation
		// fragments: the X=∅ case branch rewrites X×Y → ∅×Y → ∅ and clashes
		// with the pooled ¬(X×Y=∅)): ∅×A/A×∅ → ∅, ⋃∅ → ∅
		"0xp", "xp0", "uni0",
		// the AC-permutation family (all comm-shaped: same-length, order-decreasing
		// only) — lets eq-normalize regroup an AC chain until a hidden redex (e.g.
		// the duplicate in ((A∩B)∩A)) becomes adjacent and collapses via inidm/unidm
		"in12", "in13", "in31", "in32", "inrot", "in4", "un12", "un23", "un4"], s2id_);
}
// 0-hyp ⊆-schemata for REL-NORMALIZE (close a normalized ⊆ atom whole). A SEPARATE
// scope, composed only into the NARROW checker-eq stage: inside checker-mizar's
// union these schematic ⊆-facts meet cluster-scope's sstri (⊆-transitivity) in the
// wave and compose into a schematic junk factory that grinds every failing step
// to its full budget (measured: the 06 pipeline went 3 min → 30+ min).
ruMizarRelnormScope() -> [int] {
	// difdifss ((A∖B)∖C ⊆ A∖C, miz_aux.ru): the dif32-canonical ∖∖-chain must
	// match a schema against EITHER residual subtrahend; difss covers only one
	map(["ssid", "ssun1", "ssun2", "inss1", "inss2", "difss", "difdifss", "0ss"], s2id_);
}
// MEMBERSHIP-UNFOLD REFUTATION (the ∈-class: t44-style el-goals). Under assume-neg's
// deduction form EVERY ¬G-derived fact is GUARDED (¬G→X), so bare 1-hyp inference
// forms (imnani/mtbi) never see it — the chain rides on syllogism/d-form composers:
// syl+pm2.45/pm2.46 split a guarded ¬(a∨b); sylnib/sylnibr push a guarded ¬-fact
// through an el-bicond (elun/elin/eldif); sylib/sylibr+imnan/annim convert between
// ¬(a∧b) and (a→¬b) under the guard; mpi/mpd discharge bare premises under the
// guard; notnotrd (d-form, fact-triggered) strips ¬¬ — NOT the 0-hyp notnotr,
// whose syl-composition builds unbounded ground ¬¬-towers ordered ground-first
// expands forever (measured: adding notnotr collapsed t44 3/3 -> 0/3).
// Premise-side (bare) forms: mpbi fires at el-bicond expansion against premises
// already in the index; simpli/simpri/imnani split bare facts; ori turns a bare
// disjunction into its implication form; ord is its d-form dual (the deduction
// ∨-elim: ¬G→(a∨b) advances to ¬G→(¬a→b), then mpd — the t39 unlock);
// mt2/pm1.4 finish the ∨-transport clash. pm2.65i+notnotri = the collision.
// NO sseli (⊆-propagation is cluster-scope's job; its schematic implications
// only junked the wave here — measured, no closure needed it).
// A SEPARATE scope for the NARROW checker-el stage only (the union-dilution lesson).
ruMizarElScope() -> [int] {
	map(["syl", "mpd", "pm2.45", "pm2.46", "sylnib", "sylnibr", "sylib", "sylibr",
		"imnan", "annim", "elun", "elin", "eldif", "mpi", "mpbi", "simpli", "simpri",
		"simpld", "simprd", "imnani", "notnotrd", "nsyl", "ori", "ord", "ax-mp",
		"pm1.4", "mt2", "pm2.65i", "notnotri",
		// 1-hyp elim forms of the el-biconds (miz_aux.ru, hand-authored): trigger
		// = the ground ∈-premise itself; the schematic biconds are ground-first-
		// deferred forever, so mpbi can never unfold a bare premise in-wave.
		"elunei", "elinei", "eldifei"], s2id_);
}
// Classical case-split: excluded middle (exmid), ∨-elim over the split (pm2.61i/pm2.61d, jaoi/mpjaodan),
// non-contradiction (pm3.24).
ruCheckerExmidScope() -> [int] {
	map(["exmid", "pm2.61i", "pm2.61d", "pm2.61ii", "jaoi", "jaod", "mpjaodan", "pm3.24", "orc", "olc"], s2id_);
}
// First-order ⊆/=/∈ bridge: reduce a ⊆/= GOAL to a fresh-witness membership subgoal (ssriv/ssrdv/eqriv/
// eqrdv), instantiate a ⊆/= FACT at a witness (ssel/sseld/eleq2/eleq2d).
ruCheckerBridgeScope() -> [int] {
	map(["ssriv", "ssrdv", "eqriv", "eqrdv", "ssel", "sseld", "eleq2", "eleq2d", "eleq1", "eleq1d",
		"dfss2", "dfss3", "sspss", "eqss", "eqssd"], s2id_);
}
// Membership-over-operation unfold: e∈(A∪B)/(A∩B)/(A∖B)/𝒫A/{A}/∅ via the el-lemma iffs.
ruCheckerUnfoldScope() -> [int] {
	// elsymdif: (A∈(B△C)) ↔ ¬((A∈B)↔(A∈C)) — the △ membership unfold. The eq-rewrite
	// refiner already maps csymdif→elsymdif (unfold.flow), but without it HERE the residual
	// searches could never APPLY it — the 16 △-equality theorems of xboole_1 were unreachable.
	map(["elun", "elin", "eldif", "elsymdif", "velpw", "velsn", "noel", "elsn", "elpr", "eluni", "elint",
		"mpbi", "mpbir", "sylib", "sylibr", "biimpi", "biimpri"], s2id_);
}
// The FULL checker scope: prop ∪ refute ∪ exmid ∪ bridge ∪ unfold — the complete rule set the engine
// needs so a scoped bidirectional search stands in for the Mizar-style `by`-checker.
ruCheckerFullScope() -> [int] {
	uniq(concatA([
		ruCheckerPropScope(), ruCheckerRefuteScope(), ruCheckerExmidScope(),
		ruCheckerBridgeScope(), ruCheckerUnfoldScope(),
		// deduction-form structural + MP lemmas the emitter also uses (∧R/→R/∨R/↔R, forward MP/∧-elim).
		map(["mpd", "simpld", "simprd", "biimpd", "biimprd", "adantr", "a1i", "orcd", "olcd",
			"impbii", "impbid", "jca", "pm3.2i", "ex", "imp"], s2id_)
	]));
}

ruResidualVerdictsKey = "residual.verdicts";

ruResidualVerdicts(b : RuTacticBoard) -> Tree<Pair<string, [RuExpNode]>, RuResidualVerdict> {
	switch (ruBoardGet(b, ruResidualVerdictsKey)) {
		None(): makeTree();
		Some(t): cast(t : flow -> Tree<Pair<string, [RuExpNode]>, RuResidualVerdict>);
	}
}

// The equalizer-rewrite memo (board artifact "rewrite.cache"): the per-hyp rewrites are
// identical for every residual call of a prove step — key = (expr nodes, nnf), RuEqRewrite
// is pure data. Step-scoped because `precedes` changes per theorem.
ruRewriteCacheKey = "rewrite.cache";

ruMemoRewrite(memo : Maybe<RuResidualMemo>, em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int,
	e : RuExp, nnf : bool, precedes : (int) -> bool, pool : Tree<string, RuProofTree>) -> RuEqRewrite {
	switch (memo) {
		None(): ruEqualizerRewrite(em, conn, wff, stmtClass, [], e, nnf, precedes, pool);
		Some(m): {
			cache = switch (ruBoardGet(m.board, ruRewriteCacheKey)) {
				None(): makeTree();
				Some(t): cast(t : flow -> Tree<Pair<[RuExpNode], bool>, RuEqRewrite>);
			};
			key = Pair(e.nodes, nnf);
			switch (lookupTree(cache, key)) {
				Some(r): r;
				None(): {
					r = ruEqualizerRewrite(em, conn, wff, stmtClass, [], e, nnf, precedes, pool);
					ruBoardSet(m.board, ruRewriteCacheKey, setTree(cache, key, r));
					r;
				}
			}
		}
	}
}

// THE FACTOR-BY-DEPENDENCY CACHES. The stage cascade's residual calls differ in
// (scope, budgets, closer) — the full-config verdict memo above only catches exact
// re-entries. But two sub-computations do NOT depend on that config and are shared
// across all stages of a prove step:
//   residual.saturate — ruInSaturate output, keyed (goal, nnf): pure data (facts+DVs).
//   residual.fallback — the whole post-closer fallback chain (congruence try, ∃-tries,
//     certificates — the exponential part), keyed (goal, nnf); same completeness rule
//     as the verdict memo (truncated failures re-run).
ruSaturateCacheKey = "residual.saturate";
ruFallbackCacheKey = "residual.fallback";

ruMemoSaturate(memo : Maybe<RuResidualMemo>, math : RuMath, env : RuEnv, stmtClass : int,
	instHyps : [Pair<RuProofTree, RuExp>], goal : RuExp, cap : int, nnf : bool) -> Pair<[Pair<RuExp, RuProofTree>], Set<RuDisj>> {
	switch (memo) {
		None(): ruInSaturate(math, env, stmtClass, instHyps, goal, cap);
		Some(m): {
			cache = switch (ruBoardGet(m.board, ruSaturateCacheKey)) {
				None(): makeTree();
				Some(t): cast(t : flow -> Tree<Pair<[RuExpNode], bool>, Pair<[Pair<RuExp, RuProofTree>], Set<RuDisj>>>);
			};
			key = Pair(goal.nodes, nnf);
			switch (lookupTree(cache, key)) {
				Some(r): r;
				None(): {
					r = ruInSaturate(math, env, stmtClass, instHyps, goal, cap);
					ruBoardSet(m.board, ruSaturateCacheKey, setTree(cache, key, r));
					r;
				}
			}
		}
	}
}

ruFallbackLookup(memo : Maybe<RuResidualMemo>, goal : RuExp, nnf : bool) -> Maybe<RuResidualVerdict> {
	switch (memo) {
		None(): None();
		Some(m): switch (ruBoardGet(m.board, ruFallbackCacheKey)) {
			None(): None();
			Some(t): lookupTree(cast(t : flow -> Tree<Pair<[RuExpNode], bool>, RuResidualVerdict>), Pair(goal.nodes, nnf));
		}
	}
}

ruFallbackStore(memo : Maybe<RuResidualMemo>, goal : RuExp, nnf : bool, v : RuResidualVerdict) -> void {
	switch (memo) {
		None(): {};
		Some(m): {
			cache = switch (ruBoardGet(m.board, ruFallbackCacheKey)) {
				None(): makeTree();
				Some(t): cast(t : flow -> Tree<Pair<[RuExpNode], bool>, RuResidualVerdict>);
			};
			ruBoardSet(m.board, ruFallbackCacheKey, setTree(cache, Pair(goal.nodes, nnf), v));
		}
	}
}

ruCheckerResidual(math : RuMath, env : RuEnv, info : RuDeclInfo, stmtClass : int,
	hyps : [RuExp], goal : RuExp, scope : [int], mkCloser : () -> RuProverTactic, limit : double, nnf : bool, precedes : (int) -> bool,
	memo : Maybe<RuResidualMemo>) -> Maybe<RuRefineResult> {
	run = \-> ruCheckerResidualRun(math, env, info, stmtClass, hyps, goal, scope, mkCloser, limit, nnf, precedes, memo);
	if (env.conf.verbose >= 5) {
		env.out.println("    resid-memo: " + (switch (memo) { None(): "NONE"; Some(m): "fp=" + m.fingerprint + " entries=" + i2s(sizeTree(ruResidualVerdicts(m.board))); }));
	} else {};
	switch (memo) {
		None(): run().first;
		Some(m): {
			key = Pair(m.fingerprint, goal.nodes);
			runStore = \-> {
				r = run();
				// never overwrite a Proved entry (unreachable — proved hits return below)
				verdict = switch (r.first) {
					Some(res): RuResidualProved(res);
					None(): RuResidualFailed(r.second, limit);
				};
				ruBoardSet(m.board, ruResidualVerdictsKey, setTree(ruResidualVerdicts(m.board), key, verdict));
				r.first;
			}
			switch (lookupTree(ruResidualVerdicts(m.board), key)) {
				None(): runStore();
				Some(v): switch (v) {
					RuResidualProved(res): {
						if (env.conf.verbose >= 4) { env.out.println("  resid: memo hit (proved) goal=" + ru2s(goal, math)); } else {};
						Some(res);
					}
					RuResidualFailed(truncated, __): {
						// COMPLETENESS RULE: only a budget-independent failure (no wall gate
						// fired) short-circuits; a truncated one re-runs (and re-records).
						if (truncated) runStore()
						else {
							if (env.conf.verbose >= 4) { env.out.println("  resid: memo hit (failed) goal=" + ru2s(goal, math)); } else {};
							None();
						}
					}
				}
			}
		}
	}
}

// The residual body: Pair(result, truncated) — `truncated` = some wall-clock gate fired
// during the run (the closer's own env timer, or the fallback chain's fbTimer).
ruCheckerResidualRun(math : RuMath, env : RuEnv, info : RuDeclInfo, stmtClass : int,
	hyps : [RuExp], goal : RuExp, scope : [int], mkCloser : () -> RuProverTactic, limit : double, nnf : bool, precedes : (int) -> bool,
	memo : Maybe<RuResidualMemo>) -> Pair<Maybe<RuRefineResult>, bool> {
	// mirrors the closer sub-prove's own timer (ruInitProverEnv gets the same `limit`),
	// started strictly earlier — fires at least as often as the closer's gate.
	callTimer = ruMakeLimitedTimer(limit);
	fbRef : ref [RuTimer] = ref [];
	em = RuEnvMath(math, env); conn = ruPConnectives(); wff = tp2id_("wff");
	nh = length(hyps);
	// the problem's SETNESS POOL (class-loci): the per-premise rewrites below are each called
	// with hyps=[], so without this the theorem's own `T ∈ _V` facts are invisible and the
	// hyp-carrying membership lemmas (elpr/elsn/elpw) decline at every class metavar.
	hypPool = ruSetnessPoolOf(mapi(hyps, \i, h -> Pair(h, i)), stmtClass);
	// HYP-REWRITING: unfold each hyp the same way the goal was unfolded, so a gap like
	// `x∈(A∪B) ⊢ (x∈A)∨(x∈B)` connects (the hyp is rewritten to the goal's normal form). A hyp that
	// changes becomes a DERIVED premise `hyp'`, proven from the real hyp by mpbi(hyp, hyp↔hyp').
	// a SETNESS hyp is a type fact, not a literal to decompose: its rewrite (`x ∈ _V` → `x ⊆ x`)
	// is pure junk that then crowds the certificate's premise selection (class-loci t32).
	isSetnessExp = \e : RuExp -> ruUSetnessHyp(e, s2id("wcel"), s2id("cvv")) != None();
	hRw = map(hyps, \h -> if (isSetnessExp(h)) RuEqRewrite(h, None(), makeSet())
		else ruMemoRewrite(memo, em, conn, wff, stmtClass, h, nnf, precedes, hypPool));
	changed = filtermapi(hyps, \i, __ -> switch (hRw[i].proof) { None(): None(); Some(p): Some(Pair(i, p)); });
	derivedHyps = map(changed, \c -> hRw[c.first].residual);
	derivedProofs = map(changed, \c -> {
		i = c.first;
		RuProofStep(s2id_("mpbi"),
			[RuProofHyp(i, RuStmt(stmtClass, [hyps[i]], -1)), c.second],   // ph=hyp_i, (ph↔ps)=hyp_i↔hyp_i'
			RuStmt(stmtClass, [hRw[i].residual], -1));                      // ⊢ hyp_i'
	});
	hypDisjs = fold(changed, makeSet(), \acc, c -> mergeSets(acc, hRw[c.first].disjs));
	// THE MIZAR SATURATION (ruInSaturate): emptiness premises become their eq0 ∀-forms, every
	// ∀-shaped premise is instantiated at the setvars the problem mentions (spcv, DV declared),
	// and reflexivity facts t=t (equid) join. Each saturated fact is then NORMALIZED by the same
	// rewrite the hyps got — an instance ¬(x5 ∈ ({x5}∖{x8})) is opaque to the propositional closer
	// until eldif/elsn reduce it to ¬((x5=x5) ∧ ¬(x5=x8)) — and both forms join as derived
	// premises, with self-contained proofs (spliced below like the unfolded hyps).
	instHyps : [Pair<RuProofTree, RuExp>] = concat(
		mapi(hyps, \i, h -> Pair(RuProofHyp(i, RuStmt(stmtClass, [h], -1)), h)),
		map(changed, \c -> Pair(
			RuProofStep(s2id_("mpbi"),
				[RuProofHyp(c.first, RuStmt(stmtClass, [hyps[c.first]], -1)), c.second],
				RuStmt(stmtClass, [hRw[c.first].residual], -1)),
			hRw[c.first].residual))
	);
	// ENSURE-TYPE, the type registry's first consumer (soft-type-layer.md §4.3). A Mizar mode or
	// attribute is opaque until its DEFINITION is in the problem — `element x7 x4` is underivable
	// from `x7 ∈ x4` with d1_subset_1 merely sitting in scope as an axiom. So the registry's
	// definition rules are seeded into the ∀-pool the saturation ALREADY instantiates (spcv at the
	// problem's terms): no new proof-assembly engine, and each fact arrives with its own proof, so
	// nothing new is trusted.
	// GATED on head occurrence — only notions the problem actually mentions. Every extra pool
	// entry competes for the instance cap and taxes every downstream closer (the standing cost
	// law), so an ungated seed would be a regression by construction.
	// PARKED BEHIND A FLAG, OFF by default; enable with `conf-set ensure-type=1` (the same
	// mechanism as no-literal-closers — a bare CLI arg does NOT reach conf.opts). It is wired end-to-end and fires
	// (t2_subset_1: 1 definition seeded, sat 11 -> 17), but it closes NOTHING yet — subset_1 is
	// 13/53 with and without it — while it does fire on zfmisc, so the risk to a proved floor is
	// real and the gain is zero. Shipping that trade is exactly what was reverted twice today
	// (the subcompar scope, the wide-scope branch retry). Kept as working scaffolding so the next
	// iteration starts from here.
	// THE ISOLATED BLOCKER: the ∀∀ instantiation of d1_subset_1 never yields
	// `element x7 x4 ↔ x7 ∈ x4`. Ruled out by test: the instance cap (8 -> 24 changed nothing)
	// and missing congruences (pr_element_cong1d/cong2d are both emitted, correctly shaped).
	// Remaining suspects: the candidate list in COERCED setvar form, and the setness proof.
	tyOn = ruOptsString(env.conf.opts, "ensure-type", "") == "1";
	tyTable = if (!tyOn) RuTypeTable([], makeTree()) else ruTypeTable(math);
	tyHeads = if (!tyOn) makeSet() else ruTyHeadsOf(tyTable, arrayPush(map(instHyps, \p -> p.second), goal));
	// GUARD DISCHARGE comes first: for a GUARDED definition the raw axiom is useless (its usable
	// biconditional sits behind `X ≠ ∅`), so build the discharged instance directly — see
	// ruTyGuardFacts. The unguarded definitions are still seeded as before.
	tyGuard = if (isEmptySet(tyHeads)) [] else
		map(ruTyGuardFacts(math, env, stmtClass, tyTable, instHyps, goal), \f -> Pair(f.first, f.second));
	tyFacts = if (isEmptySet(tyHeads)) [] else concat(tyGuard,
		filtermap(filter(tyTable.all, \r -> r.role == RuTyDef() && !r.guarded && containsSet(tyHeads, r.head)),
			\r -> ruTyRuleFact(math, stmtClass, r)));
	if (env.conf.verbose >= 4 && tyOn && tyFacts == []) {
		env.out.println("  ensure-type: ON but nothing seeded — table " + i2s(length(tyTable.all))
			+ " rules, heads matched " + i2s(sizeSet(tyHeads)));
	} else {};
	if (env.conf.verbose >= 4 && tyFacts != []) {
		env.out.println("  ensure-type: " + i2s(length(tyFacts)) + " definition(s) seeded for "
			+ i2s(sizeSet(tyHeads)) + " head(s), of which " + i2s(length(tyGuard)) + " guard-discharged");
		iter(tyGuard, \f -> env.out.println("    ty-guard: " + ru2s(f.second, math)));
	} else {};
	sat = ruMemoSaturate(memo, math, env, stmtClass, concat(instHyps, tyFacts), goal, 8, nnf);
	satAll = concatA(map(sat.first, \f -> {
		// a reflexivity fact `t = t` is already a literal — its eqss rewrite is pure junk cost
		isRefl = ruEqHead(f.first) == s2id("wceq") && {
			sides = ruEqArgs(f.first);
			sides.first.nodes == sides.second.nodes;
		};
		if (isRefl) [f] else {
			rw2 = ruMemoRewrite(memo, em, conn, wff, stmtClass, f.first, nnf, precedes, hypPool);
			switch (rw2.proof) {
				None(): [f];
				Some(p2): [f, Pair(rw2.residual,
					RuProofStep(s2id_("mpbi"), [f.second, p2], RuStmt(stmtClass, [rw2.residual], -1)))];
			}
		}
	}));
	nd = length(derivedHyps);
	// premises: the real hyps (0..nh-1), then the derived unfolded hyps, then the saturation.
	premises = concat3(
		mapi(hyps, \i, h -> RuHyp(i, RuStmt(stmtClass, [h], -1), -1)),
		mapi(derivedHyps, \j, h -> RuHyp(nh + j, RuStmt(stmtClass, [h], -1), -1)),
		mapi(satAll, \k, p -> RuHyp(nh + nd + k, RuStmt(stmtClass, [p.first], -1), -1))
	);
	hypDisjs2 = mergeSets(hypDisjs, sat.second);
	// Drive the closer (a fresh one per call) over `scope` on `premises ⊢ goal`, then splice each derived
	// premise's leaf (index ≥ nh) with its mpbi derivation. Carry the hyps' DV provisos out.
	// The bounded BFS first (cheap, closes everything it used to close at the old cost), then the
	// COMPLETE propositional check as the FALLBACK (the Mizar shape: after saturation the literal
	// set is DECIDED, not searched over a hand-kept lemma list — which kept silently missing basic
	// combinations: bare ∨-introduction two days ago, disjunctive syllogism today).
	// ruHilbertPropProof is the G3cp-refutation -> Hilbert emitter: deterministic and complete
	// over the atomized premises, but exponential in the atom count — so it runs only where the
	// cheap search failed, and only under an atom-count gate (running it FIRST on every residual
	// starved the fixed wall-clock stage slices: zfmisc full stack 126 -> 109).
	premiseExps2 = map(premises, \pr -> ruExp(pr.stmt.exps[0]));
	spliceAll = \unc : RuProofTree -> ruUnfoldSplice(unc, nh, concat(derivedProofs, map(satAll, \p -> p.second)));
	if (env.conf.verbose >= 4) {
		env.out.println("  resid: goal=" + ru2s(goal, math) + " hyps=" + i2s(nh) + " derived=" + i2s(nd) + " sat=" + i2s(length(satAll)));
		if (env.conf.verbose >= 6) {
			iter(premises, \pr -> env.out.println("    residPrem: " + ru2s(ruExp(pr.stmt.exps[0]), math)));
		} else {};
	} else {};
	res0 = switch (ruRunCloser(math, env, info, stmtClass, premises, goal, scope, mkCloser(), limit)) {
		Some(unc): Some(RuRefineResult(spliceAll(unc), hypDisjs2));
		None(): switch (ruFallbackLookup(memo, goal, nnf)) {
			// The fallback chain below (congruence try, ∃-tries, certificates) does NOT
			// depend on the closer config — its verdict is shared across all stages of
			// the step. Truncated failures re-run (the completeness rule).
			Some(fv): switch (fv) {
				RuResidualProved(fres): {
					if (env.conf.verbose >= 4) { env.out.println("  resid: fallback memo hit (proved) goal=" + ru2s(goal, math)); } else {};
					Some(fres);
				}
				RuResidualFailed(ftrunc, __): if (!ftrunc) {
					if (env.conf.verbose >= 4) { env.out.println("  resid: fallback memo hit (failed) goal=" + ru2s(goal, math)); } else {};
					None();
				} else ruResidualFallback(memo, math, env, stmtClass, goal, nnf, precedes, conn, wff, em,
					premiseExps2, spliceAll, hypDisjs2, fbRef, hypPool);
			}
			None(): ruResidualFallback(memo, math, env, stmtClass, goal, nnf, precedes, conn, wff, em,
				premiseExps2, spliceAll, hypDisjs2, fbRef, hypPool);
		}
	};
	// GENERAL-PATH OR-ELIM (last resort): a pooled disjunction fact P∨Q closes the
	// goal when both branches do — prove `premises,P ⊢ G` / `premises,Q ⊢ G` (full
	// closer, HYP form), bridge each to `P→G` / `Q→G` by the deduction theorem
	// (deduction.flow, reusing the rule-table d-forms), then jaoi + ax-mp(P∨Q). The
	// deduction bridge is what the general path lacks (the disabled battery is
	// deduction-form natively); its d-form holes make the transform fail cleanly, so
	// or-elim just declines rather than building an unsound tree.
	// NB: the fallback's own fbTimer being spent must NOT gate or-elim (it has its own
	// budget) — only a real success or the whole callTimer running out does.
	res = if (isSome(res0)) res0
		else {
			// or-elim gets its OWN budget (the fallback may already have spent callTimer),
			// bounding the WHOLE candidate sweep — it fires once per distinct (fingerprint,
			// goal) since the residual verdict is memoized.
			oeRef = ruMakeLimitedTimer(1500.0);
			ruResidualOrElim(math, env, info, stmtClass, premises, premiseExps2, goal,
				limit, spliceAll, hypDisjs2, oeRef);
		};
	Pair(res, ruTimeIsOver(callTimer) || exists(^fbRef, ruTimeIsOver));
}

// GENERAL-PATH OR-ELIM. For each pooled disjunction fact P∨Q (a premise/derived/sat
// literal), prove the goal under each disjunct through the FULL closer — `premises,P
// ⊢ G` and `premises,Q ⊢ G`, HYP form — then bridge each to the branch IMPLICATION
// `P→G` / `Q→G` by the deduction theorem (ruDeductionTheorem, deduction.flow), and
// combine jaoi(P→G, Q→G) with ax-mp against P∨Q. The deduction bridge is the piece
// the general path was missing (the disabled battery closes disjunctions natively in
// deduction form); a d-form hole makes the bridge decline, never build junk. First
// disjunction that closes both branches wins (a LIMIT, not a variant discard).
ruResidualOrElim(math : RuMath, env : RuEnv, info : RuDeclInfo, stmtClass : int,
	premises : [RuHyp], premiseExps2 : [RuExp], goal : RuExp, limit : double,
	spliceAll : (RuProofTree) -> RuProofTree, hypDisjs2 : Set<RuDisj>, timer : RuTimer) -> Maybe<RuRefineResult> {
	woId = s2id("wo"); wiId = s2id("wi"); wff = tp2id_("wff");
	isOr = \e : RuExp -> ruInHead(e) == woId && ruInArity(e) == 2;
	if (ruTimeIsOver(timer)) None() else {
	// Candidate disjunctions to split on, each with HOW to prove it:
	//   Some(i) — premiseExps2[i] IS the disjunction (a hyp leaf, FREE — no sub-prove);
	//   None()  — a disjunction that occurs as the CONSEQUENT of a pooled implication
	//             `A→(P∨Q)` (the case-split source Mizar derives, e.g. the enum
	//             membership x∈{a,b} unfolds to (x=a)∨(x=b) only AFTER the ⊆-hyp is
	//             applied); proved on demand by a sub-closer.
	// COST MODEL: direct pooled ∨-facts are free and uncommon, so they always qualify
	// (t73: the hyp `x5∈(𝒫(A∖B)∪𝒫(B∖A))` unfolds straight to the case-split, and its
	// GOAL is not a disjunction). The implication-consequent candidates each cost a
	// sub-prove, so they are restricted to DISJUNCTION goals (t19/t22) — ungated they
	// fire on every failing residual and compound into a suite-wide slowdown.
	directOrs0 = filtermapi(premiseExps2, \i, e -> if (isOr(e)) Some(Pair(e, Some(i))) else None());
	implOrs = if (!isOr(goal)) [] else filtermap(premiseExps2, \e ->
		if (ruInHead(e) == wiId && ruInArity(e) == 2 && isOr(ruInArgs(e)[1])) Some(Pair(ruInArgs(e)[1], None())) else None());
	// SPECULATIVE PATH (goal is NOT a disjunction — t70/t73): admit ONE unambiguous
	// pooled case-split only. Trying every pooled ∨ on every failing non-∨ residual
	// is what cost t21/t53/t66 (measured); a single candidate is the shape where the
	// hyp unfold IS the case analysis (x5∈(𝒫(A∖B)∪𝒫(B∖A)) → the two-way split).
	directOrs = if (isOr(goal) || length(directOrs0) <= 2) directOrs0 else [];
	// implication-consequent disjunctions FIRST (the derived, relevant ones), deduped by expr.
	cands = fold(concat(implOrs, directOrs), Pair([], makeSet()), \ac : Pair<[Pair<RuExp, Maybe<int>>], Set<[RuExpNode]>>, c ->
		if (containsSet(ac.second, c.first.nodes)) ac else Pair(arrayPush(ac.first, c), insertSet(ac.second, c.first.nodes)));
	if (cands.first == [] || ruTimeIsOver(timer)) None() else {
		rt = ruRuleTable(math);
		nh2 = length(premises);   // index of the added branch-assumption hypothesis
		// The branch sub-proves are SMALL problems (goal + a few premises + one added
		// disjunct) run by a bare bfs, so the scope must be TIGHT — handing them the
		// caller's stage scope makes the branch bfs explode (measured: it bought t70 but
		// cost 8 cost-regressions). tactics/scopes/orelim-branch-scope.scope takes
		// precedence (scopes as data — the curation, and the INFERENCE-FORM lesson behind
		// it, lives there); the list below is only the fallback.
		branchScope = eitherFn(ruLoadScopeFile("orelim-branch-scope"), idfn, \ ->
			map(["eqimss", "eqimss2", "eqss", "eqssi", "jca", "olci", "orci", "biimpi", "biimpri",
				"eqcomi", "ax-mp", "mpbi", "mpbir", "syl", "sseq1", "sseq2", "simpli", "simpri",
				"sstr", "sstri", "sseqtrri", "sseqtri", "difsssymdif", "symdifcom", "velpw", "ssun1", "ssun2", "difss"], s2id_));
		if (env.conf.verbose >= 4) {
			env.out.println("  orElimTry: goal=" + ru2s(goal, math) + " cands=" + i2s(length(cands.first)));
		} else {};
		fold(take(cands.first, 6), None(), \acc : Maybe<RuRefineResult>, cand ->
			if (isSome(acc) || ruTimeIsOver(timer)) acc else {
				orE = cand.first;
				args = ruInArgs(orE);
				// a proof of the disjunction itself: the pooled hyp, or a sub-prove.
				pOrMb = switch (cand.second) {
					Some(oi): Some(RuProofHyp(oi, RuStmt(stmtClass, [orE], -1)));
					None(): ruRunCloser(math, env, info, stmtClass, premises, orE, branchScope, ruLimitedTactic(ruBreadthFirstTactic, 0.0, 0, 0, 8192, 8, 16), min(limit, ruTimeLeft(timer)));
				};
				if (env.conf.verbose >= 5) { env.out.println("    oe cand=" + ru2s(orE, math) + " provedOr=" + b2s(isSome(pOrMb))); } else {};
				maybeBind(pOrMb, \pOr -> {
					proveBranch = \branchE : RuExp -> {
						branchPrem = arrayPush(premises, RuHyp(nh2, RuStmt(stmtClass, [branchE], -1), -1));
						// ONE attempt on the tight glue scope. A second, wide-scope retry was
						// MEASURED OUT: it bought t70 but cost 8 real cost-regressions
						// (t21/t36/t53/t62/t63/t64/t66/t94) — every wide bfs is a fresh
						// unbounded cost unit on a FAILING branch, and they compound.
						cl = ruRunCloser(math, env, info, stmtClass, branchPrem, goal, branchScope,
							ruLimitedTactic(ruBreadthFirstTactic, 0.0, 0, 0, 8192, 8, 16), min(limit, ruTimeLeft(timer)));
						bres = maybeBind(cl, \btree -> ruDeductionTheorem(rt, math, stmtClass, branchE, nh2, btree));
						if (env.conf.verbose >= 5) { env.out.println("      oe branch=" + ru2s(branchE, math) + " -> " + b2s(isSome(bres))); } else {};
						bres;
					};
					maybeBind(proveBranch(args[0]), \pImp ->
						maybeMap(proveBranch(args[1]), \qImp -> {
							orGoal = ruFwdMkRule(wiId, wff, [orE, goal]);
							pJ = RuProofStep(s2id_("jaoi"), [pImp, qImp], RuStmt(stmtClass, [orGoal], -1));
							pG = RuProofStep(s2id_("ax-mp"), [pOr, pJ], RuStmt(stmtClass, [goal], -1));
							if (env.conf.verbose >= 4) { env.out.println("  orElimTry: CLOSED via " + ru2s(orE, math)); } else {};
							RuRefineResult(spliceAll(pG), hypDisjs2);
						}));
				});
			});
	}
	}
}

// The post-closer fallback chain, factored out so its verdict can be cached per (goal, nnf).
ruResidualFallback(memo : Maybe<RuResidualMemo>, math : RuMath, env : RuEnv, stmtClass : int,
	goal : RuExp, nnf : bool, precedes : (int) -> bool, conn : RuPConnectives, wff : int, em : RuEnvMath,
	premiseExps2 : [RuExp], spliceAll : (RuProofTree) -> RuProofTree, hypDisjs2 : Set<RuDisj>,
	fbRef : ref [RuTimer], hypPool : Tree<string, RuProofTree>) -> Maybe<RuRefineResult> {
	// hypPool = the CALLER's setness pool (built over the real hyps, leaf indices < nh). It is
	// threaded in rather than rebuilt over `premiseExps2` on purpose: the rewrite memo is keyed
	// by (expr, nnf) only, so two differently-numbered pools would let a cached rewrite proof
	// carry hyp leaves from the wrong numbering into another residual run.
	res = {
			// THE EQUALIZER'S SECOND ROUND: an EQUALITY goal gets the congruence-closure
			// decision over the SATURATED premise set — the derived ground equalities
			// (x9=x5 from the unfolded transported membership) exist only here, so the
			// whole-theorem `congruence` pipeline stage never sees them. The closer misses
			// long eqtri/eqcomi chains and the Hilbert emitter treats equality atoms as
			// opaque, so this is the only route for the t5-class (x9=x5, x10=x5 ⊢ x9=x10).
			// Whole-or-nothing and cheap: rules cached, the closure graph is premise-sized.
			congTry = switch (ruCongSides(goal)) {
				None(): None();
				Some(lr): {
					eqFacts = filtermap(mapi(premiseExps2, \i, e -> Pair(i, e)), \ie ->
						if (ruCongIsEq(ie.second)) Some(Pair(RuProofHyp(ie.first, RuStmt(stmtClass, [ie.second], -1)), ie.second)) else None());
					if (eqFacts == []) None() else {
						st = ruCongClose(ruCongRulesCached(math), eqFacts, arrayPush(premiseExps2, goal), stmtClass, math, env);
						if (env.conf.verbose >= 4) {
							env.out.println("  congTry: goal=" + ru2s(goal, math) + " eqFacts=" +
								strGlue(map(eqFacts, \f -> ru2s(f.second, math)), " | ") +
								" entailed=" + b2s(ruCongEqual(st, lr.first, lr.second)));
						} else {};
						switch (ruCongExplain(st, lr.first, lr.second)) {
							None(): None();
							Some(pr): switch (pr) {
								RuProofStep(__, __, __): Some(RuRefineResult(spliceAll(pr), hypDisjs2));
								RuProofHyp(__, __): None();   // goal IS a premise — the closer's job
							}
						}
					}
				}
			};
			if (isSome(congTry)) congTry else {
			// The WHOLE fallback chain (skolemization + subset try + component tries + full
			// retry) shares one wall-clock budget (see the cost-bomb lesson).
			fbTimer = ruMakeLimitedTimer(1000.0);
			fbRef := [fbTimer];
			// SKOLEMIZATION (S4): an ∃-premise is OPAQUE to the propositional check (∃xφ
			// atomizes to a single atom), so eliminate it first — Mizar's pre-check. The
			// premise's own bound var x is the eigenvariable (declined if x occurs free
			// elsewhere): the emitter proves (φ(x) → G) natively in deduction form, exlimiv
			// turns it into (∃xφ → G) — its DV(x, G) proviso declared — and ax-mp with the
			// premise concludes G. First ∃-premise only (nesting = a later increment).
			// the ∃-tries get HALF the fallback budget: the exponential emitter on ∃-shaped
			// residuals must not starve the component-retry chain that closes the borderliner
			// class in article runs (the 6e44dbc4 lesson — full zfmisc slipped 126 -> 124).
			exBudget = ruMakeLimitedTimer(min(500.0, ruTimeLeft(fbTimer)));
			exTry = {
				wexId = s2id("wex");
				plainCands = filtermapi(premiseExps2, \i, e ->
					if (ruEqHead(e) == wexId) Some(RuExPremCand(e, i, RuProofHyp(i, RuStmt(stmtClass, [e], -1)), makeSet())) else None());
				if ((plainCands == [] && !exists(premiseExps2, \e -> ruInHasExUnfold(math, ruEqHead(e))))
					|| !precedes(s2id_("exlimiv"))) None()
				else {
				// ELIM on demand: eluni-shaped premises yield their ∃v-forms here, NOT as
				// saturation facts (there they add an opaque atom to every closer's problem).
				usedIds = fold(arrayPush(premiseExps2, goal), makeSet(), \acc, e ->
					fold(e.nodes, acc, \a, n -> switch (n) { RuVar(id, __): insertSet(a, id); RuRuleNode(__, __): a; }));
				exhyps = mapi(premiseExps2, \i, e -> {
					ph : RuProofTree = RuProofHyp(i, RuStmt(stmtClass, [e], -1));
					Pair(ph, e);
				});
				derived = ruInRelExistsFacts(math, env, stmtClass, exhyps, usedIds, tp2id_("setvar"));
				exCands = concat(plainCands, map(derived.first, \d -> RuExPremCand(d.second, -1, d.first, derived.second)));
				fold(exCands, None(), \found : Maybe<RuRefineResult>, cand ->
				if (isSome(found) || ruTimeIsOver(exBudget)) found
				else {
					exPrem = cand.prem;
					xE = (ruEqArgs(exPrem)).first;
					body = (ruEqArgs(exPrem)).second;
					others = filter(enumFromTo(0, length(premiseExps2) - 1), \i -> i != cand.exclude);
					otherExps = map(others, \i -> premiseExps2[i]);
					// exlimiv's ONLY proviso is DV(x, goal): decline when x occurs in the goal.
					// Occurrences of x in other hypothesis LEAVES are licensed (hyps are
					// universally closed; the verifier checks DV at assertion applications only).
					xInGoal = switch (xE.nodes[0]) {
						RuRuleNode(__, __): true;
						RuVar(xid, __): exists(goal.nodes, \n -> switch (n) { RuVar(id, __): id == xid; RuRuleNode(__, __): false; });
					};
					// unfold the ∃-body the same way real hyps are unfolded (its atoms — x∈(A∩B)
					// composites — are otherwise opaque to the propositional check); the bridge
					// (body → body') is biimpi of the rewrite bicond, syl-composed below.
					bodyRw = ruMemoRewrite(memo, em, conn, wff, stmtClass, body, nnf, precedes, hypPool);
					body2 = bodyRw.residual;
					natoms = sizeTree(fold(concat(otherExps, [body2, goal]), ruPAtomNodes(conn, goal), \acc, e -> mergeTree(acc, ruPAtomNodes(conn, e))));
					if (env.conf.verbose >= 4) {
						env.out.println("  exTry: prem=" + ru2s(exPrem, math) + " xInGoal=" + b2s(xInGoal) + " natoms=" + i2s(natoms) +
							(if (body2.nodes == body.nodes) "" else " body'=" + ru2s(body2, math)));
					} else {};
					// 24-atom gate: the 16 tuning predated the fallback verdict cache — repeat
					// attempts are free now, and exBudget bounds each live one (t77 xboole_1's
					// witness route needs 20).
					if (xInGoal || natoms > 24) None()
					else {
						atomNodesEx = fold(concat(otherExps, [body2]), ruPAtomNodes(conn, goal), \acc, e -> mergeTree(acc, ruPAtomNodes(conn, e)));
						ctxH = RuHCtx(ruHCtx(em, wff, stmtClass, atomNodesEx) with
							timer = ruMakeLimitedTimer(ruTimeLeft(exBudget)), fo = Some(ruInAtomCongsCached(math)));
						switch (ruHilbertProveUnder(ctxH, map(otherExps, \e -> ruPAtomize(conn, e)), ruPAtomize(conn, body2), ruPAtomize(conn, goal))) {
							None(): None();
							Some(tree): {
								xVar = switch (xE.nodes[0]) { RuVar(id, tp): RuVar(id, tp); RuRuleNode(__, __): ruNoVar; };
								treeB = switch (bodyRw.proof) {
									None(): tree;
									Some(pRw): {
										impBB = ruFwdMkRule(s2id("wi"), wff, [body, body2]);
										pImpB = RuProofStep(s2id_("biimpi"), [pRw], RuStmt(stmtClass, [impBB], -1));
										impBG = ruFwdMkRule(s2id("wi"), wff, [body, goal]);
										RuProofStep(s2id_("syl"), [pImpB, tree], RuStmt(stmtClass, [impBG], -1));
									}
								};
								exImp = ruFwdMkRule(s2id("wi"), wff, [exPrem, goal]);
								pEx = RuProofStep(s2id_("exlimiv"), [ruInRemapLeaves(treeB, others)], RuStmt(stmtClass, [exImp], -1));
								pG  = RuProofStep(s2id_("ax-mp"), [cand.minor, pEx], RuStmt(stmtClass, [goal], -1));
								// DV(x, ψ) instantiated at the concrete goal: x # each goal var.
								dvs = fold(goal.nodes, makeSet(), \ds, n -> switch (n) {
									RuVar(id, tp): if (id == xVar.id) ds else insertSet(ds, RuDisj(RuVar(id, tp), xVar));
									RuRuleNode(__, __): ds;
								});
								Some(RuRefineResult(spliceAll(pG),
									mergeSets(mergeSets(mergeSets(mergeSets(hypDisjs2, dvs), ^(ctxH.disjs)), bodyRw.disjs), cand.disjs)));
							}
						}
					}
				});
				}
			};
			if (isSome(exTry)) exTry else {
			// SKOLEMIZATION, GOAL SIDE (S4b): an ∃-GOAL is equally opaque to the propositional
			// check — introduce a WITNESS instead: for each candidate term t of the problem,
			// ψ = φ[t/x] (the mechanical subst congruence + setness; spcev assembles ψ → ∃xφ),
			// and the certificate closes ψ. First witness that closes wins (a LIMIT, not a
			// variant discard — the engine's own routes stay available).
			exGoalTry = if (ruEqHead(goal) != s2id("wex") || !precedes(s2id_("spcev")) || ruTimeIsOver(exBudget)) None()
				else {
				// empty pool: premiseExps2 are REWRITTEN exprs whose proofs are not bare
			// leaves; the emitter's own setness pool (ctxH) covers the branch side
			ws = ruInExGoalWitnesses(math, env, stmtClass, makeTree(), goal, premiseExps2, 8);
				if (env.conf.verbose >= 4) {
					env.out.println("  exGoal: goal=" + ru2s(goal, math) + " witnesses=" + i2s(length(ws)) +
						(if (ws == []) "" else " first=" + ru2s(ws[0].subgoal, math)));
				} else {};
				fold(ws, None(), \found : Maybe<RuRefineResult>, w ->
					switch (found) {
						Some(__): found;
						None(): if (ruTimeIsOver(exBudget)) None()
							else maybeMap(ruHilbertPropProofTimed(em, conn, wff, stmtClass, premiseExps2, w.subgoal, ruTimeLeft(exBudget), Some(ruInAtomCongsCached(math))),
								\pr -> RuRefineResult(spliceAll(w.assemble(pr.first)),
									mergeSets(mergeSets(hypDisjs2, w.disjs), pr.second.disjs)));
					});
				};
			if (isSome(exGoalTry)) exGoalTry else {
			// RELEVANCE for the complete check: G3cp is exponential in the atom count, and the
			// saturation deliberately over-produces (instances at every occurring term), so running
			// the check over ALL premises either blows up or gets gated away — the gate then defeats
			// the very theorems the saturation enabled. Select the ATOM-CONNECTED premises instead:
			// two rounds of "shares an atom with the goal's growing atom set" — the standard
			// relevance closure, at the literal level. The certificate's hyp leaves are remapped
			// from subset positions back to the original premise indices before splicing.
			// FIRST-ORDER connectivity (S5): the per-branch transport bridges atoms through
			// EQUALITIES — (x11=x6) shares no atom with (x6∈x24), yet the branch moves it to
			// (x11∈x24). Terms therefore propagate ONLY through non-reflexive equality atoms:
			// seed = the goal atoms' argument terms; a premise joins if it shares an atom OR
			// any of its atoms' argument terms is equality-reachable; an admitted equality
			// extends the term set with both sides. Full term-keys over-widened the subsets
			// (t2/t86 blew their gates) — the equality bridge is the narrow, principled rule.
			atomKeys = \e : RuExp -> buildSet(getTreeKeys(ruPAtomNodes(conn, e)));
			termKey = \arg : RuExp -> strGlue(map(arg.nodes, \n -> switch (n) {
				RuRuleNode(idT, __): "R" + i2s(ruIdType2Id(idT));
				RuVar(id, __): "V" + i2s(id);
			}), ",");
			atomExps = \e : RuExp -> map(getTreeValues(ruPAtomNodes(conn, e)), \nodes -> RuExp(nodes, -1));
			argTerms = \e : RuExp -> fold(atomExps(e), makeSet(), \acc, ae ->
				fold(ruInArgs(ae), acc, \a2, arg -> insertSet(a2, termKey(arg))));
			eqSides = \e : RuExp, known : Set<string> -> fold(atomExps(e), makeSet(), \acc, ae ->
				if (ruEqHead(ae) != s2id("wceq")) acc else {
					sides = ruEqArgs(ae);
					if (sides.first.nodes == sides.second.nodes) acc   // refl: no transport value
					else if (containsSet(known, termKey(sides.first)) || containsSet(known, termKey(sides.second)))
						insertSet(insertSet(acc, termKey(sides.first)), termKey(sides.second))
					else acc;
				});
			// MEMBERSHIP/INCLUSION BRIDGE (the type layer's route). An equality moves an atom to
			// another term, and so does a `∈`/`⊆` chain: the goal `x7 ∈ x4` is reached from
			// `x7 ∈ x28` and `x28 ⊆ x4`, whose premises share a TERM with the goal but no ATOM —
			// so atom connectivity alone drops exactly the route (measured: 86 relevance refusals
			// on t2_subset_1 with the type-layer facts already in the pool). Same one round and
			// the same caps as the equality bridge; nothing is admitted that does not touch a
			// term already reachable from the goal.
			relSides = \e : RuExp, known : Set<string> -> fold(atomExps(e), makeSet(), \acc, ae -> {
				h = ruEqHead(ae);
				if (h != s2id("wcel") && h != s2id("wss")) acc else {
					sides = ruEqArgs(ae);
					if (containsSet(known, termKey(sides.first)) || containsSet(known, termKey(sides.second)))
						insertSet(insertSet(acc, termKey(sides.first)), termKey(sides.second))
					else acc;
				};
			});
			goalKs = atomKeys(goal);
			terms0 = argTerms(goal);
			pickA = \ksAtoms : Set<string> -> filtermapi(premiseExps2, \i, e ->
				if (!isEmptySet(intersectSets(atomKeys(e), ksAtoms))) Some(i) else None());
			r1 = pickA(goalKs);
			ks2 = fold(r1, goalKs, \acc, i -> mergeSets(acc, atomKeys(premiseExps2[i])));
			// equality-reachable terms: one propagation round over ALL premises' equality atoms
			terms2 = fold(premiseExps2, terms0, \acc, e ->
				mergeSets(mergeSets(acc, eqSides(e, acc)), relSides(e, acc)));
			// a premise whose atom ARG TERMS meet the terms that arrived VIA AN EQUALITY is
			// transportable (the seed terms alone would readmit everything — t2's blow-up);
			// bridge-only admissions CAPPED smallest-first (uncapped, enum junk with equality
			// args re-inflated t86's certificate past its gate)
			bridged = differenceSets(terms2, terms0);
			atomPick = pickA(ks2);
			// SETNESS and REFLEXIVE relation facts are NOT transport links: `x ∈ _V` / `x ⊆ x`
			// carry no information across the bridge, and being the SHORTEST premises they win
			// the smallest-first cap below and crowd the real ∨/∧ premises out (class-loci t32:
			// the elpr disjunction lost its slot to four such facts). Setness reaches the
			// emitter through the pool instead.
			isJunkPremise = \e : RuExp ->
				ruUSetnessHyp(e, s2id("wcel"), s2id("cvv")) != None()
				|| (ruInArity(e) == 2 && { a = ruInArgs(e); a[0].nodes == a[1].nodes; });
			bridgeOnly = filtermapi(premiseExps2, \i, e ->
				if (!contains(atomPick, i) && !isJunkPremise(e) && !isEmptySet(intersectSets(argTerms(e), bridged))) Some(i) else None());
			// the bridge allowance shrinks as the atom-connected set grows — on rich sets
			// (t86's final step) additions are mostly junk that burns the emitter's budgets;
			// on sparse ones (t32/t19) the transport link is the missing piece
			// GOAL-TERM FIRST, then smallest: a bridge premise that mentions one of the GOAL's own
			// terms is the transport link we are looking for; one that mentions only the bridged
			// terms is background. Size alone let short background facts (enum memberships) take
			// the whole cap and leave the ∨-premise out (class-loci t32).
			bridgeRank = \i : int -> if (isEmptySet(intersectSets(argTerms(premiseExps2[i]), terms0))) 1 else 0;
			bridgeAdds = take(mergeSort(bridgeOnly, \a, b -> {
					r = bridgeRank(a) - bridgeRank(b);
					if (r != 0) r else length(premiseExps2[a].nodes) - length(premiseExps2[b].nodes);
				}),
				if (length(atomPick) > 8) 2 else 4);
			// SETNESS IS ALWAYS AVAILABLE (the class-loci campaign): a `T ∈ _V` premise shares no
			// atom with the goal, so the relevance closure drops it — but it is the INDUCTION BASE
			// of every setness proof, and without it the emitter's hyp-carrying membership biconds
			// (elsn/elpr/elpw) decline at a class metavar and the whole branch dies (t12: the
			// branch fact x5∈{x8} never unfolds to x5=x8). Mizar keeps the type layer of every
			// term regardless of the literal's connectivity — the same law.
			// It does NOT join the certificate's HYPS: an extra propositional atom per setness
			// fact pushes rich problems past the atom gate and eats the split budget (measured:
			// t19 flipped when they joined the subset). They travel as the certificate's setness
			// POOL instead — a side channel with no atom cost — with hyp leaves numbered AFTER
			// the subset positions, so the leaf remap below reaches their real premise indices.
			setnessIdxs = filtermapi(premiseExps2, \i, e ->
				if (ruUSetnessHyp(e, s2id("wcel"), s2id("cvv")) != None()) Some(i) else None());
			subset0 = mergeSort(concat(atomPick, bridgeAdds), \a, b -> a - b);
			// DEDUP by expression: the saturation re-derives the same fact (three copies of one
			// ∨-premise = three case-split candidates burning the split budget — t86)
			subset = (fold(subset0, Pair([], makeSet()), \acc : Pair<[int], Set<[RuExpNode]>>, i -> {
				nds = premiseExps2[i].nodes;
				if (containsSet(acc.second, nds)) acc else Pair(arrayPush(acc.first, i), insertSet(acc.second, nds));
			})).first;
			// The atom gate bounds which attempts run, NOT how long one takes (the emitter is
			// exponential and its split caps bound shape, not wall cost — an ungated chain of
			// near-gate certificates once turned a 7-min article run into 6.5h).
			tryHilb = \idxs : [int], atomGate : int -> {
				exps = map(idxs, \i -> premiseExps2[i]);
				// what RELEVANCE dropped: the premise was available and did not reach the check.
				// (t32's elpr disjunction lost its bridge slot to four junk facts this way.)
				if (ruDeclinesOn(env)) {
					iteri(premiseExps2, \i, e -> if (contains(idxs, i)) {} else
						ruDecline(env, "certificate/relevance", "premise not selected for the goal "
							+ ru2s(goal, math), ru2s(e, math)));
				} else {};
				// the setness side channel: premises not already in the subset, as pool leaves
				// numbered from length(exps) upward (the remap array is extended to match).
				poolIdxs = filter(setnessIdxs, \i -> !contains(idxs, i));
				pool = ruSetnessPoolOf(mapi(poolIdxs, \j, i -> Pair(premiseExps2[i], length(exps) + j)), stmtClass);
				natoms = sizeTree(fold(arrayPush(exps, goal), ruPAtomNodes(conn, goal), \acc, e -> mergeTree(acc, ruPAtomNodes(conn, e))));
				if (natoms > atomGate || ruTimeIsOver(fbTimer)) {
					if (ruDeclinesOn(env) && natoms > atomGate) {
						ruDecline(env, "certificate/atom-gate", "problem has " + i2s(natoms) + " atoms, gate is " + i2s(atomGate),
							ru2s(goal, math));
					} else {};
					None();
				}
				else maybeMap(ruHilbertPropProofTimedPool(em, conn, wff, stmtClass, exps, goal, ruTimeLeft(fbTimer),
						Some(ruInAtomCongsCached(math)), pool),
					\pr -> RuRefineResult(spliceAll(ruInRemapLeaves(pr.first, concat(idxs, poolIdxs))),
						mergeSets(hypDisjs2, pr.second.disjs)));
			};
			switch (tryHilb(subset, 24)) {
				Some(r): Some(r);
				// The relevance subset is UNSOUND for refutations: an inconsistent premise set
				// proves anything, and the contradiction can live among premises sharing no atom
				// with the goal. But deriving ⊥ needs premises sharing atoms WITH EACH OTHER
				// (a minimal inconsistent set is atom-connected — disjoint-atom parts satisfy
				// independently), so retry with subset ∪ C per atom-connected COMPONENT C of the
				// unpicked premises, smallest first, under a TIGHTER atom gate — small tries that
				// pass where the full set fails its gate. Then the ¬-gated full-set retry as
				// before (components can be bridged by a subset premise's out-of-closure atoms).
				None(): {
					rest = filter(enumFromTo(0, length(premiseExps2) - 1), \i -> !contains(subset, i));
					comps = fold(rest, [], \acc : [Pair<[int], Set<string>>], i -> {
						ks = atomKeys(premiseExps2[i]);
						linked = filter(acc, \c -> !isEmptySet(intersectSets(c.second, ks)));
						other  = filter(acc, \c -> isEmptySet(intersectSets(c.second, ks)));
						merged = fold(linked, Pair([i], ks), \m, c ->
							Pair(concat(m.first, c.first), mergeSets(m.second, c.second)));
						arrayPush(other, merged);
					});
					compTry = fold(take(mergeSort(comps, \a, b -> length(a.first) - length(b.first)), 2), None(),
						\found : Maybe<RuRefineResult>, c -> switch (found) {
							Some(__): found;
							None(): tryHilb(mergeSort(concat(subset, c.first), \a, b -> a - b), 14);
						});
					switch (compTry) {
						Some(r): Some(r);
						None(): if (length(subset) == length(premiseExps2) || ruEqHead(goal) != conn.wn) None()
							else tryHilb(enumFromTo(0, length(premiseExps2) - 1), 24);
					}
				}
			}
			}
			}
			}
	};
	ruFallbackStore(memo, goal, nnf, switch (res) {
		Some(r): RuResidualProved(r);
		None(): RuResidualFailed(exists(^fbRef, ruTimeIsOver), 1000.0);
	});
	res;
}

// Phase 1: strip the leading ∀-chain; validation re-quantifies the matrix proof with ax-gen. Declines
// (no strip) if there is a ∀ but ax-gen does not precede the theorem — the guide would be invalid.
ruStripForallRefiner(stmtClass : int, precedes : (int) -> bool, setTerms : Set<string>) -> RuRefiner {
	RuRefiner("strip-forall", \goal -> {
		sp = ruStripForall(goal);   // (matrix, [the quantified levels, innermost first])
		if (sp.second != [] && !precedes(s2id_("ax-gen")))
			Some(RuRefineStep([goal], \proofs -> proofs[0], makeSet()))   // ax-gen not available: pass through
		else Some(RuRefineStep([sp.first],
			\proofs -> fold(sp.second, proofs[0], \acc, lvl ->
				RuProofStep(s2id_("ax-gen"), [acc], RuStmt(stmtClass, [lvl], -1))),
			makeSet()));
	},
		// ALT: for a SETVAR equality whose pointwise (extensionality) route failed, offer the
		// un-reduced goal — the saturation in the residual can often decide `x = y` directly from
		// the instantiated literal set (zfmisc t15: ¬((x5=x5) ∧ ¬(x5=x8)) + x5=x5 ⊢ x5=x8).
		// Shape-gated, so the extra residual run is paid only where the literal route exists.
		\goal -> if (ruEqHead(goal) == s2id("wceq") && ruRelIsSetvarEqIn(goal, setTerms))
			Some(RuRefineStep([goal], \proofs -> proofs[0], makeSet()))
		else None());
}

// Phase 2: unfold + canonicalise the matrix to a residual; validation combines via mpbir (or is the
// identity when nothing rewrote), carrying the rewrite's DV provisos.
ruEqRewriteRefiner(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int, hyps : [RuExp], nnf : bool, precedes : (int) -> bool) -> RuRefiner {
	RuRefiner("eq-rewrite", \goal -> {
		rw = ruEqualizerRewrite(em, conn, wff, stmtClass, hyps, goal, nnf, precedes,
			ruSetnessPoolOf(mapi(hyps, \i, h -> Pair(h, i)), stmtClass));
		Some(RuRefineStep([rw.residual],
			\proofs -> switch (rw.proof) {
				None():        proofs[0];   // nothing rewrote: residual proof IS the goal proof
				Some(rwProof): RuProofStep(s2id_("mpbir"), [proofs[0], rwProof], RuStmt(stmtClass, [goal], -1));
			},
			rw.disjs));
	},
		// FALLBACK (gated). The preferred refinement rewrites the goal to its normal form; when a
		// PREMISE's own normal form already IS the goal, that rewrite moves the goal away from the
		// premise that would discharge it in one step (zfmisc t15: goal `x5 = x8`, premise `x5 ∈ {x8}`
		// whose elsn normal form is exactly `x5 = x8`, rewritten by eqss to `(x8⊆x5) ∧ (x5⊆x8)`).
		// Offer the UN-rewritten goal as an alternative, but only in that case: an unconditional
		// fallback re-runs the residual closer for every failed goal and is too expensive.
		// The hyp normal forms are fixed for this refiner's lifetime — computed ONCE, lazily
		// (recomputing them per failed goal was a measurable slice-starver).
		{
			hypFormsC : ref [[RuExp]] = ref [];
			\goal -> {
				svEq = ruEqHead(goal) == s2id("wceq") && ruRelIsSetvarEqIn(goal, ruRelSetTerms(hyps));
				hypForms = if (^hypFormsC != []) (^hypFormsC)[0] else {
					hf = map(hyps, \h -> (ruEqualizerRewrite(em, conn, wff, stmtClass, [], h, nnf, precedes,
						ruSetnessPoolOf(mapi(hyps, \i, h2 -> Pair(h2, i)), stmtClass))).residual);
					hypFormsC := [hf];
					hf;
				};
				if (svEq || exists(hypForms, \h -> h.nodes == goal.nodes))
					Some(RuRefineStep([goal], \proofs -> proofs[0], makeSet()))
				else None();
			}
		});
}

// Phase between strip-forall and eq-rewrite: if the goal is a `⊆` / set-`=` relation, REDUCE it via
// ssriv/eqriv to a fresh-setvar membership subgoal `(v∈A)→(v∈B)` / `(v∈A)↔(v∈B)`, which then flows to
// eq-rewrite (membership unfold) + the bounded BFS closer — no Kalmár, so proofs stay small. Non-
// Both sides of this `=` are setvars (each a class coercion of a setvar variable)?
// Is the goal an ATOM equality — one the literal set can decide directly, as opposed to a
// set-level equality that wants extensionality? Both sides must be a coerced setvar, or (the
// class-loci spelling of the same thing) a class metavar the theorem DECLARES AS A SET via its
// own `T ∈ _V` hypothesis. Without the class arm the alternative below never fires at class
// loci and the pointwise reduction is irreversible (t130: the `trivial` instance concludes the
// literal `x5 = x8`, which the extensionality form can no longer use).
ruRelIsSetvarEqIn(goal : RuExp, setTerms : Set<string>) -> bool {
	setvarT = tp2id_("setvar");
	clsT = tp2id_("class");
	sides = ruEqArgs(goal);
	isSv = \e : RuExp ->
		(length(e.nodes) == 2 && (switch (e.nodes[1]) { RuVar(__, tp): tp == setvarT; RuRuleNode(__, __): false; }))
		|| (length(e.nodes) == 1 && (switch (e.nodes[0]) { RuVar(__, tp): tp == clsT; RuRuleNode(__, __): false; })
			&& containsSet(setTerms, ruUKey(e)));
	isSv(sides.first) && isSv(sides.second);
}

// the terms a hyp list declares as sets (`T ∈ _V`), keyed structurally
ruRelSetTerms(hyps : [RuExp]) -> Set<string> {
	fold(hyps, makeSet(), \acc, h -> switch (ruUSetnessHyp(h, s2id("wcel"), s2id("cvv"))) {
		None(): acc;
		Some(t): insertSet(acc, ruUKey(t));
	});
}

// relation goals pass through unchanged. This unlocks the ⊆/= gaps the prop-only residual can't.
ruRelIntroRefiner(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int, hyps : [RuExp], precedes : (int) -> bool) -> RuRefiner {
	wssId = s2id("wss"); wceqId = s2id("wceq");
	passthru = \goal -> Some(RuRefineStep([goal], \proofs -> proofs[0], makeSet()));
	RuRefiner("rel-intro", \goal -> {
		head = ruEqHead(goal);
		// If the goal IS a hypothesis, don't reduce it — the closer discharges it directly. Reducing a hyp
		// `A⊆B` to `(v∈A→v∈B)` would lose the hyp (and the residual is generally unprovable). E.g. t78_xboole_1,
		// whose `?` step goal `(X∩Y)=∅` is exactly its hypothesis.
		if (exists(hyps, \h -> h.nodes == goal.nodes)) passthru(goal)
		else if (head != wssId && head != wceqId) passthru(goal)
		else {
			// Reduce `A⊆B` / `A=B` to the fresh-setvar membership subgoal `(v∈A)→(v∈B)` / `(v∈A)↔(v∈B)`,
			// wrapped by ssriv/eqriv. The subgoal flows to eq-rewrite (membership unfold) + the BFS closer —
			// no Kalmár, so the proof stays small. Declines (passthru) if the wrapper lemma does not precede
			// the theorem — the guide would be invalid (e.g. reproving ssriv/eqriv itself, or a lemma before them).
			r = ruEqualizerRelSubgoal(em, conn, wff, stmtClass, hyps, goal, head == wssId);
			if (!precedes(r.lemma)) passthru(goal)
			else Some(RuRefineStep([r.subgoal],
				\proofs -> RuProofStep(r.lemma, [proofs[0]], RuStmt(stmtClass, [goal], -1)),
				r.disjs));
		};
	},
		// ALT: a SETVAR equality whose pointwise (extensionality) route failed goes to the residual
		// UN-reduced — the saturation there derives the element equalities (x9∈{x5} → x9=x5) and the
		// congruence closure chains them to the goal (the t5-class: {x5}={x9,x10} ⊢ x9=x10). The
		// pointwise reduction is BACKWARDS for this class: it needs the equality it is trying to
		// prove. Same shape gate as eq-rewrite's alt, so the extra residual run stays rare.
		\goal -> if (ruEqHead(goal) == s2id("wceq") && ruRelIsSetvarEqIn(goal, ruRelSetTerms(hyps)))
			Some(RuRefineStep([goal], \proofs -> proofs[0], makeSet()))
		else None());
}

// Split a CONJUNCTION goal `(B ∧ C ∧ …)` into its conjuncts, prove each separately, and recombine with
// pm3.2i (ph, ps |- (ph∧ps)). Many Mizar conclusions are bare conjunctions whose conjuncts are each a hyp,
// a prior theorem, or a relation the other refiners + the BFS closer can discharge (e.g. t3_xboole_1's
// `(x5⊆∅) ∧ (∅⊆x5)`); without this the whole conjunction hits the prop closer unreduced and fails.
// Passes through (a) a goal that IS a hypothesis (the closer discharges it directly — don't split a hyp),
// (b) non-conjunction goals, (c) when pm3.2i does not precede. Right-assoc chains flatten to leaf conjuncts.
ruConjSplitRefiner(conn : RuPConnectives, stmtClass : int, hyps : [RuExp], precedes : (int) -> bool) -> RuRefiner {
	pm32i = s2id_("pm3.2i");
	passthru = \goal -> Some(RuRefineStep([goal], \proofs -> proofs[0], makeSet()));
	RuRefiner("conj-split", \goal -> {
		if (exists(hyps, \h -> h.nodes == goal.nodes) || ruEqHead(goal) != conn.wa || !precedes(pm32i)) passthru(goal)
		else Some(RuRefineStep(
			ruConjLeaves(conn, goal),
			\proofs -> ruRebuildConj(pm32i, stmtClass, conn, goal, proofs).first,
			makeSet()
		));
	},
		\__ -> None());
}

// Leaf conjuncts of a right-associated `wa`-chain, in order: `A ∧ (B ∧ C)` -> [A, B, C].
ruConjLeaves(conn : RuPConnectives, goal : RuExp) -> [RuExp] {
	if (ruEqHead(goal) != conn.wa) [goal]
	else { ar = ruEqArgs(goal); concat([ar.first], ruConjLeaves(conn, ar.second)); }
}

// Rebuild the conjunction proof from leaf proofs (consumed left-to-right), mirroring the goal's
// right-assoc `wa` structure with pm3.2i. Returns (proof of `goal`, unconsumed leaf proofs).
ruRebuildConj(pm32i : int, stmtClass : int, conn : RuPConnectives, goal : RuExp, proofs : [RuProofTree]) -> Pair<RuProofTree, [RuProofTree]> {
	if (ruEqHead(goal) != conn.wa) Pair(proofs[0], tail(proofs))
	else {
		ar = ruEqArgs(goal);
		rr = ruRebuildConj(pm32i, stmtClass, conn, ar.second, tail(proofs));
		Pair(RuProofStep(pm32i, [proofs[0], rr.first], RuStmt(stmtClass, [goal], -1)), rr.second);
	}
}

// Resolve a refiner NAME (a `refine(...)` argument) to its RuRefiner. `nnf` toggles De Morgan in the
// eq-rewrite canon pass (the checker tries nnf=false then nnf=true).
ruRefinerByName(name : string, em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int, hyps : [RuExp], nnf : bool, precedes : (int) -> bool) -> Maybe<RuRefiner> {
	if (name == "strip-forall") Some(ruStripForallRefiner(stmtClass, precedes, ruRelSetTerms(hyps)))
	else if (name == "conj-split") Some(ruConjSplitRefiner(conn, stmtClass, hyps, precedes))
	else if (name == "rel-intro") Some(ruRelIntroRefiner(em, conn, wff, stmtClass, hyps, precedes))
	else if (name == "eq-rewrite") Some(ruEqRewriteRefiner(em, conn, wff, stmtClass, hyps, nnf, precedes))
	else None();
}

ruRefinerNames() -> [string] { ["strip-forall", "conj-split", "rel-intro", "eq-rewrite"] }
