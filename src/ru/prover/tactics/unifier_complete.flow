import ru/prover/tactics/unifier_plan;
import ru/prover/tactics/instantiate;   // RuInAtomCong — the leaf transport table
import ru/prover/core/forward;

// THE COMPLETER (three-layer architecture, phase 2 v1) — turns the planner's
// recorded reasons into Russell proofs by a FINITE CATALOG of fixed patterns.
// NO SEARCH anywhere: every step is dictated by the RuUnfCase records.
//
// V1 CATALOG (the single-case fragment): plans with EXACTLY ONE disjunct —
// no ∨-branching in DNF(¬matrix ∧ hyps), hence no or-elimination and no
// deduction ambients; pure inference-form fragments. Covered reasons:
//   - RuUnfByContradiction, SYNTACTIC complement between a case literal and
//     a basis fact:
//       goal-side literal (¬l in the case, fact l in the basis) — descend
//       the matrix to that literal with orci/olci (∨), a1i/pm2.21 (→),
//       leaf reuse (¬, atoms);
//       fact-side pair (facts contradict) — ex falso: pm2.21 + double ax-mp.
// Everything else DECLINES (None) — the caller falls back to the searching
// glue during the migration; a decline is a census entry, never an error.

export {
	// Inference-form proof of `matrix` from the basis facts, or None when the
	// plan is outside the v1 catalog. basis = (fact expression, hyp leaf index).
	ruUnfCompleteProof(stmtClass : int, wffT : int, plan : RuUnfPlan,
		basis : [Pair<RuExp, int>], matrix : RuExp) -> Maybe<RuProofTree>;

	// V2, the MULTI-CASE fold: deduction-form tableau under the Clavius ambient
	// (assume ¬matrix, every leaf closes by a syntactic complementary pair or a
	// ¬(t=t) literal via eqid, ∨-splits re-join by mpjaodan, pm2.18 discharges).
	// `insts` = proved σP premise instances (unifier_gen's uinsts) — offered as
	// extra facts, so RuUnfByPremise cases whose σP falsity is SYNTACTIC after
	// decomposition close with no new machinery.
	ruUnfCompleteTableau(math : RuMath, env : RuEnv, stmtClass : int, wffT : int,
		plan : RuUnfPlan, basis : [Pair<RuExp, int>],
		insts : [Pair<RuExp, RuProofTree>], matrix : RuExp) -> Maybe<RuProofTree>;

	// The ∃-ANTECEDENT CHAIN entry: proves the Skolem-discharge obligation
	// (b1 → (b2 → … → matrix)) — the stripped ∃-bodies as antecedents — by the
	// same tableau under the ambient ((b1∧…∧bk) ∧ ¬matrix) (its ∧-decomposition
	// distributes the bodies into facts), then ex-exportation + one Clavius syl
	// rebuild the exact chain the caller's exlimiv discharge consumes.
	ruUnfCompleteChain(math : RuMath, env : RuEnv, stmtClass : int, wffT : int,
		plan : RuUnfPlan, plain : [Pair<RuExp, int>],
		insts : [Pair<RuExp, RuProofTree>], bodies : [RuExp],
		matrix : RuExp) -> Maybe<RuProofTree>;

	// perf accumulators (sequential runs only): total ms spent in the leaf
	// transport and how many times it ran — the flip's speed prerequisite is
	// measured against these ([[unifier-planner]]).
	ruUnfTransTime : ref double;
	ruUnfTransCalls : ref int;
	ruUnfBuildTime : ref double;
}

ruUnfTransTime : ref double = ref 0.0;
ruUnfTransCalls : ref int = ref 0;
ruUnfBuildTime : ref double = ref 0.0;

ruUnfCompleteProof(stmtClass : int, wffT : int, plan : RuUnfPlan,
	basis : [Pair<RuExp, int>], matrix : RuExp) -> Maybe<RuProofTree> {
	if (!plan.provable || plan.disjuncts != 1 || length(plan.cases) != 1) None()
	else switch (plan.cases[0].refutation) {
		RuUnfByContradiction(lit): {
			// `lit` is the NEGATIVE case literal whose atom also occurs positively
			// in the case. Two sub-patterns by where the complement pair lives.
			leaf = \e : RuExp -> maybeMap(
				find(basis, \b -> b.first.nodes == e.nodes),
				\b -> RuProofHyp(b.second, RuStmt(stmtClass, [b.first], -1)));
			neg = \e : RuExp -> ruFwdMkRule(s2id("wn"), wffT, [e]);
			posFact = leaf(lit);
			negFact = leaf(neg(lit));
			switch (posFact) {
				None(): None();
				Some(pf): switch (negFact) {
					Some(nf): {
						// FACT-SIDE contradiction: basis holds l and ¬l — ex falso.
						// pm2.21: (¬φ → (φ → ψ)); two ax-mp give ψ = matrix.
						imp1 = ruFwdMkRule(s2id("wi"), wffT, [lit, matrix]);
						pm = RuProofStep(s2id("pm2.21"), [],
							RuStmt(stmtClass, [ruFwdMkRule(s2id("wi"), wffT, [neg(lit), imp1])], -1));
						mp1 = RuProofStep(s2id("ax-mp"), [nf, pm], RuStmt(stmtClass, [imp1], -1));
						Some(RuProofStep(s2id("ax-mp"), [pf, mp1], RuStmt(stmtClass, [matrix], -1)));
					}
					None():
						// GOAL-SIDE: the case's ¬(lit) comes from DNF(¬matrix);
						// the basis proves lit — descend the matrix to it.
						ruUnfDescend(stmtClass, wffT, matrix, lit, pf, \e -> leaf(e));
				}
			}
		}
		default: None();
	}
}

// ---- V2: the MULTI-CASE deduction-form fold ----------------------------------
// A tableau over ¬matrix ∧ facts under the Clavius ambient (assume ¬matrix,
// conclude matrix at every leaf clash, close by pm2.18). Every move is a FIXED
// lemma dictated by the connective + polarity; ∨-shapes split and re-join with
// mpjaodan. The plan is the PROVABILITY GUARANTEE; leaves re-find their
// complementary pair by a syntactic scan over the branch facts, so the fold
// never depends on the decision's DNF indexing. Deterministic; the only cap is
// structural (ops, the LatOvfl analogue). ↔-shapes and non-syntactic clashes
// decline in v2.

ruUnfCompleteTableau(math : RuMath, env : RuEnv, stmtClass : int, wffT : int,
	plan : RuUnfPlan, basis : [Pair<RuExp, int>],
	insts : [Pair<RuExp, RuProofTree>], matrix : RuExp) -> Maybe<RuProofTree> {
	covered = forall(plan.cases, \c -> switch (c.refutation) {
		RuUnfByContradiction(__): true;
		RuUnfByPremise(__, __): true;
		RuUnfByReflexivity(__, __): true;
		default: false;
	});
	if (!plan.provable || !covered) None()
	else {
		bt = ruMakeTimer();
		wn = \e : RuExp -> ruFwdMkRule(s2id("wn"), wffT, [e]);
		wi = \a : RuExp, b : RuExp -> ruFwdMkRule(s2id("wi"), wffT, [a, b]);
		stmt = \e : RuExp -> RuStmt(stmtClass, [e], -1);
		amb0 = wn(matrix);
		ops = ref 0;
		pending0 = concatA([
			[RuUnfTabF(amb0, 0, RuProofStep(s2id("id"), [], stmt(wi(amb0, amb0))))],
			map(basis, \b -> RuUnfTabF(b.first, 0,
				RuProofStep(s2id("a1i"),
					[RuProofHyp(b.second, stmt(b.first))],
					stmt(wi(amb0, b.first))))),
			map(insts, \p -> RuUnfTabF(p.first, 0,
				RuProofStep(s2id("a1i"), [p.second], stmt(wi(amb0, p.first)))))]);
		r = switch (ruUnfTab(math, env, ruInAtomCongsCached(math), stmtClass, wffT, matrix, [amb0], [], pending0, ops)) {
			None(): None();
			Some(t): {
				// Clavius: (¬M → M) ⊢ M
				pm = RuProofStep(s2id("pm2.18"), [],
					stmt(wi(wi(amb0, matrix), matrix)));
				Some(RuProofStep(s2id("ax-mp"), [t, pm], stmt(matrix)));
			}
		}
		ruUnfBuildTime := ^ruUnfBuildTime + ruTimePassed(bt);
		r;
	}
}

// Prove (amb → matrix) from facts: `done` are literals (each proof concludes
// amb → lit), `pending` still decompose. Linear except at ∨-splits.
// A tableau fact: `tree` proves (ambs[depth] -> exp). Facts are lifted to
// deeper ambients LAZILY (adantr chains materialize at USE, not at split) —
// wholesale lifting inflated proofs as facts x splits and the verify time
// with them (measured: the whole flip cost lived there).
RuUnfTabF(exp : RuExp, depth : int, tree : RuProofTree);

ruUnfTab(math : RuMath, env : RuEnv, congs : Tree<int, [RuInAtomCong]>,
	stmtClass : int, wffT : int, matrix : RuExp, ambs : [RuExp],
	done : [RuUnfTabF], pending : [RuUnfTabF],
	ops : ref int) -> Maybe<RuProofTree> {
	ops := ^ops + 1;
	if (^ops > 65536) None()
	else {
	wn = \e : RuExp -> ruFwdMkRule(s2id("wn"), wffT, [e]);
	wi = \a : RuExp, b : RuExp -> ruFwdMkRule(s2id("wi"), wffT, [a, b]);
	wa = \a : RuExp, b : RuExp -> ruFwdMkRule(s2id("wa"), wffT, [a, b]);
	wo = \a : RuExp, b : RuExp -> ruFwdMkRule(s2id("wo"), wffT, [a, b]);
	stmt = \e : RuExp -> RuStmt(stmtClass, [e], -1);
	cur = length(ambs) - 1;
	amb = ambs[cur];
	imp = \f : RuExp -> wi(amb, f);
	// materialize a fact at the CURRENT ambient: adantr per level it missed
	matz = \f : RuUnfTabF -> fold(enumFromTo(f.depth + 1, cur), f.tree, \t, i ->
		RuProofStep(s2id("adantr"), [t], stmt(wi(ambs[i], f.exp))));
	// a 0-hyp lemma instance used through syl AT THE SOURCE DEPTH d:
	// (ambs[d]->f) + (f->g) |- (ambs[d]->g)
	via = \pf : RuProofTree, d : int, lemma : string, f : RuExp, g : RuExp ->
		RuProofStep(s2id("syl"), [pf,
			RuProofStep(s2id(lemma), [], stmt(wi(f, g)))], stmt(wi(ambs[d], g)));
	viaBi = \pf : RuProofTree, d : int, lemma : string, f : RuExp, g : RuExp ->
		RuProofStep(s2id("syl"), [pf,
			RuProofStep(s2id("biimpi"),
				[RuProofStep(s2id(lemma), [],
					RuStmt(stmtClass, [ruFwdMkRule(s2id("wb"), wffT, [f, g])], -1))],
				stmt(wi(f, g)))], stmt(wi(ambs[d], g)));
	if (pending == []) {
		// LEAF: complementary pair / ¬(t=t) over `done` (materialize ONLY the
		// two facts the clash uses); if the plain scan fails, saturate with
		// equality-transported variants (materialized — transport is rare)
		closeWith = \ppTree : RuProofTree, nfTree : RuProofTree, p : RuExp -> {
			dd = RuProofStep(s2id("pm2.21d"), [nfTree], stmt(imp(wi(p, matrix))));
			RuProofStep(s2id("mpd"), [ppTree, dd], stmt(imp(matrix)));
		};
		scanF = fold(done, None(), \acc : Maybe<RuProofTree>, nf ->
			if (isSome(acc)) acc
			else if (!(ruInHead(nf.exp) == s2id("wn") && ruInArity(nf.exp) == 1)) acc
			else {
				p = (ruInArgs(nf.exp))[0];
				switch (find(done, \pp -> pp.exp.nodes == p.nodes)) {
					Some(pp): Some(closeWith(matz(pp), matz(nf), p));
					None():
						if (ruInHead(p) == s2id("wceq") && ruInArity(p) == 2
							&& (ruInArgs(p))[0].nodes == (ruInArgs(p))[1].nodes)
							Some(closeWith(
								RuProofStep(s2id("a1i"),
									[RuProofStep(s2id("eqid"), [], stmt(p))], stmt(imp(p))),
								matz(nf), p))
						else acc;
				}
			});
		switch (scanF) {
			Some(c): Some(c);
			None(): {
				tmr = ruMakeTimer();
				doneM = map(done, \f -> Pair(f.exp, matz(f)));
				trans = ruUnfLeafTransport(math, env, congs, stmtClass, wffT, amb, doneM);
				ruUnfTransTime := ^ruUnfTransTime + ruTimePassed(tmr);
				ruUnfTransCalls := ^ruUnfTransCalls + 1;
				r = fold(trans, None(), \acc : Maybe<RuProofTree>, nf ->
					if (isSome(acc)) acc
					else if (!(ruInHead(nf.first) == s2id("wn") && ruInArity(nf.first) == 1)) acc
					else {
						p = (ruInArgs(nf.first))[0];
						switch (find(trans, \pp -> pp.first.nodes == p.nodes)) {
							Some(pp): Some(closeWith(pp.second, nf.second, p));
							None(): acc;
						}
					});
				if (isNone(r) && ruVerbose(env.conf) >= 6) {
					env.out.println("      tabLeaf FAIL (" + i2s(length(done)) + " lits): "
						+ strGlue(map(done, \d -> ru2s(d.exp, math)), " | "));
				} else {};
				r;
			}
		}
	} else {
		f0 = pending[0];
		f = f0.exp;
		pf = f0.tree;
		fd = f0.depth;
		rest = tail(pending);
		h = ruInHead(f);
		ar = ruInArity(f);
		rec = \d2 : [RuUnfTabF], p2 : [RuUnfTabF] ->
			ruUnfTab(math, env, congs, stmtClass, wffT, matrix, ambs, d2, p2, ops);
		push = \items : [RuUnfTabF] -> rec(done, concat(items, rest));
		mk = \e : RuExp, t : RuProofTree -> RuUnfTabF(e, fd, t);
		split = \a : RuExp, b : RuExp -> {
			branch = \x : RuExp -> {
				ambx = wa(amb, x);
				xFact = RuUnfTabF(x, cur + 1, RuProofStep(s2id("simpr"), [],
					RuStmt(stmtClass, [ruFwdMkRule(s2id("wi"), wffT, [ambx, x])], -1)));
				ruUnfTab(math, env, congs, stmtClass, wffT, matrix,
					arrayPush(ambs, ambx), done, arrayPush(rest, xFact), ops);
			}
			switch (branch(a)) {
				None(): None();
				Some(pa): switch (branch(b)) {
					None(): None();
					Some(pb): Some(RuProofStep(s2id("mpjaodan"), [pa, pb, matz(f0)],
						stmt(imp(matrix))));
				}
			}
		}
		if (h == s2id("wa") && ar == 2) {
			args = ruInArgs(f);
			di = \e : RuExp -> wi(ambs[fd], e);
			push([
				mk(args[0], RuProofStep(s2id("simpld"), [pf], stmt(di(args[0])))),
				mk(args[1], RuProofStep(s2id("simprd"), [pf], stmt(di(args[1]))))]);
		} else if (h == s2id("wo") && ar == 2) {
			args = ruInArgs(f);
			split(args[0], args[1]);
		} else if (h == s2id("wi") && ar == 2) {
			args = ruInArgs(f);
			// (a→b) ⇒ (¬a∨b) by imor
			push([mk(wo(wn(args[0]), args[1]),
				viaBi(pf, fd, "imor", f, wo(wn(args[0]), args[1])))]);
		} else if (h == s2id("wn") && ar == 1) {
			g = (ruInArgs(f))[0];
			gh = ruInHead(g);
			gar = ruInArity(g);
			if (gh == s2id("wn") && gar == 1) {
				a = (ruInArgs(g))[0];
				push([mk(a, via(pf, fd, "notnotr", f, a))]);
			} else if (gh == s2id("wo") && gar == 2) {
				gargs = ruInArgs(g);
				push([
					mk(wn(gargs[0]), via(pf, fd, "pm2.45", f, wn(gargs[0]))),
					mk(wn(gargs[1]), via(pf, fd, "pm2.46", f, wn(gargs[1])))]);
			} else if (gh == s2id("wa") && gar == 2) {
				gargs = ruInArgs(g);
				// ¬(a∧b) ⇒ (¬a∨¬b) by pm3.13
				push([mk(wo(wn(gargs[0]), wn(gargs[1])),
					via(pf, fd, "pm3.13", f, wo(wn(gargs[0]), wn(gargs[1]))))]);
			} else if (gh == s2id("wi") && gar == 2) {
				gargs = ruInArgs(g);
				// ¬(a→b) ⇒ (a∧¬b) by pm4.61
				push([mk(wa(gargs[0], wn(gargs[1])),
					viaBi(pf, fd, "pm4.61", f, wa(gargs[0], wn(gargs[1]))))]);
			} else if (gh == s2id("wb") && gar == 2) {
				gargs = ruInArgs(g);
				// ¬(a↔b) ⇒ (¬a↔b) by nbbn taken BACKWARD (biimpri)
				tgt = ruFwdMkRule(s2id("wb"), wffT, [wn(gargs[0]), gargs[1]]);
				nb = RuProofStep(s2id("nbbn"), [],
					RuStmt(stmtClass, [ruFwdMkRule(s2id("wb"), wffT, [tgt, f])], -1));
				bi = RuProofStep(s2id("biimpri"), [nb], stmt(wi(f, tgt)));
				push([mk(tgt, RuProofStep(s2id("syl"), [pf, bi], stmt(wi(ambs[fd], tgt))))]);
			}
			else rec(arrayPush(done, f0), rest);       // literal
		} else if (h == s2id("wb") && ar == 2) {
			args = ruInArgs(f);
			// (a↔b) ⇒ ((a∧b)∨(¬a∧¬b)) by dfbi3
			rhs = wo(wa(args[0], args[1]), wa(wn(args[0]), wn(args[1])));
			push([mk(rhs, viaBi(pf, fd, "dfbi3", f, rhs))]);
		}
		else rec(arrayPush(done, f0), rest);           // literal (atoms, ∀/∃)
	}
	}
}

// Prove `form` (positively) given a proof `pf` of the literal `target` that
// DNF(¬form) put into the single case, plus leaf lookup for side branches.
// Mirrors ruUnfDnfX's single-clause connective cases; every step is forced.
ruUnfDescend(stmtClass : int, wffT : int, form : RuExp, target : RuExp,
	pf : RuProofTree, leaf : (RuExp) -> Maybe<RuProofTree>) -> Maybe<RuProofTree> {
	h = ruInHead(form);
	ar = ruInArity(form);
	stmt = \e : RuExp -> RuStmt(stmtClass, [e], -1);
	if (form.nodes == target.nodes) Some(pf)
	else if (h == s2id("wn") && ar == 1) {
		// goal ¬X: single case ⇒ X is the (positive) case literal; a basis fact
		// ¬X proves it verbatim
		leaf(form);
	} else if (h == s2id("wo") && ar == 2) {
		args = ruInArgs(form);
		// ∨ under ¬ is a PRODUCT — both sides landed in the one case; the
		// refuted literal sits in exactly one. orci/olci re-introduce.
		switch (ruUnfDescend(stmtClass, wffT, args[0], target, pf, leaf)) {
			Some(pl): Some(RuProofStep(s2id("orci"), [pl], stmt(form)));
			None(): maybeMap(ruUnfDescend(stmtClass, wffT, args[1], target, pf, leaf),
				\pr -> RuProofStep(s2id("olci"), [pr], stmt(form)));
		}
	} else if (h == s2id("wi") && ar == 2) {
		args = ruInArgs(form);
		// A→B: the case holds A and ¬B. Refuted A ⇒ fact ¬A ⇒ pm2.21 + ax-mp;
		// refuted ¬B ⇒ proof of B ⇒ a1i.
		neg = \e : RuExp -> ruFwdMkRule(s2id("wn"), wffT, [e]);
		if ((args[0]).nodes == target.nodes) {
			maybeMap(leaf(neg(args[0])), \na -> {
				pm = RuProofStep(s2id("pm2.21"), [],
					stmt(ruFwdMkRule(s2id("wi"), wffT, [neg(args[0]), form])));
				RuProofStep(s2id("ax-mp"), [na, pm], stmt(form));
			});
		} else maybeMap(ruUnfDescend(stmtClass, wffT, args[1], target, pf, leaf),
			\pb -> RuProofStep(s2id("a1i"), [pb], stmt(form)));
	} else None();
}

// The LEAF TRANSPORT closure — Mizar's Equate for the completer: transported
// variants of the literal facts across the leaf's equality literals (both
// orientations, eqcomd), via the scanned atom congruences. Two rounds, product
// cap 32 — structural bounds, no search: every product is forced by matching.
ruUnfLeafTransport(math : RuMath, env : RuEnv, congs : Tree<int, [RuInAtomCong]>,
	stmtClass : int, wffT : int, amb : RuExp,
	done : [Pair<RuExp, RuProofTree>]) -> [Pair<RuExp, RuProofTree>] {
	wceqId = s2id("wceq");
	wnId = s2id("wn");
	stmt = \e : RuExp -> RuStmt(stmtClass, [e], -1);
	imp = \f : RuExp -> ruFwdMkRule(s2id("wi"), wffT, [amb, f]);
	round = \fs : [Pair<RuExp, RuProofTree>] -> {
		has = \e : RuExp -> exists(fs, \g -> g.first.nodes == e.nodes);
		// equality facts, both orientations
		eqs0 = filtermap(fs, \g ->
			if (ruInHead(g.first) == wceqId && ruInArity(g.first) == 2
				&& (ruInArgs(g.first))[0].nodes != (ruInArgs(g.first))[1].nodes)
				Some(g) else None());
		eqs = fold(eqs0, eqs0, \acc, e -> {
			sides = ruInArgs(e.first);
			fl = ruFwdMkRule(wceqId, wffT, [sides[1], sides[0]]);
			if (exists(acc, \g -> g.first.nodes == fl.nodes)) acc
			else arrayPush(acc, Pair(fl,
				RuProofStep(s2id("eqcomd"), [e.second], stmt(imp(fl)))));
		});
		// literal facts as (atom, proof, negated)
		atoms = filtermap(fs, \g ->
			if (ruInHead(g.first) == wnId && ruInArity(g.first) == 1)
				Some(Triple((ruInArgs(g.first))[0], g.second, true))
			else Some(Triple(g.first, g.second, false)));
		// DEEP-TERM derived equalities: an eq (l=r) with l strictly inside a
		// direct argument t of some literal atom lifts to (t=t') through the
		// term-congruence chain — the derived eq drives the atom transport below
		// AND satisfies non-identity ¬(t=t') reflexivity leaves directly
		teqs = ruInTermCongsCached(math);
		deepEqs = fold(eqs, [], \dacc : [Pair<RuExp, RuProofTree>], eq ->
			if (length(dacc) >= 16) dacc else {
				sides = ruInArgs(eq.first);
				fold(atoms, dacc, \da, fa -> if (length(da) >= 16 || ruInArity(fa.first) == 0) da else
					fold(ruInArgs(fa.first), da, \d2, t ->
						if (length(d2) >= 16 || t.nodes == sides[0].nodes
							|| !ruUnfHasSub(t, sides[0])) d2
						else switch (ruUnfDeepEq(math, env, teqs, stmtClass, wffT, sides[0], sides[1], t)) {
							None(): d2;
							Some(ch): {
								de = ruFwdMkRule(wceqId, wffT, [t, ch.first]);
								if (has(de) || exists(d2, \g -> g.first.nodes == de.nodes)) d2
								else arrayPush(d2, Pair(de,
									RuProofStep(s2id("syl"), [eq.second, ch.second], stmt(imp(de)))));
							}
						}));
			});
		eqs2 = concat(eqs, deepEqs);
		base = concat(fs, deepEqs);
		fold(atoms, base, \acc, fa -> if (length(acc) - length(base) >= 32) acc else
			fold(eqs2, acc, \ac, eq -> if (length(ac) - length(base) >= 32) ac else {
				sides = ruInArgs(eq.first);
				fold(lookupTreeDef(congs, ruInHead(fa.first), []), ac, \a, r ->
					switch (ruMatchExp(fa.first, r.lhs, math, env)) {
						None(): a;
						Some(sub0): {
							va = lookupHashMap(sub0.map, r.va.id);
							vaIsX = switch (va) {
								Some(se): se.exp.nodes == sides[0].nodes;
								None(): false;
							};
							if (!vaIsX) a else {
								m = copyHashMap(sub0.map);
								setHashMap(m, r.vb.id, RuSubExpr(r.vb, sides[1], ruExpVarIdsHashSet(sides[1])));
								sub = RuSubst(m);
								f2exp = ruApplySubst(r.rhs, sub);
								f2refl = ruInHead(f2exp) == wceqId && ruInArity(f2exp) == 2
									&& (ruInArgs(f2exp))[0].nodes == (ruInArgs(f2exp))[1].nodes;
								f2lit = if (fa.third) ruFwdMkRule(wnId, wffT, [f2exp]) else f2exp;
								if (f2refl || f2exp.nodes == fa.first.nodes
									|| exists(a, \g -> g.first.nodes == f2lit.nodes)) a
								else {
									inst = ruApplySubst(r.prop, sub);   // (X=Y) → (F ↔ F')
									biExp = (ruInArgs(inst))[1];
									pInst = RuProofStep(r.lemmaId, [], stmt(inst));
									pBi = RuProofStep(s2id("syl"), [eq.second, pInst], stmt(imp(biExp)));
									tree = if (fa.third)
										RuProofStep(s2id("mtbid"), [fa.second, pBi], stmt(imp(f2lit)))
									else
										RuProofStep(s2id("mpbid"), [fa.second, pBi], stmt(imp(f2lit)));
									arrayPush(a, Pair(f2lit, tree));
								}
							}
						}
					});
			}));
	};
	round(round(done));
}

// Does `small` occur as a (contiguous, prefix-form) subterm slice of `big`?
ruUnfHasSub(big : RuExp, small : RuExp) -> bool {
	m = length(small.nodes);
	n = length(big.nodes);
	m <= n && exists(enumFromTo(0, n - m), \i ->
		subrange(big.nodes, i, m) == small.nodes);
}

// ⊢ ((l=r) → (term = term')) for l occurring inside `term`: recurse to the
// LEFTMOST argument containing l, base = the occurrence itself (id), each
// level up applies the op's implication-form term congruence and syl-composes
// (the arbitrary-lhs generalization of ruInTermEqChain).
ruUnfDeepEq(math : RuMath, env : RuEnv, teqs : Tree<int, [RuInAtomCong]>,
	stmtClass : int, wffT : int, l : RuExp, r : RuExp,
	term : RuExp) -> Maybe<Pair<RuExp, RuProofTree>> {
	mkImp = \a : RuExp, b : RuExp -> ruFwdMkRule(s2id("wi"), wffT, [a, b]);
	mkEq  = \a : RuExp, b : RuExp -> ruFwdMkRule(s2id("wceq"), wffT, [a, b]);
	eqLR = mkEq(l, r);
	if (term.nodes == l.nodes)
		Some(Pair(r, RuProofStep(s2id("id"), [], RuStmt(stmtClass, [mkImp(eqLR, eqLR)], -1))))
	else {
		args = ruInArgs(term);
		if (args == []) None()
		else {
			occ = filter(enumFromTo(0, length(args) - 1), \i -> ruUnfHasSub(args[i], l));
			if (occ == []) None()
			else {
				j = occ[0];
				switch (ruUnfDeepEq(math, env, teqs, stmtClass, wffT, l, r, args[j])) {
					None(): None();
					Some(subC): fold(lookupTreeDef(teqs, ruInHead(term), []), None(),
						\found : Maybe<Pair<RuExp, RuProofTree>>, rr -> switch (found) {
						Some(__): found;
						None(): switch (ruMatchExp(term, rr.lhs, math, env)) {
							None(): None();
							Some(sub0): if (!(switch (lookupHashMap(sub0.map, rr.va.id)) {
								None(): false;
								Some(se): se.exp.nodes == args[j].nodes;
							})) None() else {
								m = copyHashMap(sub0.map);
								setHashMap(m, rr.vb.id, RuSubExpr(rr.vb, subC.first, ruExpVarIdsHashSet(subC.first)));
								sub = RuSubst(m);
								term2 = ruApplySubst(rr.rhs, sub);
								inst = ruApplySubst(rr.prop, sub);   // (aj=aj') → (term=term2)
								Some(Pair(term2, RuProofStep(s2id("syl"),
									[subC.second, RuProofStep(rr.lemmaId, [], RuStmt(stmtClass, [inst], -1))],
									RuStmt(stmtClass, [mkImp(eqLR, mkEq(term, term2))], -1))));
							}
						}
					});
				}
			}
		}
	}
}

ruUnfCompleteChain(math : RuMath, env : RuEnv, stmtClass : int, wffT : int,
	plan : RuUnfPlan, plain : [Pair<RuExp, int>],
	insts : [Pair<RuExp, RuProofTree>], bodies : [RuExp],
	matrix : RuExp) -> Maybe<RuProofTree> {
	covered = forall(plan.cases, \c -> switch (c.refutation) {
		RuUnfByContradiction(__): true;
		RuUnfByPremise(__, __): true;
		RuUnfByReflexivity(__, __): true;
		default: false;
	});
	if (!plan.provable || !covered || bodies == []) None()
	else {
		wn = \e : RuExp -> ruFwdMkRule(s2id("wn"), wffT, [e]);
		wi = \a : RuExp, b : RuExp -> ruFwdMkRule(s2id("wi"), wffT, [a, b]);
		wa = \a : RuExp, b : RuExp -> ruFwdMkRule(s2id("wa"), wffT, [a, b]);
		stmt = \e : RuExp -> RuStmt(stmtClass, [e], -1);
		nM = wn(matrix);
		wb = fold(tail(bodies), bodies[0], wa);
		amb = wa(wb, nM);
		ops = ref 0;
		pending0 = concatA([
			[RuUnfTabF(amb, 0, RuProofStep(s2id("id"), [], stmt(wi(amb, amb))))],
			map(plain, \b -> RuUnfTabF(b.first, 0,
				RuProofStep(s2id("a1i"),
					[RuProofHyp(b.second, stmt(b.first))],
					stmt(wi(amb, b.first))))),
			map(insts, \p -> RuUnfTabF(p.first, 0,
				RuProofStep(s2id("a1i"), [p.second], stmt(wi(amb, p.first)))))]);
		switch (ruUnfTab(math, env, ruInAtomCongsCached(math), stmtClass, wffT, matrix, [amb], [], pending0, ops)) {
			None(): None();
			Some(t): {
				// ((wb ∧ ¬M) → M) ⇒ ex ⇒ (wb → (¬M → M)) ⇒ Clavius syl ⇒ (wb → M)
				e1 = RuProofStep(s2id("ex"), [t], stmt(wi(wb, wi(nM, matrix))));
				pm = RuProofStep(s2id("pm2.18"), [],
					stmt(wi(wi(nM, matrix), matrix)));
				clav = RuProofStep(s2id("syl"), [e1, pm], stmt(wi(wb, matrix)));
				// unfold the left-nested body conjunction into the antecedent chain
				// — EXACTLY length(bodies)-1 times: a body may itself be a
				// conjunction, and unfolding into it curries what exlimiv needs whole
				Some(ruUnfChainUnfold(stmtClass, wffT, clav, wb, matrix, length(bodies) - 1));
			}
		}
	}
}

// ((a∧b) → X) ⇒ ex ⇒ (a → (b → X)), recursing into `a`, EXACTLY n times —
// turns the left-nested body conjunction ((b1∧b2)∧…) into the right-nested
// chain b1→(b2→(…→X)) WITHOUT currying into a conjunctive body itself.
ruUnfChainUnfold(stmtClass : int, wffT : int, tree : RuProofTree, conj : RuExp,
	concl : RuExp, n : int) -> RuProofTree {
	waId = s2id("wa");
	if (n <= 0 || ruInHead(conj) != waId || ruInArity(conj) != 2) tree
	else {
		args = ruInArgs(conj);
		wi = \a : RuExp, b : RuExp -> ruFwdMkRule(s2id("wi"), wffT, [a, b]);
		inner = wi(args[1], concl);
		t2 = RuProofStep(s2id("ex"), [tree],
			RuStmt(stmtClass, [wi(args[0], inner)], -1));
		ruUnfChainUnfold(stmtClass, wffT, t2, args[0], inner, n - 1);
	}
}
