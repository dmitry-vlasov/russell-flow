import ru/prover/tactics/congruence;
import ru/prover/tactics/instantiate;
import ru/verify/theorem;
import ru/util/lang;
import ru/util/src2s;
import base/ids;

// THE EQUALIZER PLANNER — decision core (planner-executor architecture).
//
// Transcribed from the original Mizar checker (~/dev/system/kernel/):
//   checker.pas  InferenceChecker: PreCheck -> per-disjunct Equate -> Unification;
//                a disjunct is refuted when Contr > 0.
//   equalizer.pas Equate: every term of the disjunct is canonicalized into an
//                eq-class (YTerm, hash-consing); positive `=` literals become
//                pending equalities; UnionTrms merges classes with congruence
//                propagated through per-functor occurrence lists; the negated
//                goal l <> r is refuted by REFLEXIVITY (SetContr 19 in
//                ContradictionVerify) once closure puts l and r in one class.
//   unifier.pas  instantiates UNIVERSAL premises so that their instances feed
//                the eq-class structure until a clash appears.
//
// The mapping into our context: the theorem's ∀-closed equality goal, negated and
// Skolemized (Mizar's PreCheck), is exactly the goal MATRIX with its bound setvars
// read as free constants. Universal equality premises are instantiated by MATCHING
// their STRUCTURED sides against the term DAG (the Unifier restricted to the equality
// fragment; Mizar's Identities likewise registers lhs patterns), each instance is a
// ground equality fact, and the ground closure is the existing proof-producing
// congruence closure (congruence.flow — our UnionTrms + FuncTrmList). Decision:
// goal sides in one class.
//
// This module is the PLANNER'S BRAIN only: it navigates freely (any internal
// structures) and NEVER touches the PVT. Plan extraction (which nodes the executor
// expands) and the executor wiring come on top of the decision.
//
// REPRESENTATION LESSONS (all measured, each cost a debugging round):
//  - THE COERCION IS AN IDENTITY, NOT A SHAPE. The setvar->class coercion node must be
//    recognized by its RULE ID (ruSuperRule(setvar, class)); the shape test "1-ary class
//    rule over a var" also matches csn(A) — the SINGLETON — and the apply then swallowed
//    the {·} wrappers (df-pr's instance came out as `x2 ∪ x3`).
//  - RULE NODES PACK (arity, LEN): len is the argument-subtree node count, so plain node
//    equality only holds between identically-SIZED subterms — a pattern head never equals
//    a term head over different arguments. Compare id+type+arity, ignore len; and after
//    substitution RECOMPUTE lens (len = arity-driven span - 1), or the instances neither
//    dedup nor key against real expressions.
//  - CLASS-typed premise vars are true metavariables (set.mm's A/B): they bind ANY class
//    slice. SETVAR vars bind bare vars, or any class slice through the coercion.
//  - A premise side that is a LONE (possibly coerced) variable matches every term: never
//    match that direction (equid / unidm-reversed junk flooded the caps).

export {
	RuEqzPlan(
		provable  : bool,
		rounds    : int,   // instantiation rounds actually run
		instances : int,   // universal-premise instances admitted into the closure
		premises  : int,   // universal equality premises offered (post head-filter)
		overflow  : bool,  // a cap fired (Mizar's LatOvfl analogue) — verdict only "not decided"
		route     : [RuEqzRouteFact],  // provable only: the closure-explain's USED facts, in leaf order
		// The ASSEMBLED PROOF (the direct generator, pre-tactic): the explain tree with
		// every route-fact leaf spliced — hyp fact → the theorem's hyp leaf, setvar-only
		// premise instance → a 0-ref application step (the verifier reconstructs the
		// substitution from the statement). None when the goal was ∀-stripped, a hyp
		// fact was ∀-stripped, an instance is classBound, or the route uses an elem-eq
		// (the extensionality builder is not written yet).
		proof     : Maybe<RuProofTree>
	);

	// A fact admitted into the closure, with its PROVENANCE — the plan-extraction
	// currency: the route is the list of facts the goal's explain chain actually
	// uses, and the provenance says what the EXECUTOR stage needs to replay each:
	//   FromHyp      — a theorem hypothesis: a ref leaf, free;
	//   FromPremise  — an instance of a universal premise; classBound marks a
	//                  SETVAR premise var bound to a class slice — replayable only
	//                  through ax-gen + spcv (the (d) re-generalization item), while
	//                  setvar-only instances are a direct assertion application;
	//   FromElems    — an element-set coincidence: needs the extensionality builder
	//                  (both membership characterizations + the ⋁-permutation bridge).
	RuEqzRouteFact(exp : RuExp, src : RuEqzRouteFactSrc);
	RuEqzRouteFactSrc ::= RuEqzSrcHyp, RuEqzSrcPremise, RuEqzSrcElems;
		RuEqzSrcHyp(idx : int, direct : bool);   // direct = the hyp was not ∀-stripped
		RuEqzSrcPremise(assId : int, bind : Tree<int, [RuExpNode]>, classBound : bool,
			flipped : bool,    // instance matched the premise's RHS: replay = application + eqcomi
			stripped : bool);  // premise was ∀-closed: replay needs an instantiation chain (not yet)
		RuEqzSrcElems(a : RuExp, b : RuExp);

	// Decide `goal` (a possibly ∀-closed equality) from ground equality hyps + the
	// universal equality premises + the element rules. stmtClass = the statement class.
	ruEqzPlanDecide(math : RuMath, env : RuEnv, stmtClass : int,
		prems : [RuEqzPremise], elemRules : Tree<int, [RuEqzElemRule]>,
		hyps : [RuExp], goal : RuExp) -> RuEqzPlan;

	// A universal equality premise, pre-split: ∀-stripped matrix sides + matrix vars.
	RuEqzPremise(assId : int, lhs : RuExp, rhs : RuExp, vars : [int], foundational : bool,
		stripped : bool);   // the matrix was ∀-stripped from the assertion's prop

	// The premise set for a theorem: every ∀-closed (or class-var) equality assertion
	// PRECEDING the theorem (the reachability soundness law). Article/import equalities
	// wholesale; FOUNDATION (miz_set) equalities only in DEFINITIONAL shape (one
	// constructor over distinct plain-var args — the df-pr/df-tp family the A-map reuse
	// displaced the article defs onto) or STRUCTURAL shape (comm/assoc/idem of one
	// constructor — Mizar carries these as constructor PROPERTIES, equalizer.pas).
	// Wholesale foundation admission floods the caps (measured).
	ruEqzScopePremises(math : RuMath, env : RuEnv, thInfo : RuDeclInfo) -> [RuEqzPremise];

	// AN ELEMENT RULE — the definition-consumption channel (Mizar's InferConstDef:
	// definitions are available WITHOUT citation, expanded at Equate start). For a
	// constructor C whose membership characterization is a PURE DISJUNCTION,
	//   t ∈ C(a1…an)  ↔  ⋁ t = a_i (i in eqArgs)  ∨  ⋁ t ∈ a_j (j in memArgs),
	// the term C(ā) IS the finite set with elements ā|eqArgs ∪ elems(ā|memArgs). Two
	// DAG terms with the SAME element set (modulo eq-classes) are equal by
	// extensionality — that is how a k-enum term meets its {·,·}∪{·}-composite twin.
	// Scanned from two mechanical sources, each VERIFIED BY TRUTH TABLE (only the
	// sound purely-disjunctive fragment registers; ∧/¬/⊆ shapes fail the check):
	//  - membership biconds `t ∈ C(ā) ↔ rhs` (elun/elpr/elsn family; setness-only
	//    hyps admitted — the planner decides, the executor discharges them);
	//  - means-definitions `∀ (xd = k(ā) ↔ ∀t body)` with body ≡ (t∈xd ↔ ⋁…) — the
	//    Mizar `func … means` family (enumset1's d2…d8), NOT plain equalities, which
	//    is why the wceq premise scan could never use them.
	RuEqzElemRule(assId : int, cId : int, arity : int, eqArgs : [int], memArgs : [int]);
	ruEqzElemRules(math : RuMath, env : RuEnv, thInfo : RuDeclInfo) -> Tree<int, [RuEqzElemRule]>;

	ruEqzStripAlls(e : RuExp) -> RuExp;
	ruEqzCoercionId(math : RuMath, env : RuEnv) -> int;
	ruEqzMatch(term : [RuExpNode], pat : [RuExpNode], patVars : Set<int>, coId : int) -> Maybe<Tree<int, [RuExpNode]>>;
	ruEqzApply(pat : [RuExpNode], bind : Tree<int, [RuExpNode]>, coId : int) -> Maybe<[RuExpNode]>;
}

// ---- caps (Mizar's LatOvfl/TrmOvfl analogues) -------------------------------

ruEqzMaxRounds = 6;
ruEqzMaxInstances = 1024;
ruEqzMaxTerms = 4096;
ruEqzMaxFoundPerRound = 128;

// ---- small expression utilities ---------------------------------------------

ruEqzStripAlls(e : RuExp) -> RuExp {
	if (ruInHead(e) == s2id("wal") && ruInArity(e) == 2) ruEqzStripAlls((ruInArgs(e))[1]) else e;
}

// THE setvar->class coercion rule id, from the language's super-rule registry.
ruEqzCoercionId(math : RuMath, env : RuEnv) -> int {
	switch (ruSuperRule(tp2id_("setvar"), tp2id_("class"), math.decls.lang, env)) {
		Some(r): r.info.id;
		None(): -1;
	}
}

ruEqzIsCoercionAt(nodes : [RuExpNode], i : int, coId : int) -> bool {
	switch (nodes[i]) {
		RuVar(__, __): false;
		RuRuleNode(idT, __): ruIdType2Id(idT) == coId;
	}
}

ruEqzVarAt(nodes : [RuExpNode], i : int) -> int {
	switch (nodes[i]) { RuVar(id, __): id; RuRuleNode(__, __): -1; }
}

// Same constructor? Compare id+type+arity, IGNORE len (see header).
ruEqzSameNode(a : RuExpNode, b : RuExpNode) -> bool {
	switch (a) {
		RuVar(__, __): a == b;
		RuRuleNode(idT1, al1): switch (b) {
			RuVar(__, __): false;
			RuRuleNode(idT2, al2): idT1 == idT2 && ruArityLen2Arity(al1) == ruArityLen2Arity(al2);
		}
	}
}

// the node span of the subterm starting at i (1 + spans of its arguments; arity-driven,
// so it stays correct on stale-len nodes)
ruEqzSpan(nodes : [RuExpNode], i : int) -> int {
	switch (nodes[i]) {
		RuVar(__, __): 1;
		RuRuleNode(__, al): {
			fold(enumFromTo(1, ruArityLen2Arity(al)), 1, \acc, __ ->
				acc + ruEqzSpan(nodes, i + acc));
		}
	}
}

// ---- matching: ground term against a premise-side pattern -------------------

ruEqzMatch(term : [RuExpNode], pat : [RuExpNode], patVars : Set<int>, coId : int) -> Maybe<Tree<int, [RuExpNode]>> {
	ruEqzDoMatch(term, 0, length(term), pat, 0, length(pat), patVars, coId, Some(makeTree()));
}

ruEqzDoMatch(term : [RuExpNode], ti : int, tEnd : int, pat : [RuExpNode], pi : int, pEnd : int,
	patVars : Set<int>, coId : int, accM : Maybe<Tree<int, [RuExpNode]>>) -> Maybe<Tree<int, [RuExpNode]>> {
	switch (accM) {
		None(): None();
		Some(acc): {
			if (pi >= pEnd && ti >= tEnd) accM
			else if (pi >= pEnd || ti >= tEnd) None()
			else {
				bindVar = \v : int, slice : [RuExpNode], pAdv : int, tAdv : int -> {
					bound = switch (lookupTree(acc, v)) {
						Some(old): if (old == slice) accM else None();
						None(): Some(setTree(acc, v, slice));
					}
					switch (bound) {
						None(): None();
						Some(__): ruEqzDoMatch(term, ti + tAdv, tEnd, pat, pi + pAdv, pEnd, patVars, coId, bound);
					}
				}
				coercedVar = ruEqzIsCoercionAt(pat, pi, coId) && pi + 1 < pEnd
					&& containsSet(patVars, ruEqzVarAt(pat, pi + 1));
				if (coercedVar) {
					// coerced setvar: swallow the whole class term at ti
					span = ruEqzSpan(term, ti);
					bindVar(ruEqzVarAt(pat, pi + 1), subrange(term, ti, span), 2, span);
				} else {
					switch (pat[pi]) {
						RuVar(vid, tpv): {
							if (containsSet(patVars, vid)) {
								if (tpv == tp2id_("class")) {
									// a CLASS-typed matrix var is a true metavariable — any class slice
									span = ruEqzSpan(term, ti);
									bindVar(vid, subrange(term, ti, span), 1, span);
								} else {
									// a bare SETVAR matrix var: only a bare var slice can stand in
									switch (term[ti]) {
										RuVar(__, __): bindVar(vid, [term[ti]], 1, 1);
										RuRuleNode(__, __): None();
									}
								}
							} else if (term[ti] == pat[pi])
								ruEqzDoMatch(term, ti + 1, tEnd, pat, pi + 1, pEnd, patVars, coId, accM)
							else None();
						}
						RuRuleNode(__, __):
							if (ruEqzSameNode(term[ti], pat[pi]))
								ruEqzDoMatch(term, ti + 1, tEnd, pat, pi + 1, pEnd, patVars, coId, accM)
							else None();
					}
				}
			}
		}
	}
}

// apply a binding: coerced-setvar slices and class-var occurrences are replaced by the
// bound slices; bare setvar occurrences only by single-var slices
ruEqzApply(pat : [RuExpNode], bind : Tree<int, [RuExpNode]>, coId : int) -> Maybe<[RuExpNode]> {
	ok = ref true;
	built = ruEqzDoApply(pat, bind, coId, ok);
	if (^ok) Some(ruEqzFixLens(built)) else None();
}

ruEqzDoApply(pat : [RuExpNode], bind : Tree<int, [RuExpNode]>, coId : int, ok : ref bool) -> [RuExpNode] {
	out = fold(enumFromTo(0, length(pat) - 1), Pair([], 0), \acc : Pair<[[RuExpNode]], int>, j ->
		if (j < acc.second) acc else {
			coerced = ruEqzIsCoercionAt(pat, j, coId) && j + 1 < length(pat)
				&& isSome(lookupTree(bind, ruEqzVarAt(pat, j + 1)));
			if (coerced) {
				slice = either(lookupTree(bind, ruEqzVarAt(pat, j + 1)), []);
				Pair(arrayPush(acc.first, slice), j + 2);
			} else {
				n = switch (pat[j]) {
					RuVar(vid, tpv): switch (lookupTree(bind, vid)) {
						Some(slice): if (tpv == tp2id_("class") || length(slice) == 1) slice
							else { ok := false; [pat[j]]; };
						None(): [pat[j]];
					}
					RuRuleNode(__, __): [pat[j]];
				}
				Pair(arrayPush(acc.first, n), j + 1);
			}
		});
	concatA(out.first);
}

// After splicing, rule nodes above a splice carry STALE lens; recompute
// (len = span - 1: subst.flow reads subrange(nodes, 1, len)).
ruEqzFixLens(nodes : [RuExpNode]) -> [RuExpNode] {
	mapi(nodes, \i, n -> switch (n) {
		RuVar(__, __): n;
		RuRuleNode(idT, al): ruMakeRuleNode(ruIdType2Id(idT), ruIdType2Type(idT),
			ruArityLen2Arity(al), ruEqzSpan(nodes, i) - 1);
	});
}

// ---- scope premises ---------------------------------------------------------

ruEqzInfer(a : RuAssertion) -> RuInference {
	switch (a) { RuAxiom(__, i): i; RuCong(__, i): i; RuTheorem(__, i, __, __): i; RuDef(__, i, __, __): i; }
}
ruEqzInfo(a : RuAssertion) -> RuDeclInfo {
	switch (a) { RuAxiom(i, __): i; RuCong(i, __): i; RuTheorem(i, __, __, __): i; RuDef(i, __, __, __): i; }
}

ruEqzScopePremises(math : RuMath, env : RuEnv, thInfo : RuDeclInfo) -> [RuEqzPremise] {
	imported = ruVerifyImportedMap(math, env);
	coId = ruEqzCoercionId(math, env);
	walId = s2id("wal"); wexId = s2id("wex");
	isFoundation = \src : int -> switch (lookupTree(math.sources, src)) {
		Some(sc): { m = sc.info.module; m == "miz_set" || endsWith(m, "/miz_set"); }
		None(): true;
	}
	// a "plain arg": a bare var, or the coercion over a var
	argVar = \a : RuExp ->
		if (length(a.nodes) == 1) ruEqzVarAt(a.nodes, 0)
		else if (length(a.nodes) == 2 && ruEqzIsCoercionAt(a.nodes, 0, coId)) ruEqzVarAt(a.nodes, 1)
		else -1;
	// DEFINITIONAL: one constructor over pairwise-distinct plain-var args; rhs adds no vars
	defShape = \lhs : RuExp, rhs : RuExp -> {
		args = ruInArgs(lhs);
		vs = map(args, argVar);
		ruInArity(lhs) > 0 && forall(vs, \v -> v >= 0)
			&& sizeSet(buildSet(vs)) == length(vs)
			&& forall(ruInVarsOf(rhs), \v -> contains(vs, v.id));
	}
	// STRUCTURAL: comm/assoc/idem of ONE constructor (both sides only C + plain vars,
	// C appearing 1-2 times per side); rhs vars within lhs vars
	structSide = \side : RuExp, c : int -> {
		cnt = fold(enumFromTo(0, length(side.nodes) - 1), Pair(0, true), \acc : Pair<int, bool>, i ->
			if (!acc.second) acc
			else if (ruEqzIsCoercionAt(side.nodes, i, coId)) acc
			else switch (side.nodes[i]) {
				RuVar(__, __): acc;
				RuRuleNode(idT, __):
					if (ruIdType2Id(idT) == c) Pair(acc.first + 1, true)
					else Pair(acc.first, false);
			});
		if (cnt.second) cnt.first else -1;
	}
	structShape = \lhs : RuExp, rhs : RuExp -> {
		c = ruInHead(lhs);
		nl = structSide(lhs, c);
		nr = structSide(rhs, c);
		c >= 0 && c != coId && nl >= 1 && nl <= 2 && nr >= 0 && nr <= 2
			&& forall(ruInVarsOf(rhs), \v -> exists(ruInVarsOf(lhs), \w -> w.id == v.id));
	}
	filtermap(getTreeValues(math.decls.assertions), \ass -> {
		inf = ruEqzInfer(ass);
		info = ruEqzInfo(ass);
		if (inf.hyps != [] || inf.prop.exps == []) None()
		else if (!ruDeclInfoPreceeds(info, thInfo, imported)) None()
		else {
			matrix = ruEqzStripAlls(ruExp(inf.prop.exps[0]));
			if (ruInHead(matrix) != s2id("wceq") || ruInArity(matrix) != 2) None()
			else if (exists(matrix.nodes, \n -> switch (n) {
					RuVar(__, __): false;
					RuRuleNode(idT, __): ruIdType2Id(idT) == walId || ruIdType2Id(idT) == wexId;
				})) None()   // v1: no binders inside the matrix
			else {
				sides = ruInArgs(matrix);
				found = isFoundation(info.src);
				if (found && !defShape(sides[0], sides[1]) && !structShape(sides[0], sides[1])) None()
				else {
					vars = fold(matrix.nodes, makeSet(), \acc, n -> switch (n) {
						RuVar(id, __): insertSet(acc, id);
						RuRuleNode(__, __): acc;
					});
					Some(RuEqzPremise(info.id, sides[0], sides[1], set2array(vars), found,
						matrix.nodes != (ruExp(inf.prop.exps[0])).nodes));
				}
			}
		}
	});
}

// ---- element rules (definition consumption, Mizar's InferConstDef) ----------

// atom kinds inside a characterization formula, relative to (t, xd, args)
RuEqzAtom ::= RuEqzAtomEq, RuEqzAtomMem, RuEqzAtomSelf;
	RuEqzAtomEq(pos : int);    // t = args[pos]
	RuEqzAtomMem(pos : int);   // t ∈ args[pos]
	RuEqzAtomSelf();           // t ∈ xd (means-definitions only)

ruEqzElemCache : ref [Pair<int, [Pair<RuDeclInfo, RuEqzElemRule>]>] = ref [];

ruEqzElemRules(math : RuMath, env : RuEnv, thInfo : RuDeclInfo) -> Tree<int, [RuEqzElemRule]> {
	n = sizeTree(math.decls.assertions);
	c = ^ruEqzElemCache;
	all = if (c != [] && c[0].first == n) c[0].second else {
		coId = ruEqzCoercionId(math, env);
		scanned = filtermap(getTreeValues(math.decls.assertions), \ass ->
			maybeMap(ruEqzAnalyzeElemRule(math, ass, coId), \r -> Pair(ruEqzInfo(ass), r)));
		ruEqzElemCache := [Pair(n, scanned)];
		scanned;
	}
	imported = ruVerifyImportedMap(math, env);
	fold(all, makeTree(), \acc, p ->
		if (!ruDeclInfoPreceeds(p.first, thInfo, imported)) acc
		else treePushToArrayValue(acc, p.second.cId, p.second));
}

// a plain var: bare, or the coercion over a var; -1 otherwise
ruEqzPlainVar(nodes : [RuExpNode], coId : int) -> int {
	if (length(nodes) == 1) ruEqzVarAt(nodes, 0)
	else if (length(nodes) == 2 && ruEqzIsCoercionAt(nodes, 0, coId)) ruEqzVarAt(nodes, 1)
	else -1;
}

// setness-shaped hypothesis: `A ∈ _V`
ruEqzIsSetnessHyp(e : RuExp) -> bool {
	ruInHead(e) == s2id("wcel") && ruInArity(e) == 2
		&& { args = ruInArgs(e); ruInHead(args[1]) == s2id("cvv"); }
}

ruEqzAnalyzeElemRule(math : RuMath, ass : RuAssertion, coId : int) -> Maybe<RuEqzElemRule> {
	inf = ruEqzInfer(ass);
	info = ruEqzInfo(ass);
	if (inf.prop.exps == []) None()
	else {
		matrix = ruEqzStripAlls(ruExp(inf.prop.exps[0]));
		if (ruInHead(matrix) != s2id("wb") || ruInArity(matrix) != 2) None()
		else {
			sides = ruInArgs(matrix);
			lhs = sides[0]; rhs = sides[1];
			if (ruInHead(lhs) == s2id("wcel") && ruInArity(lhs) == 2
				&& forall(inf.hyps, \h -> h.stmt.exps != [] && ruEqzIsSetnessHyp(ruExp(h.stmt.exps[0])))) {
				// SOURCE A: membership bicond `t ∈ C(ā) ↔ rhs`
				mArgs = ruInArgs(lhs);
				t = ruEqzPlainVar(mArgs[0].nodes, coId);
				obj = mArgs[1];
				cId = ruInHead(obj);
				args = ruInArgs(obj);
				argVs = map(args, \a -> ruEqzPlainVar(a.nodes, coId));
				if (t < 0 || cId < 0 || cId == coId || args == []
					|| exists(argVs, \v -> v < 0 || v == t)
					|| sizeSet(buildSet(argVs)) != length(argVs)) None()
				else ruEqzCheckElemRule(info.id, cId, length(args), rhs, t, -1, argVs, coId, false);
			} else if (inf.hyps == [] && ruInHead(lhs) == s2id("wceq") && ruInArity(lhs) == 2) {
				// SOURCE B: means-definition `(xd = k(ā)) ↔ ∀t body`
				eqSides = ruInArgs(lhs);
				pick = \xdSide : RuExp, kSide : RuExp -> {
					xd = ruEqzPlainVar(xdSide.nodes, coId);
					cId = ruInHead(kSide);
					args = ruInArgs(kSide);
					argVs = map(args, \a -> ruEqzPlainVar(a.nodes, coId));
					if (xd < 0 || cId < 0 || cId == coId || args == []
						|| exists(argVs, \v -> v < 0 || v == xd)
						|| sizeSet(buildSet(argVs)) != length(argVs)
						|| ruInHead(rhs) != s2id("wal") || ruInArity(rhs) != 2) None()
					else {
						walArgs = ruInArgs(rhs);
						t = ruEqzPlainVar(walArgs[0].nodes, coId);
						body = walArgs[1];
						if (t < 0 || t == xd || contains(argVs, t)) None()
						else ruEqzCheckElemRule(info.id, cId, length(args), body, t, xd, argVs, coId, true);
					}
				}
				switch (pick(eqSides[0], eqSides[1])) {
					Some(r): Some(r);
					None(): pick(eqSides[1], eqSides[0]);
				}
			} else None();
		}
	}
}

// Parse `formula` over connectives {¬ ∧ ∨ → ↔} with atoms t=arg / t∈arg / t∈xd, then
// VERIFY BY TRUTH TABLE that it is equivalent to the pure disjunction (means form:
// t∈xd ↔ disjunction). Only then the rule is sound for element-set comparison.
ruEqzCheckElemRule(assId : int, cId : int, arity : int, formula : RuExp,
	t : int, xd : int, argVs : [int], coId : int, meansForm : bool) -> Maybe<RuEqzElemRule> {
	conn = buildSet([s2id("wn"), s2id("wa"), s2id("wo"), s2id("wi"), s2id("wb")]);
	atomsM = ruEqzCollectAtoms(formula.nodes, 0, conn, Some([]));
	switch (atomsM) {
		None(): None();
		Some(atomSlices): {
			classified = filtermap(atomSlices, \sl -> maybeMap(
				ruEqzClassifyAtom(sl, t, xd, argVs, coId), \k -> Pair(sl, k)));
			nAtoms = length(atomSlices);
			hasSelf = exists(classified, \p -> p.second == RuEqzAtomSelf());
			if (length(classified) != nAtoms || nAtoms == 0 || nAtoms > 12
				|| (meansForm && !hasSelf) || (!meansForm && hasSelf)) None()
			else {
				ok = forall(enumFromTo(0, pow(2, nAtoms) - 1), \mask -> {
					vals = mapi(classified, \i, p -> Pair(p.first, (mask / pow(2, i)) % 2 == 1));
					disj = exists(mapi(classified, \i, p ->
						Pair(p.second, vals[i].second)), \pv ->
							pv.second && pv.first != RuEqzAtomSelf());
					selfV = fold(mapi(classified, \i, p -> Pair(p.second, vals[i].second)),
						false, \acc, pv -> acc || (pv.first == RuEqzAtomSelf() && pv.second));
					target = ruEqzEvalF(formula.nodes, 0, conn, vals).first;
					if (meansForm) target == (selfV == disj) else target == disj;
				});
				if (!ok) None()
				else {
					eqArgs = filtermap(classified, \p -> switch (p.second) {
						RuEqzAtomEq(pos): Some(pos); default: None(); });
					memArgs = filtermap(classified, \p -> switch (p.second) {
						RuEqzAtomMem(pos): Some(pos); default: None(); });
					Some(RuEqzElemRule(assId, cId, arity,
						set2array(buildSet(eqArgs)), set2array(buildSet(memArgs))));
				}
			}
		}
	}
}

// collect the maximal non-connective subformula slices (the atoms), left to right
ruEqzCollectAtoms(nodes : [RuExpNode], i : int, conn : Set<int>,
	accM : Maybe<[[RuExpNode]]>) -> Maybe<[[RuExpNode]]> {
	switch (accM) {
		None(): None();
		Some(acc): {
			switch (nodes[i]) {
				RuVar(__, __): None();   // a bare wff metavar has no element reading
				RuRuleNode(idT, al): {
					if (containsSet(conn, ruIdType2Id(idT))) {
						fold(enumFromTo(1, ruArityLen2Arity(al)), Pair(accM, i + 1),
							\st : Pair<Maybe<[[RuExpNode]]>, int>, __ -> {
								sp = ruEqzSpan(nodes, st.second);
								Pair(ruEqzCollectAtoms(nodes, st.second, conn, st.first), st.second + sp);
							}).first;
					} else {
						sl = subrange(nodes, i, ruEqzSpan(nodes, i));
						if (contains(acc, sl)) accM else Some(arrayPush(acc, sl));
					}
				}
			}
		}
	}
}

ruEqzClassifyAtom(sl : [RuExpNode], t : int, xd : int, argVs : [int], coId : int) -> Maybe<RuEqzAtom> {
	e = RuExp(sl, -1);
	h = ruInHead(e);
	if (ruInArity(e) != 2) None()
	else {
		args = ruInArgs(e);
		a = ruEqzPlainVar(args[0].nodes, coId);
		b = ruEqzPlainVar(args[1].nodes, coId);
		if (h == s2id("wceq") || h == s2id("weq")) {
			if (a == t && contains(argVs, b)) Some(RuEqzAtomEq(elemIndex(argVs, b, -1)))
			else if (b == t && contains(argVs, a)) Some(RuEqzAtomEq(elemIndex(argVs, a, -1)))
			else None();
		} else if (h == s2id("wcel") || h == s2id("wel")) {
			if (a != t) None()
			else if (b == xd) Some(RuEqzAtomSelf())
			else if (contains(argVs, b)) Some(RuEqzAtomMem(elemIndex(argVs, b, -1)))
			else None();
		} else None();
	}
}

// evaluate the formula at `i` under the atom assignment; returns (value, span)
ruEqzEvalF(nodes : [RuExpNode], i : int, conn : Set<int>, vals : [Pair<[RuExpNode], bool>]) -> Pair<bool, int> {
	switch (nodes[i]) {
		RuVar(__, __): Pair(false, 1);
		RuRuleNode(idT, al): {
			id = ruIdType2Id(idT);
			if (containsSet(conn, id)) {
				ar = ruArityLen2Arity(al);
				kids = fold(enumFromTo(1, ar), Pair([], i + 1),
					\st : Pair<[bool], int>, __ -> {
						k = ruEqzEvalF(nodes, st.second, conn, vals);
						Pair(arrayPush(st.first, k.first), st.second + k.second);
					});
				v = if (id == s2id("wn")) !(kids.first)[0]
					else if (id == s2id("wa")) (kids.first)[0] && (kids.first)[1]
					else if (id == s2id("wo")) (kids.first)[0] || (kids.first)[1]
					else if (id == s2id("wi")) !(kids.first)[0] || (kids.first)[1]
					else (kids.first)[0] == (kids.first)[1];
				Pair(v, kids.second - i);
			} else {
				sp = ruEqzSpan(nodes, i);
				sl = subrange(nodes, i, sp);
				v = fold(vals, false, \acc, p -> acc || (p.first == sl && p.second));
				Pair(v, sp);
			}
		}
	}
}

// ---- element sets over the DAG ----------------------------------------------

// The canonical element set of a term (None = no element reading). Elements are
// eq-class representative keys, so the comparison is modulo the current closure.
ruEqzElemsOf(rules : Tree<int, [RuEqzElemRule]>, st : RuCongSt,
	memo : ref Tree<[RuExpNode], Maybe<Set<string>>>, t : RuExp) -> Maybe<Set<string>> {
	switch (lookupTree(^memo, t.nodes)) {
		Some(r): r;
		None(): {
			h = ruInHead(t);
			ar = ruInArity(t);
			r = switch (find(lookupTreeDef(rules, h, []), \rl -> rl.arity == ar)) {
				None(): None();
				Some(rl): {
					args = ruInArgs(t);
					base = fold(rl.eqArgs, Some(makeSet()), \acc : Maybe<Set<string>>, i ->
						maybeMap(acc, \s -> insertSet(s, ruCongRepr(st, args[i]))));
					fold(rl.memArgs, base, \acc : Maybe<Set<string>>, j ->
						maybeBind(acc, \s -> maybeMap(ruEqzElemsOf(rules, st, memo, args[j]),
							\s2 -> mergeSets(s, s2))));
				}
			}
			memo := setTree(^memo, t.nodes, r);
			r;
		}
	}
}

// New equality facts from element-set coincidence: group the DAG terms by their
// canonical element set; within a group, equate the first with each not-yet-equal rest.
ruEqzElemFacts(rules : Tree<int, [RuEqzElemRule]>, st : RuCongSt, subs : [RuExp],
	seen : Set<[RuExpNode]>) -> [RuEqzRouteFact] {
	if (isEmptyTree(rules)) [] else {
		memo : ref Tree<[RuExpNode], Maybe<Set<string>>> = ref makeTree();
		groups = fold(subs, makeTree(), \acc : Tree<string, [RuExp]>, t ->
			switch (ruEqzElemsOf(rules, st, memo, t)) {
				None(): acc;
				Some(s): treePushToArrayValue(acc, strGlue(set2array(s), "|"), t);
			});
		wffT = tp2id_("wff");
		foldTree(groups, [], \__, ts, acc ->
			if (length(ts) < 2) acc
			else fold(tail(ts), acc, \a, t2 ->
				if (ruCongEqual(st, ts[0], t2)) a
				else {
					inst = ruFwdMkRule(s2id("wceq"), wffT, [ts[0], t2]);
					if (containsSet(seen, inst.nodes)) a
					else arrayPush(a, RuEqzRouteFact(inst, RuEqzSrcElems(ts[0], t2)));
				}));
	}
}

// ---- proof assembly (the direct generator) -----------------------------------

// Splice every route-fact leaf of the explain tree into a real proof node.
// None = a fact kind the generator cannot replay yet.
ruEqzSpliceProof(tr : RuProofTree, facts : [RuEqzRouteFact]) -> Maybe<RuProofTree> {
	switch (tr) {
		RuProofHyp(i, stmt):
			if (i < 0 || i >= length(facts)) None()
			else switch (facts[i].src) {
				RuEqzSrcHyp(idx, direct): if (direct) Some(RuProofHyp(idx, stmt)) else None();
				RuEqzSrcPremise(assId, __, cb, flipped, stripped):
					if (cb || stripped) None()
					else if (!flipped) Some(RuProofStep(assId, [], stmt))
					else {
						// the instance matched the premise's RHS — the assertion proves the
						// SWAPPED equality; bridge with eqcomi (A = B ⊢ B = A)
						sds = ruInArgs(facts[i].exp);
						swapped = ruFwdMkRule(s2id("wceq"), tp2id_("wff"), [sds[1], sds[0]]);
						Some(RuProofStep(s2id("eqcomi"),
							[RuProofStep(assId, [], RuStmt(stmt with exps = [swapped]))], stmt));
					}
				RuEqzSrcElems(__, __): None();
			}
		RuProofStep(ass, ch, stmt): {
			chM = fold(ch, Some([]), \acc : Maybe<[RuProofTree]>, c -> maybeBind(acc, \arr ->
				maybeMap(ruEqzSpliceProof(c, facts), \cc -> arrayPush(arr, cc))));
			maybeMap(chM, \cc -> RuProofStep(ass, cc, stmt));
		}
	}
}

// ---- route extraction --------------------------------------------------------

// The route = the facts the goal's explain chain actually USES, in first-use leaf
// order. The closure's facts are indexed placeholder hyps (RuProofHyp i), so the
// walk maps leaf indices straight back to the provenance-carrying facts.
ruEqzExtractRoute(st : RuCongSt, gs : [RuExp], facts : [RuEqzRouteFact]) -> [RuEqzRouteFact] {
	switch (ruCongExplain(st, gs[0], gs[1])) {
		None(): [];
		Some(tr): map(ruEqzRouteWalk(tr, Pair([], makeSet())).first, \i -> facts[i]);
	}
}

ruEqzRouteWalk(tr : RuProofTree, acc : Pair<[int], Set<int>>) -> Pair<[int], Set<int>> {
	switch (tr) {
		RuProofHyp(i, __):
			if (i < 0 || containsSet(acc.second, i)) acc
			else Pair(arrayPush(acc.first, i), insertSet(acc.second, i));
		RuProofStep(__, ch, __): fold(ch, acc, \a, c -> ruEqzRouteWalk(c, a));
	}
}

// ---- the decision loop ------------------------------------------------------

ruEqzPlanDecide(math : RuMath, env : RuEnv, stmtClass : int,
	prems : [RuEqzPremise], elemRules : Tree<int, [RuEqzElemRule]>,
	hyps : [RuExp], goal : RuExp) -> RuEqzPlan {
	matrix = ruEqzStripAlls(goal);
	if (ruInHead(matrix) != s2id("wceq") || ruInArity(matrix) != 2)
		RuEqzPlan(false, 0, 0, length(prems), false, [], None())
	else {
		gs = ruInArgs(matrix);
		coId = ruEqzCoercionId(math, env);
		// HEAD-RELEVANCE premise filter (our stand-in until by-refs are carried through
		// translation — Mizar's by-list names its premises)
		problemHeads = fold(concat([matrix], hyps), makeSet(), \acc, e ->
			fold(e.nodes, acc, \a, n -> switch (n) {
				RuVar(__, __): a;
				RuRuleNode(idT, __): insertSet(a, ruIdType2Id(idT));
			}));
		relPrems0 = filter(prems, \p ->
			containsSet(problemHeads, ruInHead(p.lhs)) || containsSet(problemHeads, ruInHead(p.rhs)));
		// ARTICLE premises first: the instance cap is a shared budget, and the foundation's
		// comm/assoc family generates instances at every subterm — admitted first it CROWDS
		// OUT the article-def chains (measured: the k-functor theorems regressed from
		// decided to open when the foundation was added). Mizar has no such contention
		// because the by-list names few premises; ordering is our stand-in.
		relPrems = mergeSort(relPrems0, \a, b -> b2i(a.foundational) - b2i(b.foundational));
		rules = ruCongRulesCached(math);
		hypFacts = filtermapi(hyps, \i, h -> {
			hm = ruEqzStripAlls(h);
			if (ruInHead(hm) == s2id("wceq") && ruInArity(hm) == 2
				&& !exists(hm.nodes, \n -> switch (n) { RuVar(__, __): false; RuRuleNode(idT, __): ruIdType2Id(idT) == s2id("wal"); }))
				Some(RuEqzRouteFact(hm, RuEqzSrcHyp(i, hm.nodes == h.nodes)))
			else None();
		});
		terms0 = concat([gs[0], gs[1]], concatA(map(hypFacts, \f -> ruInArgs(f.exp))));
		goalDirect = matrix.nodes == goal.nodes;
		decideLoop(math, env, stmtClass, relPrems, elemRules, rules, coId, hypFacts, terms0, 0, gs, goalDirect);
	}
}

decideLoop(math : RuMath, env : RuEnv, stmtClass : int, prems : [RuEqzPremise],
	elemRules : Tree<int, [RuEqzElemRule]>,
	rules : Tree<int, [RuCongRule]>, coId : int, facts : [RuEqzRouteFact], terms : [RuExp],
	round : int, gs : [RuExp], goalDirect : bool) -> RuEqzPlan {
	// the closure's facts are INDEXED placeholder hyps, so an explain tree maps its
	// leaves straight back to provenance-carrying facts (route extraction)
	pairs = mapi(facts, \i, f -> Pair(RuProofHyp(i, RuStmt(stmtClass, [f.exp], -1)), f.exp));
	st = ruCongClose(rules, pairs, terms, stmtClass, math, env);
	if (ruCongEqual(st, gs[0], gs[1])) {
		explM = ruCongExplain(st, gs[0], gs[1]);
		route = switch (explM) {
			None(): [];
			Some(tr): map(ruEqzRouteWalk(tr, Pair([], makeSet())).first, \i -> facts[i]);
		}
		prf = if (!goalDirect) None() else maybeBind(explM, \tr -> ruEqzSpliceProof(tr, facts));
		RuEqzPlan(true, round, length(facts), length(prems), false, route, prf);
	} else if (round >= ruEqzMaxRounds)
		RuEqzPlan(false, round, length(facts), length(prems), false, [], None())
	else {
		subs = ruEqzSubterms(terms);
		if (length(subs) > ruEqzMaxTerms)
			RuEqzPlan(false, round, length(facts), length(prems), true, [], None())
		else {
			seen00 = buildSet(map(facts, \f -> f.exp.nodes));
			// definition consumption: terms whose canonical element sets coincide are equal
			elemFacts = ruEqzElemFacts(elemRules, st, subs, seen00);
			seen0 = fold(elemFacts, seen00, \acc, f -> insertSet(acc, f.exp.nodes));
			wceqW = tp2id_("wff");
			setvarT = tp2id_("setvar");
			// a slice a SETVAR premise var may take without re-generalization: a bare
			// var or the coercion over one; anything else marks the instance classBound
			plainSlice = \sl : [RuExpNode] ->
				(length(sl) == 1 && ruEqzVarAt(sl, 0) >= 0)
				|| (length(sl) == 2 && ruEqzIsCoercionAt(sl, 0, coId) && ruEqzVarAt(sl, 1) >= 0);
			foundCnt = ref 0;   // per-round foundation-instance budget (comm/assoc fan out hard)
			newFacts = fold(prems, Pair([], seen0), \acc : Pair<[RuEqzRouteFact], Set<[RuExpNode]>>, p -> {
				pv = buildSet(p.vars);
				varTps = fold(concat(p.lhs.nodes, p.rhs.nodes), makeTree(), \a, n -> switch (n) {
					RuVar(id, tp): setTree(a, id, tp);
					RuRuleNode(__, __): a;
				});
				// only match STRUCTURED sides — a lone-(coerced-)var side matches everything
				sides = filter([Pair(p.lhs, p.rhs), Pair(p.rhs, p.lhs)], \sd ->
					!(length(sd.first.nodes) == 1
						|| (length(sd.first.nodes) == 2 && ruEqzIsCoercionAt(sd.first.nodes, 0, coId))));
				fold(sides, acc, \ac, side ->
					fold(subs, ac, \a : Pair<[RuEqzRouteFact], Set<[RuExpNode]>>, t -> {
						if (length(a.first) + length(facts) > ruEqzMaxInstances
							|| (p.foundational && ^foundCnt > ruEqzMaxFoundPerRound)) a else
						switch (ruEqzMatch(t.nodes, side.first.nodes, pv, coId)) {
							None(): a;
							Some(bind): {
								if (exists(p.vars, \v -> !containsKeyTree(bind, v))) a
								else switch (ruEqzApply(side.second.nodes, bind, coId)) {
									None(): a;
									Some(otherNodes): {
										inst = ruFwdMkRule(s2id("wceq"), wceqW,
											[RuExp(t.nodes, -1), RuExp(otherNodes, -1)]);
										if (containsSet(a.second, inst.nodes)) a
										else {
											if (p.foundational) foundCnt := ^foundCnt + 1 else {};
											if (env.conf.verbose > 3) {
												env.out.println("        inst-src " + id2s(p.assId) + ": " + ru2s(inst, math));
											} else {};
											classBound = foldTree(bind, false, \v, sl, cb -> cb
												|| (lookupTreeDef(varTps, v, -1) == setvarT && !plainSlice(sl)));
											flipped = side.first.nodes == p.rhs.nodes;
											Pair(arrayPush(a.first,
												RuEqzRouteFact(inst, RuEqzSrcPremise(p.assId, bind,
													classBound, flipped, p.stripped))),
												insertSet(a.second, inst.nodes));
										}
									}
								}
							}
						}
					}));
			});
			if (env.conf.verbose > 2) {
				iter(take(elemFacts, 100), \f -> env.out.println("      elem: " + ru2s(f.exp, math)));
				iter(take(newFacts.first, 100), \f -> env.out.println("      inst: " + ru2s(f.exp, math)));
				env.out.println("      round " + i2s(round) + ": +" + i2s(length(elemFacts)) + " elem-eqs, +"
					+ i2s(length(newFacts.first)) + " instances, " + i2s(length(subs)) + " subterms");
			} else {};
			combined = concat(elemFacts, newFacts.first);
			if (combined == [])
				RuEqzPlan(false, round, length(facts), length(prems), length(facts) >= ruEqzMaxInstances, [], None())
			else {
				facts1 = concat(facts, combined);
				terms1 = concat(terms, concatA(map(newFacts.first, \f -> ruInArgs(f.exp))));
				decideLoop(math, env, stmtClass, prems, elemRules, rules, coId, facts1, terms1, round + 1, gs, goalDirect);
			}
		}
	}
}

// all subterm slices (as RuExps) of the given terms, deduped
ruEqzSubterms(terms : [RuExp]) -> [RuExp] {
	collected = fold(terms, Pair(makeSet(), []), \acc : Pair<Set<[RuExpNode]>, [RuExp]>, t ->
		ruEqzCollectSubs(t.nodes, 0, acc));
	collected.second;
}

ruEqzCollectSubs(nodes : [RuExpNode], i : int, acc : Pair<Set<[RuExpNode]>, [RuExp]>) -> Pair<Set<[RuExpNode]>, [RuExp]> {
	if (i >= length(nodes)) acc
	else {
		span = ruEqzSpan(nodes, i);
		slice = subrange(nodes, i, span);
		acc1 = if (containsSet(acc.first, slice)) acc
			else Pair(insertSet(acc.first, slice), arrayPush(acc.second, RuExp(slice, -1)));
		ruEqzCollectSubs(nodes, i + 1, acc1);
	}
}
