import ru/prover/tactics/kalmar;
import ru/prover/core/controls;
import ru/prover/core/tree;
import ru/proof_tree;
import ru/subst;
import ru/util/exp;
import ru/util/src2s;
import ru/util/disjs;
import ru/verify/math;
import base/ids;
import ds/set;

// The UNFOLD tactic — feeds the propositional closer the facts it needs to assemble. `prop` alone
// only assembles atoms it is GIVEN; a real gap (e.g. t1_xboole_0 = `x∈(X△Y) ↔ ¬(x∈X ↔ x∈Y)`) has
// no hypothesis supplying the connecting biconditional. Unfold supplies it: for every compound
// membership atom `( t ∈ op(args) )` in the goal/hyps, instantiate the foundation's membership lemma
// for `op` (cun→elun, cin→elin, cdif→eldif, csymdif→elsymdif, csn→elsn, cpr→elpr) at that atom,
// yielding a biconditional FACT (with its one-step proof = the lemma applied). The A-map foundation
// makes these instantiable at compound class terms. The facts join the prop assembly; the result is
// one verified proof, injected directly (no backward search). See [[project_mizar_import]] B-step-2.

export {
	// Membership-lemma instances relevant to `exps`' compound membership atoms (recursively: a
	// fact's RHS may expose further compound atoms). Each pair = (instance formula, its proof tree).
	ruUnfoldFacts(math : RuMath, env : RuEnv, stmtClass : int, exps : [RuExp]) -> [Pair<RuExp, RuProofTree>];

	// Relation-lemma instances: for every `( A = B )` atom in `exps`, the eqss fact
	// `(A = B) ↔ (A ⊆ B ∧ B ⊆ A)` (no quantifier — stays propositional, ⊆ kept as atoms). Lets the
	// equalizer rewrite an equality atom to its subset-antisymmetry form. Used by the checker only.
	ruRelUnfoldFacts(math : RuMath, env : RuEnv, stmtClass : int, exps : [RuExp]) -> [Pair<RuExp, RuProofTree>];

	// CONNECTIVE unfolds (S5): flat n-ary wff connectives (w3o/w3a — df-3or, df-3an) are OPAQUE
	// ATOMS to the propositional layer, so a `(φ∨ψ∨χ)` premise never case-splits. For every
	// subexpression of `exps` headed by a scanned connective, the definition instance
	// `C(φ…) ↔ rhs` (rhs over known connectives only) joins the rewrite facts. Shape-scanned:
	// 0-hyp `⊢ C(distinct wff metavars) ↔ rhs-over-wn/wi/wb/wa/wo(same metavars)`, cached.
	ruConnUnfoldFacts(math : RuMath, env : RuEnv, stmtClass : int, exps : [RuExp]) -> [Pair<RuExp, RuProofTree>];

	// ∀-CLOSED PREDICATE unfolds: a Mizar ATTRIBUTE definition is a ∀-closed bicond
	// (d10_zfmisc_1: ∀X((trivial X) ↔ ∀u∀v¬(...))) — invisible to every bare-bicond scan.
	// For each predicate atom P(t…) of `exps` with ALL-SETVAR args, the instance bicond is
	// mechanical: apply the assertion with the prefix vars substituted by the arg setvars
	// (setvar-for-setvar, always licensed), then strip each ∀ by sp + ax-mp. DV-FREE
	// definitions only (same constraint as the membership unfolds).
	ruPredUnfoldFacts(math : RuMath, env : RuEnv, stmtClass : int, exps : [RuExp]) -> [Pair<RuExp, RuProofTree>];

	// The ∀-closed predicate definitions, exported for the saturation's DIRECT instantiation
	// (the RHS's own binders get candidate setvars via whole-assertion application + sp strips
	// — the substitution chain cannot pass a nested ∀-atom, the albid gap).
	RuPredUnfold(lemmaId : int, prefix : [RuVar], lhs : RuExp, prop : RuExp);
	ruPredRegistry(math : RuMath) -> Tree<int, RuPredUnfold>;
	ruUStripWal(nds : [RuExpNode], pfx : [RuVar], walId : int) -> Pair<[RuVar], [RuExpNode]>;

	// Existential/emptiness unfold: for every quantified atom `∀v¬(v∈X)` in `exps` (matching eq0's
	// RHS), the eq0 fact `(X = ∅) ↔ ∀v¬(v∈X)` — instantiated with the SAME bound var v as the goal
	// uses (eq0's x is a setvar metavar), so the equalizer can rewrite `X=∅` to the goal's own
	// quantified atom. Lets `X≠∅ → ∃x x∈X` style axioms reduce to a propositional contradiction.
	// Returns the eq0 facts AND the disjoint-variable provisos they require (eq0's disjointed(A x)
	// instantiated), which the caller must declare in the assembled proof.
	ruExistUnfoldFacts(math : RuMath, env : RuEnv, stmtClass : int, exps : [RuExp]) -> Pair<[Pair<RuExp, RuProofTree>], Set<RuDisj>>;

	// df-ex unfold: for every `∃v ph` atom in `exps`, the df-ex fact `(∃v ph) ↔ ¬∀v¬ph` (no DV), so
	// the equalizer can rewrite an existential into the `¬∀¬` form eq0 produces from `X=∅`.
	ruDfExUnfoldFacts(math : RuMath, env : RuEnv, stmtClass : int, exps : [RuExp]) -> [Pair<RuExp, RuProofTree>];

	// PRUNE-CANDIDATE (DEAD — no callers): the unfold-assisted prop closer as a tactic — gather unfold
	// facts for hyps ⊢ goal, build the Kalmár skeleton over hyps + facts, splice each fact's hyp-leaf with
	// its proof, install the result. SUPERSEDED by ruEqualizerPropTactic ("Replaces the plain unfold+Kalmár
	// path"), which rewrites compound atoms away first so Kalmár runs on a far smaller residual.
	ruUnfoldPropTactic(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int,
		hyps : [RuExp], goal : RuExp) -> Maybe<RuProverTactic>;

	// (math, env) bundled, to thread through the tactic builder cleanly.
	RuEnvMath(math : RuMath, env : RuEnv);

	// Replace each hyp-leaf at index ≥ `base` with the corresponding proof tree (memoization-free;
	// the input is a tree). Used to splice proven facts (unfold / equality) into a Kalmár skeleton
	// whose extra hyps are those facts.
	ruUnfoldSplice(tree : RuProofTree, base : int, factProofs : [RuProofTree]) -> RuProofTree;

	// The mechanical setness table + prover, exposed for the INSTANTIATION phase (spcv needs `A ∈ _V`).
	ruSetnessRegistry(math : RuMath) -> Tree<int, [RuSetLemma]>;
	RuSetLemma(lemmaId : int, prop : RuExp, term : RuExp, hyps : [RuExp]);
	ruSetnessProof2(reg : Tree<int, [RuSetLemma]>, t : RuExp, stmtClass : int, math : RuMath, env : RuEnv) -> Maybe<RuProofTree>;
	// depth-parameterized form: deep nested witnesses (10-element enum composites)
	// overrun the default 8
	ruSetnessProofDeep(reg : Tree<int, [RuSetLemma]>, t : RuExp, stmtClass : int, math : RuMath, env : RuEnv, depth : int) -> Maybe<RuProofTree>;

	// SETNESS FROM HYPS (the class-loci campaign's A2): a pool of ALREADY-PROVED
	// setness facts — the theorem's own `v ∈ _V` hyps as leaf proofs — consulted
	// as a BASE CASE of the recursive prover. A bare class metavar has no
	// registry lemma (vex is setvar-only); its setness lives ONLY in the pool,
	// and compounds over metavars ({v} ∈ _V) close by snex-recursion INTO it.
	ruSetnessPoolOf(basis : [Pair<RuExp, int>], stmtClass : int) -> Tree<string, RuProofTree>;
	// same pool from facts that already CARRY their proofs (saturation-side callers)
	ruSetnessPoolOfProofs(facts : [Pair<RuProofTree, RuExp>]) -> Tree<string, RuProofTree>;
	ruSetnessProofPool(reg : Tree<int, [RuSetLemma]>, pool : Tree<string, RuProofTree>,
		t : RuExp, stmtClass : int, math : RuMath, env : RuEnv, depth : int) -> Maybe<RuProofTree>;
}

ruSetnessProof2(reg : Tree<int, [RuSetLemma]>, t : RuExp, stmtClass : int, math : RuMath, env : RuEnv) -> Maybe<RuProofTree> {
	ruSetnessProof(reg, makeTree(), t, s2id("wcel"), s2id("cvv"), stmtClass, math, env, 8);
}

ruSetnessProofDeep(reg : Tree<int, [RuSetLemma]>, t : RuExp, stmtClass : int, math : RuMath, env : RuEnv, depth : int) -> Maybe<RuProofTree> {
	ruSetnessProof(reg, makeTree(), t, s2id("wcel"), s2id("cvv"), stmtClass, math, env, depth);
}

ruSetnessProofPool(reg : Tree<int, [RuSetLemma]>, pool : Tree<string, RuProofTree>,
	t : RuExp, stmtClass : int, math : RuMath, env : RuEnv, depth : int) -> Maybe<RuProofTree> {
	ruSetnessProof(reg, pool, t, s2id("wcel"), s2id("cvv"), stmtClass, math, env, depth);
}

ruSetnessPoolOfProofs(facts : [Pair<RuProofTree, RuExp>]) -> Tree<string, RuProofTree> {
	wcelId = s2id("wcel");
	cvvId = s2id("cvv");
	fold(facts, makeTree(), \acc, f -> switch (ruUSetnessHyp(f.second, wcelId, cvvId)) {
		None(): acc;
		Some(term): setTree(acc, ruUKey(term), f.first);
	});
}

// basis facts shaped `T ∈ _V` keyed by T's structural key, as hyp-leaf proofs
ruSetnessPoolOf(basis : [Pair<RuExp, int>], stmtClass : int) -> Tree<string, RuProofTree> {
	wcelId = s2id("wcel");
	cvvId = s2id("cvv");
	fold(basis, makeTree(), \acc, b -> switch (ruUSetnessHyp(b.first, wcelId, cvvId)) {
		None(): acc;
		Some(term): setTree(acc, ruUKey(term),
			RuProofHyp(b.second, RuStmt(stmtClass, [b.first], -1)));
	});
}

// ---- subtree span (flat prefix array, by arity) ----------------------------
ruUSpanEnd(nodes : [RuExpNode], i : int) -> int {
	switch (nodes[i]) {
		RuVar(__, __): i + 1;
		RuRuleNode(__, arityLen): fold(enumFromTo(1, ruArityLen2Arity(arityLen)), i + 1, \pos, __ -> ruUSpanEnd(nodes, pos));
	}
}

ruUNodeId(node : RuExpNode) -> int {
	switch (node) { RuRuleNode(idType, __): ruIdType2Id(idType); RuVar(__, __): -1; }
}

// Structural dedup key for an expression (rule id for rule nodes, var id+type for vars).
ruUKey(e : RuExp) -> string {
	strGlue(map(e.nodes, \n -> switch (n) {
		RuRuleNode(idType, __): "R" + i2s(ruIdType2Id(idType));
		RuVar(id, type):        "V" + i2s(id) + "#" + i2s(type);
	}), ",");
}

// ---- membership-lemma registry --------------------------------------------
// op rule id -> (lemma id, lemma prop exp, lemma membership-LHS pattern exp, setness hyp patterns).
RuMembLemma(lemmaId : int, prop : RuExp, lhs : RuExp, hyps : [RuExp]);

// A SETNESS lemma: `T ∈ _V` for a constructor term T, under setness hypotheses of its own
// (`inex1`: (A∩B) ∈ _V given A ∈ _V). Keyed by T's head constructor (-1 for a bare setvar,
// which is `vex`). Discovered mechanically, exactly like the membership table.
RuSetLemma(lemmaId : int, prop : RuExp, term : RuExp, hyps : [RuExp]);

// Is this hypothesis a setness condition `X ∈ _V`? Returns the X it constrains.
ruUSetnessHyp(h : RuExp, wcelId : int, cvvId : int) -> Maybe<RuExp> {
	n = h.nodes;
	if (length(n) < 3 || ruUNodeId(n[0]) != wcelId) None()
	else {
		objIdx = ruUSpanEnd(n, 1);
		if (objIdx != length(n) - 1 || ruUNodeId(n[objIdx]) != cvvId) None()
		else Some(RuExp(subrange(n, 1, objIdx - 1), -1));
	}
}

// THE SETNESS TABLE, scanned from the index: every assertion `T ∈ _V` whose own hypotheses
// are themselves setness conditions. vex/vsnex/prex/tpex/opex/uniex/pwex/inex1/difexi… all
// register themselves. This is the mechanical replacement for ruFwdSetness's hand-coded id
// list in literal_closers, and it is what lets the unfold use the HYP-CARRYING membership
// biconds (elsn/elpr/eltp/elpw/elop) — i.e. it unlocks {a}, {a,b}, {a,b,c}, 〈a,b〉, 𝒫.
ruSetnessRegistry(math : RuMath) -> Tree<int, [RuSetLemma]> {
	n = sizeTree(math.decls.assertions);
	c = ^ruSetRegCache;
	if (c != [] && c[0].first == n) c[0].second else {
		t = ruSetnessRegistryUncached(math);
		ruSetRegCache := [Pair(n, t)];
		t;
	}
}

ruSetnessRegistryUncached(math : RuMath) -> Tree<int, [RuSetLemma]> {
	wcelId = s2id("wcel");
	cvvId  = s2id("cvv");
	fold(getTreeValues(math.decls.assertions), makeTree(), \acc, ass -> {
		inf = ruMembInfer(ass);
		if (!isEmptySet(inf.vars.disjs)) acc
		else {
			prop = ruExp(inf.prop.exps[0]);
			hyps = map(inf.hyps, \h -> ruExp(h.stmt.exps[0]));
			switch (ruUSetnessHyp(prop, wcelId, cvvId)) {
				None(): acc;
				Some(term): {
					// every hypothesis must itself be a setness condition, else we cannot discharge it
					hypTerms = filtermap(hyps, \h -> ruUSetnessHyp(h, wcelId, cvvId));
					if (length(hypTerms) != length(hyps)) acc
					else {
						headId = ruUNodeId(term.nodes[0]);
						cur = lookupTreeDef(acc, headId, []);
						setTree(acc, headId, arrayPush(cur, RuSetLemma(ruDeclId(ass), prop, term, hyps)));
					}
				}
			}
		}
	});
}

// Prove `t ∈ _V` for a concrete term t, recursively: a POOL fact (the theorem's own
// setness hyps — the only setness source for a bare class metavar) closes directly;
// else match t against a registered setness lemma and discharge that lemma's own
// setness hypotheses the same way. Fuel-bounded (the recursion descends into
// subterms, so the term size bounds it anyway).
ruSetnessProof(reg : Tree<int, [RuSetLemma]>, pool : Tree<string, RuProofTree>,
	t : RuExp, wcelId : int, cvvId : int,
	stmtClass : int, math : RuMath, env : RuEnv, fuel : int) -> Maybe<RuProofTree> {
	if (fuel <= 0) None() else {
		switch (lookupTree(pool, ruUKey(t))) {
			Some(p): Some(p);
			None(): fold(lookupTreeDef(reg, ruUNodeId(t.nodes[0]), []), None(), \acc, sl -> switch (acc) {
				Some(__): acc;
				None(): switch (ruMatchExp(t, sl.term, math, env)) {
					None(): None();
					Some(sub): {
						// the lemma's own prop, instantiated — never hand-build the node array
						goal = ruApplySubst(sl.prop, sub);
						hypProofs = filtermap(sl.hyps, \h -> {
							hi = ruApplySubst(h, sub);
							switch (ruUSetnessHyp(hi, wcelId, cvvId)) {
								None(): None();
								Some(ht): ruSetnessProof(reg, pool, ht, wcelId, cvvId, stmtClass, math, env, fuel - 1);
							}
						});
						if (length(hypProofs) != length(sl.hyps)) None()
						else Some(RuProofStep(sl.lemmaId, hypProofs, RuStmt(stmtClass, [goal], -1)));
					}
				}
			});
		}
	}
}

// MECHANICAL, not hand-listed: scan the assertion index for EVERY membership
// biconditional `( t ∈ C(…) ) ↔ RHS` whose object head C is a constructor, and key it by
// C. The foundation's own definitions ARE the table — elun/elin/eldif/elsymdif/velpw/elxp/
// abid/… all register themselves, and any lemma a later article adds registers too. This
// is the Phase-1 replacement for the six hard-coded pairs: the unfold covers a constructor
// because the foundation defines it, not because someone remembered to add a channel.
//
// Restrictions (each one a KNOWN next step, not a design choice):
//  - HYPOTHESIS-FREE only: the unfold applies a lemma with zero refs, so a lemma carrying a
//    setness hyp (`A ∈ _V` — elsn/elpr/eltp/eluni) would build an invalid 0-ref step. This
//    is exactly why {a}/{a,b}/{a,b,c}/⋃ still need the hand-written channels; discharging
//    those hyps from a mechanical setness table is Phase 1b.
//  - DV-FREE only: an instantiated lemma with disjoint-variable provisos needs those provisos
//    declared in the assembled proof (cf. ruExistUnfoldFacts, which returns them); until the
//    caller threads them through, admitting such a lemma would silently build a rejected proof.
// Several lemmas may share a constructor (𝒫 has velpw and friends), so the registry maps a
// constructor to a LIST and ruUnfoldAtom takes the first whose LHS matches the atom.
// REGISTRY CACHE: both scans walk the whole assertion index (~9800 on miz_set) and are called
// per REWRITE — every hyp of every goal of every theorem. Keyed by the index size, which is
// fixed for the duration of a run.
ruMembRegCache : ref [Pair<int, Tree<int, [RuMembLemma]>>] = ref [];
ruSetRegCache : ref [Pair<int, Tree<int, [RuSetLemma]>>] = ref [];
ruConnRegCache : ref [Pair<int, Tree<int, RuConnLemma>>] = ref [];

RuConnLemma(lemmaId : int, lhs : RuExp, prop : RuExp);

// Non-primitive wff connectives with a propositional definition: 0-hyp `⊢ C(φ…) ↔ rhs`
// where C's args are distinct bare wff metavars and rhs is built ONLY from the known
// connectives (wn/wi/wb/wa/wo) over those metavars. Catches df-3or/df-3an by shape.
ruConnRegistry(math : RuMath) -> Tree<int, RuConnLemma> {
	n = sizeTree(math.decls.assertions);
	c = ^ruConnRegCache;
	if (c != [] && c[0].first == n) c[0].second else {
		wbId = s2id("wb");
		known = buildSet([s2id("wn"), s2id("wi"), s2id("wb"), s2id("wa"), s2id("wo")]);
		wffT = tp2id_("wff");
		t = fold(getTreeValues(math.decls.assertions), makeTree(), \acc, ass -> {
			inf = switch (ass) {
				RuAxiom(__, i): i; RuCong(__, i): i; RuTheorem(__, i, __, __): i; RuDef(__, i, __, __): i;
			};
			if (length(inf.hyps) != 0) acc else {
				prop = ruExp(inf.prop.exps[0]);
				pn = prop.nodes;
				headOk = pn != [] && ruUNodeId(pn[0]) == wbId;
				if (!headOk) acc else {
					lhsEnd = ruUSpanEnd(pn, 1);
					lhs = RuExp(subrange(pn, 1, lhsEnd - 1), -1);
					rhs = RuExp(subrange(pn, lhsEnd, length(pn) - lhsEnd), -1);
					cId = ruUNodeId(lhs.nodes[0]);
					argIds = fold(tail(lhs.nodes), [], \vs, nd -> switch (nd) {
						RuVar(id, tp): if (tp == wffT) arrayPush(vs, id) else vs;
						RuRuleNode(__, __): vs;
					});
					lhsOk = length(lhs.nodes) >= 2 && cId >= 0 && !containsSet(known, cId)
						&& length(argIds) == length(lhs.nodes) - 1
						&& sizeSet(buildSet(argIds)) == length(argIds)
						&& (switch (lhs.nodes[0]) { RuRuleNode(__, __): true; RuVar(__, __): false; });
					rhsOk = forall(rhs.nodes, \nd -> switch (nd) {
						RuRuleNode(idT, __): containsSet(known, ruIdType2Id(idT));
						RuVar(id, tp): tp == wffT && contains(argIds, id);
					});
					if (lhsOk && rhsOk && !containsKeyTree(acc, cId)) setTree(acc, cId, RuConnLemma(
						switch (ass) { RuAxiom(i, __): i.id; RuCong(i, __): i.id; RuTheorem(i, __, __, __): i.id; RuDef(i, __, __, __): i.id; },
						lhs, prop)) else acc;
				}
			}
		});
		ruConnRegCache := [Pair(n, t)];
		t;
	}
}

ruPredRegCache : ref [Pair<int, Tree<int, RuPredUnfold>>] = ref [];

ruPredRegistry(math : RuMath) -> Tree<int, RuPredUnfold> {
	n = sizeTree(math.decls.assertions);
	c = ^ruPredRegCache;
	if (c != [] && c[0].first == n) c[0].second else {
		wbId = s2id("wb");
		walId = s2id("wal");
		nonPred = buildSet([s2id("wn"), s2id("wi"), s2id("wb"), s2id("wa"), s2id("wo"),
			s2id("wal"), s2id("wex"), s2id("wceq"), s2id("wcel"), s2id("wss")]);
		t = fold(getTreeValues(math.decls.assertions), makeTree(), \acc, ass -> {
			inf = switch (ass) {
				RuAxiom(__, i): i; RuCong(__, i): i; RuTheorem(__, i, __, __): i; RuDef(__, i, __, __): i;
			};
			if (length(inf.hyps) != 0 || !isEmptySet(inf.vars.disjs)) acc else {
				prop = ruExp(inf.prop.exps[0]);
				st = ruUStripWal(prop.nodes, [], walId);
				prefix = st.first;
				core = RuExp(st.second, -1);
				if (prefix == [] || core.nodes == [] || ruUNodeId(core.nodes[0]) != wbId) acc else {
					lhsEnd = ruUSpanEnd(core.nodes, 1);
					lhs = RuExp(subrange(core.nodes, 1, lhsEnd - 1), -1);
					hd = ruUNodeId(lhs.nodes[0]);
					// lhs = predicate atom over EXACTLY the coerced prefix vars, in order-free set
					argIds = filtermap(enumFromTo(0, length(lhs.nodes) - 1), \i -> switch (lhs.nodes[i]) {
						RuVar(id, __): Some(id); RuRuleNode(__, __): None();
					});
					prefIds = map(prefix, \v -> v.id);
					lhsOk = hd >= 0 && !containsSet(nonPred, hd)
						&& (switch (lhs.nodes[0]) { RuRuleNode(__, __): true; RuVar(__, __): false; })
						&& length(argIds) > 0
						&& sizeSet(buildSet(argIds)) == length(argIds)
						&& forall(argIds, \id -> contains(prefIds, id))
						&& forall(prefIds, \id -> contains(argIds, id));
					if (lhsOk && !containsKeyTree(acc, hd)) setTree(acc, hd, RuPredUnfold(
						switch (ass) { RuAxiom(i, __): i.id; RuCong(i, __): i.id; RuTheorem(i, __, __, __): i.id; RuDef(i, __, __, __): i.id; },
						prefix, lhs, prop)) else acc;
				}
			}
		});
		ruPredRegCache := [Pair(n, t)];
		t;
	}
}

ruPredUnfoldFacts(math : RuMath, env : RuEnv, stmtClass : int, exps : [RuExp]) -> [Pair<RuExp, RuProofTree>] {
	reg = ruPredRegistry(math);
	if (isEmptyTree(reg)) [] else {
		collect = \e : RuExp -> {
			nn = e.nodes;
			filtermap(enumFromTo(0, length(nn) - 1), \i -> switch (nn[i]) {
				RuVar(__, __): None();
				RuRuleNode(idT, __):
					if (!containsKeyTree(reg, ruIdType2Id(idT))) None()
					else Some(RuExp(subrange(nn, i, ruUSpanEnd(nn, i) - i), -1));
			});
		};
		subs = concatA(map(exps, collect));
		(fold(subs, Pair([], makeSet()), \acc : Pair<[Pair<RuExp, RuProofTree>], Set<string>>, s -> {
			key = ruUKey(s);
			if (containsSet(acc.second, key)) acc else {
				seen = insertSet(acc.second, key);
				switch (lookupTree(reg, ruUNodeId(s.nodes[0]))) {
					None(): Pair(acc.first, seen);
					Some(pu): {
						// all args must be coerced setvars — the substitution is then
						// setvar-for-setvar (always licensed) and sp strips each ∀ level
						args = ruUArgsOf(s);
						argVars = filtermap(args, \a ->
							if (length(a.nodes) == 2) switch (a.nodes[1]) { RuVar(id, tp): Some(RuVar(id, tp)); RuRuleNode(__, __): None(); }
							else None());
						if (length(argVars) != length(pu.prefix) || length(args) != length(argVars)) Pair(acc.first, seen)
						else switch (ruMatchExp(s, pu.lhs, math, env)) {
							None(): Pair(acc.first, seen);
							Some(sub): {
								instFull = ruApplySubst(pu.prop, sub);   // ∀t…(P(t…) ↔ RHS[t…])
								pf0 = RuProofStep(pu.lemmaId, [], RuStmt(stmtClass, [instFull], -1));
								// strip each ∀ with sp + ax-mp
								res = fold(enumFromTo(1, length(pu.prefix)), Pair(instFull, pf0), \ac2, __ -> {
									cur = ac2.first;
									bodyEnd = ruUSpanEnd(cur.nodes, 1);   // skip the binder var
									body = RuExp(subrange(cur.nodes, bodyEnd, length(cur.nodes) - bodyEnd), -1);
									spInst = RuProofStep(s2id_("sp"), [],
										RuStmt(stmtClass, [ruUMkImp(cur, body, stmtClass)], -1));
									Pair(body, RuProofStep(s2id_("ax-mp"), [ac2.second, spInst], RuStmt(stmtClass, [body], -1)));
								});
								Pair(arrayPush(acc.first, Pair(res.first, res.second)), seen);
							}
						}
					}
				}
			}
		})).first;
	}
}

// strip a ∀-prefix whose binders are plain setvars: ([binder vars], remaining body nodes)
ruUStripWal(nds : [RuExpNode], pfx : [RuVar], walId : int) -> Pair<[RuVar], [RuExpNode]> {
	if (length(nds) < 2) Pair(pfx, nds)
	else switch (nds[0]) {
		RuRuleNode(idT, __): if (ruIdType2Id(idT) != walId) Pair(pfx, nds)
			else switch (nds[1]) {
				RuVar(id, tp): ruUStripWal(subrange(nds, 2, length(nds) - 2), arrayPush(pfx, RuVar(id, tp)), walId);
				RuRuleNode(__, __): Pair(pfx, nds);
			}
		RuVar(__, __): Pair(pfx, nds);
	}
}

ruUArgsOf(e : RuExp) -> [RuExp] {
	nodes = e.nodes;
	arity = switch (nodes[0]) { RuRuleNode(__, al): ruArityLen2Arity(al); RuVar(__, __): 0; };
	(fold(enumFromTo(1, arity), Pair(1, []), \acc : Pair<int, [RuExp]>, __ -> {
		end = ruUSpanEnd(nodes, acc.first);
		Pair(end, arrayPush(acc.second, RuExp(subrange(nodes, acc.first, end - acc.first), -1)));
	})).second;
}

ruUMkImp(a : RuExp, b : RuExp, stmtClass : int) -> RuExp {
	RuExp(concat([ruMakeRuleNode(s2id("wi"), tp2id_("wff"), 2, length(a.nodes) + length(b.nodes))],
		concat(a.nodes, b.nodes)), -1);
}

ruConnUnfoldFacts(math : RuMath, env : RuEnv, stmtClass : int, exps : [RuExp]) -> [Pair<RuExp, RuProofTree>] {
	reg = ruConnRegistry(math);
	if (isEmptyTree(reg)) [] else {
		collect = \e : RuExp -> {
			nn = e.nodes;
			filtermap(enumFromTo(0, length(nn) - 1), \i -> switch (nn[i]) {
				RuVar(__, __): None();
				RuRuleNode(idT, __):
					if (!containsKeyTree(reg, ruIdType2Id(idT))) None()
					else Some(RuExp(subrange(nn, i, ruUSpanEnd(nn, i) - i), -1));
			});
		};
		subs = concatA(map(exps, collect));
		(fold(subs, Pair([], makeSet()), \acc : Pair<[Pair<RuExp, RuProofTree>], Set<string>>, s -> {
			key = ruUKey(s);
			if (containsSet(acc.second, key)) acc else {
				seen = insertSet(acc.second, key);
				switch (lookupTree(reg, ruUNodeId(s.nodes[0]))) {
					None(): Pair(acc.first, seen);
					Some(cl): switch (ruMatchExp(s, cl.lhs, math, env)) {
						None(): Pair(acc.first, seen);
						Some(sub): {
							inst = ruApplySubst(cl.prop, sub);
							Pair(arrayPush(acc.first, Pair(inst,
								RuProofStep(cl.lemmaId, [], RuStmt(stmtClass, [inst], -1)))), seen);
						}
					}
				}
			}
		})).first;
	}
}

ruMembRegistry(math : RuMath) -> Tree<int, [RuMembLemma]> {
	n = sizeTree(math.decls.assertions);
	c = ^ruMembRegCache;
	if (c != [] && c[0].first == n) c[0].second else {
		t = ruMembRegistryUncached(math);
		ruMembRegCache := [Pair(n, t)];
		t;
	}
}

ruMembRegistryUncached(math : RuMath) -> Tree<int, [RuMembLemma]> {
	wcelId = s2id("wcel");
	wbId   = s2id("wb");
	cvvId  = s2id("cvv");
	fold(getTreeValues(math.decls.assertions), makeTree(), \acc, ass -> {
		inf = ruMembInfer(ass);
		hypExps = map(inf.hyps, \h -> ruExp(h.stmt.exps[0]));
		// SETNESS-conditioned lemmas are admitted (elsn/elpr/eltp/elpw/elop): their hyps are
		// discharged by the setness prover at instantiation time. Any OTHER hypothesis shape
		// we cannot discharge, so the lemma is not a usable rewrite rule.
		setnessOnly = length(filtermap(hypExps, \h -> ruUSetnessHyp(h, wcelId, cvvId))) == length(hypExps);
		if (!setnessOnly || !isEmptySet(inf.vars.disjs)) acc
		else {
			prop = ruExp(inf.prop.exps[0]);
			nodes = prop.nodes;
			if (length(nodes) < 4 || ruUNodeId(nodes[0]) != wbId) acc
			else {
				lhs = ruUChild0(prop);                       // the bicond's left side
				ln  = lhs.nodes;
				if (length(ln) < 3 || ruUNodeId(ln[0]) != wcelId) acc
				else {
					objIdx = ruUSpanEnd(ln, 1);              // the membership's OBJECT
					if (objIdx >= length(ln)) acc
					else {
						opId = ruUNodeId(ln[objIdx]);
						// a bare-variable object (`t ∈ A`) is not a constructor — nothing to unfold
						if (opId < 0) acc
						else {
							id = ruDeclId(ass);
							cur = lookupTreeDef(acc, opId, []);
							setTree(acc, opId, arrayPush(cur, RuMembLemma(id, prop, lhs, hypExps)));
						}
					}
				}
			}
		}
	});
}

ruDeclId(ass : RuAssertion) -> int {
	switch (ass) {
		RuAxiom(info, __): info.id; RuCong(info, __): info.id;
		RuTheorem(info, __, __, __): info.id; RuDef(info, __, __, __): info.id;
	}
}

ruMembInfer(ass : RuAssertion) -> RuInference {
	switch (ass) {
		RuAxiom(__, inf): inf; RuCong(__, inf): inf;
		RuTheorem(__, inf, __, __): inf; RuDef(__, inf, __, __): inf;
	}
}

// First child subtree of a binary-rooted RuExp (the root is at 0, its first child at 1).
ruUChild0(e : RuExp) -> RuExp {
	nodes = e.nodes;
	end = ruUSpanEnd(nodes, 1);
	RuExp(subrange(nodes, 1, end - 1), -1);
}

// ---- collect compound membership atoms -------------------------------------
// Every `( t ∈ S )` subtree whose object S's head rule is a registered set operation.
ruUMembAtoms(exp : RuExp, wcelId : int, ops : Set<int>) -> [RuExp] {
	nodes = exp.nodes;
	filtermap(enumFromTo(0, length(nodes) - 1), \i ->
		if (ruUNodeId(nodes[i]) != wcelId) None()
		else {
			end  = ruUSpanEnd(nodes, i);
			aEnd = ruUSpanEnd(nodes, i + 1);          // end of the element argument
			if (aEnd >= end) None()                    // malformed: no object argument
			else if (!containsSet(ops, ruUNodeId(nodes[aEnd]))) None()
			else Some(RuExp(subrange(nodes, i, end - i), -1));
		}
	);
}

// ---- unfold ----------------------------------------------------------------
ruUnfoldFacts(math : RuMath, env : RuEnv, stmtClass : int, exps : [RuExp]) -> [Pair<RuExp, RuProofTree>] {
	registry = ruMembRegistry(math);
	setReg   = ruSetnessRegistry(math);
	wcelId   = s2id("wcel");
	ops      = buildSet(getTreeKeys(registry));
	// Iterate to a fixpoint: a fact's RHS may expose further compound membership atoms.
	ruUnfoldLoop(math, env, stmtClass, registry, setReg, wcelId, ops, exps, makeTree(), 6);
}

ruUnfoldLoop(
	math : RuMath, env : RuEnv, stmtClass : int, registry : Tree<int, [RuMembLemma]>,
	setReg : Tree<int, [RuSetLemma]>,
	wcelId : int, ops : Set<int>, frontier : [RuExp], seen : Tree<string, Pair<RuExp, RuProofTree>>, fuel : int
) -> [Pair<RuExp, RuProofTree>] {
	atoms = concatA(map(frontier, \e -> ruUMembAtoms(e, wcelId, ops)));
	newFacts = filtermap(atoms, \atom -> {
		key = ruUKey(atom);
		if (containsKeyTree(seen, key)) None()
		else ruUnfoldAtom(registry, setReg, wcelId, stmtClass, atom, math, env);
	});
	if (newFacts == [] || fuel <= 0) getTreeValues(seen)
	else {
		seen1 = fold(newFacts, seen, \acc, f -> setTree(acc, ruUKey(ruUnfoldAtomOf(f)), f));
		// scan the new facts' instance formulas for further compound atoms.
		ruUnfoldLoop(math, env, stmtClass, registry, setReg, wcelId, ops, map(newFacts, \f -> f.first), seen1, fuel - 1);
	}
}

// The membership atom a fact unfolds (= child 0 of its biconditional instance), used as the dedup key.
ruUnfoldAtomOf(f : Pair<RuExp, RuProofTree>) -> RuExp { ruUChild0(f.first); }

// One atom -> its lemma instance + proof, or None if the lemma does not match.
ruUnfoldAtom(registry : Tree<int, [RuMembLemma]>, setReg : Tree<int, [RuSetLemma]>, wcelId : int,
	stmtClass : int, atom : RuExp, math : RuMath, env : RuEnv) -> Maybe<Pair<RuExp, RuProofTree>> {
	cvvId = s2id("cvv");
	opId = ruUNodeId(atom.nodes[ruUSpanEnd(atom.nodes, 1)]);   // object's head rule
	// A constructor may have several membership lemmas (the general (B ∖ C) alongside the
	// specialized (B ∖ {C}), or elsn/elsn2 which differ only in WHICH side must be a set);
	// take the first whose LHS matches this atom AND whose setness hyps we can discharge.
	fold(lookupTreeDef(registry, opId, []), None(), \acc, ml -> switch (acc) {
		Some(__): acc;
		None(): switch (ruMatchExp(atom, ml.lhs, math, env)) {
			None(): None();
			Some(sub): {
				hypProofs = filtermap(ml.hyps, \h -> {
					hi = ruApplySubst(h, sub);
					switch (ruUSetnessHyp(hi, wcelId, cvvId)) {
						None(): None();
						Some(ht): ruSetnessProof(setReg, makeTree(), ht, wcelId, cvvId, stmtClass, math, env, 8);
					}
				});
				if (length(hypProofs) != length(ml.hyps)) None()
				else {
					inst  = ruApplySubst(ml.prop, sub);
					proof = RuProofStep(ml.lemmaId, hypProofs, RuStmt(stmtClass, [inst], -1));
					Some(Pair(inst, proof));
				}
			}
		}
	});
}

// ---- splice facts into the Kalmár skeleton ---------------------------------
// The skeleton treats facts as hyp leaves at indices [base, base+|facts|). Replace each such
// RuProofHyp with the fact's own proof tree; real-hyp leaves (idx < base) are kept.
ruUnfoldSplice(tree : RuProofTree, base : int, factProofs : [RuProofTree]) -> RuProofTree {
	switch (tree) {
		RuProofHyp(idx, __): if (idx >= base && idx - base < length(factProofs)) factProofs[idx - base] else tree;
		RuProofStep(ass, children, stmt): RuProofStep(ass, map(children, \c -> ruUnfoldSplice(c, base, factProofs)), stmt);
	}
}

ruUnfoldPropTactic(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int, hyps : [RuExp], goal : RuExp) -> Maybe<RuProverTactic> {
	facts    = ruUnfoldFacts(em.math, em.env, stmtClass, arrayPush(hyps, goal));
	factExps = map(facts, \f -> f.first);
	switch (ruKalmarSkeleton(conn, wff, stmtClass, concat(hyps, factExps), goal)) {
		Some(tree): switch (tree) {
			RuProofStep(__, __, __): {
				spliced = ruUnfoldSplice(tree, length(hyps), map(facts, \f -> f.second));
				Some(ruInstallProofTactic(RuProof(ruEmptyVarsDisjs, ruMakeLinearProof(spliced), -1)));
			}
			RuProofHyp(__, __): None();   // goal is itself a hypothesis
		}
		None(): None();
	}
}

// ---- relation unfold (= via eqss) ------------------------------------------
// Every subtree whose ROOT rule is `rootId` (e.g. wceq), as candidate relation atoms.
ruURootAtoms(exp : RuExp, rootId : int) -> [RuExp] {
	nodes = exp.nodes;
	filtermap(enumFromTo(0, length(nodes) - 1), \i ->
		if (ruUNodeId(nodes[i]) != rootId) None()
		else Some(RuExp(subrange(nodes, i, ruUSpanEnd(nodes, i) - i), -1)));
}

ruRelUnfoldFacts(math : RuMath, env : RuEnv, stmtClass : int, exps : [RuExp]) -> [Pair<RuExp, RuProofTree>] {
	wceqId = s2id("wceq");
	switch (lookupTree(math.decls.assertions, s2id_("eqss"))) {
		None(): [];
		Some(ass): {
			prop = ruExp(ruMembInfer(ass).prop.exps[0]);   // wb( (A=B), (A⊆B ∧ B⊆A) )
			lhs  = ruUChild0(prop);                         // (A=B)
			atoms = concatA(map(exps, \e -> ruURootAtoms(e, wceqId)));
			seen = ref makeSet();
			filtermap(atoms, \atom -> {
				key = ruUKey(atom);
				if (containsSet(^seen, key)) None()
				else {
					seen := insertSet(^seen, key);
					switch (ruMatchExp(atom, lhs, math, env)) {
						None(): None();
						Some(sub): {
							inst = ruApplySubst(prop, sub);
							Some(Pair(inst, RuProofStep(s2id_("eqss"), [], RuStmt(stmtClass, [inst], -1))));
						}
					}
				}
			});
		}
	}
}

// Second child subtree of a binary-rooted RuExp (root at 0, child0 at 1, child1 after child0).
ruUChild1(e : RuExp) -> RuExp {
	nodes = e.nodes;
	s0 = ruUSpanEnd(nodes, 1);          // end of child0
	end = ruUSpanEnd(nodes, s0);
	RuExp(subrange(nodes, s0, end - s0), -1);
}

ruExistUnfoldFacts(math : RuMath, env : RuEnv, stmtClass : int, exps : [RuExp]) -> Pair<[Pair<RuExp, RuProofTree>], Set<RuDisj>> {
	walId = s2id("wal");
	switch (lookupTree(math.decls.assertions, s2id_("eq0"))) {
		None(): Pair([], makeSet());
		Some(ass): {
			inf  = ruMembInfer(ass);
			prop = ruExp(inf.prop.exps[0]);                 // wb( (A=∅), ∀x¬(x∈A) )
			rhs  = ruUChild1(prop);                         // ∀x¬(x∈A)
			atoms = concatA(map(exps, \e -> ruURootAtoms(e, walId)));
			seen = ref makeSet();
			disjs = ref makeSet();
			facts = filtermap(atoms, \q -> {
				key = ruUKey(q);
				if (containsSet(^seen, key)) None()
				else {
					seen := insertSet(^seen, key);
					switch (ruMatchExp(q, rhs, math, env)) {   // binds A and x:=goal's bound var
						None(): None();
						Some(sub): {
							inst = ruApplySubst(prop, sub);    // (X=∅) ↔ ∀v¬(v∈X)  (v = goal's bound var)
							// eq0's disjointed(A x), instantiated, must be declared by the caller.
							switch (ruComputeDisjs(sub, inf.vars.disjs, RuDisjsInherent(makeSet()))) {
								RuDisjsInherent(ds): disjs := mergeSets(^disjs, ds);
								RuDisjViolation(__, __): {};
							}
							Some(Pair(inst, RuProofStep(s2id_("eq0"), [], RuStmt(stmtClass, [inst], -1))));
						}
					}
				}
			});
			Pair(facts, ^disjs);
		}
	}
}

// Build a binary-rooted expression `rule(a, b)` (prefix; len = total child node count).
ruUMkBin(rule : int, wff : int, a : RuExp, b : RuExp) -> RuExp {
	args = concat(a.nodes, b.nodes);
	RuExp(concat([ruMakeRuleNode(rule, wff, 2, length(args))], args), -1);
}

ruDfExUnfoldFacts(math : RuMath, env : RuEnv, stmtClass : int, exps : [RuExp]) -> [Pair<RuExp, RuProofTree>] {
	wexId = s2id("wex"); wbId = s2id("wb"); wff = tp2id_("wff");
	switch (lookupTree(math.decls.assertions, s2id_("df-ex"))) {
		None(): [];
		Some(ass): switch (ass) {
			RuDef(__, __, defm, defs): {
				defmE = ruExp(defm);   // ∃x ph
				defsE = ruExp(defs);   // ¬∀x¬ph
				atoms = concatA(map(exps, \e -> ruURootAtoms(e, wexId)));
				seen = ref makeSet();
				filtermap(atoms, \q -> {
					key = ruUKey(q);
					if (containsSet(^seen, key)) None()
					else {
						seen := insertSet(^seen, key);
						switch (ruMatchExp(q, defmE, math, env)) {   // binds x:=goal's bound var, ph:=body
							None(): None();
							Some(sub): {
								inst = ruUMkBin(wbId, wff, ruApplySubst(defmE, sub), ruApplySubst(defsE, sub));
								Some(Pair(inst, RuProofStep(s2id_("df-ex"), [], RuStmt(stmtClass, [inst], -1))));
							}
						}
					}
				});
			}
			default: [];
		}
	}
}
