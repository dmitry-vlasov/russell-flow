import ru/prover/tactics/equalizer_plan;
import ru/prover/tactics/unfold;
import ru/prover/tactics/instantiate;
import ru/prover/tactics/hilbert;
import ru/prover/tactics/kalmar;

// THE EXTENSIONALITY BUILDER — proofs for the Equalizer's elem-eq facts.
//
// An elem-eq (a = b) is justified by coinciding element sets. The proof, v1
// (composite–composite: both sides characterized by SOURCE-A membership biconds —
// the elun/elpr/elsn family; the means-def k-term route comes separately):
//
//   for a FRESH setvar x, emit as FACTS the membership-bicond instances
//     (x ∈ T) ↔ rhs(T)   for a, b and every mem-arg subterm,
//   with setness hypotheses discharged by the mechanical setness prover; then the
//   COMPLETE propositional certificate proves (x∈a ↔ x∈b) from those facts (the
//   composition/⋁-permutation happens propositionally — no orbi chains built by
//   hand), and eqriv (hyp (x∈A ↔ x∈B) ⊢ A=B, DV(A,x)+DV(B,x)) closes a = b.
//
// Returns the proof tree + the DV provisos the enclosing proof must declare
// (eqriv's instantiated DVs + whatever the certificate introduced).

export {
	ruEqzElemEqProof(math : RuMath, env : RuEnv, stmtClass : int,
		a : RuExp, b : RuExp) -> Maybe<Pair<RuProofTree, Set<RuDisj>>>;
}

ruEqzElemEqProof(math : RuMath, env : RuEnv, stmtClass : int,
	a : RuExp, b : RuExp) -> Maybe<Pair<RuProofTree, Set<RuDisj>>> {
	switch (ruEqzElemEqComposite(math, env, stmtClass, a, b)) {
		Some(r): Some(r);
		None(): ruEqzWitnessRoute(math, env, stmtClass, a, b);
	}
}

// THE WITNESS ROUTE: when a side is a k-term (or both are), mediate through a CANONICAL
// COMPOSITE with the same elements — W = {e1} ∪ ({e2} ∪ …) — which is source-A by
// construction: prove a = W and b = W (composite route, or the means-def route against
// W), then join a = W, W = b by eqtri.
ruEqzWitnessRoute(math : RuMath, env : RuEnv, stmtClass : int,
	a : RuExp, b : RuExp) -> Maybe<Pair<RuProofTree, Set<RuDisj>>> {
	wffT = tp2id_("wff");
	rules = ruEqzElemRulesAll(math, env);
	ea = ruEqzElemsList(rules, a, Some([]));
	eb = ruEqzElemsList(rules, b, Some([]));
	if (env.conf.verbose > 3) {
		env.out.println("      kdbg: witnessRoute a=" + ru2s(a, math) + " ea=" + b2s(isSome(ea)) + " eb=" + b2s(isSome(eb)));
	} else {};
	switch (ea) {
		None(): None();
		Some(la): switch (eb) {
			None(): None();
			Some(lb): {
				// the witness needs TEXTUALLY identical element sets (closure-equal-only
				// element pairs would need transport — not built)
				if (set2array(buildSet(la)) != set2array(buildSet(lb)) || la == []) { if (env.conf.verbose > 3) env.out.println("      kdbg: elem sets differ") else {}; None(); }
				else switch (ruEqzWitness(math, env, rules, la)) {
					None(): None();
					Some(w): {
						paM = ruEqzProveToW(math, env, stmtClass, a, w);
						pbM = ruEqzProveToW(math, env, stmtClass, b, w);
						if (env.conf.verbose > 3) {
							env.out.println("      kdbg: witness pa=" + b2s(isSome(paM))
								+ " pb=" + b2s(isSome(pbM)) + " W=" + ru2s(w, math));
						} else {};
						switch (paM) {
							None(): None();
							Some(pa): switch (pbM) {
								None(): None();
								Some(pb): {
									wb2 = RuStmt(stmtClass, [ruFwdMkRule(s2id("wceq"), wffT, [w, b])], -1);
									concl = RuStmt(stmtClass, [ruFwdMkRule(s2id("wceq"), wffT, [a, b])], -1);
									Some(Pair(
										RuProofStep(s2id("eqtri"), [pa.first,
											RuProofStep(s2id("eqcomi"), [pb.first], wb2)], concl),
										mergeSets(pa.second, pb.second)));
								}
							}
						}
					}
				}
			}
		}
	}
}

// t = W: identity, the composite route, or the means-def route (W is always source-A)
ruEqzProveToW(math : RuMath, env : RuEnv, stmtClass : int,
	t : RuExp, w : RuExp) -> Maybe<Pair<RuProofTree, Set<RuDisj>>> {
	wffT = tp2id_("wff");
	if (t.nodes == w.nodes)
		Some(Pair(RuProofStep(s2id("eqid"), [],
			RuStmt(stmtClass, [ruFwdMkRule(s2id("wceq"), wffT, [t, w])], -1)), makeSet()))
	else switch (ruEqzElemEqComposite(math, env, stmtClass, t, w)) {
		Some(r): Some(r);
		None(): switch (ruEqzKTermEq(math, env, stmtClass, w, t)) {
			Some(pk): {
				concl = RuStmt(stmtClass, [ruFwdMkRule(s2id("wceq"), wffT, [t, w])], -1);
				Some(Pair(RuProofStep(s2id("eqcomi"), [pk.first], concl), pk.second));
			}
			None(): {
				// MIXED term: k-subterms INSIDE a composite (k7(…) ∪ {x}) — rewrite each
				// k-subterm to its own witness by congruence lifting, then the all-source-A
				// term goes through the composite route; join by eqtri
				rw = ruEqzRewriteK(math, env, stmtClass, t);
				switch (rw.second) {
					None(): None();
					Some(pr): switch (ruEqzProveToW(math, env, stmtClass, rw.first, w)) {
						None(): None();
						Some(pw): {
							concl = RuStmt(stmtClass, [ruFwdMkRule(s2id("wceq"), wffT, [t, w])], -1);
							Some(Pair(RuProofStep(s2id("eqtri"), [pr.first, pw.first], concl),
								mergeSets(pr.second, pw.second)));
						}
					}
				}
			}
		}
	}
}

// Rewrite every k-subterm of t to its witness: (t', Some(⊢ t = t', DVs)) when something
// changed; (t, None()) otherwise. Source-A nodes recurse into mem-args and lift changed
// children through the scanned congruence rules (hyp- or implication-form).
ruEqzRewriteK(math : RuMath, env : RuEnv, stmtClass : int,
	t : RuExp) -> Pair<RuExp, Maybe<Pair<RuProofTree, Set<RuDisj>>>> {
	wffT = tp2id_("wff");
	classT = tp2id_("class");
	st = \e : RuExp -> RuStmt(stmtClass, [e], -1);
	unchanged = Pair(t, None());
	rules = ruEqzElemRulesAll(math, env);
	switch (find(lookupTreeDef(rules, ruInHead(t), []), \rl -> rl.arity == ruInArity(t))) {
		None(): unchanged;
		Some(rl): {
			isDef = switch (lookupTree(math.decls.assertions, rl.assId)) {
				None(): false;
				Some(ass): {
					inf = switch (ass) {
						RuAxiom(__, i): i; RuCong(__, i): i;
						RuTheorem(__, i, __, __): i; RuDef(__, i, __, __): i;
					};
					inf.prop.exps != [] && ruInHead(ruExp(inf.prop.exps[0])) == s2id("wal");
				}
			}
			if (isDef) {
				// a k-term: its witness + the def route
				switch (ruEqzElemsList(rules, t, Some([]))) {
					None(): unchanged;
					Some(els): switch (ruEqzWitness(math, env, rules, els)) {
						None(): unchanged;
						Some(wt): if (wt.nodes == t.nodes) unchanged
						else switch (ruEqzKTermEq(math, env, stmtClass, wt, t)) {
							None(): unchanged;
							Some(pk): Pair(wt, Some(Pair(
								RuProofStep(s2id("eqcomi"), [pk.first],
									st(ruFwdMkRule(s2id("wceq"), wffT, [t, wt]))),
								pk.second)));
						}
					}
				}
			} else {
				// source-A: rewrite mem-arg children, lift left to right
				args = ruInArgs(t);
				congs = ruCongRulesCached(math);
				res = fold(rl.memArgs, Pair(Pair(t, args), None()),
					\acc : Pair<Pair<RuExp, [RuExp]>, Maybe<Pair<RuProofTree, Set<RuDisj>>>>, j -> {
						cur = acc.first.first;
						curArgs = acc.first.second;
						cw = ruEqzRewriteK(math, env, stmtClass, curArgs[j]);
						switch (cw.second) {
							None(): acc;
							Some(cp): {
								newArgs = replace(curArgs, j, cw.first);
								nxt = ruFwdMkRule(ruInHead(t), classT, newArgs);
								switch (find(lookupTreeDef(congs, ruInHead(t), []),
										\cr -> cr.argPos == j)) {
									None(): acc;   // no congruence rule for this position — keep old
									Some(cr): {
										eqExp = ruFwdMkRule(s2id("wceq"), wffT, [cur, nxt]);
										stepP = if (cr.hypForm)
											RuProofStep(cr.lemmaId, [cp.first], st(eqExp))
										else {
											childEq = ruFwdMkRule(s2id("wceq"), wffT, [curArgs[j], cw.first]);
											imp = ruFwdMkRule(s2id("wi"), wffT, [childEq, eqExp]);
											RuProofStep(s2id("ax-mp"),
												[cp.first, RuProofStep(cr.lemmaId, [], st(imp))], st(eqExp));
										}
										joined = switch (acc.second) {
											None(): Pair(stepP, cp.second);
											Some(prev): Pair(
												RuProofStep(s2id("eqtri"), [prev.first, stepP],
													st(ruFwdMkRule(s2id("wceq"), wffT, [t, nxt]))),
												mergeSets(prev.second, cp.second));
										}
										Pair(Pair(nxt, newArgs), Some(joined));
									}
								}
							}
						}
					});
				Pair(res.first.first, res.second);
			}
		}
	}
}

// the TEXTUAL element list of t (first-occurrence order, deduped); None = no reading
ruEqzElemsList(rules : Tree<int, [RuEqzElemRule]>, t : RuExp,
	accM : Maybe<[[RuExpNode]]>) -> Maybe<[[RuExpNode]]> {
	switch (accM) {
		None(): None();
		Some(acc): switch (find(lookupTreeDef(rules, ruInHead(t), []),
				\rl -> rl.arity == ruInArity(t))) {
			None(): None();
			Some(rl): {
				args = ruInArgs(t);
				acc1 = fold(rl.eqArgs, acc, \a2, i ->
					if (contains(a2, (args[i]).nodes)) a2 else arrayPush(a2, (args[i]).nodes));
				fold(rl.memArgs, Some(acc1), \a2, j -> ruEqzElemsList(rules, args[j], a2));
			}
		}
	}
}

// W = {e1} ∪ ({e2} ∪ …): the singleton/union constructors identified by their ELEM-RULE
// SHAPE (arity-1 eqArgs=[0] / arity-2 memArgs=[0,1]) — never by name
ruEqzWitness(math : RuMath, env : RuEnv, rules : Tree<int, [RuEqzElemRule]>,
	els : [[RuExpNode]]) -> Maybe<RuExp> {
	classT = tp2id_("class");
	snId = foldTree(rules, -1, \cid, rls, acc ->
		if (acc >= 0) acc
		else if (exists(rls, \r -> r.arity == 1 && r.eqArgs == [0] && r.memArgs == [])) cid else acc);
	unId = foldTree(rules, -1, \cid, rls, acc ->
		if (acc >= 0) acc
		else if (exists(rls, \r -> r.arity == 2 && r.eqArgs == [] && length(r.memArgs) == 2)) cid else acc);
	if (snId < 0 || unId < 0) None()
	else {
		sn = \e : [RuExpNode] -> ruFwdMkRule(snId, classT, [RuExp(e, -1)]);
		Some(fold(reverseA(take(els, length(els) - 1)), sn(els[length(els) - 1]), \acc, e ->
			ruFwdMkRule(unId, classT, [sn(e), acc])));
	}
}

// v1: both sides characterized by SOURCE-A membership biconds
ruEqzElemEqComposite(math : RuMath, env : RuEnv, stmtClass : int,
	a : RuExp, b : RuExp) -> Maybe<Pair<RuProofTree, Set<RuDisj>>> {
	coId = ruEqzCoercionId(math, env);
	wffT = tp2id_("wff");
	// the fresh setvar: a name no translated article uses; type/coercion node harvested
	// from the sides' own coerced occurrences
	usedIds = fold(concat(a.nodes, b.nodes), makeSet(), \acc, n -> switch (n) {
		RuVar(id, __): insertSet(acc, id);
		RuRuleNode(__, __): acc;
	});
	tpAndCo = ruEqzXTemplate(concat(a.nodes, b.nodes), coId);
	switch (tpAndCo) {
		None(): None();
		Some(tc): {
			xId = ruEqzFreshName(usedIds, 0);
			xVar = RuVar(xId, tc.first);
			xExp = RuExp([tc.second, xVar], -1);
			// FOLDED bicond facts for both sides (raw per-subterm facts made the
			// certificate wander; folded, the atom world is memberships + eq-atoms only)
			factsM = switch (ruEqzCharBicond(math, env, stmtClass, coId, xExp, a)) {
				None(): None();
				Some(ca): switch (ruEqzCharBicond(math, env, stmtClass, coId, xExp, b)) {
					None(): None();
					Some(cb2): Some([Pair(ca.first, ca.second), Pair(cb2.first, cb2.second)]);
				}
			}
			switch (factsM) {
				None(): { if (env.conf.verbose > 3) env.out.println("      kdbg: composite fold failed") else {}; None(); }
				Some(fpair): {
					// DETERMINISTIC join: (m_a ↔ D_a), (D_a ↔ D_b) by ∨-reassociation,
					// (D_b ↔ m_b) by bicomi — bitri chain; no propositional search at all
					fA = fpair[0]; fB = fpair[1];
					dA = (ruInArgs(fA.first))[1];
					dB = (ruInArgs(fB.first))[1];
					mA = (ruInArgs(fA.first))[0];
					mB = (ruInArgs(fB.first))[0];
					st = \e : RuExp -> RuStmt(stmtClass, [e], -1);
					wb3 = \x : RuExp, y : RuExp -> ruFwdMkRule(s2id("wb"), wffT, [x, y]);
					switch (ruEqzOrACI(stmtClass, wffT, dA, dB)) {
						None(): { if (env.conf.verbose > 3) {
							env.out.println("      kdbg: or-assoc failed dA=" + ru2s(dA, math) + " dB=" + ru2s(dB, math));
						} else {}; None(); }
						Some(oa): {
							t1 = RuProofStep(s2id("bitri"), [fA.second, oa], st(wb3(mA, dB)));
							bc = RuProofStep(s2id("bicomi"), [fB.second], st(wb3(dB, mB)));
							g = RuProofStep(s2id("bitri"), [t1, bc], st(wb3(mA, mB)));
							concl = RuStmt(stmtClass, [ruFwdMkRule(s2id("wceq"), wffT, [a, b])], -1);
							dvs = fold(set2array(fold(concat(a.nodes, b.nodes), makeSet(), \acc, n ->
								switch (n) {
									RuVar(id, tp): insertSet(acc, RuVar(id, tp));
									RuRuleNode(__, __): acc;
								})), makeSet(), \acc, v -> insertSet(acc, RuDisj(v, xVar)));
							Some(Pair(
								RuProofStep(s2id("eqriv"), [g], concl),
								dvs));
						}
					}
				}
			}
		}
	}
}

// find the setvar type + a coercion rule node to clone, from any coerced occurrence
ruEqzXTemplate(nodes : [RuExpNode], coId : int) -> Maybe<Pair<int, RuExpNode>> {
	fold(enumFromTo(0, length(nodes) - 2), None(), \acc : Maybe<Pair<int, RuExpNode>>, i ->
		if (isSome(acc)) acc
		else if (ruEqzIsCoercionAt(nodes, i, coId)) {
			switch (nodes[i + 1]) {
				RuVar(__, tp): Some(Pair(tp, nodes[i]));
				RuRuleNode(__, __): acc;
			}
		} else acc);
}

ruEqzFreshName(used : Set<int>, i : int) -> int {
	id = s2id("xqz" + i2s(i));
	if (containsSet(used, id)) ruEqzFreshName(used, i + 1) else id;
}

// Emit the membership-bicond FACT instances for term t and (recursively) its mem-arg
// subterms: each fact = (instance bicond expression, its proof — the source-A lemma
// applied 0-ref-style with setness hyps discharged). None = a term in the chain has no
// DV-free source-A characterization (k-terms decline here; their route is the means-def).
ruEqzCharFacts(math : RuMath, env : RuEnv, stmtClass : int, coId : int, xExp : RuExp,
	t : RuExp, accM : Maybe<[Pair<RuExp, RuProofTree>]>) -> Maybe<[Pair<RuExp, RuProofTree>]> {
	switch (accM) {
		None(): None();
		Some(acc): {
			h = ruInHead(t);
			ar = ruInArity(t);
			rules = ruEqzElemRulesAll(math, env);
			switch (find(lookupTreeDef(rules, h, []), \rl -> rl.arity == ar)) {
				None(): None();
				Some(rl): {
					switch (ruEqzCharFact(math, env, stmtClass, coId, xExp, t, rl)) {
						None(): None();
						Some(fact): {
							args = ruInArgs(t);
							fold(rl.memArgs, Some(arrayPush(acc, fact)), \a2, j ->
								ruEqzCharFacts(math, env, stmtClass, coId, xExp, args[j], a2));
						}
					}
				}
			}
		}
	}
}

ruEqzCharFact(math : RuMath, env : RuEnv, stmtClass : int, coId : int, xExp : RuExp,
	t : RuExp, rl : RuEqzElemRule) -> Maybe<Pair<RuExp, RuProofTree>> {
	switch (lookupTree(math.decls.assertions, rl.assId)) {
		None(): None();
		Some(ass): {
			inf = switch (ass) {
				RuAxiom(__, i): i; RuCong(__, i): i;
				RuTheorem(__, i, __, __): i; RuDef(__, i, __, __): i;
			};
			if (inf.prop.exps == [] || !isEmptySet(inf.vars.disjs)) None()
			else {
				prop = ruEqzStripAlls(ruExp(inf.prop.exps[0]));
				// SOURCE A only: bicond headed by a membership lhs (means-defs decline)
				if (ruInHead(prop) != s2id("wb")) None()
				else {
					lhs = (ruInArgs(prop))[0];
					if (ruInHead(lhs) != s2id("wcel")) None()
					else {
						lemVars = fold(prop.nodes, makeSet(), \acc, n -> switch (n) {
							RuVar(id, __): insertSet(acc, id);
							RuRuleNode(__, __): acc;
						});
						atom = ruFwdMkRule(s2id("wcel"), tp2id_("wff"), [xExp, t]);
						switch (ruEqzMatch(atom.nodes, lhs.nodes, lemVars, coId)) {
							None(): None();
							Some(bind): switch (ruEqzApply(prop.nodes, bind, coId)) {
								None(): None();
								Some(instNodes): {
									inst = RuExp(instNodes, -1);
									// discharge the setness hyps (`T ∈ _V`) mechanically
									reg = ruSetnessRegistry(math);
									hypProofs = fold(inf.hyps, Some([]), \hacc : Maybe<[RuProofTree]>, hyp ->
										maybeBind(hacc, \harr -> {
											if (hyp.stmt.exps == []) None() else
											switch (ruEqzApply((ruExp(hyp.stmt.exps[0])).nodes, bind, coId)) {
												None(): None();
												Some(hn): {
													he = RuExp(hn, -1);
													if (ruInHead(he) != s2id("wcel")) None()
													else {
														term = (ruInArgs(he))[0];
														maybeMap(ruSetnessProof2(reg, term, stmtClass, math, env),
															\p -> arrayPush(harr, p));
													}
												}
											}
										}));
									maybeMap(hypProofs, \hp -> Pair(inst,
										RuProofStep(rl.assId, hp, RuStmt(stmtClass, [inst], -1))));
								}
							}
						}
					}
				}
			}
		}
	}
}


// The FOLDED characterization bicond (x∈t ↔ D) with D a pure right-nested eq-atom
// disjunction: singleton/pr/tp lemmas give it directly; union composes children by
// orbi12i + bitri. Shrinks the k-body certificate to the def's own 5-atom world.
ruEqzCharBicond(math : RuMath, env : RuEnv, stmtClass : int, coId : int, xExp : RuExp,
	t : RuExp) -> Maybe<Triple<RuExp, RuProofTree, RuExp>> {
	wffT = tp2id_("wff");
	rules = ruEqzElemRulesAll(math, env);
	switch (find(lookupTreeDef(rules, ruInHead(t), []), \rl -> rl.arity == ruInArity(t))) {
		None(): None();
		Some(rl): switch (ruEqzCharFact(math, env, stmtClass, coId, xExp, t, rl)) {
			None(): None();
			Some(fact): {
				instArgs = ruInArgs(fact.first);
				if (rl.memArgs == []) Some(Triple(fact.first, fact.second, instArgs[1]))
				else if (rl.eqArgs == [] && length(rl.memArgs) == 2) {
					args = ruInArgs(t);
					switch (ruEqzCharBicond(math, env, stmtClass, coId, xExp, args[rl.memArgs[0]])) {
						None(): None();
						Some(c1): switch (ruEqzCharBicond(math, env, stmtClass, coId, xExp, args[rl.memArgs[1]])) {
							None(): None();
							Some(c2): {
								m1 = (ruInArgs(c1.first))[0];
								m2 = (ruInArgs(c2.first))[0];
								dd = ruFwdMkRule(s2id("wo"), wffT, [c1.third, c2.third]);
								orbConcl = ruFwdMkRule(s2id("wb"), wffT,
									[ruFwdMkRule(s2id("wo"), wffT, [m1, m2]), dd]);
								orb = RuProofStep(s2id("orbi12i"), [c1.second, c2.second],
									RuStmt(stmtClass, [orbConcl], -1));
								bitConcl = ruFwdMkRule(s2id("wb"), wffT, [instArgs[0], dd]);
								Some(Triple(bitConcl,
									RuProofStep(s2id("bitri"), [fact.second, orb],
										RuStmt(stmtClass, [bitConcl], -1)),
									dd));
							}
						}
					}
				} else None();
			}
		}
	}
}

// ---- the k-term route (source-B means-definitions) ---------------------------

// A proof of (comp = k) from k's means-definition. comp must be SOURCE-A
// characterizable; k's head rule must come from a hyp-free DV-free ∀-closed def.
ruEqzKTermEq(math : RuMath, env : RuEnv, stmtClass : int,
	comp : RuExp, k : RuExp) -> Maybe<Pair<RuProofTree, Set<RuDisj>>> {
	coId = ruEqzCoercionId(math, env);
	wffT = tp2id_("wff");
	rules = ruEqzElemRulesAll(math, env);
	switch (find(lookupTreeDef(rules, ruInHead(k), []), \rl -> rl.arity == ruInArity(k))) {
		None(): { if (env.conf.verbose > 3) env.out.println("      kdbg: no k rule") else {}; None(); };
		Some(rl): switch (lookupTree(math.decls.assertions, rl.assId)) {
			None(): None();
			Some(ass): {
				inf = switch (ass) {
					RuAxiom(__, i): i; RuCong(__, i): i;
					RuTheorem(__, i, __, __): i; RuDef(__, i, __, __): i;
				};
				if (inf.hyps != [] || inf.prop.exps == [] || !isEmptySet(inf.vars.disjs)) { if (env.conf.verbose > 3) env.out.println("      kdbg: def hyps/disjs") else {}; None(); }
				else {
					prop0 = ruExp(inf.prop.exps[0]);
					// a real means-DEFINITION is ∀-closed — bare bicond lemmas (elun) are
					// source-A material, not defs, and must not enter the chain
					if (ruInHead(prop0) != s2id("wal")) None() else {
					matrix = ruEqzStripAlls(prop0);
					// the matrix must be source-B shaped: (xd = k(loci-vars)) ↔ …
					if (ruInHead(matrix) != s2id("wb")) None()
					else {
						sides = ruInArgs((ruInArgs(matrix))[0]);
						if (length(sides) != 2) None()
						else {
							// which equality side is the k-pattern; bind its loci to k's args
							kPat = if (ruInHead(sides[1]) == ruInHead(k)) sides[1] else sides[0];
							defVars = fold(prop0.nodes, makeSet(), \acc, n -> switch (n) {
								RuVar(id, __): insertSet(acc, id);
								RuRuleNode(__, __): acc;
							});
							switch (ruEqzMatch(k.nodes, kPat.nodes, defVars, coId)) {
								None(): { if (env.conf.verbose > 3) env.out.println("      kdbg: k pattern no match") else {}; None(); };
								Some(bind): {
									if (env.conf.verbose > 3) env.out.println("      kdbg: kTermEq def=" + id2s(rl.assId)) else {};
									// SIMULTANEOUS loci renaming (uniform, capture-free — the
									// one-at-a-time chain captured on permuted args: x3:=x4
									// under a pending ∀x4), then the strip chain is identity-only
									xdSide = if (kPat.nodes == sides[1].nodes) sides[0] else sides[1];
									xdId = ruEqzPlainVar(xdSide.nodes, coId);
									bareBind = foldTree(bind, makeTree(), \v, sl, acc ->
										if (length(sl) == 2 && ruEqzIsCoercionAt(sl, 0, coId))
											setTree(acc, v, [sl[1]])
										else setTree(acc, v, sl));
									switch (ruEqzApply(prop0.nodes, bareBind, coId)) {
										None(): None();
										Some(instN): {
											inst0 = RuExp(instN, -1);
											ruEqzKChain(math, env, stmtClass, coId, wffT, comp, k,
												inst0,
												RuProofStep(rl.assId, [], RuStmt(stmtClass, [inst0], -1)),
												xdId, makeSet());
										}
									}
								}
							}
						}
					}
					}
				}
			}
		}
	}
}

// strip the def's ∀-prefix by instantiation: each binder either maps through `bind`
// (a locus — at a setvar or a class slice) or is the definiendum xd (→ comp)
ruEqzKChain(math : RuMath, env : RuEnv, stmtClass : int, coId : int, wffT : int,
	comp : RuExp, k : RuExp, f : RuExp, fp : RuProofTree,
	xdId : int, dvs : Set<RuDisj>) -> Maybe<Pair<RuProofTree, Set<RuDisj>>> {
	if (env.conf.verbose > 3) {
		env.out.println("      kdbg: kChain |f|=" + i2s(length(f.nodes)));
	} else {};
	if (ruInHead(f) == s2id("wal") && ruInArity(f) == 2) {
		xb = ruEqzVarAt(((ruInArgs(f))[0]).nodes, 0);
		if (xb < 0) None()
		else {
			// IDENTITY instantiation (the def's locus name equals the theorem's var —
			// the articles reuse x2,x3,… on both sides) is just sp: ∀xφ → φ
			spAt = \ -> {
				body = (ruInArgs(f))[1];
				imp = ruFwdMkRule(s2id("wi"), wffT, [f, body]);
				Some(Triple(body, RuProofStep(s2id("sp"), [], RuStmt(stmtClass, [imp], -1)),
					makeSet()));
			}
			instM = if (xb == xdId) ruInForallInstTerm(math, env, stmtClass, f, comp)
				else spAt();
			switch (instM) {
				None(): { if (env.conf.verbose > 3) env.out.println("      kdbg: forall inst failed") else {}; None(); };
				Some(tr): {
					fp1 = RuProofStep(s2id("ax-mp"), [fp, tr.second],
						RuStmt(stmtClass, [tr.first], -1));
					ruEqzKChain(math, env, stmtClass, coId, wffT, comp, k, tr.first, fp1,
						xdId, mergeSets(dvs, tr.third));
				}
			}
		}
	} else if (ruInHead(f) == s2id("wb") && ruInArity(f) == 2) {
		fargs = ruInArgs(f);
		want = ruFwdMkRule(s2id("wceq"), wffT, [comp, k]);
		if ((fargs[0]).nodes != want.nodes) { if (env.conf.verbose > 3) env.out.println("      kdbg: lhs mismatch after chain") else {}; None(); }
		else {
			rhs = fargs[1];
			if (ruInHead(rhs) != s2id("wal") || ruInArity(rhs) != 2) None()
			else {
				rargs = ruInArgs(rhs);
				x1 = ruEqzVarAt((rargs[0]).nodes, 0);
				if (x1 < 0 || exists(ruInVarsOf(comp), \u -> u.id == x1)) None()
				else {
					body = rargs[1];
					xTpl = ruEqzXTemplate(comp.nodes, coId);
					switch (xTpl) {
						None(): None();
						Some(tc): {
							xExp = RuExp([tc.second, RuVar(x1, tc.first)], -1);
							switch (ruEqzCharBicond(math, env, stmtClass, coId, xExp, comp)) {
								None(): { if (env.conf.verbose > 3) env.out.println("      kdbg: charFacts(comp) failed") else {}; None(); };
								Some(cb): {
									facts = [Pair(cb.first, cb.second)];
									em = RuEnvMath(math, env);
									// align the fact's D with the DEF's D (the body's N dualized):
									// duplicate loci / order differences are ACI-equal
									fact1 = ruEqzAlignFact(stmtClass, wffT, cb.first, cb.second, body);
									switch (switch (ruEqzNnfBridge(stmtClass, wffT, fact1.second, fact1.first, body)) {
										Some(bp): Some(Pair(bp, RuVarsDisjs(makeTree(), makeSet())));
										None(): ruEqzBodyCert(em, wffT, stmtClass,
											map(facts, \ff -> ff.first), body);
									}) {
										None(): {
											if (env.conf.verbose > 3) {
												env.out.println("      kdbg: k-body certificate failed");
												bodyAtoms = getTreeKeys(ruPAtomNodes(ruPConnectives(), body));
												factAtoms = getTreeKeys(ruPAtomNodes(ruPConnectives(), cb.first));
												env.out.println("        body atoms: " + strGlue(map(bodyAtoms, \k2 -> strLeft(k2, 30)), " | "));
												env.out.println("        fact atoms: " + strGlue(map(factAtoms, \k2 -> strLeft(k2, 30)), " | "));
												env.out.println("        body: " + ru2s(body, math));
												iter(facts, \ff -> env.out.println("        fact: " + ru2s(ff.first, math)));
												eqi = fold(enumFromTo(0, length(body.nodes) - 1), -1, \ai, ii ->
													switch (body.nodes[ii]) {
														RuVar(vid, __): if (vid == 280) ii else ai;
														RuRuleNode(__, __): ai;
													});
												feq = (ruInArgs(facts[1].first))[1];
												env.out.println("        fact-eq-raw: " + toString(feq.nodes));
												hasSl = exists(enumFromTo(0, length(body.nodes) - length(feq.nodes)),
													\ii -> subrange(body.nodes, ii, length(feq.nodes)) == feq.nodes);
												env.out.println("        body has fact-eq slice: " + b2s(hasSl));
												bmem = (ruInArgs(facts[0].first))[0];
												hasM = exists(enumFromTo(0, length(body.nodes) - length(bmem.nodes)),
													\ii -> subrange(body.nodes, ii, length(bmem.nodes)) == bmem.nodes);
												env.out.println("        body has W-membership slice: " + b2s(hasM));
												if (length(facts) > 1) env.out.println("        factraw: " + strLeft(toString((facts[1].first).nodes), 300)) else {};
											} else {};
											None();
										};
										Some(cert): {
											spliced = ruUnfoldSplice(cert.first, 0, map(facts, \ff -> ff.second));
											rhsProof = RuProofStep(s2id("ax-gen"), [spliced],
												RuStmt(stmtClass, [rhs], -1));
											concl = RuStmt(stmtClass, [want], -1);
											Some(Pair(
												RuProofStep(s2id("mpbir"), [rhsProof, fp], concl),
												mergeSets(dvs, cert.second.disjs)));
										}
									}
								}
							}
						}
					}
				}
			}
		}
	} else None();
}


// The def-body certificate with a WIDER SPLIT BUDGET: the emitter's defaults (depth 6 /
// 400 global) are tuned for checker residuals and starve the 5-atom full case analysis
// the means-def body needs (hSplit hit budget=1 with 5 undecided). Same machinery,
// deeper allowance, own 8s wall.
ruEqzBodyCert(em : RuEnvMath, wffT : int, stmtClass : int,
	hyps : [RuExp], goal : RuExp) -> Maybe<Pair<RuProofTree, RuVarsDisjs>> {
	conn = ruPConnectives();
	atomNodes = fold(hyps, ruPAtomNodes(conn, goal), \acc, h -> mergeTree(acc, ruPAtomNodes(conn, h)));
	ctx = RuHCtx(ruHCtx(em, wffT, stmtClass, atomNodes) with timer = ruMakeLimitedTimer(8000.0));
	ctx.splitBudget := 16;
	ctx.globalSplits := 100000;
	maybeMap(ruHilbertProve(ctx, map(hyps, \h -> ruPAtomize(conn, h)), ruPAtomize(conn, goal)),
		\tree -> Pair(tree, RuVarsDisjs(
			fold(^(ctx.freshVars), makeTree(), \acc, v -> setTree(acc, v.id, v)), ^(ctx.disjs))));
}


// ---- the NNF bridge ----------------------------------------------------------
// The translator emits every means-def body in ONE fixed shape:
//   body = ¬(m ∧ N) ∧ (N ∨ m),   N = ¬e1 ∧ (¬e2 ∧ …)   (the De Morgan dual of D).
// Given ⊢ (m ↔ D) with D = e1 ∨ (e2 ∨ …), the body follows DETERMINISTICALLY:
//   ¬(m∧N): biimpi → (m→D); iman+mpbi → ¬(m∧¬D); (¬D↔N) De-Morgan-chained
//           (ioran+anbi2i+bitri per disjunct, biid at the leaf) → bicomi+anbi2i
//           → ((m∧N)↔(m∧¬D)); mtbir → ¬(m∧N).
//   (N∨m):  biimpri → (D→m); imor+mpbi → (¬D∨m); orbi1i(¬D↔N)+mpbi → (N∨m).
//   pm3.2i joins. No search anywhere — shape mismatch = None (the cert fallback).
ruEqzNnfBridge(stmtClass : int, wffT : int, factProof : RuProofTree, factExp : RuExp,
	body : RuExp) -> Maybe<RuProofTree> {
	wn = \e : RuExp -> ruFwdMkRule(s2id("wn"), wffT, [e]);
	wa = \x : RuExp, y : RuExp -> ruFwdMkRule(s2id("wa"), wffT, [x, y]);
	wo = \x : RuExp, y : RuExp -> ruFwdMkRule(s2id("wo"), wffT, [x, y]);
	wb2 = \x : RuExp, y : RuExp -> ruFwdMkRule(s2id("wb"), wffT, [x, y]);
	wi2 = \x : RuExp, y : RuExp -> ruFwdMkRule(s2id("wi"), wffT, [x, y]);
	st = \e : RuExp -> RuStmt(stmtClass, [e], -1);
	if (ruInHead(factExp) != s2id("wb") || ruInHead(body) != s2id("wa")) None()
	else {
		fa = ruInArgs(factExp);
		m = fa[0]; d = fa[1];
		ba = ruInArgs(body);
		c1 = ba[0]; c2 = ba[1];
		okShape = ruInHead(c1) == s2id("wn") && ruInHead(c2) == s2id("wo")
			&& { i1 = (ruInArgs(c1))[0]; ruInHead(i1) == s2id("wa")
				&& ((ruInArgs(i1))[0]).nodes == m.nodes
				&& ((ruInArgs(c2))[1]).nodes == m.nodes
				&& ((ruInArgs(i1))[1]).nodes == ((ruInArgs(c2))[0]).nodes; };
		if (!okShape) None()
		else {
			n = (ruInArgs(c2))[0];
			switch (ruEqzDeMorgan(stmtClass, wffT, d, n)) {
				None(): None();
				Some(dm): {   // dm : ⊢ (¬D ↔ N)
					// C1 = ¬(m ∧ N)
					b1 = RuProofStep(s2id("biimpi"), [factProof], st(wi2(m, d)));
					b2i = RuProofStep(s2id("iman"), [], st(wb2(wi2(m, d), wn(wa(m, wn(d))))));
					b2 = RuProofStep(s2id("mpbi"), [b1, b2i], st(wn(wa(m, wn(d)))));
					dmc = RuProofStep(s2id("bicomi"), [dm], st(wb2(n, wn(d))));
					b3 = RuProofStep(s2id("anbi2i"), [dmc], st(wb2(wa(m, n), wa(m, wn(d)))));
					pc1 = RuProofStep(s2id("mtbir"), [b2, b3], st(wn(wa(m, n))));
					// C2 = (N ∨ m)
					q1 = RuProofStep(s2id("biimpri"), [factProof], st(wi2(d, m)));
					q2i = RuProofStep(s2id("imor"), [], st(wb2(wi2(d, m), wo(wn(d), m))));
					q2 = RuProofStep(s2id("mpbi"), [q1, q2i], st(wo(wn(d), m)));
					q3 = RuProofStep(s2id("orbi1i"), [dm], st(wb2(wo(wn(d), m), wo(n, m))));
					pc2 = RuProofStep(s2id("mpbi"), [q2, q3], st(wo(n, m)));
					Some(RuProofStep(s2id("pm3.2i"), [pc1, pc2], st(body)));
				}
			}
		}
	}
}

// ⊢ (¬D ↔ N) for D = e ∨ R vs N = ¬e ∧ N_R (right-nested; leaf: N = ¬D → biid)
ruEqzDeMorgan(stmtClass : int, wffT : int, d : RuExp, n : RuExp) -> Maybe<RuProofTree> {
	wn = \e : RuExp -> ruFwdMkRule(s2id("wn"), wffT, [e]);
	wa = \x : RuExp, y : RuExp -> ruFwdMkRule(s2id("wa"), wffT, [x, y]);
	wb2 = \x : RuExp, y : RuExp -> ruFwdMkRule(s2id("wb"), wffT, [x, y]);
	st = \e : RuExp -> RuStmt(stmtClass, [e], -1);
	if (ruInHead(d) == s2id("wo") && ruInHead(n) == s2id("wa")) {
		da = ruInArgs(d);
		na = ruInArgs(n);
		if ((na[0]).nodes != (wn(da[0])).nodes) None()
		else switch (ruEqzDeMorgan(stmtClass, wffT, da[1], na[1])) {
			None(): None();
			Some(dmR): {
				ior = RuProofStep(s2id("ioran"), [],
					st(wb2(wn(d), wa(wn(da[0]), wn(da[1])))));
				an = RuProofStep(s2id("anbi2i"), [dmR],
					st(wb2(wa(wn(da[0]), wn(da[1])), wa(wn(da[0]), na[1]))));
				Some(RuProofStep(s2id("bitri"), [ior, an], st(wb2(wn(d), n))));
			}
		}
	} else if (n.nodes == (wn(d)).nodes)
		Some(RuProofStep(s2id("biid"), [], st(wb2(wn(d), wn(d)))))
	else None();
}


// ⊢ (d1 ↔ d2) for the SAME flat ∨-sequence under different association (d2 the
// right-nested canon): biid at equality, orbi2i under a shared head, orass to rotate
// a left-nested head right. Termination: left depth strictly decreases.
ruEqzOrAssoc(stmtClass : int, wffT : int, d1 : RuExp, d2 : RuExp) -> Maybe<RuProofTree> {
	wo = \x : RuExp, y : RuExp -> ruFwdMkRule(s2id("wo"), wffT, [x, y]);
	wb2 = \x : RuExp, y : RuExp -> ruFwdMkRule(s2id("wb"), wffT, [x, y]);
	st = \e : RuExp -> RuStmt(stmtClass, [e], -1);
	if (d1.nodes == d2.nodes)
		Some(RuProofStep(s2id("biid"), [], st(wb2(d1, d2))))
	else if (ruInHead(d1) != s2id("wo") || ruInHead(d2) != s2id("wo")) None()
	else {
		a1 = ruInArgs(d1);
		a2 = ruInArgs(d2);
		if ((a1[0]).nodes == (a2[0]).nodes) {
			// same head element: recurse on the tails under orbi2i
			switch (ruEqzOrAssoc(stmtClass, wffT, a1[1], a2[1])) {
				None(): None();
				Some(r): Some(RuProofStep(s2id("orbi2i"), [r], st(wb2(d1, d2))));
			}
		} else if (ruInHead(a1[0]) == s2id("wo")) {
			// left-nested head: ((A∨B)∨C) ↔ (A∨(B∨C)), then recurse
			ha = ruInArgs(a1[0]);
			rot = wo(ha[0], wo(ha[1], a1[1]));
			or1 = RuProofStep(s2id("orass"), [], st(wb2(d1, rot)));
			switch (ruEqzOrAssoc(stmtClass, wffT, rot, d2)) {
				None(): None();
				Some(r): Some(RuProofStep(s2id("bitri"), [or1, r], st(wb2(d1, d2))));
			}
		} else None();
	}
}


// ---- ∨-ACI normalization (proof-producing) -----------------------------------

// ⊢ (d1 ↔ d2) whenever the two ∨-chains have the SAME FLAT ATOM SET (association,
// order and duplicates may differ): normalize both to the sorted-deduped right-nested
// canon with proofs, join by bitri + bicomi. None when the sets differ.
ruEqzOrACI(stmtClass : int, wffT : int, d1 : RuExp, d2 : RuExp) -> Maybe<RuProofTree> {
	n1 = ruEqzOrNorm(stmtClass, wffT, d1);
	n2 = ruEqzOrNorm(stmtClass, wffT, d2);
	if ((n1.first).nodes != (n2.first).nodes) None()
	else {
		wb2 = ruFwdMkRule(s2id("wb"), wffT, [d1, d2]);
		bc = RuProofStep(s2id("bicomi"), [n2.second],
			RuStmt(stmtClass, [ruFwdMkRule(s2id("wb"), wffT, [n2.first, d2])], -1));
		Some(RuProofStep(s2id("bitri"), [n1.second, bc], RuStmt(stmtClass, [wb2], -1)));
	}
}

// (canon, ⊢ d ↔ canon): canon = sorted (by node-key), deduped, right-nested
ruEqzOrNorm(stmtClass : int, wffT : int, d : RuExp) -> Pair<RuExp, RuProofTree> {
	wb2 = \x : RuExp, y : RuExp -> ruFwdMkRule(s2id("wb"), wffT, [x, y]);
	st = \e : RuExp -> RuStmt(stmtClass, [e], -1);
	if (ruInHead(d) != s2id("wo"))
		Pair(d, RuProofStep(s2id("biid"), [], st(wb2(d, d))))
	else {
		da = ruInArgs(d);
		e = da[0];
		if (ruInHead(e) == s2id("wo")) {
			// LEFT-nested head: rotate right first — ((A∨B)∨C) ↔ (A∨(B∨C)) — then normalize
			ha = ruInArgs(e);
			rot = ruFwdMkRule(s2id("wo"), wffT, [ha[0],
				ruFwdMkRule(s2id("wo"), wffT, [ha[1], da[1]])]);
			pr = RuProofStep(s2id("orass"), [], st(wb2(d, rot)));
			nr = ruEqzOrNorm(stmtClass, wffT, rot);
			Pair(nr.first, RuProofStep(s2id("bitri"), [pr, nr.second], st(wb2(d, nr.first))));
		} else {
			nR = ruEqzOrNorm(stmtClass, wffT, da[1]);
			p1 = RuProofStep(s2id("orbi2i"), [nR.second],
				st(wb2(d, ruFwdMkRule(s2id("wo"), wffT, [e, nR.first]))));
			ins = ruEqzOrInsert(stmtClass, wffT, e, nR.first);
			Pair(ins.first, RuProofStep(s2id("bitri"), [p1, ins.second],
				st(wb2(d, ins.first))));
		}
	}
}

// insert atom e into canonical C: (result, ⊢ (e ∨ C) ↔ result)
ruEqzOrInsert(stmtClass : int, wffT : int, e : RuExp, c : RuExp) -> Pair<RuExp, RuProofTree> {
	wo = \x : RuExp, y : RuExp -> ruFwdMkRule(s2id("wo"), wffT, [x, y]);
	wb2 = \x : RuExp, y : RuExp -> ruFwdMkRule(s2id("wb"), wffT, [x, y]);
	st = \ex : RuExp -> RuStmt(stmtClass, [ex], -1);
	key = \ex : RuExp -> strGlue(map(ex.nodes, \n -> switch (n) {
		RuRuleNode(idT, __): "R" + i2s(ruIdType2Id(idT));
		RuVar(id, __): "V" + i2s(id);
	}), ",");
	if (ruInHead(c) != s2id("wo")) {
		if (e.nodes == c.nodes)
			Pair(c, RuProofStep(s2id("oridm"), [], st(wb2(wo(e, e), e))))
		else if (key(e) < key(c))
			Pair(wo(e, c), RuProofStep(s2id("biid"), [], st(wb2(wo(e, c), wo(e, c)))))
		else
			Pair(wo(c, e), RuProofStep(s2id("orcom"), [], st(wb2(wo(e, c), wo(c, e)))));
	} else {
		ca = ruInArgs(c);
		h = ca[0];
		if (e.nodes == h.nodes) {
			// (e∨(e∨C')) ↔ ((e∨e)∨C') ↔ (e∨C') = C
			r1 = RuProofStep(s2id("bicomi"),
				[RuProofStep(s2id("orass"), [], st(wb2(wo(wo(e, e), ca[1]), wo(e, wo(e, ca[1])))))],
				st(wb2(wo(e, c), wo(wo(e, e), ca[1]))));
			r2 = RuProofStep(s2id("orbi1i"),
				[RuProofStep(s2id("oridm"), [], st(wb2(wo(e, e), e)))],
				st(wb2(wo(wo(e, e), ca[1]), c)));
			Pair(c, RuProofStep(s2id("bitri"), [r1, r2], st(wb2(wo(e, c), c))));
		} else if (key(e) < key(h))
			Pair(wo(e, c), RuProofStep(s2id("biid"), [], st(wb2(wo(e, c), wo(e, c)))))
		else {
			// (e∨(h∨C')) ↔ (h∨(e∨C')) [or12], then insert into C' under orbi2i
			ins = ruEqzOrInsert(stmtClass, wffT, e, ca[1]);
			p12 = RuProofStep(s2id("or12"), [],
				st(wb2(wo(e, c), wo(h, wo(e, ca[1])))));
			pIn = RuProofStep(s2id("orbi2i"), [ins.second],
				st(wb2(wo(h, wo(e, ca[1])), wo(h, ins.first))));
			Pair(wo(h, ins.first), RuProofStep(s2id("bitri"), [p12, pIn],
				st(wb2(wo(e, c), wo(h, ins.first)))));
		}
	}
}

// Rewrite the folded fact (m ↔ D_W) into (m ↔ D_def), where D_def is the dual of the
// body's ¬-chain N — identity when they already agree; unchanged if ACI can't join.
ruEqzAlignFact(stmtClass : int, wffT : int, factExp : RuExp, factProof : RuProofTree,
	body : RuExp) -> Pair<RuExp, RuProofTree> {
	same = Pair(factExp, factProof);
	if (ruInHead(body) != s2id("wa")) same
	else {
		c2 = (ruInArgs(body))[1];
		if (ruInHead(c2) != s2id("wo")) same
		else {
			n = (ruInArgs(c2))[0];
			dDef = ruEqzOrDual(wffT, n);
			fa = ruInArgs(factExp);
			if (dDef.nodes == (fa[1]).nodes) same
			else switch (ruEqzOrACI(stmtClass, wffT, fa[1], dDef)) {
				None(): same;
				Some(aci): {
					ne = ruFwdMkRule(s2id("wb"), wffT, [fa[0], dDef]);
					Pair(ne, RuProofStep(s2id("bitri"), [factProof, aci],
						RuStmt(stmtClass, [ne], -1)));
				}
			}
		}
	}
}

// the ∨-dual of a ¬-conjunction chain: ¬e ∧ N' → e ∨ dual(N'); leaf ¬e → e
ruEqzOrDual(wffT : int, n : RuExp) -> RuExp {
	if (ruInHead(n) == s2id("wa") && ruInArity(n) == 2) {
		na = ruInArgs(n);
		ruFwdMkRule(s2id("wo"), wffT, [ruEqzOrDual(wffT, na[0]), ruEqzOrDual(wffT, na[1])]);
	} else if (ruInHead(n) == s2id("wn") && ruInArity(n) == 1)
		(ruInArgs(n))[0]
	else n;
}
