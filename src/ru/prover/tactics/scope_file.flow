import base/conf;
import base/ids;
import ds/tree;

// ---------------------------------------------------------------------------
// SCOPE FILES: a named scope's contents may live in DATA — tactics/scopes/
// <name>.scope — instead of a compiled string array. The file is a whitespace-
// separated list of assertion names; `//` and `#` start line comments. A file,
// when present, TAKES PRECEDENCE over the built-in list of the same name (the
// built-ins in refiners.flow remain as fallbacks, so a checkout without the
// scope files behaves exactly as before). This moves the semantic load of the
// curated lists — most importantly the congruence-scope equality curation,
// which is LOAD-BEARING by measurement — from code to tactic-level data,
// editable and versionable without recompiling.
// ---------------------------------------------------------------------------

export {
	// The scope's ids from tactics/scopes/<name>.scope, or None when no file
	// exists (caller falls back to the built-in). Cached per name.
	ruLoadScopeFile(name : string) -> Maybe<[int]>;
}

ruScopeFileCache : ref Tree<string, Maybe<[int]>> = ref makeTree();

ruLoadScopeFile(name : string) -> Maybe<[int]> {
	switch (lookupTree(^ruScopeFileCache, name)) {
		Some(cached): cached;
		None(): {
			path = getRussellDir() + "/tactics/scopes/" + name + ".scope";
			loaded = if (!fileExists(path)) None() else {
				content = getFileContent(path);
				names = filtermap(strSplit(content, "\n"), \line0 -> {
					// strip line comments, both styles
					c1 = strIndexOf(line0, "//");
					c2 = strIndexOf(line0, "#");
					cut = if (c1 >= 0 && (c2 < 0 || c1 < c2)) c1 else c2;
					line = trim2(if (cut >= 0) substring(line0, 0, cut) else line0, " \t\r");
					if (line == "") None() else Some(line);
				});
				ids = filtermap(names, \l -> {
					ws = filter(strSplit(l, " "), \w -> trim2(w, " \t") != "");
					if (ws == []) None() else Some(map(ws, \w -> s2id_(trim2(w, " \t"))));
				});
				Some(concatA(ids));
			};
			ruScopeFileCache := setTree(^ruScopeFileCache, name, loaded);
			loaded;
		}
	}
}
