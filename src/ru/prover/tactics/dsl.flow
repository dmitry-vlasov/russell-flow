import ru/prover/core/env;
import ru/prover/core/prove;
import ru/prover/core/expand;
import ru/prover/core/util;
import ru/prover/core/controls;
import ru/prover/tactics/subproof_replay;
import ru/prover/tactics/breadth_first;
import ru/prover/tactics/combinators;
import ru/prover/tactics/focus;
import ru/prover/tactics/follow_proof;
import ru/prover/tactics/kalmar;
import ru/prover/tactics/hilbert;
import ru/prover/tactics/unfold;
import ru/prover/tactics/equalizer;
import ru/prover/tactics/refiners;
import ru/prover/tactics/tac_file;
import ru/prover/tactics/linear_guided;
import ru/prover/ml/premise_selector;
import ru/prover/tactics/oracle;
import ru/unify/index;
import ru/verify/math;
import ru/proof_tree;
import base/util/str;

export {
	// Context passed to atomic-tactic builders that need access to the math
	// model, environment, or pre-built indices.  Atoms that don't need a
	// particular field can ignore it; atoms that need a missing field
	// produce an error at build time.
	RuTacticContext(
		math       : RuMath,
		env        : RuEnv,
		step_index : Maybe<RuIndex<Pair<int,int>>>,
		selector   : Maybe<RuMlSelector>
	);

	// The DSL produces a "tactic builder": a closure invoked once the
	// prover env exists, returning a (possibly modified) env paired with
	// the actual tactic.  Most atoms leave the env unchanged
	// (ruStaticTacticBuilder), but ones like linear-guided need penv.fns /
	// penv.fragmentTrees populated by ruInitProverEnv, and the oracle
	// further overrides penv.fns.unifyAssertion etc.
	//
	// Engine flow: build env with a placeholder tactic, then immediately
	// call builder.build(penv) to get back (penv', tactic) and use penv'
	// onwards with penv'.tactic := Some(tactic).
	RuTacticBuilder(build : (RuProverEnv) -> Pair<RuProverEnv, RuProverTactic>);
	ruStaticTacticBuilder(t : RuProverTactic) -> RuTacticBuilder;

	// Parsed AST node.  A tactic expression is a function call: a name and
	// a list of arguments.  Arguments are either positional or named.
	// Values are either nested ASTs (sub-tactics) or string literals (which
	// the atom-specific builder interprets as int/duration/etc).
	RuTacticAst(name : string, args : [RuTacticArg]);
	RuTacticArg ::= RuTacticArgPos, RuTacticArgNamed;
	RuTacticArgPos(value : RuTacticVal);
	RuTacticArgNamed(name : string, value : RuTacticVal);
	RuTacticVal ::= RuTacticValAst, RuTacticValLit;
	RuTacticValAst(ast : RuTacticAst);
	RuTacticValLit(s : string);

	// Parse a DSL expression.  On success returns Some(ast); on syntax
	// error returns None and prints a diagnostic to env.out.
	ruParseTacticDsl(src : string, env : RuEnv) -> Maybe<RuTacticAst>;

	// Build a tactic builder from an AST.  On unknown atoms or bad args
	// returns None and prints a diagnostic.
	ruBuildTacticFromAst(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuTacticBuilder>;

	// Parse + build in one call.
	ruParseAndBuildTactic(src : string, ctx : RuTacticContext) -> Maybe<RuTacticBuilder>;

	// Expand any `.tac` file reference in a tactic= source to its DSL body (recursively, to a fixpoint);
	// inline tactics and unknown atoms are returned unchanged. env-only so prove/reprove can call it for
	// the step-index scan before a RuTacticContext exists.
	ruResolveTacticSource(src : string, env : RuEnv) -> string;

	// Is `n` a built-in tactic name (atom/combinator handled inline by the dispatch)? A built-in always
	// wins over a same-named `.tac` file. Used by resolution and by the `tactic` help command.
	ruIsBuiltinTacticName(n : string) -> bool;

	// Render the given file-based (`.tac`) tactics as the same 3-column table the built-ins use
	// (Component | Category | Help, one-line summaries) — for the `tactic` command listing.
	ruFileTacticsTable(tacs : [RuTacFile]) -> string;

	// Human-readable tactic-component help for the `tactic` command: the whole annotated list when `name`
	// is empty, else the components whose signature matches `name` (case-insensitive substring), or a
	// not-found note followed by the full list.
	ruTacticHelpLookup(name : string) -> string;
}

ruStaticTacticBuilder(t : RuProverTactic) -> RuTacticBuilder { RuTacticBuilder(\penv -> Pair(penv, t)) }

// ---------------- parser state ----------------

RuDslState(
	src : string,
	pos : ref int,
	err : ref Maybe<Pair<int, string>>  // (position, message) of first error
);

ruDslFail(st : RuDslState, msg : string) -> void {
	if (^(st.err) == None()) {
		st.err := Some(Pair(^(st.pos), msg))
	}
}

ruDslPeek(st : RuDslState) -> int {
	if (^(st.pos) >= strlen(st.src)) -1
	else getCharCodeAt(st.src, ^(st.pos))
}

ruDslAdvance(st : RuDslState) -> void {
	st.pos := ^(st.pos) + 1
}

ruDslSkipWs(st : RuDslState) -> void {
	c = ruDslPeek(st);
	if (c == 32 || c == 9 || c == 10 || c == 13) {
		ruDslAdvance(st);
		ruDslSkipWs(st);
	}
}

ruDslIsLetter(c : int) -> bool {
	(c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}
ruDslIsDigit(c : int) -> bool {
	c >= 48 && c <= 57
}
ruDslIsIdentCont(c : int) -> bool {
	ruDslIsLetter(c) || ruDslIsDigit(c) || c == 45 || c == 46  // '-' and '.' allowed inside ident (assertion names: pm3.2i, 19.8a)
}

// Read a name token of ident-continuation chars from the current position, allowing a leading
// digit (set.mm assertion names like 0ss, 2sp, 3syl, 19.8a). Returns "" on no match.
ruDslReadName(st : RuDslState) -> string {
	start = ^(st.pos);
	ruDslReadIdentCont(st);
	substring(st.src, start, ^(st.pos) - start)
}

// Read an identifier starting with a letter.  Returns "" on no match.
ruDslReadIdent(st : RuDslState) -> string {
	c = ruDslPeek(st);
	if (!ruDslIsLetter(c)) ""
	else {
		start = ^(st.pos);
		ruDslReadIdentCont(st);
		substring(st.src, start, ^(st.pos) - start)
	}
}

ruDslReadIdentCont(st : RuDslState) -> void {
	c = ruDslPeek(st);
	if (c >= 0 && ruDslIsIdentCont(c)) {
		ruDslAdvance(st);
		ruDslReadIdentCont(st);
	}
}

// Read a numeric literal: optional leading '-', then digits, then an
// optional duration suffix (s / ms / m / h).  Returns "" on no match.
ruDslReadLiteral(st : RuDslState) -> string {
	c = ruDslPeek(st);
	is_neg = (c == 45);  // '-'
	if (!is_neg && !ruDslIsDigit(c)) ""
	else {
		start = ^(st.pos);
		if (is_neg) ruDslAdvance(st);
		// Must have at least one digit after the sign.
		c2 = ruDslPeek(st);
		if (!ruDslIsDigit(c2)) {
			if (is_neg) st.pos := start;
			""
		} else {
			ruDslReadDigits(st);
			c3 = ruDslPeek(st);
			if (c3 == 115 || c3 == 109 || c3 == 104) {
				if (c3 == 109) {
					ruDslAdvance(st);
					c4 = ruDslPeek(st);
					if (c4 == 115) ruDslAdvance(st);
				} else {
					ruDslAdvance(st);
				}
			}
			substring(st.src, start, ^(st.pos) - start)
		}
	}
}

ruDslReadDigits(st : RuDslState) -> void {
	c = ruDslPeek(st);
	if (c >= 0 && ruDslIsDigit(c)) {
		ruDslAdvance(st);
		ruDslReadDigits(st);
	}
}

// ---------------- grammar ----------------

// expr := IDENT ( '(' arglist ')' )?
ruDslParseExpr(st : RuDslState) -> Maybe<RuTacticAst> {
	ruDslSkipWs(st);
	name = ruDslReadIdent(st);
	if (name == "") {
		ruDslFail(st, "expected tactic name");
		None()
	} else {
		ruDslSkipWs(st);
		if (ruDslPeek(st) == 40) {
			ruDslAdvance(st);
			args = ruDslParseArgList(st);
			ruDslSkipWs(st);
			if (ruDslPeek(st) == 41) {
				ruDslAdvance(st);
				Some(RuTacticAst(name, args))
			} else {
				ruDslFail(st, "expected ')'");
				None()
			}
		} else {
			Some(RuTacticAst(name, []))
		}
	}
}

ruDslParseArgList(st : RuDslState) -> [RuTacticArg] {
	ruDslSkipWs(st);
	if (ruDslPeek(st) == 41 || ruDslPeek(st) == -1) []
	else {
		arg = ruDslParseArg(st);
		ruDslSkipWs(st);
		if (ruDslPeek(st) == 44) {
			ruDslAdvance(st);
			rest = ruDslParseArgList(st);
			switch (arg) {
				Some(a): concat([a], rest);
				None(): rest;
			}
		} else {
			switch (arg) {
				Some(a): [a];
				None(): [];
			}
		}
	}
}

ruDslParseArg(st : RuDslState) -> Maybe<RuTacticArg> {
	ruDslSkipWs(st);
	saved = ^(st.pos);
	c = ruDslPeek(st);
	if (ruDslIsLetter(c)) {
		name = ruDslReadIdent(st);
		ruDslSkipWs(st);
		if (ruDslPeek(st) == 61) {
			ruDslAdvance(st);
			switch (ruDslParseValue(st)) {
				Some(v): Some(RuTacticArgNamed(name, v));
				None(): None();
			}
		} else {
			st.pos := saved;
			switch (ruDslParseValue(st)) {
				Some(v): Some(RuTacticArgPos(v));
				None(): None();
			}
		}
	} else {
		switch (ruDslParseValue(st)) {
			Some(v): Some(RuTacticArgPos(v));
			None(): None();
		}
	}
}

ruDslParseValue(st : RuDslState) -> Maybe<RuTacticVal> {
	ruDslSkipWs(st);
	c = ruDslPeek(st);
	if (ruDslIsDigit(c) || c == 45) {  // digit or '-' : a numeric literal OR a digit-leading name
		save = ^(st.pos);
		lit = ruDslReadLiteral(st);
		nxt = ruDslPeek(st);
		// If ident chars continue past the numeric part, this is an assertion name (0ss, 19.8a),
		// not a literal — backtrack and read the whole token as a name.
		if (lit != "" && nxt >= 0 && (ruDslIsLetter(nxt) || nxt == 46)) {
			st.pos := save;
			Some(RuTacticValAst(RuTacticAst(ruDslReadName(st), [])));
		} else if (lit == "") { ruDslFail(st, "bad literal"); None() }
		else Some(RuTacticValLit(lit))
	} else if (ruDslIsLetter(c)) {
		switch (ruDslParseExpr(st)) {
			Some(ast): Some(RuTacticValAst(ast));
			None(): None();
		}
	} else {
		ruDslFail(st, "expected value");
		None()
	}
}

ruParseTacticDsl(src : string, env : RuEnv) -> Maybe<RuTacticAst> {
	trimmed = if (strlen(src) >= 2 && getCharCodeAt(src, 0) == 34 && getCharCodeAt(src, strlen(src) - 1) == 34)
		substring(src, 1, strlen(src) - 2)
	else src;
	st = RuDslState(trimmed, ref 0, ref None());
	result = ruDslParseExpr(st);
	ruDslSkipWs(st);
	if (ruDslPeek(st) != -1 && ^(st.err) == None()) {
		ruDslFail(st, "unexpected trailing input");
	}
	switch (^(st.err)) {
		Some(perr): {
			env.out.error("tactic DSL parse error at position " + i2s(perr.first) + ": " + perr.second +
				"\n  source: " + src +
				"\n          " + strRepeat(" ", perr.first) + "^", []);
			None()
		}
		None(): result;
	}
}

// ---------------- builder ----------------

ruDslPositional(ast : RuTacticAst) -> [RuTacticVal] {
	filtermap(ast.args, \arg ->
		switch (arg) {
			RuTacticArgPos(v): Some(v);
			RuTacticArgNamed(__, __): None();
		}
	)
}

// Serialize a parsed tactic AST back to its DSL string. Inverse of ruParseTacticDsl (re-parses to the
// same AST). Used to (a) label or-else alternatives without building them, and (b) splice a `closer=`
// sub-tactic into a preset expansion.
ruTacticVal2s(v : RuTacticVal) -> string {
	switch (v) {
		RuTacticValAst(a): ruTacticAst2s(a);
		RuTacticValLit(s): s;
	}
}
ruTacticAst2s(ast : RuTacticAst) -> string {
	if (ast.args == []) ast.name
	else ast.name + "(" + strGlue(map(ast.args, \arg -> switch (arg) {
		RuTacticArgPos(v):      ruTacticVal2s(v);
		RuTacticArgNamed(n, v): n + "=" + ruTacticVal2s(v);
	}), ", ") + ")";
}

ruDslGetArg(ast : RuTacticAst, name : string, pos_idx : int) -> Maybe<RuTacticVal> {
	named = filtermap(ast.args, \arg ->
		switch (arg) {
			RuTacticArgNamed(n, v): if (n == name) Some(v) else None();
			RuTacticArgPos(__): None();
		}
	);
	if (named != []) Some(named[0])
	else {
		poss = ruDslPositional(ast);
		if (pos_idx < length(poss)) Some(poss[pos_idx]) else None();
	}
}

ruDslGetInt(ast : RuTacticAst, name : string, pos_idx : int, dflt : int) -> int {
	switch (ruDslGetArg(ast, name, pos_idx)) {
		Some(v): switch (v) {
			RuTacticValLit(s): s2i(s);
			RuTacticValAst(__): dflt;
		}
		None(): dflt;
	}
}

ruDslGetString(ast : RuTacticAst, name : string, pos_idx : int, dflt : string) -> string {
	switch (ruDslGetArg(ast, name, pos_idx)) {
		Some(v): switch (v) {
			RuTacticValAst(sub): sub.name;  // bare ident becomes a 0-arg ast — use its name as string
			RuTacticValLit(s): s;
		}
		None(): dflt;
	}
}

ruDslGetDuration(ast : RuTacticAst, name : string, pos_idx : int, dflt_ms : double) -> double {
	switch (ruDslGetArg(ast, name, pos_idx)) {
		Some(v): switch (v) {
			RuTacticValLit(s): ruParseTime(s);
			RuTacticValAst(__): dflt_ms;
		}
		None(): dflt_ms;
	}
}

ruDslGetTacticBuilder(ast : RuTacticAst, pos_idx : int, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	poss = ruDslPositional(ast);
	if (pos_idx >= length(poss)) None()
	else switch (poss[pos_idx]) {
		RuTacticValAst(sub): ruBuildTacticFromAst(sub, ctx);
		RuTacticValLit(s): {
			ctx.env.out.error("tactic DSL: expected tactic, got literal: " + s, []);
			None()
		}
	}
}

ruDslBuildBuilderList(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<[RuTacticBuilder]> {
	poss = ruDslPositional(ast);
	results = map(poss, \v ->
		switch (v) {
			RuTacticValAst(sub): ruBuildTacticFromAst(sub, ctx);
			RuTacticValLit(s): {
				ctx.env.out.error("tactic DSL: expected tactic, got literal: " + s, []);
				None()
			}
		}
	);
	if (exists(results, isNone)) None()
	else Some(map(results, \r -> switch (r) { Some(b): b; None(): ruStaticTacticBuilder(ruDoneTactic); }))
}

// Force `tag` onto every tactic the builder produces, so the engine
// attributes expansions inside this DSL atom to the atom regardless of its
// internal tactic structure (e.g. spr is iterate+follow-proof internally).
ruTagBuilder(tag : string, mb : Maybe<RuTacticBuilder>) -> Maybe<RuTacticBuilder> {
	maybeMap(mb, \b -> RuTacticBuilder(\penv -> {
		p = b.build(penv);
		Pair(p.first, ruTaggedTactic(tag, p.second))
	}))
}

// Per-component documentation for the tactic DSL — what each one DOES, grouped by CATEGORY, for users
// to consult (the `tactic` command; also surfaced on an unknown-atom error). This is the component-level
// `description`, distinct from a tactic instance's `toString` (its faithful per-instance serialization).
// Categories: atoms (runnable search/closers), refiners (goal reducers used inside refine), guides
// (values yielding a proof guide), realizers (run a guide through the engine), combinators (compose
// tactics), selectors (pick props inside focus/track).
// `help` is the SHORT one-liner (the `tactic` table); `full` is the longer description shown by
// `tactic name=<component>` (empty = reuse `help`). `params` documents the arguments.
RuTacticDoc(category : string, sig : string, help : string, full : string, params : [Pair<string, string>]);

ruTacticDocs() -> [RuTacticDoc] {
	p  = \nm, h -> Pair(nm, h);
	d  = \cat, sig, help -> RuTacticDoc(cat, sig, help, "", []);            // short help only
	dp = \cat, sig, help, ps -> RuTacticDoc(cat, sig, help, "", ps);        // short help + params
	df = \cat, sig, help, full -> RuTacticDoc(cat, sig, help, full, []);    // short help + full description
	dpf = \cat, sig, help, full, ps -> RuTacticDoc(cat, sig, help, full, ps); // short help + full + params
	// shared parameter descriptions (the two budget caps every bounded search shares; ruDeltaKeepExpanding)
	md = p("max-depth", "cap on tree depth from the root (absolute)");
	ms = p("max-size",  "cap on nodes ADDED since the tactic started (a delta, not the total)");
	[
		df("atoms", "forward",                      "forward search: advance the whole forward front one wave each round, meeting backward subgoals at joins (unbounded; wrap in limited)",
			"The direction-orthogonal mirror of `bfs`. Instead of expanding the backward goal frontier, it advances the dynamic FORWARD front — applying assertions to known facts (premises + derived facts) to produce new facts, one wave per round. Facts meet the backward search at JOINS (a forward fact discharging an open backward subgoal), all proofs engine-built. It seeds the front from the theorem premises at build time. Stops when a proof is found or the front stops producing new facts.\nBound it by composing with `limited` (granularity is one wave):\n  limited(forward, time=30s)\nCompose with backward search for full bidirectional proving, e.g. seq(forward, bfs) or a loop alternating the two."),
		df("atoms", "bfs",                          "breadth-first search: expand the whole open frontier each round (unbounded)",
			"Complete breadth-first search: expands the ENTIRE open frontier each round, with no bound (it stops only when a proof is found). The pure frontier expander — the base used by replay/compress and the prover default.\nTo bound it, wrap in `limited`:\n  limited(bfs, size=N, depth=D, batch=16)  — the former `bounded-bfs` (strict delta node/depth cap)\n  limited(bfs, size=N, depth=D, batch=n)   — a top-n beam (the n most-specifically-unified leaves per round)"),
		d ("atoms", "done / giveup",                "terminate immediately (a no-op; composes as a seq fallback sentinel)"),
		dp("atoms", "spr(attempts)",                "sub-proof replay: replay held-out corpus sub-proofs as guides (unbounded; wrap in limited)", [p("attempts", "how many held-out corpus sub-proofs to try as guides")]),
		df("atoms", "ml",                           "expand the frontier in ML-ranked order (the ML analogue of bfs)",
			"Score every open leaf with the loaded ML models (feature / medoid / LGG / k-NN) and expand the frontier in best-first order. The pure ML-ranked expander, unbounded on its own — wrap in `limited` for the usual bounded top-k beam:\n  limited(ml, batch=k, size=N, depth=D)\nNeeds an ML selector in context (load-ml=1 / learn-assertions). (`apply` was removed: write `scoped(a1, …, ak, <search>)`.)"),
		dp("atoms", "ap(a, child, ...)",            "replay a positional proof tree: assertion `a` applied at the goal, each child proving a premise in order", [p("a", "the assertion applied at this node"), p("child ...", "each child: a nested ap(...) or `prem` (a premise discharged by a hyp / prior step)")]),
		d ("atoms", "kalmar-closer",                "propositional closer: unfold membership atoms + Kalmar certificate [PRUNE-CANDIDATE]"),
		d ("atoms", "hilbert",                      "the Hilbert-certificate emitter PRIMITIVE: unfold membership atoms + fresh refutation certificate (hilbert.flow), installed directly; no-op when the gap is not certifiable. Composable in any combinator."),
		dp("atoms", "checker(closer=<tactic>)",     "Mizar-style refutation-closer PRESET = hilbert + an optional fallback finisher; checker(closer=X) == or-else(hilbert, X)", [p("closer", "fallback tactic when the emitter cannot certify (e.g. limited(bfs,...)); omit for a no-op")]),
		dp("atoms", "linear-guided(attempts)", "guide search by linear goal->premise chains from the corpus (unbounded; wrap in limited)", [p("attempts", "how many goal->premise chains to try")]),
		dp("atoms", "follow-proof(theorem)",        "replay a named theorem's stored proof tree (diagnostic)", [p("theorem", "name of the theorem whose stored proof tree to replay")]),
		dp("atoms", "oracle(max-true-props, ...)",  "drive search by the theorem's own proof tree (oracle stubs map proof nodes onto prover props)", [p("max-true-props", "oracle-mapped props expanded per iteration (negative = unlimited)"), p("max-false-props", "non-oracle-mapped leaves expanded per iteration (negative = unlimited)"), p("max-variants", "assertion-unification variants offered: the oracle's + N fallbacks (negative = oracle only)"), p("max-proofs", "premise-proof variants offered: the oracle's + N fallbacks (negative = oracle only)")]),
		// refiners — goal reducers composed inside refine(...); not runnable standalone
		d ("refiners", "strip-forall",              "strip the leading ∀-chain; the matrix proof is re-quantified with ax-gen"),
		d ("refiners", "conj-split",                "split a conjunction goal (B ∧ C ∧ …) into its conjuncts; recombined with pm3.2i"),
		d ("refiners", "rel-intro",                 "reduce a ⊆ / set-= goal to a fresh-setvar membership subgoal via ssriv/eqriv"),
		d ("refiners", "eq-rewrite",                "unfold compound membership atoms + canonicalize by biconditional congruence to a residual"),
		// guides — a VALUE yielding a proof guide; consumed by replay, not runnable alone
		dp("guides", "refine(r1, ..., nnf=on, closer=<t>)", "compose goal refiners + a residual closer (default: a bounded bfs; closer= swaps it) into a proof tree", [p("r1 ...", "refiner names to compose (strip-forall, rel-intro, eq-rewrite)"), p("nnf", "on = canonicalize to negation-normal-form (De Morgan)"), p("closer", "residual closer tactic (default: limited(bfs, size=max-size, depth=max-depth, batch=16))"), md, ms]),
		d ("guides", "stored",                      "the theorem's own stored proof tree (replay(stored) reconstructs an existing proof)"),
		// realizers — run a guide through the engine
		dp("realizers", "replay(<guide>)",          "reconstruct the guide through the engine (track + replay selector); valid by construction", [p("<guide>", "a guide-expression to reconstruct: refine(...) or stored")]),
		// combinators
		dp("combinators", "seq(t1, t2, ...)",       "run t1; on Done without a proof, fall through to t2, ... (first that closes wins); built EAGERLY, threads env", [p("t1, t2, ...", "sub-tactics tried in order; the first to find a proof wins")]),
		dpf("combinators", "or-else(t1, t2, ...)",  "lazy alternation: try each in order, first proof wins",
			"Try the alternatives left to right; the first to find a proof wins and the search stops. Unlike `seq` (which builds all its sub-tactics up front and threads env stage->stage), or-else BUILDS each alternative only when the previous one finishes without a proof. So an expensive-to-build alternative -- e.g. a guide constructed by refine/replay -- is skipped entirely when an earlier one closes. This laziness is what lets `def-close` be the pure composition or-else(replay(refine(...)), replay(refine(..., nnf=on))) with no wasted builds.",
			[p("t1, t2, ...", "alternatives tried in order; later ones are built only if earlier ones fail")]),
		dp("combinators", "loop(body, max-iters=N)", "re-run body while it makes progress, up to N iterations", [p("body", "the tactic to repeat"), p("max-iters", "max iterations (stops early if a round makes no progress)")]),
		dp("combinators", "limited(t, time=, size=, depth=, batch=)", "run t under wall-clock / size / depth caps, optionally pacing its expansion (omit a cap to disable it)", [p("t", "the tactic to cap"), p("time", "wall-clock budget (e.g. 30s); 0 = none"), p("size", "max nodes ADDED since the tactic started (a delta; 0 = none)"), p("depth", "max tree depth from the root (absolute; 0 = none)"), p("batch", "expand at most this many leafs/round (0 = whole frontier); a non-zero batch keeps a size cap strict")]),
		dp("combinators", "focus(selector, t)",     "restrict t to the subtrees rooted at the selector's seeds", [p("selector", "which props/seeds to focus on (see selectors)"), p("t", "tactic run on the selected subtrees")]),
		dp("combinators", "track(selector, t)",     "restrict t to EXACTLY the selector's props each step (e.g. replay a guide)", [p("selector", "which props to keep each step (see selectors)"), p("t", "tactic restricted to them")]),
		dp("combinators", "scoped(scope, t)",       "restrict candidate rules to <scope>, then run t", [p("scope", "a named scope (e.g. prop-scope) or an inline assertion list"), p("t", "tactic run under that rule restriction")]),
		// Named COMPOSITIONS (def-close, spr-bfs, linear-bfs, ...) are now file-based `.tac` tactics under
		// tactics/, not built-in components — `tactic` lists them separately and `tactic name=<x>` shows
		// their @help/@arg metadata.
		// selectors — pick props inside focus(...) / track(...)
		d ("selectors", "all",                      "every open leaf (no restriction)"),
		d ("selectors", "frontier",                 "candidate props at the frontier where the guide diverges from the tree"),
		dp("selectors", "leaf(id) / assertion(name)", "a single prop by id / all props applying a named assertion", [p("id", "a prop id (leaf selector)"), p("name", "an assertion name (assertion selector)")])
	]
}

// The distinct categories, in listing order.
ruTacticCategories() -> [string] { uniq(map(ruTacticDocs(), \d -> d.category)) }

// Render docs as the standard 3-column help table (Component | Category | Help), like `help all`.
ruTacticDocsTable(docs : [RuTacticDoc]) -> string {
	stringTable2s([
		map(docs, \d -> d.sig),
		map(docs, \d -> d.category),
		map(docs, \d -> d.help)
	], Some(["Component", "Category", "Help"]));
}

// Column width the detailed-view Description is wrapped to (the leading tab from strIndent is on top).
ruTacticDocWidth = 80;

// Word-wrap a Description to `width` columns: split on existing newlines, keep already-fitting lines
// VERBATIM (so pre-formatted blocks — e.g. def-close's expansion — keep their indent and alignment),
// and greedily word-wrap only the over-long prose lines. Self-contained (no re-splitting of short lines,
// which would collapse intentional spacing).
ruWrapTacticDoc(text : string, width : int) -> string {
	strGlue(map(strSplit(text, "\n"), \line ->
		if (strlen(line) <= width) line
		else {
			words  = filter(strSplit(line, " "), \w -> w != "");
			packed = fold(words, Pair([], ""), \acc : Pair<[string], string>, w -> {
				cur = acc.second;
				if (cur == "") Pair(acc.first, w)
				else if (strlen(cur) + 1 + strlen(w) <= width) Pair(acc.first, cur + " " + w)
				else Pair(concat(acc.first, [cur]), w)
			});
			strGlue(concat(packed.first, [packed.second]), "\n");
		}
	), "\n");
}

// Detailed single-component view, mirroring `help <command>` (ruCommInfo2s): labelled vertical sections,
// including a Parameters table (like `help`'s Arguments) for components that take parameters.
ruTacticDoc2s(d : RuTacticDoc) -> string {
	"Component:\n\t" + d.sig + "\n" +
	"Category:\n\t" + d.category + "\n" +
	"Description:\n" + strIndent(ruWrapTacticDoc(if (d.full != "") d.full else d.help, ruTacticDocWidth)) + "\n" +
	(if (d.params == []) "" else
		"Parameters:\n" + strIndent(stringTable2s([
			map(d.params, \pp -> pp.first),
			map(d.params, \pp -> pp.second)
		], Some(["Name", "Help"]))) + "\n");
}

// Does `nm` name the LEADING component of `sig`? (sig starts with nm at a token boundary: end, '(', ' ',
// or '/'.) Lets an exact name like `apply` win over substring siblings (`apply`/`ap`), `bfs` over
// `bounded-bfs`, etc., selecting a single component for the detailed view.
ruTacticPrimaryMatch(sig : string, nm : string) -> bool {
	s = toLowerCase(sig);
	startsWith(s, nm) && (strlen(s) == strlen(nm) || {
		c = substring(s, strlen(nm), 1);
		c == "(" || c == " " || c == "/";
	});
}

ruTacticHelp2s() -> string {
	// ruTacticDocsTable (stringTable2s) already starts on a fresh line, so the header takes no trailing \n.
	"Tactic components (categories: " + strGlue(ruTacticCategories(), ", ") +
	"; `tactic name=<component|category>` for details):" + ruTacticDocsTable(ruTacticDocs());
}

// Lookup for the `tactic` command: empty -> full table; a CATEGORY name -> that category's components;
// otherwise a case-insensitive substring match on the component signature; else not-found + full table.
ruTacticHelpLookup(name : string) -> string {
	docs = ruTacticDocs();
	nm   = toLowerCase(trim2(name, " "));
	if (nm == "") ruTacticHelp2s()
	else if (exists(docs, \dc -> toLowerCase(dc.category) == nm)) ruTacticDocsTable(filter(docs, \dc -> toLowerCase(dc.category) == nm))
	else {
		// Prefer an exact leading-name hit (apply over apply/ap, bfs over bounded-bfs); fall back to
		// substring. A single match → detailed `help <command>`-style view; several → the table.
		exact   = filter(docs, \dc -> ruTacticPrimaryMatch(dc.sig, nm));
		matches = if (length(exact) == 1) exact else filter(docs, \dc -> strContains(toLowerCase(dc.sig), nm));
		if (matches == []) "no tactic component or category matching '" + name + "'\n" + ruTacticHelp2s()
		else if (length(matches) == 1) ruTacticDoc2s(matches[0])
		else ruTacticDocsTable(matches);
	}
}

ruBuildTacticFromAst(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	n = ast.name;
	// Ground atoms are tagged with their atom name; combinators (seq/loop/
	// limited) are left untagged and expose the active sub-tactic's tag.
	// bounded-bfs / top-n-bfs were REMOVED as atoms — write `limited(bfs, size=, depth=, batch=)`
	// (batch=ruSearchBatch=16 for the old bounded-bfs; batch=n for the old top-n-bfs beam).
	if (n == "bfs")              ruTagBuilder("bfs", Some(ruStaticTacticBuilder(ruBreadthFirstTactic)))
	else if (n == "forward")     ruTagBuilder("forward", ruDslBuildForward(ast, ctx))
	else if (n == "done")        Some(ruStaticTacticBuilder(ruDoneTactic))
	else if (n == "giveup")      Some(ruStaticTacticBuilder(ruDoneTactic))
	else if (n == "spr")             ruTagBuilder("spr", ruDslBuildSpr(ast, ctx))
	else if (n == "fragment-replay") {
		ctx.env.out.error("tactic DSL: 'fragment-replay' is removed; use 'spr' instead (spr subsumes fragment replay and is more general)", []);
		None()
	}
	else if (n == "ml")              ruTagBuilder("ml", ruDslBuildMl(ast, ctx))
	// `apply` removed — it was scoped + a hidden bfs; write scoped(a1, …, ak, <search>) instead
	// (scoped's scope is the leading positional names, the last positional is any search tactic).
	else if (n == "ap")              ruTagBuilder("ap", ruDslBuildAp(ast, ctx))
	else if (n == "kalmar-closer")   ruTagBuilder("kalmar-closer", ruDslBuildKalmarCloser(ast, ctx))
	else if (n == "checker")         ruTagBuilder("checker", ruDslBuildCheckerCloser(ast, ctx))
	else if (n == "hilbert")         ruTagBuilder("hilbert", ruDslBuildHilbert(ast, ctx))
	else if (n == "replay")          ruDslBuildRealizer(ast, ctx, "replay", ruReplayRealize)
	else if (n == "linear-guided")   ruTagBuilder("linear-guided", ruDslBuildLinearGuided(ast, ctx))
	else if (n == "follow-proof")    ruTagBuilder("follow-proof", ruDslBuildFollowProof(ast, ctx))
	else if (n == "oracle")          ruTagBuilder("oracle", ruDslBuildOracle(ast))
	else if (n == "seq")             ruDslBuildSeq(ast, ctx)
	else if (n == "or-else")         ruDslBuildOrElse(ast, ctx)
	else if (n == "loop")            ruDslBuildLoop(ast, ctx)
	else if (n == "limited")         ruDslBuildLimited(ast, ctx)
	else if (n == "focus")           ruDslBuildFocus(ast, ctx)
	else if (n == "track")           ruDslBuildTrack(ast, ctx)
	else if (n == "scoped")          ruDslBuildScoped(ast, ctx)
	// File-based tactics (presets) are resolved UPSTREAM in ruParseAndBuildTactic / ruResolveTacticSource
	// (a `.tac` reference is expanded to its DSL body before this dispatch runs), so by here `n` is either a
	// built-in or a genuine unknown.
	else {
		ctx.env.out.error("tactic DSL: unknown atom '" + ast.name + "'\n" + ruTacticHelp2s(), []);
		None();
	}
}

ruDslBuildSpr(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	switch (ctx.step_index) {
		None(): { ctx.env.out.error("tactic DSL: spr needs step_index in context", []); None() }
		Some(idx): {
			attempts = ruDslGetInt(ast, "attempts", 0, 3);
			// Deferred: read the theorem being proved from the env so SPR cannot
			// replay that theorem's own steps (held-out replay by default). Bounds via limited(spr(…), …).
			Some(RuTacticBuilder(\penv -> Pair(penv,
				ruSubproofReplayTactic(idx, attempts, penv.conf.task.info.id, ctx.math, ctx.env)
			)));
		}
	}
}


// `forward`: the direction-orthogonal mirror of `bfs`. The atom itself is inert
// (ruForwardTactic just signals RuTacticExpandForward each round); the builder's job
// is to SEED the proof-carrying forward front (premises + assertion hyp indexes) so
// waves have something to expand — done at build time, which the runner invokes
// BEFORE ruExpandHyp(root), so the root's backward subgoals register in backwardFront
// (the reverse-join index). A no-op if a front is already installed (forward-search-depth).
ruDslBuildForward(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	Some(RuTacticBuilder(\penv -> {
		ruSeedForwardFront(penv);
		Pair(penv, ruForwardTactic);
	}))
}

ruDslBuildMl(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	switch (ctx.selector) {
		None(): { ctx.env.out.error("tactic DSL: ml needs an ML selector in context (load-ml=1 or run learn-assertions first)", []); None() }
		Some(sel): Some(ruStaticTacticBuilder(ruMlTactic(sel)));   // bounds/beam via limited(ml, batch=k, …)
	}
}

// PRUNE-CANDIDATE: see the family note in kalmar.flow. This atom is the ONLY live entry to the Kalmár
// subsystem and NO active workflow invokes it (def-close closes residuals with bounded-bfs). Kept for now
// as the explicit propositional closer; revisit once the bounded-bfs closer's coverage is confirmed.
// The propositional closer (`kalmar-closer`): unfold the goal/hyps' compound membership atoms
// (instantiating the foundation's elun/eldif/elsymdif/… membership lemmas), rewrite the goal to base
// atoms by congruence, then close the residual `hyps + facts ⊢ goal'` with the Kalmár certificate
// TACTIC — driven through the prover by ruRunCloser, not called as a bare procedure. A no-op
// (ruDoneTactic) when the goal is not a propositional consequence, so it composes in a seq(...) before a
// fallback. The residual closer is injected (RuEqCloser.mkCloser), defaulting to Kalmár here.
ruDslBuildKalmarCloser(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	Some(RuTacticBuilder(\penv -> {
		task     = penv.conf.task;
		goalStmt = task.goal.stmt;
		goalExp  = ruExp(goalStmt.exps[0]);
		hypExps  = map(task.premises, \p -> ruExp(p.stmt.exps[0]));
		conn     = ruPConnectives();
		wff      = tp2id_("wff");
		// Default residual closer = the Kalmár certificate tactic for that concrete (premises ⊢ goal').
		// It installs the certificate (no search), so its time/size budgets are non-binding; ruRunCloser
		// recovers the installed proof tree. ruDoneTactic when goal' is not a propositional consequence.
		clo = RuEqCloser(task.info, ruCheckerPropScope(), 60000.0,
			\prems, g -> either(ruKalmarTactic(conn, wff, goalStmt.class, prems, g, 1000000), ruDoneTactic));
		tactic = switch (ruEqualizerPropTactic(RuEnvMath(ctx.math, ctx.env), conn, wff, goalStmt.class, hypExps, goalExp, clo)) {
			Some(t): t;
			None():  ruDoneTactic;
		};
		Pair(penv, tactic);
	}))
}

// MODULARITY #2 — the Hilbert emitter as a composable PRIMITIVE (`hilbert`). strip ∀, prove the body with
// the fresh Kalmár-free certificate emitter (hilbert.flow: refutation + deneg + ⊆/=/∈ bridge + membership
// unfold — a deduction-form proof over the rich propositional library, verified by construction), re-quantify
// with ax-gen, and INSTALL directly. Direct install (not replay(refine(closer=…))) is essential: the replay
// realizer re-derives via the engine and can't reconstruct the emitter's interleaved ssrdv/deneg bridge steps,
// losing the ¬-form ⊆-transitivity class (t1 etc.). prove.flow re-verifies installed proofs, so it stays sound.
// On emitter failure run `closerAstMb` (the pluggable finisher), else ruDoneTactic (a no-op that composes in
// or-else/seq). `hilbert` passes None; `checker(closer=X)` passes X — so `checker(closer=X)` ≡ or-else(hilbert,X).
ruBuildHilbertEmitter(closerAstMb : Maybe<RuTacticAst>, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	Some(RuTacticBuilder(\penv -> {
		task     = penv.conf.task;
		goalStmt = task.goal.stmt;
		stmtClass = goalStmt.class;
		sp       = ruStripForall(ruExp(goalStmt.exps[0]));   // peel ∀ (re-quantified by ax-gen below)
		body     = sp.first;
		hypExps  = map(task.premises, \p -> ruExp(p.stmt.exps[0]));
		conn     = ruPConnectives();
		wff      = tp2id_("wff");
		em       = RuEnvMath(ctx.math, ctx.env);
		// The fallback finisher, REBUILT fresh per call (a closer's internal delta-snapshot ref must not leak
		// across sub-proves); runs on the full prover env/goal. None → ruDoneTactic (the bare-primitive case).
		runCloser = \ -> switch (closerAstMb) {
			Some(sub): switch (ruBuildTacticFromAst(sub, ctx)) {
				Some(b): (b.build(penv)).second;
				None():  ruDoneTactic;
			};
			None(): ruDoneTactic;
		};
		axgen = \tree -> fold(sp.second, tree, \acc, lvl -> RuProofStep(s2id_("ax-gen"), [acc], RuStmt(stmtClass, [lvl], -1)));
		tactic = switch (ruHilbertCertificate(em, conn, wff, stmtClass, hypExps, body)) {
			Some(pr): switch (pr.first) {
				RuProofStep(__, __, __): ruInstallProofTactic(RuProof(pr.second, ruMakeLinearProof(axgen(pr.first)), -1));
				RuProofHyp(__, __):      ruDoneTactic;   // body IS a hypothesis — the engine closes it
			};
			None(): runCloser();   // emitter could not certify → hand off to the pluggable finisher
		};
		Pair(penv, tactic);
	}))
}

// `hilbert`: the bare emitter primitive (no fallback), composable in any combinator — or-else(hilbert, bfs),
// seq(some-refiner, hilbert), first(hilbert, kalmar-closer), … It also accepts closer= for symmetry.
ruDslBuildHilbert(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	ruBuildHilbertEmitter(ruDslCloserArg(ast), ctx)
}

// `checker(closer=<tactic>)`: the Mizar-style refutation-closer PRESET = the hilbert emitter plus a pluggable
// fallback finisher (MODULARITY #1). checker(closer=X) ≡ or-else(hilbert, X); bare `checker` ≡ `hilbert`.
ruDslBuildCheckerCloser(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	ruBuildHilbertEmitter(ruDslCloserArg(ast), ctx)
}

// extract the optional `closer=<tactic>` AST from an atom invocation (shared by hilbert / checker).
ruDslCloserArg(ast : RuTacticAst) -> Maybe<RuTacticAst> {
	switch (ruDslGetArg(ast, "closer", 99)) {
		None(): None();
		Some(v): switch (v) { RuTacticValAst(sub): Some(sub); RuTacticValLit(__): None(); };
	}
}


// ---- guide-expressions: a tactic VALUE that yields a proof guide (not a runnable tactic) ----
// A guide-expression evaluates (at build time, against the prover env / goal) to a proof TREE plus its
// DV provisos. It is consumed by the REALIZER tactic replay(<guide>), which reconstructs it through the
// engine. `refine(...)` and `stored` are the guide-expressions.
RuGuideBuilder(toString : string, build : (RuProverEnv) -> Maybe<RuRefineResult>);

// A guide-builder for the refiner pipeline with a FIXED nnf mode: compose the named refiners, close the
// residual with the closer tactic (default bounded-bfs(md,ms)) over the prop scope. `closer=<tactic>`
// swaps the residual search strategy; it is REBUILT fresh per residual (its delta-snapshot ref must not
// leak across sub-proves).
ruRefineGuideBuilder(refinerNames : [string], md : int, ms : int, tl : double, closerAstMb : Maybe<RuTacticAst>, nnf : bool, scope : Pair<string, [int]>, ctx : RuTacticContext) -> RuGuideBuilder {
	nnfStr    = if (nnf) ", nnf=on" else "";
	closerStr = switch (closerAstMb) { Some(sub): ", closer=" + sub.name + "(...)"; None(): ""; };
	scopeStr  = if (scope.first == "prop-scope") "" else ", scope=" + scope.first;
	gstr      = "refine(" + strGlue(refinerNames, ", ") + nnfStr + closerStr + scopeStr + ")";
	RuGuideBuilder(gstr, \penv -> {
		// Default residual closer = strict delta-bounded BFS = limited(bfs, size=ms, depth=md, batch=16).
		// `closer=<tactic>` overrides it (the residual search strategy is pluggable; bfs is just the default).
		defaultCloser = \ -> ruLimitedTactic(ruBreadthFirstTactic, 0.0, 0, 0, ms, md, ruSearchBatch);
		mkCloser = \ -> switch (closerAstMb) {
			Some(sub): switch (ruBuildTacticFromAst(sub, ctx)) {
				Some(b): (b.build(penv)).second;
				None():  defaultCloser();
			};
			None():  defaultCloser();
		};
		task      = penv.conf.task;
		goalStmt  = task.goal.stmt;
		goalExp   = ruExp(goalStmt.exps[0]);
		hypExps   = map(task.premises, \p -> ruExp(p.stmt.exps[0]));
		stmtClass = goalStmt.class;
		em        = RuEnvMath(ctx.math, ctx.env);
		conn      = ruPConnectives();
		wff       = tp2id_("wff");
		// Does assertion `aid` precede the theorem being proved? The refiners use this to avoid building
		// guides with lemmas the engine can never use (declared later, or — under reprove — the theorem
		// itself). Same `ruDeclInfoPreceeds` test the engine's search applies.
		// Hoist these immutable lookups OUT of the per-call `precedes` closure. Re-deref of the nested
		// `penv.math.decls.assertions` chain on every invocation (the closure runs once per proof-tree
		// assertion, inside `forall`) intermittently faulted and the swallowed failure made the guide
		// build silently return None — a nondeterministic "not proved". Evaluate once.
		assertionsTree = penv.math.decls.assertions;
		taskInfo       = task.info;
		importDeps     = penv.importDependencies;
		precedes  = \aid -> switch (lookupTree(assertionsTree, aid)) {
			Some(ass): ruDeclInfoPreceeds(ass.info, taskInfo, importDeps);
			None():    false;
		};
		refiners  = filtermap(refinerNames, \nm -> ruRefinerByName(nm, em, conn, wff, stmtClass, hypExps, nnf, precedes));
		close     = \g -> ruCheckerResidual(ctx.math, ctx.env, task.info, stmtClass, hypExps, g, scope.second, mkCloser, tl, nnf, precedes);
		ruRefine(refiners, goalExp, close);
	});
}

// The `refine(r1, ..., max-depth=, max-size=, nnf=on, closer=<tactic>)` guide-expression (positional
// refiner names; named budget/nnf/closer args). NOT a runnable tactic — wrap it in replay(...).
ruDslRefineGuide(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuGuideBuilder> {
	poss  = ruDslPositional(ast);
	names = filtermap(poss, \v -> switch (v) { RuTacticValAst(sub): if (sub.name != "") Some(sub.name) else None(); RuTacticValLit(__): None(); });
	unknown = filter(names, \nm -> !exists(ruRefinerNames(), \k -> k == nm));
	if (unknown != []) {
		ctx.env.out.error("tactic DSL: unknown refiner(s) " + strGlue(unknown, ", ") + " (known: " + strGlue(ruRefinerNames(), ", ") + ")", []);
		None();
	} else {
		md  = ruDslGetInt(ast, "max-depth", 99, 6);
		ms  = ruDslGetInt(ast, "max-size",  99, 4096);
		tl  = i2d(ruDslGetInt(ast, "time-limit", 99, 60));
		nnf = ruDslGetString(ast, "nnf", 99, "off") == "on";
		closerAstMb = switch (ruDslGetArg(ast, "closer", 99)) {
			None(): None();
			Some(v): switch (v) { RuTacticValAst(sub): Some(sub); RuTacticValLit(__): None(); };
		};
		// `scope=<named-scope>` widens the residual closer's rule set (default prop-scope). The checker
		// decomposition uses scope=checker-scope so the residual BFS can apply the refutation / exmid /
		// bridge lemmas prop-scope omits — closing gaps def-close cannot, still engine-reconstructed.
		scopeName = ruDslGetString(ast, "scope", 99, "prop-scope");
		scope = switch (ruNamedScope(scopeName)) {
			Some(ids): Pair(scopeName, ids);
			None(): {
				ctx.env.out.error("tactic DSL: refine: unknown scope '" + scopeName + "' (known: prop-scope, checker-scope, refute-scope, exmid-scope, bridge-scope, unfold-scope); using prop-scope", []);
				Pair("prop-scope", ruCheckerPropScope());
			}
		};
		Some(ruRefineGuideBuilder(names, md, ms, tl, closerAstMb, nnf, scope, ctx));
	}
}

// The `stored` guide-expression: the theorem's own stored proof tree, so `replay(stored)` reconstructs
// an existing proof via the engine (the former `track(replay, bfs)`).
ruDslStoredGuide(ctx : RuTacticContext) -> RuGuideBuilder {
	RuGuideBuilder("stored", \penv ->
		switch (lookupTree(ctx.math.decls.assertions, penv.conf.task.info.id)) {
			Some(ass): switch (ass) {
				RuTheorem(__, __, __, __): Some(RuRefineResult(ruTheoremProofTree(ass, ctx.math), makeSet()));
				default: None();
			}
			None(): None();
		}
	);
}

// Dispatch a guide-EXPRESSION (consumed by replay), distinct from the tactic dispatch.
ruBuildGuideFromAst(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuGuideBuilder> {
	if (ast.name == "refine")      ruDslRefineGuide(ast, ctx)
	else if (ast.name == "stored") Some(ruDslStoredGuide(ctx))
	else {
		ctx.env.out.error("tactic DSL: '" + ast.name + "' is not a guide-expression (expected refine(...) or stored)", []);
		None();
	}
}

// Realizer: turn a built guide into a tactic. replay reconstructs it via the engine (track + replay
// selector), relabelled to the guide-expression level so toString reads `replay(refine(...))`.
ruReplayRealize(penv : RuProverEnv, gstr : string, g : RuRefineResult) -> RuProverTactic {
	// replay scopes candidate generation to the guide's OWN assertions — without it the engine explores
	// the whole foundation at every expansion and times out. The scope is internal to replay (derived
	// from the guide), so it stays out of toString. (def-close builds at most one replay per prove —
	// lazy nnf — so this single-whitelist set never conflicts.)
	penv.whitelist := uniq(ruApTreeAssertions(g.proof));
	ruLabeledTactic("replay(" + gstr + ")", ruTrackTactic(ruReplaySelector(g.proof), ruBreadthFirstTactic));
}

// replay(<guide>): the realizer tactic atom. The guide-expression is evaluated at build time; if it
// yields no guide the realizer is a no-op (so it composes in a seq fallback).
ruDslBuildRealizer(ast : RuTacticAst, ctx : RuTacticContext, name : string, realize : (RuProverEnv, string, RuRefineResult) -> RuProverTactic) -> Maybe<RuTacticBuilder> {
	poss = ruDslPositional(ast);
	if (poss == []) {
		ctx.env.out.error("tactic DSL: " + name + "(<guide>) needs a guide-expression (refine(...) or stored)", []);
		None();
	} else switch (poss[0]) {
		RuTacticValLit(s): { ctx.env.out.error("tactic DSL: " + name + " expects a guide-expression, got literal " + s, []); None(); }
		RuTacticValAst(sub): switch (ruBuildGuideFromAst(sub, ctx)) {
			None(): None();
			Some(gb): Some(RuTacticBuilder(\penv -> switch (gb.build(penv)) {
				Some(g): Pair(penv, realize(penv, gb.toString, g));
				None():  Pair(penv, ruLabeledTactic(name + "(" + gb.toString + ")", ruDoneTactic));
			}));
		}
	}
}

// `def-close` is now a file-based tactic (tactics/def-close.tac), not an atom: it expands to
//   or-else( replay(refine(strip-forall, rel-intro, eq-rewrite,         budget)),
//            replay(refine(strip-forall, rel-intro, eq-rewrite, nnf=on, budget)) )
// — a composition expressed purely from primitives (build a goal-refinement guide, then have the engine
// reconstruct it: sound, precedence-checked). The lazy nnf=on fallback (build the second guide only if the
// first finds no proof) is the `or-else` combinator. Resolution: ruResolveTacticSource → ruLoadTacFile.
// (The old `inject` direct-install path was removed earlier: redundant with replay and unsound.)

// ap(<assertion>, <child0>, <child1>, ...): the POSITIONAL, structure-carrying apply — a proof
// TREE, not a rule set. The assertion is applied at the goal; each child proves the corresponding
// premise (in order) and is itself an `ap(...)` or the leaf marker `prem` (premise discharged by a
// hypothesis / prior step). The term mirrors the proof tree exactly, so there is NO search over rule
// choice: it builds a RuProofStep skeleton and replays it via follow-proof — the engine fills in the
// statements and threads variables (incl. witness vars like ax-mp's free antecedent). Deterministic;
// the lattice atom. Whitelist restricts candidate generation to the tree's assertions for speed.
//   t8 step1:  ap(mpbi, prem, ap(elun))
//   t8 step2:  ap(ax-mp, prem, ap(ax-mp, ap(mpbi, prem, ap(unss)), ap(ssel)))
ruApParseTree(ast : RuTacticAst, env : RuEnv) -> Maybe<RuProofTree> {
	if (ast.name == "prem" || ast.name == "_") Some(RuProofHyp(0, ruNoStmt))
	else if (ast.name == "ap") {
		poss = ruDslPositional(ast);
		if (poss == []) { env.out.error("tactic DSL: ap(...) needs an assertion name", []); None(); }
		else switch (poss[0]) {
			RuTacticValLit(s): { env.out.error("tactic DSL: ap: first arg must be an assertion name, got literal " + s, []); None(); }
			RuTacticValAst(head): {
				cms = map(tail(poss), \v -> switch (v) {
					RuTacticValAst(c): ruApParseTree(c, env);
					RuTacticValLit(s): { env.out.error("tactic DSL: ap: child must be ap(...) or prem, got literal " + s, []); None(); };
				});
				if (exists(cms, isNone)) None()
				else Some(RuProofStep(s2id_(head.name), map(cms, \m -> either(m, RuProofHyp(0, ruNoStmt))), ruNoStmt));
			}
		}
	}
	else { env.out.error("tactic DSL: ap: expected ap(...) or prem, got '" + ast.name + "'", []); None(); }
}

ruApTreeAssertions(t : RuProofTree) -> [int] {
	switch (t) {
		RuProofStep(a, ch, __): concat([a], concatA(map(ch, ruApTreeAssertions)));
		RuProofHyp(__, __):     [];
	}
}

ruDslBuildAp(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	switch (ruApParseTree(ast, ctx.env)) {
		None(): None();
		Some(tree): switch (tree) {
			RuProofHyp(__, __): { ctx.env.out.error("tactic DSL: ap root cannot be 'prem'", []); None(); }
			RuProofStep(a, ch, s): {
				skel = RuProofStep(a, ch, s);
				wl   = uniq(ruApTreeAssertions(skel));
				Some(RuTacticBuilder(\penv -> {
					penv.whitelist := wl;
					Pair(penv, ruScopedTactic("[" + strGlue(map(wl, id2s), ", ") + "]", ruFollowProofTactic(skel)));
				}));
			}
		}
	}
}

ruDslBuildLinearGuided(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	switch (ctx.step_index) {
		None(): {
			ctx.env.out.error("tactic DSL: linear-guided needs step_index in context (tactic string must contain 'linear-guided' for the index to be built)", []);
			None()
		}
		Some(idx): {
			attempts = ruDslGetInt(ast, "attempts", 0, 3);
			Some(RuTacticBuilder(\penv -> {
				exclude    = penv.conf.task.info.id;
				prem_exprs = filtermap(penv.conf.task.premises, \p -> {
					e = ruExp(p.stmt.exps[0]);
					if (length(e.nodes) > 0) Some(e) else None()
				});
				// Bounds via limited(linear-guided(…), …).
				Pair(penv, ruLinearGuidedTactic(idx, attempts, exclude, prem_exprs, ctx.math, ctx.env))
			}))
		}
	}
}

ruDslBuildOracle(ast : RuTacticAst) -> Maybe<RuTacticBuilder> {
	// oracle(max-true-props, max-false-props, max-variants, max-proofs):
	// drives the search by the original proof tree of the theorem being
	// proved.  Needs the per-theorem env: looks up the current theorem from
	// penv.conf.task and overrides penv.fns.unifyAssertion / unifyPremise
	// with oracle-aware variants that share a per-theorem mapping ref.
	max_true     = ruDslGetInt(ast, "max-true-props",  0, 1);
	max_false    = ruDslGetInt(ast, "max-false-props", 1, 0);
	max_variants = ruDslGetInt(ast, "max-variants",    2, -1);
	max_proofs   = ruDslGetInt(ast, "max-proofs",      3, -1);
	Some(RuTacticBuilder(\penv -> {
		th_id = penv.conf.task.info.id;
		switch (lookupTree(penv.math.decls.assertions, th_id)) {
			Some(ass): switch (ass) {
				RuTheorem(__,__,__,proof): {
					th = ass;
					mapping : ref Tree<RuProverProp, RuProofStep> = ref makeTree();
					root_ass = lookupTreeDef(penv.math.decls.assertions, ruProofQedStep(proof).assertion, ruNoAxiom);
					// Relabel with ALL four params (the underlying tactic only carries max_true/max_false;
					// max_variants/max_proofs live in the unify-fn overrides, so its own toString omits them).
					tactic = ruLabeledTactic(
						"oracle(" + i2s(max_true) + ", " + i2s(max_false) + ", " + i2s(max_variants) + ", " + i2s(max_proofs) + ")",
						ruReproveOracleTactic(th, penv.math, mapping, max_true, max_false, penv.env)
					);
					new_penv = RuProverEnv(penv with
						fns = RuProverFuncs(penv.fns with
							unifyAssertion = ruReproveOracleUnifyAssertion(
								th, penv.fns.unifyAssertion, mapping, root_ass, penv.math, penv.env,
								max_variants, max_true, max_false
							),
							unifyPremise = ruReproveOracleUnifyPremise(
								th, penv.fns.unifyPremise, mapping, penv.math, penv.env,
								max_proofs, max_true, max_false
							)
						)
					);
					Pair(new_penv, tactic)
				}
				default: {
					penv.env.out.error("tactic DSL: oracle expects a theorem in the prover task; got non-theorem", []);
					Pair(penv, ruDoneTactic)
				}
			}
			None(): {
				penv.env.out.error("tactic DSL: oracle could not look up the prover-task theorem", []);
				Pair(penv, ruDoneTactic)
			}
		}
	}))
}

ruDslBuildFollowProof(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	// follow-proof(theorem-name) — looks up the named theorem and follows its
	// QED step's sub-proof.  Useful for diagnostics ("can the engine replay
	// X's existing proof?") rather than for routine proving.
	switch (ruDslGetArg(ast, "theorem", 0)) {
		None(): { ctx.env.out.error("tactic DSL: follow-proof needs a theorem name", []); None() }
		Some(v): {
			name = switch (v) {
				RuTacticValAst(sub): sub.name;
				RuTacticValLit(s): s;
			};
			th_id = s2id_(name);
			switch (lookupTree(ctx.math.decls.assertions, th_id)) {
				None(): { ctx.env.out.error("tactic DSL: follow-proof: theorem '" + name + "' not found", []); None() }
				Some(ass): switch (ass) {
					RuTheorem(__,__,__,__): {
						proof_step = ruTheoremProofTree(ass, ctx.math);
						Some(ruStaticTacticBuilder(ruFollowProofTactic(proof_step)));
					}
					default: { ctx.env.out.error("tactic DSL: follow-proof: '" + name + "' is not a theorem", []); None() }
				}
			}
		}
	}
}

ruDslBuildSeq(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	switch (ruDslBuildBuilderList(ast, ctx)) {
		None(): None();
		Some(builders): Some(RuTacticBuilder(\penv -> {
			// Sequence threads any env modifications: each sub-builder sees
			// the env produced by the previous one.
			folded = fold(builders, Pair(penv, []), \acc : Pair<RuProverEnv, [RuProverTactic]>, b -> {
				p = b.build(acc.first);
				Pair(p.first, concat(acc.second, [p.second]))
			});
			Pair(folded.first, ruSequenceTactic(folded.second))
		}));
	}
}

// or-else(t1, t2, ...): lazy alternation. Each alternative's BUILDER is constructed now (cheap — for
// replay(refine(...)) this captures the guide-builder WITHOUT building the guide), but its actual
// .build(penv) is deferred into a thunk, so an expensive alternative is built only when or-else reaches
// it (i.e. only if the earlier ones finished without a proof). Labels come from re-serializing the child
// AST, so the whole or-else(...) toString is available without building anything.
ruDslBuildOrElse(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	poss = ruDslPositional(ast);
	pairsMb = map(poss, \v -> switch (v) {
		RuTacticValAst(sub): maybeMap(ruBuildTacticFromAst(sub, ctx), \b -> Pair(ruTacticAst2s(sub), b));
		RuTacticValLit(s): { ctx.env.out.error("tactic DSL: or-else alternative must be a tactic, got literal '" + s + "'", []); None(); };
	});
	if (poss == []) { ctx.env.out.error("tactic DSL: or-else needs at least one alternative", []); None(); }
	else if (exists(pairsMb, isNone)) None()
	else {
		pairs = filtermap(pairsMb, \m -> m);
		Some(RuTacticBuilder(\penv ->
			Pair(penv, ruOrElseTactic(map(pairs, \pr -> Pair(pr.first, \ -> (pr.second.build(penv)).second))))
		));
	}
}

ruDslBuildLoop(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	max_iters = ruDslGetInt(ast, "max-iters", 1, 3);
	poss = ruDslPositional(ast);
	if (poss == []) {
		ctx.env.out.error("tactic DSL: loop requires a body tactic", []);
		None()
	} else switch (poss[0]) {
		RuTacticValAst(body_ast): {
			Some(RuTacticBuilder(\penv -> {
				// Fresh body each iteration so state-carrying tactics reset.
				// The body's env modifications are applied at loop init only
				// (we don't iterate them per cycle — fresh state, fixed env).
				body_builder = \ -> switch (ruBuildTacticFromAst(body_ast, ctx)) {
					Some(b): (b.build(penv)).second;
					None():  ruDoneTactic;
				};
				Pair(penv, ruLoopWhileProgressTactic(body_builder, max_iters))
			}));
		}
		RuTacticValLit(s): {
			ctx.env.out.error("tactic DSL: loop body must be a tactic, got literal: " + s, []);
			None()
		}
	}
}

// Build a node selector from a DSL selector expression.  `penv` is needed by
// proof-aware selectors (frontier) to look up the theorem being proved.
// The proof tree of the theorem named in the prover task, if it is a theorem.
ruDslTaskProofTree(penv : RuProverEnv, ctx : RuTacticContext) -> Maybe<RuProofTree> {
	switch (lookupTree(ctx.math.decls.assertions, penv.conf.task.info.id)) {
		Some(ass): switch (ass) {
			RuTheorem(__, __, __, __): Some(ruTheoremProofTree(ass, ctx.math));
			default: None();
		}
		None(): None();
	}
}

ruDslBuildSelector(ast : RuTacticAst, penv : RuProverEnv, ctx : RuTacticContext) -> RuNodeSelector {
	n = ast.name;
	if (n == "all") ruAllSelector
	else if (n == "frontier") switch (ruDslTaskProofTree(penv, ctx)) {
		Some(pt): ruFrontierSelector(pt);
		None(): {
			ctx.env.out.error("tactic DSL: 'frontier' selector — prover task is not a theorem; using 'all'", []);
			ruAllSelector
		}
	}
	// (the former `replay` selector is superseded by the `replay(stored)` realizer tactic)
	else if (n == "leaf") {
		id = ruDslGetInt(ast, "id", 0, -1);
		RuNodeSelector("leaf(" + i2s(id) + ")", \tree ->
			switch (lookupTree(tree.nodes, id)) { Some(p): [p]; None(): []; }
		)
	}
	else if (n == "assertion") {
		name = ruDslGetString(ast, "name", 0, "");
		aid  = s2id_(name);
		RuNodeSelector("assertion(" + name + ")", \tree ->
			filter(getTreeValues(tree.nodes), \p -> p.assertion.info.id == aid)
		)
	}
	else {
		ctx.env.out.error("tactic DSL: unknown selector '" + n + "', using 'all'", []);
		ruAllSelector
	}
}

// Shared builder for focus(...) and track(...): they differ only in the
// combinator applied (ruFocusTactic vs ruTrackTactic).
ruDslBuildFocusLike(
	ast  : RuTacticAst,
	ctx  : RuTacticContext,
	name : string,
	wrap : (RuNodeSelector, RuProverTactic) -> RuProverTactic
) -> Maybe<RuTacticBuilder> {
	poss = ruDslPositional(ast);
	if (length(poss) < 2) {
		ctx.env.out.error("tactic DSL: " + name + "(<selector>, <tactic>) needs a selector and a tactic", []);
		None()
	} else switch (poss[0]) {
		RuTacticValLit(s): {
			ctx.env.out.error("tactic DSL: " + name + " selector must be a name, got literal: " + s, []);
			None()
		}
		RuTacticValAst(sel_ast): switch (ruDslGetTacticBuilder(ast, 1, ctx)) {
			None(): None();
			Some(inner_builder): Some(RuTacticBuilder(\penv -> {
				selector = ruDslBuildSelector(sel_ast, penv, ctx);
				built    = inner_builder.build(penv);
				Pair(built.first, wrap(selector, built.second))
			}));
		}
	}
}

ruDslBuildFocus(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	ruDslBuildFocusLike(ast, ctx, "focus", ruFocusTactic)
}

ruDslBuildTrack(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	ruDslBuildFocusLike(ast, ctx, "track", ruTrackTactic)
}

// Named scopes: a short alias for a fixed assertion set, so `scoped(prop-scope, ...)` stays readable.
ruNamedScope(name : string) -> Maybe<[int]> {
	if (name == "prop-scope")          Some(ruCheckerPropScope())
	// The decomposed checker lemma-set scopes (see refiners.flow): orthogonal rule families that let a
	// scoped bidirectional search stand in for the install `hilbert` emitter, law-abidingly.
	else if (name == "checker-scope")  Some(ruCheckerFullScope())
	else if (name == "refute-scope")   Some(ruCheckerRefuteScope())
	else if (name == "exmid-scope")    Some(ruCheckerExmidScope())
	else if (name == "bridge-scope")   Some(ruCheckerBridgeScope())
	else if (name == "unfold-scope")   Some(ruCheckerUnfoldScope())
	else None();
}

// scoped(<scope>, <tactic>): restrict candidate generation to <scope> (a named scope like `prop-scope`,
// or an inline list of assertion names), then run <tactic>. The LAST positional is the tactic; every
// preceding positional is the scope spec. Lifts the old `penv.whitelist :=` side-effect into a visible
// combinator: the whitelist is set on the prove env at build time, and ruScopedTactic carries the scope
// into toString. `apply(...)` and def-close's realizer are expressed through this.
ruDslBuildScoped(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	poss = ruDslPositional(ast);
	n = length(poss);
	if (n < 2) {
		ctx.env.out.error("tactic DSL: scoped(<scope>, <tactic>) needs a scope and a tactic", []);
		None();
	} else {
		scopeNames = filtermap(take(poss, n - 1), \v -> switch (v) {
			RuTacticValAst(sub): if (sub.name != "") Some(sub.name) else None();
			RuTacticValLit(__):  None();
		});
		resolved = if (length(scopeNames) == 1) switch (ruNamedScope(scopeNames[0])) {
			Some(ids): Pair(scopeNames[0], ids);
			None():    Pair("[" + strGlue(scopeNames, ", ") + "]", map(scopeNames, s2id_));
		} else Pair("[" + strGlue(scopeNames, ", ") + "]", map(scopeNames, s2id_));
		switch (ruDslGetTacticBuilder(ast, n - 1, ctx)) {
			None(): None();
			Some(innerBuilder): Some(RuTacticBuilder(\penv -> {
				penv.whitelist := resolved.second;
				p = innerBuilder.build(penv);
				Pair(p.first, ruScopedTactic(resolved.first, p.second));
			}));
		}
	}
}

ruDslBuildLimited(ast : RuTacticAst, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	switch (ruDslGetTacticBuilder(ast, 0, ctx)) {
		None(): None();
		Some(inner_builder): {
			// DSL surface exposes only time / size / depth / batch. applied/produced are core-only limits
			// (set directly by compress / measure-autoprovability), never used from the DSL — pass 0.
			time_ms = ruDslGetDuration(ast, "time",  1, 0.0);
			size    = ruDslGetInt(ast,      "size",  2, 0);
			depth   = ruDslGetInt(ast,      "depth", 3, 0);
			batch   = ruDslGetInt(ast,      "batch", 4, 0);
			Some(RuTacticBuilder(\penv -> {
				p = inner_builder.build(penv);
				Pair(p.first, ruLimitedTactic(p.second, time_ms, 0, 0, size, depth, batch))
			}));
		}
	}
}

ruParseAndBuildTactic(src : string, ctx : RuTacticContext) -> Maybe<RuTacticBuilder> {
	// Expand any .tac file reference to its DSL body FIRST, then parse + build as usual.
	switch (ruParseTacticDsl(ruResolveTacticSource(src, ctx.env), ctx.env)) {
		Some(ast): ruBuildTacticFromAst(ast, ctx);
		None(): None();
	}
}

// The names ruBuildTacticFromAst dispatches inline (atoms + combinators). KEEP IN SYNC with the dispatch
// above. Used to decide whether a tactic= head is a built-in (→ inline) or a candidate .tac file ref:
// a built-in always wins over a same-named file.
ruBuiltinTacticNames() -> [string] {
	["bfs", "forward", "done", "giveup", "spr", "fragment-replay", "ml", "ap", "kalmar-closer", "checker", "hilbert", "replay",
	 "linear-guided", "follow-proof", "oracle", "seq", "or-else", "loop", "limited", "focus", "track", "scoped"]
}
ruIsBuiltinTacticName(n : string) -> bool { exists(ruBuiltinTacticNames(), \b -> b == n) }

// Expand a tactic= source string: if its head names a `.tac` file (a path with '/', or a bare non-built-in
// name that resolves under tactics/), load the file, bind the invocation's args to its @arg declarations
// (named-or-positional, @defval fallback), substitute `$arg` placeholders into the body, and recurse to a
// fixpoint (a body may reference another file). Inline tactics (head is a built-in) and unknown atoms are
// returned UNCHANGED — so the normal parse/build path and its errors are untouched. env-only (no ctx) so
// prove/reprove can call it for the step-index scan before a context exists.
ruResolveTacticSource(src : string, env : RuEnv) -> string {
	ruResolveTacticSrc(src, env, [], 0)
}

ruResolveTacticSrc(src0 : string, env : RuEnv, visited : [string], depth : int) -> string {
	// ruParseTacticDsl strips surrounding quotes; do the same here so head detection / file lookup match.
	src = {
		t = trim2(src0, " \t\r\n");
		if (strlen(t) >= 2 && getCharCodeAt(t, 0) == 34 && getCharCodeAt(t, strlen(t) - 1) == 34) substring(t, 1, strlen(t) - 2) else t;
	};
	if (depth > 32) { env.out.error("tactic resolution too deep (cyclic .tac reference?): " + src, []); src0 }
	else {
		lp   = strIndexOf(src, "(");
		head = trim2(if (lp < 0) src else substring(src, 0, lp), " \t\r\n");
		if (head == "" || ruIsBuiltinTacticName(head)) src   // inline tactic → unchanged
		else {
			isPath = strContains(head, "/");
			switch (ruFindTactic(head, env)) {
				None(): {
					// A '/'-path that doesn't resolve is clearly a bad file ref; a bare name is just an
					// unknown atom — let the normal parse/build path report it.
					if (isPath) env.out.error("tactic file not found: '" + head + "' (looked under <cwd>, workingDir, tactics/)", []);
					src0;
				}
				Some(path): {
					if (exists(visited, \v -> v == path)) { env.out.error("tactic .tac cycle detected at '" + head + "'", []); src0 }
					else switch (ruLoadTacFile(head, env)) {
						None(): { env.out.error("tactic file not found: '" + head + "'", []); src0 }
						Some(tf): {
							// Parse the invocation's arg list by replacing the (possibly '/'-containing) head
							// with a dummy identifier, so named/positional/nested-tactic args parse uniformly.
							astMb = if (lp < 0) Some(RuTacticAst("d", [])) else ruParseTacticDsl("d" + substring(src, lp, strlen(src) - lp), env);
							switch (astMb) {
								None(): src0;   // arg-list parse error already reported
								Some(ast): {
									if (tf.body == "") { env.out.error("tactic file '" + head + "' has no tactic body", []); src0 }
									else ruResolveTacticSrc(ruBindTacArgs(head, tf, ast, env), env, concat(visited, [path]), depth + 1);
								}
							}
						}
					}
				}
			}
		}
	}
}

// Bind a .tac file's @arg declarations to an invocation AST's args (named-or-positional, @defval fallback)
// and substitute the `$arg` placeholders in its body. Substitution keys are sorted longest-first so `$max`
// never clobbers `$max-depth`.
ruBindTacArgs(name : string, tf : RuTacFile, ast : RuTacticAst, env : RuEnv) -> string {
	npos = length(ruDslPositional(ast));
	if (npos > length(tf.info.args))
		env.out.error("tactic '" + name + "': " + i2s(npos) + " positional args given but only " + i2s(length(tf.info.args)) + " declared", []);
	bindings = mapi(tf.info.args, \i, arg -> Pair(arg.name, switch (ruDslGetArg(ast, arg.name, i)) {
		Some(v): ruTacticVal2s(v);
		None():
			if (!arg.optional && arg.defval == "") { env.out.error("tactic '" + name + "': missing required argument '" + arg.name + "'", []); "" }
			else arg.defval;
	}));
	if (!strContains(tf.body, "$")) tf.body
	else {
		btree = pairs2tree(bindings);
		subst = concatA(map(sortCustom(map(bindings, \b -> b.first), idfn, false),
			\key -> ["$" + key, lookupTreeDef(btree, key, "")]));
		// Iterate to a fixpoint: a @defval may itself reference another arg (e.g. closer's default uses
		// $max-size/$max-depth), so one pass can leave placeholders the next pass resolves. Bounded so a
		// self-referential value can't loop forever.
		ruSubstFixpoint(tf.body, subst, 8);
	}
}

ruSubstFixpoint(body : string, subst : [string], fuel : int) -> string {
	if (fuel <= 0 || !strContains(body, "$")) body
	else {
		next = strReplaces(body, subst);
		if (next == body) body else ruSubstFixpoint(next, subst, fuel - 1);
	}
}

// First non-blank line of a help string (the one-line summary for the listing).
ruFirstHelpLine(help : string) -> string {
	ls = filter(strSplit(help, "\n"), \l -> trim2(l, " \t\r\n") != "");
	if (ls == []) "" else trim2(ls[0], " \t\r\n");
}

ruFileTacticsTable(tacs : [RuTacFile]) -> string {
	if (tacs == []) "\t(none)"
	else ruTacticDocsTable(map(tacs, \tf ->
		RuTacticDoc(if (tf.info.category == "") "derived" else tf.info.category, tf.info.name, ruFirstHelpLine(tf.info.help), "", [])));
}
