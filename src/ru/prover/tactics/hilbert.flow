import ru/prover/tactics/propositional;
import ru/prover/tactics/equalizer;   // ruEqualizerRelSubgoal (fresh-setvar membership subgoal + DV)
import ru/prover/tactics/unfold;      // RuEnvMath
import ru/prover/tactics/instantiate;
import ru/prover/core/declines; // RuInAtomCong — the per-branch equality transport table
import ru/proof_tree;

// PHASE 2, step 2 of the fresh (Kalmár-free) certificate generator (project_mizar_proving_stats).
// A deduction-form Hilbert proof EMITTER over the propositional core: given `hyps |- goal` (as RuPForms
// whose atoms realize to real wff via `atomNodes`), it BUILDS an RuProofTree applying the foundation's
// rich propositional library. NOT a truth-table construction — it is goal-directed natural deduction in
// the standard set.mm deduction form `(W -> phi)` (W = the conjunction of introduced assumptions):
//   * forward saturation : ∧-elim (simpld/simprd) + modus ponens when the antecedent is already known
//   * backward structural: ∧R (jca), →R (ex / deduction theorem), ∨R (orcd/olcd)
//   * refutation clash   : a context proving both A and ¬A discharges ANY goal (pm2.21 ∘ syl/mpd)
//   * bounded →L         : prove a missing antecedent, then mpd, retry
// Best-effort + ALWAYS sound: every node is a real lemma application, so the caller verifies the result
// (ruVerifyTheorem) — incompleteness only loses coverage, never soundness. Lemma schemas are exact
// (ax-mp, jca, simpl/simpr/simpld/simprd, ex, adantr, a1i, id, orc/olc/orcd/olcd, mpd, syl, pm2.21,
// pm3.2i — see the recon in the commit msg / project memory).

export {
	// State that the FIRST-ORDER ⊆/= handling mutates as it proves (refs are shared across all ctx copies):
	//   atomNodes  — grows as ssrdv/sseld introduce fresh-witness membership atoms (key → real nodes)
	//   splitBudget — per-PATH classical-split DEPTH budget, RESTORED on a failed branch (backtracking DFS):
	//     bounds how deep nested case-splits/∨-elims may stack along ONE proof path (the 2^n exponent).
	//   globalSplits — TOTAL split attempts across the whole proof, NEVER restored: a hard work cap that
	//     bounds the backtracking blow-up (branching^depth) so a single gap can't run away under a time limit.
	//   disjs/freshVars — the disjoint-variable provisos + fresh setvars the ssrdv steps require; the caller
	//     MUST fold these into the installed RuProof.vars, else verification fails on a DV violation
	//   em — RuEnvMath, for ruEqualizerRelSubgoal (the ⊆/= goal reduction's fresh-var + DV machinery)
	//   timer — a WALL-CLOCK deadline for the whole emitter run. The split/work caps bound the
	//     backtracking SHAPE but not its wall cost (a near-24-atom certificate can run minutes —
	//     the 6.5h zfmisc lesson); every ruHProve entry checks the timer and bails.
	//   fo — the FIRST-ORDER PER-BRANCH transport table (atom congruences): with Some, every
	//     ruHProve entry moves the branch's atom facts across its equality facts (Mizar's
	//     per-basic-problem Equalizer — a case split's equality disjunct transports the other
	//     literals INSIDE the branch, where saturation-before-the-check cannot see it).
	//   exElims/exSeen/exElimsGlobal — S4d branch skolemization bounds: per-PATH ∃-elimination
	//     depth (restored on a failed branch, like splitBudget), the atom keys already
	//     eliminated down the current recursion (no re-elimination loops), and the TOTAL
	//     elimination attempts across the whole proof (never restored — the hard work cap,
	//     exactly the splitBudget/globalSplits pairing).
	//   exNoMatch — atoms match-tested against the ∃-unfold table and declined, per
	//     certificate: ruHExElim runs at EVERY failing ruHProve entry, and without the
	//     negative cache the repeated match scans alone starved big certificates (t101).
	RuHCtx(conn : RuPConnectives, wff : int, stmtClass : int, atomNodes : ref Tree<string, [RuExpNode]>,
		splitBudget : ref int, globalSplits : ref int, disjs : ref Set<RuDisj>, freshVars : ref [RuVar], em : RuEnvMath,
		timer : RuTimer, fo : Maybe<Tree<int, [RuInAtomCong]>>, inClash : ref bool,
		exElims : ref int, exSeen : ref Set<string>, exElimsGlobal : ref int, exNoMatch : ref Set<string>,
		topFo : bool, setPool : Tree<string, RuProofTree>, setMemo : ref Tree<string, Maybe<RuProofTree>>);
	// `wff` (the wff type id) and `stmtClass` (the |- turnstile id) MUST come from the loaded math — derive
	// them from a real expression (ruIdType2Type of a connective node / the prop's class), never from the
	// memoized ruIdWff/ruIdTurnstile helpers (they cache -1 if interned before the library loads).
	ruHCtx(em : RuEnvMath, wff : int, stmtClass : int, atomNodes : Tree<string, [RuExpNode]>) -> RuHCtx;
	// A deduction-form Hilbert proof of `hyps |- goal`, or None if the emitter can't build one.
	ruHilbertProve(ctx : RuHCtx, hyps : [RuPForm], goal : RuPForm) -> Maybe<RuProofTree>;
	// SKOLEMIZATION discharge (S4): a proof of `(assume → goal)` from `hyps` — the assumption is
	// introduced natively (the deduction-theorem lift), so the caller can wrap the result with
	// exlimiv to eliminate an ∃-premise whose body the assumption is. No tree transform needed.
	ruHilbertProveUnder(ctx : RuHCtx, hyps : [RuPForm], assume : RuPForm, goal : RuPForm) -> Maybe<RuProofTree>;
	// ruHilbertPropProof with an explicit wall-clock budget (ms) — the proof search bails
	// (returns None) once the deadline passes. Callers with their own slice discipline use this.
	// `fo` = Some(atom-congruence table) turns on the per-branch equality transport.
	ruHilbertPropProofTimed(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int, hyps : [RuExp], goal : RuExp, limit_ms : double, fo : Maybe<Tree<int, [RuInAtomCong]>>) -> Maybe<Pair<RuProofTree, RuVarsDisjs>>;
	// ruHilbertPropProofTimed + an EXTERNAL setness pool: `T ∈ _V` facts that are NOT certificate
	// hyps (the relevance filter drops them — they share no atom with the goal) but must still be
	// available as the induction base of the hyp-carrying membership biconds at class metavars.
	// Their proof leaves are the caller's, so no atom is added to the exponential check.
	ruHilbertPropProofTimedPool(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int, hyps : [RuExp], goal : RuExp, limit_ms : double, fo : Maybe<Tree<int, [RuInAtomCong]>>, pool : Tree<string, RuProofTree>) -> Maybe<Pair<RuProofTree, RuVarsDisjs>>;
	// ruHilbertPropProofTimed + one TOP-LEVEL transport round over the certificate hyps
	// (the unifier-gen t85 class: the driving equality is a top-level fact, not a branch
	// assumption, so the per-branch transport never sees it). Kept out of the full-stack
	// residual paths — the extra entry cost measurably starves slice-budget borderliners
	// (t101 flipped 89->88 when this ran unconditionally).
	ruHilbertPropProofTimedTop(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int, hyps : [RuExp], goal : RuExp, limit_ms : double, fo : Maybe<Tree<int, [RuInAtomCong]>>) -> Maybe<Pair<RuProofTree, RuVarsDisjs>>;
	// Realize a propositional form as a statement `|- f` (for building the hyps/conclusion of a test theorem).
	ruHStmt(ctx : RuHCtx, f : RuPForm) -> RuStmt;
	// The COMPLETE PROPOSITIONAL ENTAILMENT PROOF ("certificate" in older notes/commits)
	// for a residual `hyps |- goal` (the equalizer's output): atomize over the real
	// subexpr nodes (atoms realize to actual expressions) and run the emitter. Returns the proof TREE plus
	// the RuVarsDisjs (fresh setvars + DV provisos) the caller must attach to the installed RuProof.
	ruHilbertPropProof(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int, hyps : [RuExp], goal : RuExp) -> Maybe<Pair<RuProofTree, RuVarsDisjs>>;
}

ruHilbertPropProof(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int, hyps : [RuExp], goal : RuExp) -> Maybe<Pair<RuProofTree, RuVarsDisjs>> {
	// 60 s SAFETY-NET deadline for untimed callers: far above any certificate that ever succeeds,
	// but a runaway search can no longer outlive its whole article run (the 6.5h lesson).
	ruHilbertPropProofTimed(em, conn, wff, stmtClass, hyps, goal, 60000.0, None());
}

ruHilbertPropProofTimed(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int, hyps : [RuExp], goal : RuExp, limit_ms : double, fo : Maybe<Tree<int, [RuInAtomCong]>>) -> Maybe<Pair<RuProofTree, RuVarsDisjs>> {
	ruHilbertPropProofTimed0(em, conn, wff, stmtClass, hyps, goal, limit_ms, fo, false, makeTree());
}

ruHilbertPropProofTimedPool(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int, hyps : [RuExp], goal : RuExp, limit_ms : double, fo : Maybe<Tree<int, [RuInAtomCong]>>, pool : Tree<string, RuProofTree>) -> Maybe<Pair<RuProofTree, RuVarsDisjs>> {
	ruHilbertPropProofTimed0(em, conn, wff, stmtClass, hyps, goal, limit_ms, fo, false, pool);
}

ruHilbertPropProofTimedTop(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int, hyps : [RuExp], goal : RuExp, limit_ms : double, fo : Maybe<Tree<int, [RuInAtomCong]>>) -> Maybe<Pair<RuProofTree, RuVarsDisjs>> {
	ruHilbertPropProofTimed0(em, conn, wff, stmtClass, hyps, goal, limit_ms, fo, true, makeTree());
}

ruHilbertPropProofTimed0(em : RuEnvMath, conn : RuPConnectives, wff : int, stmtClass : int, hyps : [RuExp], goal : RuExp, limit_ms : double, fo : Maybe<Tree<int, [RuInAtomCong]>>, topFo : bool, extPool : Tree<string, RuProofTree>) -> Maybe<Pair<RuProofTree, RuVarsDisjs>> {
	atomNodes = fold(hyps, ruPAtomNodes(conn, goal), \acc, h -> mergeTree(acc, ruPAtomNodes(conn, h)));
	hypForms  = map(hyps, \h -> ruPAtomize(conn, h));
	goalForm  = ruPAtomize(conn, goal);
	ctx = RuHCtx(ruHCtx(em, wff, stmtClass, atomNodes) with timer = ruMakeLimitedTimer(limit_ms), fo = fo, topFo = topFo,
		setPool = mergeTree(ruSetnessPoolOf(mapi(hyps, \i, h -> Pair(h, i)), stmtClass), extPool));
	// NB a split-budget lift for plan-backed (topFo) calls was TRIED AND MEASURED
	// OUT (2026-07-24): although no or-split picks a refutable-branch wrong, the
	// DFS still wanders 64-deep into SHAPE-GAP subtrees (e.g. iff-congruence over
	// ∨) before reaching the succeeding sibling — zfmisc probe 613->596 assembled,
	// 18s->3m54s. The budget artifacts on huge DNFs are only removable by the
	// per-disjunct REPLAY executor, not by tuning this search
	// ([[mizar-fidelity-budgets]]).
	if (em.env.conf.verbose >= 5) {
		em.env.out.println("      hCert: goal=" + ruHFormShape(goalForm) + " hyps=" + strGlue(map(hypForms, ruHFormShape), " ; "));
		if (em.env.conf.verbose >= 6) {
			em.env.out.println("        hCertAtoms: " + i2s(sizeTree(atomNodes)));
			em.env.out.println("        hCertGoal: " + ru2s(goal, em.math));
			iter(hyps, \h -> em.env.out.println("        hCertHyp: " + ru2s(h, em.math)));
		} else {};
	} else {};
	r0 = ruHilbertProve(ctx, hypForms, goalForm);
	if (em.env.conf.verbose >= 6) {
		em.env.out.println("        hCertOut: " + (if (isSome(r0)) "PROVED" else "failed"));
	} else {};
	maybeMap(r0, \tree ->
		Pair(tree, RuVarsDisjs(fold(^(ctx.freshVars), makeTree(), \acc, v -> setTree(acc, v.id, v)), ^(ctx.disjs))));
}

// a proof fragment: `tree` proves `|- und(curAmb, content)` for the ambient in force at its creation.
RuHF(content : RuPForm, tree : RuProofTree);

// the ∧-leaves of a form (flattening nested conjunctions).
ruHAndLeaves(f : RuPForm) -> [RuPForm] {
	switch (f) {
		RuPAnd(a, b): concat(ruHAndLeaves(a), ruHAndLeaves(b));
		default: [f];
	}
}

// does the form contain an equality ATOM anywhere? (shape gate for the ¬-membership unfold)
ruHFormHasEqAtom(ctx : RuHCtx, f : RuPForm) -> bool {
	switch (f) {
		RuPAtom(k): ruEqHead(ruHAtomExp(ctx, k)) == ruHwceq();
		RuPNot(a): ruHFormHasEqAtom(ctx, a);
		RuPAnd(a, b): ruHFormHasEqAtom(ctx, a) || ruHFormHasEqAtom(ctx, b);
		RuPOr(a, b): ruHFormHasEqAtom(ctx, a) || ruHFormHasEqAtom(ctx, b);
		RuPImp(a, b): ruHFormHasEqAtom(ctx, a) || ruHFormHasEqAtom(ctx, b);
		RuPIff(a, b): ruHFormHasEqAtom(ctx, a) || ruHFormHasEqAtom(ctx, b);
		RuPTrue(): false;
		RuPFalse(): false;
	}
}

// debug: the propositional SHAPE of a form (atoms anonymized).
ruHFormShape(f : RuPForm) -> string {
	switch (f) {
		RuPAtom(__): "A";
		RuPNot(a): "~" + ruHFormShape(a);
		RuPAnd(a, b): "(" + ruHFormShape(a) + "&" + ruHFormShape(b) + ")";
		RuPOr(a, b): "(" + ruHFormShape(a) + "|" + ruHFormShape(b) + ")";
		RuPImp(a, b): "(" + ruHFormShape(a) + ">" + ruHFormShape(b) + ")";
		RuPIff(a, b): "(" + ruHFormShape(a) + "=" + ruHFormShape(b) + ")";
		RuPTrue(): "T";
		RuPFalse(): "F";
	}
}

ruHCtx(em : RuEnvMath, wff : int, stmtClass : int, atomNodes : Tree<string, [RuExpNode]>) -> RuHCtx {
	RuHCtx(ruPConnectives(), wff, stmtClass, ref atomNodes, ref 6, ref 400, ref makeSet(), ref [], em,
		ruMakeLimitedTimer(60000.0), None(), ref false, ref 3, ref makeSet(), ref 16, ref makeSet(), false,
		makeTree(), ref makeTree());
}

// ---- RuPForm -> RuExp / RuStmt (own copy; mirrors the kalmar pattern, no kalmar dependency) ----
ruHForm2Nodes(ctx : RuHCtx, f : RuPForm) -> [RuExpNode] {
	bin = \rule, a, b -> {
		an = ruHForm2Nodes(ctx, a);
		bn = ruHForm2Nodes(ctx, b);
		concat([ruMakeRuleNode(rule, ctx.wff, 2, length(an) + length(bn))], concat(an, bn));
	};
	switch (f) {
		RuPAtom(k):   lookupTreeDef(^(ctx.atomNodes), k, []);
		RuPNot(a): { an = ruHForm2Nodes(ctx, a); concat([ruMakeRuleNode(ctx.conn.wn, ctx.wff, 1, length(an))], an); }
		RuPImp(a, b): bin(ctx.conn.wi, a, b);
		RuPIff(a, b): bin(ctx.conn.wb, a, b);
		RuPAnd(a, b): bin(ctx.conn.wa, a, b);
		RuPOr(a, b):  bin(ctx.conn.wo, a, b);
		// NB: ruPConnectives stores wtru/wfal as the SYMBOLS (⊤ / F.), not the rule names — the nullary
		// wff constants are built by the rules `wtru` / `wfal`, so use those ids here.
		RuPTrue():    [ruMakeRuleNode(s2id_("wtru"), ctx.wff, 0, 0)];
		RuPFalse():   [ruMakeRuleNode(s2id_("wfal"), ctx.wff, 0, 0)];
	}
}
ruHStmt(ctx : RuHCtx, f : RuPForm) -> RuStmt { RuStmt(ctx.stmtClass, [RuExp(ruHForm2Nodes(ctx, f), -1)], -1); }
// a single proof node: lemma `name` applied to `kids`, concluding `|- concl`.
ruHStep(ctx : RuHCtx, name : string, kids : [RuProofTree], concl : RuPForm) -> RuProofTree {
	RuProofStep(s2id_(name), kids, ruHStmt(ctx, concl));
}
ruHUnd(amb : Maybe<RuPForm>, f : RuPForm) -> RuPForm { switch (amb) { None(): f; Some(w): RuPImp(w, f); } }

// ---- FIRST-ORDER ⊆/= bridge (ssrdv/ssriv goal reduction + sseld/ssel fact instantiation) -----------
// The membership unfold WITH PROOF: a ⊆ GOAL `A⊆B` reduces to a fresh-witness membership subgoal
// `(v∈A→v∈B)` (ssriv bare / ssrdv in deduction form), and a ⊆ FACT `A⊆B` instantiates to `(e∈A→e∈B)`
// at each witness e in scope (ssel bare / sseld in deduction form). This is what transfers the emitter's
// propositional power onto real ⊆/=-structured gaps — the conclusion's quantifier is handled by ssrdv's
// ∀-intro (fresh v + DV via ruEqualizerRelSubgoal), the hyps' by sseld's ∀-inst.
ruHwss() -> int { s2id_("wss"); }
ruHwceq() -> int { s2id_("wceq"); }
ruHwcel() -> int { s2id_("wcel"); }
// the RuExp realized for atom `key` (its real subexpression nodes).
ruHAtomExp(ctx : RuHCtx, key : string) -> RuExp { RuExp(lookupTreeDef(^(ctx.atomNodes), key, []), -1); }
// build an n-ary rule application expression.
ruHMkExp(rule : int, typ : int, args : [RuExp]) -> RuExp {
	an = concatA(map(args, \a -> a.nodes));
	RuExp(concat([ruMakeRuleNode(rule, typ, length(args), length(an))], an), -1);
}
// the element exprs (CLASS, already coerced) of the membership-atom facts — the witnesses for sseld.
ruHWitnesses(ctx : RuHCtx, facts : [RuHF]) -> [RuExp] {
	filtermap(facts, \f -> switch (f.content) {
		RuPAtom(k): { e = ruHAtomExp(ctx, k); if (ruEqHead(e) == ruHwcel()) Some(ruEqArgs(e).first) else None(); };
		default: None();
	});
}
// instantiate a ⊆ FACT `A⊆B` (content RuPAtom(key)) at each witness e → `(e∈A→e∈B)` via ssel/sseld.
ruHRelInst(ctx : RuHCtx, amb : Maybe<RuPForm>, f : RuHF, key : string, witnesses : [RuExp]) -> [RuHF] {
	sub = ruHAtomExp(ctx, key); ar = ruEqArgs(sub); a = ar.first; b = ar.second;
	map(witnesses, \e -> {
		implExp = ruHMkExp(s2id_("wi"), ctx.wff, [ruHMkExp(ruHwcel(), ctx.wff, [e, a]), ruHMkExp(ruHwcel(), ctx.wff, [e, b])]);
		ctx.atomNodes := mergeTree(^(ctx.atomNodes), ruPAtomNodes(ctx.conn, implExp));
		content = ruPAtomize(ctx.conn, implExp);   // (e∈A → e∈B)
		switch (amb) {
			None():  RuHF(content, ruHStep(ctx, "ax-mp", [f.tree, ruHStep(ctx, "ssel", [], RuPImp(f.content, content))], content));
			Some(w): RuHF(content, ruHStep(ctx, "sseld", [f.tree], RuPImp(w, content)));   // (W→A⊆B) ⊢ (W→(e∈A→e∈B))
		};
	});
}
// instantiate an = FACT `A=B` at each witness e → the membership iff `(e∈A ↔ e∈B)` (eleq2 / eleq2d). Lets
// the bridge use `=` hyps (e.g. `(X∪Y)=∅`) — the dominant core-but-not-cert class. The iff then ↔-elims.
ruHEqInst(ctx : RuHCtx, amb : Maybe<RuPForm>, f : RuHF, key : string, witnesses : [RuExp]) -> [RuHF] {
	sub = ruHAtomExp(ctx, key); ar = ruEqArgs(sub); a = ar.first; b = ar.second;
	if (ctx.em.env.conf.verbose >= 6) {
		ctx.em.env.out.println("        hEqInst: eq=" + ru2s(sub, ctx.em.math) + " witnesses=" + strGlue(map(witnesses, \w -> ru2s(w, ctx.em.math)), ","));
	} else {};
	concatA(map(witnesses, \e -> {
		iffExp = ruHMkExp(s2id_("wb"), ctx.wff, [ruHMkExp(ruHwcel(), ctx.wff, [e, a]), ruHMkExp(ruHwcel(), ctx.wff, [e, b])]);
		ctx.atomNodes := mergeTree(^(ctx.atomNodes), ruPAtomNodes(ctx.conn, iffExp));
		content = ruPAtomize(ctx.conn, iffExp);   // (e∈A ↔ e∈B)
		fBi = switch (amb) {
			None():  RuHF(content, ruHStep(ctx, "ax-mp", [f.tree, ruHStep(ctx, "eleq2", [], RuPImp(f.content, content))], content));
			Some(w): RuHF(content, ruHStep(ctx, "eleq2d", [f.tree], RuPImp(w, content)));   // (W→A=B) ⊢ (W→(e∈A↔e∈B))
		};
		// (the ∅-side ¬(e∈A) shortcut proved redundant — the bicond + noel + tollens
		// saturation reaches it; a direct emission here was dead weight)
		[fBi];
	}));
}
// reduce a ⊆/= GOAL atom to its fresh-witness membership subgoal, prove it, wrap with ssriv/ssrdv (eqriv/eqrdv).
ruHRelGoal(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], key : string, fuel : int) -> Maybe<RuHF> {
	goalExp = ruHAtomExp(ctx, key); head = ruEqHead(goalExp);
	isSubset = head == ruHwss(); isEq = head == ruHwceq();
	if (!isSubset && !isEq) None()
	else {
		ambExps = switch (amb) { None(): []; Some(w): [RuExp(ruHForm2Nodes(ctx, w), -1)]; };   // W's vars → DV
		red = ruEqualizerRelSubgoal(ctx.em, ctx.conn, ctx.wff, ctx.stmtClass, ambExps, goalExp, isSubset);
		ctx.atomNodes := mergeTree(^(ctx.atomNodes), ruPAtomNodes(ctx.conn, red.subgoal));
		ctx.disjs     := mergeSets(^(ctx.disjs), red.disjs);
		ctx.freshVars := arrayPush(^(ctx.freshVars), red.fresh);
		subForm = ruPAtomize(ctx.conn, red.subgoal);
		lemma = switch (amb) {
			None():  if (isSubset) "ssriv" else "eqriv";
			Some(__): if (isSubset) "ssrdv" else "eqrdv";
		};
		maybeMap(ruHProve(ctx, amb, facts, subForm, fuel - 1), \sub ->
			RuHF(RuPAtom(key), ruHStep(ctx, lemma, [sub.tree], ruHUnd(amb, RuPAtom(key)))));
	}
}

// ---- ∈-over-operation unfold (the bridge introduces fresh-witness `v∈(compound)` the equalizer front-
// end never sees; unfold it here to the boolean / ⊆ / = core the emitter handles). Both directions of the
// el-lemma ↔: fact `v∈S` → RHS (mpbi/sylib); goal `v∈S` → prove RHS then LHS (mpbir/sylibr). ---------
ruHUnaryArg(set : RuExp) -> RuExp { RuExp(tail(set.nodes), -1); }   // operand of a unary head (𝒫A, {A})
ruHRegAtom(ctx : RuHCtx, ex : RuExp) -> RuPForm {                   // register an expr's nodes, atomize
	ctx.atomNodes := mergeTree(^(ctx.atomNodes), ruPAtomNodes(ctx.conn, ex));
	ruPAtomize(ctx.conn, ex);
}
// element `e` (class) ∈ a COMPOUND `set` → (unfolded RHS form, el-lemma name, the
// lemma's extra hyp-proof children — the G-form setness antecedent). None for a base set.
ruHMembUnfold(ctx : RuHCtx, e : RuExp, set : RuExp) -> Maybe<Triple<RuPForm, string, [RuProofTree]>> {
	h = ruEqHead(set);
	memb = \x -> ruHRegAtom(ctx, ruHMkExp(ruHwcel(), ctx.wff, [e, x]));
	// velpw/velsn carry a SETVAR element locus — legal only for a plain (coerced)
	// setvar element; a CLASS-metavar or compound element (class-loci articles) uses
	// the HYP-CARRYING twin (elpw/elsn: A ∈ _V ⊢ bicond) with the setness discharged
	// from the certificate's own setness facts (the pool) or the mechanical registry.
	// elun/elin/eldif are class-general and need no setness.
	// MEMOIZED per certificate: the recursive setness prover runs at every unfold attempt, and
	// the same handful of terms recur down the whole emitter recursion — with the pool making
	// class-metavar setness PROVABLE, the uncached scans measurably slow big certificates
	// (t19 needed 60 s instead of 10 s).
	setnessOf = \ -> if (ruHPlainSetvar(e)) None() else {
		key = ruUKey(e);
		switch (lookupTree(^(ctx.setMemo), key)) {
			Some(m): m;
			None(): {
				m = ruSetnessProofPool(ruSetnessRegistry(ctx.em.math), ctx.setPool, e,
					ctx.stmtClass, ctx.em.math, ctx.em.env, 8);
				if (m == None() && ruDeclinesOn(ctx.em.env)) {
					ruDecline(ctx.em.env, "emitter/membership-char", "setness unprovable (pool " + i2s(sizeTree(ctx.setPool)) + ")",
						ru2s(e, ctx.em.math));
				} else {};
				ctx.setMemo := setTree(^(ctx.setMemo), key, m);
				m;
			}
		}
	};
	if (h == s2id_("cun"))       { a = ruEqArgs(set); Some(Triple(RuPOr(memb(a.first), memb(a.second)), "elun", [])); }
	else if (h == s2id_("cin"))  { a = ruEqArgs(set); Some(Triple(RuPAnd(memb(a.first), memb(a.second)), "elin", [])); }
	else if (h == s2id_("cdif")) { a = ruEqArgs(set); Some(Triple(RuPAnd(memb(a.first), RuPNot(memb(a.second))), "eldif", [])); }
	else if (h == s2id_("cpw")) {
		if (ruHPlainSetvar(e))
			Some(Triple(ruHRegAtom(ctx, ruHMkExp(ruHwss(), ctx.wff, [e, ruHUnaryArg(set)])), "velpw", []))   // e⊆A
		else switch (setnessOf()) {
			Some(sp): Some(Triple(ruHRegAtom(ctx, ruHMkExp(ruHwss(), ctx.wff, [e, ruHUnaryArg(set)])), "elpw", [sp]));
			None(): None();
		}
	}
	else if (h == s2id_("csn")) {
		if (ruHPlainSetvar(e))
			Some(Triple(ruHRegAtom(ctx, ruHMkExp(ruHwceq(), ctx.wff, [e, ruHUnaryArg(set)])), "velsn", []))  // e=A
		else switch (setnessOf()) {
			Some(sp): Some(Triple(ruHRegAtom(ctx, ruHMkExp(ruHwceq(), ctx.wff, [e, ruHUnaryArg(set)])), "elsn", [sp]));
			None(): None();
		}
	}
	else None();
}
// a plain (coerced) setvar element: [cv, x] — a 1-ary class-typed head over a setvar var
ruHPlainSetvar(e : RuExp) -> bool {
	length(e.nodes) == 2
	&& switch (e.nodes[0]) {
		RuRuleNode(idT, al): ruArityLen2Arity(al) == 1 && ruIdType2Type(idT) == tp2id_("class");
		RuVar(__, __): false;
	}
	&& switch (e.nodes[1]) {
		RuVar(__, tp): tp == tp2id_("setvar");
		RuRuleNode(__, __): false;
	};
}
// from a fact `e∈S` derive its unfold RHS via the el-lemma iff (mpbi bare / sylib in deduction form).
ruHMembFact(ctx : RuHCtx, amb : Maybe<RuPForm>, f : RuHF, key : string, rhs : RuPForm, lemma : string, lemmaKids : [RuProofTree]) -> RuHF {
	iff = ruHStep(ctx, lemma, lemmaKids, RuPIff(RuPAtom(key), rhs));
	switch (amb) {
		None():  RuHF(rhs, ruHStep(ctx, "mpbi", [f.tree, iff], rhs));
		Some(w): RuHF(rhs, ruHStep(ctx, "sylib", [f.tree, iff], RuPImp(w, rhs)));
	}
}
// the NEGATED twin, as UNIT RESOLUTION: fact ¬(v∈COMPOUND) whose unfold is (a∧b) with one
// conjunct a PRESENT FACT resolves to the negation of the other (t84: ¬(v∈(x5∩x9)) + v∈x5
// ⊢ ¬(v∈x9)). The ¬(a∧b) intermediate NEVER becomes a lasting fact — as a fact it derails
// unrelated searches (t48 flipped when it joined the saturation).
//   ¬(v∈X) --sylnib/mtbi across the unfold bicond--> ¬(a∧b)
//   --mpbir/sylibr across imnan--> (a→¬b) --ax-mp/mpd with a--> ¬b   (symmetrically for b)
ruHMembNegResolve(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], f : RuHF, key : string, rhs : RuPForm, lemma : string, lemmaKids : [RuProofTree]) -> [RuHF] {
	switch (rhs) {
		RuPAnd(a, b): {
			iff = ruHStep(ctx, lemma, lemmaKids, RuPIff(RuPAtom(key), rhs));
			nAnd = switch (amb) {
				None():  ruHStep(ctx, "mtbi", [f.tree, iff], RuPNot(rhs));
				Some(w): ruHStep(ctx, "sylnib", [f.tree, iff], RuPImp(w, RuPNot(rhs)));
			};
			resolve = \haveF : RuHF, have : RuPForm, other : RuPForm -> {
				// (have → ¬other) ↔ ¬(have ∧ other): for the b-side use ancom first? No —
				// imnan is (φ→¬ψ)↔¬(φ∧ψ); the b-side resolution needs ¬(a∧b) with b known:
				// con2-style; keep it to the a-side + the commuted bicond via ancomi below.
				imn = ruHStep(ctx, "imnan", [], RuPIff(RuPImp(have, RuPNot(other)), RuPNot(RuPAnd(have, other))));
				impF = switch (amb) {
					None():  ruHStep(ctx, "mpbir", [nAnd, imn], RuPImp(have, RuPNot(other)));
					Some(w): ruHStep(ctx, "sylibr", [nAnd, imn], RuPImp(w, RuPImp(have, RuPNot(other))));
				};
				nOther = RuPNot(other);
				switch (amb) {
					None():  RuHF(nOther, ruHStep(ctx, "ax-mp", [haveF.tree, impF], nOther));
					Some(w): RuHF(nOther, ruHStep(ctx, "mpd", [haveF.tree, impF], RuPImp(w, nOther)));
				};
			};
			switch (ruHFind(facts, a)) {
				Some(fa): [resolve(fa, a, b)];
				None(): [];
			}
		}
		default: [];
	}
}
// prove a GOAL `e∈S` (compound) by proving its unfold RHS, then mpbir/sylibr back to `e∈S`.
ruHMembGoal(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], key : string, fuel : int) -> Maybe<RuHF> {
	ea = ruHAtomExp(ctx, key); args = ruEqArgs(ea);
	switch (ruHMembUnfold(ctx, args.first, args.second)) {
		None(): None();
		Some(p): maybeMap(ruHProve(ctx, amb, facts, p.first, fuel - 1), \sub -> {
			iff = ruHStep(ctx, p.second, p.third, RuPIff(RuPAtom(key), p.first));
			switch (amb) {
				None():  RuHF(RuPAtom(key), ruHStep(ctx, "mpbir", [sub.tree, iff], RuPAtom(key)));
				Some(w): RuHF(RuPAtom(key), ruHStep(ctx, "sylibr", [sub.tree, iff], RuPImp(w, RuPAtom(key))));
			};
		});
	}
}

// deneg: a Mizar implication arrives NEGATION-wrapped as `¬(A∧¬B)` (or `¬(A∧X)`); convert it to the
// implication `A→B` (iman) / `A→¬X` (imnan) and prove THAT — the emitter's direct →R + ⊆/=/∈ bridge path
// (which already closes implication-form goals like t10/t18) handles it, where the bare ¬-goal would only
// reach the weaker refutation/case-split path. Nested `¬(A∧(B∧¬C))` peels one layer → `A→¬(B∧¬C)` → recurse.
ruHDeneg(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], inner : RuPForm, fuel : int) -> Maybe<RuHF> {
	switch (inner) {
		RuPAnd(a, b): {
			di = switch (b) { RuPNot(c): Pair(RuPImp(a, c), "iman"); default: Pair(RuPImp(a, RuPNot(b)), "imnan"); };
			impForm = di.first; goal = RuPNot(inner);
			maybeMap(ruHProve(ctx, amb, facts, impForm, fuel - 1), \pi -> {
				iff = ruHStep(ctx, di.second, [], RuPIff(impForm, goal));   // (A→…) ↔ ¬(A∧…)
				switch (amb) {
					None():  RuHF(goal, ruHStep(ctx, "mpbi", [pi.tree, iff], goal));
					Some(w): RuHF(goal, ruHStep(ctx, "sylib", [pi.tree, iff], RuPImp(w, goal)));
				};
			});
		}
		RuPIff(a, b): {
			// ¬(A↔B) via xor3: prove (A↔¬B), convert across ¬(A↔B) ↔ (A↔¬B).
			goal = RuPNot(inner);
			alt = RuPIff(a, RuPNot(b));
			maybeMap(ruHProve(ctx, amb, facts, alt, fuel - 1), \pa -> {
				iff = ruHStep(ctx, "xor3", [], RuPIff(goal, alt));   // ¬(A↔B) ↔ (A↔¬B)
				switch (amb) {
					None():  RuHF(goal, ruHStep(ctx, "mpbir", [pa.tree, iff], goal));
					Some(w): RuHF(goal, ruHStep(ctx, "sylibr", [pa.tree, iff], RuPImp(w, goal)));
				};
			});
		}
		default: None();
	}
}

// S5 CLASH-BY-DERIVATION (Mizar's clash detect): a fact ¬φ with DECOMPOSABLE φ clashes
// when φ is derivable from the other facts — ruHFindContra only matches EXISTING pairs,
// so ¬((Q→R)∧((R→Q)∧P)) never clashed even with Q,R,P all in context. Bounded: first
// few ¬-compound facts, derivation at reduced fuel; ExFalso yields any goal.
ruHClashDerive(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], goal : RuPForm, fuel : int) -> Maybe<RuHF> {
	if (^(ctx.inClash)) None() else {   // NO re-entry: nested clash attempts multiply the search
	// FEASIBILITY pre-filter: an ∧-candidate with an atomic leaf that is neither a present
	// fact nor a composable compound membership can never derive — attempting it at every
	// failing entry is pure drag (t48: the ¬((v∈{x5})∧(v∈x16)) junk with bare x16).
	leafFeasible = \a : RuPForm -> switch (a) {
		RuPAtom(k): ruHFind(facts, a) != None() || {
			ea = ruHAtomExp(ctx, k);
			ruEqHead(ea) == ruHwcel() && length((ruEqArgs(ea)).second.nodes) > 2;
		}
		default: true;   // non-atomic leaves derive structurally
	};
	feasible = \phi : RuPForm -> forall(ruHAndLeaves(phi), leafFeasible);
	cands = filtermap(facts, \f -> switch (f.content) {
		RuPNot(phi): switch (phi) {
			RuPAnd(__, __): if (feasible(phi)) Some(Pair(phi, f)) else None();
			RuPIff(__, __): Some(Pair(phi, f));
			// ¬(v ∈ COMPOUND): the membership composes from its unfold's conjuncts
			// (ruHMembGoal) — the witness route's v∈(x5∩(x7∩x9)) (S2/S3 piece).
			RuPAtom(k): {
				ea = ruHAtomExp(ctx, k);
				if (ruEqHead(ea) == ruHwcel() && length((ruEqArgs(ea)).second.nodes) > 2) Some(Pair(phi, f)) else None();
			}
			default: None();
		}
		default: None();
	});
	// SHALLOW derivations only (fuel ≤ 6): the clash φ is a direct composition of present
	// facts (nested ∧-intro / membership-goal unfolds — t77's v∈(x5∩(x7∩x9)) needs 5);
	// full-fuel attempts at every failing entry multiply the whole search — the
	// hilbert-fallback cost bomb (t86 closed 1s → timeout, measured).
	r = fold(take(cands, 2), None(), \acc, c -> switch (acc) {
		Some(__): acc;
		None(): if (ruTimeIsOver(ctx.timer)) None()
			else {
				ctx.inClash := true;
				pphiMb = ruHProve(ctx, amb, facts, c.first, min(fuel - 1, 6));
				ctx.inClash := false;
				switch (pphiMb) {
				None(): None();
				Some(pphi): {
					pm  = ruHStep(ctx, "pm2.21", [], RuPImp(RuPNot(c.first), RuPImp(c.first, goal)));
					Some(switch (amb) {
						None(): {
							impAG = ruHStep(ctx, "ax-mp", [c.second.tree, pm], RuPImp(c.first, goal));
							RuHF(goal, ruHStep(ctx, "ax-mp", [pphi.tree, impAG], goal));
						}
						Some(w): {
							sylr = ruHStep(ctx, "syl", [c.second.tree, pm], RuPImp(w, RuPImp(c.first, goal)));
							RuHF(goal, ruHStep(ctx, "mpd", [pphi.tree, sylr], RuPImp(w, goal)));
						}
					});
				}
			}
			}
	});
	r;
	}
}

// ---- S4d BRANCH SKOLEMIZATION: ∃-elimination inside the certificate ---------
// A branch atom fact with a scanned ∃-unfold (the eluni class: (v∈∪A) ↔ ∃y((v∈y)∧(y∈A)))
// is OPAQUE to the propositional check — the t126-class endgame lives behind it.
// Eliminate it natively:
//   1. unfold to ∃yψ in deduction form (mpbi / sylib across the bicond instance),
//      y a FRESH eigenvariable;
//   2. instantiate the branch's ∀-atom facts at y and at the branch's setvars (the
//      Unifier draws on the new constant — the pairwise-disjointness ∀∀-premise meets
//      its eigenvariables here); nested ∀∀ gets one more round;
//   3. prove the goal under the assumption ψ (the ordinary deduction-theorem lift);
//   4. discharge:  amb None:    (ψ→G) —exlimiv→ (∃yψ→G) —ax-mp→ G          [DV(y, G)]
//                  amb Some(w): (w→∃yψ), ((w∧ψ)→G) —exlimddv→ (w→G)        [DV(y,w), DV(y,G)]
// Tried AFTER the structural/clash routes fail, BEFORE the classical case-split.
// Bounded: ctx.exElims eliminations per certificate (restored on failure), ctx.exSeen
// (no re-elimination of the same atom down the recursion), fuel and the wall timer.
ruHExElim(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], goal : RuPForm, fuel : int) -> Maybe<RuHF> {
	if (fuel <= 0 || ^(ctx.exElims) <= 0 || ^(ctx.exElimsGlobal) <= 0 || ruTimeIsOver(ctx.timer)) None()
	else {
		math = ctx.em.math;
		env = ctx.em.env;
		// cheap pre-scan: head gate + the per-certificate negative cache — the full match +
		// `used` fold must NOT run at every failing entry (it alone starved t101)
		pre = filtermap(facts, \f -> switch (f.content) {
			RuPAtom(k): if (containsSet(^(ctx.exSeen), k) || containsSet(^(ctx.exNoMatch), k)
					|| !ruInHasExUnfold(math, ruEqHead(ruHAtomExp(ctx, k)))) None()
				else Some(Pair(f, k));
			default: None();
		});
		cands = if (pre == []) [] else {
			// every var id the certificate knows (atom exprs + fresh vars): the eigenvar must be new
			used0 = foldTree(^(ctx.atomNodes), makeSet(), \__, nodes, acc ->
				fold(nodes, acc, \a, n -> switch (n) { RuVar(id, __): insertSet(a, id); RuRuleNode(__, __): a; }));
			used = fold(^(ctx.freshVars), used0, \a, v -> insertSet(a, v.id));
			filtermap(pre, \p -> switch (ruInExUnfoldAt(math, env, ctx.stmtClass, ruHAtomExp(ctx, p.second), used)) {
				None(): {
					ctx.exNoMatch := insertSet(^(ctx.exNoMatch), p.second);
					None();
				}
				Some(u): Some(Triple(p.first, p.second, u));
			});
		};
		fold(take(cands, 2), None(), \acc : Maybe<RuHF>, c -> switch (acc) {
			Some(__): acc;
			None(): if (ruTimeIsOver(ctx.timer)) None()
			else {
				f = c.first;
				k = c.second;
				u = c.third;
				// the deduction-form ∃-fact: ⊢ ∃yψ (bare) / (w→∃yψ)
				exFact = switch (amb) {
					None(): RuProofStep(s2id_("mpbi"), [f.tree, u.pBi], RuStmt(ctx.stmtClass, [u.exForm], -1));
					Some(w): {
						wExp = RuExp(ruHForm2Nodes(ctx, w), -1);
						RuProofStep(s2id_("sylib"), [f.tree, u.pBi],
							RuStmt(ctx.stmtClass, [ruFwdMkRule(s2id("wi"), ctx.wff, [wExp, u.exForm])], -1));
					}
				};
				ctx.atomNodes := mergeTree(^(ctx.atomNodes), ruPAtomNodes(ctx.conn, u.body));
				psi = ruPAtomize(ctx.conn, u.body);
				// the Unifier increment: ∀-atom facts instantiated at the eigenvar + branch setvars
				instFacts = ruHExForallInsts(ctx, amb, facts, u.eigen);
				if (env.conf.verbose >= 5) {
					env.out.println("      hExElim: atom=" + ru2s(ruHAtomExp(ctx, k), math) + " ex=" + ru2s(u.exForm, math)
						+ " forallInsts=" + i2s(length(instFacts)) + " fuel=" + i2s(fuel) + " left=" + i2s(^(ctx.exElimsGlobal)));
				} else {};
				// recurse under ψ; the path budget/seen roll back on failure, the global cap never does
				seen0 = ^(ctx.exSeen);
				el0 = ^(ctx.exElims);
				ctx.exSeen := insertSet(seen0, k);
				ctx.exElims := el0 - 1;
				ctx.exElimsGlobal := ^(ctx.exElimsGlobal) - 1;
				sub = ruHProveUnder(ctx, amb, concat(facts, instFacts), psi, goal, fuel - 1);
				switch (sub) {
					None(): {
						ctx.exSeen := seen0;
						ctx.exElims := el0;
						None();
					}
					Some(ps): {
						goalExp = RuExp(ruHForm2Nodes(ctx, goal), -1);
						gdvs = fold(ruInVarsOf(goalExp), u.disjs, \ds, gv ->
							if (gv.id == u.eigen.id) ds else insertSet(ds, RuDisj(gv, u.eigen)));
						r = switch (amb) {
							None(): {
								// exlimiv: DV(y, goal) — (ψ→G) ⊢ (∃yψ→G); ax-mp with ⊢∃yψ
								ctx.disjs := mergeSets(^(ctx.disjs), gdvs);
								exImp = ruFwdMkRule(s2id("wi"), ctx.wff, [u.exForm, goalExp]);
								pEx = RuProofStep(s2id_("exlimiv"), [ps.tree], RuStmt(ctx.stmtClass, [exImp], -1));
								RuHF(goal, RuProofStep(s2id_("ax-mp"), [exFact, pEx], RuStmt(ctx.stmtClass, [goalExp], -1)));
							}
							Some(w): {
								wExp = RuExp(ruHForm2Nodes(ctx, w), -1);
								wdvs = fold(ruInVarsOf(wExp), gdvs, \ds, wv ->
									if (wv.id == u.eigen.id) ds else insertSet(ds, RuDisj(wv, u.eigen)));
								ctx.disjs := mergeSets(^(ctx.disjs), wdvs);
								// exlimddv: (w→∃yψ), ((w∧ψ)→G) ⊢ (w→G); DV(y,w), DV(y,G)
								RuHF(goal, RuProofStep(s2id_("exlimddv"), [exFact, ps.tree],
									RuStmt(ctx.stmtClass, [ruFwdMkRule(s2id("wi"), ctx.wff, [wExp, goalExp])], -1)));
							}
						};
						ctx.freshVars := arrayPush(^(ctx.freshVars), u.eigen);
						Some(r);
					}
				}
			}
		});
	}
}

// The ∀-atom branch facts instantiated at the eigenvar and the branch's setvars (cap 3
// terms, 8 instances; one nested round for still-∀-headed instances — the ∀∀-premises).
// Composition per fact form: ax-mp (bare) / syl (deduction form) with the closed spcv
// implication ruInForallInstVar builds.
ruHExForallInsts(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], eigen : RuVar) -> [RuHF] {
	math = ctx.em.math;
	env = ctx.em.env;
	walId = s2id("wal");
	setvarT = tp2id_("setvar");
	branchVars = fold(facts, [], \acc, f -> switch (f.content) {
		RuPAtom(k): fold(ruInVarsOf(ruHAtomExp(ctx, k)), acc, \a, v ->
			if (v.type != setvarT || v.id == eigen.id || exists(a, \x -> x.id == v.id)) a else arrayPush(a, v));
		default: acc;
	});
	terms = concat([eigen], take(branchVars, 3));
	forallFacts = filtermap(facts, \f -> switch (f.content) {
		RuPAtom(k): {
			ea = ruHAtomExp(ctx, k);
			if (ruInHead(ea) == walId) Some(Pair(f, ea)) else None();
		}
		default: None();
	});
	inst1 = \pf : Pair<RuHF, RuExp>, v : RuVar -> maybeMap(ruInForallInstVar(math, env, ctx.stmtClass, pf.second, v), \tr -> {
		instExp = tr.first;
		tree = switch (amb) {
			None(): RuProofStep(s2id_("ax-mp"), [pf.first.tree, tr.second], RuStmt(ctx.stmtClass, [instExp], -1));
			Some(w): {
				wExp = RuExp(ruHForm2Nodes(ctx, w), -1);
				RuProofStep(s2id_("syl"), [pf.first.tree, tr.second],
					RuStmt(ctx.stmtClass, [ruFwdMkRule(s2id("wi"), ctx.wff, [wExp, instExp])], -1));
			}
		};
		ctx.disjs := mergeSets(^(ctx.disjs), tr.third);
		ctx.atomNodes := mergeTree(^(ctx.atomNodes), ruPAtomNodes(ctx.conn, instExp));
		Pair(RuHF(ruPAtomize(ctx.conn, instExp), tree), instExp);
	});
	round = \pfs : [Pair<RuHF, RuExp>] -> fold(pfs, [], \acc : [Pair<RuHF, RuExp>], pf ->
		fold(terms, acc, \a, v -> if (length(a) >= 8) a else switch (inst1(pf, v)) {
			None(): a;
			Some(p): if (exists(a, \q -> q.second.nodes == p.second.nodes)
				|| exists(facts, \q -> q.content == p.first.content)) a else arrayPush(a, p);
		}));
	r1 = round(forallFacts);
	// nested ∀∀ (the pairwise-disjointness premise): one more round over ∀-headed instances
	nested = filter(r1, \p -> ruInHead(p.second) == walId);
	r2 = if (nested == []) [] else round(map(nested, \p -> Pair(p.first, p.second)));
	map(concat(r1, r2), firstOfPair);
}

// e∈∅ is false (noel: ¬(A∈∅)) — derive ¬(e∈∅) so the contradiction-closure discharges the goal.
ruHNoel(ctx : RuHCtx, amb : Maybe<RuPForm>, key : string) -> RuHF {
	notAtom = RuPNot(RuPAtom(key));
	noelInst = ruHStep(ctx, "noel", [], notAtom);   // closed ¬(e∈∅)
	switch (amb) {
		None():  RuHF(notAtom, noelInst);
		Some(w): RuHF(notAtom, ruHStep(ctx, "a1i", [noelInst], RuPImp(w, notAtom)));   // |-¬(e∈∅) ⊢ (W→¬(e∈∅))
	}
}

// ---- forward saturation ----------------------------------------------------
ruHFind(facts : [RuHF], f : RuPForm) -> Maybe<RuHF> { find(facts, \fc -> fc.content == f); }

// one derivation pass: ∧-elim on every conjunction fact + MP on every implication fact whose antecedent is
// known + ⊆-fact instantiation (sseld/ssel) at every membership witness in scope.
ruHForward(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF]) -> [RuHF] {
	witnesses = ruHWitnesses(ctx, facts);
	concatA(map(facts, \f ->
		switch (f.content) {
			RuPAnd(a, b): [ruHConjElim(ctx, amb, f, a, b, true), ruHConjElim(ctx, amb, f, a, b, false)];
			RuPIff(a, b): [ruHIffElim(ctx, amb, f, a, b, true), ruHIffElim(ctx, amb, f, a, b, false)];
			RuPImp(a, b): switch (ruHCheapProve(ctx, amb, facts, a)) {
				Some(fa): [ruHModus(ctx, amb, fa, f, a, b)];
				None(): switch (ruHFind(facts, RuPNot(b))) {
					Some(fnb): [ruHTollens(ctx, amb, fnb, f, a)];
					None(): [];
				}
			};
			RuPNot(a): switch (a) {
				RuPNot(x): [ruHNotNot(ctx, amb, f, x)];  // ¬¬x ⊢ x
				RuPAnd(x, y): switch (ruHFind(facts, x)) {   // LEFT-UNIT RESOLUTION (S4d): ¬(X∧Y) + X ⊢ ¬Y
					// (imnan: (X→¬Y) ↔ ¬(X∧Y); the ∀∀-premise instances arrive as ¬(a∈A ∧ (b∈B ∧ ¬C))
					// and resolve left-to-right down to their decided literal)
					Some(fx): {
						impF = RuPImp(x, RuPNot(y));
						imnanInst = ruHStep(ctx, "imnan", [], RuPIff(impF, RuPNot(RuPAnd(x, y))));
						fimp = switch (amb) {
							None():  RuHF(impF, ruHStep(ctx, "mpbir", [f.tree, imnanInst], impF));
							Some(w): RuHF(impF, ruHStep(ctx, "sylibr", [f.tree, imnanInst], RuPImp(w, impF)));
						};
						[ruHModus(ctx, amb, fx, fimp, x, RuPNot(y))];
					}
					None(): [];
				};
				RuPAtom(k): {   // ¬(v∈COMPOUND): UNIT-RESOLVE against present conjunct facts
					ea = ruHAtomExp(ctx, k);
					if (ruEqHead(ea) != ruHwcel()) [] else {
						ar = ruEqArgs(ea);
						switch (ruHMembUnfold(ctx, ar.first, ar.second)) {
							Some(p): ruHMembNegResolve(ctx, amb, facts, f, k, p.first, p.second, p.third);
							None(): [];
						}
					}
				}
				default: [];
			};
			RuPAtom(k): {
				ea = ruHAtomExp(ctx, k); h = ruEqHead(ea);
				refl = h == ruHwceq() && { s = ruEqArgs(ea); s.first.nodes == s.second.nodes; };
				if (h == ruHwss() && witnesses != []) ruHRelInst(ctx, amb, f, k, witnesses)
					else if (h == ruHwceq() && !refl && witnesses != []) ruHEqInst(ctx, amb, f, k, witnesses)
				else if (h == ruHwcel()) { ar = ruEqArgs(ea); if (ruEqHead(ar.second) == s2id_("c0")) [ruHNoel(ctx, amb, k)] else switch (ruHMembUnfold(ctx, ar.first, ar.second)) { Some(p): [ruHMembFact(ctx, amb, f, k, p.first, p.second, p.third)]; None(): []; }; }
				else [];
			};
			default: [];
		}
	));
}
// from a fact proving (A∧B), extract A (left) or B (right).
ruHConjElim(ctx : RuHCtx, amb : Maybe<RuPForm>, f : RuHF, a : RuPForm, b : RuPForm, left : bool) -> RuHF {
	tgt = if (left) a else b;
	switch (amb) {
		None():  RuHF(tgt, ruHStep(ctx, "ax-mp", [f.tree, ruHStep(ctx, if (left) "simpl" else "simpr", [], RuPImp(RuPAnd(a, b), tgt))], tgt));
		Some(w): RuHF(tgt, ruHStep(ctx, if (left) "simpld" else "simprd", [f.tree], RuPImp(w, tgt)));
	}
}
// from a fact proving (A↔B), extract (A→B) (fwd) or (B→A).
ruHIffElim(ctx : RuHCtx, amb : Maybe<RuPForm>, f : RuHF, a : RuPForm, b : RuPForm, fwd : bool) -> RuHF {
	tgt = if (fwd) RuPImp(a, b) else RuPImp(b, a);
	switch (amb) {
		None():  RuHF(tgt, ruHStep(ctx, "ax-mp", [f.tree, ruHStep(ctx, if (fwd) "biimp" else "biimpr", [], RuPImp(RuPIff(a, b), tgt))], tgt));
		Some(w): RuHF(tgt, ruHStep(ctx, if (fwd) "biimpd" else "biimprd", [f.tree], RuPImp(w, tgt)));
	}
}
// from facts proving A and (A→B), derive B.
ruHModus(ctx : RuHCtx, amb : Maybe<RuPForm>, fa : RuHF, fimp : RuHF, a : RuPForm, b : RuPForm) -> RuHF {
	switch (amb) {
		None():  RuHF(b, ruHStep(ctx, "ax-mp", [fa.tree, fimp.tree], b));
		Some(w): RuHF(b, ruHStep(ctx, "mpd", [fa.tree, fimp.tree], RuPImp(w, b)));  // (W→A),(W→(A→B)) ⊢ (W→B)
	}
}
// modus TOLLENS: fact (A→B) + ¬B ⊢ ¬A — the witness route's ¬(v∈A) from the pointwise
// bicond implication and noel (S2/S3 branch-Unifier piece).
ruHTollens(ctx : RuHCtx, amb : Maybe<RuPForm>, fnb : RuHF, fimp : RuHF, a : RuPForm) -> RuHF {
	na = RuPNot(a);
	switch (amb) {
		None():  RuHF(na, ruHStep(ctx, "mto", [fnb.tree, fimp.tree], na));
		Some(w): RuHF(na, ruHStep(ctx, "mtod", [fnb.tree, fimp.tree], RuPImp(w, na)));  // (W→¬B),(W→(A→B)) ⊢ (W→¬A)
	}
}
// cheap (non-recursive) antecedent derivation: a is a known fact, or a disjunction with a known disjunct
// (∨-intro), or a conjunction of knowns (∧-intro). Lets saturation FIRE an implication fact `(a→b)` whose
// antecedent isn't literally present (e.g. derive `p∨q` from `p` to apply `((p∨q)→r)`). No recursion.
ruHCheapProve(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], a : RuPForm) -> Maybe<RuHF> {
	switch (ruHFind(facts, a)) {
		Some(f): Some(f);
		None(): switch (a) {
			RuPOr(x, y): switch (ruHFind(facts, x)) {
				Some(fx): Some(ruHOrIntro(ctx, amb, fx, x, y, true));
				None(): switch (ruHFind(facts, y)) { Some(fy): Some(ruHOrIntro(ctx, amb, fy, x, y, false)); None(): None(); };
			};
			RuPAnd(x, y): switch (ruHFind(facts, x)) {
				Some(fx): switch (ruHFind(facts, y)) { Some(fy): Some(ruHAndIntro(ctx, amb, fx, fy, x, y)); None(): None(); };
				None(): None();
			};
			RuPAtom(k): ruHCheapMemb(ctx, amb, facts, k);   // e∈(compound) → unfold + cheap-prove RHS (fires `(e∈S)→…` facts)
			default: None();
		};
	}
}
// cheap-prove a membership-over-op goal `e∈S`: unfold (elun/…) + cheap-prove the RHS, wrap via mpbir/sylibr.
ruHCheapMemb(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], key : string) -> Maybe<RuHF> {
	ea = ruHAtomExp(ctx, key);
	if (ruEqHead(ea) != ruHwcel()) None()
	else {
		args = ruEqArgs(ea);
		switch (ruHMembUnfold(ctx, args.first, args.second)) {
			None(): None();
			Some(p): maybeMap(ruHCheapProve(ctx, amb, facts, p.first), \sub -> {
				iff = ruHStep(ctx, p.second, p.third, RuPIff(RuPAtom(key), p.first));
				switch (amb) {
					None():  RuHF(RuPAtom(key), ruHStep(ctx, "mpbir", [sub.tree, iff], RuPAtom(key)));
					Some(w): RuHF(RuPAtom(key), ruHStep(ctx, "sylibr", [sub.tree, iff], RuPImp(w, RuPAtom(key))));
				};
			});
		}
	}
}
ruHOrIntro(ctx : RuHCtx, amb : Maybe<RuPForm>, fx : RuHF, x : RuPForm, y : RuPForm, left : bool) -> RuHF {
	disj = RuPOr(x, y);
	switch (amb) {
		None():  RuHF(disj, ruHStep(ctx, "ax-mp", [fx.tree, ruHStep(ctx, if (left) "orc" else "olc", [], RuPImp(if (left) x else y, disj))], disj));
		Some(w): RuHF(disj, ruHStep(ctx, if (left) "orcd" else "olcd", [fx.tree], RuPImp(w, disj)));
	}
}
ruHAndIntro(ctx : RuHCtx, amb : Maybe<RuPForm>, fx : RuHF, fy : RuHF, x : RuPForm, y : RuPForm) -> RuHF {
	conj = RuPAnd(x, y);
	switch (amb) {
		None():  RuHF(conj, ruHStep(ctx, "pm3.2i", [fx.tree, fy.tree], conj));
		Some(w): RuHF(conj, ruHStep(ctx, "jca", [fx.tree, fy.tree], RuPImp(w, conj)));
	}
}
// from a fact proving ¬¬x, derive x (notnotr).
ruHNotNot(ctx : RuHCtx, amb : Maybe<RuPForm>, f : RuHF, x : RuPForm) -> RuHF {
	nnr = ruHStep(ctx, "notnotr", [], RuPImp(RuPNot(RuPNot(x)), x));   // (¬¬x → x), closed
	switch (amb) {
		None():  RuHF(x, ruHStep(ctx, "ax-mp", [f.tree, nnr], x));
		Some(w): RuHF(x, ruHStep(ctx, "syl", [f.tree, nnr], RuPImp(w, x)));  // (W→¬¬x),(¬¬x→x) ⊢ (W→x)
	}
}
ruHSaturate(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], rounds : int) -> [RuHF] {
	if (rounds <= 0) facts
	else {
		derived = ruHForward(ctx, amb, facts);
		fresh   = filter(derived, \d -> !exists(facts, \f -> f.content == d.content));
		if (fresh == []) facts else ruHSaturate(ctx, amb, concat(facts, fresh), rounds - 1);
	}
}

// ---- refutation clash: a contradictory context proves anything ----
ruHFindContra(facts : [RuHF]) -> Maybe<RuPForm> {
	fold(facts, None(), \acc, f -> switch (acc) { Some(__): acc; None():
		switch (f.content) { RuPNot(a): if (ruHFind(facts, a) != None()) Some(a) else None(); default: None(); }; });
}
ruHExFalso(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], a : RuPForm, goal : RuPForm) -> RuHF {
	fa  = either(ruHFind(facts, a), RuHF(a, ruNoProofTree)).tree;
	fna = either(ruHFind(facts, RuPNot(a)), RuHF(RuPNot(a), ruNoProofTree)).tree;
	pm  = ruHStep(ctx, "pm2.21", [], RuPImp(RuPNot(a), RuPImp(a, goal)));   // (¬A→(A→goal)), closed
	switch (amb) {
		None(): {
			impAG = ruHStep(ctx, "ax-mp", [fna, pm], RuPImp(a, goal));       // (A→goal)
			RuHF(goal, ruHStep(ctx, "ax-mp", [fa, impAG], goal));
		}
		Some(w): {
			sylr = ruHStep(ctx, "syl", [fna, pm], RuPImp(w, RuPImp(a, goal)));  // (W→(A→goal))
			RuHF(goal, ruHStep(ctx, "mpd", [fa, sylr], RuPImp(w, goal)));        // (W→goal)
		}
	}
}

// ⊥ in context proves any goal, via falim (F. → goal).
ruHFalsum(ctx : RuHCtx, amb : Maybe<RuPForm>, fbot : RuHF, goal : RuPForm) -> RuHF {
	fal = ruHStep(ctx, "falim", [], RuPImp(RuPFalse(), goal));   // (F. → goal), closed
	switch (amb) {
		None():  RuHF(goal, ruHStep(ctx, "ax-mp", [fbot.tree, fal], goal));
		Some(w): RuHF(goal, ruHStep(ctx, "syl", [fbot.tree, fal], RuPImp(w, goal)));  // (W→F.),(F.→goal) ⊢ (W→goal)
	}
}

// ---- the per-branch equality transport (Mizar's per-basic-problem Equalizer) ----
// For every equality FACT (X = Y) and atom FACT F holding X at a congruence position,
// derive F[Y/X] — INSIDE the branch, under its ambient: the case split that introduced
// the equality is exactly where the transport is needed (t51: the branch fact x11=x5
// moves x11∈x24 to x5∈x24, clashing with the premise ¬(x5∈x24)), and the saturation
// that runs BEFORE the certificate can never see a branch-local equality. Deduction
// composition per ambient:
//   bare:    ax-mp(eq, congInst) = (F↔F');  mpbi(F, that) = F'
//   Some(w): syl(eq, congInst) = w→(F↔F');  mpbid(F, that) = w→F'
// One round per ruHProve entry (the recursion is the fixpoint), capped and deduped.
// Targeted variant: only the pairs involving the NEWLY INTRODUCED branch fact — the new
// equality moves the existing atoms, or the new atom moves across the existing equalities.
// Called ONCE per assumption introduction (ruHProveUnder / ruHImpR), not per ruHProve
// entry: the per-entry version re-matched atoms×eqs×rules down the whole recursion and
// its cost starved certificates that closed before (t21 4.7s → timeout, measured).
// The eqcomi/eqcomd FLIP of an equality fact — S5 canonicalization: both orientations
// join the branch facts, so transports and clash pairs match either spelling.
ruHEqFlip(ctx : RuHCtx, amb : Maybe<RuPForm>, f : Pair<RuHF, RuExp>) -> Maybe<Pair<RuHF, RuExp>> {
	if (ruEqHead(f.second) != ruHwceq()) None() else {
		sides = ruEqArgs(f.second);
		if (sides.first.nodes == sides.second.nodes) None() else {
			flipExp = ruFwdMkRule(ruHwceq(), ctx.wff, [sides.second, sides.first]);
			ctx.atomNodes := mergeTree(^(ctx.atomNodes), ruPAtomNodes(ctx.conn, flipExp));
			tree = switch (amb) {
				None(): RuProofStep(s2id_("eqcomi"), [f.first.tree], RuStmt(ctx.stmtClass, [flipExp], -1));
				Some(w): {
					wExp = RuExp(ruHForm2Nodes(ctx, w), -1);
					RuProofStep(s2id_("eqcomd"), [f.first.tree],
						RuStmt(ctx.stmtClass, [ruFwdMkRule(s2id("wi"), ctx.wff, [wExp, flipExp])], -1));
				}
			};
			Some(Pair(RuHF(ruPAtomize(ctx.conn, flipExp), tree), flipExp));
		}
	}
}

ruHTransportNew(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], newF : RuHF, congs : Tree<int, [RuInAtomCong]>) -> [RuHF] {
	// positive atoms AND negated atoms (S5: ¬P(a) moves across a=b too — the clash
	// pair ¬P(b) never meets P(b) otherwise); .third = negated.
	atomExp = \f : RuHF -> switch (f.content) {
		RuPAtom(k): Some(Triple(f, ruHAtomExp(ctx, k), false));
		RuPNot(inner): switch (inner) {
			RuPAtom(k): Some(Triple(f, ruHAtomExp(ctx, k), true));
			default: None();
		}
		default: None();
	};
	switch (atomExp(newF)) {
		None(): [];
		Some(nf): {
			atoms0 = filtermap(facts, atomExp);
			newIsEq = !nf.third && ruEqHead(nf.second) == ruHwceq();
			atoms = if (newIsEq) atoms0 else [nf];
			eqs0  = if (newIsEq) [Pair(nf.first, nf.second)]
				else filtermap(atoms0, \a -> if (!a.third && ruEqHead(a.second) == ruHwceq()) Some(Pair(a.first, a.second)) else None());
			// S5 orientation: every driving equality also acts in its flipped form.
			eqs = fold(eqs0, eqs0, \acc, e -> switch (ruHEqFlip(ctx, amb, e)) {
				None(): acc;
				Some(fl): arrayPush(acc, fl);
			});
			if (ctx.em.env.conf.verbose >= 7) {
				ctx.em.env.out.println("        hTrAtoms(nf=" + i2s(length(facts)) + "): " + strGlue(map(atoms, \a -> (if (a.third) "~" else "") + ru2s(a.second, ctx.em.math)), " | ")
					+ " EQS: " + strGlue(map(eqs, \e -> ru2s(e.second, ctx.em.math)), " | ")
					+ " FACTS: " + strGlue(map(facts, \f -> ruHFormShape(f.content)), ","));
			} else {};
			out = ruHTransportRound(ctx, amb, facts, atoms, eqs, congs);
			if (ctx.em.env.conf.verbose >= 5) {
				ctx.em.env.out.println("      hTransport: new=" + ru2s(nf.second, ctx.em.math) + (if (nf.third) "(neg)" else "") +
					" atoms=" + i2s(length(atoms)) + " eqs=" + i2s(length(eqs)) + " produced=" + i2s(length(out)) +
					(if (out == []) "" else " first=" + ru2s(RuExp(ruHForm2Nodes(ctx, out[0].content), -1), ctx.em.math)));
			} else {};
			out;
		}
	}
}

ruHTransportRound(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], atoms : [Triple<RuHF, RuExp, bool>], eqs : [Pair<RuHF, RuExp>], congs : Tree<int, [RuInAtomCong]>) -> [RuHF] {
	if (eqs == []) [] else {
		known = \fs : [RuHF], e : RuExp, neg : bool -> {
			pf0 = ruPAtomize(ctx.conn, e);
			pf : RuPForm = if (neg) RuPNot(pf0) else pf0;
			exists(facts, \f -> f.content == pf) || exists(fs, \f -> f.content == pf);
		};
		fold(atoms, [], \acc, fa -> if (length(acc) >= 8) acc else
			fold(eqs, acc, \ac, eq -> if (length(ac) >= 8 || eq.second.nodes == fa.second.nodes) ac else {
				sides = ruEqArgs(eq.second);
				if (sides.first.nodes == sides.second.nodes) ac else
				fold(lookupTreeDef(congs, ruEqHead(fa.second), []), ac, \a, r ->
					switch (ruMatchExp(fa.second, r.lhs, ctx.em.math, ctx.em.env)) {
						None(): a;
						Some(sub0): {
							va = lookupHashMap(sub0.map, r.va.id);
							vaIsX = switch (va) { Some(se): se.exp.nodes == sides.first.nodes; None(): false; };
							if (!vaIsX) a else {
								m = copyHashMap(sub0.map);
								setHashMap(m, r.vb.id, RuSubExpr(r.vb, sides.second, ruExpVarIdsHashSet(sides.second)));
								sub = RuSubst(m);
								f2exp = ruApplySubst(r.rhs, sub);
								// a REFLEXIVE product ((∅=∅), (A=A) from moving an equality across
								// itself/its flip) is junk that re-enters eq-instantiation (t48)
								f2refl = ruEqHead(f2exp) == ruHwceq() && {
									s2 = ruEqArgs(f2exp);
									s2.first.nodes == s2.second.nodes;
								};
								if (f2refl || f2exp.nodes == fa.second.nodes || known(a, f2exp, fa.third)) a
								else {
									inst = ruApplySubst(r.prop, sub);            // (X=Y) → (F ↔ F')
									biExp = (ruEqArgs(inst)).second;             // (F ↔ F')  [args of wi]
									ctx.atomNodes := mergeTree(^(ctx.atomNodes), ruPAtomNodes(ctx.conn, f2exp));
									f2atom = ruPAtomize(ctx.conn, f2exp);
									f2 : RuPForm = if (fa.third) RuPNot(f2atom) else f2atom;
									notF2exp = ruFwdMkRule(s2id("wn"), ctx.wff, [f2exp]);
									pInst = RuProofStep(r.lemmaId, [], RuStmt(ctx.stmtClass, [inst], -1));
									// positive fact: mpbi/mpbid across (F↔F'); negated: mtbi/mtbid — ¬F(a)
									// moves to ¬F(b), the S5 clash-pair transport.
									tree = switch (amb) {
										None(): {
											pBi = RuProofStep(s2id_("ax-mp"), [eq.first.tree, pInst], RuStmt(ctx.stmtClass, [biExp], -1));
											if (fa.third) RuProofStep(s2id_("mtbi"), [fa.first.tree, pBi], RuStmt(ctx.stmtClass, [notF2exp], -1))
											else RuProofStep(s2id_("mpbi"), [fa.first.tree, pBi], RuStmt(ctx.stmtClass, [f2exp], -1));
										}
										Some(w): {
											wExp = RuExp(ruHForm2Nodes(ctx, w), -1);
											wBi  = ruFwdMkRule(s2id("wi"), ctx.wff, [wExp, biExp]);
											pBi = RuProofStep(s2id_("syl"), [eq.first.tree, pInst], RuStmt(ctx.stmtClass, [wBi], -1));
											if (fa.third) RuProofStep(s2id_("mtbid"), [fa.first.tree, pBi],
												RuStmt(ctx.stmtClass, [ruFwdMkRule(s2id("wi"), ctx.wff, [wExp, notF2exp])], -1))
											else RuProofStep(s2id_("mpbid"), [fa.first.tree, pBi],
												RuStmt(ctx.stmtClass, [ruFwdMkRule(s2id("wi"), ctx.wff, [wExp, f2exp])], -1));
										}
									};
									f2f = RuHF(f2, tree);
									// a PRODUCED equality also joins flipped (S5 orientation — the
									// clash premise may spell it the other way: t86 x12=x1 vs ¬(x1=x12))
									a2 = arrayPush(a, f2f);
									if (fa.third) a2
									else switch (ruHEqFlip(ctx, amb, Pair(f2f, f2exp))) {
										None(): a2;
										Some(fl): if (known(a2, fl.second, false)) a2 else arrayPush(a2, fl.first);
									}
								}
							}
						}
					})
			}));
	}
}

// ---- the prover ------------------------------------------------------------
ruHProve(ctx : RuHCtx, amb : Maybe<RuPForm>, facts0 : [RuHF], goal : RuPForm, fuel : int) -> Maybe<RuHF> {
	if (fuel <= 0 || ruTimeIsOver(ctx.timer)) None()
	else {
		facts = ruHSaturate(ctx, amb, facts0, 8);
		direct = ruHFind(facts, goal);
		bot    = ruHFind(facts, RuPFalse());
		contra = ruHFindContra(facts);
		if (direct != None()) direct
		else if (bot != None()) maybeMap(bot, \fbot -> ruHFalsum(ctx, amb, fbot, goal))  // ⊥ ⊢ anything (falim)
		else if (contra != None()) maybeMap(contra, \a -> ruHExFalso(ctx, amb, facts, a, goal))
		else {
				// ∨-elim on a disjunction FACT, tried BEFORE the structural rules: eliminating a known disjunction is
				// productive whenever one is in scope, and doing it first stops ruHOrR (∨R) from burning the work
				// budget on deep case-split sub-proofs while trying to prove a disjunct directly (the ∨-assoc waste).
				switch (ruHDisjElim(ctx, amb, facts, goal, fuel)) {
					Some(r): Some(r);
					None(): {
						structural = switch (goal) {
							RuPAnd(a, b): ruHAndR(ctx, amb, facts, a, b, fuel);
							RuPImp(a, b): ruHImpR(ctx, amb, facts, a, b, fuel);
							RuPOr(a, b):  ruHOrR(ctx, amb, facts, a, b, fuel);
							RuPIff(a, b): ruHIffR(ctx, amb, facts, a, b, fuel);
							RuPAtom(k):   if (ruEqHead(ruHAtomExp(ctx, k)) == ruHwcel()) ruHMembGoal(ctx, amb, facts, k, fuel)  // e∈compound → unfold
							              else ruHRelGoal(ctx, amb, facts, k, fuel);  // ⊆/= goal → membership (ssriv/ssrdv); else None
							RuPNot(inner): ruHDeneg(ctx, amb, facts, inner, fuel);  // ¬(A∧¬B) → A→B (iman) so it takes the implication path
							default:      None();
						};
						switch (structural) {
							Some(r): Some(r);
							None(): switch (ruHClashDerive(ctx, amb, facts, goal, fuel)) {   // S5 clash-by-derivation
								Some(r): Some(r);
								None(): switch (ruHExElim(ctx, amb, facts, goal, fuel)) {   // S4d branch skolemization
									Some(r): Some(r);
									None(): ruHCaseSplit(ctx, amb, facts, goal, fuel);   // classical case-split: last resort (bounded)
								};
							};
						};
					};
				};
		}
	}
}
ruHAndR(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], a : RuPForm, b : RuPForm, fuel : int) -> Maybe<RuHF> {
	switch (ruHProve(ctx, amb, facts, a, fuel - 1)) { None(): None(); Some(pa):
		switch (ruHProve(ctx, amb, facts, b, fuel - 1)) { None(): None(); Some(pb): {
			conj = RuPAnd(a, b);
			Some(switch (amb) {
				None():  RuHF(conj, ruHStep(ctx, "pm3.2i", [pa.tree, pb.tree], conj));
				Some(w): RuHF(conj, ruHStep(ctx, "jca", [pa.tree, pb.tree], RuPImp(w, conj)));
			});
		}; };
	};
}
ruHImpR(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], a : RuPForm, b : RuPForm, fuel : int) -> Maybe<RuHF> {
	imp = RuPImp(a, b);
	switch (amb) {
		None(): {
			// introduce A: lift every fact `|- f` to `(A→f)` (a1i), add `(A→A)` (id), prove B under Some(A).
			lifted = map(facts, \f -> RuHF(f.content, ruHStep(ctx, "a1i", [f.tree], RuPImp(a, f.content))));
			aF = RuHF(a, ruHStep(ctx, "id", [], RuPImp(a, a)));
			facts2 = ruHWithTransport(ctx, Some(a), concat(lifted, [aF]), aF);
			maybeMap(ruHProve(ctx, Some(a), facts2, b, fuel - 1), \pb -> RuHF(imp, pb.tree));  // pb proves (A→B)
		}
		Some(w): {
			neww = RuPAnd(w, a);
			lifted = map(facts, \f -> RuHF(f.content, ruHStep(ctx, "adantr", [f.tree], RuPImp(neww, f.content))));
			aF = RuHF(a, ruHStep(ctx, "simpr", [], RuPImp(neww, a)));
			facts2 = ruHWithTransport(ctx, Some(neww), concat(lifted, [aF]), aF);
			maybeMap(ruHProve(ctx, Some(neww), facts2, b, fuel - 1),
				\pb -> RuHF(imp, ruHStep(ctx, "ex", [pb.tree], RuPImp(w, imp))));  // ((W∧A)→B) ⊢ (W→(A→B))
		}
	}
}
// facts + the targeted transport for a newly introduced branch fact (no-op without ctx.fo).
// SATURATE-THEN-TRANSPORT: at branch entry the lifted premises may still be raw
// conjunctions — two ∧-elim rounds first, so the transport sees the ATOM facts
// (t32: x6∈x24 was locked inside (x6∈x24)∧(x7∈x24) and the branch equality
// x11=x6 transported nothing). The rounds dedup against the next ruHProve entry.
ruHWithTransport(ctx : RuHCtx, amb : Maybe<RuPForm>, facts0 : [RuHF], newF : RuHF) -> [RuHF] {
	newIsEqAtom = switch (newF.content) {
		RuPAtom(k): ruEqHead(ruHAtomExp(ctx, k)) == ruHwceq();
		default: false;
	};
	facts = if (isSome(ctx.fo) && newIsEqAtom) ruHSaturate(ctx, amb, facts0, 2) else facts0;
	switch (ctx.fo) {
		None(): facts;
		Some(congs): concat(facts, ruHTransportNew(ctx, amb, facts, newF, congs));
	}
}
ruHOrR(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], a : RuPForm, b : RuPForm, fuel : int) -> Maybe<RuHF> {
	disj = RuPOr(a, b);
	tryDisj = \side, x, lemmaD, lemma0 -> maybeMap(ruHProve(ctx, amb, facts, x, fuel - 1), \px ->
		switch (amb) {
			None():  RuHF(disj, ruHStep(ctx, "ax-mp", [px.tree, ruHStep(ctx, lemma0, [], RuPImp(x, disj))], disj));
			Some(w): RuHF(disj, ruHStep(ctx, lemmaD, [px.tree], RuPImp(w, disj)));
		});
	switch (tryDisj(true, a, "orcd", "orc")) { Some(r): Some(r); None(): tryDisj(false, b, "olcd", "olc"); };
}
ruHIffR(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], a : RuPForm, b : RuPForm, fuel : int) -> Maybe<RuHF> {
	switch (ruHProve(ctx, amb, facts, RuPImp(a, b), fuel - 1)) { None(): None(); Some(pab):
		switch (ruHProve(ctx, amb, facts, RuPImp(b, a), fuel - 1)) { None(): None(); Some(pba): {
			iff = RuPIff(a, b);
			Some(switch (amb) {
				None():  RuHF(iff, ruHStep(ctx, "impbii", [pab.tree, pba.tree], iff));
				Some(w): RuHF(iff, ruHStep(ctx, "impbid", [pab.tree, pba.tree], RuPImp(w, iff)));
			});
		}; };
	};
}
// prove `goal` assuming `a`; the returned tree proves `(a→goal)` (amb None) / `((W∧a)→goal)` (amb Some).
// (the disjunction-elim branches; same lifting as ruHImpR but the conclusion is `goal`, not an implication.)
ruHProveUnder(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], a : RuPForm, goal : RuPForm, fuel : int) -> Maybe<RuHF> {
	switch (amb) {
		None(): {
			lifted = map(facts, \f -> RuHF(f.content, ruHStep(ctx, "a1i", [f.tree], RuPImp(a, f.content))));
			aF = RuHF(a, ruHStep(ctx, "id", [], RuPImp(a, a)));
			ruHProve(ctx, Some(a), ruHWithTransport(ctx, Some(a), concat(lifted, [aF]), aF), goal, fuel);   // proves (a→goal)
		}
		Some(w): {
			neww = RuPAnd(w, a);
			lifted = map(facts, \f -> RuHF(f.content, ruHStep(ctx, "adantr", [f.tree], RuPImp(neww, f.content))));
			aF = RuHF(a, ruHStep(ctx, "simpr", [], RuPImp(neww, a)));
			ruHProve(ctx, Some(neww), ruHWithTransport(ctx, Some(neww), concat(lifted, [aF]), aF), goal, fuel);   // proves ((W∧a)→goal)
		}
	}
}
// ∨-elimination on a disjunction FACT `A∨B`: prove the goal under A and under B, combine (jaoi / mpjaodan).
// SKIP disjunctions already satisfied by a known disjunct (redundant, and — since membership-unfold keeps
// REGENERATING such a disjunction from its un-consumed source fact in every branch — splitting on one spirals
// and burns the per-path budget before the PRODUCTIVE disjunction is reached); try each remaining one in turn.
ruHDisjElim(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], goal : RuPForm, fuel : int) -> Maybe<RuHF> {
	if (fuel <= 0 || ^(ctx.splitBudget) <= 0 || ^(ctx.globalSplits) <= 0) None()   // per-path depth + global work cap
	else {
		ors = filter(facts, \f -> switch (f.content) {
			RuPOr(a, b): ruHFind(facts, a) == None() && ruHFind(facts, b) == None();   // neither disjunct already known
			default: false;
		});
		fold(ors, None(), \acc, df -> switch (acc) {
			Some(__): acc;
			None(): switch (df.content) {
				RuPOr(a, b): {
					// Restore the per-path budget on wholesale failure: only SUCCESSFUL splits count against it,
					// so a failed probe can't starve sibling/parent attempts. globalSplits is the hard work cap.
					saved = ^(ctx.splitBudget);
					ctx.splitBudget := saved - 1;
					ctx.globalSplits := ^(ctx.globalSplits) - 1;   // global cap: consumed even on failure (no restore)
					rest = filter(facts, \f -> f.content != df.content);
					result = switch (ruHProveUnder(ctx, amb, rest, a, goal, fuel - 1)) {
						None(): None();
						Some(pa): maybeMap(ruHProveUnder(ctx, amb, rest, b, goal, fuel - 1), \pb -> switch (amb) {
							None():  RuHF(goal, ruHStep(ctx, "ax-mp", [df.tree, ruHStep(ctx, "jaoi", [pa.tree, pb.tree], RuPImp(RuPOr(a, b), goal))], goal));
							Some(w): RuHF(goal, ruHStep(ctx, "mpjaodan", [pa.tree, pb.tree, df.tree], RuPImp(w, goal)));
						});
					};
					switch (result) { None(): { ctx.splitBudget := saved; None(); } Some(__): result; };
				}
				default: None();
			};
		});
	}
}

// classical case-split (pm2.61): pick an undecided atom p, prove the goal under p and under ¬p, combine.
// The completing rule for classical propositional logic; bounded by ctx.splitBudget (shared, total).
ruHCaseSplit(ctx : RuHCtx, amb : Maybe<RuPForm>, facts : [RuHF], goal : RuPForm, fuel : int) -> Maybe<RuHF> {
	// a clash DERIVATION is a composition of present facts — case splits inside it burn
	// the shared budgets on failing attempts and starve the main search (t48 flipped).
	if (^(ctx.inClash) || ^(ctx.splitBudget) <= 0 || ^(ctx.globalSplits) <= 0) None()
	else {
		keys = set2array(fold(facts, ruPAtoms(goal), \acc, f -> mergeSets(acc, ruPAtoms(f.content))));
		undecided = filter(keys, \k -> ruHFind(facts, RuPAtom(k)) == None() && ruHFind(facts, RuPNot(RuPAtom(k))) == None());
		if (undecided == []) None()
		else {
			p = RuPAtom(undecided[0]);
			if (ctx.em.env.conf.verbose >= 6) {
				ctx.em.env.out.println("        hSplit: on=" + ru2s(ruHAtomExp(ctx, undecided[0]), ctx.em.math) + " budget=" + i2s(^(ctx.splitBudget)) + " undecided=" + i2s(length(undecided)));
			} else {};
			saved = ^(ctx.splitBudget);
			ctx.splitBudget := saved - 1;
			ctx.globalSplits := ^(ctx.globalSplits) - 1;   // global cap: consumed even on failure (no restore)
			result = switch (ruHProve(ctx, amb, facts, RuPImp(p, goal), fuel - 1)) {            // (p → goal)
				None(): None();
				Some(pPos): maybeMap(ruHProve(ctx, amb, facts, RuPImp(RuPNot(p), goal), fuel - 1), \pNeg -> switch (amb) {  // (¬p → goal)
					None():  RuHF(goal, ruHStep(ctx, "pm2.61i", [pPos.tree, pNeg.tree], goal));
					Some(w): RuHF(goal, ruHStep(ctx, "pm2.61d", [pPos.tree, pNeg.tree], RuPImp(w, goal)));
				});
			};
			switch (result) { None(): { ctx.splitBudget := saved; None(); } Some(__): result; }
		}
	}
}

// Refutation (Mizar's method): assume ¬goal, saturate the context to a contradiction (A and ¬A both
// derived), then conclude goal via pm2.65i (⊢ ¬¬goal) and notnotr (¬¬goal → goal). Handles the negation-
// wrapped goals the translator emits (`A implies B` ⇒ `¬(A ∧ ¬B)`), which the direct prover rejects.
ruHRefute(ctx : RuHCtx, hypFacts : [RuHF], goal : RuPForm) -> Maybe<RuProofTree> {
	ng = RuPNot(goal);
	lifted = map(hypFacts, \f -> RuHF(f.content, ruHStep(ctx, "a1i", [f.tree], RuPImp(ng, f.content))));
	facts = concat(lifted, [RuHF(ng, ruHStep(ctx, "id", [], RuPImp(ng, ng)))]);
	sat = ruHSaturate(ctx, Some(ng), facts, 16);
	// the clash: a complementary pair (φ, ¬φ) where ¬φ is a saturated fact and φ is provable in context.
	// φ may be a literal already present, or an implication we must derive (e.g. ¬(p→r) clashes with the
	// derivable (p→r)). Build ¬¬goal via pm2.65i, then goal via notnotr.
	mkClash = \fphiTree, fnphiTree, phi -> {
		nng = ruHStep(ctx, "pm2.65i", [fphiTree, fnphiTree], RuPNot(ng));   // (ng→φ),(ng→¬φ) ⊢ ¬ng = ¬¬goal
		ruHStep(ctx, "ax-mp", [nng, ruHStep(ctx, "notnotr", [], RuPImp(RuPNot(ng), goal))], goal);
	};
	negs = filtermap(sat, \f -> switch (f.content) { RuPNot(phi): Some(Pair(phi, f.tree)); default: None(); });
	fold(negs, None(), \acc, np -> switch (acc) { Some(__): acc; None(): {
		phi = np.first;
		switch (ruHProve(ctx, Some(ng), sat, phi, 32)) {     // try to derive φ (structurally) → clash with ¬φ
			Some(fphi): Some(mkClash(fphi.tree, np.second, phi));
			None(): None();
		}
	}; });
}

ruHilbertProve(ctx : RuHCtx, hyps : [RuPForm], goal : RuPForm) -> Maybe<RuProofTree> {
	hypFacts = ruHTopTransport(ctx, mapi(hyps, \i, h -> RuHF(h, RuProofHyp(i, ruHStmt(ctx, h)))));
	switch (ruHProve(ctx, None(), hypFacts, goal, 48)) {
		Some(r): Some(r.tree);
		None():  ruHRefute(ctx, hypFacts, goal);
	}
}

ruHilbertProveUnder(ctx : RuHCtx, hyps : [RuPForm], assume : RuPForm, goal : RuPForm) -> Maybe<RuProofTree> {
	hypFacts = ruHTopTransport(ctx, mapi(hyps, \i, h -> RuHF(h, RuProofHyp(i, ruHStmt(ctx, h)))));
	maybeMap(ruHProveUnder(ctx, None(), hypFacts, assume, goal, 48), \r -> r.tree);
}

// TOP-LEVEL transport round: the per-branch transport (ruHWithTransport) fires only
// for facts introduced at branch entry, so an equality arriving as a certificate
// HYP transported nothing (the unifier-gen t85 class: goal x9∈X, facts x10∈X and
// x9=x10 all top-level). One round over the hyp facts closes that — each eq-atom
// hyp transports the others; ruHWithTransport self-gates on non-eq facts.
// ctx.topFo-gated: only the ...TimedTop entry (unifier-gen) pays for it — run
// unconditionally it starved the full-stack slice borderliners (t101, 89->88).
ruHTopTransport(ctx : RuHCtx, hypFacts : [RuHF]) -> [RuHF] {
	if (!ctx.topFo) hypFacts
	else switch (ctx.fo) {
		None(): hypFacts;
		Some(__): fold(hypFacts, hypFacts, \acc, f -> ruHWithTransport(ctx, None(), acc, f));
	}
}
