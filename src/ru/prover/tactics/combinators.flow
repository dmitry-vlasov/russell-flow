import ru/prover/core/controls;
import ru/prover/core/tree;
import ru/proof_tree;

export {
	// Sequence: runs tactics in order.  When the current one returns
	// RuTacticDone, advances to the next.  When all are exhausted, terminates.
	ruSequenceTactic(tactics : [RuProverTactic]) -> RuProverTactic;

	// Iterate: on each step, call the driver.  None means terminate; Some(t)
	// means "run t to completion, then come back and ask me again."  Driver
	// state (typically in refs closed over by `driver`) is shared across
	// iterations.
	ruIterateTactic(driver : (RuProverTree) -> Maybe<RuProverTactic>) -> RuProverTactic;

	// Loop-while-progress: each iteration, call `builder()` to get a fresh
	// inner tactic and run it to completion.  If the tree grew, repeat — up
	// to max_iters times.  Stops on no progress, exhaustion of iters, or
	// when a proof is found.
	ruLoopWhileProgressTactic(builder : () -> RuProverTactic, max_iters : int) -> RuProverTactic;

	// Or-else (lazy alternation): try the alternatives in order. Each is a (toString-label, builder
	// THUNK) pair; the thunk is invoked — i.e. the alternative is BUILT — only when the previous one
	// finishes without a proof. The first proof wins; the search stops immediately. Unlike `seq` (which
	// takes already-built tactics and threads env stage→stage), or-else builds each alternative lazily
	// from the same captured base env, so an expensive-to-build alternative (e.g. a guide constructed by
	// refine/replay) is never built unless it is actually reached. This is what lets `def-close` be the
	// pure composition or-else(replay(refine(...)), replay(refine(..., nnf=on))) with no wasted builds.
	ruOrElseTactic(alts : [Pair<string, () -> RuProverTactic>]) -> RuProverTactic;

	// RETRY ROUNDS (label phase 3, RESUMABILITY): drive `mk(round)` (an or-else
	// round); when it concludes WITHOUT a proof, start the next round iff the
	// budget of rounds remains AND the ended round made PROGRESS (the `metric`
	// grew since the round's first step) — resumed stages continue from their
	// explored regions (saved fronts, visible labeled nodes) with fresh slice
	// budgets, bounded by the per-step timer. A no-progress round is genuinely
	// done: nothing new would happen in another.
	ruRetryRoundsTactic(mk : (int) -> RuProverTactic, round : int, max_rounds : int, metric : (RuProverTree) -> int) -> RuProverTactic;

	// Limit wrapper: terminates the inner tactic when any of the limits are
	// exceeded.  All limits are optional: pass 0 to disable.
	//   time_limit     — wall-clock cutoff (ms; 0 disables)
	//   applied_limit  — number of step invocations
	//   produced_limit — total leafs emitted by the inner tactic
	//   size_limit     — cap on nodes ADDED since this tactic started (a delta, snapshotted on the first
	//                    step; 0 disables). Delta (not absolute) so a size-capped tactic re-run inside a
	//                    loop gets its full budget each pass — what `bounded-bfs` relies on.
	//   depth_limit    — max tree depth from the root (absolute; 0 disables)
	//   batch          — pace the inner tactic's expansion to at most this many leafs per round
	//                    (0 = pass the whole frontier through). A non-zero batch is what keeps a
	//                    size cap STRICT: the engine expands a round's batch concurrently, so capping
	//                    the batch bounds the per-round overshoot. `bounded-bfs(md,ms)` is exactly
	//                    `limited(bfs, size=ms, depth=md, batch=ruSearchBatch)`.
	ruLimitedTactic(
		inner          : RuProverTactic,
		time_limit     : double,
		applied_limit  : int,
		produced_limit : int,
		size_limit     : int,
		depth_limit    : int,
		batch          : int
	) -> RuProverTactic;

	// Force `tag` onto `inner` and every successor it switches into, so the
	// engine attributes expansions inside `inner` to this DSL atom regardless
	// of `inner`'s internal tactic structure.
	ruTaggedTactic(tag : string, inner : RuProverTactic) -> RuProverTactic;

	// Relabel `inner`'s toString to `label`, keeping its behavior. Used by realizer atoms (replay/inject)
	// so a tactic built from a guide-expression serializes at the right abstraction level —
	// `replay(refine(...))` rather than the track/inject implementation it expands to.
	ruLabeledTactic(label : string, inner : RuProverTactic) -> RuProverTactic;

	// Display wrapper for `scoped(<scope>, inner)`: the actual candidate restriction is the
	// `penv.whitelist := <ids>` the scoped BUILDER performs at build time (the whitelist is a per-prove
	// property, not a runtime-dynamic one); this wrapper only carries the scope into `toString` so the
	// serialization is faithful — `scoped([mpbi, elun], bounded-bfs(...))`. Step transparent.
	// NOTE: one active scope per prove — nested/parallel scopes would need a runtime scope on the tactic.
	ruScopedTactic(scopeStr : string, inner : RuProverTactic) -> RuProverTactic;

	// ---- goal refiners: composing proof CONSTRUCTIONS (not backward-search tactics) ----
	// A refiner reduces `goal` to `subgoals` and provides a `validate` that lifts proofs of the
	// subgoals back to a proof of `goal`, discharging `disjs` (DV provisos the lifting introduces).
	// The connective glue lives in `validate` with CONCRETE statements — it is constructed, never
	// searched — which is why refiners compose without the free-variable blow-up a backward-search
	// `seq` would hit. None = the refiner cannot handle this goal.
	RuRefineStep(subgoals : [RuExp], validate : ([RuProofTree]) -> RuProofTree, disjs : Set<RuDisj>);
	// `refine` is the PREFERRED refinement; `alt` a fallback tried only when the whole subtree under
	// the preferred one failed to close. ruRefine has no backtracking otherwise, so a refiner that
	// reduces a goal irrevocably destroys every route the reduction closes off — and SUPPRESSING the
	// reduction instead is not an option, other proofs need it. Alternation can only ADD reachable
	// proofs. Keep the fallback CHEAP: it re-runs the residual closer, so gate it on a test that says
	// it can actually win (see ruEqRewriteRefiner).
	RuRefiner(name : string, refine : (RuExp) -> Maybe<RuRefineStep>, alt : (RuExp) -> Maybe<RuRefineStep>);
	// A completed refinement: the proof tree + all DV provisos it needs declared.
	RuRefineResult(proof : RuProofTree, disjs : Set<RuDisj>);

	// Run a refiner pipeline: refine `goal` left-to-right (each refiner refines the subgoals the
	// previous left), close the leaves with `close`, then run the validations bottom-up. None if any
	// leaf/refiner fails.
	ruRefine(refiners : [RuRefiner], goal : RuExp, close : (RuExp) -> Maybe<RuRefineResult>) -> Maybe<RuRefineResult>;
}

ruRefine(refiners : [RuRefiner], goal : RuExp, close : (RuExp) -> Maybe<RuRefineResult>) -> Maybe<RuRefineResult> {
	if (refiners == []) close(goal)
	else {
		run = \mstep : Maybe<RuRefineStep> -> switch (mstep) {
			None(): None();
			Some(step): {
				subs = map(step.subgoals, \sg -> ruRefine(tail(refiners), sg, close));
				if (!forall(subs, isSome)) None()
				else {
					results = map(subs, \s -> either(s, RuRefineResult(RuProofHyp(0, ruNoStmt), makeSet())));
					proofs  = map(results, \r -> r.proof);
					disjs   = fold(results, step.disjs, \acc, r -> mergeSets(acc, r.disjs));
					Some(RuRefineResult(step.validate(proofs), disjs));
				}
			}
		};
		switch (run(refiners[0].refine(goal))) {
			Some(r): Some(r);
			None():  run(refiners[0].alt(goal));
		}
	}
}

ruTaggedTactic(tag : string, inner : RuProverTactic) -> RuProverTactic {
	RuProverTactic(inner.toString, tag,
		\tree -> switch (inner.step(tree)) {
			RuTacticExpand(leafs): RuTacticExpand(leafs);
			RuTacticExpandForward(): RuTacticExpandForward();
			RuTacticSwitch(next):  RuTacticSwitch(ruTaggedTactic(tag, next));
			RuTacticDone():        RuTacticDone();
		},
		inner.keep_expanding
	)
}

ruLabeledTactic(label : string, inner : RuProverTactic) -> RuProverTactic {
	RuProverTactic(label, inner.tag,
		\tree -> switch (inner.step(tree)) {
			RuTacticExpand(leafs): RuTacticExpand(leafs);
			RuTacticExpandForward(): RuTacticExpandForward();
			RuTacticSwitch(next):  RuTacticSwitch(ruLabeledTactic(label, next));
			RuTacticDone():        RuTacticDone();
		},
		inner.keep_expanding
	)
}

ruScopedTactic(scopeStr : string, inner : RuProverTactic) -> RuProverTactic {
	RuProverTactic("scoped(" + scopeStr + ", " + inner.toString + ")", inner.tag,
		\tree -> switch (inner.step(tree)) {
			RuTacticExpand(leafs): RuTacticExpand(leafs);
			RuTacticExpandForward(): RuTacticExpandForward();
			RuTacticSwitch(next):  RuTacticSwitch(ruScopedTactic(scopeStr, next));
			RuTacticDone():        RuTacticDone();
		},
		inner.keep_expanding
	)
}

ruSequenceTactic(tactics : [RuProverTactic]) -> RuProverTactic {
	if (tactics == []) ruDoneTactic
	else RuProverTactic("seq(" + strGlue(map(tactics, \t -> t.toString), ", ") + ")", tactics[0].tag,
		\tree ->
			if (length(^(tree.proofs)) > 0) RuTacticDone()
			else switch (tactics[0].step(tree)) {
				RuTacticExpand(leafs): RuTacticExpand(leafs);
				RuTacticExpandForward(): RuTacticExpandForward();
				RuTacticSwitch(next): RuTacticSwitch(ruSequenceTactic(concat([next], tail(tactics))));
				RuTacticDone(): {
					rest = tail(tactics);
					if (rest == []) RuTacticDone()
					else RuTacticSwitch(ruSequenceTactic(rest))
				}
			},
		// Always allow expansion until proof is found; the active sub-tactic
		// controls switching via RuTacticDone(), not per-prop keep_expanding.
		// Using tactics[0].keep_expanding here caused BFS to inherit the
		// linear-guided delta limit, consuming leaves without expanding them.
		ruTreeNotProved
	)
}

ruIterateTactic(driver : (RuProverTree) -> Maybe<RuProverTactic>) -> RuProverTactic {
	RuProverTactic("iterate", "",
		\tree ->
			if (length(^(tree.proofs)) > 0) RuTacticDone()
			else switch (driver(tree)) {
				None(): RuTacticDone();
				Some(body): RuTacticSwitch(ruSequenceTactic([body, ruIterateTactic(driver)]));
			},
		// Iterate itself only stops on proved; the body's own keep_expanding
		// kicks in once we Switch into it.
		ruTreeNotProved
	)
}

ruLoopHelper(
	builder    : () -> RuProverTactic,
	current    : RuProverTactic,
	iters_left : int,
	prev_size  : int
) -> RuProverTactic {
	RuProverTactic("loop(" + current.toString + ", max-iters=" + i2s(iters_left) + ")", current.tag,
		\tree ->
			if (length(^(tree.proofs)) > 0) RuTacticDone()
			else switch (current.step(tree)) {
				RuTacticExpand(leafs): RuTacticExpand(leafs);
				RuTacticExpandForward(): RuTacticExpandForward();
				RuTacticSwitch(next): RuTacticSwitch(ruLoopHelper(builder, next, iters_left, prev_size));
				RuTacticDone(): {
					cur_size = sizeTree(tree.nodes);
					if (iters_left > 1 && cur_size > prev_size)
						RuTacticSwitch(ruLoopHelper(builder, builder(), iters_left - 1, cur_size))
					else RuTacticDone()
				}
			},
		current.keep_expanding
	)
}

ruLoopWhileProgressTactic(builder : () -> RuProverTactic, max_iters : int) -> RuProverTactic {
	if (max_iters <= 0) ruDoneTactic
	else ruLoopHelper(builder, builder(), max_iters, -1)
}

// `fullStr` is the whole or-else(...) serialization (all alternatives' labels), computed once and kept
// constant across switches; `current` is the built alternative now running; `rest` are the not-yet-built
// alternatives' thunks. On RuTacticDone WITHOUT a proof we build the next thunk lazily and switch to it.
ruOrElseHelper(fullStr : string, current : RuProverTactic, rest : [() -> RuProverTactic]) -> RuProverTactic {
	RuProverTactic(fullStr, current.tag,
		\tree ->
			if (length(^(tree.proofs)) > 0) RuTacticDone()
			else switch (current.step(tree)) {
				RuTacticExpand(leafs): RuTacticExpand(leafs);
				RuTacticExpandForward(): RuTacticExpandForward();
				RuTacticSwitch(next):  RuTacticSwitch(ruOrElseHelper(fullStr, next, rest));
				RuTacticDone():
					if (rest == []) RuTacticDone()
					else RuTacticSwitch(ruOrElseHelper(fullStr, (rest[0])(), tail(rest)));
			},
		current.keep_expanding
	)
}

ruRetryRoundsTactic(mk : (int) -> RuProverTactic, round : int, max_rounds : int, metric : (RuProverTree) -> int) -> RuProverTactic {
	ruRetryRoundsHelper(mk, mk(round), round, max_rounds, metric, ref -1);
}

ruRetryRoundsHelper(mk : (int) -> RuProverTactic, current : RuProverTactic, round : int, max_rounds : int, metric : (RuProverTree) -> int, start : ref int) -> RuProverTactic {
	RuProverTactic(current.toString + " [round " + i2s(round) + "]", current.tag,
		\tree -> {
			if (^start < 0) start := metric(tree) else {};
			switch (current.step(tree)) {
				RuTacticExpand(leafs): RuTacticExpand(leafs);
				RuTacticExpandForward(): RuTacticExpandForward();
				RuTacticSwitch(next): RuTacticSwitch(ruRetryRoundsHelper(mk, next, round, max_rounds, metric, start));
				RuTacticDone():
					if (length(^(tree.proofs)) == 0 && round < max_rounds && metric(tree) > ^start)
						RuTacticSwitch(ruRetryRoundsTactic(mk, round + 1, max_rounds, metric))
					else RuTacticDone();
			}
		},
		current.keep_expanding
	);
}

ruOrElseTactic(alts : [Pair<string, () -> RuProverTactic>]) -> RuProverTactic {
	if (alts == []) ruDoneTactic
	else {
		fullStr = "or-else(" + strGlue(map(alts, \a -> a.first), ", ") + ")";
		ruOrElseHelper(fullStr, (alts[0].second)(), map(tail(alts), \a -> a.second));
	}
}

ruLimitedTactic(
	inner          : RuProverTactic,
	time_limit     : double,
	applied_limit  : int,
	produced_limit : int,
	size_limit     : int,
	depth_limit    : int,
	batch          : int
) -> RuProverTactic {
	applied  : ref int = ref 0;
	produced : ref int = ref 0;
	initial_size : ref int = ref (-1);
	timer = ruMakeLimitedTimer(time_limit);
	over_limit = \tree : RuProverTree -> {
		cur = ruProverTreeSize(tree);
		if (^initial_size < 0) initial_size := cur;   // snapshot at the tactic's first step → delta base
		ruWorkTick(timer, 1);   // WORK UNIT: one step of the bounded search
		(time_limit > 0.0 && ruTimeIsOver(timer)) ||
		(applied_limit > 0 && ^applied > applied_limit) ||
		(produced_limit > 0 && ^produced > produced_limit) ||
		(size_limit > 0 && (cur - ^initial_size) > size_limit) ||   // DELTA: nodes ADDED since the tactic started
		(depth_limit > 0 && ruProverTreeDepth(tree) > depth_limit)
	};
	RuProverTactic("limited(" + inner.toString + ", time=" + d2s(time_limit) + ", applied=" + i2s(applied_limit) + ", produced=" + i2s(produced_limit) + ", size=" + i2s(size_limit) + ", depth=" + i2s(depth_limit) + ", batch=" + i2s(batch) + ")", inner.tag,
		\tree -> {
			if (over_limit(tree)) RuTacticDone()
			else {
				applied := ^applied + 1;
				switch (inner.step(tree)) {
					RuTacticDone(): RuTacticDone();
					RuTacticSwitch(next): RuTacticSwitch(ruLimitedTactic(next, time_limit, applied_limit, produced_limit, size_limit, depth_limit, batch));
					// A forward wave isn't leaf-paced (no leafs to take); pass it through.
					// The over_limit guard above still bounds it at wave granularity.
					RuTacticExpandForward(): RuTacticExpandForward();
					RuTacticExpand(leafs): {
						// pace to `batch` leafs/round (the rest stay in tree.leafs, re-offered) so a size cap
						// stays strict — the engine expands a round's batch concurrently. batch=0 = whole frontier.
						paced = if (batch > 0) take(leafs, batch) else leafs;
						produced := ^produced + length(paced);
						RuTacticExpand(paced);
					}
				}
			}
		},
		\tree -> !over_limit(tree) && inner.keep_expanding(tree)
	);
}
