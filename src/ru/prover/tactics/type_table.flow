import ru/prover/tactics/instantiate;
import ru/prover/core/declines;
import ru/unify/index;
import ru/verify/math;
import base/ids;
import ru/proof_tree;

// THE TYPE REGISTRY (soft-type-layer.md §4.1) — the scanned, read-only view of the Mizar
// soft-type layer as it exists in the loaded assertions. Read-only by design: this pass only
// CLASSIFIES what the translation produced; nothing here touches proof search. Its consumers
// (the `types.env` blackboard artifact and `ensure-type`) come next.
//
// Everything is classified BY SHAPE, never by a hand-kept name list (the standing rule) — so
// it works the same on the foundation, on a translated article, and on anything authored in
// miz_aux. The four rule kinds the design calls for:
//
//   DEF   ∀ā ( θ(t,ā) ↔ body )                        a mode/attribute UNFOLD. Mizar's guarded
//         (possibly `(c ∨ (θ↔B)) ∧ (c → (θ↔B'))`)     definitions (SUBSET_1:def 1) take the
//                                                     second form — the ∨-branch IS the
//                                                     conditional bicond `¬c → (θ↔B)`.
//   FUNC  ∀L̄ ( guards → α(f(L̄)) )                     functorial registration: the subject of
//                                                     the conclusion is a COMPOUND term.
//   COND  ∀L̄∀t ( guards ∧ α(t) → β(t) )               conditional registration: the subject is
//                                                     a variable already guarded in the
//                                                     antecedent.
//   EX    ∀L̄ ( guards → ∃t ( … ) )                    existential registration (inhabitation).
//
// Cluster rules are ORDINARY implications, so a consumer applies one as an ordinary proof step
// — nothing in this registry is trusted, and a misclassification costs coverage, never
// soundness.

export {
	RuTyRole ::= RuTyDef, RuTyFunc, RuTyCond, RuTyEx;
		RuTyDef();    // mode/attribute unfold (bicond, possibly guarded)
		RuTyFunc();   // functorial registration  — conclusion subject is a compound term
		RuTyCond();   // conditional registration — conclusion subject is a guarded variable
		RuTyEx();     // existential registration — inhabitation

	// head  = the guard/predicate symbol the rule is keyed under (its CONCLUSION head)
	// arity = that predicate's arity (1 = bare attribute, 2+ = parameterised mode/attribute)
	RuTyRule(assId : int, role : RuTyRole, head : int, arity : int, guarded : bool);

	RuTypeTable(all : [RuTyRule], byHead : Tree<int, [RuTyRule]>);

	ruTypeTable(math : RuMath) -> RuTypeTable;

	// A rule's statement together with a PROOF of it — the axiom applied with no hypotheses —
	// ready to drop straight into a premise pool. This is how the registry's content reaches a
	// consumer without any new trusted machinery: the fact carries its own derivation, so using
	// it is an ordinary proof step (soft-type-layer.md §4.2, "every entry carries its proof").
	ruTyRuleFact(math : RuMath, stmtClass : int, r : RuTyRule) -> Maybe<Pair<RuProofTree, RuExp>>;

	// The type-layer heads occurring anywhere in these expressions (used to gate a consumer:
	// only pull in definitions for notions the problem actually mentions).
	ruTyHeadsOf(t : RuTypeTable, exps : [RuExp]) -> Set<int>;
	ruTyRole2s(r : RuTyRole) -> string;

	// GUARD DISCHARGE: the usable biconditional of a GUARDED mode definition, assembled for each
	// type-layer atom of the problem — see the construction note further down. Each fact carries
	// its whole proof, so consuming one is an ordinary proof step.
	ruTyGuardFacts(math : RuMath, env : RuEnv, stmtClass : int, t : RuTypeTable,
		facts : [Pair<RuProofTree, RuExp>], goal : RuExp) -> [Pair<RuProofTree, RuExp>];
}

ruTyRole2s(r : RuTyRole) -> string {
	switch (r) { RuTyDef(): "def"; RuTyFunc(): "func-cluster"; RuTyCond(): "cond-cluster"; RuTyEx(): "ex-cluster"; }
}

// ---- cache (per index size, like ruRuleTable) --------------------------------

ruTypeTableCache : ref [Pair<int, RuTypeTable>] = ref [];

ruTypeTable(math : RuMath) -> RuTypeTable {
	n = math.decls.gen;   // O(1) cache key (was an O(n) sizeTree walk)
	c = ^ruTypeTableCache;
	if (c != [] && c[0].first == n) c[0].second else {
		t = ruTyBuild(math);
		ruTypeTableCache := [Pair(n, t)];
		t;
	}
}

ruTyRuleFact(math : RuMath, stmtClass : int, r : RuTyRule) -> Maybe<Pair<RuProofTree, RuExp>> {
	switch (lookupTree(math.decls.assertions, r.assId)) {
		None(): None();
		Some(ass): {
			inf = ruTyInfer(ass);
			if (inf.hyps != []) None() else {
				e = ruExp(inf.prop.exps[0]);
				Some(Pair(RuProofStep(r.assId, [], RuStmt(stmtClass, [e], -1)), e));
			}
		}
	}
}

ruTyHeadsOf(t : RuTypeTable, exps : [RuExp]) -> Set<int> {
	fold(exps, makeSet(), \acc, e -> fold(e.nodes, acc, \a, n -> switch (n) {
		RuVar(__, __): a;
		RuRuleNode(idT, __): { h = ruIdType2Id(idT); if (containsKeyTree(t.byHead, h)) insertSet(a, h) else a; }
	}));
}

ruTyInfer(a : RuAssertion) -> RuInference {
	switch (a) {
		RuAxiom(__, i): i; RuCong(__, i): i; RuTheorem(__, i, __, __): i; RuDef(__, i, __, __): i;
	}
}

// "d" = a definition (mode/attribute/functor unfold), "r"/"c"/"f" = the registration kinds.
// "" = not type-layer content.
ruTyDeclKind(nm : string) -> string {
	pre2 = if (strlen(nm) >= 2) substring(nm, 0, 2) else "";
	rest = if (strlen(nm) >= 2) substring(nm, 2, strlen(nm) - 2) else "";
	isNumTail = \r : string -> r != "" && (getCharCodeAt(r, 0) >= 48 && getCharCodeAt(r, 0) <= 57);
	if ((pre2 == "rc" || pre2 == "cc" || pre2 == "fc") && isNumTail(rest)) pre2
	else if (strlen(nm) >= 2 && substring(nm, 0, 1) == "d"
		&& isNumTail(substring(nm, 1, strlen(nm) - 1))) "d"
	else "";
}

ruTyInfoOf(a : RuAssertion) -> RuDeclInfo {
	switch (a) { RuAxiom(i, __): i; RuCong(i, __): i; RuTheorem(i, __, __, __): i; RuDef(i, __, __, __): i; }
}

ruTyId(a : RuAssertion) -> int {
	switch (a) { RuAxiom(i, __): i.id; RuCong(i, __): i.id; RuTheorem(i, __, __, __): i.id; RuDef(i, __, __, __): i.id; }
}

// peel the leading ∀ binders: wal's args are [x, body]
ruTyStripForalls(e : RuExp) -> RuExp {
	if (ruInHead(e) != s2id("wal") || ruInArity(e) != 2) e
	else ruTyStripForalls((ruInArgs(e))[1]);
}

// is this expression a compound (rule-headed, argument-bearing) term rather than a variable?
ruTyIsCompound(e : RuExp) -> bool { ruInHead(e) >= 0 && ruInArity(e) > 0; }

// The logical SKELETON. A guard is an ATOM, so a connective-headed expression is never one —
// without this the scan calls every `∀…(A → B)` in set.mm a conditional cluster.
ruTyIsConnective(h : int) -> bool {
	exists([s2id("wi"), s2id("wa"), s2id("wo"), s2id("wn"), s2id("wb"), s2id("wal"), s2id("wex")],
		\c -> c == h);
}

// the head symbol a guard atom is keyed under, with its arity; (-1, 0) when it is not an atom
ruTyAtomHead(e : RuExp) -> Pair<int, int> {
	h = ruInHead(e);
	if (h < 0 || ruTyIsConnective(h)) Pair(-1, 0) else Pair(h, ruInArity(e));
}

// The CONCLUSION of an implication chain, and whether its subject is compound. For a functorial
// registration the subject is a term like `𝒫 X`; for a conditional one it is the bound variable.
ruTyClassifyImp(concl : RuExp) -> Pair<RuTyRole, Pair<int, int>> {
	// A conditional registration NESTS: ∀L̄ ( argGuards → ∀t ( typ(t) ∧ ante(t) → cons(t) ) ).
	// Descend the implication chain (∀-stripping as we go) to the FINAL conclusion —
	// classifying only the first level found 1 of 9 cond-clusters.
	if (ruInHead(concl) == s2id("wi") && ruInArity(concl) == 2)
		ruTyClassifyImp(ruTyStripForalls((ruInArgs(concl))[1]))
	else {
	wexId = s2id("wex");
	// an existential registration's conclusion is ∃-headed; key it on the FIRST guard inside
	// the body (ruTyAtomHead would reject ∃ itself, since ∃ is part of the logical skeleton)
	if (ruInHead(concl) == wexId && ruInArity(concl) == 2) {
		inner = (ruInArgs(concl))[1];
		hd = fold(ruTyConjuncts(inner), Pair(-1, 0), \acc, a ->
			if (acc.first >= 0) acc else ruTyAtomHead(a));
		Pair(RuTyEx(), hd);
	} else {
		// a conclusion may be a ∧ of guards — key on the first atom that has a subject
		atoms = ruTyConjuncts(concl);
		subj = fold(atoms, Pair(RuTyCond(), Pair(-1, 0)), \acc, a ->
			if ((acc.second).first >= 0) acc else {
				hd = ruTyAtomHead(a);
				if (hd.first < 0 || hd.second == 0) acc
				else {
					args = ruInArgs(a);
					role = if (args != [] && ruTyIsCompound(args[0])) RuTyFunc() else RuTyCond();
					Pair(role, hd);
				}
			});
		subj;
	}
	}
}

ruTyConjuncts(e : RuExp) -> [RuExp] {
	if (ruInHead(e) != s2id("wa") || ruInArity(e) != 2) [e]
	else concatA(map(ruInArgs(e), ruTyConjuncts));
}

// Does this expression contain a biconditional anywhere at the top ∧/∨ structure? Mizar's
// guarded definitions bury the real unfold inside `(c ∨ (θ↔B)) ∧ (c → (θ↔B'))`.
ruTyFindBicond(e : RuExp) -> Maybe<RuExp> {
	wbId = s2id("wb"); waId = s2id("wa"); woId = s2id("wo"); wiId = s2id("wi");
	h = ruInHead(e);
	if (h == wbId && ruInArity(e) == 2) Some(e)
	else if ((h == waId || h == woId || h == wiId) && ruInArity(e) == 2)
		fold(ruInArgs(e), None(), \acc, a -> if (isSome(acc)) acc else ruTyFindBicond(a))
	else None();
}

ruTyBuild(math : RuMath) -> RuTypeTable {
	// The soft-type layer is MIZAR-side content. set.mm's own corpus (the miz_set foundation)
	// is thousands of ordinary set-theory theorems whose shapes collide with the cluster
	// patterns — scanning it reported 4045 "type rules" keyed on wceq/wcel/wi, i.e. noise.
	// Foundation reasoning is the RULE table's business; this registry covers the translated
	// articles and anything authored alongside them.
	foundIds = foldTree(math.sources, makeSet(), \id, src, acc -> {
		m = src.info.module;
		if (m == "miz_set" || endsWith(m, "/miz_set")) insertSet(acc, id) else acc;
	});
	all = filtermap(getTreeValues(math.decls.assertions), \ass -> {
		inf = ruTyInfer(ass);
		// WHICH decls are type-layer content is metadata WE emit, not something shape can decide:
	// an ordinary Mizar theorem `∀(A → atom)` is shaped exactly like a conditional
	// registration (that ambiguity reported 126 `wceq` "clusters" for subset_1). The
	// translator names registrations rc/cc/fc<n>_<aid> and definitions d<n>_<aid>, so the
	// KIND is read off that convention; the SHAPE analysis below still does the classifying.
	if (ruTyDeclKind(id2s(ruTyId(ass))) == "" || containsSet(foundIds, ruTyInfoOf(ass).src)) None() else
		// only 0-hypothesis, ∀-closed statements: definitions and registrations both take
		// that shape after translation. (A hypothesised rule is the rule table's business.)
		if (inf.hyps != []) None() else {
			body = ruTyStripForalls(ruExp(inf.prop.exps[0]));
			wiId = s2id("wi");
			switch (ruTyFindBicond(body)) {
				Some(bi): {
					lhs = (ruInArgs(bi))[0];
					hd  = ruTyAtomHead(lhs);
					// a bicond whose LHS is an ATOM with a subject is a mode/attribute unfold;
					// `guarded` records Mizar's empty-case split (the ∨/→ wrapper).
					if (hd.first < 0 || hd.second == 0) None()
					else Some(RuTyRule(ruTyId(ass), RuTyDef(), hd.first, hd.second, ruInHead(body) != s2id("wb")));
				}
				None(): {
					// A registration with NO locus guards is a bare conclusion rather than an
					// implication (fc1_subset_1 is just `∀X ¬(𝒫X = ∅)`), and a conditional
					// one re-quantifies its subject, so the conclusion needs its own ∀-strip.
					concl = if (ruInHead(body) == wiId && ruInArity(body) == 2)
						ruTyStripForalls((ruInArgs(body))[1]) else body;
					cl = ruTyClassifyImp(concl);
					hd = cl.second;
					if (hd.first < 0 || hd.second == 0) None()
					else Some(RuTyRule(ruTyId(ass), cl.first, hd.first, hd.second, false));
				}
			}
		}
	});
	byHead = fold(all, makeTree(), \acc, r -> setTree(acc, r.head, arrayPush(lookupTreeDef(acc, r.head, []), r)));
	RuTypeTable(all, byHead);
}

// ---- GUARD DISCHARGE (soft-type-layer.md §4.3) -------------------------------
//
// A Mizar mode definition is almost always GUARDED — d1_subset_1 says
//   ∀X ∀t ( ( (X = ∅) ∨ (element t X ↔ t ∈ X) ) ∧ ( (X = ∅) → (element t X ↔ t = ∅) ) )
// because the notion has an "if X is non empty otherwise" clause. Seeding that axiom into the
// premise pool — what ensure-type did — cannot help: the usable biconditional is the SECOND
// DISJUNCT of the first conjunct, reachable only after `X ≠ ∅` is discharged. Measured, that seed
// fired 648 times on ordinal1 and closed nothing.
//
// This builds the usable biconditional directly. For each atom `P(t, X)` of the problem whose head
// has a guarded definition, the instance is assembled deterministically:
//   assertion at (X, t) → sp-strip the binders → simpli → ( (X=∅) ∨ BICOND )
//   ¬(X = ∅) from one of two sources (both ordinary lemmas, nothing new trusted):
//     (a) a MEMBERSHIP fact `u ∈ X` in the problem  — ne0i then df-ne
//     (b) a 0-hypothesis NON-EMPTINESS lemma matching X — pwne0 for `𝒫A`, i.e. exactly the
//         functorial cluster registrations the type table already scans
//   orel1 resolves the disjunction → BICOND, emitted as a fact carrying its whole proof.
// No search: every step is a named lemma applied to a known instance.
ruTyGuardFacts(math : RuMath, env : RuEnv, stmtClass : int, t : RuTypeTable,
	facts : [Pair<RuProofTree, RuExp>], goal : RuExp) -> [Pair<RuProofTree, RuExp>] {
	wffT = tp2id_("wff");
	c0 = s2id("c0");
	guarded = filter(t.all, \r -> r.role == RuTyDef() && r.guarded);
	if (guarded == []) [] else {
		exps = arrayPush(map(facts, \f -> f.second), goal);
		// every type-layer atom of the problem, with its argument terms
		atoms = concatA(map(exps, \e -> ruTyAtomsOf(e, buildSet(map(guarded, \r -> r.head)))));
		round = \fs : [Pair<RuProofTree, RuExp>] -> ruTyGuardRound(math, env, stmtClass, guarded, atoms, fs, goal, wffT, c0);
		first = round(facts);
		// SETHOOD FROM THE TYPE LAYER. The class-term instantiation needs `t ∈ _V`, and in a Mizar
		// article nothing supplies it: sethood is not stated, it is implied by the TYPE — every
		// Element of X is a set. The discharge has just produced `t ∈ X` facts, and elex turns each
		// into exactly the missing `t ∈ _V`. Feeding those back and re-running is what lets the
		// SECOND round instantiate at terms the first round could not touch. (Census on subset_1:
		// sethood was 42 of the refusals, across three separate sites.)
		setFacts = filtermap(first, \f -> {
			e = f.second;
			if (ruTyHeadOf(e) != s2id("wcel")) None() else {
				args = ruTyArgsOf(e);
				if (length(args) != 2 || ruTyHeadOf(args[1]) == s2id("cvv")) None() else {
					vv = RuExp([ruMakeRuleNode(s2id("cvv"), tp2id_("class"), 0, 0)], -1);
					inV = ruFwdMkRule(s2id("wcel"), wffT, [args[0], vv]);
					elex = RuProofStep(s2id_("elex"), [], RuStmt(stmtClass, [ruTyMkImp(e, inV, wffT)], -1));
					Some(Pair(RuProofStep(s2id_("ax-mp"), [f.first, elex], RuStmt(stmtClass, [inV], -1)), inV));
				}
			}
		});
		if (setFacts == []) first else {
			second = round(concat(facts, concat(first, setFacts)));
			fold(concat3(first, setFacts, second), [], \acc, f ->
				if (exists(acc, \p -> p.second.nodes == f.second.nodes)) acc else arrayPush(acc, f));
		}
	}
}

// one pass of the discharge over every type-layer atom of the problem
ruTyGuardRound(math : RuMath, env : RuEnv, stmtClass : int, guarded : [RuTyRule], atoms : [RuExp],
	facts : [Pair<RuProofTree, RuExp>], goal : RuExp, wffT : int, c0 : int) -> [Pair<RuProofTree, RuExp>] {
	{
		fold(atoms, [], \acc, atom -> {
			if (length(acc) >= 8) acc else {
				h = ruTyHeadOf(atom);
				fold(filter(guarded, \r -> r.head == h), acc, \ac, r ->
					if (length(ac) >= 8) ac
					else switch (ruTyGuardFact(math, env, stmtClass, r, atom, facts, [goal], wffT, c0)) {
						None(): ac;
						Some(f): {
							ac1 = if (exists(ac, \p -> p.second.nodes == f.second.nodes)) ac else arrayPush(ac, f);
							// If the typed atom is itself a FACT, also emit what the biconditional
							// then gives: `element x28 𝒫x4` + the bicond yields `x28 ∈ 𝒫x4`, which is
							// what the rest of the machinery can actually consume — the membership
							// unfold turns it into `x28 ⊆ x4` and the relational ∀-form instantiates
							// that at the problem's terms. Without this step the biconditional sits
							// in the pool with nothing to discharge its left side.
							ba = ruTyArgsOf(f.second);
							if (length(ba) != 2) ac1 else
								switch (ruTyFactProof(facts, atom)) {
									None(): ac1;
									Some(ap): {
										rhs = ba[1];
										if (exists(ac1, \p -> p.second.nodes == rhs.nodes)) ac1
										else arrayPush(ac1, Pair(RuProofStep(s2id_("mpbi"), [ap, f.first],
											RuStmt(stmtClass, [rhs], -1)), rhs));
									}
								};
						}
					});
			}
		});
	}
}

// atoms of `e` headed by one of `heads`
ruTyAtomsOf(e : RuExp, heads : Set<int>) -> [RuExp] {
	n = e.nodes;
	filtermap(enumFromTo(0, length(n) - 1), \i -> switch (n[i]) {
		RuVar(__, __): None();
		RuRuleNode(idT, __):
			if (!containsSet(heads, ruIdType2Id(idT))) None()
			else Some(RuExp(subrange(n, i, ruTySpanEnd(n, i) - i), -1));
	});
}

ruTySpanEnd(nodes : [RuExpNode], i : int) -> int {
	switch (nodes[i]) {
		RuVar(__, __): i + 1;
		RuRuleNode(__, al): fold(enumFromTo(1, ruArityLen2Arity(al)), i + 1, \pos, __ -> ruTySpanEnd(nodes, pos));
	}
}

ruTyHeadOf(e : RuExp) -> int {
	switch (e.nodes[0]) { RuRuleNode(idT, __): ruIdType2Id(idT); RuVar(__, __): -1; }
}

ruTyArgsOf(e : RuExp) -> [RuExp] {
	n = e.nodes;
	arity = switch (n[0]) { RuRuleNode(__, al): ruArityLen2Arity(al); RuVar(__, __): 0; };
	(fold(enumFromTo(1, arity), Pair([], 1), \acc, __ -> {
		end = ruTySpanEnd(n, acc.second);
		Pair(arrayPush(acc.first, RuExp(subrange(n, acc.second, end - acc.second), -1)), end);
	})).first;
}

// One atom `P(ā)` + one guarded definition -> the unguarded biconditional with its proof.
ruTyGuardFact(math : RuMath, env : RuEnv, stmtClass : int, r : RuTyRule, atom : RuExp,
	facts : [Pair<RuProofTree, RuExp>], goalExps : [RuExp], wffT : int, c0 : int) -> Maybe<Pair<RuProofTree, RuExp>> {
	switch (lookupTree(math.decls.assertions, r.assId)) {
		None(): None();
		Some(ass): {
			inf = ruTyInfer(ass);
			if (inf.hyps != []) None() else {
				prop = ruExp(inf.prop.exps[0]);
				// the definition's own atom, to learn which binder sits in which argument position
				pat = ruTyAtomsOf(prop, makeSet1(r.head));
				aArgs = ruTyArgsOf(atom);
				if (pat == [] || length(ruTyArgsOf(pat[0])) != length(aArgs)) {
					if (ruDeclinesOn(env)) ruDecline(env, "type/guard-discharge", "definition atom does not line up with the problem atom", ru2s(atom, math)) else {};
					None();
				} else {
					pArgs = ruTyArgsOf(pat[0]);
					// bind each definition binder to the corresponding argument of the problem's atom
					sub = fold(enumFromTo(0, length(pArgs) - 1), makeHashMap(idfn), \m, i ->
						switch (pArgs[i].nodes[0]) {
							RuVar(vid, vtp): { v = RuVar(vid, vtp);
								setHashMap(m, vid, RuSubExpr(v, aArgs[i], ruExpVarIdsHashSet(aArgs[i]))); m; }
							RuRuleNode(__, __): {
								// a coerced binder: [cv, x] — bind the inner var
								nn = pArgs[i].nodes;
								if (length(nn) != 2) m else switch (nn[1]) {
									RuVar(vid, vtp): { v = RuVar(vid, vtp);
										setHashMap(m, vid, RuSubExpr(v, aArgs[i], ruExpVarIdsHashSet(aArgs[i]))); m; }
									RuRuleNode(__, __): m;
								};
							}
						});
					// INSTANTIATE THROUGH THE CLASS-TERM CHAIN, not by substitution. A Mizar mode's
					// binders are SETVARS; the problem applies the mode at COMPOUND CLASS TERMS
					// (`element x28 𝒫x4`). Substituting a setvar binder by a class term does not
					// give an instance — it leaves a coercion wrapper, and the guard's subject then
					// comes back headed by the coercion rule instead of by 𝒫, so no non-emptiness
					// lemma can ever match it. spcv + the substitution chain + setness is the
					// licensed route (the same one the class-loci work needed).
					// The definition is ALPHA-RENAMED first: the translator names a definition's
					// loci after the Mizar locus, so its binder can carry the very id the problem
					// uses, and instantiating without renaming is variable capture.
					pool = ruSetnessPoolOfProofs(facts);
					renamed = ruTyRenameBinders(prop, facts, goalExps);
					// the ∀ prefix, outermost first, each at the argument the definition's own atom
					// puts in that position
					order = ruTyBinderOrder(renamed, r.head, length(aArgs));
					if (length(order) != length(aArgs)) None() else {
					instR = ruTyInstAll(math, env, stmtClass,
						Triple(renamed, RuProofStep(r.assId, [], RuStmt(stmtClass, [renamed], -1)), makeSet()),
						map(order, \i -> aArgs[i]), pool);
					switch (instR) {
					None(): {
						if (ruDeclinesOn(env)) ruDecline(env, "type/guard-discharge",
							"class-term instantiation of the definition failed", ru2s(atom, math)) else {};
						None();
					}
					Some(inst3): {
					stripped = Pair(inst3.first, inst3.second);
					body = stripped.first;
					// ( (X = ∅) ∨ BICOND ) ∧ ( (X = ∅) → … )   ->  take the first conjunct
					if (ruTyHeadOf(body) != s2id("wa")) {
						if (ruDeclinesOn(env)) ruDecline(env, "type/guard-discharge", "stripped definition body is not a conjunction", ru2s(body, math)) else {};
						None();
					} else {
						conj = ruTyArgsOf(body);
						disj = conj[0];
						pDisj = RuProofStep(s2id_("simpli"), [stripped.second], RuStmt(stmtClass, [disj], -1));
						if (ruTyHeadOf(disj) != s2id("wo")) {
							if (ruDeclinesOn(env)) ruDecline(env, "type/guard-discharge", "first conjunct is not the empty-case disjunction", ru2s(disj, math)) else {};
							None();
						} else {
							dArgs = ruTyArgsOf(disj);
							emptyEq = dArgs[0];         // (X = ∅)
							bicond  = dArgs[1];         // the usable characterisation
							if (ruTyHeadOf(emptyEq) != s2id("wceq")) {
								if (ruDeclinesOn(env)) ruDecline(env, "type/guard-discharge", "left disjunct is not an equality", ru2s(emptyEq, math)) else {};
								None();
							} else {
								xTerm = (ruTyArgsOf(emptyEq))[0];
								switch (ruTyNonEmpty(math, env, stmtClass, xTerm, emptyEq, facts, wffT, c0)) {
									None(): {
										if (ruDeclinesOn(env)) ruDecline(env, "type/guard-discharge", "cannot prove the guard (no membership fact, no non-emptiness lemma)", ru2s(xTerm, math)) else {};
										None();
									}
									Some(pNot): {
										// orel1: ¬ph → ((ph ∨ ps) → ps)
										impl = ruTyMkImp(disj, bicond, wffT);
										o1 = RuProofStep(s2id_("orel1"), [],
											RuStmt(stmtClass, [ruTyMkImp(ruTyMkNot(emptyEq, wffT), impl, wffT)], -1));
										step1 = RuProofStep(s2id_("ax-mp"), [pNot, o1], RuStmt(stmtClass, [impl], -1));
										Some(Pair(RuProofStep(s2id_("ax-mp"), [pDisj, step1],
											RuStmt(stmtClass, [bicond], -1)), bicond));
									}
								}
							}
						}
					}
					}
					}
					}
				}
			}
		}
	}
}

// ¬(X = ∅), from a membership fact about X, or from a 0-hyp non-emptiness lemma matching X.
ruTyNonEmpty(math : RuMath, env : RuEnv, stmtClass : int, xTerm : RuExp, emptyEq : RuExp,
	facts : [Pair<RuProofTree, RuExp>], wffT : int, c0 : int) -> Maybe<RuProofTree> {
	notEq = ruTyMkNot(emptyEq, wffT);
	// THE EMPTY SET AS THE GUARD SPELLS IT. A translated article declares its own ∅ (and its own
	// 𝒫): the rule ids differ from the foundation's even though both print as `∅`, so a hardcoded
	// c0 matches nothing in a Mizar article. Take the term straight out of the guard.
	emptyTerm = (ruTyArgsOf(emptyEq))[1];
	neExp = ruFwdMkRule(s2id("wne"), wffT, [xTerm, emptyTerm]);
	// (X ≠ ∅) ↔ ¬(X = ∅) — df-ne, then mpbi
	viaNe = \pNe : RuProofTree -> {
		dfne = RuProofStep(s2id_("df-ne"), [],
			RuStmt(stmtClass, [ruFwdMkRule(s2id("wb"), wffT, [neExp, notEq])], -1));
		RuProofStep(s2id_("mpbi"), [pNe, dfne], RuStmt(stmtClass, [notEq], -1));
	};
	// (a) a membership fact `u ∈ X` in the problem
	memb = fold(facts, None(), \acc, f -> switch (acc) {
		Some(__): acc;
		None(): {
			e = f.second;
			if (ruTyHeadOf(e) != s2id("wcel")) None() else {
				args = ruTyArgsOf(e);
				if (length(args) != 2 || args[1].nodes != xTerm.nodes) None() else {
					// ne0i: (B ∈ A) → (A ≠ ∅)
					ne0i = RuProofStep(s2id_("ne0i"), [], RuStmt(stmtClass, [ruTyMkImp(e, neExp, wffT)], -1));
					Some(viaNe(RuProofStep(s2id_("ax-mp"), [f.first, ne0i], RuStmt(stmtClass, [neExp], -1))));
				}
			}
		}
	});
	switch (memb) {
		Some(__): memb;
		// (b) a 0-hypothesis NON-EMPTINESS lemma whose subject matches X. Two spellings both occur
		// and both are wanted: the foundation states `𝒫A ≠ ∅` (pwne0) while a translated
		// FUNCTORIAL REGISTRATION states the ∀-closed `∀X ¬(𝒫X = ∅)` (fc1_subset_1) — which is
		// precisely where Mizar keeps this knowledge. So: strip any ∀ prefix, accept either `T ≠ ∅`
		// or `¬(T = ∅)`, match T against X, then re-apply the assertion at that instance and
		// sp-strip it back down.
		None(): fold(getTreeValues(math.decls.assertions), None(), \acc, a -> switch (acc) {
			Some(__): acc;
			None(): {
				inf = ruTyInfer(a);
				if (inf.hyps != [] || !isEmptySet(inf.vars.disjs)) None() else {
					p = ruExp(inf.prop.exps[0]);
					core = ruTyStripForalls(p);
					// the two spellings, reduced to "the subject term"
					subj = if (ruTyHeadOf(core) == s2id("wne")) {
							ca = ruTyArgsOf(core);
							if (length(ca) == 2 && ruTyHeadOf(ca[1]) == ruTyHeadOf(emptyTerm)) Some(ca[0]) else None();
						} else if (ruTyHeadOf(core) == s2id("wn")) {
							inner = (ruTyArgsOf(core))[0];
							if (ruTyHeadOf(inner) != s2id("wceq")) None() else {
								ia = ruTyArgsOf(inner);
								if (length(ia) == 2 && ruTyHeadOf(ia[1]) == ruTyHeadOf(emptyTerm)) Some(ia[0]) else None();
							}
						} else None();
					switch (subj) {
						None(): None();
						Some(tm): if (!ruTyIsCompound(tm) || ruTyHeadOf(tm) != ruTyHeadOf(xTerm)) None()
							else switch (ruMatchExp(xTerm, tm, math, env)) {
								None(): {
									if (ruDeclinesOn(env)) ruDecline(env, "type/guard-discharge",
										"non-emptiness lemma head matches but the term does not",
										ru2s(tm, math) + "  vs  " + ru2s(xTerm, math)) else {};
									None();
								}
								Some(sg): {
									instP = ruApplySubst(p, sg);
									pf0 = RuProofStep(ruTyId(a), [], RuStmt(stmtClass, [instP], -1));
									st = ruTyStripForallsP(instP, pf0, stmtClass, wffT);
									// normalise to ¬(X = ∅): a `≠` statement crosses via df-ne
									if (ruTyHeadOf(st.first) == s2id("wn")) Some(st.second)
									else if (ruTyHeadOf(st.first) == s2id("wne")) Some(viaNe(st.second))
									else None();
								}
							};
					}
				}
			}
		})
	}
}

// the ∀-strip that also BUILDS the proof (sp + ax-mp per level); the plain ruTyStripForalls
// above only peels the expression
ruTyStripForallsP(e : RuExp, pf : RuProofTree, stmtClass : int, wffT : int) -> Pair<RuExp, RuProofTree> {
	if (ruTyHeadOf(e) != s2id("wal")) Pair(e, pf) else {
		n = e.nodes;
		bodyStart = ruTySpanEnd(n, 1);
		body = RuExp(subrange(n, bodyStart, length(n) - bodyStart), -1);
		sp = RuProofStep(s2id_("sp"), [], RuStmt(stmtClass, [ruTyMkImp(e, body, wffT)], -1));
		ruTyStripForallsP(body, RuProofStep(s2id_("ax-mp"), [pf, sp], RuStmt(stmtClass, [body], -1)), stmtClass, wffT);
	}
}

ruTyMkImp(a : RuExp, b : RuExp, wffT : int) -> RuExp { ruFwdMkRule(s2id("wi"), wffT, [a, b]) }
ruTyMkNot(a : RuExp, wffT : int) -> RuExp { ruFwdMkRule(s2id("wn"), wffT, [a]) }

// ---- helpers for the class-term instantiation of a definition ----------------

// Alpha-rename every setvar of the definition to an id the problem does not use. The translator
// names a definition's loci after the Mizar locus, so `∀x5` in the definition and the theorem's own
// `x5` can be the SAME id; instantiating then captures. Costs nothing when there is no clash.
ruTyRenameBinders(prop : RuExp, facts : [Pair<RuProofTree, RuExp>], goalExps : [RuExp]) -> RuExp {
	setvarT = tp2id_("setvar");
	used0 = fold(concat(map(facts, \f -> f.second), goalExps), makeSet(), \a, e ->
		fold(ruInVarsOf(e), a, \a2, v -> insertSet(a2, v.id)));
	vs = filter(ruInVarsOf(prop), \v -> v.type == setvarT);
	r = fold(vs, Pair(makeHashMap(idfn), used0), \ac, v -> {
		f = ruInFreshSetvar(ac.second, setvarT, 0);
		fE = RuExp([RuVar(f.id, f.type)], -1);
		setHashMap(ac.first, v.id, RuSubExpr(v, fE, ruExpVarIdsHashSet(fE)));
		Pair(ac.first, insertSet(ac.second, f.id));
	});
	ruApplySubst(prop, RuSubst(r.first));
}

// For each ∀ of the prefix (outermost first) the index of the ARGUMENT POSITION it occupies in the
// definition's own atom — so the caller can instantiate binder i at the problem atom's matching
// argument rather than assuming the two orders agree.
ruTyBinderOrder(prop : RuExp, head : int, arity : int) -> [int] {
	binders = ruTyBindersOf(prop);
	pat = ruTyAtomsOf(ruTyStripForalls(prop), makeSet1(head));
	if (pat == []) [] else {
		pArgs = ruTyArgsOf(pat[0]);
		if (length(pArgs) != arity) [] else
			filtermap(binders, \b -> {
				pos = findiDef(pArgs, \a -> exists(ruInVarsOf(a), \v -> v.id == b.id), -1);
				if (pos < 0) None() else Some(pos);
			});
	}
}

ruTyBindersOf(e : RuExp) -> [RuVar] {
	if (ruInHead(e) != s2id("wal") || ruInArity(e) != 2) []
	else {
		args = ruInArgs(e);
		v = if (length(args[0].nodes) != 1) [] else switch (args[0].nodes[0]) {
			RuVar(id, tp): [RuVar(id, tp)];
			RuRuleNode(__, __): [];
		};
		concat(v, ruTyBindersOf(args[1]));
	}
}

// instantiate the whole ∀ prefix at `ts`, one class-term step per level
ruTyInstAll(math : RuMath, env : RuEnv, stmtClass : int, start : Triple<RuExp, RuProofTree, Set<RuDisj>>,
	ts : [RuExp], pool : Tree<string, RuProofTree>) -> Maybe<Triple<RuExp, RuProofTree, Set<RuDisj>>> {
	fold(ts, Some(start), \acc, t -> maybeBind(acc, \cur ->
		if (ruInHead(cur.first) != s2id("wal")) None()
		else maybeMap(ruInForallInstTermH(math, env, stmtClass, cur.first, t, pool), \r ->
			Triple(r.first,
				RuProofStep(s2id_("ax-mp"), [cur.second, r.second], RuStmt(stmtClass, [r.first], -1)),
				mergeSets(cur.third, r.third)))));
}

// the proof of `e` if it is already a fact of the problem
ruTyFactProof(facts : [Pair<RuProofTree, RuExp>], e : RuExp) -> Maybe<RuProofTree> {
	fold(facts, None(), \acc, f -> switch (acc) {
		Some(__): acc;
		None(): if (f.second.nodes == e.nodes) Some(f.first) else None();
	});
}
