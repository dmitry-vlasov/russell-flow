import comm;
import ru/util/src;      // ruTheoremIsProved (skip open `?` theorems), ruDecl2Theorem
import ru/util/target;   // ruDetermineTarget / ruTargetDecls (honour target=)
import script/value;

export {
	RuDuplicateStepsRemoved(
		larger  : RuTheorem,
		smaller : RuTheorem,
		removed : [int]
	);
	ruRemoveTheoremDuplicateSteps(theorem : RuTheorem, env : RuEnv) -> Maybe<RuDuplicateStepsRemoved>;
	ruCommRemoveDuplicateSteps : RuComm;
}

ruCommRemoveDuplicateSteps = RuComm(
	RuCommInfo(
		"remove-duplicate-steps", "refactor", "self evident", "target", false, false, 
		[RuCommArg("target", true, "the target: a theorem, file or all", "all"), ruInfoDeclArg], 
		[
			RuCommRet("remove-duplicate-steps.optimized-theorems", "int", "total number of theorems, which contain duplicate steps"),
			RuCommRet("remove-duplicate-steps.optimized-steps", "int", "total number of diplicate steps, which were removed by optimization")
		]
	),
	ruRunRemoveDuplicateSteps
);

RuDuplicateStepsAcc(
	steps : [RuStep],
	exprMap : Tree<[RuExpNode], int>,
	stepMap : Tree<int, int>
);

ruRemoveTheoremDuplicateSteps(theorem : RuTheorem, env : RuEnv) -> Maybe<RuDuplicateStepsRemoved> {
	proof = theorem.proof;
	dup_steps_inds = ref [];
	new_steps = foldi(proof.steps, RuDuplicateStepsAcc([], makeTree(), makeTree()), \i, acc, step -> {
		new_step = RuStep(step with 
			ind = length(acc.steps),
			refs = map(step.refs, \r ->
				switch (r) {
					RuStepRef(j): RuStepRef(lookupTreeDef(acc.stepMap, j, -1));
					default: r;
				}
			)
		);
		switch (lookupTree(acc.exprMap, ruExp(step.stmt.exps[0]).nodes)) {
			// The LAST step is the proof's conclusion and must survive even when it
			// duplicates an interior step: dropping it re-roots the proof at whatever
			// happens to come last (a linearized theorem whose prop-chain is shared
			// with a trailing witness lemma ends at the witness — an ill-formed proof
			// that crashes every downstream re-verify, e.g. shorten-proofs on t55).
			Some(j): if (i == length(proof.steps) - 1) {
				RuDuplicateStepsAcc(
					concat(acc.steps, [new_step]),
					acc.exprMap,
					setTree(acc.stepMap, i, length(acc.steps))
				)
			} else {
				refArrayPush(dup_steps_inds, i);
				RuDuplicateStepsAcc(acc with stepMap = setTree(acc.stepMap, i, j));
			}
			None(): {
				// Record the COMPACTED position (where new_step is appended), not the original index i:
				// stepMap and the verifier address proof.steps by compacted position, so a later step that
				// is a duplicate of this one must be redirected to length(acc.steps), not i. Storing i here
				// produced refs pointing past the shrunken array ("illegal step index") whenever steps were
				// dropped before the first occurrence (e.g. on linearized proofs with many duplicates).
				RuDuplicateStepsAcc(
					concat(acc.steps, [new_step]),
					setTree(acc.exprMap, ruExp(step.stmt.exps[0]).nodes, length(acc.steps)),
					setTree(acc.stepMap, i, length(acc.steps))
				)
			}
		}
	}).steps;
	if (length(new_steps) == length(proof.steps)) None() else {
		Some(RuDuplicateStepsRemoved(
			theorem,
			RuTheorem(theorem with 
				proof = ruUpdateProofVars(RuProof(proof with steps = new_steps), theorem, theorem)
			),
			^dup_steps_inds
		));
	}
}

ruRunRemoveDuplicateSteps(unit : RuUnit) -> Maybe<RuState> {
	env = ruUnitEnv(unit);
	task = unit.task;
	state = unit.state;
	timer = ruMakeTimer();
	conf = state.conf;
	info_decl = ruTaskInfoFn2(env, task.args, "info-decl");
	math = ruMathFromSources(state.ru, env);
	target = ruDetermineTarget(task, math, env);
	reduced = filtermap(ruConcurrent(
		map(filter(filtermap(ruTargetDecls(target, math, env), ruDecl2Theorem), ruTheoremIsProved),
			\th -> \env1 -> ruRemoveTheoremDuplicateSteps(th, env1)
		), env
	), idfn);
	// Per-theorem progress; nop unless the script supplied an info-decl lambda.
	iter(reduced, \red -> info_decl(id2s(red.smaller.info.id), i2s(length(red.removed)) + " duplicate steps"));
	ret = fold(reduced, math, \acc, red -> ruMathReplaceDecl(acc, red.smaller, env));
	duplicate_steps = fold(reduced, 0, \acc, red -> acc + length(red.removed));
	Some(RuState(state with 
		ru = ret.sources,
		vars = setTree(state.vars, "remove-duplicate-steps", pairs2tree([
			Pair("optimized-theorems", flow(length(reduced))),
			Pair("optimized-steps", flow(duplicate_steps)),
			Pair("time", flow(ruTimePassed(timer)))
		]))
	));
}
