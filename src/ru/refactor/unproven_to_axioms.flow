import comm;
import script/value;
import ru/util/src;

export {
	ruCommUnprovenToAxioms : RuComm;
}

// Convert every theorem whose proof is incomplete (has open `?` steps) into an axiom. An open proof
// has no Metamath image (it would translate to an empty `$= $.` proof, which Metamath rejects and
// which crashes mm-compress-proofs), so axiomatising the unproven theorems keeps a ru -> mm export
// consistent and checkable. The proved theorems are left untouched.
ruCommUnprovenToAxioms = RuComm(
	RuCommInfo(
		"unproven-to-axioms", "refactor",
		"turn every theorem with an incomplete (open `?`) proof into an axiom (keeps a Metamath export consistent)",
		"", false, false,
		[],
		[RuCommRet("unproven-to-axioms.converted", "int", "number of theorems converted to axioms")]
	),
	ruRunUnprovenToAxioms
);

ruRunUnprovenToAxioms(unit : RuUnit) -> Maybe<RuState> {
	state = unit.state;
	timer = ruMakeTimer();
	count = ref 0;
	ru2 = mapTree(state.ru, \src ->
		RuSource(src with decls = map(src.decls, \d ->
			switch (d) {
				RuTheorem(info, infer, __, proof):
					if (ruProofIsComplete(proof)) d
					else { count := ^count + 1; RuAxiom(info, infer); }
				default: d;
			}
		))
	);
	Some(RuState(state with
		ru = ru2,
		vars = setTree(state.vars, "unproven-to-axioms", pairs2tree([
			Pair("converted", flow(^count)),
			Pair("time", flow(ruTimePassed(timer)))
		]))
	));
}
