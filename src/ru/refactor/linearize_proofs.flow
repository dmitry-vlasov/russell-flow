import comm;
import ru/util/target;
import ru/util/src;        // ruDeclIsTheorem, ruTheoremIsProved
import ru/util/lemma;      // ruMergeAllLemmasIntoProof
import ru/verify/theorem;  // ruVerifyTheorem, ruOutputVerifyErrs
import ru/map_decls;

export {
	ruCommLinearizeProofs : RuComm;
}

// The inverse of `treefy-proofs`: inline every lemma sub-proof into ONE flat (linear) proof per
// theorem (ruMergeAllLemmasIntoProof), then re-verify. A proof with no lemmas is unchanged. Only
// fully-proved theorems are touched (an open `?` theorem has no proof to flatten).
ruCommLinearizeProofs = RuComm(
	RuCommInfo(
		"linearize-proofs", "refactor", "inline all lemmas into a single flat proof per theorem", "target", false, false,
		concat([
			RuCommArg("target", true, "the target: a theorem, file or all", "all")
		], ruMapFnCommArgs), []
	),
	ruRunLinearizeProofs
);

ruRunLinearizeProofs(unit : RuUnit) -> Maybe<RuState> {
	env0 = ruUnitEnv(unit);
	task = unit.task;
	state = unit.state;
	math = ruMathFromSources(state.ru, env0);
	target = ruDetermineTarget(task, math, env0);
	linearized = ref 0;
	lin_fn = \decl, time_limit, env -> {
		th = cast(decl : RuDecl -> RuTheorem);
		merged = RuTheorem(th with proof = ruMergeAllLemmasIntoProof(th.proof, math, env));
		verified = ruVerifyTheorem(merged, math, env);
		if (verified.errs == []) {
			linearized := ^linearized + 1;
			RuMappedDecl(true, true, verified.theorem);
		} else {
			ruOutputVerifyErrs(verified, math, env);
			RuMappedDecl(true, false, decl);
		}
	};
	new_state = ruMapFnComm(
		RuUnit(unit.task, state, env0.out),
		RuMapFn(
			RuMapFnInfo(
				"linearize-proofs",
				\decl -> ruDeclIsTheorem(decl) && ruTheoremIsProved(cast(decl : RuDecl -> RuTheorem)),
				ruProofLengthMeasure,
				\ -> "linearized: " + i2s(^linearized) + " theorems"
			),
			lin_fn
		)
	);
	Some(RuState(new_state with
		vars = setTree(state.vars, "linearize-proofs", pairs2tree([
			Pair("linearized-theorems", flow(^linearized))
		]))
	));
}
