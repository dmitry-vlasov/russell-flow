import base/util/bits;
import base/util/long_array;
import base/log;

// At each change of any source struct/union bump ruCacheVersion in ru/cache/disk.

export {
	ruMakeIdType(rule : int, type : int) -> int;
	ruMakeArityLen(arity : int, len : int) -> int;

	ruIdType2Id(rule_type : int) -> int;
	ruIdType2Type(rule_type : int) -> int;
	ruArityLen2Arity(arity_len : int) -> int;
	ruArityLen2Len(arity_len : int) -> int;

	ruExpNodeMake(rule: int, type: int, arity: int, len: int) -> Long;
	ruExpNodeSetLen(n: Long, len: int) -> Long;

	ruExpNodesIsVar(nodes: ArrayOfLong, i: int) -> bool;
	ruExpNodesGetId(nodes: ArrayOfLong, i: int) -> int;
	ruExpNodesGetType(nodes: ArrayOfLong, i: int) -> int;
	ruExpNodesGetArity(nodes: ArrayOfLong, i: int) -> int;
	ruExpNodesGetLen(nodes: ArrayOfLong, i: int) -> int;
}

// A node is two 32-bit words (the two halves of a Long, or the two fields of RuRuleNode):
//   word1 "idType"  = id : low 24 bits | type : high 8 bits
//   word2 "arityLen"= arity : low 8 bits | len : high 24 bits
// Field sizes (all byte-aligned):
//   id    0 .. 2^24-1 (~16M)  rule/constant/var id  — the prover's fresh-var headroom (was 2^20)
//   type  0 .. 255            grammar type-band id  — only ~8 types exist (RU_TYPE_BAND = 256)
//   arity 0 .. 255            rule argument count   — max across the corpora is 8 (cs8)
//   len   0 .. 2^24-1 (~16M)  subexpr node count    — was 2^16-1
// The guards crash loudly rather than silently corrupt a packed node when a field overflows.

ruMakeIdType(rule : int, type : int) -> int {
	if (type < 0 || type >= 256 || rule < 0 || rule > 0xFFFFFF) {
		ruCrash("idType field overflow: rule=" + i2s(rule) + " type=" + i2s(type) + " (type must be a type-band id < 256, rule < 2^24)");
	}
	rule + bitShl(type, 24);
}

ruMakeArityLen(arity : int, len : int) -> int {
	if (arity < 0 || arity >= 256 || len < 0 || len > 0xFFFFFF) {
		ruCrash("arityLen field overflow: arity=" + i2s(arity) + " len=" + i2s(len) + " (arity < 256, len < 2^24)");
	}
	arity + bitShl(len, 8);
}

ruIdType2IdInd(rule_type : int) -> int {
	bitAnd(rule_type, 0xFFFFFF);
}

ruIdType2TypeInd(rule_type : int) -> int {
	bitUshr(rule_type, 24);
}

ruIdType2Id(rule_type : int) -> int {
	bitAnd(rule_type, 0xFFFFFF);
}

ruIdType2Type(rule_type : int) -> int {
	bitUshr(rule_type, 24);
}

ruArityLen2Arity(arity_len : int) -> int {
	bitAnd(arity_len, 0xFF);
}

ruArityLen2Len(arity_len : int) -> int {
	bitUshr(arity_len, 8);
}

// Exp nodes - plain array of longs (low = arityLen, high = idType)

ruExpNodeMake(rule: int, type: int, arity: int, len: int) -> Long {
	makeLong(arity + bitShl(len, 8), rule + bitShl(type, 24));
}

ruExpNodeSetLen(n: Long, len: int) -> Long {
	arity = bitAnd(longLow(n), 0xFF);
	makeLong(arity + bitShl(len, 8), longHigh(n));
}

ruExpNodesIsVar(nodes: ArrayOfLong, i: int) -> bool {
	ruExpNodesGetArity(nodes, i) == 0xFF;   // var marker: arity stored as -1 -> 0xFF in the 8-bit field
}
ruExpNodesGetId(nodes: ArrayOfLong, i: int) -> int {
	bitAnd(longHigh(getLongArray(nodes, i)), 0xFFFFFF);
}
ruExpNodesGetType(nodes: ArrayOfLong, i: int) -> int {
	bitUshr(longHigh(getLongArray(nodes, i)), 24);
}
ruExpNodesGetArity(nodes: ArrayOfLong, i: int) -> int {
	bitAnd(longLow(getLongArray(nodes, i)), 0xFF);
}
ruExpNodesGetLen(nodes: ArrayOfLong, i: int) -> int {
	bitUshr(longLow(getLongArray(nodes, i)), 8);
}
