import mizar/xml;
import mizar/atr;
import mptp/src;
import base/fileinfo;
import string;
import math/math;

// Translate a Mizar analyzed article XML into the (relativized FOL) TptpSource the
// MPTP back-end already turns into Russell. Milestone 1: theorem STATEMENTS only
// (the <Proposition> under each <JustifiedTheorem>); proofs come next.
//
// Mizar XML normalizes formulas to three logical primitives — <Not>, <And> (n-ary),
// <For> (typed ∀) — plus <Pred>/<Func>/<Typ>/<Is>/<Var>/<Verum>. Soft types are
// relativized here: `∀x:T . body` -> `∀x (T(x) -> body)`, `x is T` -> `T(x)`, where
// T(x) is the mode's sort predicate. Equality (`r1_hidden`) maps to TptpEq.

export {
	mizXml2Tptp(xmlContent : string, atrContent : string) -> Maybe<TptpSource>;

	// Milestone 2: per-step proof gaps. Walking a proof's skeleton, `let x:T` and
	// `assume H` accumulate a context φ; each `by`-justified step is a gap φ ⊢ P,
	// emitted in deduction form `⊢ (φ → P)`. MizGaps collects them + flags any
	// skeleton item kinds not yet handled (so coverage is data-driven).
	MizGaps(phi : [TptpForm], gaps : [MizGap], unhandled : [string]);
		MizGap(form : TptpForm, premises : [string]);   // deduction-form goal + resolved cited premises
	mizArticleGaps(xmlContent : string, atrContent : string, ethContent : string) -> Maybe<[Pair<string, MizGaps>]>;
	mizArticleGapDecls(xmlContent : string, atrContent : string, ethContent : string) -> [TptpDecl];  // t<N>_<aid>_g<k>

	// The article's environment theorems (its `.eth` — the imported theorems a proof can
	// cite via <Ref>) translated as AXIOMS, so the gaps' premises are available. Named
	// t<nr>_<aid> (kind T) / d<nr>_<aid> (kind D), matching how <Ref>s resolve.
	mizParseEnv(ethContent : string, atrContent : string) -> [TptpDecl];
}

mizParseEnv(ethContent : string, atrContent : string) -> [TptpDecl] {
	sig = mizParseAtr(atrContent);
	switch (mizParseXml(ethContent)) {
		None(): [];
		Some(root): {
			ths = if (root.tag == "Theorems") Some(root) else mizFindFirst(root.kids, "Theorems");
			switch (ths) {
				None(): [];
				Some(t): filtermap(mizKidsTagged(t, "Theorem"), \th -> {
					kind = mizAttr(th, "kind");
					if (th.kids == [] || (kind != "T" && kind != "D")) None()
					else Some(TptpDecl(
						(if (kind == "T") "t" else "d") + mizAttr(th, "nr") + "_" + toLowerCase(mizAttr(th, "aid")),
						"axiom", mizForm(sig, [], th.kids[0])));
				});
			}
		}
	}
}

mizArticleGapDecls(xmlContent : string, atrContent : string, ethContent : string) -> [TptpDecl] {
	switch (mizArticleGaps(xmlContent, atrContent, ethContent)) {
		None(): [];
		Some(thms): concatA(map(thms, \t ->
			mapi(t.second.gaps, \k, gp -> TptpDecl(t.first + "_g" + i2s(k + 1), "theorem", gp.form))));
	}
}

mizXml2Tptp(xmlContent : string, atrContent : string) -> Maybe<TptpSource> {
	sig = mizParseAtr(atrContent);
	switch (mizParseXml(xmlContent)) {
		None(): None();
		Some(root): {
			art = if (root.tag == "Article") Some(root) else mizFindFirst(root.kids, "Article");
			switch (art) {
				None(): None();
				Some(a): {
					aid  = toLowerCase(mizAttr(a, "aid"));
					thms = mizKidsTagged(a, "JustifiedTheorem");
					decls = filtermap(mapi(thms, \i, thm -> mizThmDecl(sig, aid, i, thm)), \m -> m);
					Some(TptpSource(decls, ruNoFileInfo));
				}
			}
		}
	}
}

// One <JustifiedTheorem> -> a theorem decl named t<N>_<aid> (N = 1-based position
// among the article's theorems, matching the MML/MPTP numbering).
mizThmDecl(sig : MizSig, aid : string, idx : int, thm : MizXml) -> Maybe<TptpDecl> {
	switch (mizFindFirst([thm], "Proposition")) {
		None(): None();
		Some(prop):
			if (prop.kids == []) None()
			else Some(TptpDecl("t" + i2s(idx + 1) + "_" + aid, "theorem", mizForm(sig, [], prop.kids[0])));
	}
}

// ---- Milestone 2: proof-skeleton gap extraction ----

mizArticleGaps(xmlContent : string, atrContent : string, ethContent : string) -> Maybe<[Pair<string, MizGaps>]> {
	sig    = mizParseAtr(atrContent);
	envMap = mizEnvMap(ethContent);   // env article index -> defining article id (for <Ref> resolution)
	switch (mizParseXml(xmlContent)) {
		None(): None();
		Some(root): {
			art = if (root.tag == "Article") Some(root) else mizFindFirst(root.kids, "Article");
			switch (art) {
				None(): None();
				Some(a): {
					aid  = toLowerCase(mizAttr(a, "aid"));
					thms = mizKidsTagged(a, "JustifiedTheorem");
					Some(filtermap(mapi(thms, \i, thm ->
						switch (mizFindFirst([thm], "Proof")) {
							None(): None();   // direct-by theorem: the whole statement is the (single) gap
							Some(proof): Some(Pair("t" + i2s(i + 1) + "_" + aid, mizProofGaps(sig, envMap, proof)));
						}
					), \m -> m));
				}
			}
		}
	}
}

// .eth: build env article index -> defining article id, so <Ref articlenr=N kind nr>
// resolves to the absolute premise name <t|d><nr>_<aid>.
mizEnvMap(ethContent : string) -> Tree<int, string> {
	switch (mizParseXml(ethContent)) {
		None(): makeTree();
		Some(root): {
			ths = if (root.tag == "Theorems") Some(root) else mizFindFirst(root.kids, "Theorems");
			switch (ths) {
				None(): makeTree();
				Some(t): fold(mizKidsTagged(t, "Theorem"), makeTree(), \acc, th -> {
					aid = mizAttr(th, "aid");
					if (aid == "") acc else setTree(acc, s2i(mizAttr(th, "articlenr")), aid);
				});
			}
		}
	}
}

mizRefName(envMap : Tree<int, string>, ref : MizXml) -> string {
	aid  = lookupTreeDef(envMap, s2i(mizAttr(ref, "articlenr")), "");
	kind = mizAttr(ref, "kind");
	if (aid == "") "" else (if (kind == "T") "t" else if (kind == "D") "d" else toLowerCase(kind)) + mizAttr(ref, "nr") + "_" + toLowerCase(aid);
}

mizByRefs(envMap : Tree<int, string>, by : MizXml) -> [string] {
	filtermap(mizKidsTagged(by, "Ref"), \r -> { n = mizRefName(envMap, r); if (n == "") None() else Some(n); });
}

mizProofGaps(sig : MizSig, envMap : Tree<int, string>, proof : MizXml) -> MizGaps {
	fold(proof.kids, MizGaps([], [], []), \g, item -> mizProofItem(sig, envMap, g, item));
}

// One skeleton item updates the context φ and/or appends a deduction-form gap.
mizProofItem(sig : MizSig, envMap : Tree<int, string>, g : MizGaps, item : MizXml) -> MizGaps {
	tag = item.tag;
	if (tag == "Let") {
		// `let x:T` -> add the type guard T(x) to φ (x is now a free Const by vid)
		if (item.kids == []) g
		else {
			typ = item.kids[0];
			MizGaps(arrayPush(g.phi, mizTypePred(sig, typ, TptpVar("X" + mizAttr(typ, "vid")))), g.gaps, g.unhandled);
		}
	} else if (tag == "Assume") {
		// `assume H` -> add H to φ
		hs = filtermap(item.kids, \k -> if (k.tag == "Proposition" && k.kids != []) Some(mizForm(sig, [], k.kids[0])) else None());
		MizGaps(concat(g.phi, hs), g.gaps, g.unhandled);
	} else if (tag == "Conclusion") {
		// the By is INSIDE a Conclusion
		refs = switch (mizFindFirst(item.kids, "By")) { Some(b): mizByRefs(envMap, b); None(): []; };
		mizStepGap(sig, g, mizFindFirst(item.kids, "Proposition"), refs);
	} else if (tag == "Proposition") {
		mizStepGap(sig, g, Some(item), []);   // intermediate step; its By is the NEXT sibling
	} else if (tag == "By") {
		// top-level By -> attach its refs to the most recent gap (the preceding Proposition)
		if (g.gaps == []) g
		else {
			last = lastElement(g.gaps, MizGap(TptpPred("$true", []), []));
			updated = MizGap(last.form, concat(last.premises, mizByRefs(envMap, item)));
			MizGaps(g.phi, arrayPush(subrange(g.gaps, 0, length(g.gaps) - 1), updated), g.unhandled);
		}
	} else if (tag == "BlockThesis" || tag == "Thesis" || tag == "EndPosition") {
		g;
	} else {
		MizGaps(g.phi, g.gaps, arrayPush(g.unhandled, tag));
	}
}

// A `by`-justified step: gap = (φ → P) with premises; P then joins φ as an available fact.
mizStepGap(sig : MizSig, g : MizGaps, mprop : Maybe<MizXml>, premises : [string]) -> MizGaps {
	switch (mprop) {
		None(): g;
		Some(prop):
			if (prop.kids == []) g
			else {
				p = mizForm(sig, [], prop.kids[0]);
				MizGaps(arrayPush(g.phi, p), arrayPush(g.gaps, MizGap(mizDeduction(g.phi, p), premises)), g.unhandled);
			}
	}
}

mizDeduction(phi : [TptpForm], goal : TptpForm) -> TptpForm {
	fold(reverseA(phi), goal, \acc, h -> TptpBin("imp", h, acc));
}

// ---- formula translation (binding env = var names in binding order; Var nr=1 outermost) ----

mizForm(sig : MizSig, env : [string], e : MizXml) -> TptpForm {
	kids = e.kids;
	if (e.tag == "Not") {
		TptpNeg(mizForm(sig, env, kids[0]));
	} else if (e.tag == "And") {
		mizFoldAnd(map(kids, \k -> mizForm(sig, env, k)));
	} else if (e.tag == "For") {
		// name by Mizar's vid when present (article body — matches Const naming), else by
		// binding depth (.eth env theorems omit vid). Consistent within any single decl.
		vid   = mizAttr(e, "vid");
		vname = if (vid != "") "X" + vid else "X" + i2s(length(env) + 1);
		env2  = arrayPush(env, vname);
		guard = mizTypePred(sig, kids[0], TptpVar(vname));   // kids: [Typ, body]
		body  = mizForm(sig, env2, kids[1]);
		TptpQuant("forall", [vname], TptpBin("imp", guard, body));
	} else if (e.tag == "Pred") {
		name = mizSymName(sig, mizAttr(e, "kind"), s2i(mizAttr(e, "nr")));
		args = map(kids, \k -> mizTerm(sig, env, k));
		if (name == "r1_hidden" && length(args) == 2) TptpEq(args[0], args[1])
		else TptpPred(name, args);
	} else if (e.tag == "Is") {
		mizTypePred(sig, kids[1], mizTerm(sig, env, kids[0]));   // kids: [term, Typ]
	} else if (e.tag == "Verum") {
		TptpPred("$true", []);
	} else {
		TptpPred("$unhandled_" + e.tag, []);
	}
}

mizTerm(sig : MizSig, env : [string], e : MizXml) -> TptpTerm {
	if (e.tag == "Var") {
		nr = s2i(mizAttr(e, "nr"));
		TptpVar(if (nr >= 1 && nr <= length(env)) env[nr - 1] else "Xunbound" + i2s(nr));
	} else if (e.tag == "Const") {
		TptpVar("X" + mizAttr(e, "vid"));   // a let-fixed var; same naming as For-bound (by vid)
	} else if (e.tag == "Func") {
		TptpApp(mizSymName(sig, mizAttr(e, "kind"), s2i(mizAttr(e, "nr"))),
			map(e.kids, \k -> mizTerm(sig, env, k)));
	} else if (e.tag == "LocusVar") {
		TptpVar("L" + mizAttr(e, "nr"));
	} else if (e.tag == "Int") {
		TptpApp("num" + mizAttr(e, "x"), []);
	} else {
		TptpApp("unhandled_term_" + e.tag, []);
	}
}

// `<Typ kind="M" nr=..>` applied to a term -> its sort predicate. Clusters
// (adjectives) are ignored for now (empty for the foundational base types).
mizTypePred(sig : MizSig, typ : MizXml, t : TptpTerm) -> TptpForm {
	TptpPred(mizSymName(sig, mizAttr(typ, "kind"), s2i(mizAttr(typ, "nr"))), [t]);
}

mizSymName(sig : MizSig, kind : string, nr : int) -> string {
	switch (mizResolve(sig, kind, nr)) {
		Some(c): mizConstrName(kind, c);
		None():  toLowerCase(kind) + i2s(nr) + "_unresolved";
	}
}

mizFoldAnd(fs : [TptpForm]) -> TptpForm {
	if (fs == []) TptpPred("$true", [])
	else if (length(fs) == 1) fs[0]
	else TptpBin("and", fs[0], mizFoldAnd(tail(fs)));
}
