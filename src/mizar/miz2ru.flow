import mizar/xml;
import mizar/atr;
import mizar/notation;
import fol/src;
import fol/fol2ru;
import base/fileinfo;
import string;
import math/math;

// Translate a Mizar analyzed article XML into the (relativized FOL) FolSource the
// MPTP back-end already turns into Russell. Milestone 1: theorem STATEMENTS only
// (the <Proposition> under each <JustifiedTheorem>); proofs come next.
//
// Mizar XML normalizes formulas to three logical primitives — <Not>, <And> (n-ary),
// <For> (typed ∀) — plus <Pred>/<Func>/<Typ>/<Is>/<Var>/<Verum>. Soft types are
// relativized here: `∀x:T . body` -> `∀x (T(x) -> body)`, `x is T` -> `T(x)`, where
// T(x) is the mode's sort predicate. Equality (`r1_hidden`) maps to FolEq.

export {
	// One Russell theorem per Mizar theorem: shared context `hyps` (the let-guards +
	// assumptions) and `steps` — the proof's step propositions, each later emitted as an
	// OPEN (`?`) step; the conclusion is the last step. `statement` is the full ∀ form
	// (used for the signature). A direct/no-proof theorem has hyps=[] and steps=[statement].
	// stepRefs: per step, the Mizar BY-CITATION list resolved to our assertion names
	// (t<nr>_<aid> / d<nr>_<aid>) — THE data the original checker receives as its premise
	// list (the rule of thumb: whatever the Mizar prover gets as data, we carry too).
	// Local (label) refs and scheme refs are not included: the former are already the
	// skeleton's own hyps/steps, the latter are out of scope.
	// stepPos: per step, the `<By line col>` position as "line:col" ("" for a step with no
	// By — nested Proof, scheme). The checker's derivation stamps each record with the SAME
	// position (<Inference line col>), so this is the join key between a translated open
	// step and the derivation records that close it.
	MizThm(name : string, ref : string, hyps : [FolForm], steps : [FolForm], stepRefs : [[string]], stepPos : [string], statement : FolForm, unhandled : [string]);
	mizArticleTheorems(xmlContent : string, mizSource : string, sig : MizSig, refTable : Tree<string, string>) -> Maybe<[MizThm]>;
	// (articlenr:nr:kind) -> our assertion name, from the article's .eth environment
	// (each <Theorem articlenr nr aid kind> row IS the resolution table).
	mizRefTable(ethContent : string) -> Tree<string, string>;

	// The article's environment theorems (its `.eth` — imported theorems a proof may cite)
	// as commented AXIOMS (decl + its form, for the signature). t<nr>_<aid> (T) / d<nr>_<aid> (D).
	// isReused(opSymbol) = the foundation already provides this operator (and its definition/lemmas),
	// so a Mizar DEFINITION (kind D) of it is redundant and is dropped (A-map: ∪/∩/⊆/∈/… via df-*).
	// isImportedAid(aid) = that dependency article is IMPORTED, so its theorems/defs arrive via the
	// import and must NOT be re-inlined here. The later ruMizDedupImported cannot save us: a
	// duplicate decl crashes parse-collect BEFORE it runs (relat_1 -> 't1_xtuple_0 already added',
	// which only surfaced once xtuple_0 itself began translating).
	mizParseEnv(ethContent : string, sig : MizSig, syms : MizSymbols, srcOf : (string) -> Pair<string, string>, isReused : (string, bool) -> bool, isImportedAid : (string) -> bool) -> [Pair<RuParseDecl, FolForm>];

	// The distinct DEFINING ARTICLE aids cited in the `.eth` (lower-case, e.g. "tarski", "xboole_0").
	// These are the article's direct dependencies — each becomes an `import` (so the cited theorems
	// come from the imported article, not as re-inlined axioms).
	mizEnvAids(ethContent : string) -> [string];

	// The article's OWN definitions as definitional AXIOMS (the `unfold` material the prover
	// needs — without these the `by`-gaps that expand a constructor's meaning are unprovable).
	// Each <DefTheorem> carries the defining biconditional/equation as a closed <Proposition>
	// (same shape as a theorem); named d<defnr>_<aid>. Returns (decl, form) like mizParseEnv.
	// isReused drops definitions of foundation-provided operators (see mizParseEnv).
	mizArticleDefs(xmlContent : string, mizSource : string, sig : MizSig, syms : MizSymbols, isReused : (string, bool) -> bool) -> [Pair<RuParseDecl, FolForm>];

	// Does the form mention a construct the translator could not render (`$unhandled_<Tag>`,
	// `unhandled_term_<Tag>`)? Such a form is JUNK and must never be emitted: as a theorem it is
	// unprovable, and as an env AXIOM it is a potentially FALSE assumption. Dropping it also stops
	// the placeholder constant from being declared at all — which is what made two imported
	// articles collide on `unhandled_term_Choice` (Mizar's choice term `the Element of X`).
	mizFormHasUnhandled(f : FolForm) -> bool;

	// The article's CLUSTER REGISTRATIONS as axioms. These are the rules Mizar's checker
	// applies silently to keep proofs short, and NOTHING of them was translated before — the
	// type layer's whole inference content was missing. All three kinds are ORDINARY
	// implications, so they need no new logic and no new trusted machinery:
	//   FCluster  ∀L̄ ( argGuards(L̄) → adjs(f(L̄)) )                functorial: `𝒫X is non empty`
	//   CCluster  ∀L̄∀t ( argGuards ∧ typ(t) ∧ ante(t) → cons(t) )  conditional: `finite ⇒ countable`
	//   RCluster  ∀L̄ ( argGuards(L̄) → ∃t ( typ(t) ∧ adjs(t) ) )    existential: inhabitation
	mizArticleClusters(xmlContent : string, sig : MizSig) -> [Pair<RuParseDecl, FolForm>];
}

// `srcOf(aid)` yields the (.miz, .xml) of the article that DEFINES an env entry, so each
// imported theorem/definition can carry its original Mizar surface text in its comment.
mizParseEnv(ethContent : string, sig : MizSig, syms : MizSymbols, srcOf : (string) -> Pair<string, string>, isReused : (string, bool) -> bool, isImportedAid : (string) -> bool) -> [Pair<RuParseDecl, FolForm>] {
	switch (mizParseXml(ethContent)) {
		None(): [];
		Some(root): {
			ths = if (root.tag == "Theorems") Some(root) else mizFindFirst(root.kids, "Theorems");
			switch (ths) {
				None(): [];
				Some(t): {
					nodes = filter(mizKidsTagged(t, "Theorem"), \th ->
						th.kids != [] && { k = mizAttr(th, "kind"); k == "T" || k == "D"; });
					// Parse each DEFINING article's (.miz lines, .xml tree) ONCE.
					aids = uniq(map(nodes, \th -> toLowerCase(mizAttr(th, "aid"))));
					cache = pairs2tree(map(aids, \a -> {
						p = srcOf(a);
						Pair(a, Pair(strSplit(p.first, "\n"), mizParseXml(p.second)));
					}));
					filtermap(nodes, \th -> {
						kind = mizAttr(th, "kind");
						aid  = mizAttr(th, "aid");
						nr   = mizAttr(th, "nr");
						// A definition (kind D) of a foundation-provided operator (∪/∩/⊆/∈/…) is
						// redundant — the foundation's df-* already defines it — so drop it.
						opSym = if (kind != "D") "" else mizSymName(sig, mizAttr(th, "constrkind"), s2i(mizAttr(th, "constrnr")));
						// a theorem/def of an IMPORTED dependency arrives via the import — re-inlining it here
						// duplicates the decl and CRASHES parse-collect before ruMizDedupImported can run.
						if (isImportedAid(toLowerCase(aid))
							|| (kind == "D" && isReused(opSym, mizIsWffKind(mizAttr(th, "constrkind"))))) None() else {
							nm   = (if (kind == "T") "t" else "d") + nr + "_" + toLowerCase(aid);
							form = mizResugar(mizForm(sig, [], th.kids[0]));
							surface = mizEnvSurface(lookupTree(cache, toLowerCase(aid)), kind, nr);
							// comment = Mizar reference + the original surface text, else the defined symbol.
							defsym = if (kind != "D") "" else mizSymbolReadable(syms, mizAttr(th, "constrkind"), aid, s2i(mizAttr(th, "constrnr")));
							ref = aid + ":" + (if (kind == "T") "th " else "def ") + nr;
							comment = ref + (
								if (surface != "") "  ::  " + surface
								else if (defsym == "") "" else "  (defines " + defsym + ")"
							);
							Some(Pair(folAxiomC(nm, comment, form), form));
						}
					});
				}
			}
		}
	}
}

mizEnvAids(ethContent : string) -> [string] {
	switch (mizParseXml(ethContent)) {
		None(): [];
		Some(root): {
			ths = if (root.tag == "Theorems") Some(root) else mizFindFirst(root.kids, "Theorems");
			switch (ths) {
				None(): [];
				Some(t): {
					nodes = filter(mizKidsTagged(t, "Theorem"), \th ->
						th.kids != [] && { k = mizAttr(th, "kind"); k == "T" || k == "D"; });
					uniq(map(nodes, \th -> toLowerCase(mizAttr(th, "aid"))));
				}
			}
		}
	}
}

mizArticleDefs(xmlContent : string, mizSource : string, sig : MizSig, syms : MizSymbols, isReused : (string, bool) -> bool) -> [Pair<RuParseDecl, FolForm>] {
	lines = strSplit(mizSource, "\n");
	switch (mizParseXml(xmlContent)) {
		None(): [];
		Some(root): {
			aid = switch (mizFindFirst([root], "Article")) { None(): ""; Some(ar): toLowerCase(mizAttr(ar, "aid")); };
			// (constrkind+constrnr) -> defnr, read off the <Definiens> elements (which carry defnr).
			defnrOf = fold(mizCollectAll([root], "Definiens"), makeTree(), \acc, d ->
				setTree(acc, mizAttr(d, "constrkind") + mizAttr(d, "constrnr"), mizAttr(d, "defnr")));
			filtermap(mizCollectAll([root], "DefTheorem"), \dt -> {
				ck    = mizAttr(dt, "constrkind");
				cn    = mizAttr(dt, "constrnr");
				defnr = lookupTreeDef(defnrOf, ck + cn, "");
				// drop definitions of foundation-provided operators (the foundation's df-* defines them).
				opSym = mizSymName(sig, ck, s2i(cn));
				switch (mizFindFirst([dt], "Proposition")) {
					None(): None();
					Some(prop):
						if (defnr == "" || prop.kids == [] || isReused(opSym, mizIsWffKind(ck))) None()
						else {
							form    = mizResugar(mizForm(sig, [], prop.kids[0]));
							nm      = "d" + defnr + "_" + aid;
							defsym  = mizSymbolReadable(syms, ck, toUpperCase(aid), s2i(cn));
							line    = mizFindDefLine(root, defnr);
							surface = if (line <= 0) "" else mizDefStatement(lines, mizDefStartLine(lines, line));
							ref     = toUpperCase(aid) + ":def " + defnr;
							comment = ref + (
								if (surface != "") "  ::  " + surface
								else if (defsym == "") "" else "  (defines " + defsym + ")"
							);
							Some(Pair(folAxiomC(nm, comment, form), form));
						}
				}
			});
		}
	}
}

mizArticleClusters(xmlContent : string, sig : MizSig) -> [Pair<RuParseDecl, FolForm>] {
	switch (mizParseXml(xmlContent)) {
		None(): [];
		Some(root): {
			aid = switch (mizFindFirst([root], "Article")) { None(): ""; Some(ar): toLowerCase(mizAttr(ar, "aid")); };
			concatA(map([Pair("RCluster", "rc"), Pair("CCluster", "cc"), Pair("FCluster", "fc")], \kp ->
				filtermapi(mizCollectAll([root], kp.first), \i, cl -> {
					// the loci: <ArgTypes> lists one <Typ> per LocusVar, in order. Each is read in
					// the env of the loci BEFORE it (a later locus type may mention an earlier one).
					argTyps = switch (mizFindFirst([cl], "ArgTypes")) { None(): []; Some(at): mizKidsTagged(at, "Typ"); };
					loci = fold(argTyps, Pair([], []), \ac : Pair<[string], [FolForm]>, ty -> {
						vn = "L" + i2s(length(ac.first) + 1);   // matches mizTerm's <LocusVar nr=k> naming
						Pair(arrayPush(ac.first, vn), concat(ac.second, mizTypGuards(sig, ac.first, ty, FolVar(vn))));
					});
					env = loci.first;
					rest = filter(cl.kids, \k -> k.tag != "ArgTypes");
					body = if (kp.first == "FCluster") {
						// [Func(term), Cluster…] — the registered term gains the adjectives
						fn = find(rest, \k -> mizIsTermTag(k.tag));
						switch (fn) {
							None(): None();
							Some(f): {
								t = mizTerm(sig, env, f);
								gs = mizAdjGuards(sig, env, filter(rest, \k -> k.tag == "Cluster"), t);
								if (gs == []) None() else Some(mizFoldAnd(gs));
							}
						}
					} else {
						// R/CCluster: [Cluster(ante)?, Typ, Cluster(cons)…] over a fresh subject
						ty = find(rest, \k -> k.tag == "Typ");
						switch (ty) {
							None(): None();
							Some(typ): {
								idx = findi(rest, \k -> k.tag == "Typ");
								sv = "Lt";
								tg = mizTypGuards(sig, env, typ, FolVar(sv));
								befores = filtermapi(rest, \j, k -> if (j < either(idx, 0) && k.tag == "Cluster") Some(k) else None());
								afters  = filtermapi(rest, \j, k -> if (j > either(idx, 0) && k.tag == "Cluster") Some(k) else None());
								ante = mizAdjGuards(sig, env, befores, FolVar(sv));
								cons = mizAdjGuards(sig, env, afters,  FolVar(sv));
								if (cons == []) None()
								else if (kp.first == "CCluster")
									Some(FolQuant("forall", [sv], FolBin("imp", mizFoldAnd(concat(tg, ante)), mizFoldAnd(cons))))
								else Some(FolQuant("exists", [sv], mizFoldAnd(concatA([tg, ante, cons]))));
							}
						}
					};
					maybeMap(body, \b -> {
						full = mizResugar(if (env == []) b
							else FolQuant("forall", env, if (loci.second == []) b else FolBin("imp", mizFoldAnd(loci.second), b)));
						nm = kp.second + i2s(i + 1) + "_" + aid;
						Pair(folAxiomC(nm, toUpperCase(aid) + ":" + kp.first + " " + i2s(i + 1), full), full);
					});
				})));
		}
	}
}

// Surface text of env entry (T = theorem nr, D = definition nr) from its defining article.
mizEnvSurface(cached : Maybe<Pair<[string], Maybe<MizXml>>>, kind : string, nr : string) -> string {
	switch (cached) {
		None(): "";
		Some(pr): switch (pr.second) {
			None(): "";
			Some(root): {
				line = if (kind == "T") mizFindNthTheoremLine(root, s2i(nr)) else mizFindDefLine(root, nr);
				if (line <= 0) ""
				else if (kind == "T") mizSourceStatement(pr.first, line)
				// the XML Definition line points at the means/equals BODY; scan up to the
				// `func/pred … means` definiendum line and extract from there.
				else mizDefStatement(pr.first, mizDefStartLine(pr.first, line));
			}
		}
	}
}

// Line of the n-th `theorem` (1-based) in an article's XML.
mizFindNthTheoremLine(root : MizXml, n : int) -> int {
	thms = mizCollectAll([root], "JustifiedTheorem");
	if (n >= 1 && n <= length(thms)) s2i(mizAttr(thms[n - 1], "line")) else -1;
}

// Line of the definiendum for definition number `defnr`. Each real definition emits one
// `<Definition … line=…>` (redefinitions have no line); they appear in defnr order, so the
// N-th one is def N — and its line points at the `pred/func … means …` clause itself.
mizFindDefLine(root : MizXml, defnr : string) -> int {
	defs = filter(mizCollectAll([root], "Definition"), \d -> mizAttr(d, "line") != "");
	n = s2i(defnr);
	if (n >= 1 && n <= length(defs)) s2i(mizAttr(defs[n - 1], "line")) else -1;
}

// Scan up from the means/equals body line to the `func/pred/mode/attr … ` definiendum
// line (bounded ~8 lines); returns the 1-based start line, or the body line if none.
mizDefStartLine(lines : [string], bodyLine : int) -> int {
	i0 = bodyLine - 1;
	found = mizScanUpDefHead(lines, i0, max(0, i0 - 8));
	if (found < 0) bodyLine else found + 1;
}

mizScanUpDefHead(lines : [string], i : int, lo : int) -> int {
	if (i < lo || i < 0 || i >= length(lines)) -1
	else if (mizIsDefHead(trim2(lines[i], " \t\r"))) i
	else mizScanUpDefHead(lines, i - 1, lo);
}

mizIsDefHead(t : string) -> bool {
	startsWith(t, "func ") || startsWith(t, "pred ") || startsWith(t, "mode ") ||
	startsWith(t, "attr ") || startsWith(t, "synonym ") || startsWith(t, "antonym ") ||
	startsWith(t, "struct ") || startsWith(t, "redefine ");
}

// Surface text of a definition: the `<definiendum> means/equals <body>` clause, with the
// `definition let …;` loci header and the correctness conditions/proofs stripped.
mizDefStatement(lines : [string], startLine : int) -> string {
	if (startLine < 1 || startLine > length(lines)) ""
	else {
		raw  = strGlue(mizCollectDef(lines, startLine - 1, startLine - 1, []), " ");
		norm = strGlue(filter(strSplit(strReplace(strReplace(raw, "\t", " "), "\r", " "), " "), \w -> w != ""), " ");
		body = if (startsWith(norm, "definition")) trim2(substring(norm, 10, strlen(norm) - 10), " ") else norm;
		mi = mizFirstPos(strIndexOf(body, " means "), strIndexOf(body, " equals "));
		if (mi < 0) ""    // a redefinition / mode with no means/equals — let the symbol fallback speak
		else {
			pre  = substring(body, 0, mi);
			segs = strSplit(pre, ";");
			definiendum = trim2(if (segs == []) pre else segs[length(segs) - 1], " ");
			after = substring(body, mi, strlen(body) - mi);
			semi  = strIndexOf(after, ";");
			clause = trim2(if (semi < 0) after else substring(after, 0, semi), " ");
			// drop `:Label:` tokens (e.g. :Def2:), collapse, cap.
			result = strGlue(filter(strSplit(definiendum + " " + clause, " "),
				\w -> w != "" && !(startsWith(w, ":") && endsWith(w, ":") && strlen(w) > 1)), " ");
			s = trim2(result, " ;");
			if (strlen(s) > 180) substring(s, 0, 177) + "..." else s;
		}
	}
}

mizCollectDef(lines : [string], start : int, i : int, acc : [string]) -> [string] {
	if (i >= length(lines)) acc
	else {
		code = { ci = strIndexOf(lines[i], "::"); if (ci < 0) lines[i] else substring(lines[i], 0, ci); };
		t = trim2(code, " \t\r");
		if (i > start && (t == "end;" || t == "end ;")) acc
		else mizCollectDef(lines, start, i + 1, arrayPush(acc, code));
	}
}

mizFirstPos(a : int, b : int) -> int {
	if (a < 0) b else if (b < 0) a else min(a, b);
}

mizArticleTheorems(xmlContent : string, mizSource : string, sig : MizSig, refTable : Tree<string, string>) -> Maybe<[MizThm]> {
	lines = strSplit(mizSource, "\n");
	switch (mizParseXml(xmlContent)) {
		None(): None();
		Some(root): {
			art = if (root.tag == "Article") Some(root) else mizFindFirst(root.kids, "Article");
			switch (art) {
				None(): None();
				Some(a): {
					aid  = toLowerCase(mizAttr(a, "aid"));
					thms = mizKidsTagged(a, "JustifiedTheorem");
					localTbl = foldi(thms, makeTree(), \i, acc, thm ->
						switch (mizFindFirst([thm], "Proposition")) {
							Some(prop): {
								k = mizAttr(prop, "nr") + ":" + mizAttr(prop, "vid");
								if (k == ":") acc else setTree(acc, k, "t" + i2s(i + 1) + "_" + aid);
							}
							None(): acc;
						});
					Some(filtermap(mapi(thms, \i, thm -> mizThmOfXml(sig, lines, aid, i, thm, Pair(refTable, localTbl))), \m -> m));
				}
			}
		}
	}
}

// labels: the article-local label of a hyp/step (XML Proposition nr:vid) ->
// its skeleton token "hypK"/"stepK" — CARRIED so By-citations of proof-local
// facts survive translation (Mizar checks one inference against its CITED
// premises only; dropping local refs forced the checker to consider ALL
// prior facts and blew the DNF — the 92%% decision-gap census).
MizWalk(hyps : [FolForm], steps : [FolForm], refs : [[string]], poss : [string],
	unhandled : [string], labels : Tree<string, string>);

mizRefTable(ethContent : string) -> Tree<string, string> {
	switch (mizParseXml(ethContent)) {
		None(): makeTree();
		Some(root): {
			ths = if (root.tag == "Theorems") root.kids else
				switch (mizFindFirst(root.kids, "Theorems")) { Some(t): t.kids; None(): []; };
			fold(ths, makeTree(), \acc, t ->
				if (t.tag != "Theorem") acc
				else {
					anr = mizAttr(t, "articlenr"); nr = mizAttr(t, "nr");
					kind = mizAttr(t, "kind"); aid = toLowerCase(mizAttr(t, "aid"));
					if (anr == "" || nr == "" || aid == "") acc
					else setTree(acc, anr + ":" + nr + ":" + kind,
						(if (kind == "D") "d" else "t") + nr + "_" + aid);
				});
		}
	}
}

// The <By> justification's refs. Environment refs (articlenr set) resolve through the
// .eth table; LOCAL label refs (nr/vid, no articlenr) through the article's own label
// table — the article's PRIOR THEOREMS are cited by local label in the XML (each
// JustifiedTheorem's <Proposition nr vid> is its label). Local refs that name proof-
// internal propositions resolve to nothing — they are already the skeleton's hyps/steps.
mizByRefs(tbls : Pair<Tree<string, string>, Tree<string, string>>, by : MizXml) -> [string] {
	filtermap(by.kids, \r ->
		if (r.tag != "Ref") None()
		else {
			anr = mizAttr(r, "articlenr");
			if (anr == "") lookupTree(tbls.second, mizAttr(r, "nr") + ":" + mizAttr(r, "vid"))
			else lookupTree(tbls.first, anr + ":" + mizAttr(r, "nr") + ":" + mizAttr(r, "kind"));
		});
}

// record a labeled proposition's local token (unlabeled propositions carry no nr/vid)
mizPutLabel(labels : Tree<string, string>, prop : MizXml, token : string) -> Tree<string, string> {
	nr = mizAttr(prop, "nr");
	vid = mizAttr(prop, "vid");
	if (nr == "" && vid == "") labels
	else setTree(labels, nr + ":" + vid, token);
}

// mizByRefs + LOCAL citations: a ref with no articlenr resolves first through
// the article's prior-theorem table, then through the walk's own labels — a
// proof-internal citation becomes its skeleton token ("hypK"/"stepK").
mizByRefsLoc(tbls : Pair<Tree<string, string>, Tree<string, string>>, by : MizXml,
	labels : Tree<string, string>) -> [string] {
	filtermap(by.kids, \r ->
		if (r.tag != "Ref") None()
		else {
			anr = mizAttr(r, "articlenr");
			key = mizAttr(r, "nr") + ":" + mizAttr(r, "vid");
			if (anr == "") switch (lookupTree(tbls.second, key)) {
				Some(g): Some(g);
				None(): lookupTree(labels, key);
			}
			else lookupTree(tbls.first, anr + ":" + mizAttr(r, "nr") + ":" + mizAttr(r, "kind"));
		});
}

// attach refs + the By position to the LAST collected step (a <By> follows its
// <Proposition>). The position attaches even when the By cites nothing (a linked-only
// `then` step still produces a derivation record at that position).
mizAttachRefs(w : MizWalk, rs : [string], pos : string) -> MizWalk {
	n = length(w.refs);
	if (n == 0) w
	else MizWalk(w.hyps, w.steps,
		(if (rs == []) w.refs else replace(w.refs, n - 1, concat(w.refs[n - 1], rs))),
		(if (pos == "") w.poss else replace(w.poss, n - 1, pos)),
		w.unhandled, w.labels);
}

// the `<By line col>` position as the derivation join key ("" when absent)
mizByPos(by : MizXml) -> string {
	l = mizAttr(by, "line");
	if (l == "") "" else l + ":" + mizAttr(by, "col");
}

// One <JustifiedTheorem> -> a MizThm. Direct/no-proof theorem: a single open step proving
// the statement. With a proof: the let/assume context as hyps + the proof step props as
// open steps. Falls back to the single-step form if the skeleton yielded no steps.
mizThmOfXml(sig : MizSig, lines : [string], aid : string, idx : int, thm : MizXml, tbl : Pair<Tree<string, string>, Tree<string, string>>) -> Maybe<MizThm> {
	name = "t" + i2s(idx + 1) + "_" + aid;
	src  = mizSourceStatement(lines, s2i(mizAttr(thm, "line")));
	ref  = toUpperCase(aid) + ":" + i2s(idx + 1) + (if (src == "") "" else "  ::  " + src);
	switch (mizFindFirst([thm], "Proposition")) {
		None(): None();
		Some(prop):
			if (prop.kids == []) None()
			else {
				statement = mizResugar(mizForm(sig, [], prop.kids[0]));
				// a bare-⊤ statement is the article `end` marker (canceled/empty
				// theorem slot) — nothing to prove, drop it (t115_xboole_1-class)
				if (statement == FolPred("$true", [])) None() else
				switch (mizFindFirst([thm], "Proof")) {
					None(): {
						// a DIRECT `by`-justified theorem: the By is a kid of the
						// JustifiedTheorem itself — its refs are the whole premise list
						dby = mizFindFirst(thm.kids, "By");
						drefs = switch (dby) {
							Some(by): mizByRefs(tbl, by);
							None(): [];
						};
						dpos = switch (dby) { Some(by): mizByPos(by); None(): ""; };
						Some(MizThm(name, ref, [], [statement], [drefs], [dpos], statement, []));
					}
					Some(proof): {
						w0 = mizWalkProof(sig, proof, tbl);
						// A coarse skeleton loses nested justifications (`now`-blocks etc. are
						// not walked). When NO step carries refs, attach the DEEP UNION of all
						// citations in the proof subtree to the QED step — the whole by-set is
						// that gap's premise pool. Where per-step refs exist, keep them exact.
						w = if (exists(w0.refs, \rs -> rs != []) || w0.steps == []) w0
							else {
								deep = uniq(concatA(map(mizCollectAll(proof.kids, "By"), \by -> mizByRefs(tbl, by))));
								if (deep == []) w0
								else MizWalk(w0.hyps, w0.steps,
									replace(w0.refs, length(w0.refs) - 1, deep), w0.poss, w0.unhandled, w0.labels);
							}
						if (w.steps == []) Some(MizThm(name, ref, [], [statement],
							[uniq(concatA(map(mizCollectAll(proof.kids, "By"), \by -> mizByRefs(tbl, by))))],
							[""], statement, w.unhandled))
						else {
							hyps0  = map(w.hyps, mizResugar);
							steps0 = map(w.steps, mizResugar);
							// Break bound/free variable collisions: a `given`/`consider` witness const and
							// the bound var of the existential it is eliminated from share one Mizar vid
							// (both → "X<vid>"). Russell silently drops a hyp whose var is BOTH bound (in one
							// form) and free (in another), so alpha-rename every bound var to a name disjoint
							// from all variables of the theorem.
							avoid = ref buildSet(concatA(map(concat(hyps0, arrayPush(steps0, statement)), mizFormAllVars)));
							ctr = ref 0;
							hyps1  = map(hyps0,  \h -> mizFreshenBound(h, avoid, ctr));
							steps1 = map(steps0, \s -> mizFreshenBound(s, avoid, ctr));
							Some(MizThm(name, ref, hyps1, steps1, w.refs, w.poss, statement, w.unhandled));
						}
					}
				}
			}
	}
}

// Walk a proof skeleton: `let x:T` / `assume H` -> hypotheses (shared context); each
// `by`-justified step (Conclusion or labeled Proposition) -> an open proof step.
mizWalkProof(sig : MizSig, proof : MizXml, tbl : Pair<Tree<string, string>, Tree<string, string>>) -> MizWalk {
	fold(proof.kids, MizWalk([], [], [], [], [], makeTree()), \w, item -> mizWalkItem(sig, w, item, tbl));
}

mizWalkItem(sig : MizSig, w : MizWalk, item : MizXml, tbl : Pair<Tree<string, string>, Tree<string, string>>) -> MizWalk {
	tag = item.tag;
	if (tag == "Let") {
		if (item.kids == []) w
		else {
			typ = item.kids[0];
			// `let X be set/object` adds no information (root sort = whole domain): no hyp.
			// A NON-trivial sort or an adjective (`non empty`) becomes a guard hypothesis.
			// X still gets declared as a theorem var wherever it actually occurs in the steps.
			gs = mizTypGuards(sig, [], typ, FolVar("X" + mizAttr(typ, "vid")));
			MizWalk(concat(w.hyps, gs), w.steps, w.refs, w.poss, w.unhandled, w.labels);
		}
	} else if (tag == "Assume") {
		hs = filtermap(item.kids, \k -> if (k.tag == "Proposition" && k.kids != []) Some(mizForm(sig, [], k.kids[0])) else None());
		labs = foldi(filter(item.kids, \k -> k.tag == "Proposition" && k.kids != []), w.labels, \i, a, k ->
			mizPutLabel(a, k, "hyp" + i2s(length(w.hyps) + i + 1)));
		MizWalk(concat(w.hyps, hs), w.steps, w.refs, w.poss, w.unhandled, labs);
	} else if (tag == "Given" || tag == "Consider") {
		// `given x such that P` (the existential HYPOTHESIS of an iff-backward direction) and
		// `consider x such that P` (∃-elimination): both introduce a witness variable and an
		// existential/witness proposition. Adopt every <Proposition> as a hypothesis and each
		// witness var's <Typ vid=…> as a type-guard hypothesis. Dropping these (the old behaviour,
		// they fell through to `unhandled`) lost the assumption and made the extracted theorem
		// unconditional — and often FALSE, e.g. XBOOLE_0:3 became `¬(X∩Y=∅)` with no hypothesis.
		hs = filtermap(item.kids, \k -> if (k.tag == "Proposition" && k.kids != []) Some(mizForm(sig, [], k.kids[0])) else None());
		gs = concatA(filtermap(item.kids, \k -> if (k.tag == "Typ" && mizAttr(k, "vid") != "") Some(mizTypGuards(sig, [], k, FolVar("X" + mizAttr(k, "vid")))) else None()));
		labs = foldi(filter(item.kids, \k -> k.tag == "Proposition" && k.kids != []), w.labels, \i, a, k ->
			mizPutLabel(a, k, "hyp" + i2s(length(w.hyps) + i + 1)));
		MizWalk(concatA([w.hyps, hs, gs]), w.steps, w.refs, w.poss, w.unhandled, labs);
	} else if (tag == "Conclusion") {
		// a Conclusion carries its <By> as an INNER kid (Proposition + By)
		w1 = mizAddStep(sig, w, mizFindFirst(item.kids, "Proposition"));
		switch (mizFindFirst(item.kids, "By")) {
			Some(by): mizAttachRefs(w1, mizByRefsLoc(tbl, by, w1.labels), mizByPos(by));
			None(): w1;
		}
	} else if (tag == "Proposition") {
		mizAddStep(sig, w, Some(item));
	} else if (tag == "By") {
		// a top-level <By> justifies the PRECEDING sibling <Proposition>
		mizAttachRefs(w, mizByRefsLoc(tbl, item, w.labels), mizByPos(item));
	} else if (tag == "BlockThesis" || tag == "Thesis" || tag == "EndPosition") {
		w;
	} else {
		MizWalk(w.hyps, w.steps, w.refs, w.poss, arrayPush(w.unhandled, tag), w.labels);
	}
}

mizAddStep(sig : MizSig, w : MizWalk, mprop : Maybe<MizXml>) -> MizWalk {
	switch (mprop) {
		None(): w;
		Some(prop): if (prop.kids == []) w
			else MizWalk(w.hyps, arrayPush(w.steps, mizForm(sig, [], prop.kids[0])),
				arrayPush(w.refs, []), arrayPush(w.poss, ""), w.unhandled,
				mizPutLabel(w.labels, prop, "step" + i2s(length(w.steps) + 1)));
	}
}

// Alpha-rename every quantifier-bound variable to a fresh name disjoint from `avoid` (all
// variable names of the theorem). Mizar gives an existential's bound var and the witness
// const it is eliminated to (`given`/`consider`) the SAME vid → same "X<vid>", so the bound
// var collides with the free witness var. Russell accepts a var that is only-bound OR
// only-free, but silently DROPS a hyp whose var is both bound (in one form) and free (in
// another). Freshening the bound occurrence removes the collision without changing meaning.
mizFreshenBound(f : FolForm, avoid : ref Set<string>, ctr : ref int) -> FolForm {
	switch (f) {
		FolPred(__, __):  f;
		FolEq(__, __):    f;
		FolNeg(g):        FolNeg(mizFreshenBound(g, avoid, ctr));
		FolBin(op, l, r): FolBin(op, mizFreshenBound(l, avoid, ctr), mizFreshenBound(r, avoid, ctr));
		FolQuant(op, vars, body): {
			ren     = fold(vars, makeTree(), \acc, v -> setTree(acc, v, mizFreshVar(avoid, ctr)));
			newvars = map(vars, \v -> lookupTreeDef(ren, v, v));
			FolQuant(op, newvars, mizFreshenBound(mizRenameFree(body, ren), avoid, ctr));
		}
	}
}

mizFreshVar(avoid : ref Set<string>, ctr : ref int) -> string {
	ctr := ^ctr + 1;
	nm = "X" + i2s(900 + ^ctr);
	if (containsSet(^avoid, nm)) mizFreshVar(avoid, ctr)
	else { avoid := insertSet(^avoid, nm); nm; }
}

mizRenameFree(f : FolForm, ren : Tree<string, string>) -> FolForm {
	switch (f) {
		FolPred(n, args): FolPred(n, map(args, \t -> mizRenameTerm(t, ren)));
		FolEq(l, r):      FolEq(mizRenameTerm(l, ren), mizRenameTerm(r, ren));
		FolNeg(g):        FolNeg(mizRenameFree(g, ren));
		FolBin(op, l, r): FolBin(op, mizRenameFree(l, ren), mizRenameFree(r, ren));
		// inner binder of the same name shadows the outer rename — drop it in the body
		FolQuant(op, vars, body): FolQuant(op, vars, mizRenameFree(body, fold(vars, ren, \acc, v -> removeFromTree(acc, v))));
	}
}

mizRenameTerm(t : FolTerm, ren : Tree<string, string>) -> FolTerm {
	switch (t) {
		FolVar(nm):       FolVar(lookupTreeDef(ren, nm, nm));
		FolAbs(v, body):  FolAbs(lookupTreeDef(ren, v, v), mizRenameFree(body, ren));
		FolApp(nm, args): FolApp(nm, map(args, \a -> mizRenameTerm(a, ren)));
	}
}

// Every variable name (free and bound) appearing in a form — used to pick fresh, collision-
// free bound-var names in mizFreshenBound.
mizFormAllVars(f : FolForm) -> [string] {
	switch (f) {
		FolPred(__, args): concatA(map(args, mizTermAllVars));
		FolEq(l, r):       concat(mizTermAllVars(l), mizTermAllVars(r));
		FolNeg(g):         mizFormAllVars(g);
		FolBin(__, l, r):  concat(mizFormAllVars(l), mizFormAllVars(r));
		FolQuant(__, vs, body): concat(vs, mizFormAllVars(body));
	}
}

mizTermAllVars(t : FolTerm) -> [string] {
	switch (t) {
		FolVar(nm):       [nm];
		FolAbs(v, body):  concat([v], mizFormAllVars(body));
		FolApp(__, args): concatA(map(args, mizTermAllVars));
	}
}

// ---- formula translation (binding env = var names in binding order; Var nr=1 outermost) ----

mizForm(sig : MizSig, env : [string], e : MizXml) -> FolForm {
	kids = e.kids;
	if (e.tag == "Not") {
		FolNeg(mizForm(sig, env, kids[0]));
	} else if (e.tag == "And") {
		mizFoldAnd(map(kids, \k -> mizForm(sig, env, k)));
	} else if (e.tag == "For") {
		// Name by Mizar's vid when present (article body — matches Const naming), else by
		// binding depth (.eth env theorems and the DEFINIENDUM "it"-binder of a DefTheorem
		// omit vid). The depth fallback must live in a NAMESPACE vid-names cannot produce
		// ("Xd<depth>", never "X<digits>"): a vid-less binder at depth 5 used to become
		// "X5" and SHADOW the vid-5 locus — every enumset1 `means`-definition was emitted
		// with `∀x5 ∀x5` and the definiendum aliased to its own last argument, i.e. a
		// POTENTIALLY FALSE AXIOM in the article (7 of them in the golden library).
		vid   = mizAttr(e, "vid");
		vname = if (vid != "") "X" + vid else "Xd" + i2s(length(env) + 1);
		env2  = arrayPush(env, vname);
		body  = mizForm(sig, env2, kids[1]);   // kids: [Typ, body]
		// drop the trivial set/object guard → plain ∀; keep real type/adjective
		// guards as `∀X (G X → …)` (a `non empty` adjective is a guard too).
		guards = mizTypGuards(sig, env, kids[0], FolVar(vname));
		if (guards == []) FolQuant("forall", [vname], body)
		else FolQuant("forall", [vname], FolBin("imp", mizFoldAnd(guards), body));
	} else if (e.tag == "Pred") {
		name = mizSymName(sig, mizAttr(e, "kind"), s2i(mizAttr(e, "nr")));
		args = map(kids, \k -> mizTerm(sig, env, k));
		if (name == "r1_hidden" && length(args) == 2) FolEq(args[0], args[1])
		// A-map fold: `A misses B` is definitional notation for `( A ∩ B ) = ∅` (XBOOLE_0:def 7).
		// Expand it into the foundation's class layer here so no opaque predicate survives — its
		// def axiom then collapses to a trivial `P ↔ P` and the equalizer/unfold pipeline closes
		// misses goals with no special-case tactic. (`meets` is already normalized by Mizar to
		// `¬ misses`, so it needs no separate rule.)
		else if (name == "misses" && length(args) == 2) FolEq(FolApp("∩", args), FolApp("∅", []))
		// A-map fold: `A,B are_c=-comparable` is definitional notation for `A⊆B ∨ B⊆A`
		// (XBOOLE_0:def 9) — expand like `misses`, so no opaque predicate survives.
		else if ((name == "are_c=-comparable" || name == "r3_xboole_0") && length(args) == 2)
			FolBin("or", FolPred("⊆", [args[0], args[1]]), FolPred("⊆", [args[1], args[0]]))
		// A-map fold: the `empty` ATTRIBUTE is `= ∅` (XBOOLE_0:def 1). mizTypAdjGuards already
		// folds it where it guards a TYPE, but a definition BODY reaches it as a plain predicate
		// — SUBSET_1:def 1 emitted `(empty_ x5) ∨ ((element x2 x5) ↔ (x2 ∈ x5))` with `empty_`
		// undeclared and opaque, so nothing could discharge the ∅-case and `element` stayed
		// underivable. Fold both spellings to the class layer, like misses/are_c=-comparable.
		else if ((name == "empty" || name == "empty_" || name == "v1_xboole_0") && length(args) == 1)
			FolEq(args[0], FolApp("∅", []))
		else FolPred(name, args);
	} else if (e.tag == "Is") {
		// `t is set/object` is ⊤; keep real type/adjective guards.  kids: [term, Typ]
		guards = mizTypGuards(sig, env, kids[1], mizTerm(sig, env, kids[0]));
		if (guards == []) FolPred("$true", []) else mizFoldAnd(guards);
	} else if (e.tag == "PrivPred") {
		// `defpred P[x] means φ(x)` used as `P[t]`. Mizar ALREADY INLINES the expansion in the
		// XML — a <PrivPred> carries its actual arguments followed by the fully substituted body
		// as its LAST child — so a private predicate needs no scope tracking and no
		// beta-reduction here: translate the expansion and drop the argument children.
		// (Untranslated it was the single largest remaining gap: 2.6% of all MML propositions.)
		if (kids == []) FolPred("$true", [])
		else mizForm(sig, env, kids[length(kids) - 1]);
	} else if (e.tag == "Verum") {
		FolPred("$true", []);
	} else {
		FolPred("$unhandled_" + e.tag, []);
	}
}

mizTerm(sig : MizSig, env : [string], e : MizXml) -> FolTerm {
	if (e.tag == "Var") {
		nr = s2i(mizAttr(e, "nr"));
		FolVar(if (nr >= 1 && nr <= length(env)) env[nr - 1] else "Xunbound" + i2s(nr));
	} else if (e.tag == "Const") {
		FolVar("X" + mizAttr(e, "vid"));   // a let-fixed var; same naming as For-bound (by vid)
	} else if (e.tag == "Func") {
		FolApp(mizSymName(sig, mizAttr(e, "kind"), s2i(mizAttr(e, "nr"))),
			map(e.kids, \k -> mizTerm(sig, env, k)));
	} else if (e.tag == "LocusVar") {
		FolVar("L" + mizAttr(e, "nr"));
	} else if (e.tag == "Fraenkel") {
		// `{ f(x̄) where x̄ is T̄ : P[x̄] }` — Mizar's Fraenkel (comprehension) term.
		// Children: [Typ…, RESULT term, CONDITION formula]; each <Typ> introduces a binder and
		// is itself read in the scope OUTSIDE that binder (same rule as <For>).
		// Rendered as set.mm's own class abstraction (the `cab` rule, `{ x ∣ ph }`):
		//     { y ∣ ∃x̄ ( T̄(x̄) ∧ P[x̄] ∧ y = f(x̄) ) }
		// so the term lands in the foundation's class layer instead of an opaque constant —
		// this is merge work, not a workaround. `y` is fresh, named off the binder vids.
		{
			typs = filter(e.kids, \k -> k.tag == "Typ");
			rest = filter(e.kids, \k -> k.tag != "Typ");
			if (length(rest) < 2 || typs == []) FolApp("unhandled_term_Fraenkel", []) else {
				// bind each Typ in turn; its guards are read in the env BEFORE it is added
				bound = fold(typs, Pair(env, []), \ac : Pair<[string], [Pair<string, [FolForm]>]>, ty -> {
					vid = mizAttr(ty, "vid");
					vn  = if (vid != "") "X" + vid else "Xfk" + i2s(length(ac.first) + 1);
					Pair(arrayPush(ac.first, vn),
						arrayPush(ac.second, Pair(vn, mizTypGuards(sig, ac.first, ty, FolVar(vn)))));
				});
				envIn = bound.first;
				res   = mizTerm(sig, envIn, rest[0]);                    // f(x̄)
				cond  = mizForm(sig, envIn, rest[length(rest) - 1]);     // P[x̄]
				// a fresh result variable, disjoint from every binder in scope
				y = "Yfk" + strGlue(map(typs, \ty -> mizAttr(ty, "vid")), "_");
				guards = concatA(map(bound.second, \p -> p.second));
				body = mizFoldAnd(concat(guards, [cond, FolEq(FolVar(y), res)]));
				FolAbs(y, FolQuant("exists", map(bound.second, \p -> p.first), body));
			}
		}
	} else if (e.tag == "PrivFunc") {
		// `deffunc F(x) = t(x)` used as `F(u)`. Dual to PrivPred, but the expansion comes FIRST
		// and the actual arguments follow it (verified against the <DefFunc> bodies).
		if (e.kids == []) FolApp("unhandled_term_PrivFunc", [])
		else mizTerm(sig, env, e.kids[0]);
	} else if (e.tag == "Int") {
		FolApp("num" + mizAttr(e, "x"), []);
	} else {
		FolApp("unhandled_term_" + e.tag, []);
	}
}

// `<Typ kind="M" nr=..>` applied to a term -> its sort predicate, APPLIED TO THE MODE'S
// OWN ARGUMENTS as well: `x is Element of D` -> element(x, D), not element(x).
// Dropping the arguments (the old behaviour) did not merely lose information, it emitted an
// UNSOUND definition: SUBSET_1:def 1 came out as
//   ∀D ∀x ((empty D) ∨ ((element x) ↔ (x ∈ D))) ∧ …
// whose `element x` does not mention D, so two non-empty D,D' force (x∈D ↔ x∈D') for all x.
// A parameterised mode is only correct as a predicate of arity 1 + |args|; the signature
// collector reads the arity off these formulas, so the emitted `pr_*` rule widens with it.
// Subject FIRST, then the Mizar argument order — used consistently by the definition
// (its DefTheorem travels this same path) and by every use site.
mizTypeArgs(sig : MizSig, env : [string], typ : MizXml) -> [FolTerm] {
	map(filter(typ.kids, \k -> mizIsTermTag(k.tag)), \k -> mizTerm(sig, env, k));
}

// Mizar constructor kinds that denote a WFF-former (predicate / attribute / mode) as opposed to
// a TERM-former (functor K). The A-map reuse check must be kind-aware — see FolEmit.
mizIsWffKind(kind : string) -> bool { kind == "R" || kind == "V" || kind == "M"; }

mizNameUnhandled(n : string) -> bool { startsWith(n, "unhandled") || startsWith(n, "$unhandled"); }

mizTermHasUnhandled(t : FolTerm) -> bool {
	switch (t) {
		FolVar(n):        mizNameUnhandled(n);
		FolAbs(__, body): mizFormHasUnhandled(body);
		FolApp(n, args):  mizNameUnhandled(n) || exists(args, mizTermHasUnhandled);
	}
}

mizFormHasUnhandled(f : FolForm) -> bool {
	switch (f) {
		FolPred(n, args):    mizNameUnhandled(n) || exists(args, mizTermHasUnhandled);
		FolEq(l, r):         mizTermHasUnhandled(l) || mizTermHasUnhandled(r);
		FolNeg(g):           mizFormHasUnhandled(g);
		FolBin(__, l, r):    mizFormHasUnhandled(l) || mizFormHasUnhandled(r);
		FolQuant(__, __, b): mizFormHasUnhandled(b);
	}
}

// Term-bearing children of a <Typ>/<Adjective>; <Cluster> holds adjectives, not arguments.
mizIsTermTag(tag : string) -> bool {
	tag == "Var" || tag == "Const" || tag == "Func" || tag == "LocusVar" || tag == "Int" || tag == "Num";
}

mizTypePred(sig : MizSig, env : [string], typ : MizXml, t : FolTerm) -> FolForm {
	FolPred(mizSymName(sig, mizAttr(typ, "kind"), s2i(mizAttr(typ, "nr"))),
		concat([t], mizTypeArgs(sig, env, typ)));
}

// The Typ's ADJECTIVE guards (`non empty set` etc.): each <Adjective nr=N
// [value="false"]> under the Typ's <Cluster>s becomes a guard predicate on the
// term, negated when value="false". Dropping these lost the attribute and made
// the extracted theorem FALSE — XBOOLE_1:69 (`for A being non empty set st
// A c= Y holds A meets Y`) became `∀A∀Y ¬(A⊆Y ∧ A∩Y=∅)`, refuted by A=∅.
// The `empty` attribute (XBOOLE_0:def 1) A-map-folds to `t = ∅` — the same
// policy as `misses`: no opaque predicate survives into the class layer.
// A Typ carries two clusters (lower/upper) with the same adjectives — dedupe.
mizTypAdjGuards(sig : MizSig, env : [string], typ : MizXml, t : FolTerm) -> [FolForm] {
	mizAdjGuards(sig, env, mizKidsTagged(typ, "Cluster"), t);
}

// The adjective guards carried by a list of <Cluster> nodes, applied to a term. Factored out
// of mizTypAdjGuards because a REGISTRATION carries its adjectives in bare <Cluster> siblings
// rather than inside a <Typ> (a Typ lists lower/upper clusters with the same adjectives — the
// uniq below collapses that duplication either way).
mizAdjGuards(sig : MizSig, env : [string], clusters : [MizXml], t : FolTerm) -> [FolForm] {
	// an attribute may itself be parameterised (`is Subset of D`), so carry its arguments
	// for the same soundness reason as mizTypePred.
	adjs = uniq(concatA(map(clusters, \c ->
		map(mizKidsTagged(c, "Adjective"), \a ->
			Triple(s2i(mizAttr(a, "nr")), mizAttr(a, "value") == "false",
				map(filter(a.kids, \k -> mizIsTermTag(k.tag)), \k -> mizTerm(sig, env, k)))))));
	map(adjs, \p -> {
		nm = mizSymName(sig, "V", p.first);
		pos = if (nm == "empty" || nm == "empty_" || nm == "v1_xboole_0") FolEq(t, FolApp("∅", []))
			else FolPred(nm, concat([t], p.third));
		if (p.second) FolNeg(pos) else pos;
	});
}

// ALL guards of a typed variable: the sort predicate (unless the root sort
// set/object, coextensive with the domain) plus the adjective guards.
mizTypGuards(sig : MizSig, env : [string], typ : MizXml, t : FolTerm) -> [FolForm] {
	sort = if (mizIsRootSort(sig, typ)) [] else [mizTypePred(sig, env, typ, t)];
	concat(sort, mizTypAdjGuards(sig, env, typ, t));
}

// The ROOT sorts `set` (m2_hidden) and `object` (m1_hidden) are coextensive with the whole
// domain in Mizar's Tarski–Grothendieck set theory (every object is a set), so their guard is
// ⊤. We drop these guards entirely (no `set_ X →` antecedents, no let-guard hyps) — the output
// is plain first-order set theory and needs no functor-coherence scaffolding. NON-trivial
// modes (empty, Element of, …) are NOT root sorts and keep their guards.
mizIsRootSort(sig : MizSig, typ : MizXml) -> bool {
	nm = mizSymName(sig, mizAttr(typ, "kind"), s2i(mizAttr(typ, "nr")));
	nm == "set_" || nm == "set" || nm == "object" || nm == "m1_hidden" || nm == "m2_hidden";
}

mizSymName(sig : MizSig, kind : string, nr : int) -> string {
	switch (lookupTree(sig.readable, kind + ":" + i2s(nr))) {
		Some(r): r;   // human notation symbol (in/object/union/…)
		None():
			switch (mizResolve(sig, kind, nr)) {
				Some(c): mizConstrName(kind, c);   // mechanical MPTP name for operator symbols
				None():  toLowerCase(kind) + i2s(nr) + "_unresolved";
			}
	}
}

mizFoldAnd(fs : [FolForm]) -> FolForm {
	if (fs == []) FolPred("$true", [])
	else if (length(fs) == 1) fs[0]
	else FolBin("and", fs[0], mizFoldAnd(tail(fs)));
}

// ---- re-sugar: recover →/↔/∨/∃ from Mizar's ¬/∧/∀ normal form (bottom-up) ----

mizResugar(f : FolForm) -> FolForm {
	switch (f) {
		FolPred(__, __): f;
		FolEq(__, __):   f;
		FolNeg(g):       mizResugarNeg(mizResugar(g));
		FolBin(op, a, b): mizResugarBin(op, mizResugar(a), mizResugar(b));
		FolQuant(q, vs, body): FolQuant(q, vs, mizResugar(body));
	}
}

// ¬(A ∧ ¬B) → A→B ;  ¬(¬A ∧ ¬B) → A∨B ;  ¬∀x¬P → ∃x P
mizResugarNeg(g : FolForm) -> FolForm {
	def = FolNeg(g);
	switch (g) {
		FolBin(op, a, b):
			if (op != "and") def
			else switch (b) {
				FolNeg(b1): switch (a) {
					FolNeg(a1): FolBin("or", a1, b1);
					default:     FolBin("imp", a, b1);
				}
				default: def;
			};
		FolQuant(q, vs, body):
			if (q != "forall") def
			else switch (body) { FolNeg(p): FolQuant("exists", vs, p); default: def; };
		default: def;
	}
}

// (A→B) ∧ (B→A) → A↔B
mizResugarBin(op : string, a : FolForm, b : FolForm) -> FolForm {
	def = FolBin(op, a, b);
	if (op != "and") def
	else switch (a) {
		FolBin(op1, a1, a2):
			if (op1 != "imp") def
			else switch (b) {
				FolBin(op2, b1, b2): if (op2 == "imp" && a1 == b2 && a2 == b1) FolBin("iff", a1, a2) else def;
				default: def;
			};
		default: def;
	}
}

// ---- Mizar surface source ----
// The original `.miz` statement text for a theorem, for the assertion comment. `startLine`
// is the 1-based `.miz` line of the JustifiedTheorem's `theorem` keyword (XML `line` attr).
// We gather the lines up to the proof/justification, strip the `theorem [Label:]` prefix and
// the trailing `;`/`proof`/`by …`, and collapse whitespace.
mizSourceStatement(lines : [string], startLine : int) -> string {
	if (startLine < 1 || startLine > length(lines)) ""
	else {
		raw  = strGlue(mizCollectStmt(lines, startLine - 1, startLine - 1, []), " ");
		cut  = fold([" proof", " by ", " from "], raw, \acc, m -> {
			i = strIndexOf(acc, m); if (i < 0) acc else substring(acc, 0, i);
		});
		norm = strGlue(filter(strSplit(strReplace(strReplace(cut, "\t", " "), "\r", " "), " "), \w -> w != ""), " ");
		body = if (startsWith(norm, "theorem")) trim2(substring(norm, 7, strlen(norm) - 7), " ") else norm;
		s    = trim2(mizStripLabel(body), " ;");
		if (strlen(s) > 180) substring(s, 0, 177) + "..." else s;
	}
}

mizCollectStmt(lines : [string], start : int, i : int, acc : [string]) -> [string] {
	if (i >= length(lines)) acc
	else {
		// `::` starts a Mizar line comment — strip it before looking at the code.
		code = { ci = strIndexOf(lines[i], "::"); if (ci < 0) lines[i] else substring(lines[i], 0, ci); };
		t = trim2(code, " \t\r");
		if (i > start && (startsWith(t, "proof") || t == "by" || startsWith(t, "by ") ||
			startsWith(t, "from ") || startsWith(t, "hence"))) acc
		else {
			acc2 = if (t == "") acc else arrayPush(acc, code);
			if (endsWith(t, ";")) acc2 else mizCollectStmt(lines, start, i + 1, acc2);
		}
	}
}

// Strip a leading `ThN:`-style label (short alnum word before the first `:`).
mizStripLabel(s : string) -> string {
	t  = trim2(s, " ");
	ci = strIndexOf(t, ":");
	if (ci <= 0 || ci > 12) t
	else if (mizIsAlnum(substring(t, 0, ci))) trim2(substring(t, ci + 1, strlen(t) - ci - 1), " ")
	else t;
}

mizIsAlnum(s : string) -> bool {
	n = strlen(s);
	if (n == 0) false else mizIsAlnumFrom(s, 0, n);
}
mizIsAlnumFrom(s : string, i : int, n : int) -> bool {
	if (i >= n) true
	else {
		c = getCharCodeAt(s, i);
		if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)) mizIsAlnumFrom(s, i + 1, n)
		else false;
	}
}
