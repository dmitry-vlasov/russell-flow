import comm;
import base/env;
import base/fileinfo;
import mizar/miz2ru;
import mizar/deriv;
import mizar/emit;
import mizar/atr;
import mizar/notation;
import mizar/xml;
import mizar/original/prep;
import mizar/original/accom_env;
import mizar/original/verfinit;
import mizar/original/checker;
import fol/src;
import fol/fol2ru;
import fol/pcert;
import ru/parse/exps/sources;
import ru/parse/load;
import ru/cache/cache;
import ru/util/src2s;
import ru/util/exp;
import base/util/fs;

// Commands for the Mizar analyzed-XML front-end. The proof corpus lives in the MML
// dir as per-article `.xml` (+ `.atr` for constructor resolution). Milestone 1:
//   `mizar-stmts`  — translate an article's theorem statements and print them (debug),
//   `mizar-to-ru`  — translate statements into a Russell article importing the foundation.
// Mirrors the MPTP front-end (`mptp-to-ru`): only the source changes (XML vs TPTP); the
// back-end (folArticleSource -> RuParseSource -> RuSource) is shared.

export {
	ruMizarCommands : [RuComm];
}

ruMizarCommands = [
	ruCommMizarStmts,
	ruCommMizarProofs,
	ruCommMizarToRu,
	ruCommMizarDerivation,
	ruCommTestPCert,
];

// ---- the propositional certificate's own gate: translate a battery of
// entailments through G3cp -> Hilbert (fol/pcert) and write ONE .ru file the
// ordinary verifier checks against the miz_set foundation ----

ruCommTestPCert = RuComm(
	RuCommInfo(
		"test-pcert", "io", "emit the G3cp->Hilbert certificate battery as a verifiable .ru file", "", false, false,
		[RuCommArg("out", true, "output .ru path", "pcert_test.ru")], []
	),
	ruRunTestPCert
);

ruRunTestPCert(unit : RuUnit) -> Maybe<RuState> {
	env = ruUnitEnv(unit);
	out = ruTaskStringArg(unit.task, "out", "pcert_test.ru");
	pa = RuPAtom("A"); pb = RuPAtom("B"); pc = RuPAtom("C");
	atom = \k : string -> {
		v = if (k == "A") "X5" else if (k == "B") "X7" else "X9";
		FolPred("∈", [FolVar("X2"), FolVar(v)]);
	};
	cases : [Pair<[RuPForm], RuPForm>] = [
		Pair([RuPAnd(pa, pb)], RuPAnd(pb, pa)),
		Pair([RuPOr(pa, pb), RuPNot(pa)], pb),
		Pair([RuPImp(pa, pb), pa], pb),
		Pair([RuPIff(pa, pb), pb], pa),
		Pair([], RuPImp(pa, RuPImp(pb, pa))),
		Pair([], RuPIff(RuPAnd(pa, pb), RuPAnd(pb, pa))),
		Pair([RuPNot(RuPNot(pa))], pa),
		Pair([pa], RuPOr(pa, pb)),
		Pair([], RuPTrue()),
		Pair([pa, RuPNot(pa)], pb),
		Pair([RuPImp(pa, RuPOr(pb, pc)), pa, RuPNot(pb)], pc),
		Pair([], RuPIff(RuPNot(RuPAnd(pa, pb)), RuPOr(RuPNot(pa), RuPNot(pb)))),
		Pair([RuPIff(pa, RuPOr(pb, pc)), RuPNot(pb), pa], pc),
		Pair([RuPNot(pa)], RuPImp(pa, pb)),
	];
	thms = mapi(cases, \i, cs -> switch (folPCert(cs.first, cs.second, atom)) {
		None(): "";
		Some(steps): ruPCertThmText("pcert" + i2s(i + 1), cs.first, cs.second, steps, atom);
	});
	bad = foldi(thms, [], \i, acc, t -> if (t == "") arrayPush(acc, i + 1) else acc);
	// negative control: an invalid entailment must yield a countermodel, not a proof
	negOk = switch (folPCert([RuPOr(pa, pb)], pa, atom)) { None(): true; Some(__): false; };
	if (bad != [] || !negOk) {
		env.out.error("test-pcert: no certificate for cases "
			+ strGlue(map(bad, i2s), ",") + (if (negOk) "" else "; negative control PROVED"), []);
		None();
	} else {
		text = "import mizar/miz_set;;\n\n" + concatStrings(thms);
		if (!setFileContent(out, text)) {
			env.out.error("test-pcert: cannot write " + out, []);
			None();
		} else {
			nSteps = fold(thms, 0, \acc, t -> acc + strCountOf(t, "\tstep "));
			env.out.println("test-pcert: " + i2s(length(cases)) + " cases, "
				+ i2s(nSteps) + " steps -> " + out);
			Some(unit.state);
		}
	}
}

ruPCertExpr(f : FolForm) -> string { strGlue(folFormToks(f), " "); }

ruPCertRef(r : FolPRef) -> string {
	switch (r) {
		FolPRefStep(i): "step " + i2s(i + 1);
		FolPRefFact(i): "hyp " + i2s(i + 1);
	}
}

ruPCertThmText(name : string, facts : [RuPForm], goal : RuPForm, steps : [FolPStep],
	atom : (string) -> FolForm) -> string {
	forms = map(concat(facts, [goal]), \f -> folPFol(f, atom));
	vars = sortUnique(concatA(map(forms, folFormVars)));
	hdr = "theorem " + name
		+ (if (vars == []) "" else " (" + strGlue(map(vars, \v -> v + " : setvar"), ", ") + ")")
		+ " {\n";
	hyps = concatStrings(mapi(facts, \i, f ->
		"\thyp " + i2s(i + 1) + " : wff = |- " + ruPCertExpr(folPFol(f, atom)) + " ;;\n"));
	sep = if (facts == []) "" else "\t----------\n";
	prop = "\tprop : wff = |- " + ruPCertExpr(folPFol(goal, atom)) + " ;;\n";
	body = concatStrings(mapi(steps, \i, s ->
		"\tstep " + i2s(i + 1) + " : wff = " + s.assertion
		+ " (" + strGlue(map(s.refs, ruPCertRef), ", ") + ") |- "
		+ ruPCertExpr(s.form) + " ;;\n"));
	hdr + hyps + sep + prop + "} proof {\n" + body + "}\n";
}

// ---- the completer's coverage census: run the ported checker in-process and
// classify every derivation record by the closing family ----

ruCommMizarDerivation = RuComm(
	RuCommInfo(
		"mizar-derivation", "io", "run the ported checker on an article and classify its derivation records by closing family (the completer's coverage census)", "article", false, false,
		[
			RuCommArg("article", false, "article name (e.g. xboole_1)", ""),
			RuCommArg("dir", true, "MML dir with .miz + .evl + prel/ (default $RUSSELL_MATH/MML/mml)", ""),
			RuCommArg("from-source", true, "1 = the translated skeleton also reads its intermediates from the in-memory producers", "0")
		], []
	),
	ruRunMizarDerivation
);

ruRunMizarDerivation(unit : RuUnit) -> Maybe<RuState> {
	env = ruUnitEnv(unit);
	article = ruTaskStringArg(unit.task, "article", "");
	dir = mizArticleDir(unit);
	if (dir == "" || article == "") {
		env.out.error("mizar-derivation: 'article' is required (and a resolvable MML dir)", []);
		None();
	} else {
		mizFiles = "/usr/local/share/mizar/";
		mizSetDerivXmlOn(true);
		r = mizMSMVerifyArticleEx(dir, article, mizFiles,
			mizAccomEnvLoader(dir, article, mizFiles), false, false, false, false);
		mizSetDerivXmlOn(false);
		switch (r.stats) {
			None(): { env.out.error("mizar-derivation: the checker did not run", []); None(); }
			Some(s): {
				xmlStr = "<Derivation>\n"
					+ concatStrings(vector2array(s.derivXml)) + "</Derivation>\n";
				switch (mizParseXml(xmlStr)) {
					None(): { env.out.error("mizar-derivation: bad derivation XML", []); None(); }
					Some(root): {
						infs = mizKidsTagged(root, "Inference");
						// the translated proof skeleton's step positions — <Inference line col>
						// equals the step's <By line col>, so this joins each derivation
						// record to the open step it closes (the completer's input pairing)
						tsrc = mizMakeMmlSrc(unit);
						dsig = mizReadSig(tsrc, article);
						thms = either(mizArticleTheorems(mizFile(tsrc, article, "xml"),
							mizFile(tsrc, article, "miz"), dsig,
							mizRefTable(mizEth(tsrc, article))), []);
						// By position -> the owning theorem's Const scope (nr -> vid):
						// the evidence bridge recovers the record constants' identities
						// from the theorem's own analyzed-XML subtree
						posScope = switch (mizParseXml(mizFile(tsrc, article, "xml"))) {
							None(): makeTree();
							Some(ax): fold(mizCollectAll([ax], "JustifiedTheorem"), makeTree(), \acc, t -> {
								sc = mizConstScope(t);
								fold(mizByPositions(t), acc, \ac, p -> setTree(ac, p, sc));
							});
						};
						stepPoss = fold(thms, makeSet(), \acc, t ->
							fold(t.stepPos, acc, \ac, p -> if (p == "") ac else insertSet(ac, p)));
						nSteps = fold(thms, 0, \acc, t -> acc + length(t.steps));
						nStepsPos = fold(thms, 0, \acc, t ->
							acc + length(filter(t.stepPos, \p -> p != "")));
						matched = ref 0;
						pureMatched = ref 0;
						// evidence bridge counters, over the JOINED pure-verify records
						nRec = ref 0;        // Verify records seen
						nPremOk = ref 0;     // premise translates with no unhandled marker
						nWitOk = ref 0;      // every witness term translates clean
						nFullOk = ref 0;     // both — the record is completer-ready
						nEvComplete = ref 0; // inferences with EVERY disjunct completer-ready
						// per-assign failure split: what blocks a witness term
						nAsg = ref 0;
						nAsgEq = ref 0;      // references an equalizer class (EqClass/It)
						nAsgConst = ref 0;   // a constant the theorem scope cannot map
						nFact = ref 0;         // records whose instantiated fact computes
						nFactComplete = ref 0; // inferences with a fact for EVERY disjunct
						// the merge log (congruence-closure proof forest): volume + reasons
						nMerge = ref 0;
						nDisjWithMerge = ref 0;
						maxMerge = ref 0;
						byPhase = ref makeTree();
						nFNoInst = ref 0;   // no <Instance> in the record
						nFInstBad = ref 0;  // instance formula does not translate
						nFPartial = ref 0;  // a free variable survives / a witness fails
						// S4b: the offline replay validator, per disjunct
						nVal = ref 0;       // disjuncts whose refutation validates
						nValDisj = ref 0;   // disjuncts checked
						valBuckets = ref makeTree();
						// S4c scoping: the PROOF-PATTERN catalog over validated
						// disjuncts — which fixed emission pattern each one needs
						patBuckets = ref makeTree();
						// per disjunct the closing family; per inference whether
						// EVERY disjunct is closed by the Verify family with a
						// witness — the first completer family's addressable set
						nDisj = ref 0;
						byFam = ref makeTree();
						bump = \k : string -> byFam := setTree(^byFam, k, lookupTreeDef(^byFam, k, 0) + 1);
						pureVerify = ref 0;
						verifyOrEq = ref 0;
						famOf = \d : MizXml -> {
							code = s2i(mizAttr(mizFindDef(d, "Contr"), "code"));
							hasWith = exists(mizKidsTagged(d, "Verify"),
								\v -> mizKidsTagged(v, "With") != []);
							if (code == 0) "open"
							else if (code >= 45 && code <= 49)
								(if (hasWith) "verify-witness" else "verify-normalized")
							else if (code >= 50) "arithmetic"
							else "equalizer";
						};
						iter(infs, \inf -> {
							ds = mizKidsTagged(inf, "Disjunct");
							iter(ds, \d -> {
								ms = mizKidsTagged(d, "Merge");
								if (ms != []) {
									nDisjWithMerge := ^nDisjWithMerge + 1;
									nMerge := ^nMerge + length(ms);
									maxMerge := max(^maxMerge, length(ms));
									iter(ms, \m -> {
										ph = mizAttr(m, "phase");
										byPhase := setTree(^byPhase, ph, lookupTreeDef(^byPhase, ph, 0) + 1);
									});
								}
								// equality provenance events: the reason each pending
								// pair exists (S2 of the full replay)
								iter(["Equation", "ConstEq", "RequirementEq", "PolyEq", "DefEq"], \tg -> {
									n = length(mizKidsTagged(d, tg));
									if (n > 0) byPhase := setTree(^byPhase, "src:" + tg,
										lookupTreeDef(^byPhase, "src:" + tg, 0) + n);
								});
							});
							fams = map(ds, famOf);
							iter(fams, \f -> { nDisj := ^nDisj + 1; bump(f); });
							ok = \f : string -> f == "verify-witness" || f == "verify-normalized";
							pure = ds != [] && forall(fams, ok);
							if (pure) pureVerify := ^pureVerify + 1;
							if (ds != [] && forall(fams, \f -> ok(f) || f == "equalizer"))
								verifyOrEq := ^verifyOrEq + 1;
							pos = mizAttr(inf, "line") + ":" + mizAttr(inf, "col");
							isM = containsSet(stepPoss, pos);
							if (isM) matched := ^matched + 1;
							if (isM && pure) pureMatched := ^pureMatched + 1;
							// the evidence bridge, on the completer's current input set:
							// joined + pure-verify. A disjunct is completer-ready when its
							// Verify record translates fully into the article dialect.
							if (isM && pure) {
								scope = lookupTreeDef(posScope, pos, makeTree());
								iter(ds, \d -> {
									nValDisj := ^nValDisj + 1;
									vr = mizDerivValidate(d);
									if (vr == "" || vr == "special-rule") nVal := ^nVal + 1;
									vk = if (vr == "") "validated" else vr;
									valBuckets := setTree(^valBuckets, vk,
										lookupTreeDef(^valBuckets, vk, 0) + 1);
									// the emission pattern this disjunct needs:
									// [split|single] x [resolution|instantiation] x
									// equality depth (none / equation-only / mixed)
									if (vr == "" || vr == "special-rule") {
										ms = mizKidsTagged(d, "Merge");
										eqOnly = forall(ms, \m ->
											mizAttr(m, "phase") == "UnionEqualsForNonComplex");
										pat = (if (length(ds) > 1) "split-" else "single-")
											+ (if (mizKidsTagged(d, "Resolve") != []) "resolve-" else "verify-")
											+ (if (ms == []) "noeq"
												else if (eqOnly) "eq" + i2s(min(length(ms), 3)) + "plus"
												else "eqmixed")
											+ (if (vr == "special-rule") "-special" else "");
										patBuckets := setTree(^patBuckets, pat,
											lookupTreeDef(^patBuckets, pat, 0) + 1);
									}
								});
								dsOk = map(ds, \d -> {
									vs = mizKidsTagged(d, "Verify");
									oks = map(vs, \v -> {
										nRec := ^nRec + 1;
										pk = mizFindDef(v, "Premise").kids;
										premOk = pk != [] &&
											!mizFormHasUnhandled(mizDerivForm(dsig, scope, pk[0]));
										// no <With> = contradictory as normalized: no witnesses needed
										witOk = forall(map(mizKidsTagged(v, "With"), \wt ->
											forall(map(mizKidsTagged(wt, "Assign"), \a -> {
												nAsg := ^nAsg + 1;
												hasEq = mizCollectAll(a.kids, "EqClass") != []
													|| mizCollectAll(a.kids, "It") != [];
												asgOk = a.kids != [] &&
													!mizTermHasUnhandled(mizDerivTerm(dsig, scope, a.kids[0]));
												if (hasEq) nAsgEq := ^nAsgEq + 1
												else if (!asgOk) nAsgConst := ^nAsgConst + 1;
												asgOk;
											}), idfn)), idfn);
										if (premOk) nPremOk := ^nPremOk + 1;
										if (witOk) nWitOk := ^nWitOk + 1;
										if (premOk && witOk) nFullOk := ^nFullOk + 1;
										factOk = isSome(mizDerivFact(dsig, scope, v));
										if (factOk) nFact := ^nFact + 1
										else {
											prems = mizKidsTagged(v, "Premise");
											if (prems == [] || prems[0].kids == []) nFNoInst := ^nFNoInst + 1
											else if (mizFormHasUnhandled(mizDerivForm(dsig, scope, prems[0].kids[0])))
												nFInstBad := ^nFInstBad + 1
											else nFPartial := ^nFPartial + 1;
										}
										Pair(premOk && witOk, factOk);
									});
									Pair(exists(oks, \o -> o.first), exists(oks, \o -> o.second));
								});
								if (ds != [] && forall(dsOk, \o -> o.first))
									nEvComplete := ^nEvComplete + 1;
								if (ds != [] && forall(dsOk, \o -> o.second))
									nFactComplete := ^nFactComplete + 1;
							}
						});
						env.out.println("mizar-derivation: " + article + " = "
							+ i2s(length(infs)) + " inferences, " + i2s(^nDisj) + " disjuncts");
						traverseInOrder(^byFam, \k, v ->
							env.out.println("  " + k + ": " + i2s(v) + " disjuncts"));
						env.out.println("  pure-verify inferences (first completer family): "
							+ i2s(^pureVerify) + " / " + i2s(length(infs)));
						env.out.println("  verify+equalizer inferences (two families): "
							+ i2s(^verifyOrEq) + " / " + i2s(length(infs)));
						env.out.println("  translated steps carrying a By position: "
							+ i2s(nStepsPos) + " / " + i2s(nSteps));
						env.out.println("  inferences joined to a translated step: "
							+ i2s(^matched) + " / " + i2s(length(infs)));
						env.out.println("  pure-verify inferences joined (completer-addressable now): "
							+ i2s(^pureMatched) + " / " + i2s(^pureVerify));
						env.out.println("  evidence bridge over the joined set: "
							+ i2s(^nRec) + " records, premise clean " + i2s(^nPremOk)
							+ ", witnesses clean " + i2s(^nWitOk)
							+ ", completer-ready " + i2s(^nFullOk));
						env.out.println("  evidence-complete inferences (every disjunct ready): "
							+ i2s(^nEvComplete) + " / " + i2s(^pureMatched));
						env.out.println("  witness terms: " + i2s(^nAsg)
							+ ", blocked by equalizer class refs " + i2s(^nAsgEq)
							+ ", by unmapped constants " + i2s(^nAsgConst));
						env.out.println("  instantiated facts computed: " + i2s(^nFact)
							+ " / " + i2s(^nRec) + " records; fact-complete inferences: "
							+ i2s(^nFactComplete) + " / " + i2s(^pureMatched));
						env.out.println("  fact failures: no premise " + i2s(^nFNoInst)
							+ ", premise untranslatable " + i2s(^nFInstBad)
							+ ", witness/inner-quantifier " + i2s(^nFPartial));
						env.out.println("  offline replay: " + i2s(^nVal) + " / " + i2s(^nValDisj)
							+ " joined pure-verify disjuncts validate");
						traverseInOrder(^valBuckets, \bk, bn ->
							env.out.println("    replay " + bk + ": " + i2s(bn)));
						env.out.println("  emission patterns over validated disjuncts:");
						traverseInOrder(^patBuckets, \pk, pn ->
							env.out.println("    pattern " + pk + ": " + i2s(pn)));
						env.out.println("  merge log: " + i2s(^nMerge) + " merges in "
							+ i2s(^nDisjWithMerge) + " / " + i2s(^nDisj)
							+ " disjuncts, max per disjunct " + i2s(^maxMerge));
						traverseInOrder(^byPhase, \ph, n ->
							env.out.println("    merge phase " + ph + ": " + i2s(n)));
						Some(unit.state);
					}
				}
			}
		}
	}
}

// first child with the tag, or an empty element
mizFindDef(x : MizXml, tag : string) -> MizXml {
	ks = mizKidsTagged(x, tag);
	if (ks != []) ks[0] else MizXml(tag, makeTree(), []);
}

// MML analyzed-xml dir: explicit `dir=`, else the first import-root + /MML/mml.
mizArticleDir(unit : RuUnit) -> string {
	d = ruTaskStringArg(unit.task, "dir", "");
	roots = unit.state.conf.importRoots;
	if (d != "") d
	else if (roots == []) ""
	else roots[0] + "/MML/mml";
}

// Where an article's contents come from: the flat intermediate files Mizar's
// own toolchain wrote next to the .miz (the default), or — with
// `from-source=1` — the ported verifier producing every intermediate IN
// MEMORY from .miz + .evl + prel/ alone. The produced bytes are the
// env-gate-verified ones (byte-identical to the accommodated files), and the
// .xml/.msx are the analyzer/MSM reports of the same one-process run, so the
// two sources are interchangeable.
MizMmlSrc(dir : string, content : (string, string) -> string);

mizMakeMmlSrc(unit : RuUnit) -> MizMmlSrc {
	dir = mizArticleDir(unit);
	if (ruTaskStringArg(unit.task, "from-source", "0") != "1") {
		MizMmlSrc(dir, \article, ext -> {
			path = dir + "/" + article + "." + ext;
			if (fileExists(path)) getFileContent(path) else "";
		});
	} else {
		mizFiles = "/usr/local/share/mizar/";
		loaders : ref Tree<string, MizEnvLoader> = ref makeTree();
		runs : ref Tree<string, MizVerifyRun> = ref makeTree();
		loaderOf = \a -> switch (lookupTree(^loaders, a)) {
			Some(l): l;
			None(): {
				l = mizAccomEnvLoader(dir, a, mizFiles);
				loaders := setTree(^loaders, a, l);
				l;
			}
		};
		// one parse+analyze per article (deps included), cached for the run
		runOf = \a -> switch (lookupTree(^runs, a)) {
			Some(r): r;
			None(): {
				r = mizMSMVerifyArticleEx(dir, a, mizFiles, loaderOf(a),
					false, false, true, true);
				runs := setTree(^runs, a, r);
				r;
			}
		};
		MizMmlSrc(dir, \article, ext ->
			if (article == "") ""
			else if (ext == "miz") {
				path = dir + "/" + article + ".miz";
				if (fileExists(path)) getFileContent(path) else "";
			}
			else if (ext == "xml") runOf(article).xml
			else if (ext == "msx") runOf(article).msx
			else loaderOf(article).envFile("." + ext));
	}
}

mizFile(src : MizMmlSrc, article : string, ext : string) -> string {
	src.content(article, ext);
}

mizEth(src : MizMmlSrc, article : string) -> string { mizFile(src, article, "eth"); }

// The MML canonical article order (mml.lar, one aid per line) as aid -> index. This is the
// ownership order for a contested symbol: the article that introduced a notion owns its name,
// every later article that re-spells it falls back to a mechanical name. Read once per run;
// empty (all ranks unknown) if mml.lar is absent, which just restores the old drop-both rule.
mizMmlOrder(unit : RuUnit) -> Tree<string, int> {
	path = ruDirName(mizArticleDir(unit)) + "/mml.lar";
	if (!fileExists(path)) makeTree()
	else foldi(filter(map(strSplit(getFileContent(path), "\n"), trim), \l -> l != ""),
		makeTree(), \i, acc, aid -> if (containsKeyTree(acc, toLowerCase(aid))) acc else setTree(acc, toLowerCase(aid), i));
}

// ---- S-A: the GLOBAL name-ownership table ----
//
// A constructor's Russell name must be a function of the CONSTRUCTOR, never of
// the article being translated. The contest for a word is what breaks that: the
// word `real` is the notation of NUMBERS' functor AND of XREAL_0's attribute, so
// an article whose environment holds only the first names it `real`, while an
// article holding both drops the name from both and falls back to the mechanical
// `k1_numbers`. The same constructor then has two names in two articles: they no
// longer link, and importing both raises "decl 'k1_numbers' is already added"
// (5 of the first 300 articles in dependency order died exactly there).
//
// So the contest is decided over the WHOLE library, not inside one environment:
// every article's notations are read once, each word goes to the claimant whose
// defining article comes first in MML canonical order, and every other claimant
// keeps its mechanical name — in every article alike. The table is cached next
// to the MML as `russell_names.tsv` (word <TAB> owning constructor); delete the
// file to rebuild it.
mizGlobalOwnersPath(unit : RuUnit) -> string {
	ruDirName(mizArticleDir(unit)) + "/russell_names.tsv";
}

mizGlobalOwners(env : RuEnv, unit : RuUnit, src : MizMmlSrc, order : Tree<string, int>) -> Tree<string, string> {
	path = mizGlobalOwnersPath(unit);
	if (fileExists(path))
		fold(strSplit(getFileContent(path), "\n"), makeTree(), \acc, line -> {
			cols = strSplit(line, "\t");
			if (length(cols) != 2) acc else setTree(acc, cols[0], cols[1]);
		})
	else if (isEmptyTree(order)) makeTree()   // no mml.lar — no canonical order to decide with
	else {
		t = mizBuildGlobalOwners(src, order);
		text = strGlue(map(tree2pairs(t), \p -> p.first + "\t" + p.second), "\n");
		if (!setFileContent(path, text))
			env.out.error("mizar-to-ru: cannot cache the name table at " + path, []);
		t;
	}
}

// word -> the mechanical name of the constructor that owns it, read from every
// article's accommodated notations (.eno -> .frm -> .dcx). A constructor's word
// lives in the .eno of the articles that USE it, not in its own, so the whole
// library is read once.
//
// ★ THE JOIN. A `.eno` <Pattern> names its constructor by (aid, constrnr) — and
// that constrnr is the ENVIRONMENT index, the `.atr` <Constructor>'s `relnr`,
// NOT the constructor's number inside its defining article. The two differ from
// the first import on (TARSKI's four functors are relnr 81..84 in numbers.atr),
// so the pattern must be resolved through the SAME article's .atr to reach the
// absolute (aid, nr) that names the constructor everywhere.
mizBuildGlobalOwners(src : MizMmlSrc, order : Tree<string, int>) -> Tree<string, string> {
	best = fold(map(tree2pairs(order), \p -> p.first), makeTree(), \acc, a -> {
		syms = mizParseNotation(mizFile(src, a, "eno"), mizFile(src, a, "frm"), mizFile(src, a, "dcx"));
		atr = mizParseAtr(mizFile(src, a, "atr"));
		foldTree(syms.eno, acc, \key, __, ac -> {
			parts = strSplit(key, ":");
			if (length(parts) != 3) ac else {
				kind = parts[0];
				switch (lookupTree(atr.table, kind + ":" + parts[2])) {
					None(): ac;
					Some(c): {
						w0 = mizSymbolReadable(syms, kind, parts[1], c.nr, s2i(parts[2]));
						// the same final mapping the translator applies (in -> ∈, union -> ∪.)
						m = mizOpName(w0);
						w = if (m != "") m else w0;
						// A BRACKET name cannot be read from .dcx (see
						// mizIsBracketName), so a claimant found for one here is a
						// coincidence: `pair` went to XTUPLE_0's `is pair` attribute,
						// which then declared the wff-former over the bracket term's
						// own grammar rule. Brackets stay with the .msx path.
						if (w == "" || mizIsBracketName(w)) ac else {
							cn = mizConstrName(kind, c);
							r = mizAidRank(order, cn, toLowerCase(c.aid));
							switch (lookupTree(ac, w)) {
								None(): setTree(ac, w, Pair(cn, r));
								Some(cur): if (r < cur.second || (r == cur.second && cn < cur.first))
									setTree(ac, w, Pair(cn, r)) else ac;
							}
						}
					}
				}
			}
		});
	});
	mapTree(best, \p -> p.first);
}

// Rank a constructor by its defining article. HIDDEN's primitives (∈, =) precede every article;
// an aid absent from mml.lar (miz_aux, a stray) ranks last so it never steals a symbol.
mizAidRank(order : Tree<string, int>, ctorName : string, aid : string) -> int {
	if (aid == "hidden" || endsWith(ctorName, "_hidden")) -1
	else lookupTreeDef(order, aid, 1000000);
}

// The full signature (constructor resolution + readable notation names) from .atr/.eno/.frm/.dcx.
mizReadSig(src : MizMmlSrc, article : string) -> MizSig {
	mizFullSig(mizFile(src, article, "xml"), mizFile(src, article, "atr"), mizFile(src, article, "eno"),
		mizFile(src, article, "frm"), mizFile(src, article, "dcx"));
}

mizReadArticle(env : RuEnv, src : MizMmlSrc, article : string) -> Maybe<Pair<string, string>> {
	if (src.dir == "" || article == "") {
		env.out.error("mizar: 'article' is required (and a resolvable MML dir — pass dir= or set RUSSELL_MATH)", []);
		None();
	} else {
		xml = mizFile(src, article, "xml");
		atr = mizFile(src, article, "atr");
		if (xml == "") { env.out.error("mizar: no .xml for " + article + " in " + src.dir, []); None(); }
		else if (atr == "") { env.out.error("mizar: no .atr for " + article + " (verify the article first)", []); None(); }
		else Some(Pair(xml, atr));
	}
}

ruCommMizarStmts = RuComm(
	RuCommInfo(
		"mizar-stmts", "io", "translate a Mizar article's theorem statements to relativized FOL and print them", "article", false, false,
		[
			RuCommArg("article", false, "article name (e.g. tarski)", ""),
			RuCommArg("dir", true, "MML analyzed-xml dir (default $RUSSELL_MATH/MML/mml)", ""),
			RuCommArg("from-source", true, "1 = produce every intermediate in memory from .miz + .evl + prel/ (the ported verifier); 0 = read the flat files (default)", "0")
		], []
	),
	ruRunMizarStmts
);

ruRunMizarStmts(unit : RuUnit) -> Maybe<RuState> {
	env = ruUnitEnv(unit);
	article = ruTaskStringArg(unit.task, "article", "");
	src = mizMakeMmlSrc(unit);
	switch (mizReadArticle(env, src, article)) {
		None(): None();
		Some(p): switch (mizArticleTheorems(p.first, mizFile(src, article, "miz"), mizReadSig(src, article), makeTree())) {
			None(): { env.out.error("mizar-stmts: no <Article> root in " + article + ".xml", []); None(); }
			Some(thms): {
				env.out.println("mizar-stmts: " + article + " -> " + i2s(length(thms)) + " theorems");
				iter(thms, \t -> env.out.println("  " + t.name + " : " + tptpForm2s(t.statement)));
				Some(unit.state);
			}
		}
	}
}

ruCommMizarProofs = RuComm(
	RuCommInfo(
		"mizar-proofs", "io", "translate a Mizar article's proof skeletons (multi-step, open) and print them", "article", false, false,
		[
			RuCommArg("article", false, "article name (e.g. xboole_1)", ""),
			RuCommArg("dir", true, "MML analyzed-xml dir (default first import-root + /MML/mml)", ""),
			RuCommArg("show", true, "how many multi-step proofs to print", "6"),
			RuCommArg("from-source", true, "1 = produce every intermediate in memory from .miz + .evl + prel/", "0")
		], []
	),
	ruRunMizarProofs
);

ruRunMizarProofs(unit : RuUnit) -> Maybe<RuState> {
	env = ruUnitEnv(unit);
	article = ruTaskStringArg(unit.task, "article", "");
	show = s2i(ruTaskStringArg(unit.task, "show", "6"));
	src = mizMakeMmlSrc(unit);
	switch (mizReadArticle(env, src, article)) {
		None(): None();
		Some(p): switch (mizArticleTheorems(p.first, mizFile(src, article, "miz"), mizReadSig(src, article), makeTree())) {
			None(): { env.out.error("mizar-proofs: no <Article> root in " + article + ".xml", []); None(); }
			Some(thms): {
				withProof = filter(thms, \t -> length(t.steps) > 1);
				unh = uniq(concatA(map(thms, \t -> t.unhandled)));
				env.out.println("mizar-proofs: " + article + " -> " + i2s(length(thms)) + " theorems, " +
					i2s(length(withProof)) + " with multi-step proofs" +
					(if (unh == []) "" else "; UNHANDLED skeleton items: " + strGlue(unh, " ")));
				iter(subrange(withProof, 0, min(show, length(withProof))), \t -> {
					env.out.println("  " + t.name + " (" + i2s(length(t.steps)) + " steps" +
						(if (t.unhandled == []) "" else ", skipped: " + strGlue(uniq(t.unhandled), " ")) + "):");
					if (t.hyps != []) env.out.println("     hyps: " + strGlue(map(t.hyps, tptpForm2s), ", ")) else {};
					iteri(t.steps, \i, s -> env.out.println("     step " + i2s(i + 1) + " : ? |- " + tptpForm2s(s)));
				});
				Some(unit.state);
			}
		}
	}
}

ruCommMizarToRu = RuComm(
	RuCommInfo(
		"mizar-to-ru", "translate", "translate a Mizar analyzed article (xml+atr) into a Russell article importing the foundation (load it first via read-ru)", "article", false, false,
		[
			RuCommArg("article", false, "article name (e.g. tarski)", ""),
			RuCommArg("dir", true, "MML analyzed-xml dir (default $RUSSELL_MATH/MML/mml)", ""),
			RuCommArg("module", true, "module name for the generated article (default = article)", ""),
			RuCommArg("foundation", true, "foundation module to import (miz_set = A-map class layer; miz_logic = flat set)", "miz_set"),
			RuCommArg("proofs", true, "1 = multi-step open proof skeletons (default), 0 = statements only", "1"),
			RuCommArg("class-loci", true, "1 = Mizar loci as CLASS metavars + setness hyps (the elpr pattern; EXPERIMENTAL — the emitter stack loses ~25 zfmisc theorems until setness-from-hyps and G-form chars land), 0 = setvar loci (default)", "0"),
			RuCommArg("from-source", true, "1 = produce every intermediate in memory from .miz + .evl + prel/", "0"),
			RuCommArg("facts", true, "1 = run the ported checker and insert its instantiated facts as intermediate open steps on each fact-complete by-gap (default 0)", "0"),
			RuCommArg("emit", true, "1 = close by-steps deterministically (membership unfolds + the G3cp->Hilbert certificate); unclosed steps stay open (default 0)", "0"),
			RuCommArg("emit-max-facts", true, "certificate budget: max facts per step attempt", "16"),
			RuCommArg("emit-max-size", true, "certificate budget: max total connective count per step attempt", "200")
		], []
	),
	ruRunMizarToRu
);

ruRunMizarToRu(unit : RuUnit) -> Maybe<RuState> {
	env = ruUnitEnv(unit);
	state = unit.state;
	article = ruTaskStringArg(unit.task, "article", "");
	module0 = ruTaskStringArg(unit.task, "module", "");
	module = if (module0 != "") module0 else article;
	foundation = ruTaskStringArg(unit.task, "foundation", "miz_set");
	// A-map (miz_set) keeps set.mm's native class layer and maps Mizar's set operations onto it;
	// the legacy flat foundation (miz_logic) emits a `set`-typed article rule for every operator.
	emit = if (foundation == "miz_logic") folFlatEmit() else folAmapEmit();
	proofsOn = ruTaskStringArg(unit.task, "proofs", "1") != "0";
	classLoci = ruTaskStringArg(unit.task, "class-loci", "0") == "1";
	src0 = mizMakeMmlSrc(unit);
	sig0 = mizReadSig(src0, article);
	// Surface spellings (\+\, c=, ∪/∩/\, …) per defining article (read .xml+.msx once each).
	aids = uniq(map(getTreeValues(sig0.table), \c -> toLowerCase(c.aid)));
	spellCache = pairs2tree(map(aids, \a -> Pair(a, mizSpellingMap(mizFile(src0, a, "xml"), mizFile(src0, a, "msx")))));
	spellOf = \kind, c : MizAtrConstr -> lookupTreeDef(lookupTreeDef(spellCache, toLowerCase(c.aid), makeTree()), kind + ":" + i2s(c.nr), Pair("", 0));
	// Build the readable-name map from the .msx surface symbols (the reliable source): operators
	// get the math symbol (∪/⊆/△/…), bracket functors an arity-disambiguated name
	// (singleton/pair/opair), clean words themselves (union/misses/…). Fall back to the .eno-based
	// sig0.readable only for symbols with no .msx (HIDDEN: in/object/set). Then dedup so no two
	// constructors share a Russell name.
	// Names already taken by foundation assertions (theorems/axioms/defs/congruences). A Mizar
	// clean word that clashes (e.g. `empty` vs set.mm's `theorem empty`) would collide on read,
	// so it gets a trailing `_` — the same disambiguation already used for set_/object.
	reserved = foldTree(state.ru, makeSet(), \__, s, acc ->
		fold(s.decls, acc, \ac, d -> if (ruDeclIsAssertion(d)) insertSet(ac, id2s(d.info.id)) else ac));
	mmlOrder = mizMmlOrder(unit);
	globalOwners = mizGlobalOwners(env, unit, src0, mmlOrder);
	// The table read the other way: constructor -> the word it owns. An article
	// cannot see the notation of its OWN constructors (a constructor's word lives
	// in the .eno of the articles that IMPORT it, never in its own), so funct_1
	// called its attribute `v3_funct_1` while every importer called it
	// `constant_` — and two importers then declared that constant, its
	// congruence and its congruence axiom twice. Reading the name out of the
	// global table gives the defining article the same name as everyone else.
	ownerWord = foldTree(globalOwners, makeTree(), \w, cn, acc ->
		if (containsKeyTree(acc, cn)) acc else setTree(acc, cn, w));
	merged = foldTree(sig0.table, makeTree(), \key, c, acc -> {
		sa = spellOf(strSplit(key, ":")[0], c);
		fromMsx = if (sa.first == "") "" else mizSymbolName(sa.first, sa.second);
		nm1 = lookupTreeDef(sig0.readable, key,
			lookupTreeDef(ownerWord, mizConstrName(strSplit(key, ":")[0], c), ""));
		nm0 = if (fromMsx != "") fromMsx else nm1;
		// final: map a clean-word name that has a math symbol (in -> ∈, union -> ⋃) — covers the
		// HIDDEN fallback (`in`) which has no .msx. Symbols/other words pass through unchanged.
		nm = {
			m = mizOpName(nm0); base = if (m != "") m else nm0;
			if (base != "" && containsSet(reserved, base)) base + "_" else base;
		};
		if (nm == "") acc else setTree(acc, key, nm);
	});
	// Dedup by DISTINCT constructor, not by table key — a redefinition alias (TARSKI's
	// `in` -> HIDDEN ∈) puts the same constructor under two keys and must keep its name.
	mcounts = foldTree(merged, makeTree(), \k, v, acc -> {
		cn = switch (lookupTree(sig0.table, k)) {
			Some(c): mizConstrName(strSplit(k, ":")[0], c);
			None(): k;
		};
		setTree(acc, v, insertSet(lookupTreeDef(acc, v, makeSet()), cn));
	});
	// SENIORITY on collision. A new article routinely re-spells a primitive symbol for its
	// own notion — subset_1 spells BOTH `{}` (k1_subset_1, the empty Subset) and `in`
	// (k10_subset_1) exactly as XBOOLE_0's ∅ and HIDDEN's ∈. Dropping the name from ALL
	// claimants (the old rule) then severed the FOUNDATION's own ∈/∅: every imported lemma
	// stopped applying and subset_1 proved 11/53 on both paths. So when a name is contested,
	// the IMPORTED constructor keeps it and the article's OWN newcomer falls back to its
	// mechanical MPTP name (still unique, just unsugared). Contest purely among imports
	// (zfmisc's 5 `are_mutually_distinct` relations) stays ambiguous and is still dropped.
	isOwn = \cn : string -> endsWith(cn, "_" + toLowerCase(article));
	mseniors = foldTree(mcounts, makeTree(), \nm, cs, acc ->
		setTree(acc, nm, filterSet(cs, \cn -> !isOwn(cn))));
	// SENIORITY, PART 2 — the CANONICAL-ORDER tiebreak. Own-vs-imported settles a contest only
	// while one claimant is the article's own. Downstream every claimant is imported
	// (`∅ <- k1_subset_1, k1_xboole_0`, `∈ <- k10_subset_1, r2_hidden`, `∪. <- k2_setfam_1,
	// k3_tarski`), the name is dropped from BOTH, and the primitive falls back to a mechanical
	// const — which two imports then declare twice ("decl 'k1_xboole_0' is already added").
	// A symbol belongs to the article that introduced it, so rank claimants by MML canonical
	// order (mml.lar) and let the EARLIEST win; HIDDEN is the most primitive of all.
	// a mechanical name is <kind><nr>_<aid> and the AID ITSELF CONTAINS UNDERSCORES
	// (k1_xboole_0 -> xboole_0, k10_subset_1 -> subset_1), so split at the FIRST one.
	rankOfCtor = \cn : string -> {
		us = strIndexOf(cn, "_");
		aid = if (us < 0) "" else toLowerCase(substring(cn, us + 1, strlen(cn) - us - 1));
		mizAidRank(mmlOrder, cn, aid);
	};
	bestOf = \cs : Set<string> -> fold(set2array(cs), Pair("", 1000000), \bp, cn -> {
		r = rankOfCtor(cn);
		if (r < bp.second) Pair(cn, r) else bp;
	});
	// THE GLOBAL OWNER decides the contest, so the answer does not depend on
	// which article is being translated (see mizGlobalOwners). The env-local
	// rules below stay for words the table does not know (an operator spelling
	// read from .msx, an article with no mml.lar rank).
	sig = MizSig(sig0 with readable = filterTree(merged, \k, v -> {
		all = lookupTreeDef(mcounts, v, makeSet());
		ctorOf = \key : string -> switch (lookupTree(sig0.table, key)) {
			Some(c): mizConstrName(strSplit(key, ":")[0], c);
			None(): key;
		};
		cn = ctorOf(k);
		// EVERY word is decided by the table, the A-map foundation's own
		// (∈/∪/singleton/…) included: the table now renders bracket and operator
		// spellings just as the .msx path does, so it knows them. Excluding them
		// left the foundation words on the environment-local rule, and `∈` then
		// stayed HIDDEN's in one article and fell back to `r2_hidden` in another
		// whose environment happened to hold SUBSET_1's `In` functor as a third
		// claimant — the same theorem inlined by two such articles then clashed.
		switch (lookupTree(globalOwners, v)) {
			Some(owner): owner == cn;
			None(): if (sizeSet(all) == 1) true
			else {
				sen = lookupTreeDef(mseniors, v, makeSet());
				// One non-own claimant → it wins. Otherwise: a FOUNDATION symbol (∅/∈/⊆/𝒫/…) must
				// still be resolved — falling back to a mechanical name there both severs the A-map
				// and makes every user declare its own copy ("decl 'k1_xboole_0' is already added"),
				// so the canonically-earliest article takes it. For any OTHER contested name the safe
				// mechanical fallback stands: adopting more pretty names was MEASURED WORSE
				// (28 OK / 1262 thms / 5 parse-fails vs 29 / 1331 / 0) — mangling is always correct,
				// a pretty name is only ever an optimisation.
				if (sizeSet(sen) == 1) containsSet(sen, cn)
				else if (folAmapReused(v)) (bestOf(if (isEmptySet(sen)) all else sen)).first == cn
				else false;
			}
		}
	}));
	// Signature comments: the constructor's FINAL Russell name (readable or MPTP) -> its symbol.
	notationMap = foldTree(sig.table, makeTree(), \key, c, acc -> {
		kind = strSplit(key, ":")[0];
		sp = spellOf(kind, c).first;
		if (sp == "") acc else setTree(acc, lookupTreeDef(sig.readable, key, mizConstrName(kind, c)), sp);
	});
	switch (mizReadArticle(env, src0, article)) {
		None(): None();
		Some(p): switch (mizArticleTheorems(p.first, mizFile(src0, article, "miz"), sig, mizRefTable(mizEth(src0, article)))) {
			None(): { env.out.error("mizar-to-ru: no <Article> root in " + article + ".xml", []); None(); }
			Some(thms0): {
				// THE CHECKER'S RECORD, per by-step position. Computed whenever
				// something consumes it: `facts=1` inserts the instantiated
				// premises as intermediate open steps, `emit=1` proves them from
				// their citation and feeds them to the certificate ladder.
				factsOn = ruTaskStringArg(unit.task, "facts", "0") == "1";
				emitOn = ruTaskStringArg(unit.task, "emit", "0") == "1";
				// the definitions the checker expanded, per by-step position
				posExp : ref Tree<string, [Pair<string, string>]> = ref makeTree();
				// the premise equations the equalizer consumed, per position —
				// the merge-log seed for the certificate's fact selection
				posEqs : ref Tree<string, [FolForm]> = ref makeTree();
				posRec : Tree<string, [MizDerivFact]> =
					if (!factsOn && !emitOn) makeTree()
					else {
						mizFiles = "/usr/local/share/mizar/";
						adir = mizArticleDir(unit);
						mizSetDerivXmlOn(true);
						dr = mizMSMVerifyArticleEx(adir, article, mizFiles,
							mizAccomEnvLoader(adir, article, mizFiles), false, false, false, false);
						mizSetDerivXmlOn(false);
						derivStr = switch (dr.stats) {
							None(): "";
							Some(st): "<Derivation>\n" + concatStrings(vector2array(st.derivXml)) + "</Derivation>\n";
						};
						posScope = switch (mizParseXml(p.first)) {
							None(): makeTree();
							Some(ax): fold(mizCollectAll([ax], "JustifiedTheorem"), makeTree(), \acF, tx -> {
								sc = mizConstScope(tx);
								fold(mizByPositions(tx), acF, \aF, pp -> setTree(aF, pp, sc));
							});
						};
						posExp := mizDerivPosExpansions(derivStr, sig);
						posEqs := mizDerivPosEqs(derivStr, sig, posScope);
						env.out.println("mizar-to-ru: merge-log seeds at "
							+ i2s(sizeTree(^posEqs)) + " positions, "
							+ i2s(fold(getTreeValues(^posEqs), 0, \a9, e9 -> a9 + length(e9)))
							+ " equations");
						mizDerivPosFacts(derivStr, sig, posScope);
					};
				thms = if (!factsOn) thms0
				else {
					// EMISSION POLICY (measured on zfmisc_1): insert only FULLY
					// instantiated facts. A residual fact (the elimination stopped
					// at an unassigned binder) keeps a leading ∀ the general tactic
					// must re-eliminate — measured to sink theorems; it returns
					// when a dedicated closer handles it.
					posFacts = mapTree(posRec, \fs ->
						map(filter(fs, \f -> f.full), \f -> f.fact));
					nIns = ref 0;
					out = map(thms0, \t -> {
						t1 = mizThmInsertFacts(t, posFacts);
						nIns := ^nIns + length(t1.steps) - length(t.steps);
						t1;
					});
					env.out.println("mizar-to-ru: facts=1 inserted " + i2s(^nIns)
						+ " instantiated-fact steps");
					out;
				};
				eth  = mizEth(src0, article);
				// miz_aux (hand-authored companion lemmas — partition bridges, 1-hyp
				// elim forms) is a STANDING dependency: loaded and imported whenever
				// <ru-root>/miz_aux.ru exists (ruMizLoadDeps no-ops when absent). The
				// prover's assertion index is import-precedence filtered, so without
				// the import the aux lemmas are read-visible but never applicable.
				// The .eth cites only the articles whose THEOREMS are used. An article may also
				// USE a constructor (subset_1's `Element of`, xboole_0's ∅) without citing any of
				// that article's theorems — and then re-declares the symbol locally. Import two such
				// articles together and their duplicate `constant element` blocks collide at
				// parse-collect ("decl 'element' is already added": partfun1/funct_2/funct_3/
				// funcop_1/funct_4, and 'k1_xboole_0' for ordinal2/ordinal3/pboole). So the
				// dependency set is the cited aids UNION the DEFINING aids of every constructor in
				// the environment — a symbol is declared by its own article and imported everywhere.
				// ACYCLICITY: only import an aid that PRECEDES this article in the MML canonical
				// order. Importing every constructor-defining aid unfiltered builds a cyclic
				// import graph — the library then translates article-by-article but FAILS TO
				// LOAD ("Cyclic imports detected": subset_1 -> … -> xregular -> …). Canonical
				// order is a DAG by construction, so ranking below the current article is both
				// sufficient and the natural reading of "this notion already existed".
				// An aid absent from mml.lar (miz_aux) ranks last and is added separately below.
				selfRank = mizAidRank(mmlOrder, "", toLowerCase(article));
				ctorAids = filter(uniq(map(getTreeValues(sig0.table), \c -> toLowerCase(c.aid))),
					\a -> a != toLowerCase(article) && a != "hidden" && a != ""
						&& mizAidRank(mmlOrder, "", a) < selfRank);
				depAids0 = uniq(concat(arrayPush(if (eth != "") mizEnvAids(eth) else [], "miz_aux"), ctorAids));
				// AUTO-LOAD already-translated dependency articles (their .ru lives next to the output
				// module) so the cited theorems come from `import`, not re-inlined axioms. No-op for a
				// dependency that isn't translated yet (its env axioms then fall back to foundation dedup).
				// The dep dir = the directory the OUTPUT lands in (ru-root): derive it from the SAME path
				// computation as the write, so it's correct whether `module` is a bare name or a path.
				// (ruDirName(module) alone is "" for a bare module name → deps never found → re-inlined.)
				outPath = ruNewFileInfo(module, state.conf, ".ru").path;
				stateD = ruMizLoadDeps(state, env, depAids0, ruDirName(outPath));
				// A dependency ARTICLE's own operators (tarski's ⋃, enumset1's
				// enumeration functors, …) now come via `import` — the emitter must
				// not re-declare their constant/rule/congruence blocks (a duplicate
				// decl crashes the parse-collect before ruMizDedupImported runs).
				// Extend the static foundation isReused with the loaded LANGUAGE
				// decl names (constants/types/rules + congruences; theorems excluded).
				depLangNames = foldTree(stateD.ru, makeSet(), \__, sr, accN ->
					fold(sr.decls, accN, \acN, d -> switch (d) {
						RuConst(__,__,__): insertSet(acN, id2s(d.info.id));
						RuType(__,__):     insertSet(acN, id2s(d.info.id));
						RuRule(__,__,__):  insertSet(acN, id2s(d.info.id));
						RuCong(__,__):     insertSet(acN, id2s(d.info.id));
						default: acN;
					}));
				emitD = FolEmit(emit with isReused = \n, isPred -> emit.isReused(n, isPred) || containsSet(depLangNames, n));
				// Import the foundation by its ACTUAL loaded source id (read-from-disk module
				// ids may be path-qualified), exactly as mptp-to-ru does.
				found_id = foldTree(stateD.ru, s2id(foundation), \id, s, acc ->
					if (s.info.module == foundation || endsWith(s.info.module, "/" + foundation)) s.info.id else acc);
				// Direct dependencies: each article aid cited in the .eth becomes an `import` of that
				// article's already-loaded .ru (module == aid). The cited theorems/defs then come FROM
				// the imported article (deduped below by name), never re-inlined as axioms here. An aid
				// that isn't loaded (e.g. fully covered by the foundation) simply yields no import — its
				// env axioms fall back to the foundation-canonical dedup.
				// Each dependency article cited in the .eth becomes an `import` of its already-loaded
				// source (resolved by aid == its module). Load the dependency the same way as the
				// foundation — `read-ru <path>` before translating this article — so its self-id is in
				// the same (resolvable-on-read-back) form as the foundation's, and the cited theorems
				// come FROM the import (deduped below by name) rather than re-inlined as axioms here.
				depResolved = filtermap(depAids0, \aid ->
					foldTree(stateD.ru, None(), \id, s, acc ->
						if (s.info.module == aid || endsWith(s.info.module, "/" + aid)) Some(Pair(aid, s.info.id)) else acc));
				depIds  = map(depResolved, \pr -> pr.second);
				importedAids = buildSet(map(depResolved, \pr -> toLowerCase(pr.first)));				importIds = concat([found_id], depIds);
				syms = mizParseNotation(mizFile(src0, article, "eno"), mizFile(src0, article, "frm"), mizFile(src0, article, "dcx"));
				// env theorems as commented axioms (available premises for the open steps).
				// srcOf resolves the DEFINING article's (.miz, .xml) so each carries its surface text.
				srcOf = \aid -> Pair(mizFile(src0, aid, "miz"), mizFile(src0, aid, "xml"));
				envPairs = if (eth != "") mizParseEnv(eth, sig, syms, srcOf, emitD.isReused, \a -> containsSet(importedAids, a)) else [];
				// The SAME env, with nothing dropped for being imported: emission
				// must not re-inline an imported theorem, but the emitter still
				// has to know its STATEMENT to cite it. Without this the record's
				// premises could only be matched against the handful of theorems
				// the article inlines — subset_1 resolved 0 of 77.
				envAll = if (eth != "") mizParseEnv(eth, sig, syms, srcOf, emitD.isReused, \__ -> false) else [];
				// the article's OWN definitions (XBOOLE_0:def N) as definitional axioms — the
				// `unfold` material the prover needs to close the by-gaps; in scope before the theorems.
				defPairs = mizArticleDefs(p.first, mizFile(src0, article, "miz"), sig, syms, emitD.isReused);
				// A form the translator could not render is JUNK — unprovable as a theorem and a
				// potentially FALSE assumption as an env axiom. Drop it rather than emit it: that
				// also stops the `unhandled_term_<Tag>` placeholder constant from being declared,
				// which is what made two IMPORTED articles collide (Mizar's <Choice> term,
				// `the Element of X`, cost 9 articles / ~600 theorems in the first 40).
				// the article's CLUSTER REGISTRATIONS — the type layer's inference content, which
				// was previously not translated at all (see mizArticleClusters).
				clusterPairs = mizArticleClusters(p.first, sig);
				// ...and the article's CONSTRUCTOR RESULT TYPES — the other half of
				// the type layer. A Mizar definition states an equation AND a type,
				// and only the equation was translated (see mizArticleConstrTypes).
				constrTypePairs = mizArticleConstrTypes(p.first, sig);
				// the defs-by-symbol index, consumed ONLY inside the emitter's
				// ∃-elimination (the definition of an assumed atom's head predicate);
				// definitions (d…) and constructor types (ct…), imported ones included
				// ...and the DEPENDENCY ARTICLES' own definition tables. The .eth
				// environment lists only what the article's proofs CITE, and a
				// definition the checker expands silently (proj1 = d12_xtuple_0 on
				// relat_1) is not there — so each imported article's definitions are
				// read from its OWN XML with its OWN signature. Only definitions the
				// loaded sources actually carry are kept (dedup by name).
				// A name is a function of the CONSTRUCTOR (the S-A invariant), so the
				// dependency's forms are rendered with the MAIN article's readable
				// names carried over by constructor identity — the dep's own .eno
				// would give the mechanical name (k9_xtuple_0 where the article
				// writes proj1) and the symbol index would never match.
				mainCtorName = foldTree(sig.table, makeTree(), \k, c, accM -> {
					kind = strSplit(k, ":")[0];
					switch (lookupTree(sig.readable, k)) {
						Some(nm): setTree(accM, kind + ":" + toLowerCase(c.aid) + ":" + i2s(c.nr), nm);
						None(): accM;
					}
				});
				depDefPairs0 = concatA(map(uniq(map(depResolved, \pr -> toLowerCase(pr.first))), \aid -> {
					// the dep's own constructors are declared inline in its XML, not in
					// its .atr — same merge mizFullSig does (else *_unresolved)
					depT0 = mizParseAtr(mizFile(src0, aid, "atr"));
					depTable = switch (mizParseXml(mizFile(src0, aid, "xml"))) {
						None(): depT0.table;
						Some(depRoot): fold(mizCollectAll([depRoot], "Constructor"), depT0.table, mizAddConstr);
					};
					depT = MizSig(depTable, makeTree());
					depReadable = foldTree(depT.table, makeTree(), \k2, c2, acc2 -> {
						kind2 = strSplit(k2, ":")[0];
						switch (lookupTree(mainCtorName,
								kind2 + ":" + toLowerCase(c2.aid) + ":" + i2s(c2.nr))) {
							Some(nm2): setTree(acc2, k2, nm2);
							None(): acc2;
						}
					});
					depSig = MizSig(depT.table, depReadable);
					depSyms = mizParseNotation(mizFile(src0, aid, "eno"),
						mizFile(src0, aid, "frm"), mizFile(src0, aid, "dcx"));
					// the STATIC foundation reuse check, not emitD's: the extended one
					// treats every symbol a loaded import declares as provided — which
					// is exactly what a dependency's own definitions are. Here the form
					// is wanted for the INDEX, nothing is re-declared.
					got = mizArticleDefs(mizFile(src0, aid, "xml"), mizFile(src0, aid, "miz"),
						depSig, depSyms, emit.isReused);
					if (getUrlParameterDef("dbg-depdefs", "") == "1")
						env.out.println("  DEP " + aid + " defs=" + i2s(length(got))
							+ " table=" + i2s(sizeTree(depT.table))
							+ " readable=" + i2s(sizeTree(depReadable)));
					got;
				}));
				knownIds = buildSet(map(concatA([envPairs, defPairs, envAll]), \pr -> id2s(pr.first.id)));
				depDefPairs = filter(depDefPairs0, \pr -> !containsSet(knownIds, id2s(pr.first.id))
					&& !mizFormHasUnhandled(pr.second));
				if (getUrlParameterDef("dbg-depdefs", "") == "1")
				{
					d12e = filter(envAll, \pr -> id2s(pr.first.id) == "d12_xtuple_0");
					env.out.println("  D12 in envAll: " + i2s(length(d12e)) + " form: "
						+ strGlue(concatA(map(d12e, \pr -> mizFormSymbols(pr.second))), ",")
						+ " | in raw: " + i2s(length(filter(depDefPairs0,
							\pr -> id2s(pr.first.id) == "d12_xtuple_0"))));
				}
					env.out.println("mizar-to-ru: dep defs raw=" + i2s(length(depDefPairs0))
						+ " kept=" + i2s(length(depDefPairs)) + " :: "
						+ strGlue(map(depDefPairs, \pr -> id2s(pr.first.id)), ",")
						+ " || d12 syms: " + strGlue(concatA(map(
							filter(depDefPairs, \pr -> id2s(pr.first.id) == "d12_xtuple_0"),
							\pr -> mizFormSymbols(pr.second))), ","));
				defsBySym = fold(filter(concatA([defPairs, constrTypePairs, envAll, depDefPairs]),
						\pr -> { nm = id2s(pr.first.id); startsWith(nm, "d") || startsWith(nm, "ct"); }),
					makeTree(), \acc, pr ->
						fold(mizFormSymbols(pr.second), acc, \ac, sym ->
							setTree(ac, sym, arrayPush(lookupTreeDef(ac, sym, []), id2s(pr.first.id)))));
				mizEmitSetDefsOfSym(\sym -> lookupTreeDef(defsBySym, sym, []));
				allEnvPairs = filter(concatA([envPairs, defPairs, clusterPairs, constrTypePairs]), \pr -> !mizFormHasUnhandled(pr.second));
				envDecls = map(allEnvPairs, \pr -> pr.first);
				envForms = map(allEnvPairs, \pr -> pr.second);
				// ONE theorem per Mizar theorem: multi-step open proof skeleton (or a single
				// open step proving the statement when proofs=0), each carrying its Mizar ref.
				thmsOk = filter(thms, \t -> !mizFormHasUnhandled(t.statement)
					&& !exists(t.hyps, mizFormHasUnhandled) && !exists(t.steps, mizFormHasUnhandled));
				// S-A: the loss must be VISIBLE. A dropped theorem carries a
				// construct the translator cannot render; report how many were
				// dropped and bucket them by the marker that caused it.
				okNames = buildSet(map(thmsOk, \t -> t.name));
				thmsLost = filter(thms, \t -> !containsSet(okNames, t.name));
				emitMaxFacts = s2i(ruTaskStringArg(unit.task, "emit-max-facts", "16"));
				emitMaxSize = s2i(ruTaskStringArg(unit.task, "emit-max-size", "200"));
				emitCnt = ref MizEmitCounts(0, 0, 0);
				// how far each THEOREM is from closing: the by-step counts do not
				// say whether the closures are spread over many theorems or
				// finish any of them, and only a finished theorem is a result
				thmFull = ref 0; thmOneLeft = ref 0;
				// S-B: THE RECORD AS THE EMITTER'S INPUT. The record supplies the
				// INSTANCE the checker needed; which citation it came from is
				// recovered by matching (the <Premise> is the checker's normal
				// form and no longer matches the article's axiom text).
				// Only assertions THIS ARTICLE EMITS may be cited, because the
				// citation step has to state what the assertion actually says: an
				// env axiom/definition/registration is ∀-closed, an own theorem's
				// proposition is whatever its skeleton left (∀-closed for a direct
				// `by`, the open matrix after a `let`). An IMPORTED theorem's
				// emitted shape is decided in ITS article and is not visible here —
				// citing it from the .eth's ∀-closed form produced steps Russell
				// rejected (t70_xboole_1, t28_xboole_1).
				// Only HYPOTHESIS-FREE assertions may be cited: a certificate step
				// names its assertion and supplies a reference per hypothesis, and
				// a theorem carrying the article's let/assume context has some.
				// The article's OWN definitions and cluster REGISTRATIONS belong in
				// the table too: a type fact the checker uses comes from a
				// registration, and subset_1 — the type-layer article — could
				// resolve only 18 of its 77 recorded premises without them.
				// IMPORTED theorems are citable again. Their emitted shape is
				// decided in their own article, but the article is LOADED — so it
				// is read from there: a theorem carrying hypotheses cannot be cited
				// with no references, and one whose proposition is ∀-closed needs
				// the prefix eliminated while an open one is instantiated by
				// Russell. `wal` is the foundation's universal quantifier rule.
				propIsAll = \stat : RuInference -> if (stat.prop.exps == []) false
					else switch (stat.prop.exps[0]) {
						RuExp(nodes, __): if (nodes == []) false else switch (nodes[0]) {
							RuRuleNode(idType, __): id2s(ruIdType2Id(idType)) == "wal";
							RuVar(__, __): false;
						}
						RuTerm(__, __, __): false;
					};
				impShape = foldTree(stateD.ru, makeTree(), \__, src, acc ->
					fold(src.decls, acc, \ac, d -> switch (d) {
						// an imported DEFINITION or environment theorem is emitted as
						// an axiom: hypothesis-free, and ∀-closed when its statement
						// says so. These are what the expansion record names.
						RuAxiom(inf3, stat3): setTree(ac, id2s(inf3.id),
							Pair(stat3.hyps == [], propIsAll(stat3)));
						RuTheorem(inf2, stat, __, __): {
							isAll = if (stat.prop.exps == []) false else switch (stat.prop.exps[0]) {
								RuExp(nodes, __): if (nodes == []) false else switch (nodes[0]) {
									RuRuleNode(idType, __): id2s(ruIdType2Id(idType)) == "wal";
									RuVar(__, __): false;
								}
								RuTerm(__, __, __): false;
							};
							setTree(ac, id2s(inf2.id), Pair(stat.hyps == [], isAll));
						}
						default: ac;
					}));
				stmtTbl = fold(concatA([
						map(filter(allEnvPairs, \pr -> !mizFormHasUnhandled(pr.second)),
							\pr -> Pair(id2s(pr.first.id), pr.second)),
						// an imported theorem: the .eth gives the statement, the
						// loaded article says whether it may be cited at all
						map(filter(envAll, \pr -> !mizFormHasUnhandled(pr.second)
								&& (switch (lookupTree(impShape, id2s(pr.first.id))) {
									Some(sh): sh.first; None(): false;
								})),
							\pr -> Pair(id2s(pr.first.id), pr.second)),
						// an article theorem is emitted with its PROP — the open
						// matrix, implicitly closed over the theorem's variables —
						// not with the ∀-closed statement
						map(filter(thmsOk, \t -> t.hyps == [] && t.steps != []),
							\t -> Pair(t.name, t.steps[length(t.steps) - 1])),
						// a dependency's definition, read from its own XML: citable
						// when the LOADED source carries it as an axiom
						map(filter(depDefPairs, \pr ->
								switch (lookupTree(impShape, id2s(pr.first.id))) {
									Some(sh): sh.first; None(): false;
								}),
							\pr -> Pair(id2s(pr.first.id), pr.second))]),
					makeTree(), \acc, pr ->
						if (containsKeyTree(acc, pr.first)) acc else setTree(acc, pr.first, pr.second));
				// a theorem emitted WITH hypotheses (the honest hypothetical
				// form): kept OUT of stmtTbl — its name may not be cited bare —
				// and offered to the hyp-cite channel, which proves each
				// substituted hypothesis and cites with those references
				// free variables are normalized to their RENDERED (lowercase)
				// names: the theorem's hyps carry AST-case binders ("X26") while
				// its prop's are rendered ("x26"), and the hyp-cite matching
				// compares names exactly (the standing case trap)
				lcFree = \f : FolForm -> mizRenameFree(f, fold(mizFormFreeVars(f),
					makeTree(), \ac, v -> setTree(ac, v, toLowerCase(v))));
				hypThmTbl = fold(filter(thmsOk, \t -> t.hyps != [] && t.steps != []),
					makeTree(), \acc, t ->
						setTree(acc, t.name, Pair(lcFree(t.steps[length(t.steps) - 1]),
							map(t.hyps, lcFree))));
				// PRECEDENCE. An article theorem may only be cited by a LATER one:
				// the skeleton index happily offered t50_zfmisc_1 to t11 and the
				// Metamath checker rejected the forward reference. Environment and
				// imported statements always precede the article.
				thmOrd = foldi(thmsOk, makeTree(), \i, acc, t -> setTree(acc, t.name, i));
				// Which names are emitted as AXIOMS here (∀-closed): this article's
				// env theorems, definitions and registrations. Everything else a
				// step may cite is a THEOREM — this article's own or an imported
				// one — whose proposition is the open matrix.
				// The dispatch is on the SHAPE of what is emitted, not on the kind
				// of assertion: a ∀-closed proposition needs its prefix eliminated,
				// an open one is instantiated by Russell when the step names it.
				isAxiomName = \nm : string -> switch (lookupTree(impShape, nm)) {
					Some(sh): sh.second;   // the loaded article says what it emitted
					None(): switch (lookupTree(stmtTbl, nm)) {
						None(): false;
						Some(st): switch (st) {
							FolQuant(q, vs, __): q == "forall" && vs != [];
							default: false;
						}
					}
				};
				stmtOfAt = \i : int, nm : string ->
					if (lookupTreeDef(thmOrd, nm, -1) >= i) None() else lookupTree(stmtTbl, nm);
				hypStmtOfAt = \i : int, nm : string ->
					if (lookupTreeDef(thmOrd, nm, -1) >= i) None() else lookupTree(hypThmTbl, nm);
				// statements indexed by skeleton, so a recorded fact can find the
				// premise it instantiates even when the step cites nothing
				skelTbl = foldTree(stmtTbl, makeTree(), \nm, st, acc ->
					fold(mizEmitPieceSkeletons(st), acc, \a2, k ->
						setTree(a2, k, arrayPush(lookupTreeDef(a2, k, []), nm))));
				bySkeletonAt = \i : int, k : string -> {
					c = filter(lookupTreeDef(skelTbl, k, []), \nm -> lookupTreeDef(thmOrd, nm, -1) < i);
					// a skeleton shared by very many statements is weak evidence for
					// the record matcher — but the GUARD channel needs exactly the
					// crowded skeletons (`X is Relation` names half the env), and
					// matching decides anyway. Axioms first, then a wide cap: the
					// guard/def instances live in ct*/registration axioms, and
					// first-match takes the earliest candidate.
					if (length(c) <= 32) c
					else {
						ax = filter(c, \nm -> isAxiomName(nm));
						if (length(ax) > 96) [] else ax;
					}
				};
				nRecSeen = ref 0; nRecFull = ref 0;
				// a single-step fallback theorem carries its WHOLE proof's
				// positions comma-joined — split and union every record lookup
				posSplit = \pos : string -> filter(strSplit(pos, ","), \p9 -> p9 != "");
				recOf = \pos : string -> concatA(map(posSplit(pos), \p9 ->
					filtermap(lookupTreeDef(posRec, p9, []), \df -> {
						nRecSeen := ^nRecSeen + 1;
						if (!df.full) None() else { nRecFull := ^nRecFull + 1; Some(df.fact); }
					})));
				// the article's own sethood axiom for a functor (the foundation's
				// reused functors have their own lemmas — see mizEmitFoundSethood)
				shOf = \fn : string -> "sh_" + folRuleId(fn);
				mizEmitRecReset();
				articleDecls : [RuParseDecl] = mapi(thmsOk, \ti, t ->
					if (proofsOn && emitOn) {
						tThm0 = timestamp();
						pr = mizEmitThmProofs(t, emitMaxFacts, emitMaxSize, recOf,
							\nm -> stmtOfAt(ti, nm), \nm -> hypStmtOfAt(ti, nm),
							\k -> bySkeletonAt(ti, k),
							\pos -> concatA(map(posSplit(pos), \p9 -> lookupTreeDef(^posExp, p9, []))),
							\pos -> concatA(map(posSplit(pos), \p9 -> lookupTreeDef(^posEqs, p9, []))), isAxiomName, shOf);
						if (getUrlParameterDef("dbg-times", "") == "1") {
							dtT = timestamp() - tThm0;
							if (dtT > 500.0)
								println("THM-TIME " + t.name + " " + d2s(dtT / 1000.0) + "s");
						}
						nOpen = length(filter(pr.first, \mp -> !isSome(mp)));
						if (nOpen == 0) thmFull := ^thmFull + 1
						else if (nOpen == 1) {
							thmOneLeft := ^thmOneLeft + 1;
							iteri(pr.first, \k, mp -> if (!isSome(mp) && k < length(t.steps))
								println("ONELEFT " + mizEmitSkeleton(t.steps[k])
									+ (if (k == length(t.steps) - 1) " QED" else " mid")
									+ " :: " + t.name + " :: " + strGlue(folFormToks(t.steps[k]), " ")
									+ " || hyps=" + strGlue(map(t.hyps, \h -> strGlue(folFormToks(h), " ")), " ; ")));
						};
						c0 = ^emitCnt; c1 = pr.second;
						emitCnt := MizEmitCounts(c0.attempted + c1.attempted,
							c0.closed + c1.closed, c0.skipped + c1.skipped);
						decl9 = folProofTheoremE(t.name, t.ref, t.hyps, t.steps, t.stepRefs, classLoci, pr.first);
						// register the built theorem's declared disjointedness so a
						// LATER theorem citing it can map the requirement through
						// its substitution (or decline)
						switch (decl9) {
							RuParseTheorem(__, __, __, dj9, __, __, __, __, __): if (dj9 != [])
								mizEmitSetThmDisjs(t.name, map(dj9, \d9 -> map(d9.vars, id2s)));
							default: {};
						};
						decl9;
					}
					else if (proofsOn) folProofTheoremC(t.name, t.ref, t.hyps, t.steps, t.stepRefs, classLoci)
					else folProofTheoremC(t.name, t.ref, [], [t.statement],
						// single-statement mode: the whole by-list (union over steps) guides the one gap
						[uniq(concatA(t.stepRefs))], classLoci));
				if (emitOn) {
					env.out.println("mizar-to-ru: record at emitted steps: " + i2s(^nRecSeen)
						+ " facts, " + i2s(^nRecFull) + " full, "
						+ i2s((mizEmitRecDiag()).first) + " citation statements, "
						+ i2s((mizEmitRecDiag()).second) + " matched, "
						+ i2s(mizEmitRecUsed()) + " proved from a citation");
					env.out.println("mizar-to-ru: theorems fully closed " + i2s(^thmFull)
						+ " / " + i2s(length(thmsOk)) + ", one step short " + i2s(^thmOneLeft));
					fk = mizEmitFailKinds();
					env.out.println("mizar-to-ru: certificate failures: "
						+ i2s(fk.first) + " unprovable from the facts offered, "
						+ i2s(fk.second) + " tree over cap, " + i2s(fk.third) + " proof over cap");
					dd = mizEmitDefDiag();
					env.out.println("mizar-to-ru: expanded definitions at emitted steps: "
						+ i2s(dd.first) + " named, " + i2s(dd.second) + " instantiated, "
						+ i2s(dd.third) + " with their type guard discharged, "
							+ i2s(mizEmitCleanCount()) + " re-stated as an equivalence");
					hd = mizEmitHypCiteDiag();
					env.out.println("mizar-to-ru: hypothetical citations: "
						+ i2s(hd.first) + " ladder stages with a candidate, "
						+ i2s(hd.second) + " instances built"
						+ (if (mizEmitHypWhy() == "") "" else " (" + mizEmitHypWhy() + ")"));
					env.out.println("mizar-to-ru: failed steps that WERE provable, only too long: "
						+ i2s(mizEmitLongStepCount()));
					ec = ^emitCnt;
					env.out.println("mizar-to-ru: emit closed " + i2s(ec.closed) + " / "
						+ i2s(ec.attempted) + " attempted steps, " + i2s(ec.skipped)
						+ " skipped over budget");
				}
				// every emitted form contributes to the symbol signature.
				sigForms = concat(envForms, concatA(map(thmsOk, \t -> arrayPush(concat(t.hyps, t.steps), t.statement))));
				src = folArticleSource(FolSource([], ruNoFileInfo), sigForms, concat(envDecls, articleDecls), importIds, module, state.conf,
					\name -> lookupTreeDef(notationMap, name, ""), emitD);
				err = ref 0;
				env1 = ruAddErrCounter2Env(env, err);
				articleSrc = ruParseSource2RuSource(src, env1);
				if (^err != 0) {
					env.out.error("mizar-to-ru: failed to parse '" + module + "' against '" + foundation + "' (load the foundation first via read-ru)", []);
					None();
				} else {
					// First drop anything already provided by an IMPORTED article (env theorems/defs,
					// shared operator rules/consts/congruences) — those now come via `import`. Then drop
					// any remaining env axiom that matches the foundation canonically (covers a dependency
					// aid with no translated .ru of its own).
					dedupImp = ruMizDedupImported(articleSrc, ruMizLoadedDeclIds(stateD));
						dedup = ruMizDedupEnvAxioms(dedupImp.first, ruMizFoundationCanon(stateD));
						articleSrc1 = dedup.first;
						nproofs = length(filter(thms, \t -> length(t.steps) > 1));
						ndropped = dedupImp.second + dedup.second;
					env.out.println("mizar-to-ru: '" + module + "' = " + i2s(length(thms)) + " theorems (" +
						i2s(nproofs) + " with multi-step proofs)" +
						(if (depIds == []) "" else " importing " + i2s(length(depIds)) + " dependency article(s)") +
							(if (ndropped == 0) "" else " (" + i2s(ndropped) + " decls dropped — provided by imports/foundation)") +
							" importing '" + foundation + "'");
					if (thmsLost != [])
						env.out.println("mizar-to-ru: NOT translated: " + i2s(length(thmsLost))
							+ " of " + i2s(length(thms)) + " theorems — " + mizLossBuckets(thmsLost));
					Some(RuState(stateD with ru = setTree(stateD.ru, articleSrc1.info.id, articleSrc1)));
				}
			}
		}
	}
}

// ---- Foundation dedup: drop env axioms whose statement already appears in the foundation ----

// Canonical form of an assertion statement for cross-foundation matching: strip the leading
// ∀-closure, alpha-rename vars by first occurrence, and merge the individual sorts (setvar/set/
// class → "i") so a setvar-closed Mizar axiom matches a class-var foundation theorem. Two
// assertions share a canonical form iff they are the same formula up to variable names and the
// setvar↔class direction. Empty for non-statements. Matching here is used only to DROP redundant
// env axioms, so it is incompleteness-safe (a wrong match can never make a false proof verify).
ruMizCanonForm(stmt : RuStmt) -> string {
	if (stmt.exps == []) "" else ruMizCanonNodes(ruMizStripUniv(ruExp(stmt.exps[0])).nodes);
}

// Drop a leading chain of ∀ (wal) binders: the env axioms are universally closed, the foundation
// forms have free metavars (ax-ext is free in x,y; sstr in classes A,B,C).
ruMizStripUniv(e : RuExp) -> RuExp {
	if (e.nodes == []) e
	else switch (e.nodes[0]) {
		RuVar(__, __): e;
		RuRuleNode(idType, arityLen):
			if (id2s(ruIdType2Id(idType)) == "wal" && ruArityLen2Arity(arityLen) == 2) {
				s1 = ruMizSubtreeSize(e.nodes, 1); // size of the bound-var subtree
				ruMizStripUniv(RuExp(subrange(e.nodes, 1 + s1, length(e.nodes) - 1 - s1), -1));
			} else e;
	}
}

// Node count of the prefix-encoded subtree rooted at index i.
ruMizSubtreeSize(nodes : [RuExpNode], i : int) -> int {
	if (i >= length(nodes)) 0
	else switch (nodes[i]) {
		RuVar(__, __): 1;
		RuRuleNode(__, arityLen): fold(enumFromTo(0, ruArityLen2Arity(arityLen) - 1), 1, \pos, __ -> pos + ruMizSubtreeSize(nodes, i + pos));
	}
}

ruMizCanonNodes(nodes : [RuExpNode]) -> string {
	vm = ref makeTree(); cnt = ref 0;
	concatStrings(map(nodes, \n -> switch (n) {
		RuRuleNode(idType, arityLen): id2s(ruIdType2Id(idType)) + "/" + i2s(ruArityLen2Arity(arityLen)) + " ";
		RuVar(id, type): {
			idx = switch (lookupTree(^vm, id)) {
				Some(i): i;
				None(): { c = ^cnt; vm := setTree(^vm, id, c); cnt := c + 1; c; };
			};
			"v" + i2s(idx) + ":" + ruMizCanonSort(type) + " ";
		}
	}));
}

ruMizCanonSort(t : int) -> string {
	n = id2s(t);
	if (n == "setvar" || n == "set" || n == "class") "i" else n;
}

// Canonical forms of every foundation AXIOM/THEOREM currently loaded (the article isn't in state yet).
ruMizFoundationCanon(state : RuState) -> Set<string> {
	foldTree(state.ru, makeSet(), \__, s, acc ->
		fold(s.decls, acc, \ac, d -> switch (d) {
			RuAxiom(__, infer):       insertSet(ac, ruMizCanonForm(infer.prop));
			RuTheorem(__, infer, __, __): insertSet(ac, ruMizCanonForm(infer.prop));
			default: ac;
		}));
}

// Drop every env AXIOM in the article whose statement matches a foundation assertion. The article's
// own theorems (RuTheorem) and article-local definitions (axioms over operators absent from the
// foundation) are untouched. Returns the filtered source and the number dropped.
ruMizDedupEnvAxioms(src : RuSource, foundation : Set<string>) -> Pair<RuSource, int> {
	kept = filter(src.decls, \d -> switch (d) {
		RuAxiom(__, infer): !containsSet(foundation, ruMizCanonForm(infer.prop));
		default: true;
	});
	Pair(RuSource(src with decls = kept), length(src.decls) - length(kept));
}

// The ids of every declaration in the already-loaded sources (foundation + the dependency
// articles read in before this one). Used to drop anything we'd otherwise re-emit that an
// import already provides.
ruMizLoadedDeclIds(state : RuState) -> Set<int> {
	foldTree(state.ru, makeSet(), \__, s, acc ->
		fold(s.decls, acc, \ac, d -> insertSet(ac, d.info.id)));
}

// Load the already-translated dependency articles (`<dir>/<aid>.ru`) into the state, so the article
// being translated can `import` them. A dependency already loaded, or not yet translated (no .ru on
// disk), is skipped. Mirrors how `read-ru` loads a file (ruLoadAllInfo + ruCollectMathFast).
ruMizLoadDeps(state : RuState, env : RuEnv, depAids : [string], dir : string) -> RuState {
	fold(depAids, state, \st, aid -> {
		already = exists(getTreeValues(st.ru), \s -> s.info.module == aid || endsWith(s.info.module, "/" + aid));
		path = dir + "/" + aid + ".ru";
		if (already || !fileExists(path)) st
		else {
			module = ruTrimPath(path, st.conf, ".ru");
			loaded = ruLoadAllInfo(env, s2id(module), \id -> ruCacheGet(id, true, env), nop2, nop2);
			switch (maybeBind(loaded, \srcs -> ruCollectMathFast(srcs, env))) {
				Some(math): RuState(st with ru = mergeTree(st.ru, math.sources));
				None():     st;
			}
		}
	});
}

// Drop every NON-theorem decl (env axiom, operator rule/const, congruence, definition) whose name
// is already declared in an imported source — it now comes via `import`, so re-declaring it would be
// a duplicate. The article's OWN theorems (RuTheorem) are always kept (they are this article's work
// and are never present in an import). Returns the filtered source and the number dropped.
ruMizDedupImported(src : RuSource, importedIds : Set<int>) -> Pair<RuSource, int> {
	kept = filter(src.decls, \d -> switch (d) {
		RuTheorem(__, __, __, __): true;
		default:                   !containsSet(importedIds, d.info.id);
	});
	Pair(RuSource(src with decls = kept), length(src.decls) - length(kept));
}

// S-A loss report: "Fraenkel 12, Choice 8" — the unhandled markers of the
// theorems the translator had to drop, most frequent first. One theorem counts
// once per distinct marker it mentions.
mizLossBuckets(lost : [MizThm]) -> string {
	counts = fold(lost, makeTree(), \acc, t -> {
		names = uniq(concatA(map(concat(t.hyps, arrayPush(t.steps, t.statement)),
			mizFormUnhandledNames)));
		fold(if (names == []) ["(other)"] else names, acc, \a, n ->
			setTree(a, n, lookupTreeDef(a, n, 0) + 1));
	});
	items = sortCustom(tree2pairs(counts), \p -> -p.second, true);
	strGlue(map(items, \p -> p.first + " " + i2s(p.second)), ", ");
}
