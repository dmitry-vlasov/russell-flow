import comm;
import base/env;
import base/fileinfo;
import mizar/miz2ru;
import mizar/atr;
import mizar/notation;
import fol/src;
import fol/fol2ru;
import ru/parse/exps/sources;
import ru/parse/load;
import ru/cache/cache;
import ru/util/src2s;
import ru/util/exp;
import base/util/fs;

// Commands for the Mizar analyzed-XML front-end. The proof corpus lives in the MML
// dir as per-article `.xml` (+ `.atr` for constructor resolution). Milestone 1:
//   `mizar-stmts`  — translate an article's theorem statements and print them (debug),
//   `mizar-to-ru`  — translate statements into a Russell article importing the foundation.
// Mirrors the MPTP front-end (`mptp-to-ru`): only the source changes (XML vs TPTP); the
// back-end (folArticleSource -> RuParseSource -> RuSource) is shared.

export {
	ruMizarCommands : [RuComm];
}

ruMizarCommands = [
	ruCommMizarStmts,
	ruCommMizarProofs,
	ruCommMizarToRu,
];

// MML analyzed-xml dir: explicit `dir=`, else the first import-root + /MML/mml.
mizArticleDir(unit : RuUnit) -> string {
	d = ruTaskStringArg(unit.task, "dir", "");
	roots = unit.state.conf.importRoots;
	if (d != "") d
	else if (roots == []) ""
	else roots[0] + "/MML/mml";
}

mizFile(unit : RuUnit, article : string, ext : string) -> string {
	path = mizArticleDir(unit) + "/" + article + "." + ext;
	if (fileExists(path)) getFileContent(path) else "";
}

mizEth(unit : RuUnit, article : string) -> string { mizFile(unit, article, "eth"); }

// The MML canonical article order (mml.lar, one aid per line) as aid -> index. This is the
// ownership order for a contested symbol: the article that introduced a notion owns its name,
// every later article that re-spells it falls back to a mechanical name. Read once per run;
// empty (all ranks unknown) if mml.lar is absent, which just restores the old drop-both rule.
mizMmlOrder(unit : RuUnit) -> Tree<string, int> {
	path = ruDirName(mizArticleDir(unit)) + "/mml.lar";
	if (!fileExists(path)) makeTree()
	else foldi(filter(map(strSplit(getFileContent(path), "\n"), trim), \l -> l != ""),
		makeTree(), \i, acc, aid -> if (containsKeyTree(acc, toLowerCase(aid))) acc else setTree(acc, toLowerCase(aid), i));
}

// Rank a constructor by its defining article. HIDDEN's primitives (∈, =) precede every article;
// an aid absent from mml.lar (miz_aux, a stray) ranks last so it never steals a symbol.
mizAidRank(order : Tree<string, int>, ctorName : string, aid : string) -> int {
	if (aid == "hidden" || endsWith(ctorName, "_hidden")) -1
	else lookupTreeDef(order, aid, 1000000);
}

// The full signature (constructor resolution + readable notation names) from .atr/.eno/.frm/.dcx.
mizReadSig(unit : RuUnit, article : string) -> MizSig {
	mizFullSig(mizFile(unit, article, "xml"), mizFile(unit, article, "atr"), mizFile(unit, article, "eno"),
		mizFile(unit, article, "frm"), mizFile(unit, article, "dcx"));
}

mizReadArticle(env : RuEnv, dir : string, article : string) -> Maybe<Pair<string, string>> {
	if (dir == "" || article == "") {
		env.out.error("mizar: 'article' is required (and a resolvable MML dir — pass dir= or set RUSSELL_MATH)", []);
		None();
	} else {
		xmlPath = dir + "/" + article + ".xml";
		atrPath = dir + "/" + article + ".atr";
		if (!fileExists(xmlPath)) { env.out.error("mizar: not found: " + xmlPath, []); None(); }
		else if (!fileExists(atrPath)) { env.out.error("mizar: not found: " + atrPath + " (verify the article first)", []); None(); }
		else Some(Pair(getFileContent(xmlPath), getFileContent(atrPath)));
	}
}

ruCommMizarStmts = RuComm(
	RuCommInfo(
		"mizar-stmts", "io", "translate a Mizar article's theorem statements to relativized FOL and print them", "article", false, false,
		[
			RuCommArg("article", false, "article name (e.g. tarski)", ""),
			RuCommArg("dir", true, "MML analyzed-xml dir (default $RUSSELL_MATH/MML/mml)", "")
		], []
	),
	ruRunMizarStmts
);

ruRunMizarStmts(unit : RuUnit) -> Maybe<RuState> {
	env = ruUnitEnv(unit);
	article = ruTaskStringArg(unit.task, "article", "");
	switch (mizReadArticle(env, mizArticleDir(unit), article)) {
		None(): None();
		Some(p): switch (mizArticleTheorems(p.first, mizFile(unit, article, "miz"), mizReadSig(unit, article))) {
			None(): { env.out.error("mizar-stmts: no <Article> root in " + article + ".xml", []); None(); }
			Some(thms): {
				env.out.println("mizar-stmts: " + article + " -> " + i2s(length(thms)) + " theorems");
				iter(thms, \t -> env.out.println("  " + t.name + " : " + tptpForm2s(t.statement)));
				Some(unit.state);
			}
		}
	}
}

ruCommMizarProofs = RuComm(
	RuCommInfo(
		"mizar-proofs", "io", "translate a Mizar article's proof skeletons (multi-step, open) and print them", "article", false, false,
		[
			RuCommArg("article", false, "article name (e.g. xboole_1)", ""),
			RuCommArg("dir", true, "MML analyzed-xml dir (default first import-root + /MML/mml)", ""),
			RuCommArg("show", true, "how many multi-step proofs to print", "6")
		], []
	),
	ruRunMizarProofs
);

ruRunMizarProofs(unit : RuUnit) -> Maybe<RuState> {
	env = ruUnitEnv(unit);
	article = ruTaskStringArg(unit.task, "article", "");
	show = s2i(ruTaskStringArg(unit.task, "show", "6"));
	switch (mizReadArticle(env, mizArticleDir(unit), article)) {
		None(): None();
		Some(p): switch (mizArticleTheorems(p.first, mizFile(unit, article, "miz"), mizReadSig(unit, article))) {
			None(): { env.out.error("mizar-proofs: no <Article> root in " + article + ".xml", []); None(); }
			Some(thms): {
				withProof = filter(thms, \t -> length(t.steps) > 1);
				unh = uniq(concatA(map(thms, \t -> t.unhandled)));
				env.out.println("mizar-proofs: " + article + " -> " + i2s(length(thms)) + " theorems, " +
					i2s(length(withProof)) + " with multi-step proofs" +
					(if (unh == []) "" else "; UNHANDLED skeleton items: " + strGlue(unh, " ")));
				iter(subrange(withProof, 0, min(show, length(withProof))), \t -> {
					env.out.println("  " + t.name + " (" + i2s(length(t.steps)) + " steps" +
						(if (t.unhandled == []) "" else ", skipped: " + strGlue(uniq(t.unhandled), " ")) + "):");
					if (t.hyps != []) env.out.println("     hyps: " + strGlue(map(t.hyps, tptpForm2s), ", ")) else {};
					iteri(t.steps, \i, s -> env.out.println("     step " + i2s(i + 1) + " : ? |- " + tptpForm2s(s)));
				});
				Some(unit.state);
			}
		}
	}
}

ruCommMizarToRu = RuComm(
	RuCommInfo(
		"mizar-to-ru", "translate", "translate a Mizar analyzed article (xml+atr) into a Russell article importing the foundation (load it first via read-ru)", "article", false, false,
		[
			RuCommArg("article", false, "article name (e.g. tarski)", ""),
			RuCommArg("dir", true, "MML analyzed-xml dir (default $RUSSELL_MATH/MML/mml)", ""),
			RuCommArg("module", true, "module name for the generated article (default = article)", ""),
			RuCommArg("foundation", true, "foundation module to import (miz_set = A-map class layer; miz_logic = flat set)", "miz_set"),
			RuCommArg("proofs", true, "1 = multi-step open proof skeletons (default), 0 = statements only", "1")
		], []
	),
	ruRunMizarToRu
);

ruRunMizarToRu(unit : RuUnit) -> Maybe<RuState> {
	env = ruUnitEnv(unit);
	state = unit.state;
	article = ruTaskStringArg(unit.task, "article", "");
	module0 = ruTaskStringArg(unit.task, "module", "");
	module = if (module0 != "") module0 else article;
	foundation = ruTaskStringArg(unit.task, "foundation", "miz_set");
	// A-map (miz_set) keeps set.mm's native class layer and maps Mizar's set operations onto it;
	// the legacy flat foundation (miz_logic) emits a `set`-typed article rule for every operator.
	emit = if (foundation == "miz_logic") folFlatEmit() else folAmapEmit();
	proofsOn = ruTaskStringArg(unit.task, "proofs", "1") != "0";
	sig0 = mizReadSig(unit, article);
	// Surface spellings (\+\, c=, ∪/∩/\, …) per defining article (read .xml+.msx once each).
	aids = uniq(map(getTreeValues(sig0.table), \c -> toLowerCase(c.aid)));
	spellCache = pairs2tree(map(aids, \a -> Pair(a, mizSpellingMap(mizFile(unit, a, "xml"), mizFile(unit, a, "msx")))));
	spellOf = \kind, c : MizConstr -> lookupTreeDef(lookupTreeDef(spellCache, toLowerCase(c.aid), makeTree()), kind + ":" + i2s(c.nr), Pair("", 0));
	// Build the readable-name map from the .msx surface symbols (the reliable source): operators
	// get the math symbol (∪/⊆/△/…), bracket functors an arity-disambiguated name
	// (singleton/pair/opair), clean words themselves (union/misses/…). Fall back to the .eno-based
	// sig0.readable only for symbols with no .msx (HIDDEN: in/object/set). Then dedup so no two
	// constructors share a Russell name.
	// Names already taken by foundation assertions (theorems/axioms/defs/congruences). A Mizar
	// clean word that clashes (e.g. `empty` vs set.mm's `theorem empty`) would collide on read,
	// so it gets a trailing `_` — the same disambiguation already used for set_/object.
	reserved = foldTree(state.ru, makeSet(), \__, s, acc ->
		fold(s.decls, acc, \ac, d -> if (ruDeclIsAssertion(d)) insertSet(ac, id2s(d.info.id)) else ac));
	merged = foldTree(sig0.table, makeTree(), \key, c, acc -> {
		sa = spellOf(strSplit(key, ":")[0], c);
		fromMsx = if (sa.first == "") "" else mizSymbolName(sa.first, sa.second);
		nm0 = if (fromMsx != "") fromMsx else lookupTreeDef(sig0.readable, key, "");
		// final: map a clean-word name that has a math symbol (in -> ∈, union -> ⋃) — covers the
		// HIDDEN fallback (`in`) which has no .msx. Symbols/other words pass through unchanged.
		nm = {
			m = mizOpName(nm0); base = if (m != "") m else nm0;
			if (base != "" && containsSet(reserved, base)) base + "_" else base;
		};
		if (nm == "") acc else setTree(acc, key, nm);
	});
	// Dedup by DISTINCT constructor, not by table key — a redefinition alias (TARSKI's
	// `in` -> HIDDEN ∈) puts the same constructor under two keys and must keep its name.
	mcounts = foldTree(merged, makeTree(), \k, v, acc -> {
		cn = switch (lookupTree(sig0.table, k)) {
			Some(c): mizConstrName(strSplit(k, ":")[0], c);
			None(): k;
		};
		setTree(acc, v, insertSet(lookupTreeDef(acc, v, makeSet()), cn));
	});
	// SENIORITY on collision. A new article routinely re-spells a primitive symbol for its
	// own notion — subset_1 spells BOTH `{}` (k1_subset_1, the empty Subset) and `in`
	// (k10_subset_1) exactly as XBOOLE_0's ∅ and HIDDEN's ∈. Dropping the name from ALL
	// claimants (the old rule) then severed the FOUNDATION's own ∈/∅: every imported lemma
	// stopped applying and subset_1 proved 11/53 on both paths. So when a name is contested,
	// the IMPORTED constructor keeps it and the article's OWN newcomer falls back to its
	// mechanical MPTP name (still unique, just unsugared). Contest purely among imports
	// (zfmisc's 5 `are_mutually_distinct` relations) stays ambiguous and is still dropped.
	isOwn = \cn : string -> endsWith(cn, "_" + toLowerCase(article));
	mseniors = foldTree(mcounts, makeTree(), \nm, cs, acc ->
		setTree(acc, nm, filterSet(cs, \cn -> !isOwn(cn))));
	// SENIORITY, PART 2 — the CANONICAL-ORDER tiebreak. Own-vs-imported settles a contest only
	// while one claimant is the article's own. Downstream every claimant is imported
	// (`∅ <- k1_subset_1, k1_xboole_0`, `∈ <- k10_subset_1, r2_hidden`, `∪. <- k2_setfam_1,
	// k3_tarski`), the name is dropped from BOTH, and the primitive falls back to a mechanical
	// const — which two imports then declare twice ("decl 'k1_xboole_0' is already added").
	// A symbol belongs to the article that introduced it, so rank claimants by MML canonical
	// order (mml.lar) and let the EARLIEST win; HIDDEN is the most primitive of all.
	mmlOrder = mizMmlOrder(unit);
	// a mechanical name is <kind><nr>_<aid> and the AID ITSELF CONTAINS UNDERSCORES
	// (k1_xboole_0 -> xboole_0, k10_subset_1 -> subset_1), so split at the FIRST one.
	rankOfCtor = \cn : string -> {
		us = strIndexOf(cn, "_");
		aid = if (us < 0) "" else toLowerCase(substring(cn, us + 1, strlen(cn) - us - 1));
		mizAidRank(mmlOrder, cn, aid);
	};
	bestOf = \cs : Set<string> -> fold(set2array(cs), Pair("", 1000000), \bp, cn -> {
		r = rankOfCtor(cn);
		if (r < bp.second) Pair(cn, r) else bp;
	});
	sig = MizSig(sig0 with readable = filterTree(merged, \k, v -> {
		all = lookupTreeDef(mcounts, v, makeSet());
		if (sizeSet(all) == 1) true
		else {
			sen = lookupTreeDef(mseniors, v, makeSet());
			cn = switch (lookupTree(sig0.table, k)) {
				Some(c): mizConstrName(strSplit(k, ":")[0], c);
				None(): k;
			};
			// One non-own claimant → it wins. Otherwise: a FOUNDATION symbol (∅/∈/⊆/𝒫/…) must
			// still be resolved — falling back to a mechanical name there both severs the A-map
			// and makes every user declare its own copy ("decl 'k1_xboole_0' is already added"),
			// so the canonically-earliest article takes it. For any OTHER contested name the safe
			// mechanical fallback stands: adopting more pretty names was MEASURED WORSE
			// (28 OK / 1262 thms / 5 parse-fails vs 29 / 1331 / 0) — mangling is always correct,
			// a pretty name is only ever an optimisation.
			if (sizeSet(sen) == 1) containsSet(sen, cn)
			else if (folAmapReused(v)) (bestOf(if (isEmptySet(sen)) all else sen)).first == cn
			else false;
		}
	}));
	// Signature comments: the constructor's FINAL Russell name (readable or MPTP) -> its symbol.
	notationMap = foldTree(sig.table, makeTree(), \key, c, acc -> {
		kind = strSplit(key, ":")[0];
		sp = spellOf(kind, c).first;
		if (sp == "") acc else setTree(acc, lookupTreeDef(sig.readable, key, mizConstrName(kind, c)), sp);
	});
	switch (mizReadArticle(env, mizArticleDir(unit), article)) {
		None(): None();
		Some(p): switch (mizArticleTheorems(p.first, mizFile(unit, article, "miz"), sig)) {
			None(): { env.out.error("mizar-to-ru: no <Article> root in " + article + ".xml", []); None(); }
			Some(thms): {
				eth  = mizEth(unit, article);
				// miz_aux (hand-authored companion lemmas — partition bridges, 1-hyp
				// elim forms) is a STANDING dependency: loaded and imported whenever
				// <ru-root>/miz_aux.ru exists (ruMizLoadDeps no-ops when absent). The
				// prover's assertion index is import-precedence filtered, so without
				// the import the aux lemmas are read-visible but never applicable.
				// The .eth cites only the articles whose THEOREMS are used. An article may also
				// USE a constructor (subset_1's `Element of`, xboole_0's ∅) without citing any of
				// that article's theorems — and then re-declares the symbol locally. Import two such
				// articles together and their duplicate `constant element` blocks collide at
				// parse-collect ("decl 'element' is already added": partfun1/funct_2/funct_3/
				// funcop_1/funct_4, and 'k1_xboole_0' for ordinal2/ordinal3/pboole). So the
				// dependency set is the cited aids UNION the DEFINING aids of every constructor in
				// the environment — a symbol is declared by its own article and imported everywhere.
				// ACYCLICITY: only import an aid that PRECEDES this article in the MML canonical
				// order. Importing every constructor-defining aid unfiltered builds a cyclic
				// import graph — the library then translates article-by-article but FAILS TO
				// LOAD ("Cyclic imports detected": subset_1 -> … -> xregular -> …). Canonical
				// order is a DAG by construction, so ranking below the current article is both
				// sufficient and the natural reading of "this notion already existed".
				// An aid absent from mml.lar (miz_aux) ranks last and is added separately below.
				selfRank = mizAidRank(mmlOrder, "", toLowerCase(article));
				ctorAids = filter(uniq(map(getTreeValues(sig0.table), \c -> toLowerCase(c.aid))),
					\a -> a != toLowerCase(article) && a != "hidden" && a != ""
						&& mizAidRank(mmlOrder, "", a) < selfRank);
				depAids0 = uniq(concat(arrayPush(if (eth != "") mizEnvAids(eth) else [], "miz_aux"), ctorAids));
				// AUTO-LOAD already-translated dependency articles (their .ru lives next to the output
				// module) so the cited theorems come from `import`, not re-inlined axioms. No-op for a
				// dependency that isn't translated yet (its env axioms then fall back to foundation dedup).
				// The dep dir = the directory the OUTPUT lands in (ru-root): derive it from the SAME path
				// computation as the write, so it's correct whether `module` is a bare name or a path.
				// (ruDirName(module) alone is "" for a bare module name → deps never found → re-inlined.)
				outPath = ruNewFileInfo(module, state.conf, ".ru").path;
				stateD = ruMizLoadDeps(state, env, depAids0, ruDirName(outPath));
				// A dependency ARTICLE's own operators (tarski's ⋃, enumset1's
				// enumeration functors, …) now come via `import` — the emitter must
				// not re-declare their constant/rule/congruence blocks (a duplicate
				// decl crashes the parse-collect before ruMizDedupImported runs).
				// Extend the static foundation isReused with the loaded LANGUAGE
				// decl names (constants/types/rules + congruences; theorems excluded).
				depLangNames = foldTree(stateD.ru, makeSet(), \__, sr, accN ->
					fold(sr.decls, accN, \acN, d -> switch (d) {
						RuConst(__,__,__): insertSet(acN, id2s(d.info.id));
						RuType(__,__):     insertSet(acN, id2s(d.info.id));
						RuRule(__,__,__):  insertSet(acN, id2s(d.info.id));
						RuCong(__,__):     insertSet(acN, id2s(d.info.id));
						default: acN;
					}));
				emitD = FolEmit(emit with isReused = \n, isPred -> emit.isReused(n, isPred) || containsSet(depLangNames, n));
				// Import the foundation by its ACTUAL loaded source id (read-from-disk module
				// ids may be path-qualified), exactly as mptp-to-ru does.
				found_id = foldTree(stateD.ru, s2id(foundation), \id, s, acc ->
					if (s.info.module == foundation || endsWith(s.info.module, "/" + foundation)) s.info.id else acc);
				// Direct dependencies: each article aid cited in the .eth becomes an `import` of that
				// article's already-loaded .ru (module == aid). The cited theorems/defs then come FROM
				// the imported article (deduped below by name), never re-inlined as axioms here. An aid
				// that isn't loaded (e.g. fully covered by the foundation) simply yields no import — its
				// env axioms fall back to the foundation-canonical dedup.
				// Each dependency article cited in the .eth becomes an `import` of its already-loaded
				// source (resolved by aid == its module). Load the dependency the same way as the
				// foundation — `read-ru <path>` before translating this article — so its self-id is in
				// the same (resolvable-on-read-back) form as the foundation's, and the cited theorems
				// come FROM the import (deduped below by name) rather than re-inlined as axioms here.
				depResolved = filtermap(depAids0, \aid ->
					foldTree(stateD.ru, None(), \id, s, acc ->
						if (s.info.module == aid || endsWith(s.info.module, "/" + aid)) Some(Pair(aid, s.info.id)) else acc));
				depIds  = map(depResolved, \pr -> pr.second);
				importedAids = buildSet(map(depResolved, \pr -> toLowerCase(pr.first)));				importIds = concat([found_id], depIds);
				syms = mizParseNotation(mizFile(unit, article, "eno"), mizFile(unit, article, "frm"), mizFile(unit, article, "dcx"));
				// env theorems as commented axioms (available premises for the open steps).
				// srcOf resolves the DEFINING article's (.miz, .xml) so each carries its surface text.
				srcOf = \aid -> Pair(mizFile(unit, aid, "miz"), mizFile(unit, aid, "xml"));
				envPairs = if (eth != "") mizParseEnv(eth, sig, syms, srcOf, emitD.isReused, \a -> containsSet(importedAids, a)) else [];
				// the article's OWN definitions (XBOOLE_0:def N) as definitional axioms — the
				// `unfold` material the prover needs to close the by-gaps; in scope before the theorems.
				defPairs = mizArticleDefs(p.first, mizFile(unit, article, "miz"), sig, syms, emitD.isReused);
				// A form the translator could not render is JUNK — unprovable as a theorem and a
				// potentially FALSE assumption as an env axiom. Drop it rather than emit it: that
				// also stops the `unhandled_term_<Tag>` placeholder constant from being declared,
				// which is what made two IMPORTED articles collide (Mizar's <Choice> term,
				// `the Element of X`, cost 9 articles / ~600 theorems in the first 40).
				// the article's CLUSTER REGISTRATIONS — the type layer's inference content, which
				// was previously not translated at all (see mizArticleClusters).
				clusterPairs = mizArticleClusters(p.first, sig);
				allEnvPairs = filter(concatA([envPairs, defPairs, clusterPairs]), \pr -> !mizFormHasUnhandled(pr.second));
				envDecls = map(allEnvPairs, \pr -> pr.first);
				envForms = map(allEnvPairs, \pr -> pr.second);
				// ONE theorem per Mizar theorem: multi-step open proof skeleton (or a single
				// open step proving the statement when proofs=0), each carrying its Mizar ref.
				thmsOk = filter(thms, \t -> !mizFormHasUnhandled(t.statement)
					&& !exists(t.hyps, mizFormHasUnhandled) && !exists(t.steps, mizFormHasUnhandled));
				articleDecls : [RuParseDecl] = map(thmsOk, \t ->
					if (proofsOn) folProofTheorem(t.name, t.ref, t.hyps, t.steps)
					else folProofTheorem(t.name, t.ref, [], [t.statement]));
				// every emitted form contributes to the symbol signature.
				sigForms = concat(envForms, concatA(map(thmsOk, \t -> arrayPush(concat(t.hyps, t.steps), t.statement))));
				src = folArticleSource(FolSource([], ruNoFileInfo), sigForms, concat(envDecls, articleDecls), importIds, module, state.conf,
					\name -> lookupTreeDef(notationMap, name, ""), emitD);
				err = ref 0;
				env1 = ruAddErrCounter2Env(env, err);
				articleSrc = ruParseSource2RuSource(src, env1);
				if (^err != 0) {
					env.out.error("mizar-to-ru: failed to parse '" + module + "' against '" + foundation + "' (load the foundation first via read-ru)", []);
					None();
				} else {
					// First drop anything already provided by an IMPORTED article (env theorems/defs,
					// shared operator rules/consts/congruences) — those now come via `import`. Then drop
					// any remaining env axiom that matches the foundation canonically (covers a dependency
					// aid with no translated .ru of its own).
					dedupImp = ruMizDedupImported(articleSrc, ruMizLoadedDeclIds(stateD));
						dedup = ruMizDedupEnvAxioms(dedupImp.first, ruMizFoundationCanon(stateD));
						articleSrc1 = dedup.first;
						nproofs = length(filter(thms, \t -> length(t.steps) > 1));
						ndropped = dedupImp.second + dedup.second;
					env.out.println("mizar-to-ru: '" + module + "' = " + i2s(length(thms)) + " theorems (" +
						i2s(nproofs) + " with multi-step proofs)" +
						(if (depIds == []) "" else " importing " + i2s(length(depIds)) + " dependency article(s)") +
							(if (ndropped == 0) "" else " (" + i2s(ndropped) + " decls dropped — provided by imports/foundation)") +
							" importing '" + foundation + "'");
					Some(RuState(stateD with ru = setTree(stateD.ru, articleSrc1.info.id, articleSrc1)));
				}
			}
		}
	}
}

// ---- Foundation dedup: drop env axioms whose statement already appears in the foundation ----

// Canonical form of an assertion statement for cross-foundation matching: strip the leading
// ∀-closure, alpha-rename vars by first occurrence, and merge the individual sorts (setvar/set/
// class → "i") so a setvar-closed Mizar axiom matches a class-var foundation theorem. Two
// assertions share a canonical form iff they are the same formula up to variable names and the
// setvar↔class direction. Empty for non-statements. Matching here is used only to DROP redundant
// env axioms, so it is incompleteness-safe (a wrong match can never make a false proof verify).
ruMizCanonForm(stmt : RuStmt) -> string {
	if (stmt.exps == []) "" else ruMizCanonNodes(ruMizStripUniv(ruExp(stmt.exps[0])).nodes);
}

// Drop a leading chain of ∀ (wal) binders: the env axioms are universally closed, the foundation
// forms have free metavars (ax-ext is free in x,y; sstr in classes A,B,C).
ruMizStripUniv(e : RuExp) -> RuExp {
	if (e.nodes == []) e
	else switch (e.nodes[0]) {
		RuVar(__, __): e;
		RuRuleNode(idType, arityLen):
			if (id2s(ruIdType2Id(idType)) == "wal" && ruArityLen2Arity(arityLen) == 2) {
				s1 = ruMizSubtreeSize(e.nodes, 1); // size of the bound-var subtree
				ruMizStripUniv(RuExp(subrange(e.nodes, 1 + s1, length(e.nodes) - 1 - s1), -1));
			} else e;
	}
}

// Node count of the prefix-encoded subtree rooted at index i.
ruMizSubtreeSize(nodes : [RuExpNode], i : int) -> int {
	if (i >= length(nodes)) 0
	else switch (nodes[i]) {
		RuVar(__, __): 1;
		RuRuleNode(__, arityLen): fold(enumFromTo(0, ruArityLen2Arity(arityLen) - 1), 1, \pos, __ -> pos + ruMizSubtreeSize(nodes, i + pos));
	}
}

ruMizCanonNodes(nodes : [RuExpNode]) -> string {
	vm = ref makeTree(); cnt = ref 0;
	concatStrings(map(nodes, \n -> switch (n) {
		RuRuleNode(idType, arityLen): id2s(ruIdType2Id(idType)) + "/" + i2s(ruArityLen2Arity(arityLen)) + " ";
		RuVar(id, type): {
			idx = switch (lookupTree(^vm, id)) {
				Some(i): i;
				None(): { c = ^cnt; vm := setTree(^vm, id, c); cnt := c + 1; c; };
			};
			"v" + i2s(idx) + ":" + ruMizCanonSort(type) + " ";
		}
	}));
}

ruMizCanonSort(t : int) -> string {
	n = id2s(t);
	if (n == "setvar" || n == "set" || n == "class") "i" else n;
}

// Canonical forms of every foundation AXIOM/THEOREM currently loaded (the article isn't in state yet).
ruMizFoundationCanon(state : RuState) -> Set<string> {
	foldTree(state.ru, makeSet(), \__, s, acc ->
		fold(s.decls, acc, \ac, d -> switch (d) {
			RuAxiom(__, infer):       insertSet(ac, ruMizCanonForm(infer.prop));
			RuTheorem(__, infer, __, __): insertSet(ac, ruMizCanonForm(infer.prop));
			default: ac;
		}));
}

// Drop every env AXIOM in the article whose statement matches a foundation assertion. The article's
// own theorems (RuTheorem) and article-local definitions (axioms over operators absent from the
// foundation) are untouched. Returns the filtered source and the number dropped.
ruMizDedupEnvAxioms(src : RuSource, foundation : Set<string>) -> Pair<RuSource, int> {
	kept = filter(src.decls, \d -> switch (d) {
		RuAxiom(__, infer): !containsSet(foundation, ruMizCanonForm(infer.prop));
		default: true;
	});
	Pair(RuSource(src with decls = kept), length(src.decls) - length(kept));
}

// The ids of every declaration in the already-loaded sources (foundation + the dependency
// articles read in before this one). Used to drop anything we'd otherwise re-emit that an
// import already provides.
ruMizLoadedDeclIds(state : RuState) -> Set<int> {
	foldTree(state.ru, makeSet(), \__, s, acc ->
		fold(s.decls, acc, \ac, d -> insertSet(ac, d.info.id)));
}

// Load the already-translated dependency articles (`<dir>/<aid>.ru`) into the state, so the article
// being translated can `import` them. A dependency already loaded, or not yet translated (no .ru on
// disk), is skipped. Mirrors how `read-ru` loads a file (ruLoadAllInfo + ruCollectMathFast).
ruMizLoadDeps(state : RuState, env : RuEnv, depAids : [string], dir : string) -> RuState {
	fold(depAids, state, \st, aid -> {
		already = exists(getTreeValues(st.ru), \s -> s.info.module == aid || endsWith(s.info.module, "/" + aid));
		path = dir + "/" + aid + ".ru";
		if (already || !fileExists(path)) st
		else {
			module = ruTrimPath(path, st.conf, ".ru");
			loaded = ruLoadAllInfo(env, s2id(module), \id -> ruCacheGet(id, true, env), nop2, nop2);
			switch (maybeBind(loaded, \srcs -> ruCollectMathFast(srcs, env))) {
				Some(math): RuState(st with ru = mergeTree(st.ru, math.sources));
				None():     st;
			}
		}
	});
}

// Drop every NON-theorem decl (env axiom, operator rule/const, congruence, definition) whose name
// is already declared in an imported source — it now comes via `import`, so re-declaring it would be
// a duplicate. The article's OWN theorems (RuTheorem) are always kept (they are this article's work
// and are never present in an import). Returns the filtered source and the number dropped.
ruMizDedupImported(src : RuSource, importedIds : Set<int>) -> Pair<RuSource, int> {
	kept = filter(src.decls, \d -> switch (d) {
		RuTheorem(__, __, __, __): true;
		default:                   !containsSet(importedIds, d.info.id);
	});
	Pair(RuSource(src with decls = kept), length(src.decls) - length(kept));
}
