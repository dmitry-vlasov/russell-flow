import mizar/deriv;   // the recorded refutation (MizDerivClause) is transcribed here

// S4c EMISSION, pattern 1 — the deterministic completer for the A-map family.
// A by-step whose goal follows from its context by unfolding ∪/∩/∖/∅
// memberships is closed WITHOUT the prover:
//   facts   = the theorem's hyps + the preceding steps (quantifier-free ones —
//             a quantified form is an opaque atom the proof can only use
//             whole, so it is kept only when it IS the goal);
//   unfolds = one foundation biconditional instance per compound membership
//             occurring in facts/goal (elun / elin / eldif, ¬(x ∈ ∅) by noel),
//             closed recursively — each is ONE proof step with no premises;
//   close   = folPCert (G3cp -> Hilbert): facts + unfolds ⊢ goal decided and
//             translated into foundation propositional steps.
// The result splices into folProofTheoremE. A step that does not close stays
// an open `?` — attempted/closed/skipped are reported, never hidden.

export {
	MizEmitCounts(attempted : int, closed : int, skipped : int);
	// per original step: a closed deterministic proof, or None (stays open).
	// maxFacts / maxSize bound the proof attempt (skipped = over budget).
	// `recOf(pos)` gives the checker's RECORDED instantiated premises for the
	// by-step at that position; `stmtOf(name)` the statement of a cited
	// assertion. Each recorded instance is matched against the step's citations
	// and, where one instantiates to it, enters the ladder as a derived fact
	// PROVED from that citation — Mizar's own choice of premise and witness
	// instead of a search.
	// `isAxiom(name)` says the assertion is emitted as an AXIOM — its statement
	// is ∀-closed, so an instance of it must be derived by elimination. Anything
	// else is emitted as a THEOREM, whose proposition is the open matrix over
	// the theorem's own variables: Russell instantiates it when a step names it,
	// so the instance is stated directly in one step. Getting this backwards is
	// what made three xboole_1 theorems and two zfmisc_1 theorems unverifiable.
	// `hypStmtOf(name)` resolves an own-article theorem emitted WITH hypotheses
	// to (proposition, hypotheses): such a theorem is citable only through the
	// hyp-cite channel, which supplies one reference per substituted hypothesis.
	mizEmitThmProofs(t : MizThm, maxFacts : int, maxSize : int,
		recOf : (string) -> [FolForm], stmtOf : (string) -> Maybe<FolForm>,
		hypStmtOf : (string) -> Maybe<Pair<FolForm, [FolForm]>>,
		bySkeleton : (string) -> [string], expOf : (string) -> [Pair<string, string>],
		eqOf : (string) -> [FolForm], codesOf : (string) -> [int],
		clausesOf : (string) -> [MizDerivClause],
		isAxiom : (string) -> bool,
		shOf : (string) -> string) -> Pair<[Maybe<FolStepProof>], MizEmitCounts>;
	// the index key: instantiation preserves it exactly
	mizEmitSkeleton(f : FolForm) -> string;
	// every skeleton a statement can be matched under — its own and those of
	// the PIECES the checker may have used (a definition's conjunct, one
	// direction of a biconditional). Indexing only the whole statement hid
	// exactly the type-layer expansions: subset_1's `Element of` meaning is the
	// first conjunct of d1_subset_1, never the whole of it.
	mizEmitPieceSkeletons(f : FolForm) -> [string];
	// how many recorded facts were emitted as derived facts (a run counter, for
	// the census line)
	mizEmitRecUsed() -> int;
	// comms installs the defs-by-symbol lookup (definitions + constructor types
	// indexed by the symbols they mention, imported ones included)
	mizEmitSetDefsOfSym(fn : (string) -> [string]) -> void;
	mizEmitSetRegsOfSym(fn : (string) -> [string]) -> void;
	// the ARTICLE symbols a form mentions (not the foundation's ∈ / ⊆ / = …)
	mizFormSymbols(f : FolForm) -> [string];
	// derived facts re-stated as an equivalence instead of the checker's normal form
	mizEmitCleanCount() -> int;
	mizEmitRecReset() -> void;
	// register a built theorem's declared disjointedness groups (var names)
	mizEmitSetThmDisjs(name : string, groups : [[string]]) -> void;
	// (citations resolved to a statement, instances matched to one) — the two
	// places the record-to-citation join can fail
	mizEmitRecDiag() -> Pair<int, int>;
	// why the proof attempts failed, over the whole article:
	// (unprovable from the facts offered, G3cp tree too big, proof too long)
	mizEmitFailKinds() -> Triple<int, int, int>;
	// failed steps for which SOME attempt produced a proof that was merely too
	// long or too big — those are an encoding problem, not a fact problem
	mizEmitLongStepCount() -> int;
	// (failing steps, of which the record HAS the checker's refutation)
	mizEmitClauseCoverage() -> Pair<int, int>;
	// clause literals of failing steps: [shares a goal atom, has a symbol the
	// goal never mentions (a skolem constant), neither]
	mizEmitLitKinds() -> [int];
	// instantiations declined because the witness mentions the statement's
	// own binder — a NAME collision between an axiom's bound variable and the
	// step's free variable, not a real capture
	mizEmitInstDeclines() -> int;
	// (declines on the congruence walk, declines on sethood)
	mizEmitInstDeclWalkSeth() -> Pair<int, int>;
	// failing steps whose recorded instance was never offered as a fact
	mizEmitClauseNoInstCount() -> int;
	// those instances bucketed: [premise did not translate, no candidate
	// statement, a candidate but no match, matched yet not built]
	mizEmitNoInstKinds() -> [int];
	// [one-step-short theorems, of them with the checker's refutation recorded,
	// theorems whose every failing step has one]
	mizEmitReplayCoverage() -> [int];
	// the binder names those declines were on, most frequent first
	mizEmitInstDeclNamesTop() -> string;
	// (definitions the record named at emitted steps, instances built from them)
	mizEmitDefDiag() -> Triple<int, int, int>;
	// (ladder stages that saw a hypothetical-citation candidate, instances built)
	mizEmitHypCiteDiag() -> Pair<int, int>;
	// why hypothetical-citation attempts declined, bucketed (a census string)
	mizEmitHypWhy() -> string;
}

mizEmitRecCount : ref int = ref 0;
mizEmitRecCites : ref int = ref 0;
mizEmitRecMatch : ref int = ref 0;
mizEmitRecDiag() -> Pair<int, int> { Pair(^mizEmitRecCites, ^mizEmitRecMatch); }

mizEmitDbg : ref bool = ref false;
// the article's sethood lookup, needed deep inside the reduction: a means-
// definition is instantiated at an element the REDUCTION invented (the ⊆/=
// characterization's fresh variable), which the caller cannot know
mizEmitShOfRef : ref ((string) -> string) = ref (\__ -> "");
// the per-step statement lookup and the defs-by-symbol index, for the
// ∃-elimination's FIRST LINK: the definition of the assumption's own head
// predicate (asm `v1_relat_1 X` → d1_relat_1 at X). Selection by the head
// symbol of a fact IN SCOPE — not by every symbol the step mentions, which
// was the measured budget-blowing dead end.
mizEmitStmtOfRef : ref ((string) -> Maybe<FolForm>) = ref (\__ -> None());
mizEmitDefsOfSymRef : ref ((string) -> [string]) = ref (\__ -> []);
// THE TYPE LAYER's supply: the cluster REGISTRATIONS indexed by the functor
// they speak about. A registration is what gives a term its attributes ("the
// powerset of anything is non empty"), the checker applies them WITHOUT
// citation — the type record's F half names them per firing — and the
// translator already emits them as citable axioms (fc<N>_<article>). Indexed
// by functor because that is how a step meets them: it mentions the term.
mizEmitRegsOfSymRef : ref ((string) -> [string]) = ref (\__ -> []);
// the CONTRADICTION CODES the checker closed this step's disjuncts with —
// its own name for the rule it used. The emitter dispatches on them: a
// channel that serves one kind of inference runs only where that kind fired.
// The type family is codes 1,2,6,8,9,10,11 (attribute clash) and 21,40,41,43
// (type membership); see the census in docs/mizar-inference-catalogue.md.
mizEmitStepCodesRef : ref [int] = ref [];
// the RECORDED REFUTATION of this step, when the checker closed it with a
// single disjunct: clause, premise instance, and the kill pairing
mizEmitStepClausesRef : ref [MizDerivClause] = ref [];
mizEmitTypeCodes() -> [int] { [1, 2, 6, 8, 9, 10, 11, 21, 40, 41, 43]; }
mizEmitStepIsTyped() -> bool {
	exists(^mizEmitStepCodesRef, \c -> exists(mizEmitTypeCodes(), \t -> t == c));
}
// the current step's CITED statements (name, statement): a step with no
// record facts previously got NOTHING from its by-list — the citations only
// served the record matcher. Rung 3 instantiates these at the stage's free
// variables like any other ∀-fact (cite-rooted chain, mizEmitInstCite).
mizEmitCiteStmtsRef : ref [Pair<string, FolForm>] = ref [];
// the current step's cited HYPOTHETICAL statements (name, (prop, hyps)): a
// theorem emitted with hypotheses is cited by stating an instance of its
// proposition and supplying one reference per substituted hypothesis
mizEmitCiteHypsRef : ref [Pair<string, Pair<FolForm, [FolForm]>>] = ref [];
// same-skeleton statement lookup + the axiom-shape dispatch, for deriving a
// def instance's GUARD inside the reduction: the checker uses cluster
// registrations WITHOUT citation, so the by-list can never supply
// `Relation X → Relation (X~)` — the constructor-type axioms can
mizEmitBySkelRef : ref ((string) -> [string]) = ref (\__ -> []);
mizEmitIsAxiomRef : ref ((string) -> bool) = ref (\__ -> false);
// the current step's merge-log seed: atom keys (both orientations) of the
// premise equations the equalizer consumed at this position
mizEmitSeedKeysRef : ref Set<string> = ref makeSet();
// declared disjointedness groups of the article's ALREADY-BUILT theorems
// (rendered var names): a citation of an open-matrix theorem must map these
// through its substitution and carry them — or decline when a group member
// is substituted by a non-variable (the citation would be illegal)
mizEmitThmDisjsRef : ref Tree<string, [[string]]> = ref makeTree();
// disjointedness pairs collected by the membership-NF rewriting (the def
// unfold's ∀-elimination demands them); harvested by the rewrite's consumers
mizEmitNFDjRef : ref [Pair<string, string>] = ref [];
// per STEP: did some proof attempt find a proof that was only too LONG?
// That step wants a smaller encoding, not better facts.
mizEmitStepLong : ref bool = ref false;
mizEmitLongSteps : ref int = ref 0;
// coverage counters for the recorded-refutation route
mizEmitFailSteps2 : ref int = ref 0;
mizEmitFailWithClause : ref int = ref 0;
mizEmitInstDeclBinder : ref int = ref 0;
mizEmitInstDeclNames : ref Tree<string, int> = ref makeTree();
mizEmitInstDeclWalk : ref int = ref 0;
mizEmitInstDeclSeth : ref int = ref 0;
// failing steps whose RECORDED instance never became one of the offered facts
mizEmitClauseNoInst : ref int = ref 0;
// per-theorem: failing steps, and how many of them carry a full refutation
mizEmitThmFail : ref int = ref 0;
mizEmitThmFailRec : ref int = ref 0;
// theorems ONE STEP short, and those whose single failing step is covered
mizEmitOneShort : ref int = ref 0;
mizEmitOneShortRec : ref int = ref 0;
// theorems whose EVERY failing step is covered (the replay's ceiling)
mizEmitAllCovered : ref int = ref 0;
mizEmitNoInstVerum : ref int = ref 0;
mizEmitNoInstNoCand : ref int = ref 0;
mizEmitNoInstNoMatch : ref int = ref 0;
mizEmitNoInstOther : ref int = ref 0;
mizEmitLitShared : ref int = ref 0;
mizEmitLitForeign : ref int = ref 0;
mizEmitLitOther : ref int = ref 0;
mizEmitDefNames : ref int = ref 0;
mizEmitDefMade : ref int = ref 0;
mizEmitDischarged : ref int = ref 0;
mizEmitCleaned : ref int = ref 0;
mizEmitFailUnprov : ref int = ref 0;
mizEmitFailNodes : ref int = ref 0;
mizEmitFailSteps : ref int = ref 0;
mizEmitLongStepCount() -> int { ^mizEmitLongSteps; }
mizEmitClauseCoverage() -> Pair<int, int> { Pair(^mizEmitFailSteps2, ^mizEmitFailWithClause); }
mizEmitLitKinds() -> [int] { [^mizEmitLitShared, ^mizEmitLitForeign, ^mizEmitLitOther]; }
mizEmitInstDeclines() -> int { ^mizEmitInstDeclBinder; }
mizEmitInstDeclWalkSeth() -> Pair<int, int> { Pair(^mizEmitInstDeclWalk, ^mizEmitInstDeclSeth); }
mizEmitClauseNoInstCount() -> int { ^mizEmitClauseNoInst; }
// [one-step-short theorems, of them covered by a refutation, theorems with
// every failing step covered]
mizEmitReplayCoverage() -> [int] {
	[^mizEmitOneShort, ^mizEmitOneShortRec, ^mizEmitAllCovered];
}
mizEmitNoInstKinds() -> [int] { [^mizEmitNoInstVerum, ^mizEmitNoInstNoCand,
	^mizEmitNoInstNoMatch, ^mizEmitNoInstOther]; }
mizEmitInstDeclNamesTop() -> string {
	strGlue(map(subrange(sortCustom(tree2pairs(^mizEmitInstDeclNames), \p9 -> -p9.second, true),
		0, 8), \p9 -> p9.first + ":" + i2s(p9.second)), " ");
}

mizEmitCleanCount() -> int { ^mizEmitCleaned; }
mizEmitDefDiag() -> Triple<int, int, int> {
	Triple(^mizEmitDefNames, ^mizEmitDefMade, ^mizEmitDischarged);
}

mizEmitFailKinds() -> Triple<int, int, int> {
	Triple(^mizEmitFailUnprov, ^mizEmitFailNodes, ^mizEmitFailSteps);
}
mizEmitHypCands : ref int = ref 0;
mizEmitHypMade : ref int = ref 0;
mizEmitHypCiteDiag() -> Pair<int, int> { Pair(^mizEmitHypCands, ^mizEmitHypMade); }
mizEmitHypWhyRef : ref Tree<string, int> = ref makeTree();
mizEmitCurThmRef : ref string = ref "";
// PER-THEOREM WORK BUDGET, in proof attempts (mizEmitTry calls) —
// deterministic and machine-independent. One pathological theorem
// (t115_zfmisc_1: 4 binders, ∨ antecedent over products) burned 20 of
// zfmisc_1's 24 emit minutes on attempts that never closed; at MML scale
// a theorem must never cost that. Over budget = the honest SKIP verdict.
// `emit-work=N` overrides; 0 disables.
mizEmitWorkRef : ref int = ref 0;
mizEmitWorkCapRef : ref int = ref 512;
mizEmitHypBump(k : string) -> void {
	mizEmitHypWhyRef := setTree(^mizEmitHypWhyRef, k, lookupTreeDef(^mizEmitHypWhyRef, k, 0) + 1);
}
mizEmitHypWhy() -> string {
	strGlue(map(tree2pairs(^mizEmitHypWhyRef), \p -> p.first + "=" + i2s(p.second)), " ");
}
mizEmitRecUsed() -> int { ^mizEmitRecCount; }
mizEmitSetDefsOfSym(fn : (string) -> [string]) -> void { mizEmitDefsOfSymRef := fn; }
mizEmitSetRegsOfSym(fn : (string) -> [string]) -> void { mizEmitRegsOfSymRef := fn; }
mizEmitRecReset() -> void {
	mizEmitRecCount := 0; mizEmitRecCites := 0; mizEmitRecMatch := 0;
	mizEmitFailUnprov := 0; mizEmitFailNodes := 0; mizEmitFailSteps := 0;
	mizEmitLongSteps := 0; mizEmitDefNames := 0; mizEmitDefMade := 0;
	mizEmitFailSteps2 := 0; mizEmitFailWithClause := 0;
	mizEmitLitShared := 0; mizEmitLitForeign := 0; mizEmitLitOther := 0;
	mizEmitInstDeclBinder := 0; mizEmitInstDeclNames := makeTree();
	mizEmitInstDeclWalk := 0; mizEmitInstDeclSeth := 0; mizEmitClauseNoInst := 0;
	mizEmitOneShort := 0; mizEmitOneShortRec := 0; mizEmitAllCovered := 0;
	mizEmitNoInstVerum := 0; mizEmitNoInstNoCand := 0;
	mizEmitNoInstNoMatch := 0; mizEmitNoInstOther := 0;
	mizEmitDischarged := 0; mizEmitCleaned := 0;
	mizEmitHypCands := 0; mizEmitHypMade := 0;
	mizEmitHypWhyRef := makeTree();
	mizEmitThmDisjsRef := makeTree();
}

mizEmitThmProofs(t : MizThm, maxFacts : int, maxSize : int,
	recOf : (string) -> [FolForm], stmtOf : (string) -> Maybe<FolForm>,
	hypStmtOf : (string) -> Maybe<Pair<FolForm, [FolForm]>>,
	bySkeleton : (string) -> [string], expOf : (string) -> [Pair<string, string>],
	eqOf : (string) -> [FolForm], codesOf : (string) -> [int],
	clausesOf : (string) -> [MizDerivClause],
	isAxiom : (string) -> bool,
	shOf : (string) -> string) -> Pair<[Maybe<FolStepProof>], MizEmitCounts> {
	// the work budget is PER THEOREM: reset here, cap from emit-work= (0 = off)
	mizEmitWorkRef := 0;
	mizEmitWorkCapRef := s2i(getUrlParameterDef("emit-work", "512"));
	mizEmitThmFail := 0;
	mizEmitThmFailRec := 0;
	res = foldi(t.steps, Pair([], MizEmitCounts(0, 0, 0)), \i, acc : Pair<[Maybe<FolStepProof>], MizEmitCounts>, goal -> {
		pos = if (i < length(t.stepPos)) t.stepPos[i] else "";
		// THE CHECKER'S OWN PREMISES. recOf keeps only FULLY instantiated
		// record facts; the recorded refutation keeps the rest — the instance
		// Mizar actually refuted with, whether or not every binder was assigned.
		// Adding it is not a heuristic: it is the premise the checker used.
		recs0 = if (pos == "") [] else recOf(pos);
		// The clause's LITERALS were offered here too and closed nothing: they
		// speak of the checker's fresh constants, so they are not facts that can
		// be derived on their own — the constant has to be introduced first, and
		// that is what mizEmitNempEx does for the case the record shows.
		recs = uniqBy(concat(recs0, map(clausesOf(pos), \c -> c.instance)),
			\a9, b9 -> mizEmitKey(a9) == mizEmitKey(b9));
		cites = if (i < length(t.stepRefs)) t.stepRefs[i] else [];
		// S-C: the definitions the checker expanded for THIS step, instantiated
		// against the step's own atoms
		stepAtoms = uniq(concatA(map(concat(t.hyps, arrayPush(subrange(t.steps, 0, i), goal)),
			\f -> mizEmitAtomsOf(f, []))));
		ctxI = concat(
			mapi(t.hyps, \j, h -> Pair(h, mizEmitHypRef(j))),
			mapi(subrange(t.steps, 0, i), \j, sp -> Pair(sp, mizEmitStepRef(j))));
		// a guard the context does not carry: try to DERIVE it from an
		// environment statement — the constructor-type axioms are exactly the
		// statements that say what type a functor term has
		proveGuard = \g : FolForm -> {
			cands = concat(cites, bySkeleton(mizEmitSkeleton(g)));
			// an exact statement first, then the ones that state `g` under guards
			concat(
				switch (mizEmitRecFromCites(cands, g, stmtOf, isAxiom, shOf)) {
					None(): []; Some(d): [d];
				},
				mizEmitGuardedInsts(cands, g, stmtOf, isAxiom, shOf, 6));
		};
		// the rules the checker closed THIS step with (record dispatch)
		mizEmitStepCodesRef := codesOf(pos);
		mizEmitStepClausesRef := clausesOf(pos);
		mizEmitShOfRef := shOf;
		mizEmitStmtOfRef := stmtOf;
		mizEmitBySkelRef := bySkeleton;
		mizEmitIsAxiomRef := isAxiom;
		// THE MERGE-LOG SEED: the premise equations the equalizer consumed at
		// this position, in both orientations, as atom KEYS — they join the
		// relevance closure's seed and the greedy's scoring set, so the facts
		// the checker itself used outrank everything else from the start
		seedEqs = eqOf(pos);
		mizEmitSeedKeysRef := fold(seedEqs, makeSet(), \ac9, f9 -> switch (f9) {
			FolEq(l9, r9): insertSet(insertSet(ac9, mizEmitKey(f9)),
				mizEmitKey(FolEq(r9, l9)));
			default: ac9;
		});
		if (^mizEmitDbg || t.name == getUrlParameterDef("dbg-thm", ""))
			if (seedEqs != [])
				println("  SEED-EQS " + i2s(length(seedEqs)) + " :: "
					+ strGlue(map(seedEqs, \f9 -> strGlue(folFormToks(f9), " ")), " ; "));
		// only names whose TABLE TEXT is the emitted text may be stated as cite
		// facts: an own-article theorem's entry IS its emitted prop (since the
		// honesty gate, the ∀-closed Mizar statement), and an env axiom is
		// emitted ∀-closed as stated. An IMPORTED theorem's entry is the .eth
		// statement while its emitted shape was decided in its own article —
		// citing t27_xtuple_0 by the .eth text made Russell DISPROVE relat_1.
		artOf = \nm : string -> {
			u = strIndexOf(nm, "_");
			if (u < 0) nm else strRight(nm, u + 1);
		};
		ownArt = artOf(t.name);
		mizEmitCiteStmtsRef := filtermap(cites, \c ->
			if (!isAxiom(c) && artOf(c) != ownArt) None()
			else switch (stmtOf(c)) {
				None(): None();
				Some(st): Some(Pair(c, st));
			});
		// cited theorems emitted WITH hypotheses (own-article only — the table
		// is built from this article's theorems): the hyp-cite channel proves
		// each substituted hypothesis and supplies the references
		mizEmitCiteHypsRef := filtermap(cites, \c -> switch (hypStmtOf(c)) {
			None(): None();
			Some(ph): Some(Pair(c, ph));
		});
		defDrvs = map(mizEmitDefUnfolds(expOf(pos), stepAtoms, stmtOf, shOf, 6), \d -> {
			r = mizEmitDischarge(d, ctxI, proveGuard);
			if (getUrlParameterDef("dbg-guard", "") == "1" && r.form != d.form)
				println("DISCHARGED " + strGlue(folFormToks(r.form), " "));
			if (getUrlParameterDef("dbg-guard", "") == "1" && r.form == d.form)
				println("GUARD-KEPT " + strGlue(folFormToks(d.form), " "));
			r;
		});
		mizEmitDefNames := ^mizEmitDefNames + length(expOf(pos));
		mizEmitDefMade := ^mizEmitDefMade + length(defDrvs);
		drvs0 = filtermap(recs, \fact -> {
			// the step's own citations first, then any environment statement with
			// the same skeleton (the premise Mizar used without citing it)
			// the step's citations, the DEFINITIONS the checker expanded while
			// checking it, then anything with the same skeleton
			cands = concatA([cites, map(expOf(pos), \p -> p.first),
				bySkeleton(mizEmitSkeleton(fact))]);
			d = mizEmitRecFromCites(cands, fact, stmtOf, isAxiom, shOf);
			if (isSome(d)) mizEmitRecCount := ^mizEmitRecCount + 1;
			if (isNone(d) && t.name == getUrlParameterDef("dbg-thm", "")) {
				println("  REC-UNMATCHED cands=" + strGlue(cands, ",")
					+ " fact=" + strGlue(folFormToks(fact), " "));
				iter(subrange(cands, 0, 2), \c9 -> switch (stmtOf(c9)) {
					None(): println("    CAND " + c9 + " no-stmt");
					Some(st9): println("    CAND " + c9 + " axiom=" + b2s(isAxiom(c9))
						+ " match=" + b2s(isSome(mizEmitMatchInst(st9, fact)))
						+ " stmt=" + strGlue(folFormToks(st9), " "));
				});
			}
			d;
		});
		// A guard that could NOT be discharged is still worth stating. Under a
		// deduction step the antecedents live in the CERTIFICATE's context, not
		// in ctx, so the discharge cannot reach them — but the statement that
		// would have discharged the guard (`argGuards → element (f ā) T`) is an
		// ordinary fact with a self-contained proof, and the proof chains
		// it with the assumption itself.
		guardDrvs = concatA(map(defDrvs, \d -> switch (d.form) {
			FolBin(op, l, __): if (op != "imp" || isSome(find(ctxI, \p -> p.first == l))) []
				else mizEmitGuardedInsts(concat(cites, bySkeleton(mizEmitSkeleton(l))),
					l, stmtOf, isAxiom, shOf, 2);
			default: [];
		}));
		// every derived fact is offered in the CHEAPER of the two forms — the
		// checker's normalized iff costs twice the connectives of the equivalence
		// it states, and the budget is what binds
		// a derived instance whose equation atom IS the step's own goal equation
		// is CIRCULAR — the def channel emitted the goal's eqss as an "expansion"
		// and its bridges crowded the cut while proving nothing
		goalEqKeys = fold(mizEmitEqAtoms(goal, []), makeSet(), \ac8, e8 -> switch (e8) {
			FolEq(l8, r8): insertSet(insertSet(ac8, mizEmitKey(e8)), mizEmitKey(FolEq(r8, l8)));
			default: ac8;
		});
		defDrvs1 = filter(defDrvs, \d8 -> !exists(mizEmitEqAtoms(d8.form, []),
			\e8 -> containsSet(goalEqKeys, mizEmitKey(e8))));
		// The record's existentials are NOT computed here: at this level the
		// step's own variables are still bound by the goal's prefix, so every
		// name looks foreign and the walk cannot tell the checker's constants
		// from ours. It runs where the goal has been peeled — at the leaf.
		nempDrvs = mizEmitClauseExAll(concat(t.hyps,
			arrayPush(subrange(t.steps, 0, i), goal)));
		// nempDrvs stays OUT of the normalizer: it turns `¬(A = ∅) → ∃x (x ∈ A)`
		// into the ∀-contrapositive, which is the one form the ∃-elimination
		// cannot use — and an eigenvariable is the whole point of the fact.
		drvs = concat(map(concatA([drvs0, defDrvs1, guardDrvs]), mizEmitCleanIff), nempDrvs);
		// the RECORD'S OWN equations seed the scoring too: the checker-attested
		// instances (a cited theorem's `proj2 X = proj1 (X~)`, an expanded
		// definition's equation) are as authoritative as the merge log's direct
		// literals, and their bridges must outrank the ⊆-junk in the cut
		mizEmitSeedKeysRef := fold(concatA(map(drvs, \d9 -> mizEmitEqAtoms(d9.form, []))),
			^mizEmitSeedKeysRef, \ac9, e9 -> switch (e9) {
				FolEq(l9, r9): insertSet(insertSet(ac9, mizEmitKey(e9)),
					mizEmitKey(FolEq(r9, l9)));
				default: ac9;
			});
		// `dbg-thm=<name>` traces one theorem's proof attempts
		mizEmitDbg := (t.name == getUrlParameterDef("dbg-thm", ""));
		mizEmitCurThmRef := t.name;
		mizEmitNFDjRef := [];
		mizEmitStepLong := false;
		if (^mizEmitDbg)
			println("  DRVS " + i2s(length(drvs)) + " (rec " + i2s(length(drvs0))
				+ " def " + i2s(length(defDrvs)) + " guard " + i2s(length(guardDrvs))
				+ ") pos=" + pos + " recs=" + i2s(length(recs))
				+ " :: " + strGlue(map(drvs, \d9 -> strGlue(folFormToks(d9.form), " ")), " ;; "));
		r = mizEmitStepProof(t.hyps, subrange(t.steps, 0, i), goal, maxFacts, maxSize, drvs);
		if (isNone(r.first) && ^mizEmitStepLong) {
			mizEmitLongSteps := ^mizEmitLongSteps + 1;
			if (getUrlParameterDef("dbg-long", "") == "1")
				println("LONG " + mizEmitSkeleton(goal) + " :: " + strGlue(folFormToks(goal), " "));
		};
		if (isNone(r.first) && ^mizEmitDbg)
			println("FAILSTEP " + t.name + " goal=" + strGlue(folFormToks(goal), " ")
				+ "  provable-but-long=" + b2s(^mizEmitStepLong));
		// THE TRANSCRIPTION'S COVERAGE, measured per failing step: does the
		// checker's own refutation of this step exist in the record at all?
		if (isNone(r.first)) {
			mizEmitThmFail := ^mizEmitThmFail + 1;
			if (^mizEmitStepClausesRef != []) mizEmitThmFailRec := ^mizEmitThmFailRec + 1;
			mizEmitFailSteps2 := ^mizEmitFailSteps2 + 1;
			if (^mizEmitStepClausesRef != []) {
				mizEmitFailWithClause := ^mizEmitFailWithClause + 1;
				// the two normal forms, side by side — is the gap EXPANSION or
				// merely spelling? (the caveat the measurement left open)
				if (^mizEmitDbg) {
					// the step's own context, so the clause can be read against
					// what the emitted proof actually has in hand
					iter(t.hyps, \h8 -> println("    ctx-hyp:  "
						+ strGlue(folFormToks(h8), " ")));
					iteri(subrange(t.steps, 0, i), \j8, s8 -> println("    ctx-step[" + i2s(j8)
						+ "] " + strGlue(folFormToks(s8), " ")));
					iter(^mizEmitStepClausesRef, \c8 -> {
						println("  CLAUSE-VS-GOAL goal: " + strGlue(folFormToks(goal), " "));
						iteri(c8.lits, \k8, pl8 -> println("    lit[" + i2s(pl8.first) + "] "
							+ strGlue(folFormToks(pl8.second), " ")));
						println("    instance: " + strGlue(folFormToks(c8.instance), " "));
						println("    premise:  " + strGlue(folFormToks(c8.premise), " "));
						iter(c8.wits, \w8 -> println("    wit " + w8.first + " := "
							+ strGlue(folTermToks(w8.second), " ")));
						iter(c8.kills, \k9 -> println("    kill anr=" + i2s(k9.first) + " by "
							+ strGlue(folFormToks(k9.second), " ")));
						println("    code: " + i2s(c8.code));
					});
				}
				// AND IS THE CHECKER'S OWN INSTANCE AMONG THE FACTS? After the
				// binder fix this is the honest coverage number: a failing step
				// whose recorded instance is present failed on the endgame, one
				// whose instance is missing failed to BUILD it.
				// the built fact carries OUR binder names, so the comparison is
				// alpha-tolerant like the matcher's
				offered = \ins : FolForm -> exists(drvs, \d8 ->
					isSome(mizEmitMatchF(d8.form, ins, makeSet(), Some(makeTree()))));
				if (exists(^mizEmitStepClausesRef, \c7 -> !offered(c7.instance))) {
					mizEmitClauseNoInst := ^mizEmitClauseNoInst + 1;
					// WHY it was not built, bucketed: the record's premise did not
					// translate (⊤), no citable statement is a candidate at all, or
					// a candidate IS the premise and the instance does not match it
					iter(^mizEmitStepClausesRef, \c6 ->
						if (!offered(c6.instance)) {
							cands6 = concat(cites, bySkeleton(mizEmitSkeleton(c6.instance)));
							matched = exists(cands6, \c5 -> switch (stmtOf(c5)) {
								None(): false;
								Some(st5): isSome(mizEmitMatchInst(st5, c6.instance))
									|| isSome(mizEmitMatchInstG(st5, c6.instance));
							});
							if (mizEmitKey(c6.instance) == mizEmitKey(FolPred("⊤", [])))
								mizEmitNoInstVerum := ^mizEmitNoInstVerum + 1
							else if (matched) mizEmitNoInstOther := ^mizEmitNoInstOther + 1
							else if (cands6 == []) mizEmitNoInstNoCand := ^mizEmitNoInstNoCand + 1
							else mizEmitNoInstNoMatch := ^mizEmitNoInstNoMatch + 1;
						});
					if (getUrlParameterDef("dbg-noinst", "") == "1"
						&& ^mizEmitClauseNoInst <= 6)
						iter(^mizEmitStepClausesRef, \c7 ->
							if (!offered(c7.instance))
								{
									cands7 = concat(cites, bySkeleton(mizEmitSkeleton(c7.instance)));
									println("  NOINST " + t.name
										+ "\n    want=" + strGlue(folFormToks(c7.instance), " ")
										+ "\n    from=" + strGlue(folFormToks(c7.premise), " ")
										+ "\n    stmts=" + strGlue(map(subrange(cands7, 0, 3),
											\c4 -> c4 + "=" + (switch (stmtOf(c4)) {
												None(): "-";
												Some(st4): strGlue(folFormToks(st4), " ");
											})), " | ")
										+ "\n    cands=" + strGlue(map(subrange(cands7, 0, 6),
											\c6 -> c6 + "(" + (switch (stmtOf(c6)) {
												None(): "no-stmt";
												Some(st6): if (isSome(mizEmitMatchInst(st6, c7.instance)))
													"MATCH" else "no-match";
											}) + ")"), " "));
								});
				}
				// HOW FAR APART are the two normal forms? Every literal whose
				// atoms all occur in the goal is propositional shuffling; one
				// carrying a symbol the goal never mentions is Mizar's own
				// skolem constant, and that is a different kind of work.
				gAtoms = buildSet(map(mizEmitAtomsOf(goal, []), mizEmitKey));
				gSyms = buildSet(concatA(map(mizEmitAtomsOf(goal, []), mizFormSymbols)));
				iter(^mizEmitStepClausesRef, \c9 -> iter(c9.lits, \pl -> {
					las = mizEmitAtomsOf(pl.second, []);
					shared = exists(las, \a9 -> containsSet(gAtoms, mizEmitKey(a9)));
					foreign = exists(concatA(map(las, mizFormSymbols)),
						\sy -> !containsSet(gSyms, sy));
					if (foreign) mizEmitLitForeign := ^mizEmitLitForeign + 1
					else if (shared) mizEmitLitShared := ^mizEmitLitShared + 1
					else mizEmitLitOther := ^mizEmitLitOther + 1;
				}));
			}
		}
		cnt = acc.second;
		ncnt = switch (r.first) {
			None(): if (r.second) MizEmitCounts(cnt.attempted, cnt.closed, cnt.skipped + 1)
				else MizEmitCounts(cnt.attempted + 1, cnt.closed, cnt.skipped);
			Some(__): MizEmitCounts(cnt.attempted + 1, cnt.closed + 1, cnt.skipped);
		};
		Pair(arrayPush(acc.first, r.first), ncnt);
	});
	// THE REPLAY'S CEILING, per theorem: a theorem closes only when EVERY step
	// closes, so what decides the prize is not how many steps carry the
	// checker's refutation but how they fall across theorems
	if (^mizEmitThmFail == 1) {
		mizEmitOneShort := ^mizEmitOneShort + 1;
		if (^mizEmitThmFailRec == 1) mizEmitOneShortRec := ^mizEmitOneShortRec + 1;
	};
	if (^mizEmitThmFail > 0 && ^mizEmitThmFail == ^mizEmitThmFailRec)
		mizEmitAllCovered := ^mizEmitAllCovered + 1;
	res;
}

// a DERIVED fact: a ∀-instance of a quantified context fact, with its own
// proof block (spv + a congruence walk); the block's FolPRefFact indices
// point into its OWN `refs` list (usually just the quantified fact's ref)
MizEmitDrv(form : FolForm, steps : [FolPStep], refs : [RuParseRef],
	disjs : [Pair<string, string>]);

// (proof?, skippedByBudget) — goal REDUCTION around the fact ladder:
// peel ∀ with ax-gen, turn a ⊆/= goal into a fresh-variable ∀-matrix via
// df-ss/dfcleq + mpbir, split an ∧ goal with pm3.2i; the matrix closes by
// the ladder (unfolds → bridges → ∀-instances)
mizEmitStepProof(hyps : [FolForm], prev : [FolForm], goal : FolForm,
	maxFacts : int, maxSize : int, recDrv : [MizEmitDrv]) -> Pair<Maybe<FolStepProof>, bool> {
	used = buildSet(concatA(map(concat(hyps, arrayPush(prev, goal)), folFormVars)));
	fresh = ref 0;
	// the recorded facts are plain facts of the step once proved, so the ladder
	// sees them as extra context — with their own proof block attached
	r = mizEmitReduce(hyps, prev, goal, maxFacts, maxSize, 0, fresh, used, recDrv);
	switch (r.first) {
		Some(__): r;
		None(): mizEmitExElim(hyps, prev, goal, maxFacts, maxSize, fresh, used, recDrv, r);
	}
}

// ---- USING an existential fact ----
// A hypothesis `∃x φ(x)` was an opaque atom: the proof cannot open a
// quantifier, so the fact contributed nothing (a Mizar `consider` leaves both
// the ∃ and its witnessed instance in scope, but a `∃` that arrives ALONE —
// most often from a cited theorem — was dead weight). Mizar's own reading is
// ∃-elimination: name the witness, reason from φ(name), and the name must not
// escape into the conclusion. That is one lemma here: the deduction reduction
// proves `φ(x) → goal` with the binder as the temporary name, exlimiv turns it
// into `∃x φ(x) → goal` (its disjointness condition — x not in the goal — is
// exactly the no-escape rule), and ax-mp closes with the hypothesis. Tried for
// each ∃ hypothesis in turn; the binder must not occur free anywhere else.
// one candidate existential: its formula, and how it is obtained — a context
// fact is cited by `ref`; a derived one carries its own proof block whose last
// step proves `form` (refs index the block's OWN factRefs extension)
MizExCand(form : FolForm, ref : Maybe<RuParseRef>, steps : [FolPStep],
	refs : [RuParseRef], disjs : [Pair<string, string>]);

mizEmitExElim(hyps : [FolForm], prev : [FolForm], goal : FolForm,
	maxFacts : int, maxSize : int, fresh : ref int, used : Set<string>,
	recDrv : [MizEmitDrv], failed : Pair<Maybe<FolStepProof>, bool>) -> Pair<Maybe<FolStepProof>, bool> {
	ctx = concat(
		mapi(hyps, \j, h -> Pair(h, mizEmitHypRef(j))),
		mapi(prev, \j, sp -> Pair(sp, mizEmitStepRef(j))));
	ctxCands = map(ctx, \p -> MizExCand(p.first, Some(p.second), [], [], []));
	// ...and the ∃-facts one modus ponens away: a definition instance often
	// reads `x ∈ X → ∃ā ψ` (every element of a relation is a pair) with its
	// antecedent already a context fact — so the existential is DERIVED first,
	// splicing the instance's own proof block and one ax-mp
	insts = mizEmitDrvInsts(recDrv,
		arrayPush(map(ctx, \p -> p.first), goal), ^mizEmitShOfRef);
	drvCands = filtermap(insts, \d -> if (d.steps == []) None() else switch (d.form) {
		FolQuant(q, __, __): if (q == "exists")
			Some(MizExCand(d.form, None(), d.steps, d.refs, d.disjs)) else None();
		FolBin(op, a, c): {
			isEx = switch (c) {
				FolQuant(q2, __, __): q2 == "exists";
				default: false;
			};
			if (op != "imp" || !isEx) None()
			else switch (find(ctx, \p -> p.first == a)) {
				None(): None();
				Some(pa): {
					k = length(d.refs);
					mp = FolPStep(c, "ax-mp",
						[FolPRefFact(k), FolPRefStep(length(d.steps) - 1)]);
					Some(MizExCand(c, None(), arrayPush(d.steps, mp),
						arrayPush(d.refs, pa.second), d.disjs));
				}
			}
		}
		default: None();
	});
	if (^mizEmitDbg && (ctxCands != [] || drvCands != []))
		println("  EXELIM ctx=" + i2s(length(filter(ctxCands, \c -> switch (c.form) {
				FolQuant(q, __, __): q == "exists"; default: false; })))
			+ " drv=" + i2s(length(drvCands)) + " insts=" + i2s(length(insts))
			+ " :: " + strGlue(folFormToks(goal), " "));
	othersOf = \cand : MizExCand -> concat(
		filtermap(ctx, \p -> if (p.first == cand.form) None() else Some(p.first)), [goal]);
	fold(concat(ctxCands, drvCands), failed, \acc : Pair<Maybe<FolStepProof>, bool>, cand ->
		switch (acc.first) {
			Some(__): acc;
			None(): switch (cand.form) {
				FolQuant(q, vs, body): {
					if (q != "exists" || vs == []
						|| exists(vs, \v -> mizEmitFreeIn(v, goal))
						|| exists(vs, \v -> exists(othersOf(cand), \f -> mizEmitFreeIn(v, f)))) acc
					else {
						// ★ THE WITNESS IS NAMED HERE, so here the recorded clause is
						// restated about it: the checker's constant becomes this
						// binder, its instance is rebuilt at those terms, and the
						// binder gets the type its membership gives it.
						ctxF = concat(map(ctx, \p9 -> p9.first), [goal]);
						extra = concatA([
							mizEmitClauseFactsAt(vs[0], ctxF),
							mizEmitEltiAt(vs[0], arrayPush(ctxF, body)),
							mizEmitEigenInsts(concat(hyps, prev), vs[0])]);
						if (^mizEmitDbg && extra != [])
							println("  EXREPLAY " + vs[0] + " facts=" + i2s(length(extra))
								+ " :: " + strGlue(map(extra, \d9 ->
									strGlue(folFormToks(d9.form), " ")), " ;; "));
						sub = mizEmitReduceA(hyps, prev, body, goal, maxFacts, maxSize,
							1, fresh, used, concat(recDrv, extra));
						switch (sub.first) {
							// a failed ∃-attempt keeps the step's ORIGINAL status: this
							// is a last resort, and its budget overruns should not turn
							// an attempted step into a "skipped" one
							None(): acc;
							Some(pr): {
								dj = concatA(map(vs, \v -> {
									vr = toLowerCase(v);
									filtermap(folFormVars(goal),
										\w -> if (w == vr) None() else Some(Pair(vr, w)));
								}));
								// exlimiv per binder, innermost first: (ψ → goal) →
								// (∃b ψ → goal) → (∃a ∃b ψ → goal)
								n = length(vs);
								exs = generate(0, n, \i -> {
									k2 = n - 1 - i;
									FolPStep(FolBin("imp",
										FolQuant("exists", subrange(vs, k2, n - k2), body), goal),
										"exlimiv", [FolPRefStep(length(pr.steps) + i - 1)]);
								});
								exs0 = mapi(exs, \i, e -> if (i > 0) e
									else FolPStep(e.form, e.assertion, [FolPRefStep(length(pr.steps) - 1)]));
								// the ∃ fact itself: cited (context) or derived (block)
								n1 = length(pr.steps) + n;
								kf = length(pr.factRefs);
								last = switch (cand.ref) {
									Some(r): Pair([FolPStep(goal, "ax-mp",
										[FolPRefFact(kf), FolPRefStep(n1 - 1)])], [r]);
									None(): {
										bs = mizEmitShift(cand.steps, n1, kf);
										Pair(arrayPush(bs, FolPStep(goal, "ax-mp",
											[FolPRefStep(n1 + length(bs) - 1), FolPRefStep(n1 - 1)])),
											cand.refs);
									}
								};
								Pair(Some(FolStepProof(concatA([pr.steps, exs0, last.first]),
									concat(pr.factRefs, last.second),
									uniq(concatA([pr.disjs, dj, cand.disjs])))), false);
							}
						}
					}
				}
				default: acc;
			}
		});
}

// `asm → A` for a conjunct A of a left-nested assumption, by simpl/simpr/syl;
// the identity case is `id`. Returns the index of the step proving it.
mizEmitProjTo(steps : ref [FolPStep], asm : FolForm, tgt : FolForm) -> Maybe<int> {
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	if (asm == tgt) Some(emit(FolBin("imp", asm, asm), "id", []))
	else switch (asm) {
		FolBin(op, l, r): if (op != "and") None()
			else if (r == tgt) Some(emit(FolBin("imp", asm, r), "simpr", []))
			else if (l == tgt) Some(emit(FolBin("imp", asm, l), "simpl", []))
			else {
				// BOTH branches: the walk descended only into the LEFT conjunct, so
				// a conjunct nested to the right — which is the shape Mizar's own
				// conjunctions have (`A ∧ ( B ∧ C )`) — could not be projected at
				// all, and every channel that asks for one (the ∃-elimination's
				// antecedent among them) failed on it.
				s1 = emit(FolBin("imp", asm, l), "simpl", []);
				byL = switch (mizEmitProjTo(steps, l, tgt)) {
					None(): None();
					Some(s2): Some(emit(FolBin("imp", asm, tgt), "syl",
						[FolPRefStep(s1), FolPRefStep(s2)]));
				};
				switch (byL) {
					Some(__): byL;
					None(): {
						s3 = emit(FolBin("imp", asm, r), "simpr", []);
						switch (mizEmitProjTo(steps, r, tgt)) {
							None(): None();
							Some(s4): Some(emit(FolBin("imp", asm, tgt), "syl",
								[FolPRefStep(s3), FolPRefStep(s4)]));
						}
					}
				}
			}
		default: None();
	}
}

// ∃-elimination under the assumption: prove `(asm ∧ ψ) → goal`, curry (ex),
// exlimdv per binder — its disjointness (binder apart from asm AND goal) is
// the no-escape rule — then supply `∃ā ψ`: a context fact by mpi, a derived
// one whose proof stands alone by mpi on its block, and one whose antecedent
// is a CONJUNCT of the assumption by projection + syl + mpd.
// THE PAIR-MATRIX INSTANCE: an assumption conjunct `⟨u,v⟩ ∈ T` keys the
// pool's guarded matrix facts about T (d8/d10's membership
// characterizations, `G → ∀a∀b (…)`): the guard is discharged by its
// absolute supplier in the pool (`relation-like ((#) R S)` by the
// registration instance), the two binders are eliminated at (u, v), and
// the whole plus its conjunct halves are offered — the forward half
// `⟨u,v⟩ ∈ T → ∃z ψ` is what the ∃-peeler consumes (Mizar's `consider z`),
// the plain halves serve the tableau directly. The 08-13 diagnosis: the
// pair membership is a STRENGTHENED consequence, never an original
// conjunct — so the producer must run on the assumption the sub-proof
// actually receives, not on the one the chain started from.
// equation BRIDGES: for a candidate equation `v = T` — an assumption
// conjunct, or an atom INSIDE a pool fact (`z = x19` lives in d10's
// instantiated matrix and is only derived by the tableau) — and a
// membership the assumption or goal states about v, the congruence walk
// proves `(v = T) → (φ ↔ φ[T/v])` standalone. The tableau cannot rewrite
// inside terms; handed the implication it chains propositionally. Only
// the stated orientation is offered — a flipped antecedent is an atom
// the facts never assert.
mizEmitEqBridgeDrvs(asm : FolForm, goal : FolForm, pool : [MizEmitDrv]) -> [MizEmitDrv] {
	conjs = mizEmitConjuncts(asm, []);
	eqAtoms0 = uniq(concatA(map(concat(conjs, map(pool, \d -> d.form)), \f ->
		filtermap(mizEmitAtomsOf(f, []), \a -> switch (a) {
			FolEq(l, __): switch (l) { FolVar(__): Some(a); default: None(); };
			default: None();
		}))));
	tgts0 : [FolForm] = uniq(concat(
		filtermap(conjs, \c -> switch (c) {
			FolPred(nmT, __): if (nmT == "∈") Some(c) else None();
			default: None();
		}),
		switch (goal) {
			FolPred(nmG, __): if (nmG == "∈") [goal] else [];
			default: [];
		}));
	tgts = if (length(tgts0) > 5) subrange(tgts0, 0, 5) else tgts0;
	// rank: an equation whose variable sits INSIDE a pair argument of a
	// target membership is the witness equation the derivation needs
	// (x926 = x19 for ⟨x18,x926⟩ ∈ x26); plain noise equations from
	// registration instances (x26 = ∅) must not crowd it off the cap
	inPair = \v9 : string -> exists(tgts, \f9 -> switch (f9) {
		FolPred(__, args8): exists(args8, \a8 -> switch (a8) {
			FolApp(fp8, ap8): fp8 == "opair" && exists(ap8, \p8 -> p8 == FolVar(v9));
			default: false;
		});
		default: false;
	});
	score = \eq9 : FolForm -> switch (eq9) {
		FolEq(l9, __): switch (l9) {
			FolVar(v9): if (inPair(v9)) 2 else if (exists(tgts, \f9 -> mizEmitFreeIn(v9, f9))) 1 else 0;
			default: 0;
		};
		default: 0;
	};
	eqRanked = mergeSort(eqAtoms0, \a9, b9 -> score(b9) - score(a9));
	eqAtoms = if (length(eqRanked) > 8) subrange(eqRanked, 0, 8) else eqRanked;
	r = concatA(map(eqAtoms, \eq -> switch (eq) {
		FolEq(lv, t): switch (lv) {
			FolVar(v): {
				direct = filtermap(tgts, \f ->
					if (f == eq || !mizEmitFreeIn(v, f) || mizEmitTermHas(v, t)) None()
					else {
						steps : ref [FolPStep] = ref [];
						dj : ref [Pair<string, string>] = ref [];
						switch (mizEmitWalkT(steps, dj, v, t, f)) {
							None(): None();
							Some(w): Some(MizEmitDrv((^steps)[w.first].form, ^steps, [], ^dj));
						}
					});
				// for a var=var equation the facts may state the WRONG
				// orientation for a target (d10 gives x18 = x926 while the
				// membership speaks of x926): compose the flip through
				// eqcom + biimpi + syl, so the antecedent stays the atom
				// AS THE FACTS STATE IT
				flipped = switch (t) {
					FolVar(w2): filtermap(tgts, \f ->
						if (!mizEmitFreeIn(w2, f) || mizEmitFreeIn(v, f)) None()
						else {
							steps : ref [FolPStep] = ref [];
							dj : ref [Pair<string, string>] = ref [];
							switch (mizEmitWalkT(steps, dj, w2, FolVar(v), f)) {
								None(): None();
								Some(w): {
									rev = FolEq(FolVar(w2), FolVar(v));
									e1 = FolPStep(FolBin("iff", eq, rev), "eqcom", []);
									steps := arrayPush(^steps, e1);
									i1 = length(^steps) - 1;
									steps := arrayPush(^steps, FolPStep(FolBin("imp", eq, rev),
										"biimpi", [FolPRefStep(i1)]));
									i2 = length(^steps) - 1;
									fin = FolBin("imp", eq, switch ((^steps)[w.first].form) {
										FolBin(__, __, cq): cq;
										default: (^steps)[w.first].form;
									});
									steps := arrayPush(^steps, FolPStep(fin, "syl",
										[FolPRefStep(i2), FolPRefStep(w.first)]));
									Some(MizEmitDrv(fin, ^steps, [], ^dj));
								}
							}
						});
					default: [];
				};
				concat(direct, flipped);
			}
			default: [];
		}
		default: [];
	}));
	if (^mizEmitDbg && getUrlParameterDef("dbg-exelim", "") == "1" && r != [])
		println("  EQB n=" + i2s(length(r)) + " :: "
			+ strGlue(map(r, \d3 -> strGlue(folFormToks(d3.form), " ")), " | "));
	r;
}

mizEmitPairMatrixDrvs(asm : FolForm, pool : [MizEmitDrv],
	shOf : (string) -> string) -> [MizEmitDrv] {
	pairs = filtermap(mizEmitConjuncts(asm, []), \c -> switch (c) {
		FolPred(nm9, args9): if (nm9 != "∈" || length(args9) != 2) None()
			else switch (args9[0]) {
				FolApp(fp9, ap9): if (fp9 == "opair" && length(ap9) == 2)
					Some(ap9) else None();
				default: None();
			};
		default: None();
	});
	dbgP = ^mizEmitDbg && getUrlParameterDef("dbg-exelim", "") == "1";
	if (dbgP && pairs != []) {
		imp2c = filtermap(pool, \d -> switch (d.form) {
			FolBin(op8, g8, x8): if (op8 != "imp" || d.steps == []) None()
				else if (length((mizEmitPrefixOf(x8, [])).first) != 2) None()
				else Some(isSome(find(pool, \d2 -> d2.form == g8 && d2.steps != [])));
			default: None();
		});
		println("  PMX? pairs=" + i2s(length(pairs)) + " imp2=" + i2s(length(imp2c))
			+ " guarded=" + i2s(length(filter(imp2c, \b -> b)))
			+ " poolforms= " + strGlue(map(pool, \d3 ->
				strGlue(folFormToks(d3.form), " ")), " | "));
	}
	r = if (pairs == []) [] else concatA(map(pool, \d -> switch (d.form) {
		FolBin(op9, g9, x9): if (op9 != "imp" || d.steps == []) [] else
			switch (find(pool, \d2 -> d2.form == g9 && d2.steps != [])) {
				// no ABSOLUTE supplier for the guard (`relation-like x26` is
				// an assumption conjunct, not a registration): produce the
				// instance in GUARDED form — `g → M[u,v]` and its guarded
				// halves are still standalone blocks, and the proof
				// discharges g from the assumption propositionally
				None(): mizEmitPairMatrixGuarded(d, g9, x9, pairs, shOf);
				Some(dg): {
					bnd = mizEmitPrefixOf(x9, []);
					if (length(bnd.first) != 2) [] else concatA(map(pairs, \pm -> {
						steps : ref [FolPStep] = ref d.steps;
						dj : ref [Pair<string, string>] = ref d.disjs;
						b9 = length(^steps);
						steps := concat(^steps, mizEmitShift(dg.steps, b9, length(d.refs)));
						mp9 = {
							steps := arrayPush(^steps, FolPStep(x9, "ax-mp",
								[FolPRefStep(length(^steps) - 1), FolPRefStep(length(d.steps) - 1)]));
							length(^steps) - 1;
						};
						r0 = fold([Pair(bnd.first[0], pm[0]), Pair(bnd.first[1], pm[1])],
							Some(Pair(x9, mp9)), \ac : Maybe<Pair<FolForm, int>>, wp -> switch (ac) {
								None(): None();
								Some(st): mizEmitElimAt(steps, dj, st.first, st.second,
									wp.first, wp.second, shOf, 0);
							});
						switch (r0) {
							None(): [];
							Some(fin): {
								rfs = concat(d.refs, dg.refs);
								djs = uniq(concat(^dj, dg.disjs));
								whole = MizEmitDrv(fin.first, ^steps, rfs, djs);
								halves = switch (fin.first) {
									FolBin(opH, __, __): if (opH != "and") [] else
										concatA(map(["simpl", "simpr"], \hop -> {
											st2 : ref [FolPStep] = ref ^steps;
											switch (mizEmitApplyOps(st2, fin.first, fin.second, [hop])) {
												None(): [];
												Some(pr2): [MizEmitDrv(pr2.first, ^st2, rfs, djs)];
											}
										}));
									default: [];
								};
								concat([whole], halves);
							}
						}
					}));
				}
			}
		default: [];
	}));
	// pre-discharge REFLEXIVE guards: a half `g → ((t=t) → C)` (d10's
	// diagonal instance) forces the tableau through the opaque `t=t` atom
	// and an eqid fact two hops from the goal — offer `g → C` directly
	rr = concat(r, concatA(map(r, \d3 -> switch (d3.form) {
		FolBin(op8, g8, c8): if (op8 != "imp") [] else switch (c8) {
			FolBin(op7, e7, c7): if (op7 != "imp") [] else switch (e7) {
				FolEq(l7, r7): if (l7 != r7) [] else {
					st3 : ref [FolPStep] = ref d3.steps;
					em3 = \f3 : FolForm, lm3 : string, rs3 : [FolPRef] -> {
						st3 := arrayPush(^st3, FolPStep(f3, lm3, rs3));
						length(^st3) - 1;
					};
					e3 = em3(e7, "eqid", []);
					f3 = em3(FolBin("imp", g8, c7), "mpi",
						[FolPRefStep(e3), FolPRefStep(length(d3.steps) - 1)]);
					[MizEmitDrv(FolBin("imp", g8, c7), ^st3, d3.refs, d3.disjs)];
				}
				default: [];
			};
			default: [];
		};
		default: [];
	})));
	if (^mizEmitDbg && getUrlParameterDef("dbg-exelim", "") == "1" && rr != [])
		println("  PMX n=" + i2s(length(rr)) + " :: "
			+ strGlue(map(rr, \d3 -> strGlue(folFormToks(d3.form), " ")), " | "));
	rr;
}

// `g → M[u,v]` from a pool block proving `g → ∀a∀b M`: the two instance
// implications (each standalone) composed by syl under the guard, then the
// guarded conjunct halves through simpl/simpr + syl
mizEmitPairMatrixGuarded(d : MizEmitDrv, g9 : FolForm, x9 : FolForm,
	pairs : [[FolTerm]], shOf : (string) -> string) -> [MizEmitDrv] {
	bnd = mizEmitPrefixOf(x9, []);
	if (length(bnd.first) != 2) [] else concatA(map(pairs, \pm -> {
		steps : ref [FolPStep] = ref d.steps;
		dj : ref [Pair<string, string>] = ref d.disjs;
		dIdx = length(d.steps) - 1;              // |- g → ∀a∀b M
		emit = \form : FolForm, lemma : string, rs : [FolPRef] -> {
			steps := arrayPush(^steps, FolPStep(form, lemma, rs));
			length(^steps) - 1;
		};
		switch (mizEmitInstImp(steps, dj, x9, bnd.first[0], pm[0], shOf, 0)) {
			None(): [];
			Some(i1): switch (mizEmitInstImp(steps, dj, i1.second, bnd.first[1], pm[1], shOf, 0)) {
				None(): [];
				Some(i2): {
					s1 = emit(FolBin("imp", x9, i2.second), "syl",
						[FolPRefStep(i1.first), FolPRefStep(i2.first)]);
					gi = emit(FolBin("imp", g9, i2.second), "syl",
						[FolPRefStep(dIdx), FolPRefStep(s1)]);
					whole = MizEmitDrv(FolBin("imp", g9, i2.second), ^steps, d.refs, uniq(^dj));
					halves = switch (i2.second) {
						FolBin(opH, hA, hB): if (opH != "and") [] else
							concatA(map([Pair(hA, "simpl"), Pair(hB, "simpr")], \ph -> {
								st2 : ref [FolPStep] = ref ^steps;
								em2 = \form : FolForm, lemma : string, rs : [FolPRef] -> {
									st2 := arrayPush(^st2, FolPStep(form, lemma, rs));
									length(^st2) - 1;
								};
								p1 = em2(FolBin("imp", i2.second, ph.first), ph.second, []);
								p2 = em2(FolBin("imp", g9, ph.first), "syl",
									[FolPRefStep(gi), FolPRefStep(p1)]);
								[MizEmitDrv(FolBin("imp", g9, ph.first), ^st2, d.refs, uniq(^dj))];
							}));
						default: [];
					};
					concat([whole], halves);
				}
			}
		}
	}));
}

mizEmitExElimA(hyps : [FolForm], prev : [FolForm], asm : FolForm, goal : FolForm,
	maxFacts : int, maxSize : int, depth : int, fresh : ref int, used : Set<string>,
	recDrv : [MizEmitDrv], failed : Pair<Maybe<FolStepProof>, bool>) -> Pair<Maybe<FolStepProof>, bool> {
	ctx = concat(
		mapi(hyps, \j, h -> Pair(h, mizEmitHypRef(j))),
		mapi(prev, \j, sp -> Pair(sp, mizEmitStepRef(j))));
	insts = mizEmitDrvInsts(recDrv,
		concat(map(ctx, \p -> p.first), [asm, goal]), ^mizEmitShOfRef);
	// candidates: (∃ form, how to supply it: Left = ctx ref, Right = (block, refs,
	// disjs, antecedent conjunct or None for an outright block))
	ctxCands = filtermap(ctx, \p -> switch (p.first) {
		FolQuant(q, __, __): if (q == "exists") Some(MizExCand(p.first, Some(p.second), [], [], [])) else None();
		default: None();
	});
	drvCands = filtermap(insts, \d -> if (d.steps == []) None() else switch (d.form) {
		FolQuant(q, __, __): if (q == "exists")
			Some(MizExCand(d.form, None(), d.steps, d.refs, d.disjs)) else None();
		FolBin(op, a, c): {
			isEx = switch (c) { FolQuant(q2, __, __): q2 == "exists"; default: false; };
			// the antecedent must be reachable: a context fact (ax-mp now) or a
			// conjunct of the assumption (projection later) — encode the latter by
			// keeping the implication whole and remembering `a`
			if (op != "imp" || !isEx) None()
			else switch (find(ctx, \p -> p.first == a)) {
				Some(pa): {
					k = length(d.refs);
					mp = FolPStep(c, "ax-mp", [FolPRefFact(k), FolPRefStep(length(d.steps) - 1)]);
					Some(MizExCand(c, None(), arrayPush(d.steps, mp),
						arrayPush(d.refs, pa.second), d.disjs));
				}
				None(): {
					pr : ref [FolPStep] = ref [];
					switch (mizEmitProjTo(pr, asm, a)) {
						None(): None();
						Some(__): Some(MizExCand(d.form, None(), d.steps, d.refs, d.disjs));
					}
				}
			}
		}
		default: None();
	});
	if (^mizEmitDbg && getUrlParameterDef("dbg-exelim", "") == "1")
		println("  EXELIM d" + i2s(depth)
			+ " ctx-ex=" + i2s(length(ctxCands)) + " drv-ex=" + i2s(length(drvCands))
			+ " insts=" + i2s(length(insts))
			+ " asm= " + strGlue(folFormToks(asm), " ")
			+ " goal= " + strGlue(folFormToks(goal), " ")
			+ "\n    insts:: " + strGlue(map(insts, \d9 ->
				strGlue(folFormToks(d9.form), " ")), " ;; "));
	r1 = fold(concat(ctxCands, drvCands), failed, \acc : Pair<Maybe<FolStepProof>, bool>, cand -> switch (acc.first) {
		Some(__): acc;
		None(): {
			// the ∃ this candidate yields (an imp-shaped one is peeled below)
			exf = switch (cand.form) {
				FolBin(__, __, c2): c2;
				default: cand.form;
			};
			switch (exf) {
				FolQuant(q, vs, body): {
					bad = \v : string -> mizEmitFreeIn(v, goal) || mizEmitFreeIn(v, asm)
						|| exists(map(ctx, \p -> p.first), \f -> mizEmitFreeIn(v, f));
					if (q != "exists" || vs == [] || exists(vs, bad)) acc
					else {
						// the eliminated body's own pair memberships key the
						// matrix instances the sub-proof will need (d10 at the
						// inner witness) — produce on the ENRICHED assumption
						asmE = FolBin("and", asm, body);
						pmxE = mizEmitPairMatrixDrvs(asmE, recDrv, ^mizEmitShOfRef);
						// ★ THE REPLAY'S LAST LINK. The witness has just been named,
						// so the checker's own clause is restated about it: its
						// constant becomes this binder, the recorded instance is
						// rebuilt at those terms, and the binder gets the type its
						// membership gives it. Mizar's endgame then has its premises.
						ctxF9 = concat(map(ctx, \p9 -> p9.first), [asm, goal]);
						cfE = mizEmitClauseFactsAt(vs[0], ctxF9);
						repE = concatA([
							cfE,
							mizEmitEltiAt(vs[0], concat(arrayPush(ctxF9, body),
								map(cfE, \d9 -> d9.form))),
							mizEmitEigenInsts(concatA([[asm], mizEmitConjuncts(asm, []),
								hyps, prev]), vs[0])]);
						if (^mizEmitDbg && repE != [])
							println("  EXREPLAY-A " + vs[0] + " facts=" + i2s(length(repE))
								+ " :: " + strGlue(map(repE, \d9 ->
									strGlue(folFormToks(d9.form), " ")), " ;; "));
						poolE = concatA([recDrv, pmxE, repE]);
						eqbE = mizEmitEqBridgeDrvs(asmE, goal, poolE);
						sub = mizEmitReduceA0(hyps, prev, asmE, goal,
							maxFacts, maxSize, depth + 2, fresh, used, concat(poolE, eqbE));
						switch (sub.first) {
							None(): acc;
							Some(pr): {
								steps : ref [FolPStep] = ref pr.steps;
								refs : ref [RuParseRef] = ref pr.factRefs;
								emit = \form : FolForm, lemma : string, rs : [FolPRef] -> {
									steps := arrayPush(^steps, FolPStep(form, lemma, rs));
									length(^steps) - 1;
								};
								cur = emit(FolBin("imp", asm, FolBin("imp", body, goal)), "ex",
									[FolPRefStep(length(pr.steps) - 1)]);
								n = length(vs);
								exl = fold(enumFromTo(1, n), cur, \st, i -> {
									k2 = n - i;
									emit(FolBin("imp", asm, FolBin("imp",
										FolQuant("exists", subrange(vs, k2, n - k2), body), goal)),
										"exlimdv", [FolPRefStep(st)]);
								});
								dj = concatA(map(vs, \v -> {
									vr = toLowerCase(v);
									filtermap(uniq(concat(folFormVars(goal), folFormVars(asm))),
										\w -> if (w == vr) None() else Some(Pair(vr, w)));
								}));
								fin = switch (cand.ref) {
									Some(r): {
										k = length(^refs);
										refs := arrayPush(^refs, r);
										Some(emit(FolBin("imp", asm, goal), "mpi",
											[FolPRefFact(k), FolPRefStep(exl)]));
									}
									None(): {
										base = length(^steps);
										kf = length(^refs);
										steps := concat(^steps, mizEmitShift(cand.steps, base, kf));
										refs := concat(^refs, cand.refs);
										blockLast = length(^steps) - 1;
										if (cand.form == exf)
											// the block proves ∃ā ψ outright
											Some(emit(FolBin("imp", asm, goal), "mpi",
												[FolPRefStep(blockLast), FolPRefStep(exl)]))
										else switch (cand.form) {
											FolBin(__, a2, __): switch (mizEmitProjTo(steps, asm, a2)) {
												None(): None();
												Some(pj): {
													sy = emit(FolBin("imp", asm, exf), "syl",
														[FolPRefStep(pj), FolPRefStep(blockLast)]);
													Some(emit(FolBin("imp", asm, goal), "mpd",
														[FolPRefStep(sy), FolPRefStep(exl)]));
												}
											}
											default: None();
										}
									}
								};
								switch (fin) {
									None(): acc;
									Some(__): Pair(Some(FolStepProof(^steps, ^refs,
										uniq(concatA([pr.disjs, dj, cand.disjs])))), false);
								}
							}
						}
					}
				}
				default: acc;
			}
		}
	});
	switch (r1.first) {
		Some(__): r1;
		None(): {
			r2 = mizEmitExChain(hyps, prev, asm, goal, maxFacts, maxSize, depth,
				fresh, used, recDrv, ctx, r1);
			switch (r2.first) {
				Some(__): r2;
				None(): mizEmitExSupplyA(hyps, prev, asm, goal, maxFacts, maxSize,
					depth, fresh, used, recDrv, r2);
			}
		}
	}
}

// ---- GOAL SUPPLY THROUGH AN ∃-IMPLICATION ----
// The pair-matrix BACKWARD half `∃z ψ → ⟨u,v⟩ ∈ f(…)` is membership INTO a
// defined term (Mizar's `then [x,y] in R (#) S`): prove the ∃ under the
// assumption — the witness is COMPUTED by the one-hole match — splice the
// implication, and reach the goal directly or across ONE equation bridge
// `(eq) → (goal ↔ C)` whose eq the assumption projects (mpbird).
mizEmitExSupplyA(hyps : [FolForm], prev : [FolForm], asm : FolForm, goal : FolForm,
	maxFacts : int, maxSize : int, depth : int, fresh : ref int, used : Set<string>,
	recDrv : [MizEmitDrv], failed : Pair<Maybe<FolStepProof>, bool>) -> Pair<Maybe<FolStepProof>, bool> {
	dbgS = ^mizEmitDbg && getUrlParameterDef("dbg-exelim", "") == "1";
	// candidate implications: ∃-shaped antecedent, consequent linked to the
	// goal — equal to it, or bridged by an eq-bridge fact of the pool
	cands = filtermap(recDrv, \d -> if (d.steps == []) None() else switch (d.form) {
		FolBin(op9, e9, c9): if (op9 != "imp") None() else switch (e9) {
			FolQuant(q9, __, __): if (q9 != "exists") None()
				else if (c9 == goal) Some(Pair(d, None()))
				else switch (find(recDrv, \b -> b.steps != [] && switch (b.form) {
					FolBin(opB, __, iffB): opB == "imp" && switch (iffB) {
						FolBin(opI, gl, cc): opI == "iff" && gl == goal && cc == c9;
						default: false;
					};
					default: false;
				})) {
					Some(br): Some(Pair(d, Some(br)));
					None(): None();
				};
			default: None();
		};
		default: None();
	});
	capped = if (length(cands) > 3) subrange(cands, 0, 3) else cands;
	if (dbgS && capped != [])
		println("  EXSUP n=" + i2s(length(capped)) + " :: "
			+ strGlue(map(capped, \p9 -> strGlue(folFormToks(p9.first.form), " ")), " | "));
	fold(capped, failed, \acc : Pair<Maybe<FolStepProof>, bool>, cand -> switch (acc.first) {
		Some(__): acc;
		None(): switch (cand.first.form) {
			FolBin(__, exE, cC): switch (exE) {
				FolQuant(__, vsE, bodyE): {
					// the witness-substituted body's own pair memberships key
					// the DIAGONAL matrix instances (`⟨u,u⟩ ∈ id T`) the
					// sub-proof needs and the caller's producer never saw
					pmxS = mizEmitPairMatrixDrvs(bodyE, recDrv, ^mizEmitShOfRef);
					sub = mizEmitExGoalA(hyps, prev, asm, exE, vsE, bodyE,
						maxFacts, maxSize, depth + 1, fresh, used,
						Pair(None(), false), concat(recDrv, pmxS));
					switch (sub.first) {
						None(): acc;
						Some(pr): {
							steps : ref [FolPStep] = ref pr.steps;
							refs : ref [RuParseRef] = ref pr.factRefs;
							dj : ref [Pair<string, string>] = ref pr.disjs;
							exIdx = length(pr.steps) - 1;   // asm → ∃ψ
							emit = \form : FolForm, lemma : string, rs : [FolPRef] -> {
								steps := arrayPush(^steps, FolPStep(form, lemma, rs));
								length(^steps) - 1;
							};
							b0 = length(^steps);
							k0 = length(^refs);
							steps := concat(^steps, mizEmitShift(cand.first.steps, b0, k0));
							refs := concat(^refs, cand.first.refs);
							dj := concat(^dj, cand.first.disjs);
							bC = length(^steps) - 1;        // |- ∃ψ → C
							c1 = emit(FolBin("imp", asm, cC), "syl",
								[FolPRefStep(exIdx), FolPRefStep(bC)]);
							switch (cand.second) {
								None(): {
									if (dbgS) println("  EXSUP ok direct");
									Pair(Some(FolStepProof(^steps, ^refs, uniq(^dj))), false);
								}
								Some(br): switch (br.form) {
									FolBin(__, eqF, iffF): {
										switch (mizEmitProjTo(steps, asm, eqF)) {
											None(): acc;
											Some(pe): {
												b1 = length(^steps);
												k1 = length(^refs);
												steps := concat(^steps, mizEmitShift(br.steps, b1, k1));
												refs := concat(^refs, br.refs);
												dj := concat(^dj, br.disjs);
												bB = length(^steps) - 1;   // |- eq → (goal ↔ C)
												s2 = emit(FolBin("imp", asm, iffF), "syl",
													[FolPRefStep(pe), FolPRefStep(bB)]);
												fin = emit(FolBin("imp", asm, goal), "mpbird",
													[FolPRefStep(c1), FolPRefStep(s2)]);
												if (dbgS) println("  EXSUP ok bridged");
												Pair(Some(FolStepProof(^steps, ^refs, uniq(^dj))), false);
											}
										}
									}
									default: acc;
								}
							}
						}
					}
				}
				default: acc;
			}
			default: acc;
		}
	});
}

// ---- THE FIRST LINK: the assumed atom's own definition ----
// The record never names the definition of an ASSUMED attribute (relation-hood
// arrives through the type channel, unattributed), so the candidate is built
// from the assumption itself: for an atom `v1_relat_1 X` of the assumption,
// the definitions of that head predicate give `P ↔ ∀x (B → ∃ψ)`; with P and
// B[e] both conjuncts of the assumption, the existential is reached under it:
//   biimpi, projTo(P) + syl        asm → ∀x (B → ∃ψ)
//   instance implication + syl     asm → (B[e] → ∃ψ[e])
//   projTo(B[e]) + mpd             asm → ∃ψ[e]
//   ex / exlimdv per binder / mpd  asm → goal
mizEmitExChain(hyps : [FolForm], prev : [FolForm], asm : FolForm, goal : FolForm,
	maxFacts : int, maxSize : int, depth : int, fresh : ref int, used : Set<string>,
	recDrv : [MizEmitDrv], ctx : [Pair<FolForm, RuParseRef>],
	failed : Pair<Maybe<FolStepProof>, bool>) -> Pair<Maybe<FolStepProof>, bool> {
	stmtOf = ^mizEmitStmtOfRef;
	defsOf = ^mizEmitDefsOfSymRef;
	shOf = ^mizEmitShOfRef;
	allAtoms = uniq(concatA(map(concat(map(ctx, \p -> p.first), [asm, goal]),
		\f -> mizEmitAtomsOf(f, []))));
	heads = uniq(filtermap(mizEmitAtomsOf(asm, []), \a -> switch (a) {
		FolPred(h, __): if (mizEmitIsArticleSym(h)) Some(h) else None();
		default: None();
	}));
	// SYNTHETIC TARGETS: the head predicate applied to each membership
	// CONTAINER — `x ∈ (#) R S` wants d1 instantiated AT THE COMPOSITION
	// (`relation-like ((#) R S) → …`), and that atom occurs nowhere in the
	// step; the guard is discharged absolutely (ct4/ct6) at the chain's
	// first link
	memConts0 = uniq(filtermap(allAtoms, \a -> switch (a) {
		FolPred(nmM, argsM): if (nmM != "∈" || length(argsM) != 2) None()
			else switch (argsM[1]) {
				FolApp(__, __): Some(argsM[1]);
				default: None();
			};
		default: None();
	}));
	memConts = if (length(memConts0) > 4) subrange(memConts0, 0, 4) else memConts0;
	cands0 = concatA(map(heads, \h -> {
		ds0 = defsOf(h);
		ds = if (length(ds0) > 2) subrange(ds0, 0, 2) else ds0;
		// the matcher keeps its first hit, so each synthetic target gets its
		// own instantiation call
		concat(
			filtermap(ds, \nm -> mizEmitDefInstance(nm, h, allAtoms, stmtOf, shOf)),
			concatA(map(memConts, \tC -> filtermap(ds, \nm ->
				mizEmitDefInstance(nm, h, [FolPred(h, [tC])], stmtOf, shOf)))));
	}));
	// normalize each instance (the checker's ¬∧∀ shape → implications and ∃,
	// by mizEmitQNF + mpbi) and keep the implication halves `P → ∀v (B → ∃ψ)`
	// with P a conjunct of the assumption — each as a STANDALONE block
	conjs = mizEmitConjuncts(asm, []);
	// pp need NOT be an assumption conjunct: an absolutely provable guard
	// (`relation-like ((#) R S)` by ct4) is discharged at the chain's first
	// link — projTo, else the unguarded-axiom instance + a1i
	shaped = \form : FolForm -> switch (form) {
		FolBin(op0, pp, qq): if (op0 != "imp") None()
			else switch (qq) {
				FolQuant(q, vs, b): if (q == "forall" && length(vs) == 1) switch (b) {
					FolBin(op2, bb, ee): if (op2 == "imp") switch (ee) {
						FolQuant(q2, __, __): if (q2 == "exists") Some(Triple(pp, qq, vs[0])) else None();
						default: None();
					} else None();
					default: None();
				} else None();
				default: None();
			}
		default: None();
	};
	cands = concatA(map(cands0, \cand -> if (cand.steps == []) [] else {
		steps : ref [FolPStep] = ref cand.steps;
		emit = \form : FolForm, lemma : string, rs : [FolPRef] -> {
			steps := arrayPush(^steps, FolPStep(form, lemma, rs));
			length(^steps) - 1;
		};
		blockLast = length(^steps) - 1;
		nm = switch (mizEmitQNF(steps, cand.form, 0)) {
			None(): Pair(blockLast, cand.form);
			Some(w): Pair(emit(w.second, "mpbi", [FolPRefStep(blockLast), FolPRefStep(w.first)]), w.second);
		};
		// each conjunct half in turn (simpl / simpr through mizEmitApplyOps)
		halves = switch (nm.second) {
			FolBin(opH, __, __): if (opH == "and") ["simpl", "simpr"] else [""];
			default: [""];
		};
		filtermap(halves, \hop -> {
			st2 : ref [FolPStep] = ref ^steps;
			fin = if (hop == "") Some(Pair(nm.second, nm.first))
				else mizEmitApplyOps(st2, nm.second, nm.first, [hop]);
			switch (fin) {
				None(): None();
				Some(pr2): switch (shaped(pr2.first)) {
					None(): None();
					Some(tr): Some(Pair(MizEmitDrv(pr2.first, ^st2, cand.refs, cand.disjs), tr));
				}
			}
		});
	}));
	if (^mizEmitDbg)
		println("  EXCHAIN heads=" + strGlue(heads, ",") + " raw=" + i2s(length(cands0))
			+ " shaped=" + i2s(length(cands)) + " asm=" + strGlue(folFormToks(asm), " "));
	fold(cands, failed, \acc : Pair<Maybe<FolStepProof>, bool>, cp -> switch (acc.first) {
		Some(__): acc;
		None(): {
			pp = cp.second.first; qq = cp.second.second; v = cp.second.third;
			bb = switch (qq) {
				FolQuant(__, __, b2): switch (b2) {
					FolBin(__, l2, __): l2;
					default: b2;
				}
				default: qq;
			};
			// the element: match B against a conjunct of the assumption
			es = uniq(filtermap(conjs, \c ->
				switch (mizEmitMatchF(bb, c, makeSet1(v), Some(makeTree()))) {
					None(): None();
					Some(sub): lookupTree(sub, v);
				}));
			fold(es, acc, \a2 : Pair<Maybe<FolStepProof>, bool>, e -> switch (a2.first) {
				Some(__): a2;
				None(): mizEmitExChainAt(hyps, prev, asm, goal, maxFacts, maxSize,
					depth, fresh, used, recDrv, cp.first, pp, qq, v, e, shOf, a2);
			});
		}
	});
}

// collect a nested single-binder ∃ prefix into one binder list
mizEmitExFlatten(f : FolForm) -> Pair<[string], FolForm> {
	switch (f) {
		FolQuant(q, vs, b): if (q != "exists") Pair([], f) else {
			inner = mizEmitExFlatten(b);
			Pair(concat(vs, inner.first), inner.second);
		}
		default: Pair([], f);
	}
}

// ---- STRENGTHENING THE ASSUMPTION ----
// The chain's sub-proof runs from `asm ∧ x = ⟨a,b⟩`, but what it NEEDS are
// consequences of that: `⟨a,b⟩ ∈ X` (the equation moved into the membership)
// and `a ∈ proj1 X` (a definition with an ∃ body, introduced at the other
// component). Both are derivable under the assumption with machinery that
// exists — but they arise inside the tableau, where no ∃ step can happen. So
// they are derived FIRST, each as `asmB → c`, and the sub-proof runs from the
// strengthened conjunction. Appends proofs to the shared refs; returns the
// consequences with the step index proving each.
mizEmitStrengthen(hyps : [FolForm], prev : [FolForm], asmB : FolForm, goal : FolForm,
	maxFacts : int, maxSize : int, depth : int, fresh : ref int, used : Set<string>,
	recDrv : [MizEmitDrv], steps : ref [FolPStep], refs : ref [RuParseRef],
	dj : ref [Pair<string, string>], shOf : (string) -> string) -> [Pair<FolForm, int>] {
	emit = \form : FolForm, lemma : string, rs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, rs));
		length(^steps) - 1;
	};
	conjs = mizEmitConjuncts(asmB, []);
	// round 1 — the equation moved into the membership: conjuncts `x = t` and
	// `x ∈ T` give `t ∈ T` by eleq1 + syl + mpbid
	r1 = concatA(map(conjs, \c -> switch (c) {
		FolEq(l, t): switch (l) {
			FolVar(__): filtermap(conjs, \c2 -> switch (c2) {
				FolPred(nm, args): if (nm != "∈" || length(args) != 2 || args[0] != l) None()
					else {
						tgt = mizEmitMem(t, args[1]);
						el = emit(FolBin("imp", c, FolBin("iff", c2, tgt)), "eleq1", []);
						switch (mizEmitProjTo(steps, asmB, c)) {
							None(): None();
							Some(p1): {
								s1 = emit(FolBin("imp", asmB, FolBin("iff", c2, tgt)), "syl",
									[FolPRefStep(p1), FolPRefStep(el)]);
								switch (mizEmitProjTo(steps, asmB, c2)) {
									None(): None();
									Some(p2): Some(Pair(tgt, emit(FolBin("imp", asmB, tgt), "mpbid",
										[FolPRefStep(p2), FolPRefStep(s1)])));
								}
							}
						}
					}
				default: None();
			});
			default: [];
		}
		default: [];
	}));
	if (^mizEmitDbg)
		println("    STR r1=" + i2s(length(r1)) + " conjs="
			+ strGlue(map(conjs, \c2 -> strGlue(folFormToks(c2), " ")), " | "));
	// round 2 — membership by an ∃-bodied definition: for a goal-term symbol f
	// with normalized instance `∀z (z ∈ f(ā) ↔ ∃y ψ)`, and an element a of the
	// assumption, prove `a ∈ f(ā)`: instance at a, biimpri, and the ∃ proved
	// under the round-1-strengthened assumption by the ∃-goal machinery
	asm1 = fold(r1, asmB, \ac, pr -> FolBin("and", ac, pr.first));
	// asmB → asm1 (id + jca over the round-1 consequences)
	asm1idx = if (r1 == []) -1 else {
		i0 = emit(FolBin("imp", asmB, asmB), "id", []);
		(fold(r1, Pair(i0, asmB), \ac : Pair<int, FolForm>, pr -> {
			nf = FolBin("and", ac.second, pr.first);
			Pair(emit(FolBin("imp", asmB, nf), "jca",
				[FolPRefStep(ac.first), FolPRefStep(pr.second)]), nf);
		})).first;
	};
	stmtOf = ^mizEmitStmtOfRef;
	defsOf = ^mizEmitDefsOfSymRef;
	gAtoms = uniq(concatA(map([goal, asm1], \gf -> mizEmitAtomsOf(gf, []))));
	gSyms = uniq(concatA(map(mizEmitAtomsOf(goal, []), mizFormSymbols)));
	// the index maps a symbol to every statement MENTIONING it; keep only an
	// instance that DEFINES it — `∀z (z ∈ sy(…) ↔ …)` after normalization
	memOf = \f5 : FolForm, sy : string -> switch (f5) {
		FolPred(nm4, args4): nm4 == "∈" && length(args4) == 2
			&& mizEmitTermHasSym(args4[1], sy);
		default: false;
	};
	defines = \d2 : MizEmitDrv, sy : string -> switch (d2.form) {
		FolQuant(q4, vs4, b4): if (q4 != "forall" || length(vs4) != 1) false else switch (b4) {
			// `z∈f ↔ …` or the normalizer's `(z∈f → E) ∧ (E → z∈f)`
			FolBin(op4, l4, r4): if (op4 == "iff") memOf(l4, sy)
				else if (op4 == "and") switch (r4) {
					FolBin(op5, __, m5): op5 == "imp" && memOf(m5, sy);
					default: false;
				} else false;
			default: false;
		}
		default: false;
	};
	defs = concatA(map(gSyms, \sy -> {
		ds = defsOf(sy);
		// instantiate up to six and let the DEFINES filter choose — the entry
		// that defines a symbol can sit behind several that merely mention it
		raw = filtermap(if (length(ds) > 6) subrange(ds, 0, 6) else ds,
			\nm2 -> maybeMap(mizEmitDefInstance(nm2, sy, gAtoms, stmtOf, shOf), mizEmitCleanIff));
		if (^mizEmitDbg)
			println("    STR-DEF " + sy + " ds=" + strGlue(if (length(ds) > 3) subrange(ds, 0, 3) else ds, ",")
				+ " inst=" + strGlue(map(raw, \d2 -> strGlue(folFormToks(d2.form), " ")), " | "));
		filter(raw, \d2 -> defines(d2, sy));
	}));
	elems = uniq(filtermap(concatA(map(conjs, \c -> folFormVars(c))), \v -> Some(v)));
	if (^mizEmitDbg)
		println("    STR syms=" + strGlue(gSyms, ",") + " defs=" + i2s(length(defs))
			+ " forms=" + strGlue(map(defs,
				\d2 -> strGlue(folFormToks(d2.form), " ")), " | "));
	r2 = concatA(map(defs, \d -> if (d.steps == []) [] else switch (d.form) {
		FolQuant(q0, vs0, b0): if (q0 != "forall" || length(vs0) != 1) [] else {
			z = vs0[0];
			filtermap(if (length(elems) > 4) subrange(elems, 0, 4) else elems, \a -> {
				s0 = ^steps; r0 = ^refs; d0 = ^dj;
				roll = \ -> { steps := s0; refs := r0; dj := d0; None(); };
				// the instance `a ∈ f ↔ ∃y ψ(a)`, standalone
				base = length(^steps);
				kf = length(^refs);
				steps := concat(^steps, mizEmitShift(d.steps, base, kf));
				refs := concat(^refs, d.refs);
				dj := concat(^dj, d.disjs);
				blockLast = length(^steps) - 1;
				switch (mizEmitInstImp(steps, dj, d.form, z, FolVar(a), shOf, 0)) {
					None(): roll();
					Some(im): {
						inst = emit(im.second, "ax-mp", [FolPRefStep(blockLast), FolPRefStep(im.first)]);
						// the instance is `a∈f ↔ ∃yψ` (biimpri) or the normalizer's
						// `(a∈f → E) ∧ (∃yψ → a∈f)` (the second conjunct, by simpr)
						dir = switch (im.second) {
							FolBin(opI, l5, r5): if (opI == "iff") Some(Triple(l5, r5, true))
								else if (opI == "and") switch (r5) {
									FolBin(op6, e6, m6): if (op6 == "imp") Some(Triple(m6, e6, false)) else None();
									default: None();
								} else None();
							default: None();
						};
						switch (dir) {
							Some(tr5): {
								memF = tr5.first;
								exF = tr5.second;
								okEx = switch (exF) { FolQuant(qE, __, __): qE == "exists"; default: false; };
								memOk = switch (memF) { FolPred(nm5, __): nm5 == "∈"; default: false; };
								if (!okEx || !memOk) roll() else {
									bi = if (tr5.third)
											emit(FolBin("imp", exF, memF), "biimpri", [FolPRefStep(inst)])
										else switch (mizEmitApplyOps(steps, im.second, inst, ["simpr"])) {
											None(): -1;
											Some(pr6): pr6.second;
										};
									if (bi < 0) roll() else {
									// the ∃ proved under the strengthened assumption
									sub = switch (exF) {
										FolQuant(__, vsE, bE): mizEmitExGoalA(hyps, prev, asm1, exF,
											vsE, bE, maxFacts, maxSize, depth + 2, fresh, used,
											Pair(None(), false), recDrv);
										default: Pair(None(), false);
									};
									switch (sub.first) {
										None(): roll();
										Some(pe): {
											b2 = length(^steps);
											k2 = length(^refs);
											steps := concat(^steps, mizEmitShift(pe.steps, b2, k2));
											refs := concat(^refs, pe.factRefs);
											dj := concat(^dj, pe.disjs);
											exIdx = length(^steps) - 1;   // asm1 → ∃yψ(a)
											// back to asmB: syl through asmB → asm1
											exB = if (asm1idx < 0) exIdx
												else emit(FolBin("imp", asmB, exF), "syl",
													[FolPRefStep(asm1idx), FolPRefStep(exIdx)]);
											Some(Pair(memF, emit(FolBin("imp", asmB, memF), "syl",
												[FolPRefStep(exB), FolPRefStep(bi)])));
										}
									}
								}
								}
							}
							None(): roll();
						}
					}
				}
			});
		}
		default: [];
	}));
	// round 3 — the ELEMENT BRIDGE (the type layer's membership twin): an asm
	// conjunct `element A Y` is Mizar's silent type fact, and its meaning is
	// membership. The element definition arrives in the pool as the record
	// instance `(Y = ∅) ∨ ((element A Y) ↔ (A ∈ Y))`; when Y is a power class
	// the empty case is refuted by the foundation (pwne0 + neii), the
	// disjunction is eliminated (orel1 + ax-mp), and the membership follows
	// under the assumption by mpbid. A variable member then gets the subset
	// twin `A ⊆ t` by velpw — the fact subset_1's guards actually need.
	empty0 = FolApp("∅", []);
	r3 = concatA(map(conjs, \c -> switch (c) {
		FolPred(nmE, argsE): if (nmE != "element" || length(argsE) != 2) [] else {
			aE = argsE[0];
			yE = argsE[1];
			switch (yE) {
				FolApp(fnY, argsY): if (fnY != "𝒫" || length(argsY) != 1) [] else {
					tY = argsY[0];
					memE = FolPred("∈", [aE, yE]);
					iffE = FolBin("iff", c, memE);
					orE = FolBin("or", FolEq(yE, empty0), iffE);
					d1 = find(recDrv, \d -> d.steps != [] && d.form == orE);
					switch (d1) {
						None(): [];
						Some(dd): {
							base = length(^steps);
							kf = length(^refs);
							steps := concat(^steps, mizEmitShift(dd.steps, base, kf));
							refs := concat(^refs, dd.refs);
							dj := concat(^dj, dd.disjs);
							d1idx = length(^steps) - 1;               // |- (Y=∅) ∨ (elem ↔ mem)
							neS = emit(FolPred("≠", [yE, empty0]), "pwne0", []);
							ngS = emit(FolNeg(FolEq(yE, empty0)), "neii", [FolPRefStep(neS)]);
							o1 = emit(FolBin("imp", FolNeg(FolEq(yE, empty0)),
								FolBin("imp", orE, iffE)), "orel1", []);
							o2 = emit(FolBin("imp", orE, iffE), "ax-mp",
								[FolPRefStep(ngS), FolPRefStep(o1)]);
							iffS = emit(iffE, "ax-mp", [FolPRefStep(d1idx), FolPRefStep(o2)]);
							switch (mizEmitProjTo(steps, asmB, c)) {
								None(): [];
								Some(pc): {
									la = emit(FolBin("imp", asmB, iffE), "a1i", [FolPRefStep(iffS)]);
									m1 = emit(FolBin("imp", asmB, memE), "mpbid",
										[FolPRefStep(pc), FolPRefStep(la)]);
									// the subset twin: a VARIABLE member of a power class
									// (velpw is x∈𝒫A ↔ x⊆A with x,A disjoint — the member
									// must not occur in the power class's argument)
									sub = switch (aE) {
										FolVar(av): if (mizEmitFreeIn(av, FolEq(tY, tY))) [] else {
											ssE = mizEmitSs(aE, tY);
											v1 = emit(FolBin("iff", memE, ssE), "velpw", []);
											lv = emit(FolBin("imp", asmB, FolBin("iff", memE, ssE)),
												"a1i", [FolPRefStep(v1)]);
											[Pair(ssE, emit(FolBin("imp", asmB, ssE), "mpbid",
												[FolPRefStep(m1), FolPRefStep(lv)]))];
										}
										default: [];
									};
									concat([Pair(memE, m1)], sub);
								}
							}
						}
					}
				}
				default: [];
			}
		}
		default: [];
	}));
	if (^mizEmitDbg && r3 != [])
		println("    STR r3(element)=" + i2s(length(r3)) + " :: "
			+ strGlue(map(r3, \pr -> strGlue(folFormToks(pr.first), " ")), " | "));
	concatA([r1, if (length(r2) > 3) subrange(r2, 0, 3) else r2, r3]);
}

// cand's block proves `P → qq` standalone (qq = ∀v (B → ∃ψ)); under asm:
// projTo(P)+syl, the instance implication + syl, projTo(B[e])+mpd, then the
// exlimdv discharge of the sub-proof
mizEmitExChainAt(hyps : [FolForm], prev : [FolForm], asm : FolForm, goal : FolForm,
	maxFacts : int, maxSize : int, depth : int, fresh : ref int, used : Set<string>,
	recDrv : [MizEmitDrv], cand : MizEmitDrv, pp : FolForm, qq : FolForm,
	v : string, e : FolTerm, shOf : (string) -> string,
	failed : Pair<Maybe<FolStepProof>, bool>) -> Pair<Maybe<FolStepProof>, bool> {
	// learn the instantiated shapes on a scratch pad first
	scr : ref [FolPStep] = ref [];
	scrD : ref [Pair<string, string>] = ref [];
	dbgf = \where : string -> {
		if (^mizEmitDbg) println("  CHAIN-FAIL " + where + " e=" + strGlue(folFormToks(FolEq(e, e)), " "));
		failed;
	};
	switch (mizEmitInstImp(scr, scrD, qq, v, e, shOf, 0)) {
		None(): dbgf("instimp");
		Some(im0): {
			inst = switch ((^scr)[im0.first].form) {
				FolBin(__, __, r): r;   // (∀v(B→∃ψ)) → (B[e] → ∃ψ[e])
				default: im0.second;
			};
			switch (inst) {
				FolBin(op3, be, exe): {
					conjs2 = mizEmitConjuncts(asm, []);
					// the normalizer peels one binder at a time, so `∃a∃b E` arrives as
					// nested single-binder nodes — flatten to get every binder
					flat = mizEmitExFlatten(exe);
					vs3 = flat.first;
					body3 = flat.second;
					vsOk = vs3 != []
						&& !exists(vs3, \w -> mizEmitFreeIn(w, goal) || mizEmitFreeIn(w, asm)
							|| exists(hyps, \hf -> mizEmitFreeIn(w, hf))
							|| exists(prev, \pf -> mizEmitFreeIn(w, pf)));
					if (op3 != "imp" || !vsOk || !exists(conjs2, \c -> c == be)) dbgf("shape-or-conjunct")
					else {
						{
							// the GOAL's own operators (proj1, proj2, …) get their
							// definitions too — same index, same QNF, capped; without
							// them the sub-proof cannot know what the goal's terms mean
							stmtOf = ^mizEmitStmtOfRef;
							defsOf = ^mizEmitDefsOfSymRef;
							gAtoms = uniq(concatA(map([goal, asm, FolBin("and", asm, body3)],
								\gf -> mizEmitAtomsOf(gf, []))));
							gSyms = uniq(concatA(map(gAtoms, mizFormSymbols)));
							// freshen each definition's binders away from the step's
							// variables (the binder-collision trap: a matrix binder
							// rendering as the pair's own variable refuses every
							// pair-matrix elimination), and try up to six entries per
							// symbol — the DEFINING one can sit behind mere mentions
							avoidC = ref buildSet(concatA(map(gAtoms, mizFormAllVars)));
							ctrC = ref 0;
							stmtOfF = \nm9 : string -> switch (stmtOf(nm9)) {
								None(): None();
								Some(st9): Some(mizFreshenBound(st9, avoidC, ctrC));
							};
							extra0 = concatA(map(gSyms, \sy -> {
								ds = defsOf(sy);
								tried = map(if (length(ds) > 6) subrange(ds, 0, 6) else ds,
									\nm2 -> Pair(nm2, mizEmitDefInstance(nm2, sy, gAtoms, stmtOfF, shOf)));
								got = filtermap(tried, \pr5 -> pr5.second);
								if (^mizEmitDbg && getUrlParameterDef("dbg-exelim", "") == "1")
									println("  CH-DEF " + sy + " ds=" + i2s(length(ds))
										+ " tried= " + strGlue(map(tried, \pr5 -> pr5.first
											+ (if (isSome(pr5.second)) "+" else "-")), ",")
										+ " :: " + strGlue(map(got,
											\g5 -> strGlue(folFormToks(g5.form), " ")), " | "));
								if (length(got) > 2) subrange(got, 0, 2) else got;
							}));
							extra1 = map(if (length(extra0) > 8) subrange(extra0, 0, 8) else extra0,
								mizEmitCleanIff);
							// a GUARDED extra (`relation-like T → matrix`) needs its
							// guard in the pool too — derive it from the unguarded
							// registrations, as the ladder's guard channel does; the
							// pair-matrix producer requires the standalone guard
							extra = concat(extra1, concatA(map(extra1, \d4 -> switch (d4.form) {
								FolBin(op4, l4, __): if (op4 != "imp") [] else
									mizEmitGuardedInsts((^mizEmitBySkelRef)(mizEmitSkeleton(l4)),
										l4, ^mizEmitStmtOfRef, ^mizEmitIsAxiomRef, shOf, 2);
								default: [];
							})));
							asmB = FolBin("and", asm, body3);
							if (^mizEmitDbg && getUrlParameterDef("dbg-exelim", "") == "1")
								println("  CHAIN-SUB d" + i2s(depth + 2)
									+ " extra=" + i2s(length(extra))
									+ " asmB= " + strGlue(folFormToks(asmB), " ")
									+ " goal= " + strGlue(folFormToks(goal), " "));
							plain = mizEmitReduceA0(hyps, prev, asmB, goal,
								maxFacts, maxSize, depth + 2, fresh, used, concat(recDrv, extra));
							// the sub-proof, possibly from the STRENGTHENED assumption:
							// (proof, index of the step proving asmB → goal)
							prep : Maybe<Pair<FolStepProof, int>> = switch (plain.first) {
								Some(pr0): Some(Pair(pr0, length(pr0.steps) - 1));
								None(): {
									st2 : ref [FolPStep] = ref [];
									rf2 : ref [RuParseRef] = ref [];
									dj2 : ref [Pair<string, string>] = ref [];
									exs = mizEmitStrengthen(hyps, prev, asmB, goal, maxFacts, maxSize,
										depth, fresh, used, concat(recDrv, extra), st2, rf2, dj2, shOf);
									if (^mizEmitDbg)
										println("  STRENGTHEN n=" + i2s(length(exs)) + " :: "
											+ strGlue(map(exs, \c2 -> strGlue(folFormToks(c2.first), " ")), " ; "));
									if (exs == []) None() else {
										asmS = fold(exs, asmB, \ac, c2 -> FolBin("and", ac, c2.first));
										// the producer keys on the STRENGTHENED conjuncts —
										// the pair membership is a round-1 consequence,
										// never an asmB conjunct (08-13 diagnosis)
										pool3 = concat(recDrv, extra);
										pmx = mizEmitPairMatrixDrvs(asmS, pool3, shOf);
										pool4 = concat(pool3, pmx);
										eqb = mizEmitEqBridgeDrvs(asmS, goal, pool4);
										subS0 = mizEmitReduceA0(hyps, prev, asmS, goal,
											maxFacts, maxSize, depth + 2, fresh, used, concat(pool4, eqb));
										// the nested ∃ (d8's inner witness, Mizar's
										// `consider z`) lives one layer down, and the
										// recursion cap sits exactly at this depth — the
										// elimination is called DIRECTLY, bounded to one
										// extra layer past the cap
										subS = switch (subS0.first) {
											Some(__): subS0;
											None(): if (depth + 2 >= 10) subS0
												else mizEmitExElimA(hyps, prev, asmS, goal,
													maxFacts, maxSize, depth + 2, fresh, used,
													concat(pool4, eqb), subS0);
										};
										switch (subS.first) {
											None(): None();
											Some(ps): {
												base = length(ps.steps);
												kf = length(ps.factRefs);
												stA : ref [FolPStep] = ref concat(ps.steps,
													mizEmitShift(^st2, base, kf));
												em2 = \form : FolForm, lemma : string, rs : [FolPRef] -> {
													stA := arrayPush(^stA, FolPStep(form, lemma, rs));
													length(^stA) - 1;
												};
												// asmB → asmS (id + jca over the consequences), then syl
												i0 = em2(FolBin("imp", asmB, asmB), "id", []);
												ci = (fold(exs, Pair(i0, asmB), \ac : Pair<int, FolForm>, c2 -> {
													nf2 = FolBin("and", ac.second, c2.first);
													Pair(em2(FolBin("imp", asmB, nf2), "jca",
														[FolPRefStep(ac.first), FolPRefStep(c2.second + base)]), nf2);
												})).first;
												gi = em2(FolBin("imp", asmB, goal), "syl",
													[FolPRefStep(ci), FolPRefStep(base - 1)]);
												Some(Pair(FolStepProof(^stA, concat(ps.factRefs, ^rf2),
													uniq(concat(ps.disjs, ^dj2))), gi));
											}
										}
									}
								}
							};
							switch (prep) {
								None(): dbgf("subproof");
								Some(pg): {
									pr = pg.first;
									steps : ref [FolPStep] = ref pr.steps;
									refs : ref [RuParseRef] = ref pr.factRefs;
									dj : ref [Pair<string, string>] = ref pr.disjs;
									emit = \form : FolForm, lemma : string, rs : [FolPRef] -> {
										steps := arrayPush(^steps, FolPStep(form, lemma, rs));
										length(^steps) - 1;
									};
									cur = emit(FolBin("imp", asm, FolBin("imp", body3, goal)), "ex",
										[FolPRefStep(pg.second)]);
									n = length(vs3);
									exl = fold(enumFromTo(1, n), cur, \st, i -> {
										k2 = n - i;
										emit(FolBin("imp", asm, FolBin("imp",
											FolQuant("exists", subrange(vs3, k2, n - k2), body3), goal)),
											"exlimdv", [FolPRefStep(st)]);
									});
									dj := concat(^dj, concatA(map(vs3, \w -> {
										wr = toLowerCase(w);
										filtermap(uniq(concat(folFormVars(goal), folFormVars(asm))),
											\u -> if (u == wr) None() else Some(Pair(wr, u)));
									})));
									// the standalone block proving `P → qq`
									base = length(^steps);
									kf = length(^refs);
									steps := concat(^steps, mizEmitShift(cand.steps, base, kf));
									refs := concat(^refs, cand.refs);
									dj := concat(^dj, cand.disjs);
									b1 = length(^steps) - 1;
									// the first link's guard: projected from the
									// assumption, else proved ABSOLUTELY from an
									// unguarded axiom (ct4/ct6's registrations) + a1i
									pDis = switch (mizEmitProjTo(steps, asm, pp)) {
										Some(p0): Some(p0);
										None(): {
											gds = mizEmitGuardedInsts(
												(^mizEmitBySkelRef)(mizEmitSkeleton(pp)), pp,
												^mizEmitStmtOfRef, ^mizEmitIsAxiomRef, shOf, 2);
											switch (find(gds, \gd -> gd.form == pp && gd.steps != [])) {
												None(): None();
												Some(gd): {
													bg = length(^steps);
													kg = length(^refs);
													steps := concat(^steps, mizEmitShift(gd.steps, bg, kg));
													refs := concat(^refs, gd.refs);
													dj := concat(^dj, gd.disjs);
													Some(emit(FolBin("imp", asm, pp), "a1i",
														[FolPRefStep(length(^steps) - 1)]));
												}
											}
										}
									};
									switch (pDis) {
										None(): failed;
										Some(p1): {
											c1 = emit(FolBin("imp", asm, qq), "syl",
												[FolPRefStep(p1), FolPRefStep(b1)]);
											switch (mizEmitInstImp(steps, dj, qq, v, e, shOf, 0)) {
												None(): failed;
												Some(im): {
													e1 = emit(FolBin("imp", asm, inst), "syl",
														[FolPRefStep(c1), FolPRefStep(im.first)]);
													switch (mizEmitProjTo(steps, asm, be)) {
														None(): failed;
														Some(p2): {
															f1 = emit(FolBin("imp", asm, exe), "mpd",
																[FolPRefStep(p2), FolPRefStep(e1)]);
															fin = emit(FolBin("imp", asm, goal), "mpd",
																[FolPRefStep(f1), FolPRefStep(exl)]);
															Pair(Some(FolStepProof(^steps, ^refs, uniq(^dj))), false);
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
				default: failed;
			}
		}
	}
}
mizEmitFresh(fresh : ref int, used : Set<string>) -> string {
	n = "X95" + i2s(^fresh);
	fresh := ^fresh + 1;
	if (containsSet(used, toLowerCase(n))) mizEmitFresh(fresh, used) else n;
}

mizEmitShift(steps : [FolPStep], dS : int, dF : int) -> [FolPStep] {
	map(steps, \cs -> FolPStep(cs.form, cs.assertion, map(cs.refs, \r -> switch (r) {
		FolPRefStep(k): FolPRefStep(k + dS);
		FolPRefFact(k): FolPRefFact(k + dF);
	})));
}

mizEmitReduce(hyps : [FolForm], prev : [FolForm], goal : FolForm,
	maxFacts : int, maxSize : int, depth : int,
	fresh : ref int, used : Set<string>, recDrv : [MizEmitDrv]) -> Pair<Maybe<FolStepProof>, bool> {
	if (^mizEmitDbg && getUrlParameterDef("dbg-reduce", "") == "1")
		println("  REDUCE d" + i2s(depth) + " " + strGlue(folFormToks(goal), " "));
	// membership pairs REWRITE FIRST: the proof also closes them, but as
	// a G3cp trace over biconditional facts — the shape the size directive
	// forbids. The rewrite route is linear (unfold chains + the ∨-tree walk),
	// and its residue still reaches the full reduction — the ladder included —
	// whenever the walk alone cannot close it.
	memFirst0 = if (depth >= 8) None() else switch (mizEmitMemPair(goal)) {
		None(): None();
		Some(tr): mizEmitMemRewrite(hyps, prev, goal, tr.first, tr.second,
			(tr.third).first, (tr.third).second, maxFacts, maxSize, depth,
			fresh, used, recDrv);
	};
	// a general IFF between membership combinations (the pointwise pair
	// family): NF both sides, join by the walks
	memFirst = if (isSome(memFirst0) || depth >= 8) memFirst0
		else mizEmitIffNFWalk(goal);
	if (isSome(memFirst)) Pair(memFirst, false) else {
	direct = mizEmitLadder(hyps, prev, goal, maxFacts, maxSize, recDrv);
	switch (direct.first) {
		Some(__): direct;
		None(): if (depth >= 8) direct else switch (goal) {
			FolQuant(q, vs, body): {
				if (q == "exists" && vs != [])
					mizEmitExGoal(hyps, prev, goal, vs, body, maxFacts, maxSize, depth, fresh, used, direct, recDrv)
				else if (q != "forall" || vs == []) direct
				else {
					sub = mizEmitReduce(hyps, prev, body, maxFacts, maxSize, depth + 1, fresh, used, recDrv);
					switch (sub.first) {
						None(): Pair(None(), direct.second || sub.second);
						Some(pr): {
							n = length(vs);
							gen = generate(0, n, \i -> {
								k = n - 1 - i;
								FolPStep(FolQuant("forall", subrange(vs, k, n - k), body),
									"ax-gen", [FolPRefStep(length(pr.steps) + i - 1)]);
							});
							// the first ax-gen cites the sub-proof's last step
							gen0 = mapi(gen, \i, g -> if (i > 0) g
								else FolPStep(g.form, g.assertion, [FolPRefStep(length(pr.steps) - 1)]));
							Pair(Some(FolStepProof(concat(pr.steps, gen0), pr.factRefs, pr.disjs)), false);
						}
					}
				}
			}
			FolPred(name, args): {
				if (name != "⊆" || length(args) != 2) direct
				else mizEmitCharGoal(hyps, prev, goal, args[0], args[1], "imp", "df-ss",
					maxFacts, maxSize, depth, fresh, used, direct, recDrv);
			}
			// ★ A DENIED GOAL IS PROVED BY ASSUMING IT. Mizar states most of its
			// theses as denied conjunctions (`¬ ( A ∧ … ∧ ¬ C )`), and the checker
			// proves one the only way there is: it assumes the body and derives a
			// contradiction. The reduction had no such rule — a negated goal went
			// to the ladder whole — so the step's own premises were never in hand.
			// The deduction reduction already proves `asm → X`; with X the false
			// constant, pm2.65i turns `body → ¬ ⊤` and `body → ⊤` into `¬ body`.
			FolNeg(body): if (body == FolPred("$true", [])) direct else {
				sub = mizEmitReduceA(hyps, prev, body, FolNeg(FolPred("$true", [])),
					maxFacts, maxSize, depth + 1, fresh, used, recDrv);
				switch (sub.first) {
					None(): {
						// the old route: rewrite the goal and prove the residue
						gr = mizEmitGoalNF(hyps, prev, goal, maxFacts, maxSize, depth,
							fresh, used, recDrv);
						switch (gr) {
							Some(__): Pair(gr, false);
							None(): Pair(None(), direct.second || sub.second);
						}
					}
					Some(pr): {
						n0 = length(pr.steps);
						tr = FolPStep(FolPred("$true", []), "tru", []);
						a1 = FolPStep(FolBin("imp", body, FolPred("$true", [])), "a1i",
							[FolPRefStep(n0)]);
						fin = FolPStep(goal, "pm2.65i",
							[FolPRefStep(n0 + 1), FolPRefStep(n0 - 1)]);
						Pair(Some(FolStepProof(concat(pr.steps, [tr, a1, fin]),
							pr.factRefs, pr.disjs)), false);
					}
				}
			}
			FolEq(l, r): mizEmitCharGoal(hyps, prev, goal, l, r, "iff", "dfcleq",
				maxFacts, maxSize, depth, fresh, used, direct, recDrv);
			FolBin(op0, l0, r0): {
				// (membership pairs were already tried by the rewrite-first route
				// at this function's entry)
				// THE DEDUCTION STEP. An implication goal reached the
				// proof whole and with nothing to reason from — for
				// t21_subset_1, `facts=0`. Mizar reads `A → B` by assuming A,
				// so the antecedent joins the facts and the proof
				// concludes `A → B` itself (folPCertAssuming). This is a leaf
				// strategy: the consequent is not reduced further, because
				// every combinator above would then have to be lifted into
				// deduction form.
				// `A → ∀x C` is `∀x (A → C)` when x is not free in A — the
				// shape a Mizar `assume` followed by a `let` leaves. Swapping
				// it (19.21v) puts the ∀ back on the outside, where ax-gen
				// peels it and each antecedent is assumed in turn.
				swapped = if (op0 != "imp") Pair(None(), false)
					else mizEmitImpAll(hyps, prev, goal, l0, r0, maxFacts, maxSize,
						depth, fresh, used, recDrv);
				ded = switch (swapped.first) {
					Some(__): swapped;
					None(): if (op0 != "imp") Pair(None(), false)
						else mizEmitReduceA(hyps, prev, l0, r0, maxFacts, maxSize,
							depth, fresh, used, recDrv);
				};
				switch (ded.first) {
					Some(__): ded;
					None(): mizEmitBinGoal(hyps, prev, goal, op0, l0, r0, maxFacts, maxSize,
						depth, fresh, used, direct, recDrv);
				}
			}
		}
	}
	}
}

// ---- THE REDUCTION UNDER AN ASSUMPTION ----
// The same reduction as mizEmitReduce, but every proof it returns ends on
// `asm → goal` instead of `goal`, so the antecedent of an implication step
// stays available all the way down instead of only at the proof. Each
// combinator has its deduction twin, and they are all one lemma:
//   ax-gen  -> alrimiv     (the binder must not occur in the assumption)
//   mpbir   -> sylibr      (⊆/= characterizations, goal and membership NF)
//   pm3.2i  -> jca
//   impbii  -> impbid
//   nested antecedent: assume the CONJUNCTION and re-curry with `ex`
// A leaf goes to folPCertAssuming, which is the same proof with one
// fact named as the assumption.
mizEmitReduceA(hyps : [FolForm], prev : [FolForm], asm : FolForm, goal : FolForm,
	maxFacts : int, maxSize : int, depth : int,
	fresh : ref int, used : Set<string>, recDrv : [MizEmitDrv]) -> Pair<Maybe<FolStepProof>, bool> {
	r = mizEmitReduceA0(hyps, prev, asm, goal, maxFacts, maxSize, depth, fresh, used, recDrv);
	switch (r.first) {
		Some(__): r;
		// ∃-elimination UNDER the assumption — where the relation family's facts
		// actually live (`∀X (X is Relation → …)` puts both the relation-hood and
		// the element antecedent inside this reduction). exlimdv is exlimiv's
		// deduction twin, one more row of the twin table.
		// 8 matches mizEmitReduceA0's own recursion cap: at 6 the ⊆-matrix of a
		// conditional theorem (∀-lift + assume + ∧-split + df-ss + assume) sits
		// just past the gate and the relation family's element stage never ran
		None(): if (depth >= 8) {
				if (^mizEmitDbg && getUrlParameterDef("dbg-exelim", "") == "1")
					println("  EXELIM-GATED d" + i2s(depth)
						+ " goal= " + strGlue(folFormToks(goal), " "));
				r;
			} else mizEmitExElimA(hyps, prev, asm, goal, maxFacts, maxSize, depth, fresh, used, recDrv, r);
	}
}

// ---- THE FORWARD MODUS-PONENS CLOSER ----
// The flat proof search explodes on a pile of nested guarded implications
// while the proof it needs is a SHORT FORWARD CHAIN: take what the
// assumption already states, apply the pool's implications by modus
// ponens, and cite the foundation's deduction lemmas. Every line is
// `asm → F`, so the chain is linear in the facts it uses and restates no
// context — the size directive's route (cite a lemma, do not let the
// search re-derive it).
//   imp   A, A→B      mpd        (a conjunctive antecedent is built by jca)
//   and   A∧B         simpld / simprd
//   iff   A, A↔B      mpbid      (B, A↔B: mpbird)
//
// TWO PASSES, and the second is the whole point: saturation only RECORDS
// how each fact was derived (a node = form + lemma + argument nodes);
// nothing is emitted until the goal is reached, and then only the nodes
// the goal actually depends on are written out. Emitting during
// saturation instead cost 7115 lines for a six-line chain, because every
// pool fact's block was spliced whether used or not.
mizEmitMpClose(hyps : [FolForm], prev : [FolForm], asm : FolForm, goal : FolForm,
	recDrv : [MizEmitDrv], rounds : int) -> Maybe<FolStepProof> {
	// (form, kind, argument nodes); kinds: asm ctx pool mpd jca simpld simprd mpbid mpbird
	nodes : ref [Triple<FolForm, string, [int]>] = ref [];
	idx : ref Tree<string, int> = ref makeTree();
	get = \f9 : FolForm -> lookupTree(^idx, mizEmitKey(f9));
	ensure = \f9 : FolForm, kind : string, args : [int] -> switch (get(f9)) {
		Some(i9): i9;
		None(): {
			nodes := arrayPush(^nodes, Triple(f9, kind, args));
			n9 = length(^nodes) - 1;
			idx := setTree(^idx, mizEmitKey(f9), n9);
			n9;
		}
	};
	// SEED 1 — what the assumption itself states (checked on a scratch pad;
	// the projection is only written if the goal ends up needing it)
	iter(mizEmitConjuncts(asm, []), \c -> {
		scr : ref [FolPStep] = ref [];
		if (isNone(mizEmitProjTo(scr, asm, c))) {} else { ensure(c, "asm", []); {} }
	});
	// SEED 2 — the context's facts
	ctx = concat(
		mapi(hyps, \j, h -> Pair(h, mizEmitHypRef(j))),
		mapi(prev, \j, sp -> Pair(sp, mizEmitStepRef(j))));
	iteri(ctx, \j, p -> { ensure(p.first, "ctx", [j]); {} });
	// SEED 3 — the pool's proved blocks. NO BLIND TRUNCATION: the fact a
	// chain needs is often the LAST one produced (the pre-discharged
	// diagonal instance sits at the end), and this pass emits nothing, so
	// the cap is only a runaway guard.
	pool = if (length(recDrv) > 160) subrange(recDrv, 0, 160) else recDrv;
	iteri(pool, \j, d -> if (d.steps == []) {} else { ensure(d.form, "pool", [j]); {} });
	// SATURATE — bounded rounds over a snapshot; each derivation is one
	// citation of one foundation lemma
	iter(enumFromTo(1, rounds), \__ ->
		iteri(^nodes, \i, nd -> if (length(^nodes) > 400) {} else switch (nd.first) {
			FolBin(op, a, b): {
				if (op == "imp") {
					ai = switch (get(a)) {
						Some(k): Some(k);
						None(): {
							ants = mizEmitConjuncts(a, []);
							if (length(ants) < 2) None() else {
								built = fold(ants, Some(Pair(-1, FolPred("$none", []))),
									\ac : Maybe<Pair<int, FolForm>>, c -> switch (ac) {
										None(): None();
										Some(st): switch (get(c)) {
											None(): None();
											Some(ci): if (st.first < 0) Some(Pair(ci, c)) else {
												nf = FolBin("and", st.second, c);
												Some(Pair(ensure(nf, "jca", [st.first, ci]), nf));
											}
										}
									});
								// the jca fold must land on the antecedent EXACTLY (its
								// own association), else the mpd would not match
								switch (built) {
									None(): None();
									Some(st): if (mizEmitKey(st.second) == mizEmitKey(a))
										Some(st.first) else None();
								}
							}
						}
					};
					switch (ai) {
						None(): {};
						Some(k): { ensure(b, "mpd", [k, i]); {} }
					}
				} else if (op == "and") {
					ensure(a, "simpld", [i]);
					ensure(b, "simprd", [i]);
					{}
				} else if (op == "iff") {
					switch (get(a)) {
						Some(k): { ensure(b, "mpbid", [k, i]); {} }
						None(): switch (get(b)) {
							Some(k): { ensure(a, "mpbird", [k, i]); {} }
							None(): {};
						}
					}
				} else {}
			}
			default: {};
		}));
	// the goal, or a conjunction whose parts are both known
	fin = switch (get(goal)) {
		Some(gi): Some(gi);
		None(): switch (goal) {
			FolBin(opG, l, r): if (opG != "and") None() else switch (get(l)) {
				None(): None();
				Some(li): switch (get(r)) {
					None(): None();
					Some(ri): Some(ensure(goal, "jca", [li, ri]));
				}
			};
			default: None();
		}
	};
	switch (fin) {
		None(): {
			if (^mizEmitDbg && getUrlParameterDef("dbg-mp", "") == "1")
				println("  MPCLOSE miss known=" + i2s(length(^nodes))
					+ " goal= " + strGlue(folFormToks(goal), " "));
			None();
		}
		Some(gn): {
			// PASS 2 — mark what the goal depends on (arguments always have
			// smaller indices, so one downward sweep suffices), then write
			// out those nodes only, in dependency order
			need : ref Set<int> = ref insertSet(makeSet(), gn);
			iter(enumFromTo(0, gn), \d -> {
				i9 = gn - d;
				if (!containsSet(^need, i9)) {} else
					iter((^nodes)[i9].third, \a -> need := insertSet(^need, a));
			});
			steps : ref [FolPStep] = ref [];
			refs : ref [RuParseRef] = ref [];
			dj : ref [Pair<string, string>] = ref [];
			at : ref Tree<int, int> = ref makeTree();   // node -> step
			bad : ref bool = ref false;
			emit = \f9 : FolForm, lm : string, rs : [FolPRef] -> {
				steps := arrayPush(^steps, FolPStep(f9, lm, rs));
				length(^steps) - 1;
			};
			ref2 = \n9 : int -> switch (lookupTree(^at, n9)) {
				None(): { bad := true; FolPRefStep(0); }
				Some(s9): FolPRefStep(s9);
			};
			iter(enumFromTo(0, gn), \i9 -> if (!containsSet(^need, i9) || ^bad) {} else {
				nd = (^nodes)[i9];
				f9 = nd.first;
				imp9 = FolBin("imp", asm, f9);
				si = if (nd.second == "asm")
						switch (mizEmitProjTo(steps, asm, f9)) {
							None(): { bad := true; 0; }
							Some(p9): p9;
						}
					else if (nd.second == "ctx") {
						kf = length(^refs);
						refs := arrayPush(^refs, ctx[nd.third[0]].second);
						emit(imp9, "a1i", [FolPRefFact(kf)]);
					} else if (nd.second == "pool") {
						d9 = pool[nd.third[0]];
						b9 = length(^steps);
						kf = length(^refs);
						steps := concat(^steps, mizEmitShift(d9.steps, b9, kf));
						refs := concat(^refs, d9.refs);
						dj := concat(^dj, d9.disjs);
						emit(imp9, "a1i", [FolPRefStep(length(^steps) - 1)]);
					} else if (length(nd.third) == 1)
						emit(imp9, nd.second, [ref2(nd.third[0])])
					else
						emit(imp9, nd.second, [ref2(nd.third[0]), ref2(nd.third[1])]);
				at := setTree(^at, i9, si);
			});
			if (^bad) None() else {
				if (^mizEmitDbg && getUrlParameterDef("dbg-exelim", "") == "1")
					println("  MPCLOSE ok " + i2s(length(^steps)) + " steps, goal= "
						+ strGlue(folFormToks(goal), " "));
				Some(FolStepProof(^steps, ^refs, uniq(^dj)));
			}
		}
	}
}

mizEmitReduceA0(hyps : [FolForm], prev : [FolForm], asm : FolForm, goal : FolForm,
	maxFacts : int, maxSize : int, depth : int,
	fresh : ref int, used : Set<string>, recDrv : [MizEmitDrv]) -> Pair<Maybe<FolStepProof>, bool> {
	// the forward chain first: it is search-free, and its proof is the short
	// one the size directive asks for
	mpc = if (recDrv == []) None()
		else mizEmitMpClose(hyps, prev, asm, goal, recDrv, 8);
	if (isSome(mpc)) Pair(mpc, false) else {
	direct = mizEmitLadderA(hyps, prev, goal, maxFacts, maxSize, recDrv, Some(asm));
	switch (direct.first) {
		Some(__): direct;
		None(): if (depth >= 8) direct else {
			// (sub-proof of `asm → g`, then one lemma) — the shared shape
			lift = \g : FolForm, mk : (int) -> [FolPStep] -> {
				sub = mizEmitReduceA(hyps, prev, asm, g, maxFacts, maxSize, depth + 1,
					fresh, used, recDrv);
				switch (sub.first) {
					None(): Pair(None(), direct.second || sub.second);
					Some(pr): Pair(Some(FolStepProof(concat(pr.steps, mk(length(pr.steps) - 1)),
						pr.factRefs, pr.disjs)), false);
				}
			};
			switch (goal) {
				FolQuant(q, vs, body): if (q == "exists" && vs != [])
					mizEmitExGoalA(hyps, prev, asm, goal, vs, body, maxFacts, maxSize,
						depth, fresh, used, direct, recDrv)
				else if (q != "forall" || vs == []) direct
					else if (exists(vs, \v -> mizEmitFreeIn(v, asm))) direct
					else {
						// one alrimiv per binder, innermost first — the same ladder
						// ax-gen builds, with the assumption carried along
						n = length(vs);
						r = lift(body, \last -> generate(0, n, \i -> {
							k = n - 1 - i;
							FolPStep(FolBin("imp", asm, FolQuant("forall", subrange(vs, k, n - k), body)),
								"alrimiv", [FolPRefStep(last + i)]);
						}));
						// alrimiv is disjointed(ph x): the binder must not meet the
						// assumption's variables
						dj = concatA(map(vs, \v -> {
							vr = toLowerCase(v);
							filtermap(folFormVars(asm), \w -> if (w == vr) None() else Some(Pair(vr, w)));
						}));
						switch (r.first) {
							None(): r;
							Some(pr): Pair(Some(FolStepProof(pr.steps, pr.factRefs,
								uniq(concat(pr.disjs, dj)))), false);
						}
					}
				FolPred(name, args): if (name != "⊆" || length(args) != 2) direct
					else mizEmitCharGoalA(hyps, prev, asm, goal, args[0], args[1], "imp", "df-ss",
						maxFacts, maxSize, depth, fresh, used, direct, recDrv);
				// ★ THE DENIED GOAL'S DEDUCTION TWIN. Mizar's theses are denied
				// conjunctions and most of them stand UNDER an assumption, so the
				// rule that assumes the body has to exist here too: prove
				// `( asm ∧ body ) → ¬ ⊤`, deny the conjunction with pm2.65i, and
				// imnani re-curries it into `asm → ¬ body`.
				// ...but never on the contradiction marker itself: assuming ⊤ and
				// denying it again is an infinite regress (it grew the assumption
				// by `∧ ⊤` at every depth until the cap, 162 attempts on one step)
				FolNeg(nbody): if (nbody == FolPred("$true", [])) direct else {
					both9 = FolBin("and", asm, nbody);
					// the assumption now carries what the record's witnesses come from
					sub9 = mizEmitReduceA(hyps, prev, both9, FolNeg(FolPred("$true", [])),
						maxFacts, maxSize, depth + 1, fresh, used,
						concat(recDrv, mizEmitClauseEx(concat(concat(hyps, prev), [both9]))));
					switch (sub9.first) {
						None(): Pair(None(), direct.second || sub9.second);
						Some(pr9): {
							n9 = length(pr9.steps);
							tr9 = FolPStep(FolPred("$true", []), "tru", []);
							a19 = FolPStep(FolBin("imp", both9, FolPred("$true", [])), "a1i",
								[FolPRefStep(n9)]);
							dn9 = FolPStep(FolNeg(both9), "pm2.65i",
								[FolPRefStep(n9 + 1), FolPRefStep(n9 - 1)]);
							im9 = FolPStep(FolBin("imp", asm, goal), "imnani",
								[FolPRefStep(n9 + 2)]);
							Pair(Some(FolStepProof(concat(pr9.steps, [tr9, a19, dn9, im9]),
								pr9.factRefs, pr9.disjs)), false);
						}
					}
				}
				FolEq(l, r): mizEmitCharGoalA(hyps, prev, asm, goal, l, r, "iff", "dfcleq",
					maxFacts, maxSize, depth, fresh, used, direct, recDrv);
				FolBin(op, l, r): {
					if (op == "imp") {
						// a second antecedent: assume the CONJUNCTION, then re-curry
						both = FolBin("and", asm, l);
						sub = mizEmitReduceA(hyps, prev, both, r, maxFacts, maxSize, depth + 1,
							fresh, used, recDrv);
						switch (sub.first) {
							None(): Pair(None(), direct.second || sub.second);
							Some(pr): Pair(Some(FolStepProof(arrayPush(pr.steps,
								FolPStep(FolBin("imp", asm, goal), "ex",
									[FolPRefStep(length(pr.steps) - 1)])),
								pr.factRefs, pr.disjs)), false);
						}
					} else if (op == "and" || op == "iff") {
						la = if (op == "and") l else FolBin("imp", l, r);
						ra = if (op == "and") r else FolBin("imp", r, l);
						sa = mizEmitReduceA(hyps, prev, asm, la, maxFacts, maxSize, depth + 1,
							fresh, used, recDrv);
						switch (sa.first) {
							None(): Pair(None(), direct.second || sa.second);
							Some(pa): {
								sb = mizEmitReduceA(hyps, prev, asm, ra, maxFacts, maxSize, depth + 1,
									fresh, used, recDrv);
								switch (sb.first) {
									None(): Pair(None(), direct.second || sb.second);
									Some(pb): {
										dS = length(pa.steps); dF = length(pa.factRefs);
										bs = mizEmitShift(pb.steps, dS, dF);
										jn = FolPStep(FolBin("imp", asm, goal),
											if (op == "and") "jca" else "impbid",
											[FolPRefStep(dS - 1), FolPRefStep(dS + length(bs) - 1)]);
										Pair(Some(FolStepProof(concatA([pa.steps, bs, [jn]]),
											concat(pa.factRefs, pb.factRefs),
											uniq(concat(pa.disjs, pb.disjs)))), false);
									}
								}
							}
						}
					} else direct;
				}
			}
		}
	}
	}
}

// reflexive equations (`t = t`) occurring as atoms of the pool's facts,
// discharged by eqid — the tableau holds `=` atoms as opaque, so a matrix
// instance guarded by `u = u` is unusable without this
mizEmitEqidDrvs(pool : [MizEmitDrv]) -> [MizEmitDrv] {
	eqs = uniq(filtermap(concatA(map(pool, \d -> mizEmitAtomsOf(d.form, []))),
		\a -> switch (a) {
			FolEq(l9, r9): if (l9 == r9) Some(a) else None();
			default: None();
		}));
	map(if (length(eqs) > 4) subrange(eqs, 0, 4) else eqs,
		\e -> MizEmitDrv(e, [FolPStep(e, "eqid", [])], [], []));
}

// one-hole structural match: does `tgt` equal `pat` with the variable `x`
// replaced by ONE consistent term? Returns that term. Every other variable
// must match verbatim — they are fixed at this stage.
mizEmitMatchHole(pat : FolForm, tgt : FolForm, x : string) -> Maybe<FolTerm> {
	hole : ref Maybe<FolTerm> = ref None();
	ok = switch (pat) {
		FolPred(n1, a1): switch (tgt) {
			FolPred(n2, a2): n1 == n2 && length(a1) == length(a2)
				&& forall(mapi(a1, \i, p9 -> Pair(p9, a2[i])),
					\pr9 -> mizEmitMatchHoleT(pr9.first, pr9.second, x, hole));
			default: false;
		};
		FolEq(l1, r1): switch (tgt) {
			FolEq(l2, r2): mizEmitMatchHoleT(l1, l2, x, hole)
				&& mizEmitMatchHoleT(r1, r2, x, hole);
			default: false;
		};
		default: false;
	};
	if (ok) ^hole else None();
}
mizEmitMatchHoleT(p : FolTerm, t : FolTerm, x : string, hole : ref Maybe<FolTerm>) -> bool {
	switch (p) {
		FolVar(v): if (v != x) p == t else switch (^hole) {
			None(): { hole := Some(t); true; }
			Some(t0): t0 == t;
		};
		FolApp(n1, a1): switch (t) {
			FolApp(n2, a2): n1 == n2 && length(a1) == length(a2)
				&& forall(mapi(a1, \i, p9 -> Pair(p9, a2[i])),
					\pr9 -> mizEmitMatchHoleT(pr9.first, pr9.second, x, hole));
			default: false;
		};
		default: p == t;
	}
}

// An ∃ GOAL under the assumption — mizEmitExGoal's deduction twin. The binder
// itself as witness needs 19.8a + syl; a term witness w needs the congruence
// walk, spcegv (whose disjointness is the same no-capture rule), the witness's
// sethood, and syl — the same three pieces the plain ∃-introduction uses,
// with the final ax-mp replaced by syl through the assumption.
mizEmitExGoalA(hyps : [FolForm], prev : [FolForm], asm : FolForm, goal : FolForm,
	vs : [string], body : FolForm,
	maxFacts : int, maxSize : int, depth : int,
	fresh : ref int, used : Set<string>,
	direct : Pair<Maybe<FolStepProof>, bool>, recDrv : [MizEmitDrv]) -> Pair<Maybe<FolStepProof>, bool> {
	x = vs[0];
	rest = if (length(vs) == 1) body else FolQuant("exists", tail(vs), body);
	mems : ref [Pair<FolTerm, FolTerm>] = ref [];
	subs : ref [Pair<FolTerm, FolTerm>] = ref [];
	eqs  : ref [Pair<FolTerm, FolTerm>] = ref [];
	iter(arrayPush(filter(concatA([hyps, prev, [asm]]), \f -> !mizEmitHasQuant(f)), body),
		\f -> mizEmitHarvest(f, mems, subs, eqs));
	// every variable of the harvested terms — a witness often sits INSIDE a
	// term (the b of `⟨a,b⟩ ∈ X`), where a top-level scan never looks
	names = uniq(concatA(map(
		concatA(map(concatA([^mems, ^subs, ^eqs]), \p -> [p.first, p.second])),
		mizEmitTermVars)));
	// COMPUTED witnesses first: match each body atom containing the binder
	// against the context's quantifier-free atoms with the binder as the one
	// hole — the witness of `∃z (⟨a,z⟩∈R ∧ ⟨z,b⟩∈S)` is COMPUTED from the
	// membership the context already states, never guessed (a blind witness
	// pool tried `⟨x26,x12⟩ ∈ x26`-shaped nonsense and burned a full
	// reduction per miss — the t52 diagnosis)
	ctxQF = filter(concatA([hyps, prev, mizEmitConjuncts(asm, [])]),
		\f -> !mizEmitHasQuant(f));
	bodyAtoms = filter(mizEmitAtomsOf(body, []), \a2 -> mizEmitFreeIn(x, a2));
	ctxAtoms = uniq(concatA(map(ctxQF, \f -> mizEmitAtomsOf(f, []))));
	scoreW = \t9 : FolTerm -> length(filter(bodyAtoms, \pa ->
		exists(ctxAtoms, \fa -> mizEmitMatchHole(pa, fa, x) == Some(t9))));
	computed0 = filtermap(
		uniq(concatA(map(bodyAtoms, \pa ->
			filtermap(ctxAtoms, \fa -> mizEmitMatchHole(pa, fa, x))))),
		\t9 -> switch (t9) {
			FolVar(v9): if (v9 != x) Some(v9) else None();
			default: None();
		});
	computedR = mergeSort(computed0, \a9, b9 -> scoreW(FolVar(b9)) - scoreW(FolVar(a9)));
	computed = if (length(computedR) > 3) subrange(computedR, 0, 3) else computedR;
	if (^mizEmitDbg && getUrlParameterDef("dbg-exelim", "") == "1" && computed != [])
		println("  EXGW computed= " + strGlue(computed, ",")
			+ " body= " + strGlue(folFormToks(body), " "));
	blindCap = if (computed == []) 6 else 3;
	blind = filter(if (length(names) > blindCap) subrange(names, 0, blindCap) else names,
		\n -> n != x && !contains(computed, n));
	cands = concat(computed, concat([x], blind));
	fold(cands, direct, \acc : Pair<Maybe<FolStepProof>, bool>, y -> switch (acc.first) {
		Some(__): acc;
		None(): {
			if (y == x) {
				sub = mizEmitReduceA(hyps, prev, asm, rest, maxFacts, maxSize, depth + 1,
					fresh, used, recDrv);
				switch (sub.first) {
					None(): acc;
					Some(pr): {
						n0 = length(pr.steps);
						im = FolPStep(FolBin("imp", rest, goal), "19.8a", []);
						sy = FolPStep(FolBin("imp", asm, goal), "syl",
							[FolPRefStep(n0 - 1), FolPRefStep(n0)]);
						Pair(Some(FolStepProof(concatA([pr.steps, [im, sy]]),
							pr.factRefs, pr.disjs)), false);
					}
				}
			} else {
				wsteps : ref [FolPStep] = ref [];
				djr : ref [Pair<string, string>] = ref [];
				switch (mizEmitWalkT(wsteps, djr, x, FolVar(y), rest)) {
					None(): acc;
					Some(w): {
						// the SUBSTITUTED body's pair memberships key the
						// matrix instances the sub-proof needs — the diagonal
						// `⟨u,u⟩ ∈ id T` only exists after substitution; its
						// `u = u` sides are discharged by eqid facts
						pmxW = mizEmitPairMatrixDrvs(w.second, recDrv, ^mizEmitShOfRef);
						eqdW = mizEmitEqidDrvs(concat(pmxW, recDrv));
						poolW = concatA([recDrv, pmxW, eqdW]);
						// a CONJUNCTIVE witness body splits: two small
						// proofs joined by jca, instead of one whose
						// tableau blows the node cap on the pooled facts
						// (t65's 6-step proof was reachable and the whole-∧
						// attempt still died on `nodes`); the ∧-split of the
						// reduction is depth-gated at this point
						sub = switch (w.second) {
							FolBin(opW, wA, wB): if (opW != "and")
									mizEmitReduceA(hyps, prev, asm, w.second, maxFacts, maxSize,
										depth + 1, fresh, used, poolW)
								else switch (mizEmitReduceA(hyps, prev, asm, wA, maxFacts, maxSize,
										depth + 1, fresh, used, poolW).first) {
									None(): Pair(None(), false);
									Some(pA): switch (mizEmitReduceA(hyps, prev, asm, wB,
											maxFacts, maxSize, depth + 1, fresh, used, poolW).first) {
										None(): Pair(None(), false);
										Some(pB): {
											bJ = length(pA.steps);
											kJ = length(pA.factRefs);
											stJ = concatA([pA.steps, mizEmitShift(pB.steps, bJ, kJ),
												[FolPStep(FolBin("imp", asm, w.second), "jca",
													[FolPRefStep(bJ - 1),
													 FolPRefStep(bJ + length(pB.steps) - 1)])]]);
											Pair(Some(FolStepProof(stJ,
												concat(pA.factRefs, pB.factRefs),
												uniq(concat(pA.disjs, pB.disjs)))), false);
										}
									}
								};
							default: mizEmitReduceA(hyps, prev, asm, w.second, maxFacts, maxSize,
								depth + 1, fresh, used, poolW);
						};
						switch (sub.first) {
							None(): acc;
							Some(pr): {
								base = length(pr.steps);
								ws = mizEmitShift(^wsteps, base, 0);
								steps : ref [FolPStep] = ref concat(pr.steps, ws);
								emit = \form : FolForm, lemma : string, rs : [FolPRef] -> {
									steps := arrayPush(^steps, FolPStep(form, lemma, rs));
									length(^steps) - 1;
								};
								// spcegv is disjointed(A x, ps x)
								xr = toLowerCase(x);
								dj2 = fold(arrayPush(folFormVars(w.second), y), ^djr,
									\ac, v -> if (toLowerCase(v) == xr) ac
										else arrayPush(ac, Pair(xr, toLowerCase(v))));
								inV = FolPred("∈", [FolVar(y), FolApp("_V", [])]);
								sg = emit(FolBin("imp", inV, FolBin("imp", w.second, goal)),
									"spcegv", [FolPRefStep(base + w.first)]);
								vx = emit(inV, "vex", []);
								m1 = emit(FolBin("imp", w.second, goal), "ax-mp",
									[FolPRefStep(vx), FolPRefStep(sg)]);
								sy = emit(FolBin("imp", asm, goal), "syl",
									[FolPRefStep(base - 1), FolPRefStep(m1)]);
								Pair(Some(FolStepProof(^steps, pr.factRefs,
									uniq(concat(pr.disjs, dj2)))), false);
							}
						}
					}
				}
			}
		}
	});
}

// (A ⊆ B) / (A = B) under an assumption: the same fresh-variable matrix, closed
// by sylibr — mpbir's deduction twin — instead of mpbir
mizEmitCharGoalA(hyps : [FolForm], prev : [FolForm], asm : FolForm, goal : FolForm,
	a : FolTerm, b : FolTerm, op : string, lemma : string,
	maxFacts : int, maxSize : int, depth : int,
	fresh : ref int, used : Set<string>,
	direct : Pair<Maybe<FolStepProof>, bool>, recDrv : [MizEmitDrv]) -> Pair<Maybe<FolStepProof>, bool> {
	v = mizEmitFresh(fresh, used);
	matrix = FolBin(op, mizEmitMem(FolVar(v), a), mizEmitMem(FolVar(v), b));
	subGoal = FolQuant("forall", [v], matrix);
	sub = mizEmitReduceA(hyps, prev, asm, subGoal, maxFacts, maxSize, depth + 1,
		fresh, used, concat(recDrv,
			concatA([
				mizEmitEigenInsts(concatA([[asm], mizEmitConjuncts(asm, []), hyps, prev]), v),
				mizEmitElemTypeFacts(concatA([mizEmitConjuncts(asm, []), hyps, prev]), v),
				mizEmitClauseEx(concatA([[asm, goal], hyps, prev]))])));
	switch (sub.first) {
		None(): Pair(None(), direct.second || sub.second);
		Some(pr): {
			inst = FolBin("iff", goal, subGoal);
			vr = toLowerCase(v);
			dj = filtermap(uniq(concat(folFormVars(inst), folFormVars(asm))),
				\w -> if (w == vr) None() else Some(Pair(vr, w)));
			n0 = length(pr.steps);
			df = FolPStep(inst, lemma, []);
			sy = FolPStep(FolBin("imp", asm, goal), "sylibr",
				[FolPRefStep(n0 - 1), FolPRefStep(n0)]);
			Pair(Some(FolStepProof(concatA([pr.steps, [df, sy]]),
				pr.factRefs, uniq(concat(pr.disjs, dj)))), false);
		}
	}
}

// an IFF goal whose sides normalize into the same canonical ∨/DNF form
// closes by citation alone: NF both sides (membership leaves opened,
// opelxp included), then the ∨-walk / DNF walk joins the normal forms —
// this is the pointwise pair-membership family (`⟨a,b⟩ ∈ (X∪Y)×.Z ↔ …`)
// that used to case-split in the flat proof
mizEmitIffNFWalk(goal : FolForm) -> Maybe<FolStepProof> {
	switch (goal) {
		FolBin(op, l, r): if (op != "iff") None() else {
			rw : ref [FolPStep] = ref [];
			djBase = length(^mizEmitNFDjRef);
			emitRw = \form : FolForm, lemma : string, refs : [FolPRef] -> {
				rw := arrayPush(^rw, FolPStep(form, lemma, refs));
				length(^rw) - 1;
			};
			wl0 = mizEmitFormNF(rw, l, 0);
			wr0 = mizEmitFormNF(rw, r, 0);
			if (isNone(wl0) && isNone(wr0)) {
				// no membership to open — the walk may still join the sides
				switch (mizEmitOrIff(l, r)) {
					Some(w9): Some(w9);
					None(): mizEmitDnfIff(l, r);
				}
			} else {
				wl = switch (wl0) {
					Some(w): w;
					None(): Pair(emitRw(FolBin("iff", l, l), "biid", []), l);
				};
				wr = switch (wr0) {
					Some(w): w;
					None(): Pair(emitRw(FolBin("iff", r, r), "biid", []), r);
				};
				walk = if (wl.second == wr.second)
						Some(FolStepProof([FolPStep(FolBin("iff", wl.second, wr.second),
							"biid", [])], [], []))
					else switch (mizEmitOrIff(wl.second, wr.second)) {
						Some(w9): Some(w9);
						None(): mizEmitDnfIff(wl.second, wr.second);
					};
				switch (walk) {
					None(): None();
					Some(wp): {
						// walk steps first (last = NL↔NR), then the rewriting
						// block, then the three-way join to L↔R
						n = length(wp.steps);
						ws = mizEmitShift(^rw, n, 0);
						iL = n + wl.first;
						iR = n + wr.first;
						n0 = n + length(ws);
						j1 = FolPStep(FolBin("iff", l, wr.second), "bitri",
							[FolPRefStep(iL), FolPRefStep(n - 1)]);
						j2 = FolPStep(FolBin("iff", wr.second, r), "bicomi",
							[FolPRefStep(iR)]);
						j3 = FolPStep(goal, "bitri",
							[FolPRefStep(n0), FolPRefStep(n0 + 1)]);
						ndj = length(^mizEmitNFDjRef) - djBase;
						Some(FolStepProof(concatA([wp.steps, ws, [j1, j2, j3]]),
							wp.factRefs,
							uniq(concat(wp.disjs, subrange(^mizEmitNFDjRef, djBase, ndj)))));
					}
				}
			}
		}
		default: None();
	}
}

// rewrite the GOAL to normal form, prove that, and come back with mpbir
mizEmitGoalNF(hyps : [FolForm], prev : [FolForm], goal : FolForm,
	maxFacts : int, maxSize : int, depth : int,
	fresh : ref int, used : Set<string>, recDrv : [MizEmitDrv]) -> Maybe<FolStepProof> {
	rw : ref [FolPStep] = ref [];
	djBase = length(^mizEmitNFDjRef);
	switch (mizEmitFormNF(rw, goal, 0)) {
		None(): None();
		Some(w): {
			sub = mizEmitReduce(hyps, prev, w.second, maxFacts, maxSize,
				depth + 1, fresh, used, recDrv);
			switch (sub.first) {
				None(): None();
				Some(pr): {
					base = length(pr.steps);
					ws = mizEmitShift(^rw, base, 0);
					fin = FolPStep(goal, "mpbir",
						[FolPRefStep(base - 1), FolPRefStep(base + w.first)]);
					ndj = length(^mizEmitNFDjRef) - djBase;
					Some(FolStepProof(concatA([pr.steps, ws, [fin]]), pr.factRefs,
						uniq(concat(pr.disjs, subrange(^mizEmitNFDjRef, djBase, ndj)))));
				}
			}
		}
	}
}

// `A → ∀x C` from `∀x (A → C)` by 19.21v (its disjointness condition — x not
// free in A — is exactly when the two are the same statement), so a goal that
// alternates antecedents and binders is peeled the whole way down instead of
// stopping at the first implication.
mizEmitImpAll(hyps : [FolForm], prev : [FolForm], goal : FolForm,
	a : FolForm, r : FolForm, maxFacts : int, maxSize : int, depth : int,
	fresh : ref int, used : Set<string>, recDrv : [MizEmitDrv]) -> Pair<Maybe<FolStepProof>, bool> {
	switch (r) {
		FolQuant(q, vs, body): if (q != "forall" || vs == []) Pair(None(), false) else {
			v = vs[0];
			rest = if (length(vs) == 1) body else FolQuant("forall", tail(vs), body);
			if (mizEmitFreeIn(v, a)) Pair(None(), false)
			else {
				subGoal = FolQuant("forall", [v], FolBin("imp", a, rest));
				sub = mizEmitReduce(hyps, prev, subGoal, maxFacts, maxSize, depth + 1,
					fresh, used, recDrv);
				switch (sub.first) {
					None(): Pair(None(), sub.second);
					Some(pr): {
						inst = FolBin("iff", subGoal, goal);
						vr = toLowerCase(v);
						dj = filtermap(folFormVars(a), \w -> if (w == vr) None() else Some(Pair(vr, w)));
						n0 = length(pr.steps);
						sw = FolPStep(inst, "19.21v", []);
						mp = FolPStep(goal, "mpbi", [FolPRefStep(n0 - 1), FolPRefStep(n0)]);
						Pair(Some(FolStepProof(concatA([pr.steps, [sw, mp]]),
							pr.factRefs, uniq(concat(pr.disjs, dj)))), false);
					}
				}
			}
		}
		default: Pair(None(), false);
	}
}

// the connective cases of the reduction, unchanged
mizEmitBinGoal(hyps : [FolForm], prev : [FolForm], goal : FolForm,
	op : string, l : FolForm, r : FolForm, maxFacts : int, maxSize : int,
	depth : int, fresh : ref int, used : Set<string>,
	direct : Pair<Maybe<FolStepProof>, bool>, recDrv : [MizEmitDrv]) -> Pair<Maybe<FolStepProof>, bool> {
	{
			{
				// A BICONDITIONAL goal is proved as its two implications and joined
				// by impbii: one monolithic proof for `a ↔ b` is where the
				// equality family blows the tableau cap, while each direction on
				// its own stays small.
				if (op == "iff") {
					sa = mizEmitReduce(hyps, prev, FolBin("imp", l, r), maxFacts, maxSize,
						depth + 1, fresh, used, recDrv);
					switch (sa.first) {
						None(): Pair(None(), direct.second || sa.second);
						Some(pa): {
							sb = mizEmitReduce(hyps, prev, FolBin("imp", r, l), maxFacts, maxSize,
								depth + 1, fresh, used, recDrv);
							switch (sb.first) {
								None(): Pair(None(), direct.second || sb.second);
								Some(pb): {
									dS = length(pa.steps); dF = length(pa.factRefs);
									bs = mizEmitShift(pb.steps, dS, dF);
									jn = FolPStep(goal, "impbii",
										[FolPRefStep(dS - 1), FolPRefStep(dS + length(bs) - 1)]);
									Pair(Some(FolStepProof(concatA([pa.steps, bs, [jn]]),
										concat(pa.factRefs, pb.factRefs),
										uniq(concat(pa.disjs, pb.disjs)))), false);
								}
							}
						}
					}
				}
				else if (op != "and") direct
				else {
					sa = mizEmitReduce(hyps, prev, l, maxFacts, maxSize, depth + 1, fresh, used, recDrv);
					switch (sa.first) {
						None(): Pair(None(), direct.second || sa.second);
						Some(pa): {
							sb = mizEmitReduce(hyps, prev, r, maxFacts, maxSize, depth + 1, fresh, used, recDrv);
							switch (sb.first) {
								None(): Pair(None(), direct.second || sb.second);
								Some(pb): {
									dS = length(pa.steps); dF = length(pa.factRefs);
									bs = mizEmitShift(pb.steps, dS, dF);
									jn = FolPStep(goal, "pm3.2i",
										[FolPRefStep(dS - 1), FolPRefStep(dS + length(bs) - 1)]);
									Pair(Some(FolStepProof(concatA([pa.steps, bs, [jn]]),
										concat(pa.factRefs, pb.factRefs),
										uniq(concat(pa.disjs, pb.disjs)))), false);
								}
							}
						}
					}
				}
			}
	}
}

// an ∃ goal closes by ∃-INTRODUCTION at a witness: the binder itself
// (|- ψ then 19.8a + ax-mp) or a step element y (spei, its substitution
// hypothesis by the same congruence walk rung 3 uses). Witnesses are tried
// in order; the first whose instance the reduction can prove wins.
mizEmitExGoal(hyps : [FolForm], prev : [FolForm], goal : FolForm,
	vs : [string], body : FolForm,
	maxFacts : int, maxSize : int, depth : int,
	fresh : ref int, used : Set<string>,
	direct : Pair<Maybe<FolStepProof>, bool>, recDrv : [MizEmitDrv]) -> Pair<Maybe<FolStepProof>, bool> {
	x = vs[0];
	rest = if (length(vs) == 1) body else FolQuant("exists", tail(vs), body);
	// candidate witnesses: the step's element variables
	mems : ref [Pair<FolTerm, FolTerm>] = ref [];
	subs : ref [Pair<FolTerm, FolTerm>] = ref [];
	eqs  : ref [Pair<FolTerm, FolTerm>] = ref [];
	iter(arrayPush(filter(concat(hyps, prev), \f -> !mizEmitHasQuant(f)), body),
		\f -> mizEmitHarvest(f, mems, subs, eqs));
	names = uniq(filtermap(
		concatA(map(concatA([^mems, ^subs, ^eqs]), \p -> [p.first, p.second])),
		\t -> switch (t) { FolVar(n): Some(n); default: None(); }));
	cands = concat([x], filter(if (length(names) > 5) subrange(names, 0, 5) else names,
		\n -> n != x));
	fold(cands, direct, \acc : Pair<Maybe<FolStepProof>, bool>, y -> switch (acc.first) {
		Some(__): acc;
		None(): {
			if (y == x) {
				sub = mizEmitReduce(hyps, prev, rest, maxFacts, maxSize, depth + 1, fresh, used, recDrv);
				switch (sub.first) {
					None(): Pair(None(), acc.second || sub.second);
					Some(pr): {
						n0 = length(pr.steps);
						im = FolPStep(FolBin("imp", rest, goal), "19.8a", []);
						mp = FolPStep(goal, "ax-mp", [FolPRefStep(n0 - 1), FolPRefStep(n0)]);
						Pair(Some(FolStepProof(concatA([pr.steps, [im, mp]]),
							pr.factRefs, pr.disjs)), false);
					}
				}
			} else {
				wsteps : ref [FolPStep] = ref [];
				djr : ref [Pair<string, string>] = ref [];
				switch (mizEmitWalk(wsteps, djr, x, y, rest)) {
					None(): acc;
					Some(w): {
						sub = mizEmitReduce(hyps, prev, w.second, maxFacts, maxSize, depth + 1, fresh, used, recDrv);
						switch (sub.first) {
							None(): Pair(None(), acc.second || sub.second);
							Some(pr): {
								base = length(pr.steps);
								ws = mizEmitShift(^wsteps, base, 0);
								sp = FolPStep(goal, "spei",
									[FolPRefStep(base + w.first), FolPRefStep(base - 1)]);
								Pair(Some(FolStepProof(concatA([pr.steps, ws, [sp]]),
									pr.factRefs, uniq(concat(pr.disjs, ^djr)))), false);
							}
						}
					}
				}
			}
		}
	});
}

// (A ⊆ B) / (A = B) via its fresh-variable ∀-characterization + mpbir
// ---- THE EIGENVARIABLE'S OWN INSTANCES ----
// A ⊆ / = goal is proved by introducing a FRESH variable and proving the
// membership matrix for it. That variable is Mizar's skolem constant for the
// step, and the checker instantiates its premises AT it. We did not: the facts
// were built at the by-step level, where the variable does not exist yet, so a
// universal hypothesis like `∀x ( x is Element of A → ( x ∈ X → x ∈ Y ) )` sat
// over the leaf `x951 ∈ x29` as one opaque atom — the very thing the ∀-fact law
// forbids ("instantiate it at the goal's element, or drop it").
// The instance implication `∀x φ → φ[v]` is a self-contained fact with its own
// proof (spcgv + sethood), so the tableau detaches φ[v] from the hypothesis
// itself; nothing needs to be threaded through the reduction.
mizEmitEigenInsts(fs : [FolForm], v : string) -> [MizEmitDrv] {
	shOf = ^mizEmitShOfRef;
	cands = filter(uniq(fs), \f -> switch (f) {
		FolQuant(q, vs, __): q == "forall" && vs != [];
		default: false;
	});
	insts = filtermap(subrange(cands, 0, 4), \f -> {
		steps : ref [FolPStep] = ref [];
		dj : ref [Pair<string, string>] = ref [];
		x = switch (f) { FolQuant(__, vs, __): vs[0]; default: ""; };
		switch (mizEmitInstImp(steps, dj, f, x, FolVar(v), shOf, 0)) {
			None(): None();
			Some(im): if (^steps == []) None()
				else Some(MizEmitDrv((^steps)[length(^steps) - 1].form, ^steps, [], uniq(^dj)));
		}
	});
	insts;
}

// ---- THE RECORDED REFUTATION, RESTATED ABOUT OUR WITNESS ----
// The checker names the witness of an existential and then states its whole
// clause about that name. Our proof names its own witness — the binder the
// ∃-elimination introduces — so the record is unusable until the two names are
// identified. That is the last link of the replay: a free variable of the
// recorded instance that is NOT a variable of the step is the checker's
// constant, and substituting our binder for it turns the record into facts
// about a term we have.
//
// The instance is then rebuilt at those terms by the ordinary join (a
// foundation row, or a statement the skeleton index finds), so nothing is
// asserted that is not proved, and the step's endgame becomes what Mizar's is:
// the premise instance against the clause, over three or four formulas.
// the names the INSTANCE speaks of that the step does not: the checker's
// constants. Only the instance — the clause's literal list also carries the
// universal premise, whose own binders are no one's constants — and the
// comparison is case-insensitive, since the two variable readers disagree on
// case (the standing trap).
// variable names AS THE FORMULA CARRIES THEM (folFormVars lowercases)
mizEmitRawVars(f : FolForm, acc : [string]) -> [string] {
	switch (f) {
		FolPred(__, args): fold(args, acc, \a, t -> mizEmitRawVarsT(t, a));
		FolEq(l, r): mizEmitRawVarsT(r, mizEmitRawVarsT(l, acc));
		FolNeg(g): mizEmitRawVars(g, acc);
		FolBin(__, l, r): mizEmitRawVars(r, mizEmitRawVars(l, acc));
		FolQuant(__, __, b): mizEmitRawVars(b, acc);
	}
}

mizEmitRawVarsT(t : FolTerm, acc : [string]) -> [string] {
	switch (t) {
		FolVar(n): arrayPush(acc, n);
		FolApp(__, args): fold(args, acc, \a, t2 -> mizEmitRawVarsT(t2, a));
		FolAbs(__, b): mizEmitRawVars(b, acc);
	}
}

mizEmitClauseConsts(c : MizDerivClause, ctxVars : Set<string>) -> [string] {
	filter(uniq(folFormVars(c.instance)),
		\v -> !containsSet(ctxVars, toLowerCase(v)));
}

mizEmitProveFact(f : FolForm) -> Maybe<MizEmitDrv> {
	switch (mizEmitFoundFact(f)) {
		Some(d): Some(d);
		None(): mizEmitRecFromCites((^mizEmitBySkelRef)(mizEmitSkeleton(f)), f,
			^mizEmitStmtOfRef, ^mizEmitIsAxiomRef, ^mizEmitShOfRef);
	}
}

mizEmitClauseFactsAt(v : string, ctxForms : [FolForm]) -> [MizEmitDrv] {
	// FREE variables: folFormVars counts binders too, and the assumption's own
	// `∀ x7 …` then made x7 look like a variable of the step — which is exactly
	// the name the checker uses for its constant, so nothing was ever restated
	ctxVars = buildSet(map(concatA(map(ctxForms, mizFormFreeVars)), toLowerCase));
	vt = FolVar(v);
	concatA(map(^mizEmitStepClausesRef, \c -> {
		consts = mizEmitClauseConsts(c, ctxVars);
		// exactly one name to identify: with none there is nothing to restate,
		// with several the pairing is a choice and this walk makes none
		if (^mizEmitDbg && getUrlParameterDef("dbg-exelim", "") == "1")
			println("    CLAUSEFACT consts=" + strGlue(consts, ",")
				+ " inst=" + strGlue(folFormToks(c.instance), " "));
		if (length(consts) != 1) []
		else {
			// the substitution must use the variable's RAW spelling: folFormVars
			// lowercases and mizEmitSubF looks up what the term actually carries
			sub = fold(mizEmitRawVars(c.instance, []), makeTree(), \ac, rv ->
				if (toLowerCase(rv) == toLowerCase(consts[0])) setTree(ac, rv, vt) else ac);
			inst2 = mizEmitSubF(c.instance, sub);
			// the literals the record states about the constant become facts
			// about our binder as well, when they can be proved on their own
			lits2 = filtermap(c.lits, \pl -> {
				l2 = mizEmitSubF(pl.second, sub);
				if (!mizEmitFreeIn(v, l2)) None() else mizEmitProveFact(l2);
			});
			pf = mizEmitProveFact(inst2);
			if (^mizEmitDbg && getUrlParameterDef("dbg-exelim", "") == "1")
				println("    CLAUSEFACT-AT " + strGlue(folFormToks(inst2), " ")
					+ " proved=" + b2s(isSome(pf)));
			concat(switch (pf) {
				None(): [];
				Some(d): [d];
			}, subrange(lits2, 0, 2));
		}
	}));
}

// `x ∈ T` makes x an Element of T (miz_aux elti) — the type the checker gives
// its witness for free, and the form the step's own typed hypothesis needs.
mizEmitEltiAt(v : string, forms : [FolForm]) -> [MizEmitDrv] {
	vt = FolVar(v);
	sets = uniq(filtermap(concatA(map(forms, \f -> mizEmitAtomsOf(f, []))), \a -> switch (a) {
		FolPred(nm, args): if (nm != "∈" || length(args) != 2) None()
			else if (args[0] != vt) None() else Some(args[1]);
		default: None();
	}));
	map(subrange(sets, 0, 2), \t -> {
		form = FolBin("imp", FolPred("∈", [vt, t]), FolPred("element", [vt, t]));
		MizEmitDrv(form, [FolPStep(form, "elti", [])], [], []);
	});
}

// ---- WHERE THE CHECKER'S FRESH CONSTANTS COME FROM, GENERALLY ----
// The checker normalizes what it assumes, and every existential it meets is
// replaced by a fresh constant; the clause then speaks about those names. A
// proof of ours can use the clause only after the same witnesses exist here,
// and the record says exactly which ones it needs: a free variable of the
// recorded instance that is not a variable of the step IS such a constant, and
// the literals mentioning it say what it satisfies.
//
// So the existential to prove is READ OFF THE RECORD — `∃v (the clause's
// literals about the constant, at v)` — and proving it is the ordinary job of
// the fact machinery: a foundation lemma, a definition, a citation. Nothing
// here knows any particular formula; `¬ ( A = ∅ ) → ∃x ( x ∈ A )` is a lemma in
// miz_aux, not a case in the emitter.
// A name is the checker's constant when it is not the step's. What "the step's"
// means depends on where the walk stands: at a LEAF the goal has been peeled, so
// its own variables are free and the free ones are ours; ABOVE the peeling they
// are still bound by the goal's prefix, and there the honest test is that the
// name occurs nowhere in the step at all. One walk, two readings of the same
// rule — not two channels.
mizEmitClauseExAt(ctxVars : Set<string>) -> [MizEmitDrv] {
	concatA(map(^mizEmitStepClausesRef, \c -> {
		consts = mizEmitClauseConsts(c, ctxVars);
		concatA(map(subrange(consts, 0, 2), \k -> {
			// what the record says this name satisfies (positive literals only:
			// a negative one states what does NOT hold of it)
			// case-insensitively: the record's forms carry the raw spelling and
			// the name came through the lowercasing reader (the standing trap,
			// met three times in this walk — every comparison here goes through
			// mizEmitRawVars, which reads what the formula actually carries)
			mentions = \f9 : FolForm -> exists(mizEmitRawVars(f9, []),
				\rv -> toLowerCase(rv) == toLowerCase(k));
			about = filtermap(c.lits, \pl -> switch (pl.second) {
				FolNeg(__): None();
				default: if (mentions(pl.second)) Some(pl.second) else None();
			});
			if (about == []) [] else {
				v = "Xw" + i2s(sizeSet(ctxVars));
				sub = fold(mizEmitRawVars(about[0], []), makeTree(), \ac, rv ->
					if (toLowerCase(rv) == toLowerCase(k)) setTree(ac, rv, FolVar(v)) else ac);
				body = mizEmitSubF(about[0], sub);
				exForm = FolQuant("exists", [v], body);
				if (^mizEmitDbg && getUrlParameterDef("dbg-exelim", "") == "1")
					println("    CLAUSE-EX " + k + " :: " + strGlue(folFormToks(exForm), " "));
				// proved outright, or under a guard the step can discharge — the
				// guarded form is what the elimination's own candidate list takes
				concat(switch (mizEmitProveFact(exForm)) {
					None(): [];
					Some(d): [d];
				}, mizEmitFoundConcl(exForm));
			}
		}));
	}));
}

// at a leaf: the step's variables are the FREE ones
mizEmitClauseEx(ctxForms : [FolForm]) -> [MizEmitDrv] {
	mizEmitClauseExAt(buildSet(map(concatA(map(ctxForms, mizFormFreeVars)), toLowerCase)));
}

// above the peeling: every name the step mentions, bound or free, is ours
mizEmitClauseExAll(ctxForms : [FolForm]) -> [MizEmitDrv] {
	mizEmitClauseExAt(buildSet(map(concatA(map(ctxForms, folFormVars)), toLowerCase)));
}

// a foundation row whose CONCLUSION is `f`, as the implication it is: the row
// is stated `guard → f`, and the elimination discharges the guard from the
// step's own assumption. Matching rows by their conclusion is what makes the
// existential above provable without naming any lemma here.
mizEmitFoundConcl(f : FolForm) -> [MizEmitDrv] {
	metas = buildSet(["A", "B", "C", "D"]);
	filtermap(mizEmitFoundIffTable(), \row -> switch (row.second) {
		FolBin(op, l, r): if (op != "imp") None()
			else switch (mizEmitMatchF(r, f, metas, Some(makeTree()))) {
				None(): None();
				Some(sub): {
					inst = mizEmitSubF(row.second, sub);
					switch (inst) {
						// up to the names of the binders, like every other
						// comparison in this walk
						FolBin(__, __, r2): if (isNone(mizEmitMatchF(r2, f, makeSet(),
							Some(makeTree())))) None()
							else Some(MizEmitDrv(inst, [FolPStep(inst, row.first, [])], [], []));
						default: None();
					}
				}
			}
		default: None();
	});
}

// ---- MIZAR'S SOFT TYPE LAYER, AS FOUNDATION LEMMAS ----
// Mizar gives every term a type and the checker uses what a type MEANS without
// ever stating it: the information is in no citation and in no record, so a
// step reasoning about the elements of a Subset stops for want of a fact that
// nothing supplies. That meaning belongs in the foundation, not in every proof
// — `miz_aux.ru` now defines the mode (df-elt, SUBSET_1:def 1's two halves) and
// proves what it gives:
//   eltor   ( B = ∅ ) ∨ ( ( element A B ) ↔ ( A ∈ B ) )
//   elt0    ( B = ∅ ) → ( ( element A B ) ↔ ( A = ∅ ) )
//   elti    ( A ∈ B ) → ( element A B )
//   eltpwi  ( element A 𝒫 B ) → ( A ⊆ B )
//   eltss   ( element A 𝒫 B ) → ( ( C ∈ A ) → ( element C B ) )
// The emitter's job is then a CITATION, one step long, at the terms of the
// step. `eltss` is the rule a subset-goal leaf needs: its eigenvariable is a
// member of a Subset, so it is an Element of the underlying set, and the
// step's typed hypothesis applies to it.
mizEmitElemTypeFacts(ctx : [FolForm], v : string) -> [MizEmitDrv] {
	vt = FolVar(v);
	// the typed context facts: `X is Element of 𝒫A`
	pairs = filtermap(uniq(ctx), \f -> switch (f) {
		FolPred(nm, args): if (nm != "element" || length(args) != 2) None()
			else switch (args[1]) {
				FolApp(fn, fa): if (fn != "𝒫" || length(fa) != 1) None()
					else Some(Pair(args[0], fa[0]));
				default: None();
			}
		default: None();
	});
	map(subrange(pairs, 0, 2), \pr -> {
		form = FolBin("imp", FolPred("element", [pr.first, FolApp("𝒫", [pr.second])]),
			FolBin("imp", FolPred("∈", [vt, pr.first]),
				FolPred("element", [vt, pr.second])));
		MizEmitDrv(form, [FolPStep(form, "eltss", [])], [], []);
	});
}

mizEmitCharGoal(hyps : [FolForm], prev : [FolForm], goal : FolForm,
	a : FolTerm, b : FolTerm, op : string, lemma : string,
	maxFacts : int, maxSize : int, depth : int,
	fresh : ref int, used : Set<string>,
	direct : Pair<Maybe<FolStepProof>, bool>, recDrv : [MizEmitDrv]) -> Pair<Maybe<FolStepProof>, bool> {
	v = mizEmitFresh(fresh, used);
	matrix = FolBin(op, mizEmitMem(FolVar(v), a), mizEmitMem(FolVar(v), b));
	subGoal = FolQuant("forall", [v], matrix);
	sub = mizEmitReduce(hyps, prev, subGoal, maxFacts, maxSize, depth + 1, fresh, used,
		concatA([recDrv, mizEmitEigenInsts(concat(hyps, prev), v),
			mizEmitElemTypeFacts(concat(hyps, prev), v)]));
	switch (sub.first) {
		None(): Pair(None(), direct.second || sub.second);
		Some(pr): {
			inst = FolBin("iff", goal, subGoal);
			vr = toLowerCase(v);
			dj = filtermap(folFormVars(inst), \w -> if (w == vr) None() else Some(Pair(vr, w)));
			n0 = length(pr.steps);
			df = FolPStep(inst, lemma, []);
			mp = FolPStep(goal, "mpbir", [FolPRefStep(n0 - 1), FolPRefStep(n0)]);
			Pair(Some(FolStepProof(concatA([pr.steps, [df, mp]]),
				pr.factRefs, uniq(concat(pr.disjs, dj)))), false);
		}
	}
}

mizEmitLadder(hyps : [FolForm], prev : [FolForm], goal : FolForm,
	maxFacts : int, maxSize : int, recDrv : [MizEmitDrv]) -> Pair<Maybe<FolStepProof>, bool> {
	mizEmitLadderA(hyps, prev, goal, maxFacts, maxSize, recDrv, None());
}

// `asm` is the ASSUMED formula of a deduction step: it joins the facts the
// ladder reasons from, and the proof concludes `asm → goal` instead of
// `goal` (folPCertAssuming). Everything else — unfolds, bridges, instances,
// relevance — sees it as an ordinary fact, which is the point: an implication
// goal was reaching the proof whole, with nothing to reason from.
mizEmitLadderA(hyps : [FolForm], prev : [FolForm], goal : FolForm,
	maxFacts : int, maxSize : int, recDrv : [MizEmitDrv],
	asm : Maybe<FolForm>) -> Pair<Maybe<FolStepProof>, bool> {
	ctx0 = concat(
		mapi(hyps, \j, h -> Pair(h, mizEmitHypRef(j))),
		mapi(prev, \j, s -> Pair(s, mizEmitStepRef(j))));
	// quantified facts stay as OPAQUE atoms — sharing no atoms with anything,
	// relevance drops them unless a characterization instance (df-ss/dfcleq)
	// links them to a ⊆/= atom, which is exactly when they are needed
	ctx = ctx0;
	allForms = concat(arrayPush(map(filter(ctx, \p -> !mizEmitHasQuant(p.first)),
		\p -> p.first), goal),
		switch (asm) { None(): []; Some(af): if (mizEmitHasQuant(af)) [] else [af]; });
	insts0 = fold(allForms, makeTree(), \acc, f -> mizEmitUnfolds(f, acc));
	// LADDER: rung 1 membership unfolds alone; rung 2 adds the ⊆/= bridges;
	// rung 3 adds ∀-INSTANCES of the quantified local facts (spv + walk)
	r1 = mizEmitTry(ctx, goal, getTreeValues(insts0), recDrv, maxFacts, maxSize, asm);
	switch (r1.first) {
		Some(__): r1;
		None(): if (r1.second) r1 else {
			bridged = getTreeValues(mizEmitBridges(allForms, insts0));
			r20 = mizEmitTry(ctx, goal, bridged, recDrv, maxFacts, maxSize, asm);
			// RUNG 2R — THE RECORD WHOLESALE: when the checker's record supplies
			// facts for this step, attempt with THAT pool and its own bridges
			// and unfolds before any speculative candidate joins. The record IS
			// the selection — three rounds of score tuning could not assemble a
			// chain the checker had already written down.
			r2 = switch (r20.first) {
				Some(__): r20;
				None(): {
					drvR = mizEmitDrvInsts(recDrv,
						arrayPush([goal], switch (asm) { None(): goal; Some(af): af; }),
						^mizEmitShOfRef);
					if (drvR == []) r20 else {
						allR = concat(allForms, map(drvR, \d -> d.form));
						iR = fold(allR, makeTree(), \acc, f -> mizEmitUnfolds(f, acc));
						mizEmitTry(ctx, goal,
							getTreeValues(mizEmitBridges(allR, iR)), drvR, maxFacts, maxSize, asm);
					}
				}
			};
			switch (r2.first) {
				Some(__): r2;
				None(): if (r2.second) r2 else {
					// the GOAL'S OWN OPERATOR DEFINITIONS (field, k2_relat_1, …)
					// join rung 3 like every other derived instance: the whole
					// imp(v1_relat_1,…) family states an equation between DEFINED
					// terms, and the ladder saw those terms as opaque atoms. This
					// was measured a dead end before the greedy/ascending selection
					// existed ("defs of every symbol blew the budget"); the caps
					// mirror the ∃-chain's (one def per symbol, three total).
					stmtOfG0 = ^mizEmitStmtOfRef;
					defsOfG = ^mizEmitDefsOfSymRef;
					gAtomsG = uniq(concatA(map(
						arrayPush([goal], switch (asm) { None(): goal; Some(af): af; }),
						\gf -> mizEmitAtomsOf(gf, []))));
					// THE BINDER-COLLISION TRAP, at this application site as at every
					// other: a definition's locus renders as the same id as the
					// theorem's variable (d6's X26), so a witness containing x26
					// reads as "binder in witness" and every compound instance is
					// refused. Alpha-rename the statement's bound variables away
					// from everything the step mentions before matching.
					avoidG = ref buildSet(concatA(map(gAtomsG, mizFormAllVars)));
					ctrG = ref 0;
					stmtOfG = \nm5 : string -> switch (stmtOfG0(nm5)) {
						None(): None();
						Some(st5): Some(mizFreshenBound(st5, avoidG, ctrG));
					};
					gSymsG = uniq(concatA(map(gAtomsG, mizFormSymbols)));
					gDefs0 = concatA(map(gSymsG, \sy -> {
						ds = defsOfG(sy);
						if (^mizEmitDbg && getUrlParameterDef("dbg-gdefs", "") == "1")
							println("  GDEFS sym=" + sy + " ds=" + strGlue(ds, ","));
						// ONE def per symbol, but an instance PER OCCURRENCE TERM:
						// t21 needs `field` defined at BOTH `field x26` and
						// `field (k2_relat_1 x26)`, and the term matcher stops at
						// its first match — so it is steered per term through a
						// synthetic one-term atom
						sts0 = uniqBy(concatA(map(gAtomsG, \a2 -> mizEmitSymTerms(a2, sy))),
							\a2, b2 -> mizEmitTKey(a2) == mizEmitTKey(b2));
						sts = if (length(sts0) > 3) subrange(sts0, 0, 3) else sts0;
						concatA(map(if (length(ds) > 1) subrange(ds, 0, 1) else ds,
							\nm2 -> filtermap(sts, \tt -> {
								r5 = mizEmitDefInstance(nm2, sy, [FolPred("$dt", [tt])], stmtOfG, ^mizEmitShOfRef);
								if (^mizEmitDbg && isNone(r5))
									println("  GDEF-DECLINE " + nm2 + " @ " + strGlue(folFormToks(FolPred("$dt", [tt])), " "));
								r5;
							})));
					}));
					gDefs1 = uniqBy(map(gDefs0, mizEmitCleanIff),
						\d2, d3 -> mizEmitKey(d2.form) == mizEmitKey(d3.form));
					gDefs = if (length(gDefs1) > 6) subrange(gDefs1, 0, 6) else gDefs1;
					// THE STEP'S CITED STATEMENTS, instantiated at this stage's free
					// variables: a step with no record facts got nothing from its
					// by-list, and the ∀-closed citation was invisible to relevance.
					// The stage where the theorem's ∀ has been peeled is exactly
					// where the citation's binder has something to bind to.
					// the GOAL'S free variables only: instantiating the citations at
					// every variable of every form put 77 candidates against a
					// 10-slot ranked cut and crowded out t2_xboole_0's needed facts
					fvs0 = uniq(concat(folFormVars(goal),
						switch (asm) { None(): []; Some(af): folFormVars(af); }));
					fvs = if (length(fvs0) > 4) subrange(fvs0, 0, 4) else fvs0;
					citeDrvs0 = concatA(map(^mizEmitCiteStmtsRef, \pc ->
						if (!mizEmitIsForall(pc.second)) {
							if (folFormVars(pc.second) != []) [] else
								[MizEmitDrv(pc.second, [FolPStep(pc.second, pc.first, [])], [], [])];
						} else {
							nbc = mizEmitPrefixLen(pc.second);
							tuples = if (nbc == 1) map(fvs, \e -> [e])
								else if (nbc == 2) concatA(map(fvs, \e1 -> map(fvs, \e2 -> [e1, e2])))
								else [];
							// CAPTURE GUARD: a witness must be the binder itself
							// (spi) or a name FOREIGN to the statement — putting one
							// binder's name under another's ∀ was the albidv/spv
							// disjointedness violation the verifier caught
							// variable names differ in CASE between the statement's AST
							// (binders "X7") and the rendered free vars ("x7") — the
							// guard must compare lowercased or it passes everything
							sVars = buildSet(map(mizFormAllVars(pc.second), toLowerCase));
							tpsOk = filter(tuples, \tp -> foldi(tp, true, \bi, ok, y -> {
								ok && (toLowerCase(mizEmitBinderAt(pc.second, bi)) == toLowerCase(y)
									|| !containsSet(sVars, toLowerCase(y)));
							}));
							tps = if (length(tpsOk) > 2) subrange(tpsOk, 0, 2) else tpsOk;
							varDrvs = filtermap(tps, \tp -> mizEmitInstCite(pc.first, pc.second, tp));
							// TERM witnesses: tuples over the goal/asm's compound
							// subterms (at least one compound element — the all-var
							// tuples are the var route's)
							comps0 = uniqBy(concat(mizEmitCompTerms(goal),
									switch (asm) { None(): []; Some(af9): mizEmitCompTerms(af9); }),
								\a2, b2 -> mizEmitTKey(a2) == mizEmitTKey(b2));
							comps = if (length(comps0) > 3) subrange(comps0, 0, 3) else comps0;
							poolT = concat(comps, map(fvs, \v9 -> FolVar(v9)));
							tuplesT0 = if (nbc == 1) map(comps, \e -> [e])
								else if (nbc == 2) filter(
									concatA(map(poolT, \e1 -> map(poolT, \e2 -> [e1, e2]))),
									\tp9 -> exists(tp9, \w9 -> switch (w9 : FolTerm) {
										FolApp(__, __): true;
										default: false;
									}))
								else [];
							tuplesT = if (length(tuplesT0) > 6) subrange(tuplesT0, 0, 6) else tuplesT0;
							termDrvs = filtermap(tuplesT, \tp ->
								mizEmitInstCiteT(pc.first, pc.second, tp, ^mizEmitShOfRef));
							concat(varDrvs, termDrvs);
						}));
					// HYPOTHETICAL CITATION: a theorem emitted with hypotheses is
					// cited by stating an instance of its proposition; one
					// reference per substituted hypothesis, discharged from ctx
					// FACTS (never the assumption), or as t ⊆ t (ssid) / t = t
					// (eqid). t51_relat_1's hyps = a v1 ctx fact + ssid.
					if (^mizEmitCiteHypsRef != []) {
						mizEmitHypCands := ^mizEmitHypCands + 1;
						if (ctx0 != []) mizEmitHypBump("cand-ctx@" + ^mizEmitCurThmRef);
					}
					hypDrvs0 = concatA(map(^mizEmitCiteHypsRef, \ph -> {
						prop9 = ph.second.first;
						hs9 = ph.second.second;
						pvs9 = uniq(folFormVars(prop9));
						if (pvs9 == []) { mizEmitHypBump("no-free-vars"); []; }
						else {
							// substitutions COMPUTED from the hypotheses (ctx matches
							// + ssid/eqid side-binding); statement variables the
							// hypotheses leave unbound are filled from the goal pool
							comps8 = uniqBy(concat(mizEmitCompTerms(goal),
									switch (asm) { None(): []; Some(af8): mizEmitCompTerms(af8); }),
								\a2, b2 -> mizEmitTKey(a2) == mizEmitTKey(b2));
							pool9 : [FolTerm] = concat(map(fvs, \v9 -> FolVar(v9)),
								if (length(comps8) > 6) subrange(comps8, 0, 6) else comps8);
							subs9 = mizEmitHypCiteSubs(hs9, pvs9, ctx0);
							if (subs9 == []) mizEmitHypBump("no-sub-computed");
							if (^mizEmitDbg)
								println("  HYPSUBS " + ph.first
									+ " pvs=" + strGlue(pvs9, ",")
									+ " subs=" + i2s(length(subs9))
									+ " hyps: " + strGlue(map(hs9,
										\h9 -> strGlue(folFormToks(h9), " ")), " ; ")
									+ " || ctx=" + i2s(length(ctx0)) + " :: "
									+ strGlue(map(ctx0, \p9 ->
										strGlue(folFormToks(p9.first), " ")), " ; "));
							tps0 = concatA(map(subs9, \s9 -> {
								miss9 = filter(pvs9, \v9 -> !containsKeyTree(s9, v9));
								if (miss9 == []) [map(pvs9, \v9 ->
									lookupTreeDef(s9, v9, FolVar(v9)))]
								else if (length(miss9) > 1) { mizEmitHypBump("unbound-gt-1"); []; }
								else map(pool9, \w9 -> map(pvs9, \v9 ->
									if (v9 == miss9[0]) w9
									else lookupTreeDef(s9, v9, FolVar(v9))));
							}));
							tps9 = if (length(tps0) > 24) subrange(tps0, 0, 24) else tps0;
							filtermap(tps9, \tp ->
								mizEmitInstCiteH(ph.first, prop9, hs9, pvs9, tp, ctx0));
						}
					}));
					mizEmitHypMade := ^mizEmitHypMade + length(hypDrvs0);
					if (^mizEmitDbg && ^mizEmitCiteHypsRef != [])
						println("  CITE-HYP cands=" + i2s(length(^mizEmitCiteHypsRef))
							+ " made=" + i2s(length(hypDrvs0))
							+ " :: " + strGlue(map(hypDrvs0, \d9 -> strGlue(folFormToks(d9.form), " ")), " ;; "));
					// the TYPE LAYER's own channel: the registrations that type the step's
					// terms, instantiated where they fire. Cited by nobody, so nothing else
					// can supply them.
					// only where the checker actually used a TYPE rule: offering these at
					// every step doubled the emit time for two theorems — the whole point
					// of the record's codes is that a channel need not fire everywhere
					regDrvs = if (!mizEmitStepIsTyped()) []
						else concat(
							mizEmitRegDrvs(goal, asm, ^mizEmitStmtOfRef, ^mizEmitShOfRef),
							// ...and the MEANING of the step's Mizar types, which the checker
							// uses without citing it
							mizEmitTypeIffDrvs(goal, asm, ^mizEmitStmtOfRef, ^mizEmitShOfRef));
					if (^mizEmitDbg && regDrvs != [])
						println("  REG " + i2s(length(regDrvs)) + " :: "
							+ strGlue(map(regDrvs, \d9 -> strGlue(folFormToks(d9.form), " ")), " ; "));
					citeDrvs1 = uniqBy(concatA([citeDrvs0, hypDrvs0, regDrvs]),
						\d2, d3 -> mizEmitKey(d2.form) == mizEmitKey(d3.form));
					citeDrvs = if (length(citeDrvs1) > 12) subrange(citeDrvs1, 0, 12) else citeDrvs1;
					// a GUARDED instance (`Relation (X~) → field (X~) = …`) is inert
					// until its guard is a fact, and the guard's source — a cluster
					// registration / constructor-type axiom — is cited by NOBODY:
					// derive it by skeleton, exactly as the top-level channel does
					gdOf = \ds4 : [MizEmitDrv] -> concatA(map(ds4, \d4 -> switch (d4.form) {
						FolBin(op4, l4, __): if (op4 != "imp") [] else
							mizEmitGuardedInsts((^mizEmitBySkelRef)(mizEmitSkeleton(l4)),
								l4, stmtOfG, ^mizEmitIsAxiomRef, ^mizEmitShOfRef, 2);
						default: [];
					}));
					// THE ∀-ASSUMPTION'S DEDUCTION TWIN: a quantified antecedent
					// is one opaque atom to the tableau. Its instances arrive as
					// implications `asm → φ(t)` (sp / spcgv+sethood chain), which
					// the propositional proof chains with the assumption itself.
					// Witnesses: the stage's free variables, then the goal's
					// compound subterms. One binder deep — the t2_xboole_0 class
					// (a ∀-antecedent in a reshaped implication-form theorem).
					asmDrvs = switch (asm) {
						None(): [];
						Some(af): switch (af) {
							FolQuant(q8, vs8, __): if (q8 != "forall" || vs8 == []) [] else {
								comps7 = uniqBy(mizEmitCompTerms(goal),
									\a2, b2 -> mizEmitTKey(a2) == mizEmitTKey(b2));
								wits8 = concat(map(fvs, \v8 -> FolVar(v8)),
									if (length(comps7) > 2) subrange(comps7, 0, 2) else comps7);
								filtermap(if (length(wits8) > 5) subrange(wits8, 0, 5) else wits8,
									\w8 -> {
										st8 : ref [FolPStep] = ref [];
										dj8 : ref [Pair<string, string>] = ref [];
										switch (mizEmitInstImp(st8, dj8, af, vs8[0], w8,
												^mizEmitShOfRef, 0)) {
											None(): None();
											Some(p8): Some(MizEmitDrv((^st8)[p8.first].form,
												^st8, [], uniq(^dj8)));
										}
									});
							}
							default: [];
						}
					};
					goalForms3 = arrayPush([goal], switch (asm) { None(): goal; Some(af): af; });
					// the def instances go through the SAME ∀-elimination as the
					// record facts: a means-definition's instance keeps its inner
					// ∀ (x ∈ it ↔ …) and as an opaque atom it shares nothing —
					// relevance dropped every enum-family definition unseen
					gDefsI = mizEmitDrvInsts(gDefs, goalForms3, ^mizEmitShOfRef);
					drv0 = concatA([mizEmitDrvInsts(recDrv, goalForms3, ^mizEmitShOfRef),
						gDefsI, gdOf(gDefsI), asmDrvs,
						mizEmitCtxNF(ctx0),
						mizEmitChars(ctx0), mizEmitDerive(ctx0, allForms)]);
					// the element bridge's implications for the flat proof
					// (the chains derive the same through their guard prover)
					drv = concat(drv0, mizEmitElemBridgeDrvs(asm, drv0));
					// THE LIBRARY TABLE, for every goal shape. A row may be unguarded
					// (mizEmitFoundIffGoal) or carry sethood guards
					// (mizEmitFoundGuardedEq); which one applies is a property of the
					// ROW, not of the goal, so both are tried at every shape.
					// MERGE-LOG REPLAY: an equation goal gets its chain BUILT — a
					// proof-producing congruence closure over the candidate
					// equations — not selected: the flat cut is structurally too
					// small for the equalizer family (t21_relat_1, measured 4x)
					foundTbl = \g9 : FolForm -> switch (mizEmitFoundIffGoal(g9, asm)) {
						Some(r7): Some(r7);
						None(): switch (mizEmitFoundGuardedEq(g9, asm)) {
							Some(r5): Some(r5);
							// the checker writes an implication as a denied conjunction
							None(): mizEmitFoundNegGoal(g9, asm);
						};
					};
					chainR = switch (goal) {
						FolEq(__, __): {
							drvC = concatA([drv, citeDrvs, gdOf(citeDrvs)]);
							r9 = mizEmitEqChain(ctx0, goal, asm, drvC);
							switch (r9) {
								Some(__): r9;
								// antisymmetry: the two inclusion chains (eqssi)
								None(): switch (mizEmitSsChain(ctx0, goal, asm, drvC)) {
									Some(r8): Some(r8);
									// ...and the LIBRARY IDENTITY table: an equation
									// that IS a foundation lemma (pwsn, unipw, xpundir,
									// difxp1, …) is one citation, not a proof. The
									// table was only consulted for ⊆ and ↔ goals, so
									// equations went to the flat search and ran past
									// the size cap — seven of zfmisc_1's over-cap
									// steps are exactly such identities.
									None(): foundTbl(goal);
								}
							}
						}
						FolPred(gn9, ga9): if (gn9 == "element")
							// a Mizar TYPE goal has its own fixed shape (no search).
							// Since the mode became foundation-provided, the type
							// LEMMAS are rows like any other — `element ∅ 𝒫 B` is
							// elt0pw, one citation — so the table is the fallback.
							switch (mizEmitTypeGoal(goal, asm, ^mizEmitStmtOfRef, ^mizEmitShOfRef)) {
								Some(r7): Some(r7);
								None(): foundTbl(goal);
							}
							else if (gn9 == "⊆" && length(ga9) == 2)
							// an inclusion goal may ALSO be a library row (pwuni, uniin,
							// xpss1): the chain runs first, the table catches what no
							// chain of the offered edges can join
							switch (mizEmitSsChain(ctx0, goal, asm,
								concatA([drv, citeDrvs, gdOf(citeDrvs)]))) {
								Some(r6): Some(r6);
								None(): foundTbl(goal);
							}
							else foundTbl(goal);
						FolBin(gop9, __, __): if (gop9 == "iff")
							foundTbl(goal)
							// an IMPLICATION goal can be a library equivalence's half
							// (xtuple_0's pair injectivity is opthg's forward half) —
							// the table was never consulted for this shape at all
							else if (gop9 == "imp") foundTbl(goal)
							else None();
						// a DENIED CONJUNCTION is the checker's spelling of an
						// implication — the library row is matched through the bridge
						FolNeg(__): foundTbl(goal);
						default: None();
					};
					r3 = if (isSome(chainR)) Pair(chainR, false)
					else if (drv == []) r2
					else {
						// unfolds/bridges over the instances too
						all2 = concat(allForms, map(drv, \d -> d.form));
						i2 = fold(all2, makeTree(), \acc, f -> mizEmitUnfolds(f, acc));
						mizEmitTry(ctx, goal,
							getTreeValues(mizEmitBridges(all2, i2)), drv, maxFacts, maxSize, asm);
					};
					switch (r3.first) {
						Some(__): r3;
						// RUNG 4 — the CITED statements join only when everything
						// without them failed: as ordinary candidates they crowded
						// the ranked cut and cost a closing theorem (t2_xboole_0)
						None(): if (citeDrvs == []) r3 else {
							drv4 = concatA([drv, citeDrvs, gdOf(citeDrvs)]);
							all4 = concat(allForms, map(drv4, \d -> d.form));
							i4 = fold(all4, makeTree(), \acc, f -> mizEmitUnfolds(f, acc));
							mizEmitTry(ctx, goal,
								getTreeValues(mizEmitBridges(all4, i4)), drv4, maxFacts, maxSize, asm);
						}
					}
				}
			}
		}
	}
}

// A DERIVED fact that is universally quantified is as opaque to the proof
// as a context one, and for the same reason: it shares no atom with anything
// until it is instantiated. A means-definition unfolds to exactly such a fact
// (`∀x (x ∈ f(ā) ↔ φ)`), so it is instantiated at the elements of the GOAL, by
// the same elimination the context facts use, and REPLACED by its instances —
// keeping the ∀ form as well only spends the budget.
mizEmitDrvInsts(drvs : [MizEmitDrv], goalForms : [FolForm],
	shOf : (string) -> string) -> [MizEmitDrv] {
	mems : ref [Pair<FolTerm, FolTerm>] = ref [];
	subs : ref [Pair<FolTerm, FolTerm>] = ref [];
	eqs  : ref [Pair<FolTerm, FolTerm>] = ref [];
	iter(goalForms, \f -> mizEmitHarvest(f, mems, subs, eqs));
	elems0 = uniqBy(map(^mems, firstOfPair), \a, b -> mizEmitTKey(a) == mizEmitTKey(b));
	// ONE element: the goal's first. A definition instantiated at every element
	// in sight put 25 facts in front of a 16-fact budget, and the relevance
	// filter cannot tell them apart — they all mention the goal's atoms.
	elems = if (length(elems0) > 1) subrange(elems0, 0, 1) else elems0;
	concatA(map(drvs, \d -> switch (d.form) {
		FolQuant(q, vs, __): if (q != "forall" || length(vs) != 1 || d.steps == []) {
				if (^mizEmitDbg && getUrlParameterDef("dbg-gdefs", "") == "1")
					println("  DRVINST-KEPT-OPAQUE q=" + q + " vs=" + i2s(length(vs))
						+ " steps=" + i2s(length(d.steps))
						+ " :: " + strGlue(folFormToks(d.form), " "));
				[d];
			}
			else {
				got = filtermap(elems, \e -> {
					steps : ref [FolPStep] = ref d.steps;
					dj : ref [Pair<string, string>] = ref d.disjs;
					switch (mizEmitElimAt(steps, dj, d.form, length(d.steps) - 1, vs[0], e, shOf, 0)) {
						None(): {
							if (^mizEmitDbg && getUrlParameterDef("dbg-gdefs", "") == "1")
								println("  DRVINST-ELIM-FAIL @ " + mizEmitTKey(e)
									+ " :: " + strGlue(folFormToks(d.form), " "));
							None();
						}
						Some(fin): Some(mizEmitCleanIff(MizEmitDrv(fin.first, ^steps, d.refs, uniq(^dj))));
					}
				});
				// a ∀-fact that could not be instantiated is DROPPED, not kept: to
				// the tableau it is one opaque atom that matches nothing, and its
				// size is what pushed 43 of enumset1's 95 steps over the budget
				got;
			}
		default: [d];
	}));
}

mizEmitTry(ctx : [Pair<FolForm, RuParseRef>], goal : FolForm,
	instList0 : [Pair<FolForm, string>], drv : [MizEmitDrv],
	maxFacts : int, maxSize : int, asm : Maybe<FolForm>) -> Pair<Maybe<FolStepProof>, bool> {
	// a degenerate instance `A ↔ A` proves nothing and still spends the budget
	// — under the ranking it even outranks a real unfold, being small and full
	// of goal atoms (t74_xboole_1 kept two of these and lost the elin it needed)
	instList = filter(instList0, \p -> switch (p.first) {
		FolBin(op, l, r): op != "iff" || l != r;
		default: true;
	});
	work = ^mizEmitWorkRef + 1;
	mizEmitWorkRef := work;
	cap = ^mizEmitWorkCapRef;
	if (cap > 0 && work > cap) Pair(None(), true) else {
	atoms : ref Tree<string, FolForm> = ref makeTree();
	ctxP0 = map(ctx, \p -> mizEmitP(atoms, p.first));
	instP0 = map(instList, \p -> mizEmitP(atoms, p.first));
	drvP0 = map(drv, \d -> mizEmitP(atoms, d.form));
	goalP = mizEmitP(atoms, goal);
	asmP = maybeMap(asm, \af -> mizEmitP(atoms, af));
	r0 = mizEmitTrySel(ctx, goal, instList, drv, maxFacts, maxSize,
		atoms, ctxP0, instP0, drvP0, goalP, 1000000, asm, asmP);
	switch (r0.first) {
		Some(__): r0;
		None(): if (!r0.second) r0
			// over budget with the full relevance closure: retry with DIRECT
			// (1-hop) relevance — most by-steps use immediately related facts
			else mizEmitTrySel(ctx, goal, instList, drv, maxFacts, maxSize,
				atoms, ctxP0, instP0, drvP0, goalP, 1, asm, asmP);
	}
	}
}

mizEmitTrySel(ctx : [Pair<FolForm, RuParseRef>], goal : FolForm,
	instList : [Pair<FolForm, string>], drv : [MizEmitDrv],
	maxFacts : int, maxSize : int, atoms : ref Tree<string, FolForm>,
	ctxP0 : [RuPForm], instP0 : [RuPForm], drvP0 : [RuPForm], goalP : RuPForm,
	hops : int, asm : Maybe<FolForm>, asmP : Maybe<RuPForm>) -> Pair<Maybe<FolStepProof>, bool> {
	// RELEVANCE: keep only facts/unfolds connected to the goal through shared
	// atoms (`hops` rounds) — an unrelated fact only inflates the G3cp tree.
	// The ASSUMPTION goes in last so the index ranges below are untouched, and
	// it is never dropped: without it the proof would prove `goal`, not
	// `asm → goal`. Relevance still runs THROUGH it, which is how a fact that
	// only relates to the antecedent survives.
	// A goal with NO atoms — `¬ ⊤`, the QED step of a Mizar proof by
	// contradiction — is connected to nothing, so relevance dropped every fact
	// and the refutation was attempted empty-handed. The contradiction lives in
	// the FACTS there; keep them all and let the ranking cap the count.
	all = concatA([ctxP0, instP0, drvP0,
		switch (asmP) { None(): []; Some(ap): [ap]; }]);
	// the merge-log seed keys extend the closure's SEED: a fact stating an
	// equation the checker consumed is relevant by decree, not by reachability
	gseed = foldSet(^mizEmitSeedKeysRef, mizEmitAtomKeys(goalP, makeSet()),
		\s9, k9 -> insertSet(s9, k9));
	rel = if (isEmptySet(mizEmitAtomKeys(goalP, makeSet())))
			buildSet(enumFromTo(0, length(all) - 1))
		else mizEmitRelClose(map(all, \f9 -> mizEmitAtomKeys(f9, makeSet())),
			gseed, makeSet(), hops);
	// ASCENDING FACT LADDER: a small sufficient set gives a small proof — and
	// the emitted TEXT scales with context × steps, so a step closed from the
	// full relevance set when a 4-fact core sufficed is what quadrupled the
	// emitted articles. Attempt greedy-4 and greedy-8 first; the full set (and
	// the ranked/descending machinery behind it) is only paid when a small
	// context cannot close the step. A failed small attempt is cheap: its
	// G3cp tree is bounded by its own fact count.
	gk0 = foldSet(^mizEmitSeedKeysRef,
		mizEmitAtomKeys(goalP,
			switch (asmP) { None(): makeSet(); Some(ap): mizEmitAtomKeys(ap, makeSet()); }),
		\s9, k9 -> insertSet(s9, k9));
	allF = concatA([ctxP0, instP0, drvP0]);
	cands = filter(mapi(allF, \j, f -> Pair(j, f)), \pr -> containsSet(rel, pr.first));
	catoms = map(cands, \pr -> mizEmitAtomKeys(pr.second, makeSet()));
	// The rungs START AT ZERO. Every line of a flat proof restates the
	// accumulated context, so a fact the proof never uses widens the WHOLE
	// proof: t94's residue is a two-atom tautology whose lines still carry
	// 2551 bytes of context, most of it facts that tautology never touches.
	// A 0/1/2-fact attempt is nearly free (its tree is bounded by its own
	// fact count) and, when it succeeds, the step's text collapses.
	rAsc = fold([0, 1, 2, 4, 8, 16], None(), \acc : Maybe<Pair<Maybe<FolStepProof>, bool>>, k ->
		switch (acc) {
			Some(__): acc;
			None(): if (length(cands) <= k) None()
				else {
					kept = mizEmitGreedyKeep(cands, catoms, gk0, k, makeSet());
					r = mizEmitTrySelR(ctx, goal, instList, drv, maxFacts, maxSize, atoms,
						ctxP0, instP0, drvP0, goalP, asm, asmP, kept);
					switch (r.first) { Some(__): Some(r); None(): None(); }
				}
		});
	switch (rAsc) {
		Some(r): r;
		None(): mizEmitTrySelR(ctx, goal, instList, drv, maxFacts, maxSize, atoms,
			ctxP0, instP0, drvP0, goalP, asm, asmP, rel);
	}
}

mizEmitTrySelR(ctx : [Pair<FolForm, RuParseRef>], goal : FolForm,
	instList : [Pair<FolForm, string>], drv : [MizEmitDrv],
	maxFacts : int, maxSize : int, atoms : ref Tree<string, FolForm>,
	ctxP0 : [RuPForm], instP0 : [RuPForm], drvP0 : [RuPForm], goalP : RuPForm,
	asm : Maybe<FolForm>, asmP : Maybe<RuPForm>,
	rel : Set<int>) -> Pair<Maybe<FolStepProof>, bool> {
	keepCtx = filteri(ctx, \j, __ -> containsSet(rel, j));
	ctxP = filteri(ctxP0, \j, __ -> containsSet(rel, j));
	nC0 = length(ctxP0);
	instKeep = filteri(instList, \j, __ -> containsSet(rel, nC0 + j));
	instP = filteri(instP0, \j, __ -> containsSet(rel, nC0 + j));
	nI0 = nC0 + length(instP0);
	drvKeep = filteri(drv, \j, __ -> containsSet(rel, nI0 + j));
	drvP = filteri(drvP0, \j, __ -> containsSet(rel, nI0 + j));
	factsP = concat(concatA([ctxP, instP, drvP]),
		switch (asmP) { None(): []; Some(ap): [ap]; });
	assumedIdx = switch (asmP) { None(): -1; Some(__): length(factsP) - 1; };
	// the ASSUMPTION is mandatory and never dropped, so it must not count
	// against `maxFacts`: counting it made every ranked retry of a deduction
	// step over-budget by its own assumption (kept = cap, factsP = cap + 1),
	// and the retry recursed cap 10 → 6 → 4 → … → 0 without ever attempting
	nAsm = switch (asmP) { None(): 0; Some(__): 1; };
	size = fold(factsP, mizEmitSize(goalP), \acc, f -> acc + mizEmitSize(f));
	// OVER BUDGET IS NOT A REASON TO GIVE UP. Relevance keeps every fact that
	// shares an atom with the goal, and on a step with many unfolds that is 25
	// facts against a budget of 16 — the attempt was then skipped, and the step
	// counted as never tried. Rank instead: most goal atoms shared first,
	// smaller first among equals, and attempt with the best `maxFacts` of them.
	// The ranking is deterministic and does no search; losing a needed fact only
	// costs an attempt that was not being made at all.
	if (length(factsP) - nAsm > maxFacts || size > maxSize) {
		if (getUrlParameterDef("dbg-budget", "") == "1")
			println("OVER facts=" + i2s(length(factsP)) + " size=" + i2s(size)
				+ " goal=" + strGlue(folFormToks(goal), " "));
		if (length(factsP) - nAsm <= maxFacts) Pair(None(), true)
		else {
			// rank against the GOAL AND ASSUMPTION atoms: the proof proves
			// `asm → goal`, so a fact whose atoms live in the assumption (the
			// opelxp unfold of a strengthened conjunct) is as load-bearing as a
			// goal-atom one — under goal-only ranking it could never win a slot
			gk = foldSet(^mizEmitSeedKeysRef,
				mizEmitAtomKeys(goalP,
					switch (asmP) { None(): makeSet(); Some(ap): mizEmitAtomKeys(ap, makeSet()); }),
				\s9, k9 -> insertSet(s9, k9));
			all = concatA([ctxP0, instP0, drvP0]);
			cands = filter(mapi(all, \j, f -> Pair(j, f)),
				\pr -> containsSet(rel, pr.first));
			catoms = map(cands, \pr -> mizEmitAtomKeys(pr.second, makeSet()));
			// a RANKED attempt is a second chance, not a bigger one: with the full
			// budget it ran the k-way splits of enumset1 past ten minutes, so it
			// gets two thirds of the facts and a third of the tree
			cap = maxFacts * 2 / 3;
			// GREEDY FRONTIER, not a one-shot sort: each kept fact's atoms join
			// the scoring set before the next pick. The unfold instances form
			// CHAINS (eleq1 introduces the membership elin defines, whose parts
			// opelxp defines) and a fixed scoring set always broke the chain at
			// its second link — the small def-instance junk outranked it
			kept = mizEmitGreedyKeep(cands, catoms, gk, cap, makeSet());
			if (sizeSet(kept) == sizeSet(rel)) Pair(None(), true)
			else mizEmitTrySelR(ctx, goal, instList, drv, cap, maxSize, atoms,
				ctxP0, instP0, drvP0, goalP, asm, asmP, kept);
		}
	}
	else {
		tab = ^atoms;
		// cap the G3cp tree and the emitted proof: a by-step proof past a
		// few hundred steps is a blowup, not a proof — reject, keep the step open
		nodeCap = if (length(factsP) > maxFacts * 2 / 3) 5000 else 1500;
		switch (folPCertAssuming(factsP, goalP, \k -> lookupTreeDef(tab, k, FolPred("$false", [])),
			nodeCap, 2400, assumedIdx)) {
			None(): {
				k = folPCertLastFail();
				if (^mizEmitDbg && getUrlParameterDef("dbg-facts", "") == "1")
					iteri(concatA([map(keepCtx, \pc -> pc.first),
						map(instKeep, \pc -> pc.first), map(drvKeep, \dk -> dk.form)]),
						\fi, ff -> println("    F" + i2s(fi) + " " + strGlue(folFormToks(ff), " ")));
				if (^mizEmitDbg)
					println("  ATTEMPT " + k + " facts=" + i2s(length(factsP))
						+ " goal=" + strGlue(folFormToks(goal), " "));
				if (k == "unprovable") mizEmitFailUnprov := ^mizEmitFailUnprov + 1
				else if (k == "nodes") { mizEmitFailNodes := ^mizEmitFailNodes + 1; mizEmitStepLong := true; }
				else if (k == "steps") { mizEmitFailSteps := ^mizEmitFailSteps + 1; mizEmitStepLong := true; };
				// a blowup is a fact-COUNT symptom, not a verdict: the needed core
				// is picked EARLY by the greedy frontier, so retry with the top
				// half of the current set (deterministic descending ladder)
				n2 = length(factsP) - nAsm;
				if ((k == "steps" || k == "nodes") && n2 > 3) {
					gk2 = mizEmitAtomKeys(goalP,
						switch (asmP) { None(): makeSet(); Some(ap): mizEmitAtomKeys(ap, makeSet()); });
					all2 = concatA([ctxP0, instP0, drvP0]);
					cands2 = filter(mapi(all2, \j, f -> Pair(j, f)),
						\pr -> containsSet(rel, pr.first));
					catoms2 = map(cands2, \pr -> mizEmitAtomKeys(pr.second, makeSet()));
					kept2 = mizEmitGreedyKeep(cands2, catoms2, gk2, n2 / 2, makeSet());
					if (sizeSet(kept2) >= sizeSet(rel)) Pair(None(), false)
					else mizEmitTrySelR(ctx, goal, instList, drv, maxFacts, maxSize, atoms,
						ctxP0, instP0, drvP0, goalP, asm, asmP, kept2);
				}
				else Pair(None(), false);
			}
			Some(csteps): {
				nCtx = length(keepCtx);
				nInst = length(instKeep);
				instSteps = map(instKeep, \p -> FolPStep(p.first, p.second, []));
				// splice the derived-instance proof blocks after the unfold
				// instances; their local refs land in the factRefs EXTENSION
				factRefs0 = map(keepCtx, \p -> p.second);
				blocks = fold(drvKeep, Pair([], Pair(factRefs0, [])),
					\acc : Pair<[FolPStep], Pair<[RuParseRef], [int]>>, d -> {
					blockStart = nInst + length(acc.first);
					refBase = length(acc.second.first);
					bs = map(d.steps, \cs -> FolPStep(cs.form, cs.assertion,
						map(cs.refs, \r -> switch (r) {
							FolPRefStep(k): FolPRefStep(blockStart + k);
							FolPRefFact(k): FolPRefFact(refBase + k);
						})));
					Pair(concat(acc.first, bs),
						Pair(concat(acc.second.first, d.refs),
							arrayPush(acc.second.second, blockStart + length(bs) - 1)));
				});
				drvLast = blocks.second.second;
				shifted = map(csteps, \cs -> FolPStep(cs.form, cs.assertion,
					map(cs.refs, \r -> switch (r) {
						FolPRefStep(k): FolPRefStep(k + nInst + length(blocks.first));
						FolPRefFact(k):
							if (k < nCtx) FolPRefFact(k)
							else if (k < nCtx + nInst) FolPRefStep(k - nCtx)
							else FolPRefStep(drvLast[k - nCtx - nInst]);
					})));
				Pair(Some(FolStepProof(concatA([instSteps, blocks.first, shifted]),
					blocks.second.first,
					uniq(concatA(map(drvKeep, \d -> d.disjs))))), false);
			}
		}
	}
}

mizEmitHypRef(j : int) -> RuParseRef { RuParseHypRef(j); }
mizEmitStepRef(j : int) -> RuParseRef { RuParseStepRef(j); }

// ---- rung 3: ∀-instances of quantified local facts ----
// |- ψ from |- ∀x φ: spv needs |- (x = y → (φ ↔ ψ)) — built by a structure-
// directed CONGRUENCE WALK (eleq1/eleq2/eqeq1/eqeq2/sseq1/sseq2 at atoms
// where the substituted variable sits in an argument position, biidd where it
// is absent, notbid/anbi12d/orbi12d/imbi12d/bibi12d through connectives,
// albidv/exbidv under distinct binders). A witness equal to the binder needs
// only spi. Variables nested inside compound terms are OUT (term congruence
// is a later slice) — the walk fails and the instance is not offered.

// the ⊆/= CHARACTERIZATION instances: a quantified local fact of the shape
// ∀v (v∈A → v∈B) / ∀v (v∈A ↔ v∈B) is exactly df-ss / dfcleq's right side, so
// one instance step relates it to the (A ⊆ B) / (A = B) atom — this is how a
// let-block's proved ∀-form becomes the step's ⊆/= goal, no eigenvariable
// machinery needed. The lemmas' disjointed(A x, B x) becomes declared pairs.
mizEmitChars(ctx0 : [Pair<FolForm, RuParseRef>]) -> [MizEmitDrv] {
	filtermap(ctx0, \p -> switch (p.first) {
		FolQuant(q, vs, body): {
			if (q != "forall" || length(vs) != 1) None()
			else {
				v = vs[0];
				switch (body) {
					FolBin(op, l, r): {
						ab = switch (l) {
							FolPred(n1, a1): if (n1 == "∈" && length(a1) == 2 && a1[0] == FolVar(v))
								switch (r) {
									FolPred(n2, a2): if (n2 == "∈" && length(a2) == 2 && a2[0] == FolVar(v))
										Some(Pair(a1[1], a2[1])) else None();
									default: None();
								} else None();
							default: None();
						};
						switch (ab) {
							None(): None();
							Some(pr): {
								if (mizEmitTermHas(v, pr.first) || mizEmitTermHas(v, pr.second)) None()
								else {
									head = if (op == "imp") mizEmitSs(pr.first, pr.second)
										else if (op == "iff") FolEq(pr.first, pr.second)
										else FolPred("$none", []);
									lemma = if (op == "imp") "df-ss" else "dfcleq";
									if (op != "imp" && op != "iff") None()
									else {
										inst = FolBin("iff", head, p.first);
										vr = toLowerCase(v);
										dj = filtermap(folFormVars(inst),
											\w -> if (w == vr) None() else Some(Pair(vr, w)));
										Some(MizEmitDrv(inst,
											[FolPStep(inst, lemma, [])], [], dj));
									}
								}
							}
						}
					}
					default: None();
				}
			}
		}
		default: None();
	});
}

mizEmitDerive(ctx0 : [Pair<FolForm, RuParseRef>], allForms : [FolForm]) -> [MizEmitDrv] {
	mems : ref [Pair<FolTerm, FolTerm>] = ref [];
	subs : ref [Pair<FolTerm, FolTerm>] = ref [];
	eqs  : ref [Pair<FolTerm, FolTerm>] = ref [];
	iter(allForms, \f -> mizEmitHarvest(f, mems, subs, eqs));
	// candidates = the FREE VARIABLES of the step's forms, not only variables
	// that are a WHOLE side of an atom: `(field x26) = (field (k2_relat_1
	// x26))` has no bare-variable side at all, and the cited ∀-fact was never
	// instantiated at x26 — the variable every term of the step is built from
	names = uniq(concatA(map(allForms, folFormVars)));
	elems = if (length(names) > 5) subrange(names, 0, 5) else names;
	seen : ref Set<string> = ref makeSet();
	fold(ctx0, [], \acc, p -> {
		if (length(acc) >= 24 || !mizEmitIsForall(p.first)) acc
		else {
			nb = mizEmitPrefixLen(p.first);
			tuples = if (nb == 1) map(elems, \e -> [e])
				else if (nb == 2) concatA(map(elems, \e1 -> map(elems, \e2 -> [e1, e2])))
				else [];
			fold(tuples, acc, \ac, tp -> {
				if (length(ac) >= 24) ac
				else switch (mizEmitInst(p.first, p.second, tp)) {
					None(): {
						if (^mizEmitDbg)
							println("  DERIVE-DECLINE @ " + strGlue(tp, ",") + " :: "
								+ strGlue(folFormToks(p.first), " "));
						ac;
					}
					Some(d): {
						k = mizEmitKey(d.form);
						if (containsSet(^seen, k)) ac
						else {
							seen := insertSet(^seen, k);
							arrayPush(ac, d);
						}
					}
				}
			});
		}
	});
}

mizEmitIsForall(f : FolForm) -> bool {
	switch (f) { FolQuant(q, __, __): q == "forall"; default: false; }
}

mizEmitPrefixLen(f : FolForm) -> int {
	switch (f) {
		FolQuant(q, vs, b): if (q == "forall") length(vs) + mizEmitPrefixLen(b) else 0;
		default: 0;
	}
}

mizEmitInst(fact : FolForm, factRef : RuParseRef, ws : [string]) -> Maybe<MizEmitDrv> {
	steps : ref [FolPStep] = ref [];
	dj : ref [Pair<string, string>] = ref [];
	r = mizEmitInstChain(steps, dj, Pair(fact, FolPRefFact(0)), ws);
	switch (r) {
		None(): None();
		Some(fin): if (^steps == []) None()
			else Some(MizEmitDrv(fin.first, ^steps, [factRef], uniq(^dj)));
	}
}

// the same ∀-elimination chain rooted at a CITED assertion: step 0 states the
// citation's whole statement and names it (Russell does the substitution for
// an open-matrix theorem; a ∀-closed one is peeled here like a context fact)
mizEmitInstCite(name : string, stmt : FolForm, ws : [string]) -> Maybe<MizEmitDrv> {
	steps : ref [FolPStep] = ref [FolPStep(stmt, name, [])];
	dj : ref [Pair<string, string>] = ref [];
	r = mizEmitInstChain(steps, dj, Pair(stmt, FolPRefStep(0)), ws);
	switch (r) {
		None(): None();
		Some(fin): switch (mizEmitMapThmDisjs(name, \g7 -> {
				fold(enumFromTo(0, length(ws) - 1), None(), \ac7 : Maybe<FolTerm>, i7 ->
					if (isSome(ac7)) ac7
					else if (toLowerCase(mizEmitBinderAt(stmt, i7)) == toLowerCase(g7))
						Some(FolVar(ws[i7])) else None());
			})) {
			None(): None();
			Some(dps7): Some(MizEmitDrv(fin.first, ^steps, [], uniq(concat(^dj, dps7))));
		}
	}
}

// ---- THE TYPE LAYER: THE MEANING OF A MIZAR TYPE, BY CITATION ----
// `element t D` is Mizar's "t is an Element of D". Its meaning is stated by
// the article's own mode definition — for SUBSET_1 that is
//   ∀D ∀t ( ( D = ∅ ∨ ( element t D ↔ t ∈ D ) ) ∧ ( D = ∅ → … ) )
// — and the checker uses it with NO citation, so the by-list never supplies
// it and every `element` goal has been going to the flat search unarmed.
//
// The bridge is a FIXED shape, not a search: instantiate the definition at
// (D, t), take the left conjunct, kill the `D = ∅` disjunct from the type's
// non-emptiness, and what remains is `element t D ↔ t ∈ D`. Non-emptiness of
// a powerset is `∅ ∈ 𝒫 Y` (0elpw) through n0i. The membership that remains
// is ordinary set theory, which the library rows already state.
mizEmitTypeIffDrvs(goal : FolForm, asm : Maybe<FolForm>,
	stmtOf : (string) -> Maybe<FolForm>, shOf : (string) -> string) -> [MizEmitDrv] {
	empty0 = FolApp("∅", []);
	atoms = uniqBy(concat(mizEmitAtomsOf(goal, []),
			switch (asm) { None(): []; Some(af): mizEmitAtomsOf(af, []); }),
		\a, b -> mizEmitKey(a) == mizEmitKey(b));
	defs = (^mizEmitDefsOfSymRef)("element");
	if (defs == []) [] else concatA(map(atoms, \at -> switch (at) {
		FolPred(nm, args): if (nm != "element" || length(args) != 2) [] else {
			tE = args[0];
			dE = args[1];
			memE = FolPred("∈", [tE, dE]);
			iffE = FolBin("iff", at, memE);
			orE = FolBin("or", FolEq(dE, empty0), iffE);
			// the non-emptiness of the type. 𝒫 Y always has ∅ in it; any other
			// shape declines rather than guess (the checker knows it from the
			// registrations, and that is a later slice)
			nonEmpty = switch (dE) {
				FolApp(fp, ap): if (fp != "𝒫" || length(ap) != 1) None()
					else Some(Pair(FolPred("∈", [empty0, dE]), "0elpw"));
				default: None();
			};
			switch (nonEmpty) {
				None(): [];
				// THE INSTANCE IS MATCHED, NOT ELIMINATED AT WITNESSES. The mode
				// definition binds `∀ x5 ∀ xd2`, and the article's own free
				// variable is called x5 too — eliminating the binder at `𝒫 x5`
				// is then a capture and spcgv's disjointedness condition
				// (rightly) refuses it. mizEmitDefInstance matches the
				// definition's own atom against the step's instead, which is how
				// every other definitional channel here survives the collision.
				// ...and the definition's BOUND VARIABLES are renamed away from
				// everything the step mentions first. SUBSET_1's mode definition
				// binds `x5`, the article's own free variable is `x5`, and the
				// match then reads as a capture and is refused — the same trap
				// the rung-3 channel hit, with the same fix (mizFreshenBound).
				Some(ne): {
					avoid = ref buildSet(concatA(map(atoms, mizFormAllVars)));
					ctr = ref 0;
					stmtF = \nm5 : string -> switch (stmtOf(nm5)) {
						None(): None();
						Some(st5): Some(mizFreshenBound(st5, avoid, ctr));
					};
					concatA(map(defs, \dn ->
					switch (mizEmitDefInstance(dn, "element", [at], stmtF, shOf)) {
						None(): { if (^mizEmitDbg) println("  TYPEIFF " + dn + " no-instance"); []; }
						Some(d0): {
								// the instance must be the definition's own shape:
								// `(D = ∅ ∨ (element t D ↔ t ∈ D)) ∧ …`
								ok = switch (d0.form) {
									FolBin(op1, l1, __): op1 == "and" && l1 == orE;
									default: false;
								};
								if (!ok) {
									if (^mizEmitDbg) println("  TYPEIFF " + dn + " shape :: "
										+ strGlue(folFormToks(d0.form), " ")
										+ "  WANT left = " + strGlue(folFormToks(orE), " "));
									[];
								} else {
									n0 = length(d0.steps);
									// simpl is a THEOREM here — `(φ ∧ ψ) → φ` — not a
									// one-premise rule, so the conjunct comes off by
									// citing it and detaching (the verifier caught the
									// rule reading at once)
									steps = concat(d0.steps, [
										FolPStep(FolBin("imp", d0.form, orE), "simpl", []),
										FolPStep(orE, "ax-mp",
											[FolPRefStep(n0 - 1), FolPRefStep(n0)]),
										FolPStep(ne.first, ne.second, []),
										FolPStep(FolBin("imp", ne.first,
											FolNeg(FolEq(dE, empty0))), "n0i", []),
										FolPStep(FolNeg(FolEq(dE, empty0)), "ax-mp",
											[FolPRefStep(n0 + 2), FolPRefStep(n0 + 3)]),
										FolPStep(FolBin("imp", FolNeg(FolEq(dE, empty0)),
											FolBin("imp", orE, iffE)), "orel1", []),
										FolPStep(FolBin("imp", orE, iffE), "ax-mp",
											[FolPRefStep(n0 + 4), FolPRefStep(n0 + 5)]),
										FolPStep(iffE, "ax-mp",
											[FolPRefStep(n0 + 1), FolPRefStep(n0 + 6)])]);
									[MizEmitDrv(iffE, steps, d0.refs, d0.disjs)];
								}
							}
					}));
				}
			}
		}
		default: [];
	}));
}

// THE TYPE GOAL, CLOSED OUTRIGHT. `element t 𝒫 Y` is Mizar for "t is a
// Subset of Y". When the goal IS that — no assumption, and t is ∅, which the
// library says is in every powerset (0elpw) — the whole proof is fixed: the
// meaning bridge from mizEmitTypeIffDrvs, the membership by citation, mpbir.
// Nothing searches. Other shapes decline rather than guess; they need the
// step's own antecedent, which is the next slice.
mizEmitTypeGoal(goal : FolForm, asm : Maybe<FolForm>,
	stmtOf : (string) -> Maybe<FolForm>, shOf : (string) -> string) -> Maybe<FolStepProof> {
	switch (goal) {
		FolPred(nm, args): if (nm != "element" || length(args) != 2 || isSome(asm)) None()
			else {
				tE = args[0];
				dE = args[1];
				isEmpty = switch (tE) {
					FolApp(ft, at2): ft == "∅" && at2 == [];
					default: false;
				};
				isPw = switch (dE) {
					FolApp(fp, ap): fp == "𝒫" && length(ap) == 1;
					default: false;
				};
				if (!isEmpty || !isPw) None() else {
					memE = FolPred("∈", [tE, dE]);
					drvs = mizEmitTypeIffDrvs(goal, asm, stmtOf, shOf);
					if (^mizEmitDbg) println("  TYPEGOAL bridge drvs=" + i2s(length(drvs))
						+ " defs=" + strGlue((^mizEmitDefsOfSymRef)("element"), ","));
					if (drvs == []) None() else {
						d0 = drvs[0];
						n0 = length(d0.steps);
						steps = concat(d0.steps, [
							FolPStep(memE, "0elpw", []),
							FolPStep(goal, "mpbir", [FolPRefStep(n0), FolPRefStep(n0 - 1)])]);
						Some(FolStepProof(steps, d0.refs, d0.disjs));
					}
				}
			}
		default: None();
	}
}

// ---- THE TYPE LAYER: REGISTRATIONS INSTANTIATED AT THE STEP'S OWN TERMS ----
// A cluster registration says what attributes a term shape carries — "the
// powerset of anything is non empty" (fc1_zfmisc_1), "a singleton is non
// empty" (fc2_xboole_0). The checker applies them with NO citation (the type
// record's F half is the only thing that names them), so the by-list can
// never supply the type guard a discharge is looking for, and the emitter's
// type family has been closing nothing.
//
// The supply is mechanical once the registrations are indexed by the functor
// they speak about: take each compound subterm the step mentions, look up the
// registrations for its head, MATCH the registration's own term against it to
// recover the witnesses, and instantiate. The instantiation is the existing
// spcgv+sethood chain — a type fact is an instance of an axiom the article
// already states, not a new proof shape.
mizEmitRegTermsOf(stmt : FolForm, f : string, arity : int) -> [FolTerm] {
	// the registration's own occurrences of the functor, as patterns over its
	// binders (the pattern whose match against a concrete term gives the
	// witness tuple)
	filter(mizEmitCompTerms(mizEmitMatrixOfQ(stmt)), \t -> switch (t) {
		FolApp(nm, args): nm == f && length(args) == arity;
		default: false;
	});
}

// the ∀-prefix stripped, for reading the statement's term shapes
mizEmitMatrixOfQ(f : FolForm) -> FolForm {
	switch (f) {
		FolQuant(q, __, body): if (q != "forall") f else mizEmitMatrixOfQ(body);
		default: f;
	}
}

mizEmitRegDrvs(goal : FolForm, asm : Maybe<FolForm>,
	stmtOf : (string) -> Maybe<FolForm>, shOf : (string) -> string) -> [MizEmitDrv] {
	terms = uniqBy(concat(mizEmitCompTerms(goal),
			switch (asm) { None(): []; Some(af): mizEmitCompTerms(af); }),
		\a, b -> mizEmitTKey(a) == mizEmitTKey(b));
	// the step's own terms, biggest cut first — a registration fires on the
	// term as written, so there is nothing to search for
	ts = if (length(terms) > 8) subrange(terms, 0, 8) else terms;
	concatA(map(ts, \t -> switch (t) {
		FolApp(fn, args): concatA(map((^mizEmitRegsOfSymRef)(fn), \nm ->
			switch (stmtOf(nm)) {
				None(): [];
				Some(st): {
					n = mizEmitPrefixLen(st);
					if (n == 0 || n > 3) [] else {
						binders = map(enumFromTo(0, n - 1), \i -> mizEmitBinderAt(st, i));
						metas = buildSet(binders);
						// the witness tuple is READ OFF the match, never guessed
						pats = mizEmitRegTermsOf(st, fn, length(args));
						subs = filtermap(pats, \pt ->
							switch (mizEmitMatchT(pt, t, metas, Some(makeTree()))) {
								None(): None();
								Some(sub): if (mizEmitSubT(pt, sub) != t) None()
									else if (exists(binders, \b -> !containsKeyTree(sub, b))) None()
									else Some(map(binders, \b -> lookupTreeDef(sub, b, FolVar(b))));
							});
						filtermap(if (length(subs) > 2) subrange(subs, 0, 2) else subs,
							\ws -> mizEmitInstCiteT(nm, st, ws, shOf));
					}
				}
			}));
		default: [];
	}));
}

// the same citation instantiated at TERM witnesses (a goal subterm such as
// `proj1 x26`): spcgv + sethood per binder (mizEmitElimAt), where spi/spv
// only reach plain variables — `t50 @ x7 := proj1 x26` is the shape that
// blocked the guarded relat_1 families (30× v1→eq, 18× v1→⊆)
mizEmitInstCiteT(name : string, stmt : FolForm, ws : [FolTerm],
	shOf : (string) -> string) -> Maybe<MizEmitDrv> {
	steps : ref [FolPStep] = ref [FolPStep(stmt, name, [])];
	dj : ref [Pair<string, string>] = ref [];
	r = fold(ws, Some(Pair(stmt, 0)), \acc : Maybe<Pair<FolForm, int>>, w ->
		switch (acc) {
			None(): None();
			Some(st): switch (st.first) {
				FolQuant(q, vs, __): if (q != "forall" || vs == []) None()
					else mizEmitElimAt(steps, dj, st.first, st.second, vs[0], w, shOf, 0);
				default: None();
			}
		});
	switch (r) {
		None(): None();
		Some(fin): switch (mizEmitMapThmDisjs(name, \g7 -> {
				fold(enumFromTo(0, length(ws) - 1), None(), \ac7 : Maybe<FolTerm>, i7 ->
					if (isSome(ac7)) ac7
					else if (toLowerCase(mizEmitBinderAt(stmt, i7)) == toLowerCase(g7))
						Some(ws[i7]) else None());
			})) {
			None(): None();
			Some(dps7): Some(MizEmitDrv(fin.first, ^steps, [], uniq(concat(^dj, dps7))));
		}
	}
}

// The hyp-citation's substitution is COMPUTED from the hypotheses, never
// enumerated: each hypothesis either matches a ctx fact (binding statement
// variables), or — for a ⊆/= hypothesis with one side already determined —
// binds its other side so the instance discharges by ssid/eqid (σ(x7) :=
// proj1 x26 is the shape that pays on t51_relat_1). Statement variables the
// hypotheses leave unbound are filled from the goal pool afterwards.
mizEmitHypCiteSubs(hyps : [FolForm], pvs : [string],
	ctxI : [Pair<FolForm, RuParseRef>]) -> [Tree<string, FolTerm>] {
	metas0 = buildSet(pvs);
	key9 = \s : Tree<string, FolTerm> -> strGlue(map(tree2pairs(s),
		\p -> p.first + ":" + mizEmitTKey(p.second)), "|");
	empty9 : Tree<string, FolTerm> = makeTree();
	fold(hyps, [empty9], \acc : [Tree<string, FolTerm>], h ->
		uniqBy(concatA(map(acc, \s -> {
			unbound = fold(pvs, makeSet(), \a9, v9 ->
				if (containsKeyTree(s, v9)) a9 else insertSet(a9, v9));
			// a side is DETERMINED when substitution leaves no unbound
			// statement variable in it (a bound one may land on a citing-side
			// var of the same name — that is a constant here)
			ground9 = \t : FolTerm -> {
				tS = mizEmitSubT(t, s);
				Pair(tS, forall(mizEmitTermVars(tS), \v9 -> !containsSet(unbound, v9)));
			};
			bindEq = \l : FolTerm, r : FolTerm -> {
				lG = ground9(l); rG = ground9(r);
				if (lG.second)
					switch (mizEmitMatchT(r, lG.first, metas0, Some(s))) {
						None(): []; Some(s2): [s2];
					}
				else if (rG.second)
					switch (mizEmitMatchT(l, rG.first, metas0, Some(s))) {
						None(): []; Some(s2): [s2];
					}
				else [];
			};
			ctxOpts = filtermap(ctxI, \p ->
				switch (mizEmitMatchF(h, p.first, metas0, Some(s))) {
					None(): None(); Some(s2): Some(s2);
				});
			selfOpts = switch (h) {
				FolPred(nm9, as9): if (nm9 == "⊆" && length(as9) == 2)
					bindEq(as9[0], as9[1]) else [];
				FolEq(l9, r9): bindEq(l9, r9);
				default: [];
			};
			if (^mizEmitDbg)
				println("    HYPSUB-H rawvars=" + strGlue(mizFormAllVars(h), ",")
					+ " metas=" + strGlue(pvs, ",")
					+ " ctxOpts=" + i2s(length(ctxOpts))
					+ " selfOpts=" + i2s(length(selfOpts))
					+ " s={" + key9(s) + "}"
					+ " ctxraw: " + strGlue(map(ctxI,
						\p9 -> strGlue(mizFormAllVars(p9.first), ",")), " ; "));
			concat(ctxOpts, selfOpts);
		})), \a, b -> key9(a) == key9(b)));
}

// HYPOTHETICAL CITATION: a theorem emitted WITH hypotheses is cited by
// stating an instance of its proposition (Russell substitutes when the step
// names the theorem) and supplying one reference per substituted hypothesis.
// Discharge kinds, in order: a ctx FACT with the hypothesis's key (never the
// assumption — under deduction the reference cannot reach it), `t ⊆ t` by
// ssid, `t = t` by eqid; any other hypothesis declines the citation.
// `pvs` are the proposition's free variables, `ws` the witness per variable.
mizEmitInstCiteH(name : string, prop : FolForm, hyps : [FolForm],
	pvs : [string], ws : [FolTerm],
	ctxI : [Pair<FolForm, RuParseRef>]) -> Maybe<MizEmitDrv> {
	// Unlike the spv/spcgv elimination chains, this citation is one stated
	// instance Russell matches against the open proposition — first-order
	// matching is unique, so a witness may share a FREE variable's name.
	// Only a collision with a BOUND variable is capture (the substitution
	// would change the instance's meaning and the verifier refuses it).
	freeL = buildSet(map(concat(pvs, concatA(map(hyps, folFormVars))), toLowerCase));
	boundL = fold(map(concat(mizFormAllVars(prop),
		concatA(map(hyps, mizFormAllVars))), toLowerCase), makeSet(),
		\ac9, v9 -> if (containsSet(freeL, v9)) ac9 else insertSet(ac9, v9));
	// a hypothesis variable outside the proposition's own is unconstrained by
	// the stated instance — decline
	hypVarsIn = forall(uniq(concatA(map(hyps, folFormVars))), \v -> contains(pvs, v));
	noCapture = forall(ws, \w -> forall(mizEmitTermVars(w),
		\v -> !containsSet(boundL, toLowerCase(v))));
	ok = length(pvs) == length(ws) && hypVarsIn && noCapture;
	if (!ok) {
		mizEmitHypBump(if (!hypVarsIn) "hyp-var-outside-prop"
			else if (!noCapture) "capture" else "arity-mismatch");
		None();
	}
	else {
		sub = pairs2tree(mapi(pvs, \i, v -> Pair(v, ws[i])));
		inst = mizEmitSubF(prop, sub);
		steps : ref [FolPStep] = ref [];
		refs : ref [RuParseRef] = ref [];
		hrefs : Maybe<[FolPRef]> = fold(hyps, Some([]),
			\acc : Maybe<[FolPRef]>, h0 -> switch (acc) {
				None(): None();
				Some(rs): {
					h = mizEmitSubF(h0, sub);
					hk = mizEmitKey(h);
					switch (find(ctxI, \p -> mizEmitKey(p.first) == hk)) {
						Some(p): {
							refs := arrayPush(^refs, p.second);
							Some(arrayPush(rs, FolPRefFact(length(^refs) - 1)));
						}
						None(): {
							lem = switch (h) {
								FolPred(pn9, as9): if (pn9 == "⊆" && length(as9) == 2
									&& mizEmitTKey(as9[0]) == mizEmitTKey(as9[1])) "ssid" else "";
								FolEq(l9, r9): if (mizEmitTKey(l9) == mizEmitTKey(r9)) "eqid" else "";
								default: "";
							};
							if (lem == "") {
								mizEmitHypBump("undis" + (if (ctxI == []) "-emptyctx" else "")
									+ ":" + mizEmitSkeleton(h));
								if (^mizEmitDbg && ctxI != [])
									println("    HYP-UNDIS " + name
										+ " hyp: " + strGlue(folFormToks(h), " ")
										+ " || ctx: " + strGlue(map(ctxI,
											\p9 -> strGlue(folFormToks(p9.first), " ")), " ; "));
								None();
							}
							else {
								steps := arrayPush(^steps, FolPStep(h, lem, []));
								Some(arrayPush(rs, FolPRefStep(length(^steps) - 1)));
							}
						}
					}
				}
			});
		switch (hrefs) {
			None(): None();
			Some(rs): switch (mizEmitMapThmDisjs(name, \g7 -> {
					gl = toLowerCase(g7);
					foldi(pvs, None(), \i7, ac7 : Maybe<FolTerm>, v7 ->
						if (isSome(ac7)) ac7
						else if (toLowerCase(v7) == gl) Some(ws[i7]) else None());
				})) {
				None(): { mizEmitHypBump("disjs-decline"); None(); }
				Some(dps): {
					mizEmitHypBump("built");
					steps := arrayPush(^steps, FolPStep(inst, name, rs));
					Some(MizEmitDrv(inst, ^steps, ^refs, uniq(dps)));
				}
			}
		}
	}
}

// the compound subterms of a formula, outermost first
mizEmitCompTermsT(t : FolTerm, acc : [FolTerm]) -> [FolTerm] {
	switch (t) {
		FolApp(__, args): fold(args, arrayPush(acc, t), \a2, a -> mizEmitCompTermsT(a, a2));
		default: acc;
	}
}

mizEmitCompTerms(f : FolForm) -> [FolTerm] {
	switch (f) {
		FolPred(__, args): fold(args, [], \ac, a -> mizEmitCompTermsT(a, ac));
		FolEq(l, r): mizEmitCompTermsT(r, mizEmitCompTermsT(l, []));
		FolNeg(g): mizEmitCompTerms(g);
		FolBin(__, l, r): concat(mizEmitCompTerms(l), mizEmitCompTerms(r));
		FolQuant(__, __, b): mizEmitCompTerms(b);
	}
}

mizEmitInstChain(steps : ref [FolPStep], dj : ref [Pair<string, string>],
	start : Pair<FolForm, FolPRef>, ws : [string]) -> Maybe<Pair<FolForm, FolPRef>> {
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	fold(ws, Some(start), \acc : Maybe<Pair<FolForm, FolPRef>>, y ->
		switch (acc) {
			None(): None();
			Some(st): switch (st.first) {
				FolQuant(q, vs, body): {
					if (q != "forall" || vs == []) None()
					else {
						x = vs[0];
						rest = if (length(vs) == 1) body else FolQuant(q, tail(vs), body);
						// the AST binder ("X5") and a rendered free-var name ("x5")
						// are the SAME variable — compare lowercased, or the identity
						// instantiation falls into spv and violates its own
						// disjointedness (the t95_xboole_1 disproof)
						if (toLowerCase(y) == toLowerCase(x)) {
							i = emit(rest, "spi", [st.second]);
							Some(Pair(rest, FolPRefStep(i)));
						} else switch (mizEmitWalk(steps, dj, x, y, rest)) {
							None(): None();
							Some(w): {
								// spv's disjointed(ps x): x must stay disjoint
								// from everything substituted into the instance
								xr = toLowerCase(x);
								dj := concat(^dj, filtermap(folFormVars(w.second),
									\v -> if (v == xr) None() else Some(Pair(xr, v))));
								sp = emit(FolBin("imp", st.first, w.second), "spv", [FolPRefStep(w.first)]);
								mp = emit(w.second, "ax-mp", [st.second, FolPRefStep(sp)]);
								Some(Pair(w.second, FolPRefStep(mp)));
							}
						}
					}
				}
				default: None();
			}
		});
}

// steps proving |- (x = y → (f ↔ f[y/x])); returns (stepIdx, f[y/x]).
// `dj` accumulates the disjointedness the used lemmas demand.
mizEmitWalk(steps : ref [FolPStep], dj : ref [Pair<string, string>],
	x : string, y : string, f : FolForm) -> Maybe<Pair<int, FolForm>> {
	mizEmitWalkT(steps, dj, x, FolVar(y), f);
}

// The same walk with a TERM on the right — |- (x = T → (f ↔ f[T/x])). Every
// congruence lemma it cites (eleq1/sseq1/eqeq1/notbid/anbi12d/albidv/…) is
// class-general in the foundation, so nothing but the substituted object
// changes. This is what lets a recorded witness (a Mizar term such as X ∪ Y,
// never a bare variable) be eliminated at all.
mizEmitWalkT(steps : ref [FolPStep], dj : ref [Pair<string, string>],
	x : string, t : FolTerm, f : FolForm) -> Maybe<Pair<int, FolForm>> {
	y = t;
	ante = FolEq(FolVar(x), t);
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	mkIff = \a, b, lemma, refs -> emit(FolBin("imp", ante, FolBin("iff", a, b)), lemma, refs);
	if (!mizEmitFreeIn(x, f)) Some(Pair(mkIff(f, f, "biidd", []), f))
	else switch (f) {
		FolPred(name, args): {
			if (length(args) != 2) mizEmitWalkPred(steps, x, y, f, name, args, mkIff)
			else {
				aX = args[0] == FolVar(x); bX = args[1] == FolVar(x);
				aHas = mizEmitTermHas(x, args[0]); bHas = mizEmitTermHas(x, args[1]);
				lem1 = if (name == "∈") "eleq1" else if (name == "⊆") "sseq1" else "";
				lem2 = if (name == "∈") "eleq2" else if (name == "⊆") "sseq2" else "";
				if (lem1 == "") mizEmitWalkPred(steps, x, y, f, name, args, mkIff)
				else if (aX && !bHas) {
					g = FolPred(name, [y, args[1]]);
					Some(Pair(mkIff(f, g, lem1, []), g));
				} else if (bX && !aHas) {
					g = FolPred(name, [args[0], y]);
					Some(Pair(mkIff(f, g, lem2, []), g));
				} else {
					// the variable sits INSIDE a compound argument (A ⊆ A ∪ B):
					// rewrite each side as a term, then combine with the
					// deduction form of the predicate's congruence
					lem12 = if (name == "∈") "eleq12d" else "sseq12d";
					switch (mizEmitWalkTerm(steps, x, y, args[0])) {
						None(): None();
						Some(wa): switch (mizEmitWalkTerm(steps, x, y, args[1])) {
							None(): None();
							Some(wb): {
								g = FolPred(name, [wa.second, wb.second]);
								Some(Pair(mkIff(f, g, lem12,
									[FolPRefStep(wa.first), FolPRefStep(wb.first)]), g));
							}
						}
					}
				}
			}
		}
		FolEq(l, r): {
			lX = l == FolVar(x); rX = r == FolVar(x);
			if (lX && !mizEmitTermHas(x, r)) {
				g = FolEq(y, r);
				Some(Pair(mkIff(f, g, "eqeq1", []), g));
			} else if (rX && !mizEmitTermHas(x, l)) {
				g = FolEq(l, y);
				Some(Pair(mkIff(f, g, "eqeq2", []), g));
			} else switch (mizEmitWalkTerm(steps, x, y, l)) {
				None(): None();
				Some(wl): switch (mizEmitWalkTerm(steps, x, y, r)) {
					None(): None();
					Some(wr): {
						g = FolEq(wl.second, wr.second);
						Some(Pair(mkIff(f, g, "eqeq12d",
							[FolPRefStep(wl.first), FolPRefStep(wr.first)]), g));
					}
				}
			}
		}
		FolNeg(g): switch (mizEmitWalkT(steps, dj, x, y, g)) {
			None(): None();
			Some(w): {
				g2 = FolNeg(w.second);
				Some(Pair(mkIff(f, g2, "notbid", [FolPRefStep(w.first)]), g2));
			}
		}
		FolBin(op, l, r): {
			lemma = if (op == "and") "anbi12d" else if (op == "or") "orbi12d"
				else if (op == "imp") "imbi12d" else "bibi12d";
			switch (mizEmitWalkT(steps, dj, x, y, l)) {
				None(): None();
				Some(wl): switch (mizEmitWalkT(steps, dj, x, y, r)) {
					None(): None();
					Some(wr): {
						g2 = FolBin(op, wl.second, wr.second);
						Some(Pair(mkIff(f, g2, lemma, [FolPRefStep(wl.first), FolPRefStep(wr.first)]), g2));
					}
				}
			}
		}
		FolQuant(q, vs, b): {
			// capture / shadow: the binder may be neither x nor any variable of
			// the substituted term
			if (exists(vs, \v -> v == x || mizEmitTermHas(v, y))) None()
			else switch (mizEmitWalkT(steps, dj, x, y, b)) {
				None(): None();
				Some(w): {
					lemma = if (q == "forall") "albidv" else "exbidv";
					// albidv/exbidv: the binder must be disjoint from the
					// antecedent's variables (x = y)
					dj := fold(vs, ^dj, \ac, v ->
						fold(mizEmitTermVars(y), arrayPush(ac, Pair(toLowerCase(v), toLowerCase(x))),
							\a2, tv -> arrayPush(a2, Pair(toLowerCase(v), toLowerCase(tv)))));
					start : Pair<int, Pair<FolForm, FolForm>> = Pair(w.first, Pair(b, w.second));
					p2 = foldr(vs, start, \acc, v -> {
						a2 = FolQuant(q, [v], acc.second.first);
						b2 = FolQuant(q, [v], acc.second.second);
						Pair(mkIff(a2, b2, lemma, [FolPRefStep(acc.first)]), Pair(a2, b2));
					});
					Some(Pair(p2.first, p2.second.second));
				}
			}
		}
	}
}

mizEmitFreeIn(x : string, f : FolForm) -> bool {
	switch (f) {
		FolPred(__, args): exists(args, \t -> mizEmitTermHas(x, t));
		FolEq(l, r):       mizEmitTermHas(x, l) || mizEmitTermHas(x, r);
		FolNeg(g):         mizEmitFreeIn(x, g);
		FolBin(__, l, r):  mizEmitFreeIn(x, l) || mizEmitFreeIn(x, r);
		FolQuant(__, vs, b): if (exists(vs, \v -> v == x)) false else mizEmitFreeIn(x, b);
	}
}

mizEmitTermHas(x : string, t : FolTerm) -> bool {
	switch (t) {
		FolVar(n): n == x;
		FolApp(__, args): exists(args, \a -> mizEmitTermHas(x, a));
		FolAbs(v, b): if (v == x) false else mizEmitFreeIn(x, b);
	}
}

filteri(xs : [?], pred : (int, ?) -> bool) -> [?] {
	foldi(xs, [], \i, acc, x -> if (pred(i, x)) arrayPush(acc, x) else acc);
}

// indices of the facts connected to the goal through shared atom keys,
// within `hops` closure rounds (a large hops = the full fixpoint)
mizEmitGreedyKeep(cands : [Pair<int, RuPForm>], catoms : [Set<string>],
	gk : Set<string>, cap : int, chosen : Set<int>) -> Set<int> {
	if (cap <= 0) chosen
	else {
		best = foldi(cands, Pair(-1, 0), \i, acc : Pair<int, int>, pr -> {
			if (containsSet(chosen, pr.first)) acc
			else {
				sc = 1000 * sizeSet(intersectSets(catoms[i], gk)) - mizEmitSize(pr.second);
				if (acc.first < 0 || sc > acc.second) Pair(i, sc) else acc;
			}
		});
		if (best.first < 0) chosen
		else mizEmitGreedyKeep(cands, catoms,
			foldSet(catoms[best.first], gk, \s, k -> insertSet(s, k)),
			cap - 1, insertSet(chosen, cands[best.first].first));
	}
}

mizEmitRelevantH(facts : [RuPForm], goal : RuPForm, hops : int) -> Set<int> {
	factAtoms = map(facts, \f -> mizEmitAtomKeys(f, makeSet()));
	seed = mizEmitAtomKeys(goal, makeSet());
	mizEmitRelClose(factAtoms, seed, makeSet(), hops);
}

mizEmitRelClose(factAtoms : [Set<string>], seen : Set<string>, kept : Set<int>, hops : int) -> Set<int> {
	if (hops <= 0) kept
	else {
		grown = foldi(factAtoms, Pair(seen, kept), \i, acc : Pair<Set<string>, Set<int>>, fa -> {
			if (containsSet(acc.second, i)) acc
			else if (existsSet(fa, \k -> containsSet(acc.first, k)))
				Pair(foldSet(fa, acc.first, \s, k -> insertSet(s, k)), insertSet(acc.second, i))
			else acc;
		});
		if (sizeSet(grown.second) == sizeSet(kept)) kept
		else mizEmitRelClose(factAtoms, grown.first, grown.second, hops - 1);
	}
}

mizEmitAtomKeys(f : RuPForm, acc : Set<string>) -> Set<string> {
	switch (f) {
		RuPAtom(k):   insertSet(acc, k);
		RuPNot(g):    mizEmitAtomKeys(g, acc);
		RuPAnd(l, r): mizEmitAtomKeys(r, mizEmitAtomKeys(l, acc));
		RuPOr(l, r):  mizEmitAtomKeys(r, mizEmitAtomKeys(l, acc));
		RuPImp(l, r): mizEmitAtomKeys(r, mizEmitAtomKeys(l, acc));
		RuPIff(l, r): mizEmitAtomKeys(r, mizEmitAtomKeys(l, acc));
		default: acc;
	}
}

mizEmitHasQuant(f : FolForm) -> bool {
	switch (f) {
		FolQuant(__, __, __): true;
		FolNeg(g):            mizEmitHasQuant(g);
		FolBin(__, l, r):     mizEmitHasQuant(l) || mizEmitHasQuant(r);
		default:              false;
	}
}

mizEmitKey(f : FolForm) -> string { strGlue(folFormToks(f), " "); }

// FolForm -> propositional skeleton; leaves (atoms, equalities, quantified
// subforms) intern into the atom table by their rendered key
mizEmitP(atoms : ref Tree<string, FolForm>, f : FolForm) -> RuPForm {
	switch (f) {
		FolNeg(g):        RuPNot(mizEmitP(atoms, g));
		FolBin(op, l, r): {
			pl = mizEmitP(atoms, l);
			pr = mizEmitP(atoms, r);
			if (op == "and") RuPAnd(pl, pr)
			else if (op == "or") RuPOr(pl, pr)
			else if (op == "imp") RuPImp(pl, pr)
			else RuPIff(pl, pr);
		}
		FolPred(name, __): {
			if (name == "$true") RuPTrue()
			else if (name == "$false") RuPFalse()
			else mizEmitAtom(atoms, f);
		}
		default: mizEmitAtom(atoms, f);
	}
}

mizEmitAtom(atoms : ref Tree<string, FolForm>, f : FolForm) -> RuPForm {
	k = mizEmitKey(f);
	atoms := setTree(^atoms, k, f);
	RuPAtom(k);
}

mizEmitSize(f : RuPForm) -> int {
	switch (f) {
		RuPNot(a):     1 + mizEmitSize(a);
		RuPAnd(a, b):  1 + mizEmitSize(a) + mizEmitSize(b);
		RuPOr(a, b):   1 + mizEmitSize(a) + mizEmitSize(b);
		RuPImp(a, b):  1 + mizEmitSize(a) + mizEmitSize(b);
		RuPIff(a, b):  1 + mizEmitSize(a) + mizEmitSize(b);
		default: 1;
	}
}

// collect the membership-unfold instances of one form's propositional
// skeleton (never descend under a quantifier — those memberships carry bound
// variables and their instances would be junk). Key -> (instance, lemma).
mizEmitUnfolds(f : FolForm, acc : Tree<string, Pair<FolForm, string>>) -> Tree<string, Pair<FolForm, string>> {
	switch (f) {
		FolNeg(g):        mizEmitUnfolds(g, acc);
		FolBin(__, l, r): mizEmitUnfolds(r, mizEmitUnfolds(l, acc));
		FolPred(name, args):
			if (name == "∈" && length(args) == 2) mizEmitMemGen(args[0], args[1], acc)
			else acc;
		default: acc;
	}
}

mizEmitMem(x : FolTerm, s : FolTerm) -> FolForm { FolPred("∈", [x, s]); }
mizEmitSs(l : FolTerm, r : FolTerm) -> FolForm { FolPred("⊆", [l, r]); }
mizEmitTKey(t : FolTerm) -> string { mizEmitKey(FolPred("k", [t])); }

// BRIDGE instances connecting the three atom families the steps mix:
//   eqss   (A = B) ↔ (A ⊆ B ∧ B ⊆ A)         per = atom
//   eleq2  (A = B) → (e ∈ A ↔ e ∈ B)          per = atom × element
//   eleq1  (A = B) → (A ∈ S ↔ B ∈ S)          per = atom whose side IS an element
//   ssel   (A ⊆ B) → (e ∈ A → e ∈ B)          per ⊆ atom (incl. eqss-derived) × element
// plus the membership unfolds of the memberships the bridges introduce.
// Elements = the left-hand sides of the memberships present in the step.
mizEmitBridges(forms : [FolForm], acc0 : Tree<string, Pair<FolForm, string>>) -> Tree<string, Pair<FolForm, string>> {
	mems : ref [Pair<FolTerm, FolTerm>] = ref [];
	subs : ref [Pair<FolTerm, FolTerm>] = ref [];
	eqs  : ref [Pair<FolTerm, FolTerm>] = ref [];
	iter(forms, \f -> mizEmitHarvest(f, mems, subs, eqs));
	elems = uniqBy(map(^mems, firstOfPair), \a, b -> mizEmitTKey(a) == mizEmitTKey(b));
	allSubs = concat(^subs, concatA(map(^eqs, \q -> [q, Pair(q.second, q.first)])));
	add = \acc, f, lemma -> setTree(acc, mizEmitKey(f), Pair(f, lemma));
	// reflexivity per element — identity chains (velsn: x ∈ {x} needs x = x)
	// are unreachable propositionally without it
	accR = fold(elems, acc0, \acc, e -> add(acc, FolEq(e, e), "eqid"));
	acc1 = fold(^eqs, accR, \acc, q -> {
		eqf = FolEq(q.first, q.second);
		a1 = add(acc, FolBin("iff", eqf, FolBin("and",
			mizEmitSs(q.first, q.second), mizEmitSs(q.second, q.first))), "eqss");
		a2 = fold(elems, a1, \ac, e -> add(ac,
			FolBin("imp", eqf, FolBin("iff", mizEmitMem(e, q.first), mizEmitMem(e, q.second))), "eleq2"));
		// an equality between ELEMENTS: bridge their memberships in every set
		// present — and UNFOLD the memberships the bridge introduces: the eleq1
		// instance states `⟨a,b⟩ ∈ (X ∩ P)`, and without its elin/opelxp unfolds
		// the new atom is as opaque as the old one (t8_relat_1's sub-proof had
		// every fact and still failed on exactly this)
		lk = mizEmitTKey(q.first); rk = mizEmitTKey(q.second);
		sideIsElem = exists(elems, \e -> { k = mizEmitTKey(e); k == lk || k == rk; });
		if (!sideIsElem) a2
		else fold(^mems, a2, \ac, m -> {
			a3 = add(ac, FolBin("imp", eqf, FolBin("iff",
				mizEmitMem(q.first, m.second), mizEmitMem(q.second, m.second))), "eleq1");
			mizEmitMemGen(q.second, m.second, mizEmitMemGen(q.first, m.second, a3));
		});
	});
	fold(allSubs, acc1, \acc, s -> fold(elems, acc, \ac, e -> {
		a1 = add(ac, FolBin("imp", mizEmitSs(s.first, s.second),
			FolBin("imp", mizEmitMem(e, s.first), mizEmitMem(e, s.second))), "ssel");
		mizEmitMemGen(e, s.second, mizEmitMemGen(e, s.first, a1));
	}));
}

mizEmitIsOpair(t : FolTerm) -> bool {
	switch (t) { FolApp(n, args): n == "opair" && length(args) == 2; default: false; }
}

mizEmitIsVar(t : FolTerm) -> bool {
	switch (t) { FolVar(__): true; default: false; }
}

mizEmitIff(acc : Tree<string, Pair<FolForm, string>>, x : FolTerm, s : FolTerm,
	body : FolForm, lemma : string) -> Tree<string, Pair<FolForm, string>> {
	inst = FolBin("iff", mizEmitMem(x, s), body);
	setTree(acc, mizEmitKey(inst), Pair(inst, lemma));
}

mizEmitHarvest(f : FolForm, mems : ref [Pair<FolTerm, FolTerm>],
	subs : ref [Pair<FolTerm, FolTerm>], eqs : ref [Pair<FolTerm, FolTerm>]) -> void {
	switch (f) {
		FolNeg(g):        mizEmitHarvest(g, mems, subs, eqs);
		FolBin(__, l, r): { mizEmitHarvest(l, mems, subs, eqs); mizEmitHarvest(r, mems, subs, eqs); }
		FolPred(name, args): {
			if (length(args) == 2) {
				if (name == "∈") mems := arrayPush(^mems, Pair(args[0], args[1]))
				else if (name == "⊆") subs := arrayPush(^subs, Pair(args[0], args[1]));
			}
		}
		FolEq(l, r): eqs := arrayPush(^eqs, Pair(l, r));
		default: {}
	}
}

uniqBy(xs : [?], eq : (?, ?) -> bool) -> [?] {
	fold(xs, [], \acc, x -> if (exists(acc, \y -> eq(x, y))) acc else arrayPush(acc, x));
}

mizEmitMemGen(x : FolTerm, s : FolTerm, acc : Tree<string, Pair<FolForm, string>>) -> Tree<string, Pair<FolForm, string>> {
	switch (s) {
		FolApp(op, args): {
			if (length(args) == 2 && (op == "∪" || op == "∩" || op == "∖")) {
				ma = mizEmitMem(x, args[0]);
				mb = mizEmitMem(x, args[1]);
				body = if (op == "∪") FolBin("or", ma, mb)
					else if (op == "∩") FolBin("and", ma, mb)
					else FolBin("and", ma, FolNeg(mb));
				lemma = if (op == "∪") "elun" else if (op == "∩") "elin" else "eldif";
				inst = FolBin("iff", mizEmitMem(x, s), body);
				acc1 = setTree(acc, mizEmitKey(inst), Pair(inst, lemma));
				mizEmitMemGen(x, args[1], mizEmitMemGen(x, args[0], acc1));
			} else if (length(args) == 2 && op == "△") {
				// SYMMETRIC DIFFERENCE is a foundation operator like the other three
				// and was simply missing from this table, so `x ∈ (X △ Y)` reached
				// the proof opaque and every △ identity of xboole_1 stopped
				// one step short of its statement.
				inst = FolBin("iff", mizEmitMem(x, s),
					FolNeg(FolBin("iff", mizEmitMem(x, args[0]), mizEmitMem(x, args[1]))));
				acc1 = setTree(acc, mizEmitKey(inst), Pair(inst, "elsymdif"));
				mizEmitMemGen(x, args[1], mizEmitMemGen(x, args[0], acc1));
			} else if (length(args) == 2 && op == "×." && mizEmitIsOpair(x)) {
				// an ORDERED PAIR in a cartesian product: opelxp is the same kind of
				// unfold, and it is the atom every relat_1 / zfmisc_1 step about a
				// relation is made of. A non-pair element needs elxp's ∃∃, which is
				// not an unfold and stays out.
				ps = switch (x) { FolApp(__, as2): as2; default: []; };
				inst = FolBin("iff", mizEmitMem(x, s),
					FolBin("and", mizEmitMem(ps[0], args[0]), mizEmitMem(ps[1], args[1])));
				acc1 = setTree(acc, mizEmitKey(inst), Pair(inst, "opelxp"));
				mizEmitMemGen(ps[1], args[1], mizEmitMemGen(ps[0], args[0], acc1));
			} else if (op == "∅" && args == []) {
				inst = FolNeg(mizEmitMem(x, s));
				setTree(acc, mizEmitKey(inst), Pair(inst, "noel"));
			} else if (mizEmitIsVar(x) && op == "singleton" && length(args) == 1) {
				mizEmitIff(acc, x, s, FolEq(x, args[0]), "velsn");
			} else if (mizEmitIsVar(x) && op == "pair" && length(args) == 2) {
				mizEmitIff(acc, x, s,
					FolBin("or", FolEq(x, args[0]), FolEq(x, args[1])), "velpr");
			} else if (mizEmitIsVar(x) && op == "triple" && length(args) == 3) {
				mizEmitIff(acc, x, s, FolBin("or",
					FolBin("or", FolEq(x, args[0]), FolEq(x, args[1])),
					FolEq(x, args[2])), "veltp");
			} else if (mizEmitIsVar(x) && op == "𝒫" && length(args) == 1) {
				mizEmitIff(acc, x, s, mizEmitSs(x, args[0]), "velpw");
			} else acc;
		}
		default: acc;
	}
}

// ---- S-B: eliminating a universal at a recorded WITNESS TERM ----
// Mizar's <Assign> witnesses are terms (`X ∪ Y`), and the ladder could only
// instantiate at a variable (spv). The foundation's spcgv does terms:
//   spcgv:  hyp (x = A) → (φ ↔ ψ)   ⊢  (A ∈ V) → (∀x φ → ψ)
// so an elimination is: the congruence walk for the hypothesis, the term's
// SETHOOD for the antecedent, then two ax-mp. Sethood is proved bottom-up —
// a variable by `vex`, a functor term by the article's own `sh_<f>` axiom
// instantiated (recursively) at its arguments.

mizEmitTermVars(t : FolTerm) -> [string] {
	switch (t) {
		FolVar(n):        [n];
		FolApp(__, args): concatA(map(args, mizEmitTermVars));
		FolAbs(__, __):   [];
	}
}

// The FOUNDATION's own sethood lemmas for the A-map functors, with the argument
// sethoods each one takes as hypotheses (in order). The article emits no `sh_`
// axiom for a reused functor — the foundation already proves it.
mizEmitFoundSethood(name : string) -> Maybe<Pair<string, [int]>> {
	lookupTree(pairs2tree([
		Pair("∪", Pair("unex", [0, 1])),
		Pair("∩", Pair("inex1", [0])),
		Pair("∖", Pair("difexi", [0])),
		Pair("△", Pair("symdifex", [0, 1])),
		Pair("×.", Pair("xpex", [0, 1])),
		Pair("𝒫", Pair("pwex", [0])),
		Pair("∪.", Pair("uniex", [0])),
		Pair("∅", Pair("0ex", [])),
		Pair("singleton", Pair("snex", [])),
		Pair("pair", Pair("prex", [])),
		Pair("triple", Pair("tpex", [])),
		Pair("opair", Pair("opex", [])),
	]), name);
}

// steps proving |- (t ∈ _V); None when some functor on the way has no sethood
// axiom in the article. `shOf` names the sethood axiom of a functor.
mizEmitSethood(steps : ref [FolPStep], dj : ref [Pair<string, string>],
	t : FolTerm, shOf : (string) -> string, depth : int) -> Maybe<int> {
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	inV = \tt : FolTerm -> FolPred("∈", [tt, FolApp("_V", [])]);
	if (depth > 6) None()
	else switch (t) {
		FolVar(__): Some(emit(inV(t), "vex", []));
		FolAbs(__, __): None();
		FolApp(name, args): switch (mizEmitFoundSethood(name)) {
			Some(fs): {
				// a foundation functor: cite its lemma with the argument
				// sethoods it asks for
				r = fold(fs.second, Some([]), \acc : Maybe<[FolPRef]>, j ->
					switch (acc) {
						None(): None();
						Some(rs): if (j >= length(args)) None()
							else switch (mizEmitSethood(steps, dj, args[j], shOf, depth + 1)) {
								None(): None();
								Some(k): Some(arrayPush(rs, FolPRefStep(k)));
							}
					});
				switch (r) {
					None(): None();
					Some(rs): Some(emit(inV(t), fs.first, rs));
				}
			}
			None(): {
			// a FOUNDATION operator absent from the table has no sh_ axiom to
			// cite — guessing one emitted `sh_symdiff` and Russell disproved
			// the article; decline and the instance simply does not build
			sh = if (folAmapReusedTerm(name)) "" else shOf(name);
			if (sh == "") None()
			else {
				// the sethood axiom is ∀s0…sn ( f(s̄) ∈ _V ); instantiate it at
				// the actual arguments, which needs their sethood in turn
				vars = map(enumFromTo(0, length(args) - 1), \i -> "S" + i2s(i));
				form0 = FolPred("∈", [FolApp(name, map(vars, \v -> FolVar(v))), FolApp("_V", [])]);
				start = if (vars == []) form0 else FolQuant("forall", vars, form0);
				i0 = emit(start, sh, []);
				r = foldi(args, Some(Pair(start, i0)), \j, acc : Maybe<Pair<FolForm, int>>, a ->
					switch (acc) {
						None(): None();
						Some(st): mizEmitElimAt(steps, dj, st.first, st.second, vars[j], a, shOf, depth + 1);
					});
				switch (r) {
					None(): None();
					Some(fin): if (fin.first == inV(t)) Some(fin.second) else None();
				}
			}
			}
		}
	}
}

// ONE elimination: from `∀x φ` at step `srcIdx` to `φ[t/x]`, by spcgv.
// Returns (instance, step index).
mizEmitElimAt(steps : ref [FolPStep], dj : ref [Pair<string, string>],
	f : FolForm, srcIdx : int, x : string, t : FolTerm,
	shOf : (string) -> string, depth : int) -> Maybe<Pair<FolForm, int>> {
	switch (mizEmitInstImp(steps, dj, f, x, t, shOf, depth)) {
		None(): None();
		Some(im): {
			steps := arrayPush(^steps, FolPStep(im.second, "ax-mp",
				[FolPRefStep(srcIdx), FolPRefStep(im.first)]));
			Some(Pair(im.second, length(^steps) - 1));
		}
	}
}

// the INSTANCE IMPLICATION `∀x φ → φ[t/x]` on its own — what an elimination
// under an assumption needs (the ∀ is only reachable as `asm → ∀x φ`, so the
// implication is chained by syl instead of discharged by ax-mp)
mizEmitInstImp(steps : ref [FolPStep], dj : ref [Pair<string, string>],
	f : FolForm, x : string, t : FolTerm,
	shOf : (string) -> string, depth : int) -> Maybe<Pair<int, FolForm>> {
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	switch (f) {
		FolQuant(q, vs, body): {
			if (q != "forall" || vs == [] || vs[0] != x) None()
			else {
				rest = if (length(vs) == 1) body else FolQuant(q, tail(vs), body);
				// The IDENTITY instance needs no substitution — and must not go
				// through spcgv, whose disjoint-variable condition forbids the
				// witness being the binder itself (an invalid proof Russell
				// accepts and the Metamath checker rejects). It goes through the
				// IMPLICATION form `sp`, not `spi`: spi's binder occurs only in
				// its hypothesis, so the Metamath export cannot determine it and
				// emits no floating argument for it.
				if (switch (t) {
					FolVar(vn): toLowerCase(vn) == toLowerCase(x);
					default: false;
				}) Some(Pair(emit(FolBin("imp", f, rest), "sp", []), rest))
				// ...and a witness that MENTIONS the binder is no better: spcgv is
				// disjointed(A x), so instantiating x5 at `𝒫 x5` is not an instance
				// of anything. Russell caught it on t1_subset_1 the moment
				// definitions began to be matched at any term of the step.
				else if (mizEmitTermHas(x, t)) {
					mizEmitInstDeclBinder := ^mizEmitInstDeclBinder + 1;
					mizEmitInstDeclNames := setTree(^mizEmitInstDeclNames, x,
						lookupTreeDef(^mizEmitInstDeclNames, x, 0) + 1);
					if (^mizEmitDbg || (getUrlParameterDef("dbg-decl", "") == "1"
						&& ^mizEmitInstDeclBinder <= 5))
						println("  INSTIMP-DECLINE binder-in-witness " + x
						+ " wit=" + strGlue(folTermToks(t), " ")
						+ " stmt=" + strGlue(folFormToks(f), " "));
					None();
				}
				else switch (mizEmitWalkT(steps, dj, x, t, rest)) {
					None(): {
						mizEmitInstDeclWalk := ^mizEmitInstDeclWalk + 1;
						if (^mizEmitDbg) println("  INSTIMP-DECLINE walk " + x);
						None();
					}
					Some(wk): switch (mizEmitSethood(steps, dj, t, shOf, depth)) {
						None(): {
							mizEmitInstDeclSeth := ^mizEmitInstDeclSeth + 1;
							if (^mizEmitDbg) println("  INSTIMP-DECLINE sethood " + x);
							None();
						}
						Some(shIdx): {
							// spcgv is disjointed(A x, ps x): the binder must be apart
							// from the witness's variables AND from every variable of
							// the RESULTING instance. Declaring only the witness's left
							// `disjointed(x5 x7)` undeclared in t29_xboole_1, and
							// Russell rejected the article.
							xr = toLowerCase(x);
							dj := fold(concat(mizEmitTermVars(t), folFormVars(wk.second)), ^dj,
								\ac, v -> if (toLowerCase(v) == xr) ac
									else arrayPush(ac, Pair(xr, toLowerCase(v))));
							inV = FolPred("∈", [t, FolApp("_V", [])]);
							sp = emit(FolBin("imp", inV, FolBin("imp", f, wk.second)),
								"spcgv", [FolPRefStep(wk.first)]);
							Some(Pair(emit(FolBin("imp", f, wk.second), "ax-mp",
								[FolPRefStep(shIdx), FolPRefStep(sp)]), wk.second));
						}
					}
				}
			}
		}
		default: None();
	}
}

// A cited assertion whose statement is OPEN — an article theorem, whose prop
// carries free variables and is implicitly universally closed — is instantiated
// by Russell itself when the step names it, so the whole elimination is one
// step stating the instance. Citing such a theorem with a ∀-closed form instead
// is what made t90/t110_xboole_1 unverifiable: the step's claim could not be
// matched against the theorem's actual proposition.
mizEmitCiteTheorem(name : string, stmt : FolForm, fact : FolForm) -> Maybe<MizEmitDrv> {
	// the statement may be the .eth's ∀-closed form of the same matrix, so both
	// readings are tried: substitute the theorem's own variables, or eliminate
	// a universal prefix. Either way the EMITTED step states the instance and
	// names the theorem — Russell does the substitution.
	pre = mizEmitPrefixOf(stmt, []);
	metas = if (pre.first == []) buildSet(folFormVars(stmt)) else buildSet(pre.first);
	if (isEmptySet(metas)) None()
	else fold(mizEmitPieces(pre.second, [], 2), None(), \acc : Maybe<MizEmitDrv>, pc ->
		switch (acc) {
			Some(__): acc;
			None(): switch (mizEmitMatchF(pc.form, fact, metas, Some(makeTree()))) {
				None(): None();
				Some(sub): {
					inst = mizEmitSubF(pc.form, sub);
					// The CITED STEP must state what the theorem states, not the PIECE
					// of it the fact came from: a step reading `¬(A ∧ B)` while
					// t56_zfmisc_1 proves `¬(A ∧ B) ∧ ¬(C ∧ D)` cannot be matched
					// against the theorem, and Russell disproves the article. So the
					// whole statement is instantiated and the piece is reached from it
					// by the piece's own ops. A binder the piece does not mention gets
					// no witness, and leaving it as itself can collide with one — such
					// a match is dropped rather than guessed.
					whole = mizEmitSubF(pre.second, sub);
					complete = forall(folFormVars(pre.second),
						\v -> !containsSet(metas, v) || isSome(lookupTree(sub, v)));
					if (inst != fact || !complete) None()
					else {
						// the cited theorem's declared disjointedness maps through
						// the substitution: every group member must land on a
						// VARIABLE, pairwise distinct — else the citation is
						// illegal and the instance declines (t58_enumset1 cited a
						// theorem declaring disjointed(x2 x3 x4) and the citing
						// theorem inherited nothing)
						groups = lookupTreeDef(^mizEmitThmDisjsRef, name, []);
						mdis : Maybe<[Pair<string, string>]> = fold(groups, Some([]),
							\ac7 : Maybe<[Pair<string, string>]>, grp -> switch (ac7) {
								None(): None();
								Some(ps7): {
									vs7 = map(grp, \g7 -> switch (lookupTree(sub, g7)) {
										None(): Some(toLowerCase(g7));
										Some(tv): switch (tv) {
											FolVar(vn7): Some(toLowerCase(vn7));
											default: None();
										}
									});
									if (exists(vs7, isNone)) None()
									else {
										names7 = map(vs7, \m7 -> either(m7, ""));
										if (length(uniq(names7)) != length(names7)) None()
										else Some(concat(ps7, concatA(mapi(names7, \i7, a7 ->
											map(subrange(names7, i7 + 1, length(names7) - i7 - 1),
												\b7 -> Pair(a7, b7))))));
									}
								}
							});
						switch (mdis) {
							None(): None();
							Some(dps): {
								steps : ref [FolPStep] = ref [];
								i0 = {
									steps := arrayPush(^steps, FolPStep(whole, name, []));
									0;
								};
								switch (mizEmitApplyOps(steps, whole, i0, pc.ops)) {
									None(): None();
									Some(fin): if (fin.first != fact) None()
										else Some(MizEmitDrv(fact, ^steps, [], dps));
								}
							}
						}
					}
				}
			}
		});
}

// ---- a fact that arrives UNDER ITS OWN GUARDS ----
// A constructor-type axiom says `argGuards(L̄) → typ(f(L̄))`, so a step wanting
// the type fact cannot match the axiom as a whole. Matching its CONCLUSION —
// the right end of the implication spine — fixes the loci, and the instance is
// emitted whole: the guards are then discharged by the caller (mizEmitPeel),
// which is where a guard that is itself a type fact recurses.
mizEmitConcl(f : FolForm) -> FolForm {
	switch (f) {
		FolBin(op, __, r): if (op == "imp") mizEmitConcl(r) else f;
		default: f;
	}
}

mizEmitGuardedInsts(cands : [string], g : FolForm,
	stmtOf : (string) -> Maybe<FolForm>, isAxiom : (string) -> bool,
	shOf : (string) -> string, cap : int) -> [MizEmitDrv] {
	fold(cands, [], \acc : [MizEmitDrv], c ->
		if (length(acc) >= cap) acc
		else switch (stmtOf(c)) {
			None(): acc;
			Some(st): if (!isAxiom(c)) acc else {
				pre = mizEmitPrefixOf(st, []);
				binders = pre.first;
				concl = mizEmitConcl(pre.second);
				// an UNGUARDED axiom (concl == the whole body) is matched too:
				// the unconditional cluster/constructor-type registrations
				// (`relation-like ((#) a b)`, ct4/ct6_relat_1) are exactly the
				// guard facts the d8/d10 characterizations wait for, and no
				// other channel offers them (they are cited by nobody and share
				// only their skeleton with the step)
				if (binders == []) acc
				else switch (mizEmitBinderWits(concl, g, buildSet(binders), binders)) {
					None(): acc;
					Some(ws): switch (mizEmitRecordDrv(c, st, ws, [], shOf)) {
						None(): acc;
						Some(d): arrayPush(acc, d);
					}
				}
			}
		});
}

// The first citation of the step whose statement instantiates to the recorded
// fact, emitted as a derived fact proved from it.
// A recorded premise the FOUNDATION already proves is a one-step citation, not
// a search: match the instance against the foundation rows and cite the row.
// This is how the soft-type lemmas reach a step — the article states none of
// them, and after the mode became foundation-provided it has no definition of
// its own to instantiate either.
mizEmitFoundFact(fact : FolForm) -> Maybe<MizEmitDrv> {
	metas = buildSet(["A", "B", "C", "D"]);
	fold(mizEmitFoundIffTable(), None(), \acc : Maybe<MizEmitDrv>, row -> switch (acc) {
		Some(__): acc;
		None(): switch (mizEmitMatchF(row.second, fact, metas, Some(makeTree()))) {
			None(): None();
			Some(sub): if (mizEmitSubF(row.second, sub) != fact) None()
				else Some(MizEmitDrv(fact, [FolPStep(fact, row.first, [])], [], []));
		}
	});
}

mizEmitRecFromCites(cites : [string], fact : FolForm,
	stmtOf : (string) -> Maybe<FolForm>, isAxiom : (string) -> bool,
	shOf : (string) -> string) -> Maybe<MizEmitDrv> {
	// per FACT, where the join stops: no citation statement / no citation
	// instantiates to it / the elimination cannot be emitted
	if (exists(cites, \c -> isSome(stmtOf(c)))) mizEmitRecCites := ^mizEmitRecCites + 1;
	if (exists(cites, \c -> switch (stmtOf(c)) {
		None(): false;
		Some(st): isSome(mizEmitMatchInst(st, fact));
	})) mizEmitRecMatch := ^mizEmitRecMatch + 1;
	r0 = fold(cites, None(), \acc : Maybe<MizEmitDrv>, c -> switch (acc) {
		Some(__): acc;
		None(): switch (stmtOf(c)) {
			None(): None();
			Some(st): if (!isAxiom(c)) mizEmitCiteTheorem(c, st, fact)
				else switch (mizEmitMatchInst(st, fact)) {
					// the plain prefix does not reach it — retry through the guards
					None(): switch (mizEmitMatchInstG(st, fact)) {
						None(): None();
						Some(ws): mizEmitRecordDrvG(c, st, ws, shOf);
					}
					Some(mt): mizEmitRecordDrv(c, st, mt.first, mt.second, shOf);
				}
		}
	});
	switch (r0) {
		Some(__): r0;
		None(): mizEmitFoundFact(fact);
	}
}

// ---- THE CHECKER'S IFF, IN HALF THE SIZE ----
// Mizar's checker normalizes `A ↔ B` to `¬(A ∧ ¬B) ∧ (¬B ∨ A)`, and every
// definition it hands us arrives in that shape: twice the connectives of the
// equivalence it states, with the disjuncts buried under a negated conjunction.
// Since the fact BUDGET is what binds — raising it runs the tableau out of
// memory — the cheaper form is worth a proof of its own. It is a propositional
// consequence, so the proof itself derives it, over three atoms and in a
// handful of steps, and the STEP's tableau then sees the equivalence.
mizEmitCleanIff(d0 : MizEmitDrv) -> MizEmitDrv {
	// FIRST the quantifier normalizer: a definition arrives with its
	// quantifiers buried under negations (the checker has only ¬ ∧ ∀), and no
	// propositional conversion can reach through them. QNF proves `f ↔ f'`
	// and mpbi re-states the fact; the propositional cleanup then runs on f'.
	d = if (d0.steps == []) d0 else {
		st : ref [FolPStep] = ref d0.steps;
		blockLast = length(^st) - 1;
		switch (mizEmitQNF(st, d0.form, 0)) {
			None(): d0;
			Some(w): if (w.second == d0.form) d0 else {
				st := arrayPush(^st, FolPStep(w.second, "mpbi",
					[FolPRefStep(blockLast), FolPRefStep(w.first)]));
				mizEmitCleaned := ^mizEmitCleaned + 1;
				MizEmitDrv(w.second, ^st, d0.refs, d0.disjs);
			}
		}
	};
	mizEmitCleanIff0(d);
}

mizEmitCleanIff0(d : MizEmitDrv) -> MizEmitDrv {
	if (getUrlParameterDef("dbg-clean", "") == "1")
		println("CLEAN? cands=" + i2s(length(mizEmitIffCands(d.form)))
			+ " :: " + strGlue(folFormToks(d.form), " "));
	fold(mizEmitIffCands(d.form), d, \acc : MizEmitDrv, clean ->
		if (acc.form != d.form) acc
		else if (mizEmitFormSize(clean) >= mizEmitFormSize(d.form)) acc
		else {
			atoms : ref Tree<string, FolForm> = ref makeTree();
			factP = mizEmitP(atoms, d.form);
			goalP = mizEmitP(atoms, clean);
			tab = ^atoms;
			switch (folPCertBounded([factP], goalP,
				\k -> lookupTreeDef(tab, k, FolPred("$false", [])), 2000, 300)) {
				None(): {
					if (getUrlParameterDef("dbg-clean", "") == "1")
						println("  CLEAN-FAIL " + folPCertLastFail() + " :: "
							+ strGlue(folFormToks(clean), " "));
					acc;
				}
				Some(cs): {
					base = length(d.steps);
					shifted = map(cs, \c -> FolPStep(c.form, c.assertion, map(c.refs, \r -> switch (r) {
						FolPRefStep(k): FolPRefStep(base + k);
						FolPRefFact(__): FolPRefStep(base - 1);
					})));
					mizEmitCleaned := ^mizEmitCleaned + 1;
					MizEmitDrv(clean, concat(d.steps, shifted), d.refs, d.disjs);
				}
			}
		});
}

// The checker's iff is a CONJUNCTION OF TWO IMPLICATIONS, each written in
// whatever negated form its normalization left: `A → B` beside `¬(B ∧ ¬A)`,
// or `¬(A ∧ N)` beside `N ∨ A`. Rather than enumerate the shapes, each half is
// read as an implication, the two candidate equivalences are formed, and the
// CERTIFICATE decides — a guess it cannot prove is simply not offered.
mizEmitIffCands(f : FolForm) -> [FolForm] {
	switch (f) {
		FolBin(op, l, r): if (op != "and") [] else {
			i1 = mizEmitAsImp(l);
			i2 = mizEmitAsImp(r);
			switch (i1) {
				None(): [];
				Some(p1): switch (i2) {
					None(): [];
					Some(p2): uniq([FolBin("iff", p1.first, p1.second),
						FolBin("iff", p2.first, p2.second)]);
				}
			}
		}
		default: [];
	}
}

// one half, read as an implication:
//   A → B                    as itself
//   ¬(c₁ ∧ … ∧ ¬A)           as (c₁ ∧ …) → A     — the trailing ¬A is the conclusion
//   ¬(A ∧ B)                 as A → ¬B
//   A ∨ B                    as ¬A → B
mizEmitAsImp(f : FolForm) -> Maybe<Pair<FolForm, FolForm>> {
	switch (f) {
		FolBin(op, l, r):
			if (op == "imp") Some(Pair(l, r))
			else if (op == "or") Some(Pair(mizEmitNegIn(l), r))
			else None();
		FolNeg(g): switch (g) {
			FolBin(op2, __, __): if (op2 != "and") None() else {
				cs = mizEmitConjuncts(g, []);
				n = length(cs);
				switch (cs[n - 1]) {
					FolNeg(a): Some(Pair(mizEmitConj(subrange(cs, 0, n - 1)), a));
					default: switch (g) {
						FolBin(__, a, b): Some(Pair(a, mizEmitNegIn(b)));
						default: None();
					}
				}
			}
			default: None();
		}
		default: None();
	}
}

mizEmitConjuncts(f : FolForm, acc : [FolForm]) -> [FolForm] {
	switch (f) {
		FolBin(op, l, r): if (op != "and") arrayPush(acc, f)
			else mizEmitConjuncts(r, mizEmitConjuncts(l, acc));
		default: arrayPush(acc, f);
	}
}

mizEmitConj(fs : [FolForm]) -> FolForm {
	if (fs == []) FolPred("$true", [])
	else foldi(tail(fs), fs[0], \__, acc, f -> FolBin("and", acc, f));
}

// ¬(¬p ∧ rest) -> p ∨ ¬rest, recursively; anything else keeps its negation
mizEmitNegIn(f : FolForm) -> FolForm {
	switch (f) {
		FolNeg(g): g;
		FolBin(op, l, r): if (op != "and") FolNeg(f)
			else FolBin("or", mizEmitNegIn(l), mizEmitNegIn(r));
		default: FolNeg(f);
	}
}

mizEmitFormSize(f : FolForm) -> int {
	switch (f) {
		FolNeg(g): 1 + mizEmitFormSize(g);
		FolBin(__, l, r): 1 + mizEmitFormSize(l) + mizEmitFormSize(r);
		FolQuant(__, __, b): 1 + mizEmitFormSize(b);
		default: 1;
	}
}

// A RECORDED fact as a derived fact: cite the premise by name, then eliminate
// its binders at the matched witnesses. `premName` must be an assertion of the
// article (a cited theorem/definition) whose statement is `premise`.
mizEmitRecordDrv(premName : string, premise : FolForm,
	wits : [Pair<string, FolTerm>], ops : [string],
	shOf : (string) -> string) -> Maybe<MizEmitDrv> {
	steps : ref [FolPStep] = ref [];
	dj : ref [Pair<string, string>] = ref [];
	i0 = {
		steps := arrayPush(^steps, FolPStep(premise, premName, []));
		0;
	};
	r = fold(wits, Some(Pair(premise, i0)), \acc : Maybe<Pair<FolForm, int>>, wp ->
		switch (acc) {
			None(): None();
			Some(st): mizEmitElimAt(steps, dj, st.first, st.second, wp.first, wp.second, shOf, 0);
		});
	switch (r) {
		None(): None();
		Some(fin): switch (mizEmitApplyOps(steps, fin.first, fin.second, ops)) {
			None(): None();
			Some(fin2): if (length(^steps) <= 1) None()
				else switch (mizEmitMapThmDisjs(premName, \g7 ->
						maybeMap(find(wits, \wp7 -> toLowerCase(wp7.first) == toLowerCase(g7)),
							\wp7 -> wp7.second))) {
					None(): None();
					Some(dps7): Some(MizEmitDrv(fin2.first, ^steps, [], uniq(concat(^dj, dps7))));
				}
		}
	}
}

// ---- matching a CITED statement against a RECORDED instance ----
// The record says WHICH premise the checker used and WHAT instance it needed,
// but not which of the step's citations that premise is: <Premise> carries the
// checker's NORMALIZED formula (an iff split into two implications, ∃ dualized),
// which no longer matches the article's own axiom text. So the join runs the
// other way — take the recorded instance, and for each citation of the step ask
// whether its statement instantiates to it. First-order matching recovers the
// witness terms itself, so it needs no agreement with the checker's binder
// numbering.

mizEmitSubT(t : FolTerm, sub : Tree<string, FolTerm>) -> FolTerm {
	switch (t) {
		FolVar(n): lookupTreeDef(sub, n, t);
		FolApp(n, args): FolApp(n, map(args, \a -> mizEmitSubT(a, sub)));
		FolAbs(v, b): FolAbs(v, mizEmitSubF(b, sub));
	}
}

mizEmitSubF(f : FolForm, sub : Tree<string, FolTerm>) -> FolForm {
	switch (f) {
		FolPred(n, args):  FolPred(n, map(args, \a -> mizEmitSubT(a, sub)));
		FolEq(l, r):       FolEq(mizEmitSubT(l, sub), mizEmitSubT(r, sub));
		FolNeg(g):         FolNeg(mizEmitSubF(g, sub));
		FolBin(op, l, r):  FolBin(op, mizEmitSubF(l, sub), mizEmitSubF(r, sub));
		FolQuant(q, vs, b): FolQuant(q, vs, mizEmitSubF(b, fold(vs, sub,
			\s, v -> removeFromTree(s, v))));
	}
}

// one-sided matching: bind the pattern's metavariables so that pat[sub] == tgt
mizEmitMatchT(pat : FolTerm, tgt : FolTerm, meta : Set<string>,
	sub : Maybe<Tree<string, FolTerm>>) -> Maybe<Tree<string, FolTerm>> {
	switch (sub) {
		None(): None();
		Some(s): switch (pat) {
			FolVar(n): if (!containsSet(meta, n)) (if (pat == tgt) sub else None())
				else switch (lookupTree(s, n)) {
					None(): Some(setTree(s, n, tgt));
					Some(old): if (old == tgt) sub else None();
				};
			FolApp(n, args): switch (tgt) {
				FolApp(n2, args2): if (n != n2 || length(args) != length(args2)) None()
					else foldi(args, sub, \i, acc, a -> mizEmitMatchT(a, args2[i], meta, acc));
				default: None();
			}
			FolAbs(__, __): if (pat == tgt) sub else None();
		}
	}
}

mizEmitMatchF(pat : FolForm, tgt : FolForm, meta : Set<string>,
	sub : Maybe<Tree<string, FolTerm>>) -> Maybe<Tree<string, FolTerm>> {
	switch (sub) {
		None(): None();
		Some(__): switch (pat) {
			FolPred(n, args): switch (tgt) {
				FolPred(n2, args2): if (n != n2 || length(args) != length(args2)) None()
					else foldi(args, sub, \i, acc, a -> mizEmitMatchT(a, args2[i], meta, acc));
				default: None();
			}
			FolEq(l, r): switch (tgt) {
				// equality is symmetric, and a definition states `f(ā) = …` while
				// a step may write `… = f(ā)`; try both orientations
				FolEq(l2, r2): {
					d = mizEmitMatchT(r, r2, meta, mizEmitMatchT(l, l2, meta, sub));
					if (isSome(d)) d
					else mizEmitMatchT(r, l2, meta, mizEmitMatchT(l, r2, meta, sub));
				}
				default: None();
			}
			FolNeg(g): switch (tgt) {
				FolNeg(g2): mizEmitMatchF(g, g2, meta, sub);
				default: None();
			}
			FolBin(op, l, r): switch (tgt) {
				FolBin(op2, l2, r2): if (op != op2) None()
					else mizEmitMatchF(r, r2, meta, mizEmitMatchF(l, l2, meta, sub));
				default: None();
			}
			FolQuant(q, vs, b): switch (tgt) {
				// A BOUND VARIABLE'S NAME IS NOT PART OF THE STATEMENT. The
				// checker's instance keeps the binders it did not eliminate under
				// ITS names (`∀ xd4 …`) while our statement carries ours (`∀ xq4 …`),
				// and demanding the names agree rejected every instance with a
				// quantifier left in it — 37 of subset_1's unbuilt instances and 128
				// of relat_1's. The target's binders are renamed to the pattern's,
				// which is a renaming and not a substitution: it is refused if one
				// of the pattern's names occurs free in the target's body.
				FolQuant(q2, vs2, b2): if (q != q2 || length(vs) != length(vs2)) None()
					else {
						meta2 = fold(vs, meta, \m, v -> removeSet(m, v));
						if (vs == vs2) mizEmitMatchF(b, b2, meta2, sub)
						else {
							frees = buildSet(mizFormFreeVars(b2));
							if (exists(vs, \v -> containsSet(frees, v))) None()
							else mizEmitMatchF(b, mizEmitSubF(b2, foldi(vs2, makeTree(),
								\i, ac, v2 -> setTree(ac, v2, FolVar(vs[i])))), meta2, sub);
						}
					}
				default: None();
			}
		}
	}
}

mizEmitPrefixOf(f : FolForm, acc : [string]) -> Pair<[string], FolForm> {
	switch (f) {
		FolQuant(q, vs, b): if (q != "forall") Pair(acc, f) else mizEmitPrefixOf(b, concat(acc, vs));
		default: Pair(acc, f);
	}
}

// Does `cited` instantiate to `fact` by eliminating its leading universals?
// Returns the elimination trace in binder order.
// ---- THE UNIVERSALS BEHIND A GUARD ----
// The checker instantiates EVERY universal of its premise, including the ones an
// implication hides: `∀A∀B ( B is Subset of A → ∀C ( C is Subset of A → … ) )`
// comes back instantiated at C too, with both guards still standing. Matching
// only the LEADING prefix left those instances unbuilt — 37 of subset_1's 48 and
// 128 of relat_1's 164.
// The walk THROUGH the guards already exists (mizEmitPrefixGm, and the assembly
// mizEmitRecordDrvG that eliminates each binder under them by syl/syl6): it was
// written for guard-interleaved DEFINITIONS and simply never offered to the
// record's own join. `mizEmitStripGm` removes exactly the binders that walk
// collects, keeping the implication spine, so the recorded instance can be
// matched against the statement as a whole.
// the walk the ASSEMBLY performs (mizEmitElimUnder): a guard is entered only
// while an eliminable binder remains behind it, and at most two are entered.
// The plain mizEmitPrefixGm descends through every implication, which on
// `… → ( ∀xd4 φ → xd2 ⊆ xd3 )` counts a third guard and gives up.
mizEmitHasElim(f : FolForm) -> bool {
	switch (f) {
		FolQuant(q, __, b): q == "forall" || mizEmitHasElim(b);
		FolBin(op, __, r): op == "imp" && mizEmitHasElim(r);
		default: false;
	}
}

mizEmitPrefixGe(f : FolForm, accV : [string], guards : int) -> Pair<[string], FolForm> {
	switch (f) {
		FolQuant(q, vs, b): if (q == "forall") mizEmitPrefixGe(b, concat(accV, vs), guards)
			else Pair(accV, f);
		FolBin(op, __, r): if (op == "imp" && guards < 2 && mizEmitHasElim(r))
			mizEmitPrefixGe(r, accV, guards + 1) else Pair(accV, f);
		default: Pair(accV, f);
	}
}

mizEmitStripGm(f : FolForm, guards : int) -> FolForm {
	switch (f) {
		FolQuant(q, __, b): if (q == "forall") mizEmitStripGm(b, guards) else f;
		FolBin(op, l, r): if (op == "imp" && guards < 2 && mizEmitHasElim(r))
			FolBin("imp", l, mizEmitStripGm(r, guards + 1)) else f;
		default: f;
	}
}

mizEmitMatchInstG(cited : FolForm, fact : FolForm) -> Maybe<[Pair<string, FolTerm>]> {
	gp = mizEmitPrefixGe(cited, [], 0);
	plain = mizEmitPrefixOf(cited, []);
	// nothing new unless the guarded walk reaches binders the plain one cannot
	if (length(gp.first) <= length(plain.first)) None()
	else {
		stripped = mizEmitStripGm(cited, 0);
		switch (mizEmitMatchF(stripped, fact, buildSet(gp.first), Some(makeTree()))) {
			None(): None();
			Some(sub): {
				ws = filtermap(gp.first, \b -> switch (lookupTree(sub, b)) {
					None(): None();
					Some(t): Some(Pair(b, t));
				});
				if (length(ws) != length(gp.first)) None()
				else if (isNone(mizEmitMatchF(mizEmitSubF(stripped, sub), fact,
					makeSet(), Some(makeTree())))) None()
				else Some(ws);
			}
		}
	}
}

mizEmitMatchInst(cited : FolForm, fact : FolForm) -> Maybe<Pair<[Pair<string, FolTerm>], [string]>> {
	pre = mizEmitPrefixOf(cited, []);
	binders = pre.first;
	body = pre.second;
	if (binders == []) None()
	else fold(mizEmitPieces(body, [], 2), None(), \acc : Maybe<Pair<[Pair<string, FolTerm>], [string]>>, pc ->
		switch (acc) {
			Some(__): acc;
			None(): switch (mizEmitMatchF(pc.form, fact, buildSet(binders), Some(makeTree()))) {
				None(): None();
				Some(sub): {
					ws = filtermap(binders, \b -> switch (lookupTree(sub, b)) {
						None(): None();
						Some(t): Some(Pair(b, t));
					});
					// every binder must be determined and the piece must come
					// out exactly as recorded
					if (length(ws) != length(binders)) None()
					// equal UP TO the names of the binders left standing
					else if (isNone(mizEmitMatchF(mizEmitSubF(pc.form, sub), fact,
						makeSet(), Some(makeTree())))) None()
					else Some(Pair(ws, pc.ops));
				}
			}
		});
}

// ---- congruence INSIDE a term ----
// The formula walk could only rewrite an argument that IS the variable, so a
// premise like ∀A∀B (A ⊆ A ∪ B) could not be instantiated at all: substituting
// A has to reach into `A ∪ B` as well. Rewriting one argument slot at a time is
// enough, and both kinds of functor offer exactly that shape —
//   foundation: uneq1 : (A = B) → ((A ∪ C) = (B ∪ C))
//   article:    fn_<f>_cong1d : (a0 = b0) → (f(a0,a1) = f(b0,a1))
// so the slots chain by eqtrd and lift to the antecedent by syl.
mizEmitSlotCong(name : string, slot : int) -> string {
	found = lookupTree(pairs2tree([
		Pair("∪", ["uneq1", "uneq2"]),
		Pair("∩", ["ineq1", "ineq2"]),
		Pair("∖", ["difeq1", "difeq2"]),
		Pair("△", ["symdifeq1", "symdifeq2"]),
		Pair("×.", ["xpeq1", "xpeq2"]),
		Pair("opair", ["opeq1", "opeq2"]),
		Pair("pair", ["preq1", "preq2"]),
		Pair("triple", ["tpeq1", "tpeq2", "tpeq3"]),
		Pair("singleton", ["sneq"]),
		Pair("𝒫", ["pweq"]),
		Pair("∪.", ["unieq"]),
	]), name);
	switch (found) {
		Some(ls): if (slot < length(ls)) ls[slot] else "";
		None(): "fn_" + folRuleId(name) + "_cong" + i2s(slot + 1) + "d";
	}
}

// steps proving |- (x = T → u = u[T/x]); returns (stepIdx, u[T/x])
mizEmitWalkTerm(steps : ref [FolPStep], x : string, t : FolTerm,
	u : FolTerm) -> Maybe<Pair<int, FolTerm>> {
	ante = FolEq(FolVar(x), t);
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	if (u == FolVar(x)) Some(Pair(emit(FolBin("imp", ante, FolEq(u, t)), "id", []), t))
	else if (!mizEmitTermHas(x, u))
		Some(Pair(emit(FolBin("imp", ante, FolEq(u, u)), "eqidd", []), u))
	else switch (u) {
		FolVar(__): None();
		FolAbs(__, __): None();
		FolApp(fn, args): {
			start : Maybe<Pair<int, FolTerm>> =
				Some(Pair(emit(FolBin("imp", ante, FolEq(u, u)), "eqidd", []), u));
			foldi(args, start, \i, acc : Maybe<Pair<int, FolTerm>>, a ->
				switch (acc) {
					None(): None();
					Some(st): if (!mizEmitTermHas(x, a)) acc else {
						lem = mizEmitSlotCong(fn, i);
						if (lem == "") None()
						else switch (mizEmitWalkTerm(steps, x, t, a)) {
							None(): None();
							Some(w): {
								cur : FolTerm = st.second;
								curArgs = switch (cur) { FolApp(__, aa): aa; default: []; };
								if (length(curArgs) != length(args)) None()
								else {
									nxt = FolApp(fn, replace(curArgs, i, w.second));
									cg = emit(FolBin("imp", FolEq(curArgs[i], w.second),
										FolEq(cur, nxt)), lem, []);
									sy = emit(FolBin("imp", ante, FolEq(cur, nxt)), "syl",
										[FolPRefStep(w.first), FolPRefStep(cg)]);
									tr = emit(FolBin("imp", ante, FolEq(u, nxt)), "eqtrd",
										[FolPRefStep(st.first), FolPRefStep(sy)]);
									Some(Pair(tr, nxt));
								}
							}
						}
					}
				});
		}
	}
}

// ---- MERGE-LOG REPLAY: the equation-chain builder ----
// When the goal (after reduction, possibly under an assumption) is an
// EQUATION, the flat proof is the wrong tool: t21_relat_1's chain needs
// ~14 exact facts against a 16-slot cut over ~40 candidates, and no static
// rank can pick them (measured 4x). But the equalizer already computed the
// chain — its facts are the candidate pool the channels built. So build the
// chain OURSELVES: a small proof-producing congruence closure over the
// candidate equations (commutativity of the symmetric foundation ops and slot
// congruence supply the edges the merge log leaves implicit), then emit the
// extracted path as eqtrd/eqcomd/syl steps. Deterministic, no selection cut.
//
// A candidate's payload is a bare equation or a SINGLY-guarded one
// (`g → l = r`); the guard is discharged through the same pool — `g` is the
// assumption itself, an unconditional candidate, or reachable from one by a
// chain of candidate implications (the ct-guard shape `Relation X →
// Relation (X~)`).

// where a candidate's proof lives: drv >= 0 an index into the drv pool
// (its steps spliced on first use), else fact >= 0 a context index
// (referenced, never restated)
MizEqCand(form : FolForm, drv : int, fact : int);
// one edge over the term universe: kind 0 = candidate equation (cand = its
// index), 1 = commutativity, 2 = congruence — round > 0, and its argument
// equalities are provable using edges of strictly earlier rounds only (the
// termination measure of the extraction)
MizEqEdge(a : int, b : int, round : int, kind : int, cand : int);
// a ⊆/= atom reached INSIDE a candidate: through at most one guard (discharged
// via the pool) and a simpl/simpr piece path — the subset closure's edges live
// in conjunctions the payload reader cannot see (a previous step concludes
// `(A ⊆ B) ∧ (C = D)` as one fact)
MizSsPiece(cand : int, guard : Maybe<FolForm>, ops : [string]);
MizEqChainEnv(
	ph : Maybe<FolForm>, phKey : string,
	cands : [MizEqCand],
	drvs : [MizEmitDrv],
	ctx : [Pair<FolForm, RuParseRef>],
	provable : Set<string>,
	uni : Tree<string, int>,
	terms : [FolTerm],
	edges : [MizEqEdge],
	adj : Tree<int, [int]>,
	steps : ref [FolPStep],
	frefs : ref [RuParseRef],
	djs : ref [Pair<string, string>],
	candH : ref Tree<int, FolPRef>,
	guardH : ref Tree<string, FolPRef>,
	eqH : ref Tree<string, FolPRef>,
	// piece-derived equations for kind-3 edges (index = the edge's cand field);
	// empty for the plain equation chain
	pieces : [MizSsPiece]);

mizEqcCommLemma(fn : string) -> string {
	if (fn == "∪") "uncom" else if (fn == "∩") "incom"
	else if (fn == "△") "symdifcom" else if (fn == "pair") "prcom" else "";
}

// the foundation's DISTRIBUTION / ABSORPTION identities as rewrite twins:
// a term matching a lemma's left side gets the right side as a twin term and
// a kind-4 edge citing the lemma — one edge where the proof case-split
// (zfmisc_1's ×.-distribution family t97/t99/t57 is exactly this shape).
// Each entry's orientation is the miz_set statement VERBATIM.
mizEqcRewriteTwins(t : FolTerm) -> [Pair<FolTerm, string>] {
	mk2 = \fn : string, a : FolTerm, b : FolTerm -> FolApp(fn, [a, b]);
	empty = FolApp("∅", []);
	switch (t) {
		FolApp(fn, args): if (length(args) != 2) [] else {
			a0 = args[0];
			a1 = args[1];
			concatA([
				// ×. over ∪ / ∩
				if (fn == "×.") concatA([
					switch (a0) {
						FolApp(f0, i0): if (length(i0) == 2 && f0 == "∪")
								[Pair(mk2("∪", mk2("×.", i0[0], a1), mk2("×.", i0[1], a1)), "xpundir")]
							else if (length(i0) == 2 && f0 == "∩")
								[Pair(mk2("∩", mk2("×.", i0[0], a1), mk2("×.", i0[1], a1)), "xpindir")]
							else [];
						default: [];
					},
					switch (a1) {
						FolApp(f1, i1): if (length(i1) == 2 && f1 == "∪")
								[Pair(mk2("∪", mk2("×.", a0, i1[0]), mk2("×.", a0, i1[1])), "xpundi")]
							else if (length(i1) == 2 && f1 == "∩")
								[Pair(mk2("∩", mk2("×.", a0, i1[0]), mk2("×.", a0, i1[1])), "xpindi")]
							else [];
						default: [];
					}]) else [],
				// ∖ over ∪ / ∩ / ∖, and the ∪∖-absorption
				if (fn == "∖") concatA([
					switch (a0) {
						FolApp(f0, i0): if (length(i0) == 2 && f0 == "∪") concat(
								[Pair(mk2("∪", mk2("∖", i0[0], a1), mk2("∖", i0[1], a1)), "difundir")],
								if (mizEmitTKey(i0[1]) == mizEmitTKey(a1))
									[Pair(mk2("∖", i0[0], a1), "difun2")] else [])
							else if (length(i0) == 2 && f0 == "∩")
								[Pair(mk2("∩", mk2("∖", i0[0], a1), mk2("∖", i0[1], a1)), "difindir")]
							else [];
						default: [];
					},
					switch (a1) {
						FolApp(f1, i1): if (length(i1) == 2 && f1 == "∪")
								[Pair(mk2("∩", mk2("∖", a0, i1[0]), mk2("∖", a0, i1[1])), "difundi")]
							else if (length(i1) == 2 && f1 == "∩")
								[Pair(mk2("∪", mk2("∖", a0, i1[0]), mk2("∖", a0, i1[1])), "difindi")]
							else if (length(i1) == 2 && f1 == "∖")
								[Pair(mk2("∪", mk2("∖", a0, i1[0]), mk2("∩", a0, i1[1])), "difdif2")]
							else [];
						default: [];
					}]) else [],
				// ∩ / ∪ over each other
				if (fn == "∩") concatA([
					switch (a0) {
						FolApp(f0, i0): if (length(i0) == 2 && f0 == "∪")
							[Pair(mk2("∪", mk2("∩", i0[0], a1), mk2("∩", i0[1], a1)), "indir")]
							else [];
						default: [];
					},
					switch (a1) {
						FolApp(f1, i1): if (length(i1) == 2 && f1 == "∪")
							[Pair(mk2("∪", mk2("∩", a0, i1[0]), mk2("∩", a0, i1[1])), "indi")]
							else [];
						default: [];
					}]) else [],
				if (fn == "∪") concatA([
					switch (a0) {
						FolApp(f0, i0): if (length(i0) == 2 && f0 == "∩")
							[Pair(mk2("∩", mk2("∪", i0[0], a1), mk2("∪", i0[1], a1)), "undir")]
							else [];
						default: [];
					},
					switch (a1) {
						FolApp(f1, i1): if (length(i1) == 2 && f1 == "∩")
							[Pair(mk2("∩", mk2("∪", a0, i1[0]), mk2("∪", a0, i1[1])), "undi")]
							else [];
						default: [];
					}]) else [],
				// the ∅ and idempotence rows
				if (mizEmitTKey(a1) == mizEmitTKey(empty))
					(if (fn == "∖") [Pair(a0, "dif0")]
					else if (fn == "∪") [Pair(a0, "un0")]
					else if (fn == "∩") [Pair(empty, "in0")]
					else if (fn == "×.") [Pair(empty, "xp0")]
					else []) else [],
				if (fn == "×." && mizEmitTKey(a0) == mizEmitTKey(empty))
					[Pair(empty, "0xp")] else [],
				if (mizEmitTKey(a0) == mizEmitTKey(a1))
					(if (fn == "∩") [Pair(a0, "inidm")]
					else if (fn == "∪") [Pair(a0, "unidm")]
					else []) else []]);
		}
		default: [];
	}
}

// the candidate's equation payload with its (at most one) guard
mizEqcPayload(f : FolForm) -> Maybe<Pair<FolForm, Maybe<FolForm>>> {
	switch (f) {
		FolEq(__, __): Some(Pair(f, None()));
		FolBin(op, g, r): if (op != "imp") None() else switch (r) {
			FolEq(__, __): Some(Pair(r, Some(g)));
			default: None();
		}
		default: None();
	}
}

mizEqcAddTerm(uni : ref Tree<string, int>, terms : ref [FolTerm], t : FolTerm) -> int {
	k = mizEmitTKey(t);
	switch (lookupTree(^uni, k)) {
		Some(i): i;
		None(): {
			switch (t) {
				FolApp(__, args): iter(args, \a -> { mizEqcAddTerm(uni, terms, a); {} });
				default: {};
			}
			i = length(^terms);
			terms := arrayPush(^terms, t);
			uni := setTree(^uni, k, i);
			i;
		}
	}
}

mizEqcFind(uf : ref Tree<int, int>, i : int) -> int {
	p = lookupTreeDef(^uf, i, i);
	if (p == i) i else mizEqcFind(uf, p);
}

// congruence rounds to a fixpoint: same head, argument classes equal, every
// differing slot's congruence lemma available
mizEqcCongRounds(terms : [FolTerm], uni : Tree<string, int>,
	uf : ref Tree<int, int>, edges : ref [MizEqEdge], round : int) -> void {
	if (round <= 8) {
		buckets = foldi(terms, makeTree(), \i, acc, t -> switch (t) {
			FolApp(fn, args): {
				k = fn + "/" + i2s(length(args));
				setTree(acc, k, arrayPush(lookupTreeDef(acc, k, []), i));
			}
			default: acc;
		});
		added = foldTree(buckets, false, \__, is, acc0 -> fold(is, acc0, \acc1, i ->
			fold(is, acc1, \acc, j ->
				if (j <= i || mizEqcFind(uf, i) == mizEqcFind(uf, j)) acc
				else switch (terms[i]) {
					FolApp(fn, ai): switch (terms[j]) {
						FolApp(__, aj): {
							ok = foldi(ai, true, \s, o, a -> o && {
								if (a == aj[s]) true
								else if (mizEmitSlotCong(fn, s) == "") false
								else {
									ka = lookupTreeDef(uni, mizEmitTKey(a), -1);
									kb = lookupTreeDef(uni, mizEmitTKey(aj[s]), -1);
									ka >= 0 && kb >= 0 && mizEqcFind(uf, ka) == mizEqcFind(uf, kb);
								}
							});
							if (!ok) acc
							else {
								// the round is the edge COUNT at creation: the argument
								// classes were joined by edges already present, so the
								// extraction bound `index < mine` is exactly what holds
								// (a per-pass round let a cong edge depend on a
								// same-pass merge the extraction then refused)
								edges := arrayPush(^edges,
									MizEqEdge(i, j, length(^edges) + 1, 2, -1));
								uf := setTree(^uf, mizEqcFind(uf, i), mizEqcFind(uf, j));
								true;
							}
						}
						default: acc;
					}
					default: acc;
				})));
		if (added) mizEqcCongRounds(terms, uni, uf, edges, round + 1);
	}
}

mizEqcEmit(env : MizEqChainEnv, form : FolForm, lemma : string, refs : [FolPRef]) -> FolPRef {
	env.steps := arrayPush(^(env.steps), FolPStep(form, lemma, refs));
	FolPRefStep(length(^(env.steps)) - 1);
}

mizEqcMkD(env : MizEqChainEnv, f : FolForm) -> FolForm {
	switch (env.ph) { None(): f; Some(p): FolBin("imp", p, f); }
}

// the handle proving the candidate's own form: a context reference, or the
// derived block spliced once (local refs shifted exactly as the proof
// splices them)
mizEqcCandH(env : MizEqChainEnv, ci : int) -> FolPRef {
	switch (lookupTree(^(env.candH), ci)) {
		Some(h): h;
		None(): {
			c = env.cands[ci];
			h = if (c.fact >= 0) {
				env.frefs := arrayPush(^(env.frefs), env.ctx[c.fact].second);
				FolPRefFact(length(^(env.frefs)) - 1);
			} else {
				d = env.drvs[c.drv];
				base = length(^(env.steps));
				refBase = length(^(env.frefs));
				iter(d.steps, \cs -> {
					env.steps := arrayPush(^(env.steps), FolPStep(cs.form, cs.assertion,
						map(cs.refs, \rr -> switch (rr) {
							FolPRefStep(k): FolPRefStep(base + k);
							FolPRefFact(k): FolPRefFact(refBase + k);
						})));
				});
				env.frefs := concat(^(env.frefs), d.refs);
				env.djs := concat(^(env.djs), d.disjs);
				FolPRefStep(length(^(env.steps)) - 1);
			}
			env.candH := setTree(^(env.candH), ci, h);
			h;
		}
	}
}

// the simpld/simprd path to a CONJUNCT of a form (the assumption is often a
// conjunction — `(v1 X ∧ A ⊆ B) → goal` — and its conjuncts are the guards
// the candidates ask for)
mizEqcConjPath(f : FolForm, gk : string, ops : [string], depth : int) -> Maybe<[string]> {
	if (mizEmitKey(f) == gk) Some(ops)
	else if (depth <= 0) None()
	else switch (f) {
		FolBin(op, l, r): if (op != "and") None()
			else switch (mizEqcConjPath(l, gk, arrayPush(ops, "simpld"), depth - 1)) {
				Some(p): Some(p);
				None(): mizEqcConjPath(r, gk, arrayPush(ops, "simprd"), depth - 1);
			}
		default: None();
	}
}

mizEqcConjKeys(f : FolForm, depth : int) -> [string] {
	self = [mizEmitKey(f)];
	if (depth <= 0) self
	else switch (f) {
		FolBin(op, l, r): if (op != "and") self
			else concat(self, concat(mizEqcConjKeys(l, depth - 1),
				mizEqcConjKeys(r, depth - 1)));
		default: self;
	}
}

// discharge a guard: a step proving `ph → g` (deduction mode) / `g`
// (inference mode), through the candidate pool; in deduction mode a guard
// that is a CONJUNCT of the assumption is projected out (id + simpld/simprd)
// the ELEMENT BRIDGE as a guard rule: a goal `A ∈ 𝒫 t` or `A ⊆ t` is proved
// from an assumption conjunct `element A 𝒫 t` through the element
// definition's record instance `(𝒫 t = ∅) ∨ ((element A 𝒫 t) ↔ (A ∈ 𝒫 t))`
// (a pool candidate): pwne0 + neii refute the empty case, orel1 + ax-mp
// eliminate the disjunction, mpbid lands the membership under the
// assumption, and velpw adds the subset form (A a variable not occurring in
// t — velpw's disjointedness). This is the meaning Mizar's `Element of` type
// carries silently — the first type-layer fact the chains consume.
mizEqcElemBridge(env : MizEqChainEnv, g : FolForm, depth : int) -> Maybe<FolPRef> {
	if (isNone(env.ph)) None() else {
		empty0 = FolApp("∅", []);
		// (member, the power class's argument, goal-is-subset)
		req = switch (g) {
			FolPred(nmS, argsS):
				if (nmS == "⊆" && length(argsS) == 2) Some(Triple(argsS[0], argsS[1], true))
				else if (nmS == "∈" && length(argsS) == 2) switch (argsS[1]) {
					FolApp(fp, ap): if (fp == "𝒫" && length(ap) == 1)
						Some(Triple(argsS[0], ap[0], false)) else None();
					default: None();
				} else None();
			default: None();
		};
		switch (req) {
			None(): None();
			Some(t3): {
				aE = t3.first;
				tY = t3.second;
				yE = FolApp("𝒫", [tY]);
				cE = FolPred("element", [aE, yE]);
				memE = FolPred("∈", [aE, yE]);
				iffE = FolBin("iff", cE, memE);
				orE = FolBin("or", FolEq(yE, empty0), iffE);
				okVar = switch (aE) {
					FolVar(av): !t3.third || !mizEmitFreeIn(av, FolEq(tY, tY));
					default: false;
				};
				ci = foldi(env.cands, -1, \i, ac, c ->
					if (ac >= 0) ac else if (c.form == orE) i else -1);
				if (!okVar || ci < 0) None()
				else switch (mizEqcProveG(env, cE, depth - 1)) {
					None(): None();
					Some(hC): {
						d1h = mizEqcCandH(env, ci);
						ngS = mizEqcEmit(env, FolNeg(FolEq(yE, empty0)), "neii",
							[mizEqcEmit(env, FolPred("≠", [yE, empty0]), "pwne0", [])]);
						o2 = mizEqcEmit(env, FolBin("imp", orE, iffE), "ax-mp",
							[ngS, mizEqcEmit(env, FolBin("imp", FolNeg(FolEq(yE, empty0)),
								FolBin("imp", orE, iffE)), "orel1", [])]);
						iffS = mizEqcEmit(env, iffE, "ax-mp", [d1h, o2]);
						m1 = mizEqcEmit(env, mizEqcMkD(env, memE), "mpbid",
							[hC, mizEqcEmit(env, mizEqcMkD(env, iffE), "a1i", [iffS])]);
						if (!t3.third) Some(m1)
						else {
							ssE = mizEmitSs(aE, tY);
							v1 = mizEqcEmit(env, FolBin("iff", memE, ssE), "velpw", []);
							Some(mizEqcEmit(env, mizEqcMkD(env, ssE), "mpbid",
								[m1, mizEqcEmit(env, mizEqcMkD(env, FolBin("iff", memE, ssE)),
									"a1i", [v1])]));
						}
					}
				}
			}
		}
	}
}

mizEqcProveG(env : MizEqChainEnv, g : FolForm, depth : int) -> Maybe<FolPRef> {
	gk = mizEmitKey(g);
	switch (lookupTree(^(env.guardH), gk)) {
		Some(h): Some(h);
		None(): if (depth <= 0) None() else {
			conjR = switch (env.ph) {
				None(): None();
				Some(af): if (gk == env.phKey) None()
					else switch (mizEqcConjPath(af, gk, [], 2)) {
						None(): None();
						Some(ops): {
							h0 = mizEqcEmit(env, mizEqcMkD(env, af), "id", []);
							fin = fold(ops, Pair(af, h0), \st, op -> switch (st.first) {
								FolBin(__, l9, r9): {
									side = if (op == "simpld") l9 else r9;
									Pair(side, mizEqcEmit(env, mizEqcMkD(env, side), op,
										[st.second]));
								}
								default: st;
							});
							if (fin.first == g) Some(fin.second) else None();
						}
					}
			};
			r = if (isSome(conjR)) conjR
			else if (isSome(env.ph) && gk == env.phKey)
				Some(mizEqcEmit(env, mizEqcMkD(env, g), "id", []))
			else {
				direct = foldi(env.cands, None(), \ci, ac : Maybe<FolPRef>, c ->
					if (isSome(ac) || mizEmitKey(c.form) != gk) ac
					else {
						h = mizEqcCandH(env, ci);
						switch (env.ph) {
							None(): Some(h);
							Some(__): Some(mizEqcEmit(env, mizEqcMkD(env, g), "a1i", [h]));
						}
					});
				switch (direct) {
					Some(__): direct;
					None(): foldi(env.cands, None(), \ci, ac : Maybe<FolPRef>, c ->
						if (isSome(ac)) ac
						else switch (c.form) {
							FolBin(op, g2, g3): if (op != "imp" || mizEmitKey(g3) != gk) ac
								else if (isSome(env.ph) && mizEmitKey(g2) == env.phKey)
									Some(mizEqcCandH(env, ci))
								else switch (mizEqcProveG(env, g2, depth - 1)) {
									None(): ac;
									Some(hg): {
										hc = mizEqcCandH(env, ci);
										switch (env.ph) {
											None(): Some(mizEqcEmit(env, g, "ax-mp", [hg, hc]));
											Some(__): Some(mizEqcEmit(env, mizEqcMkD(env, g), "syl", [hg, hc]));
										}
									}
								}
							default: ac;
						});
				}
			}
			r2 = switch (r) {
				None(): mizEqcElemBridge(env, g, depth);
				Some(__): r;
			};
			switch (r2) {
				None(): None();
				Some(h): { env.guardH := setTree(^(env.guardH), gk, h); r2; }
			}
		}
	}
}

// a step proving mkD(T(from) = T(to)) across one edge
mizEqcEdgeStep(env : MizEqChainEnv, e : MizEqEdge, from : int) -> Maybe<FolPRef> {
	to = if (e.a == from) e.b else e.a;
	tf = env.terms[from];
	tt = env.terms[to];
	if (e.kind == 0) {
		c = env.cands[e.cand];
		switch (mizEqcPayload(c.form)) {
			None(): None();
			Some(pl): {
				eq = pl.first;
				natural = switch (eq) {
					FolEq(l, __): mizEmitTKey(l) == mizEmitTKey(tf);
					default: false;
				};
				base : Maybe<FolPRef> = switch (pl.second) {
					None(): switch (env.ph) {
						None(): Some(mizEqcCandH(env, e.cand));
						Some(__): Some(mizEqcEmit(env, mizEqcMkD(env, eq), "a1i",
							[mizEqcCandH(env, e.cand)]));
					}
					Some(g): if (isSome(env.ph) && mizEmitKey(g) == env.phKey)
						Some(mizEqcCandH(env, e.cand))
					else switch (mizEqcProveG(env, g, 6)) {
						None(): None();
						Some(hg): {
							hc = mizEqcCandH(env, e.cand);
							switch (env.ph) {
								None(): Some(mizEqcEmit(env, eq, "ax-mp", [hg, hc]));
								Some(__): Some(mizEqcEmit(env, mizEqcMkD(env, eq), "syl", [hg, hc]));
							}
						}
					}
				};
				switch (base) {
					None(): None();
					Some(h): if (natural) Some(h)
						else Some(mizEqcEmit(env, mizEqcMkD(env, FolEq(tf, tt)),
							if (isSome(env.ph)) "eqcomd" else "eqcomi", [h]));
				}
			}
		}
	} else if (e.kind == 1) {
		// commutativity holds in the requested direction directly
		h = mizEqcEmit(env, FolEq(tf, tt), switch (tf) {
			FolApp(fn, __): mizEqcCommLemma(fn);
			default: "";
		}, []);
		switch (env.ph) {
			None(): Some(h);
			Some(__): Some(mizEqcEmit(env, mizEqcMkD(env, FolEq(tf, tt)), "a1i", [h]));
		}
	} else if (e.kind == 4) {
		// a foundation rewrite (distribution/absorption): the lemma's left
		// side is whichever end matches, the other direction adds eqcomi
		natural = find(mizEqcRewriteTwins(tf), \pr ->
			mizEmitTKey(pr.first) == mizEmitTKey(tt));
		base : Maybe<FolPRef> = switch (natural) {
			Some(pr): Some(mizEqcEmit(env, FolEq(tf, tt), pr.second, []));
			None(): switch (find(mizEqcRewriteTwins(tt), \pr ->
					mizEmitTKey(pr.first) == mizEmitTKey(tf))) {
				None(): None();
				Some(pr): {
					h0 = mizEqcEmit(env, FolEq(tt, tf), pr.second, []);
					Some(mizEqcEmit(env, FolEq(tf, tt), "eqcomi", [h0]));
				}
			}
		};
		switch (base) {
			None(): None();
			Some(h): switch (env.ph) {
				None(): Some(h);
				Some(__): Some(mizEqcEmit(env, mizEqcMkD(env, FolEq(tf, tt)), "a1i", [h]));
			}
		}
	} else if (e.kind == 3) {
		// a piece-derived equation (inside a conjunction, under a guard):
		// discharged on demand, re-oriented by eqcomi/eqcomd when the path
		// runs it backwards. Only the subset chain's env carries these.
		switch (mizSscPieceH(env, env.pieces[e.cand])) {
			None(): None();
			Some(pp): switch (pp.first) {
				FolEq(l3, __): {
					if (mizEmitTKey(l3) == mizEmitTKey(tf)) Some(pp.second)
					else Some(mizEqcEmit(env, mizEqcMkD(env, FolEq(tf, tt)),
						if (isSome(env.ph)) "eqcomd" else "eqcomi", [pp.second]));
				}
				default: None();
			}
		}
	} else {
		// congruence: rewrite each differing slot in turn, chaining by eqtrd/eqtri
		switch (tf) {
			FolApp(fn, af): switch (tt) {
				FolApp(__, at_): {
					r = foldi(af, Some(Pair(tf, None())),
						\i, acc : Maybe<Pair<FolTerm, Maybe<FolPRef>>>, a -> switch (acc) {
						None(): None();
						Some(st): if (a == at_[i]) acc else {
							cur = st.first;
							curArgs = switch (cur) { FolApp(__, aa): aa; default: []; };
							ua = mizEqcTermIdx(env, a);
							ub = mizEqcTermIdx(env, at_[i]);
							if (ua < 0 || ub < 0 || length(curArgs) != length(af)) None()
							else switch (mizEqcProveEq(env, ua, ub, e.round)) {
								None(): None();
								Some(argH): {
									lem = mizEmitSlotCong(fn, i);
									nxt = FolApp(fn, replace(curArgs, i, at_[i]));
									cg = mizEqcEmit(env, FolBin("imp", FolEq(curArgs[i], at_[i]),
										FolEq(cur, nxt)), lem, []);
									stepH = switch (env.ph) {
										None(): mizEqcEmit(env, FolEq(cur, nxt), "ax-mp", [argH, cg]);
										Some(__): mizEqcEmit(env, mizEqcMkD(env, FolEq(cur, nxt)), "syl", [argH, cg]);
									};
									comb = switch (st.second) {
										None(): stepH;
										Some(prevH): mizEqcEmit(env, mizEqcMkD(env, FolEq(tf, nxt)),
											if (isSome(env.ph)) "eqtrd" else "eqtri", [prevH, stepH]);
									};
									Some(Pair(nxt, Some(comb)));
								}
							}
						}
					});
					switch (r) {
						None(): None();
						Some(fin): fin.second;
					}
				}
				default: None();
			}
			default: None();
		}
	}
}

mizEqcTermIdx(env : MizEqChainEnv, t : FolTerm) -> int {
	lookupTreeDef(env.uni, mizEmitTKey(t), -1);
}

// the ELEMENT BRIDGE as proof FACTS: for an assumption conjunct
// `element A 𝒫 t` whose element-definition or-instance is in the pool, two
// absolute implications the tableau can chain with the assumption —
// `(element A 𝒫 t) → (A ∈ 𝒫 t)` (biimpi off the eliminated disjunction) and
// `(element A 𝒫 t) → (A ⊆ t)` (sylbb through velpw). The chains get the same
// meaning through mizEqcElemBridge; this serves the MID-STEP goals that go to
// the flat proof, where no guard prover runs.
mizEmitElemBridgeDrvs(asm : Maybe<FolForm>, pool : [MizEmitDrv]) -> [MizEmitDrv] {
	c1 = \f2 : FolForm -> switch (f2) {
		FolBin(op2, l2, r2): if (op2 == "and") [l2, r2] else [f2];
		default: [f2];
	};
	conjs = switch (asm) {
		None(): [];
		Some(af): concatA(map(c1(af), c1));
	};
	empty0 = FolApp("∅", []);
	concatA(map(uniqBy(conjs, \a2, b2 -> a2 == b2), \f -> switch (f) {
		FolPred(nmE, argsE): if (nmE != "element" || length(argsE) != 2) [] else
			switch (argsE[1]) {
				FolApp(fp, ap): if (fp != "𝒫" || length(ap) != 1) [] else {
					aE = argsE[0];
					tY = ap[0];
					yE = argsE[1];
					memE = FolPred("∈", argsE);
					iffE = FolBin("iff", f, memE);
					orE = FolBin("or", FolEq(yE, empty0), iffE);
					switch (find(pool, \d -> d.form == orE && d.steps != [])) {
						None(): [];
						Some(dd): {
							n0 = length(dd.steps);   // dd's last step (n0-1) proves orE
							pre = [
								FolPStep(FolPred("≠", [yE, empty0]), "pwne0", []),
								FolPStep(FolNeg(FolEq(yE, empty0)), "neii", [FolPRefStep(n0)]),
								FolPStep(FolBin("imp", FolNeg(FolEq(yE, empty0)),
									FolBin("imp", orE, iffE)), "orel1", []),
								FolPStep(FolBin("imp", orE, iffE), "ax-mp",
									[FolPRefStep(n0 + 1), FolPRefStep(n0 + 2)]),
								FolPStep(iffE, "ax-mp",
									[FolPRefStep(n0 - 1), FolPRefStep(n0 + 3)])];
							d1 = MizEmitDrv(FolBin("imp", f, memE),
								concat3(dd.steps, pre, [FolPStep(FolBin("imp", f, memE),
									"biimpi", [FolPRefStep(n0 + 4)])]),
								dd.refs, dd.disjs);
							sub = switch (aE) {
								FolVar(av): if (mizEmitFreeIn(av, FolEq(tY, tY))) [] else {
									ssE = mizEmitSs(aE, tY);
									[MizEmitDrv(FolBin("imp", f, ssE),
										concat3(dd.steps, pre, [
											FolPStep(FolBin("iff", memE, ssE), "velpw", []),
											FolPStep(FolBin("imp", f, ssE), "sylbb",
												[FolPRefStep(n0 + 4), FolPRefStep(n0 + 5)])]),
										dd.refs, dd.disjs)];
								}
								default: [];
							};
							concat([d1], sub);
						}
					}
				}
				default: [];
			}
		default: [];
	}));
}

// the keys the ELEMENT BRIDGE (mizEqcElemBridge) can prove, added to the
// guard seed BEFORE the fixpoint: for an assumption conjunct
// `element A 𝒫 t` whose element-definition or-instance is in the pool, the
// membership `A ∈ 𝒫 t` and (variable member, velpw's disjointedness) the
// subset `A ⊆ t`. Mirrors the bridge's own precondition exactly — an
// admitted edge whose guard the bridge then cannot prove would abort the
// path extraction.
mizEqcElemSeedKeys(asm : Maybe<FolForm>, cands : [MizEqCand]) -> [string] {
	c1 = \f2 : FolForm -> switch (f2) {
		FolBin(op2, l2, r2): if (op2 == "and") [l2, r2] else [f2];
		default: [f2];
	};
	conjs = switch (asm) {
		None(): [];
		Some(af): concatA(map(c1(af), c1));
	};
	concatA(map(conjs, \f -> switch (f) {
		FolPred(nmE, argsE): if (nmE != "element" || length(argsE) != 2) [] else
			switch (argsE[1]) {
				FolApp(fp, ap): if (fp != "𝒫" || length(ap) != 1) [] else {
					memE = FolPred("∈", argsE);
					orE = FolBin("or", FolEq(argsE[1], FolApp("∅", [])),
						FolBin("iff", f, memE));
					if (!exists(cands, \c -> c.form == orE)) [] else
						concat([mizEmitKey(memE)], switch (argsE[0]) {
							FolVar(av): if (mizEmitFreeIn(av, FolEq(ap[0], ap[0]))) []
								else [mizEmitKey(FolPred("⊆", [argsE[0], ap[0]]))];
							default: [];
						});
				}
				default: [];
			}
		default: [];
	}));
}

mizEqcGuardFix(cands : [MizEqCand], s : Set<string>) -> Set<string> {
	s2 = fold(cands, s, \ac, c -> switch (c.form) {
		FolBin(op, g, f): if (op != "imp") ac
			else if (containsSet(ac, mizEmitKey(g))) insertSet(ac, mizEmitKey(f))
			else ac;
		default: ac;
	});
	if (sizeSet(s2) == sizeSet(s)) s else mizEqcGuardFix(cands, s2);
}

// BFS over edges of round < maxR; returns the path as (edge index, from-term)
mizEqcPath(env : MizEqChainEnv, u : int, v : int, maxR : int) -> Maybe<[Pair<int, int>]> {
	bfs = \queue0 : [int], visited0 : Tree<int, Pair<int, int>> -> {
		// tail-recursive worklist via fold-until: implemented with a bounded loop
		state : ref Pair<[int], Tree<int, Pair<int, int>>> = ref Pair(queue0, visited0);
		found : ref bool = ref (u == v);
		iter(enumFromTo(0, length(env.terms) * 4), \__ -> {
			q = ^state;
			if (!^found && q.first != []) {
				cur = q.first[0];
				rest = tail(q.first);
				nq = fold(lookupTreeDef(env.adj, cur, []), Pair(rest, q.second),
					\acc : Pair<[int], Tree<int, Pair<int, int>>>, ei -> {
					e = env.edges[ei];
					if (e.round >= maxR) acc else {
						nxt = if (e.a == cur) e.b else e.a;
						if (containsKeyTree(acc.second, nxt) || nxt == u) acc
						else {
							if (nxt == v) found := true;
							Pair(arrayPush(acc.first, nxt), setTree(acc.second, nxt, Pair(cur, ei)));
						}
					}
				});
				state := nq;
			}
		});
		if (!^found) None() else Some((^state).second);
	};
	if (u == v) Some([])
	else switch (bfs([u], makeTree())) {
		None(): None();
		Some(vis): {
			// reconstruct backwards from v
			path : ref [Pair<int, int>] = ref [];
			cur : ref int = ref v;
			ok : ref bool = ref true;
			iter(enumFromTo(0, length(env.terms)), \__ -> {
				if (^ok && ^cur != u) {
					switch (lookupTree(vis, ^cur)) {
						None(): ok := false;
						Some(pv): {
							path := arrayPush(^path, Pair(pv.second, pv.first));
							cur := pv.first;
						}
					}
				}
			});
			if (!^ok) None() else Some(reverseA(^path));
		}
	}
}

// the memoized proof of mkD(T(u) = T(v)); cong edges recurse with their round
// as the new bound
mizEqcProveEq(env : MizEqChainEnv, u : int, v : int, maxR : int) -> Maybe<FolPRef> {
	mk = i2s(u) + ":" + i2s(v);
	switch (lookupTree(^(env.eqH), mk)) {
		Some(h): Some(h);
		None(): {
			r = if (u == v)
				Some(switch (env.ph) {
					None(): mizEqcEmit(env, FolEq(env.terms[u], env.terms[u]), "eqid", []);
					Some(__): mizEqcEmit(env, mizEqcMkD(env,
						FolEq(env.terms[u], env.terms[u])), "eqidd", []);
				})
			else switch (mizEqcPath(env, u, v, maxR)) {
				None(): None();
				Some(path): {
					// a FAILED edge must abort the whole chain: re-seeding on the
					// next success silently drops the unproven prefix (the
					// t6_enumset1 disproof — the verifier caught exactly that)
					r2 = fold(path, Some(None()),
						\acc : Maybe<Maybe<FolPRef>>, pe -> switch (acc) {
						None(): None();
						Some(prev): {
							e = env.edges[pe.first];
							from = pe.second;
							to = if (e.a == from) e.b else e.a;
							switch (mizEqcEdgeStep(env, e, from)) {
								None(): None();
								Some(h1): switch (prev) {
									None(): Some(Some(h1));
									Some(h0): Some(Some(mizEqcEmit(env,
										mizEqcMkD(env, FolEq(env.terms[u], env.terms[to])),
										if (isSome(env.ph)) "eqtrd" else "eqtri", [h0, h1])));
								}
							}
						}
					});
					switch (r2) { None(): None(); Some(mh): mh; }
				}
			}
			switch (r) {
				None(): None();
				Some(h): { env.eqH := setTree(^(env.eqH), mk, h); r; }
			}
		}
	}
}

mizEmitEqChain(ctx : [Pair<FolForm, RuParseRef>], goal : FolForm,
	asm : Maybe<FolForm>, drvs : [MizEmitDrv]) -> Maybe<FolStepProof> {
	switch (goal) {
		FolEq(gl, gr): if (gl == gr) None() else {
			phKey = switch (asm) { None(): ""; Some(af): mizEmitKey(af); };
			cands = concat(
				mapi(ctx, \j, p -> MizEqCand(p.first, -1, j)),
				mapi(drvs, \j, d -> MizEqCand(d.form, j, -1)));
			// forms reachable as guards: the assumption AND ITS CONJUNCTS,
			// every candidate form, and the closure over singly-guarded
			// candidate implications
			seedA = switch (asm) {
				None(): makeSet();
				Some(af): buildSet(mizEqcConjKeys(af, 2));
			};
			seed0 = fold(cands, seedA, \ac, c -> insertSet(ac, mizEmitKey(c.form)));
			seedE = fold(mizEqcElemSeedKeys(asm, cands), seed0, insertSet);
			provable = mizEqcGuardFix(cands, seedE);
			// edges from candidate payloads whose guard is dischargeable
			payloads = filtermap(mapi(cands, \ci, c -> Pair(ci, mizEqcPayload(c.form))),
				\pr -> switch (pr.second) {
					None(): None();
					Some(pl): switch (pl.second) {
						None(): Some(Pair(pr.first, pl.first));
						Some(g): if (containsSet(provable, mizEmitKey(g)))
							Some(Pair(pr.first, pl.first)) else None();
					}
				});
			if (payloads == []) None() else {
				uni : ref Tree<string, int> = ref makeTree();
				terms0 : ref [FolTerm] = ref [];
				gi = mizEqcAddTerm(uni, terms0, gl);
				gj = mizEqcAddTerm(uni, terms0, gr);
				peIdx = map(payloads, \pl -> switch (pl.second) {
					FolEq(l, r): Pair(mizEqcAddTerm(uni, terms0, l), mizEqcAddTerm(uni, terms0, r));
					default: Pair(-1, -1);
				});
				// commutative twins join the universe: the equalizer bakes ∪/∩
				// commutativity into its classes with no log entry
				twins = foldi(^terms0, [], \i, ac, t -> switch (t) {
					FolApp(fn, args): if (length(args) == 2 && mizEqcCommLemma(fn) != "")
						arrayPush(ac, Pair(i, FolApp(fn, [args[1], args[0]])))
						else ac;
					default: ac;
				});
				commEdges = fold(twins, [], \ac, tw ->
					arrayPush(ac, Pair(tw.first, mizEqcAddTerm(uni, terms0, tw.second))));
				// the foundation rewrite twins (after comm, so commuted forms
				// rewrite too; one level, like comm)
				rwTwins = foldi(^terms0, [], \i, ac, t ->
					fold(mizEqcRewriteTwins(t), ac, \a2, pr -> arrayPush(a2, Pair(i, pr.first))));
				rwEdges = fold(rwTwins, [], \ac, tw ->
					arrayPush(ac, Pair(tw.first, mizEqcAddTerm(uni, terms0, tw.second))));
				terms = ^terms0;
				uf : ref Tree<int, int> = ref makeTree();
				edges : ref [MizEqEdge] = ref [];
				iteri(peIdx, \k, pr -> if (pr.first >= 0) {
					edges := arrayPush(^edges, MizEqEdge(pr.first, pr.second, 0, 0,
						payloads[k].first));
					uf := setTree(^uf, mizEqcFind(uf, pr.first), mizEqcFind(uf, pr.second));
				});
				iter(commEdges, \pr -> if (pr.first != pr.second) {
					edges := arrayPush(^edges, MizEqEdge(pr.first, pr.second, 0, 1, -1));
					uf := setTree(^uf, mizEqcFind(uf, pr.first), mizEqcFind(uf, pr.second));
				});
				iter(rwEdges, \pr -> if (pr.first != pr.second) {
					edges := arrayPush(^edges, MizEqEdge(pr.first, pr.second, 0, 4, -1));
					uf := setTree(^uf, mizEqcFind(uf, pr.first), mizEqcFind(uf, pr.second));
				});
				mizEqcCongRounds(terms, ^uni, uf, edges, 1);
				if (mizEqcFind(uf, gi) != mizEqcFind(uf, gj)) {
					if (^mizEmitDbg) {
						println("  EQCHAIN no-join terms=" + i2s(length(terms))
							+ " edges=" + i2s(length(^edges)));
						iter(^edges, \e9 -> println("    E" + i2s(e9.kind)
							+ " " + strGlue(folFormToks(FolEq(terms[e9.a], terms[e9.b])), " ")));
						iter(payloads, \pl9 -> println("    P "
							+ strGlue(folFormToks(pl9.second), " ")));
					}
					None();
				} else {
					adj = foldi(^edges, makeTree(), \ei, ac, e ->
						setTree(setTree(ac, e.a, arrayPush(lookupTreeDef(ac, e.a, []), ei)),
							e.b, arrayPush(lookupTreeDef(ac, e.b, []), ei)));
					env = MizEqChainEnv(asm, phKey, cands, drvs, ctx, provable,
						^uni, terms, ^edges, adj,
						ref [], ref [], ref [], ref makeTree(), ref makeTree(), ref makeTree(), []);
					switch (mizEqcProveEq(env, gi, gj, 1000000000)) {
						None(): {
							if (^mizEmitDbg) println("  EQCHAIN extract-fail");
							None();
						}
						Some(h): {
							// the ladder contract: the LAST step proves the conclusion
							lastOk = switch (h) {
								FolPRefStep(k): k == length(^(env.steps)) - 1;
								FolPRefFact(__): false;
							};
							if (!lastOk) None()
							else {
								if (^mizEmitDbg) {
									println("  EQCHAIN ok steps=" + i2s(length(^(env.steps))));
									iteri(^(env.steps), \si9, s9 ->
										println("    S" + i2s(si9) + " " + s9.assertion + " ["
											+ strGlue(map(s9.refs, \r9 -> switch (r9) {
												FolPRefStep(k9): "s" + i2s(k9);
												FolPRefFact(k9): "f" + i2s(k9);
											}), ",") + "] "
											+ strGlue(folFormToks(s9.form), " ")));
								}
								Some(FolStepProof(^(env.steps), ^(env.frefs), uniq(^(env.djs))));
							}
						}
					}
				}
			}
		}
		default: None();
	}
}

// ---- THE SUBSET CLOSURE: ⊆ and = goals as citation chains ----
// relat_1's three heaviest proofs (t8/t68/t94, 89% of the article's
// emitted mass) refute a ~15-fact residue whose mathematical content is a
// small ⊆-chain: `X ⊆ proj1 X ×. proj2 X`, monotonicity of ×., intersection
// absorption. The flat proof restates the branch context in every
// lift step; the chain CITES the foundation instead: composition by
// sstri/sseqtri/eqsstri over a directed graph whose edges are the candidate
// pool's ⊆ atoms (through conjunction pieces and one guard), the structural
// inclusions (inss1/inss2/difss/ssun1/ssun2), and the equation closure the
// eq-chain already maintains (an eq edge bridges two ⊆ hops). Introduction
// on the compound side is ssin (∩ on the right) / unss (∪ on the left), and
// an equation goal is antisymmetry (eqssi) of two chains. Plain mode only —
// under an assumption the chain declines (the deduction twins are mechanical
// but unpaid until a trace asks for them).

// one directed ⊆ edge over the term universe: kind 0 = a candidate atom
// (atom = its index), kind 1 = a structural inclusion cited directly
MizSsEdge(a : int, b : int, kind : int, atom : int, lemma : string);
MizSsAtom(from : FolTerm, to : FolTerm, piece : MizSsPiece);
MizSsEnv(eq : MizEqChainEnv,
	atoms : [MizSsAtom],
	edges : [MizSsEdge],
	adj : Tree<int, [int]>,          // edge indices by CLASS root of the source
	classOf : Tree<int, int>,        // term index -> union-find root
	members : Tree<int, [int]>,      // class root -> term indices
	atomH : ref Tree<int, FolPRef>,
	ssH : ref Tree<string, FolPRef>,
	busy : ref Set<string>);

// the ⊆ / piece-eq atoms reachable inside one candidate form: through at most
// one top-level guard (must be dischargeable) and a simpl/simpr piece path.
// A bare or top-guarded equation is NOT collected — the payload reader
// already turns those into edges; only equations under a piece path are new.
mizSscWalk(f : FolForm, guard : Maybe<FolForm>, ops : [string], depth : int,
	provable : Set<string>) -> [Triple<FolForm, Maybe<FolForm>, [string]>] {
	switch (f) {
		FolPred(n, args): if (n == "⊆" && length(args) == 2)
			[Triple(f, guard, ops)] else [];
		FolEq(__, __): if (ops == []) [] else [Triple(f, guard, ops)];
		FolBin(op, l, r):
			if (op == "and" && depth > 0)
				concat(mizSscWalk(l, guard, arrayPush(ops, "simpl"), depth - 1, provable),
					mizSscWalk(r, guard, arrayPush(ops, "simpr"), depth - 1, provable))
			// guards may STACK: a rule-form record fact keeps two antecedents
			// under an assumption (`proj2⊆ → (proj1⊆ → ∪⊆)`); each peeled
			// antecedent must be provable, and the discharge loop in
			// mizSscPieceH re-derives the same path from the candidate's form
			else if (op == "imp" && ops == []
					&& containsSet(provable, mizEmitKey(l)))
				mizSscWalk(r, Some(l), ops, depth, provable)
			else [];
		default: [];
	}
}

// discharge a piece: the candidate's own handle (the ASSUMPTION itself when
// cand < 0), the guard through the pool, then the simpl/simpr path — returns
// the reached PLAIN form and the step proving it (mkD-wrapped in deduction
// mode: the handle proves `ph → form` and the path steps are the d-twins)
mizSscPieceH(env : MizEqChainEnv, p : MizSsPiece) -> Maybe<Pair<FolForm, FolPRef>> {
	base : Maybe<Pair<FolForm, FolPRef>> = if (p.cand < 0) {
		// the assumption as a piece source (deduction mode only)
		switch (env.ph) {
			None(): None();
			Some(af): Some(Pair(af, mizEqcEmit(env, mizEqcMkD(env, af), "id", [])));
		}
	} else {
		c = env.cands[p.cand];
		switch (p.guard) {
			None(): switch (env.ph) {
				None(): Some(Pair(c.form, mizEqcCandH(env, p.cand)));
				Some(__): Some(Pair(c.form, mizEqcEmit(env, mizEqcMkD(env, c.form),
					"a1i", [mizEqcCandH(env, p.cand)])));
			}
			Some(__): {
				// A candidate may carry SEVERAL leading guards — a rule-form
				// record fact keeps two under an assumption. Discharge each
				// leading antecedent in turn: the first from the plain
				// candidate handle (syl / ax-mp), later ones from the wrapped
				// result (mpd / ax-mp); a guard that IS the assumption needs
				// no proof — the candidate is already the wrapped form. The
				// target atoms (⊆ / =) are never implications, so peeling
				// stops exactly where the walk stopped.
				pr9 = fold(enumFromTo(0, 2),
					Some(Triple(c.form, mizEqcCandH(env, p.cand), true)),
					\st : Maybe<Triple<FolForm, FolPRef, bool>>, __ -> switch (st) {
						None(): None();
						Some(s3): switch (s3.first) {
							FolBin(op9, g9, r9): if (op9 != "imp") st else {
								if (isSome(env.ph) && s3.third
										&& mizEmitKey(g9) == env.phKey)
									Some(Triple(r9, s3.second, false))
								else switch (mizEqcProveG(env, g9, 6)) {
									None(): None();
									Some(hg): switch (env.ph) {
										None(): Some(Triple(r9,
											mizEqcEmit(env, r9, "ax-mp", [hg, s3.second]),
											false));
										Some(__): Some(Triple(r9,
											mizEqcEmit(env, mizEqcMkD(env, r9),
												if (s3.third) "syl" else "mpd",
												[hg, s3.second]),
											false));
									}
								}
							}
							default: st;
						}
					});
				switch (pr9) {
					None(): None();
					Some(s9): Some(Pair(s9.first, s9.second));
				}
			}
		}
	};
	fold(p.ops, base, \acc : Maybe<Pair<FolForm, FolPRef>>, op ->
		switch (acc) {
			None(): None();
			Some(st): switch (st.first) {
				FolBin(bop, l, r): if (bop != "and") None()
					else {
						side = if (op == "simpl") l else r;
						switch (env.ph) {
							None(): {
								im = mizEqcEmit(env, FolBin("imp", st.first, side), op, []);
								Some(Pair(side, mizEqcEmit(env, side, "ax-mp", [st.second, im])));
							}
							Some(__): Some(Pair(side, mizEqcEmit(env, mizEqcMkD(env, side),
								op + "d", [st.second])));
						}
					}
				default: None();
			}
		});
}

mizSscSsF(env : MizEqChainEnv, a : int, b : int) -> FolForm {
	FolPred("⊆", [env.terms[a], env.terms[b]]);
}

mizSscCls(senv : MizSsEnv, i : int) -> int {
	lookupTreeDef(senv.classOf, i, i);
}

// a step proving |- T(e.a) ⊆ T(e.b) (mkD-wrapped in deduction mode) for one edge
mizSscEdgeH(senv : MizSsEnv, e : MizSsEdge) -> Maybe<FolPRef> {
	env = senv.eq;
	if (e.kind == 1) {
		h0 = mizEqcEmit(env, mizSscSsF(env, e.a, e.b), e.lemma, []);
		switch (env.ph) {
			None(): Some(h0);
			Some(__): Some(mizEqcEmit(env, mizEqcMkD(env, mizSscSsF(env, e.a, e.b)),
				"a1i", [h0]));
		}
	}
	else switch (lookupTree(^(senv.atomH), e.atom)) {
		Some(h): Some(h);
		None(): switch (mizSscPieceH(env, senv.atoms[e.atom].piece)) {
			None(): None();
			Some(pr): {
				senv.atomH := setTree(^(senv.atomH), e.atom, pr.second);
				Some(pr.second);
			}
		}
	}
}

// BFS over the class graph; returns the edge-index path in order
mizSscPath(senv : MizSsEnv, cu : int, cv : int) -> Maybe<[int]> {
	state : ref Pair<[int], Tree<int, Pair<int, int>>> = ref Pair([cu], makeTree());
	found : ref bool = ref false;
	iter(enumFromTo(0, length(senv.eq.terms) * 4), \__ -> {
		q = ^state;
		if (!^found && q.first != []) {
			cur = q.first[0];
			rest = tail(q.first);
			nq = fold(lookupTreeDef(senv.adj, cur, []), Pair(rest, q.second),
				\acc : Pair<[int], Tree<int, Pair<int, int>>>, ei -> {
				e = senv.edges[ei];
				nxt = mizSscCls(senv, e.b);
				if (containsKeyTree(acc.second, nxt) || nxt == cu) acc
				else {
					if (nxt == cv) found := true;
					Pair(arrayPush(acc.first, nxt), setTree(acc.second, nxt, Pair(cur, ei)));
				}
			});
			state := nq;
		}
	});
	if (!^found) None() else {
		path : ref [int] = ref [];
		cur : ref int = ref cv;
		ok : ref bool = ref true;
		iter(enumFromTo(0, length(senv.eq.terms)), \__ -> {
			if (^ok && ^cur != cu) {
				switch (lookupTree((^state).second, ^cur)) {
					None(): ok := false;
					Some(pv): {
						path := arrayPush(^path, pv.second);
						cur := pv.first;
					}
				}
			}
		});
		if (!^ok) None() else Some(reverseA(^path));
	}
}

// fold the path into one chain `T(u) ⊆ T(v)`: eq bridges by sseqtri/eqsstri
// (their d-twins under an assumption), composition by sstri/sstrd; a failed
// edge or bridge ABORTS (the eq-chain's law)
mizSscExtract(senv : MizSsEnv, u : int, v : int, path : [int]) -> Maybe<FolPRef> {
	env = senv.eq;
	big = 1000000000;
	d = isSome(env.ph);
	emitD = \f : FolForm, lem : string, refs : [FolPRef] ->
		mizEqcEmit(env, mizEqcMkD(env, f), if (d) lem + "d" else lem + "i", refs);
	fin = fold(path, Some(Pair(None(), u)),
		\acc : Maybe<Pair<Maybe<FolPRef>, int>>, ei -> switch (acc) {
		None(): None();
		Some(st): {
			e = senv.edges[ei];
			switch (mizSscEdgeH(senv, e)) {
				None(): None();
				Some(hE): {
					cur = st.second;
					switch (st.first) {
						None():
							if (cur == e.a) Some(Pair(Some(hE), e.b))
							else switch (mizEqcProveEq(env, cur, e.a, big)) {
								None(): None();
								Some(he): Some(Pair(Some(emitD(
									mizSscSsF(env, cur, e.b), "eqsstr", [he, hE])), e.b));
							}
						Some(h0): {
							h1 = if (cur == e.a) Some(h0)
								else switch (mizEqcProveEq(env, cur, e.a, big)) {
									None(): None();
									Some(he): Some(emitD(
										mizSscSsF(env, u, e.a), "sseqtr", [h0, he]));
								};
							switch (h1) {
								None(): None();
								Some(h2): Some(Pair(Some(emitD(
									mizSscSsF(env, u, e.b), "sstr", [h2, hE])), e.b));
							}
						}
					}
				}
			}
		}
	});
	switch (fin) {
		None(): None();
		Some(st): {
			cur = st.second;
			switch (st.first) {
				None(): None();
				Some(h0): if (cur == v) Some(h0)
					else switch (mizEqcProveEq(env, cur, v, big)) {
						None(): None();
						Some(he): Some(emitD(mizSscSsF(env, u, v), "sseqtr", [h0, he]));
					}
			}
		}
	}
}

// introduction on the compound side: `u ⊆ (A ∩ B)` from both conjunct chains
// (ssin), `(A ∪ B) ⊆ v` from both disjunct chains (unss); the compound may
// sit anywhere in the endpoint's eq class, bridged back by sseqtri/eqsstri
mizSscIntro(senv : MizSsEnv, u : int, v : int, depth : int) -> Maybe<FolPRef> {
	env = senv.eq;
	big = 1000000000;
	d = isSome(env.ph);
	emitD = \f : FolForm, lem : string, refs : [FolPRef] ->
		mizEqcEmit(env, mizEqcMkD(env, f), if (d) lem + "d" else lem + "i", refs);
	// the conjunction of the two chains: pm3.2i, or jca under the assumption;
	// the ssin/unss instance stays PLAIN and joins by sylib in deduction mode
	conj2 = \fa : FolForm, fb : FolForm, ha : FolPRef, hb : FolPRef, fm : FolForm, lem : string -> {
		cj = mizEqcEmit(env, mizEqcMkD(env, FolBin("and", fa, fb)),
			if (d) "jca" else "pm3.2i", [ha, hb]);
		bi = mizEqcEmit(env, FolBin("iff", FolBin("and", fa, fb), fm), lem, []);
		mizEqcEmit(env, mizEqcMkD(env, fm), if (d) "sylib" else "mpbi", [cj, bi]);
	};
	tIdx = \t : FolTerm -> lookupTreeDef(env.uni, mizEmitTKey(t), -1);
	mvs0 = lookupTreeDef(senv.members, mizSscCls(senv, v), []);
	mvs = if (length(mvs0) > 8) subrange(mvs0, 0, 8) else mvs0;
	viaIn = fold(mvs, None(), \acc : Maybe<FolPRef>, m -> switch (acc) {
		Some(__): acc;
		None(): switch (env.terms[m]) {
			FolApp(fn, args): if (fn != "∩" || length(args) != 2) None() else {
				ia = tIdx(args[0]);
				ib = tIdx(args[1]);
				if (ia < 0 || ib < 0) None()
				else switch (mizSscProve(senv, u, ia, depth - 1)) {
					None(): None();
					Some(ha): switch (mizSscProve(senv, u, ib, depth - 1)) {
						None(): None();
						Some(hb): {
							hm = conj2(mizSscSsF(env, u, ia), mizSscSsF(env, u, ib),
								ha, hb, mizSscSsF(env, u, m), "ssin");
							if (m == v) Some(hm)
							else switch (mizEqcProveEq(env, m, v, big)) {
								None(): None();
								Some(he): Some(emitD(mizSscSsF(env, u, v), "sseqtr", [hm, he]));
							}
						}
					}
				}
			}
			default: None();
		}
	});
	switch (viaIn) {
		Some(__): viaIn;
		None(): {
			mus0 = lookupTreeDef(senv.members, mizSscCls(senv, u), []);
			mus = if (length(mus0) > 8) subrange(mus0, 0, 8) else mus0;
			fold(mus, None(), \acc : Maybe<FolPRef>, m -> switch (acc) {
				Some(__): acc;
				None(): switch (env.terms[m]) {
					FolApp(fn, args): if (fn != "∪" || length(args) != 2) None() else {
						ia = tIdx(args[0]);
						ib = tIdx(args[1]);
						if (ia < 0 || ib < 0) None()
						else switch (mizSscProve(senv, ia, v, depth - 1)) {
							None(): None();
							Some(ha): switch (mizSscProve(senv, ib, v, depth - 1)) {
								None(): None();
								Some(hb): {
									hm = conj2(mizSscSsF(env, ia, v), mizSscSsF(env, ib, v),
										ha, hb, mizSscSsF(env, m, v), "unss");
									if (m == u) Some(hm)
									else switch (mizEqcProveEq(env, u, m, big)) {
										None(): None();
										Some(he): Some(emitD(mizSscSsF(env, u, v), "eqsstr", [he, hm]));
									}
								}
							}
						}
					}
					default: None();
				}
			});
		}
	}
}

// the memoized chain `T(u) ⊆ T(v)`: same class = ssid (+ eq bridge), else a
// BFS path over the class graph, else introduction on the compound side
mizSscProve(senv : MizSsEnv, u : int, v : int, depth : int) -> Maybe<FolPRef> {
	env = senv.eq;
	big = 1000000000;
	key = i2s(u) + ":" + i2s(v);
	switch (lookupTree(^(senv.ssH), key)) {
		Some(h): Some(h);
		None(): if (depth <= 0 || containsSet(^(senv.busy), key)) None() else {
			senv.busy := insertSet(^(senv.busy), key);
			d = isSome(env.ph);
			mkId = \ -> {
				h9 = mizEqcEmit(env, mizSscSsF(env, u, u), "ssid", []);
				if (!d) h9
				else mizEqcEmit(env, mizEqcMkD(env, mizSscSsF(env, u, u)), "a1i", [h9]);
			};
			r = if (mizSscCls(senv, u) == mizSscCls(senv, v)) {
				if (u == v) Some(mkId())
				else switch (mizEqcProveEq(env, u, v, big)) {
					None(): None();
					Some(he): {
						h0 = mkId();
						Some(mizEqcEmit(env, mizEqcMkD(env, mizSscSsF(env, u, v)),
							if (d) "sseqtrd" else "sseqtri", [h0, he]));
					}
				}
			} else {
				viaPath = switch (mizSscPath(senv, mizSscCls(senv, u), mizSscCls(senv, v))) {
					None(): None();
					Some(path): mizSscExtract(senv, u, v, path);
				};
				switch (viaPath) {
					Some(__): viaPath;
					None(): mizSscIntro(senv, u, v, depth);
				}
			};
			senv.busy := removeSet(^(senv.busy), key);
			switch (r) {
				None(): None();
				Some(h): { senv.ssH := setTree(^(senv.ssH), key, h); r; }
			}
		}
	}
}

mizEmitSsChain(ctx : [Pair<FolForm, RuParseRef>], goal : FolForm,
	asm : Maybe<FolForm>, drvs : [MizEmitDrv]) -> Maybe<FolStepProof> {
	gp : Maybe<Triple<FolTerm, FolTerm, bool>> = switch (goal) {
		FolEq(gl, gr): Some(Triple(gl, gr, true));
		FolPred(gn, ga): if (gn == "⊆" && length(ga) == 2)
			Some(Triple(ga[0], ga[1], false)) else None();
		default: None();
	};
	switch (gp) {
		None(): None();
		Some(g3): if (g3.first == g3.second) None() else {
			phKey = switch (asm) { None(): ""; Some(af): mizEmitKey(af); };
			cands = concat(
				mapi(ctx, \j, p -> MizEqCand(p.first, -1, j)),
				mapi(drvs, \j, d -> MizEqCand(d.form, j, -1)));
			seedA = switch (asm) {
				None(): makeSet();
				Some(af): buildSet(mizEqcConjKeys(af, 2));
			};
			seed0 = fold(cands, seedA, \ac, c -> insertSet(ac, mizEmitKey(c.form)));
			seedE = fold(mizEqcElemSeedKeys(asm, cands), seed0, insertSet);
			provable = mizEqcGuardFix(cands, seedE);
			// equation payloads exactly as the eq-chain reads them
			payloads = filtermap(mapi(cands, \ci, c -> Pair(ci, mizEqcPayload(c.form))),
				\pr -> switch (pr.second) {
					None(): None();
					Some(pl): switch (pl.second) {
						None(): Some(Pair(pr.first, pl.first));
						Some(g): if (containsSet(provable, mizEmitKey(g)))
							Some(Pair(pr.first, pl.first)) else None();
					}
				});
			// the pieces: ⊆ atoms and buried equations — from the candidates,
			// and from the ASSUMPTION's own conjuncts (pseudo-candidate -1)
			walked = concat(
				concatA(mapi(cands, \ci, c ->
					map(mizSscWalk(c.form, None(), [], 2, provable),
						\t3 -> Pair(ci, t3)))),
				switch (asm) {
					None(): [];
					Some(af): map(mizSscWalk(af, None(), [], 2, provable),
						\t3 -> Pair(-1, t3));
				});
			ssAtoms = filtermap(walked, \w -> switch (w.second.first) {
				FolPred(__, aa): Some(MizSsAtom(aa[0], aa[1],
					MizSsPiece(w.first, w.second.second, w.second.third)));
				default: None();
			});
			eqPieces = filtermap(walked, \w -> switch (w.second.first) {
				FolEq(el, er): Some(Triple(el, er,
					MizSsPiece(w.first, w.second.second, w.second.third)));
				default: None();
			});
			if (payloads == [] && ssAtoms == [] && eqPieces == []) None()
			else {
				uni : ref Tree<string, int> = ref makeTree();
				terms0 : ref [FolTerm] = ref [];
				gi = mizEqcAddTerm(uni, terms0, g3.first);
				gj = mizEqcAddTerm(uni, terms0, g3.second);
				peIdx = map(payloads, \pl -> switch (pl.second) {
					FolEq(l, r): Pair(mizEqcAddTerm(uni, terms0, l),
						mizEqcAddTerm(uni, terms0, r));
					default: Pair(-1, -1);
				});
				epIdx = map(eqPieces, \ep -> Pair(mizEqcAddTerm(uni, terms0, ep.first),
					mizEqcAddTerm(uni, terms0, ep.second)));
				ssIdx = map(ssAtoms, \a -> Pair(mizEqcAddTerm(uni, terms0, a.from),
					mizEqcAddTerm(uni, terms0, a.to)));
				twins = foldi(^terms0, [], \i, ac, t -> switch (t) {
					FolApp(fn, args): if (length(args) == 2 && mizEqcCommLemma(fn) != "")
						arrayPush(ac, Pair(i, FolApp(fn, [args[1], args[0]])))
						else ac;
					default: ac;
				});
				commEdges = fold(twins, [], \ac, tw ->
					arrayPush(ac, Pair(tw.first, mizEqcAddTerm(uni, terms0, tw.second))));
				// the foundation rewrite twins (after comm, so commuted forms
				// rewrite too; one level, like comm)
				rwTwins = foldi(^terms0, [], \i, ac, t ->
					fold(mizEqcRewriteTwins(t), ac, \a2, pr -> arrayPush(a2, Pair(i, pr.first))));
				rwEdges = fold(rwTwins, [], \ac, tw ->
					arrayPush(ac, Pair(tw.first, mizEqcAddTerm(uni, terms0, tw.second))));
				terms = ^terms0;
				uf : ref Tree<int, int> = ref makeTree();
				edges : ref [MizEqEdge] = ref [];
				iteri(peIdx, \k, pr -> if (pr.first >= 0) {
					edges := arrayPush(^edges, MizEqEdge(pr.first, pr.second, 0, 0,
						payloads[k].first));
					uf := setTree(^uf, mizEqcFind(uf, pr.first), mizEqcFind(uf, pr.second));
				});
				iteri(epIdx, \k, pr -> {
					edges := arrayPush(^edges, MizEqEdge(pr.first, pr.second, 0, 3, k));
					uf := setTree(^uf, mizEqcFind(uf, pr.first), mizEqcFind(uf, pr.second));
				});
				iter(commEdges, \pr -> if (pr.first != pr.second) {
					edges := arrayPush(^edges, MizEqEdge(pr.first, pr.second, 0, 1, -1));
					uf := setTree(^uf, mizEqcFind(uf, pr.first), mizEqcFind(uf, pr.second));
				});
				iter(rwEdges, \pr -> if (pr.first != pr.second) {
					edges := arrayPush(^edges, MizEqEdge(pr.first, pr.second, 0, 4, -1));
					uf := setTree(^uf, mizEqcFind(uf, pr.first), mizEqcFind(uf, pr.second));
				});
				mizEqcCongRounds(terms, ^uni, uf, edges, 1);
				adjEq = foldi(^edges, makeTree(), \ei, ac, e ->
					setTree(setTree(ac, e.a, arrayPush(lookupTreeDef(ac, e.a, []), ei)),
						e.b, arrayPush(lookupTreeDef(ac, e.b, []), ei)));
				env = MizEqChainEnv(asm, phKey, cands, drvs, ctx, provable,
					^uni, terms, ^edges, adjEq,
					ref [], ref [], ref [], ref makeTree(), ref makeTree(), ref makeTree(),
					map(eqPieces, \ep -> ep.third));
				// the ⊆ edges: candidate atoms, then the structural inclusions of
				// every compound term in the universe
				tIdx = \t : FolTerm -> lookupTreeDef(^uni, mizEmitTKey(t), -1);
				ssEdges0 = mapi(ssIdx, \k, pr ->
					MizSsEdge(pr.first, pr.second, 0, k, ""));
				ssEdges = foldi(terms, ssEdges0, \i, ac, t -> switch (t) {
					FolApp(fn, args): if (length(args) != 2) ac
						else {
							ia = tIdx(args[0]);
							ib = tIdx(args[1]);
							if (fn == "∩" && ia >= 0 && ib >= 0)
								arrayPush(arrayPush(ac, MizSsEdge(i, ia, 1, -1, "inss1")),
									MizSsEdge(i, ib, 1, -1, "inss2"))
							else if (fn == "∖" && ia >= 0)
								arrayPush(ac, MizSsEdge(i, ia, 1, -1, "difss"))
							else if (fn == "∪" && ia >= 0 && ib >= 0)
								arrayPush(arrayPush(ac, MizSsEdge(ia, i, 1, -1, "ssun1")),
									MizSsEdge(ib, i, 1, -1, "ssun2"))
							else ac;
						}
					default: ac;
				});
				classOf = foldi(terms, makeTree(), \i, ac, __ ->
					setTree(ac, i, mizEqcFind(uf, i)));
				members = foldi(terms, makeTree(), \i, ac, __ -> {
					rt = mizEqcFind(uf, i);
					setTree(ac, rt, arrayPush(lookupTreeDef(ac, rt, []), i));
				});
				adjSs = foldi(ssEdges, makeTree(), \ei, ac, e -> {
					rt = mizEqcFind(uf, e.a);
					setTree(ac, rt, arrayPush(lookupTreeDef(ac, rt, []), ei));
				});
				senv = MizSsEnv(env, ssAtoms, ssEdges, adjSs, classOf, members,
					ref makeTree(), ref makeTree(), ref makeSet());
				r = if (g3.third) {
					switch (mizSscProve(senv, gi, gj, 5)) {
						None(): None();
						Some(h1): switch (mizSscProve(senv, gj, gi, 5)) {
							None(): None();
							Some(h2): Some(mizEqcEmit(env, mizEqcMkD(env, goal),
								if (isSome(asm)) "eqssd" else "eqssi", [h1, h2]));
						}
					}
				} else mizSscProve(senv, gi, gj, 5);
				switch (r) {
					None(): {
						if (^mizEmitDbg) println("  SSCHAIN fail terms=" + i2s(length(terms))
							+ " ss=" + i2s(length(ssEdges)) + " eq=" + i2s(length(^edges))
							+ " :: " + strGlue(folFormToks(goal), " "));
						None();
					}
					Some(h): {
						lastOk = switch (h) {
							FolPRefStep(k): k == length(^(env.steps)) - 1
								&& (^(env.steps))[k].form == mizEqcMkD(env, goal);
							FolPRefFact(__): false;
						};
						if (!lastOk) None()
						else {
							if (^mizEmitDbg)
								println("  SSCHAIN ok steps=" + i2s(length(^(env.steps))));
							Some(FolStepProof(^(env.steps), ^(env.frefs), uniq(^(env.djs))));
						}
					}
				}
			}
		}
	}
}

// ---- GOAL vs FOUNDATION LEMMA: the characterization table ----
// A by-step goal like `(X∖{a,b} = X) ↔ (X∩{a,b} = ∅)` is a foundation lemma
// (disj3) up to the iff's side order and each equation's orientation — and
// the flat proof spent 4,300 steps re-deriving it (t120/t57_zfmisc_1, 15 MB).
// The table lists the lemmas in Fol form with metavariables A/B; a goal is
// matched against each row directly and through the orientation bridges
// (bicomi for the iff, eqcom per equation limb, joined by bibi12i + mpbi).
mizEmitFoundIffTable() -> [Pair<string, FolForm>] {
	va = FolVar("A");
	vb = FolVar("B");
	vc = FolVar("C");
	vd = FolVar("D");
	[
		Pair("disj3", FolBin("iff",
			FolEq(FolApp("∩", [va, vb]), FolApp("∅", [])),
			FolEq(va, FolApp("∖", [va, vb])))),
		Pair("dfss2", FolBin("iff",
			FolPred("⊆", [va, vb]),
			FolEq(FolApp("∩", [va, vb]), va))),
		Pair("ssequn1", FolBin("iff",
			FolPred("⊆", [va, vb]),
			FolEq(FolApp("∪", [va, vb]), vb))),
		Pair("disjdif", FolEq(FolApp("∩", [va, FolApp("∖", [vb, va])]),
			FolApp("∅", []))),
		// EQUATION ROWS. Each is a library identity, copied VERBATIM from
		// miz_set (never reconstructed from memory — a mis-stated row is a
		// disproof), and each replaces a by-step proof that ran past the size
		// cap: the census of zfmisc_1's over-cap steps found these seven
		// equations, and six of them are one citation each.
		//   pwsn      𝒫 { A } = { ∅ , { A } }
		Pair("pwsn", FolEq(FolApp("𝒫", [FolApp("singleton", [va])]),
			FolApp("pair", [FolApp("∅", []), FolApp("singleton", [va])]))),
		//   unipw     ∪. 𝒫 A = A
		Pair("unipw", FolEq(FolApp("∪.", [FolApp("𝒫", [va])]), va)),
		//   xpundir   ( A ∪ B ) ×. C = ( A ×. C ) ∪ ( B ×. C )
		Pair("xpundir", FolEq(FolApp("×.", [FolApp("∪", [va, vb]), vc]),
			FolApp("∪", [FolApp("×.", [va, vc]), FolApp("×.", [vb, vc])]))),
		//   xpundi    A ×. ( B ∪ C ) = ( A ×. B ) ∪ ( A ×. C )
		Pair("xpundi", FolEq(FolApp("×.", [va, FolApp("∪", [vb, vc])]),
			FolApp("∪", [FolApp("×.", [va, vb]), FolApp("×.", [va, vc])]))),
		//   difxp1    ( A ∖ B ) ×. C = ( A ×. C ) ∖ ( B ×. C )
		Pair("difxp1", FolEq(FolApp("×.", [FolApp("∖", [va, vb]), vc]),
			FolApp("∖", [FolApp("×.", [va, vc]), FolApp("×.", [vb, vc])]))),
		//   difxp2    A ×. ( B ∖ C ) = ( A ×. B ) ∖ ( A ×. C )
		Pair("difxp2", FolEq(FolApp("×.", [va, FolApp("∖", [vb, vc])]),
			FolApp("∖", [FolApp("×.", [va, vb]), FolApp("×.", [va, vc])]))),
		// THE UNION / POWER-CLASS ROWS, from a census of the OPEN goals in
		// the emitted zfmisc_1: each is a library lemma outright, stated
		// VERBATIM as miz_set states it.
		//   uni0      ∪. ∅ = ∅
		Pair("uni0", FolEq(FolApp("∪.", [FolApp("∅", [])]), FolApp("∅", []))),
		//   uniun     ∪. ( A ∪ B ) = ( ∪. A ∪ ∪. B )
		Pair("uniun", FolEq(FolApp("∪.", [FolApp("∪", [va, vb])]),
			FolApp("∪", [FolApp("∪.", [va]), FolApp("∪.", [vb])]))),
		//   inxp      ( ( A ×. B ) ∩ ( C ×. D ) ) = ( ( A ∩ C ) ×. ( B ∩ D ) )
		Pair("inxp", FolEq(
			FolApp("∩", [FolApp("×.", [va, vb]), FolApp("×.", [vc, vd])]),
			FolApp("×.", [FolApp("∩", [va, vc]), FolApp("∩", [vb, vd])]))),
		// ---- THE SOFT TYPE LAYER (miz_aux df-elt and its lemmas) ----
		// What Mizar's `Element of` MEANS. The checker uses it without stating
		// it, so these never arrive as citations; as foundation rows they are
		// available to any step, goal-side or fact-side.
		//   eltor     ( B = ∅ ) ∨ ( ( element A B ) ↔ ( A ∈ B ) )
		Pair("eltor", FolBin("or", FolEq(vb, FolApp("∅", [])),
			FolBin("iff", FolPred("element", [va, vb]), FolPred("∈", [va, vb])))),
		//   elt0      ( B = ∅ ) → ( ( element A B ) ↔ ( A = ∅ ) )
		Pair("elt0", FolBin("imp", FolEq(vb, FolApp("∅", [])),
			FolBin("iff", FolPred("element", [va, vb]), FolEq(va, FolApp("∅", []))))),
		//   elti      ( A ∈ B ) → ( element A B )
		Pair("elti", FolBin("imp", FolPred("∈", [va, vb]), FolPred("element", [va, vb]))),
		//   nempex    ¬ ( A = ∅ ) → ∃x ( x ∈ A )   — a set that is not empty HAS a
		//   member: the existential Mizar's own normalization names a constant for
		Pair("nempex", FolBin("imp", FolNeg(FolEq(va, FolApp("∅", []))),
			FolQuant("exists", ["Xe1"], FolPred("∈", [FolVar("Xe1"), va])))),
		//   elt0pw    ( element ∅ 𝒫 B )
		Pair("elt0pw", FolPred("element", [FolApp("∅", []), FolApp("𝒫", [vb])])),
		//   eltpwi    ( element A 𝒫 B ) → ( A ⊆ B )
		Pair("eltpwi", FolBin("imp", FolPred("element", [va, FolApp("𝒫", [vb])]),
			FolPred("⊆", [va, vb]))),
		//   eltmem    ( element A 𝒫 B ) → ( ( C ∈ A ) → ( C ∈ B ) )
		Pair("eltmem", FolBin("imp", FolPred("element", [va, FolApp("𝒫", [vb])]),
			FolBin("imp", FolPred("∈", [vc, va]), FolPred("∈", [vc, vb])))),
		//   eltss     ( element A 𝒫 B ) → ( ( C ∈ A ) → ( element C B ) )
		Pair("eltss", FolBin("imp", FolPred("element", [va, FolApp("𝒫", [vb])]),
			FolBin("imp", FolPred("∈", [vc, va]), FolPred("element", [vc, vb])))),
		//   pwuni     A ⊆ 𝒫 ∪. A
		Pair("pwuni", FolPred("⊆", [va, FolApp("𝒫", [FolApp("∪.", [va])])])),
		//   uniin     ∪. ( A ∩ B ) ⊆ ( ∪. A ∩ ∪. B )
		Pair("uniin", FolPred("⊆", [FolApp("∪.", [FolApp("∩", [va, vb])]),
			FolApp("∩", [FolApp("∪.", [va]), FolApp("∪.", [vb])])])),
		//   elssuni   ( A ∈ B ) → ( A ⊆ ∪. B )
		Pair("elssuni", FolBin("imp", FolPred("∈", [va, vb]),
			FolPred("⊆", [va, FolApp("∪.", [vb])]))),
		//   uniss     ( A ⊆ B ) → ( ∪. A ⊆ ∪. B )
		Pair("uniss", FolBin("imp", FolPred("⊆", [va, vb]),
			FolPred("⊆", [FolApp("∪.", [va]), FolApp("∪.", [vb])]))),
		//   sspw      ( A ⊆ B ) → ( 𝒫 A ⊆ 𝒫 B )
		Pair("sspw", FolBin("imp", FolPred("⊆", [va, vb]),
			FolPred("⊆", [FolApp("𝒫", [va]), FolApp("𝒫", [vb])]))),
		//   xpss1     ( A ⊆ B ) → ( ( A ×. C ) ⊆ ( B ×. C ) )
		Pair("xpss1", FolBin("imp", FolPred("⊆", [va, vb]),
			FolPred("⊆", [FolApp("×.", [va, vc]), FolApp("×.", [vb, vc])]))),
		//   xpss2     ( A ⊆ B ) → ( ( C ×. A ) ⊆ ( C ×. B ) )
		Pair("xpss2", FolBin("imp", FolPred("⊆", [va, vb]),
			FolPred("⊆", [FolApp("×.", [vc, va]), FolApp("×.", [vc, vb])]))),
		//   xpss12    ( ( A ⊆ B ) ∧ ( C ⊆ D ) ) → ( ( A ×. C ) ⊆ ( B ×. D ) )
		Pair("xpss12", FolBin("imp",
			FolBin("and", FolPred("⊆", [va, vb]), FolPred("⊆", [vc, vd])),
			FolPred("⊆", [FolApp("×.", [va, vc]), FolApp("×.", [vb, vd])]))),
		// THE INCLUSION / PROPER-INCLUSION FAMILY. Every one of these is a
		// two-atom library fact that the flat search was re-deriving,
		// because the checker spells a by-step goal as a denied conjunction
		// and the table was only ever matched against the goal AS WRITTEN
		// (the bridge is mizEmitFoundNegGoal).
		//   sstr      ( ( A ⊆ B ) ∧ ( B ⊆ C ) ) → ( A ⊆ C )
		Pair("sstr", FolBin("imp",
			FolBin("and", FolPred("⊆", [va, vb]), FolPred("⊆", [vb, vc])), FolPred("⊆", [va, vc]))),
		//   unss      ( ( A ⊆ C ) ∧ ( B ⊆ C ) ) ↔ ( ( A ∪ B ) ⊆ C )
		Pair("unss", FolBin("iff",
			FolBin("and", FolPred("⊆", [va, vc]), FolPred("⊆", [vb, vc])),
			FolPred("⊆", [FolApp("∪", [va, vb]), vc]))),
		//   ssin      ( ( A ⊆ B ) ∧ ( A ⊆ C ) ) ↔ ( A ⊆ ( B ∩ C ) )
		Pair("ssin", FolBin("iff",
			FolBin("and", FolPred("⊆", [va, vb]), FolPred("⊆", [va, vc])),
			FolPred("⊆", [va, FolApp("∩", [vb, vc])]))),
		//   npss0     ¬ ( A ⊊ ∅ )
		Pair("npss0", FolNeg(FolPred("⊊", [va, FolApp("∅", [])]))),
		//   pssn2lp   ¬ ( ( A ⊊ B ) ∧ ( B ⊊ A ) )
		Pair("pssn2lp", FolNeg(FolBin("and", FolPred("⊊", [va, vb]), FolPred("⊊", [vb, va])))),
		//   ssnpss    ( A ⊆ B ) → ¬ ( B ⊊ A )
		Pair("ssnpss", FolBin("imp", FolPred("⊆", [va, vb]), FolNeg(FolPred("⊊", [vb, va])))),
		//   pssss     ( A ⊊ B ) → ( A ⊆ B )
		Pair("pssss", FolBin("imp", FolPred("⊊", [va, vb]), FolPred("⊆", [va, vb]))),
		//   psstr     ( ( A ⊊ B ) ∧ ( B ⊊ C ) ) → ( A ⊊ C )
		Pair("psstr", FolBin("imp",
			FolBin("and", FolPred("⊊", [va, vb]), FolPred("⊊", [vb, vc])), FolPred("⊊", [va, vc]))),
		//   psssstr   ( ( A ⊊ B ) ∧ ( B ⊆ C ) ) → ( A ⊊ C )
		Pair("psssstr", FolBin("imp",
			FolBin("and", FolPred("⊊", [va, vb]), FolPred("⊆", [vb, vc])), FolPred("⊊", [va, vc]))),
		//   sspsstr   ( ( A ⊆ B ) ∧ ( B ⊊ C ) ) → ( A ⊊ C )
		Pair("sspsstr", FolBin("imp",
			FolBin("and", FolPred("⊆", [va, vb]), FolPred("⊊", [vb, vc])), FolPred("⊊", [va, vc]))),
		//   dfpss3    ( A ⊊ B ) ↔ ( ( A ⊆ B ) ∧ ¬ ( B ⊆ A ) )
		Pair("dfpss3", FolBin("iff", FolPred("⊊", [va, vb]),
			FolBin("and", FolPred("⊆", [va, vb]), FolNeg(FolPred("⊆", [vb, va]))))),
		//   sspss     ( A ⊆ B ) ↔ ( ( A ⊊ B ) ∨ ( A = B ) )
		Pair("sspss", FolBin("iff", FolPred("⊆", [va, vb]),
			FolBin("or", FolPred("⊊", [va, vb]), FolEq(va, vb)))),
		// A SECOND CENSUS ROUND, this one mechanical: every open goal of the
		// emitted articles was canonicalised and looked up in miz_set by its
		// STATEMENT. These are the remaining exact matches.
		//   unss12    ( ( A ⊆ B ) ∧ ( C ⊆ D ) ) → ( ( A ∪ C ) ⊆ ( B ∪ D ) )
		Pair("unss12", FolBin("imp",
			FolBin("and", FolPred("⊆", [va, vb]), FolPred("⊆", [vc, vd])),
			FolPred("⊆", [FolApp("∪", [va, vc]), FolApp("∪", [vb, vd])]))),
		//   ss2in     ( ( A ⊆ B ) ∧ ( C ⊆ D ) ) → ( ( A ∩ C ) ⊆ ( B ∩ D ) )
		Pair("ss2in", FolBin("imp",
			FolBin("and", FolPred("⊆", [va, vb]), FolPred("⊆", [vc, vd])),
			FolPred("⊆", [FolApp("∩", [va, vc]), FolApp("∩", [vb, vd])]))),
		//   ssdisj    ( ( A ⊆ B ) ∧ ( ( B ∩ C ) = ∅ ) ) → ( ( A ∩ C ) = ∅ )
		Pair("ssdisj", FolBin("imp",
			FolBin("and", FolPred("⊆", [va, vb]),
				FolEq(FolApp("∩", [vb, vc]), FolApp("∅", []))),
			FolEq(FolApp("∩", [va, vc]), FolApp("∅", [])))),
		//   snelpwi   ( A ∈ B ) → ( { A } ∈ 𝒫 B )
		Pair("snelpwi", FolBin("imp", FolPred("∈", [va, vb]),
			FolPred("∈", [FolApp("singleton", [va]), FolApp("𝒫", [vb])]))),
		//   xpsspw    ( A ×. B ) ⊆ 𝒫 𝒫 ( A ∪ B )
		Pair("xpsspw", FolPred("⊆", [FolApp("×.", [va, vb]), FolApp("𝒫", [FolApp("𝒫", [FolApp("∪", [va, vb])])])])),
		//   xpid11    ( ( A ×. A ) = ( B ×. B ) ) ↔ ( A = B )
		Pair("xpid11", FolBin("iff",
			FolEq(FolApp("×.", [va, va]), FolApp("×.", [vb, vb])),
			FolEq(va, vb))),
		//   difxp     ( ( C ×. D ) ∖ ( A ×. B ) ) =
		//                    ( ( ( C ∖ A ) ×. D ) ∪ ( C ×. ( D ∖ B ) ) )
		Pair("difxp", FolEq(
			FolApp("∖", [FolApp("×.", [vc, vd]), FolApp("×.", [va, vb])]),
			FolApp("∪", [FolApp("×.", [FolApp("∖", [vc, va]), vd]),
				FolApp("×.", [vc, FolApp("∖", [vd, vb])])]))),
		//   difsnid   ( B ∈ A ) → ( ( ( A ∖ { B } ) ∪ { B } ) = A )
		Pair("difsnid", FolBin("imp", FolPred("∈", [vb, va]),
			FolEq(FolApp("∪", [FolApp("∖", [va, FolApp("singleton", [vb])]),
				FolApp("singleton", [vb])]), va))),
		//   ssdifsn   ( A ⊆ ( B ∖ { C } ) ) ↔ ( ( A ⊆ B ) ∧ ¬ ( C ∈ A ) )
		Pair("ssdifsn", FolBin("iff",
			FolPred("⊆", [va, FolApp("∖", [vb, FolApp("singleton", [vc])])]),
			FolBin("and", FolPred("⊆", [va, vb]), FolNeg(FolPred("∈", [vc, va])))))
	];
}

// ---- GUARDED LIBRARY IDENTITIES ----
// Some identities are stated with sethood guards (`A ∈ V ∧ B ∈ W → …`).
// At a SETVAR argument each guard is `vex`, so the identity is still a
// citation: two or three vex lines, the instance, and one detachment.
// Statements copied verbatim from miz_set; the class metavariables V/W/U
// are instantiated at _V.
mizEmitFoundGuardedTable() -> [Triple<string, [FolForm], FolForm>] {
	va = FolVar("A");
	vb = FolVar("B");
	vc = FolVar("C");
	vd = FolVar("D");
	vv = FolApp("_V", []);
	g = \t : FolTerm -> FolPred("∈", [t, vv]);
	[
		//  xpsng    ( A ∈ V ∧ B ∈ W ) → ( { A } ×. { B } = { 〈 A , B 〉 } )
		Triple("xpsng", [g(va), g(vb)],
			FolEq(FolApp("×.", [FolApp("singleton", [va]), FolApp("singleton", [vb])]),
				FolApp("singleton", [FolApp("opair", [va, vb])]))),
		//  opthg    ( A ∈ V ∧ B ∈ W ) →
		//                 ( ( 〈 A , B 〉 = 〈 C , D 〉 ) ↔ ( A = C ∧ B = D ) )
		//  — an EQUIVALENCE row: the goals that want it are its halves
		//    (xtuple_0's pair-injectivity steps), closed by biimpi/biimpri
		Triple("opthg", [g(va), g(vb)],
			FolBin("iff",
				FolEq(FolApp("opair", [va, vb]), FolApp("opair", [vc, vd])),
				FolBin("and", FolEq(va, vc), FolEq(vb, vd)))),
		//  xpprsng  ( A ∈ V ∧ B ∈ W ∧ C ∈ U ) →
		//                    ( { A , B } ×. { C } = { 〈 A , C 〉 , 〈 B , C 〉 } )
		//  — a THREE-guard row: its antecedent is the foundation's 3-ary
		//    conjunction, written with the "and3" node that renders flat
		Triple("xpprsng", [g(va), g(vb), g(vc)],
			FolEq(FolApp("×.", [FolApp("pair", [va, vb]), FolApp("singleton", [vc])]),
				FolApp("pair", [FolApp("opair", [va, vc]), FolApp("opair", [vb, vc])]))),
		// ONE-GUARD ROWS. At a setvar the single guard is vex and the row
		// detaches with ax-mp; the goals are zfmisc_1's singleton and
		// power-class steps.
		//  pwidg    ( A ∈ V ) → ( A ∈ 𝒫 A )
		Triple("pwidg", [g(va)], FolPred("∈", [va, FolApp("𝒫", [va])])),
		//  unisng   ( A ∈ V ) → ( ∪. { A } = A )
		Triple("unisng", [g(va)],
			FolEq(FolApp("∪.", [FolApp("singleton", [va])]), va)),
		//  snssg    ( A ∈ V ) → ( ( A ∈ B ) ↔ ( { A } ⊆ B ) )
		Triple("snssg", [g(va)],
			FolBin("iff", FolPred("∈", [va, vb]),
				FolPred("⊆", [FolApp("singleton", [va]), vb]))),
		//  uniprg   ( A ∈ V ∧ B ∈ W ) → ( ∪. { A , B } = ( A ∪ B ) )
		Triple("uniprg", [g(va), g(vb)],
			FolEq(FolApp("∪.", [FolApp("pair", [va, vb])]),
				FolApp("∪", [va, vb])))
	];
}

mizEmitFoundGuardedEq(goal : FolForm, asm : Maybe<FolForm>) -> Maybe<FolStepProof> {
	metas = buildSet(["A", "B", "C", "D"]);
	// a row is used AS STATED, or — when it is an equivalence — through the
	// half the goal asks for (biimpi / biimpri after the detachment)
	shapes = \concl : FolForm -> switch (concl) {
		FolBin(op6, l6, r6): if (op6 != "iff") [Pair(concl, "")]
			else [Pair(concl, ""), Pair(FolBin("imp", l6, r6), "biimpi"),
				Pair(FolBin("imp", r6, l6), "biimpri"),
				// ...and the row read the other way round
				Pair(FolBin("iff", r6, l6), "bicomi")];
		default: [Pair(concl, "")];
	};
	fold(mizEmitFoundGuardedTable(), None(), \acc : Maybe<FolStepProof>, row ->
		switch (acc) {
			Some(__): acc;
			None(): fold(shapes(row.third), None(), \ac2 : Maybe<FolStepProof>, sh ->
			switch (ac2) {
			Some(__): ac2;
			None(): switch (mizEmitMatchF(sh.first, goal, metas, Some(makeTree()))) {
				None(): None();
				Some(sub): if (mizEmitSubF(sh.first, sub) != goal) None() else {
					gs = map(row.second, \gf -> mizEmitSubF(gf, sub));
					// vex is for SETVARS — a compound argument would need its own
					// sethood proof, and this row declines rather than guess
					ok = forall(gs, \gf -> switch (gf) {
						FolPred(nm, args): nm == "∈" && length(args) == 2
							&& switch (args[0]) { FolVar(__): true; default: false; };
						default: false;
					});
					n = length(gs);
					lem = if (n == 1) "ax-mp" else if (n == 2) "mp2an"
						else if (n == 3) "mp3an" else "";
					if (!ok || lem == "") None() else {
						// three guards conjoin into the flat-rendering node; two
						// into a plain binary conjunction
						conj = if (n == 3)
								FolBin("and3", FolBin("and", gs[0], gs[1]), gs[2])
							else fold(tail(gs), gs[0], \a9, gf -> FolBin("and", a9, gf));
						vexes = map(gs, \gf -> FolPStep(gf, "vex", []));
						// the instance states the ROW as written; the requested half
						// follows it
						conclI = mizEmitSubF(row.third, sub);
						inst = FolPStep(FolBin("imp", conj, conclI), row.first, []);
						refs = arrayPush(mapi(gs, \i, __ -> FolPRefStep(i)), FolPRefStep(n));
						det = arrayPush(arrayPush(vexes, inst), FolPStep(conclI, lem, refs));
						steps0 = if (sh.second == "") det
							else arrayPush(det, FolPStep(goal, sh.second,
								[FolPRefStep(length(det) - 1)]));
						steps = switch (asm) {
							None(): steps0;
							Some(af): arrayPush(steps0, FolPStep(FolBin("imp", af, goal), "a1i",
								[FolPRefStep(length(steps0) - 1)]));
						};
						Some(FolStepProof(steps, [], []));
					}
				}
			}
			});
		});
}

mizEmitFoundIffGoal(goal : FolForm, asm : Maybe<FolForm>) -> Maybe<FolStepProof> {
	metas = buildSet(["A", "B", "C", "D"]);
	flipEq = \f : FolForm -> switch (f) {
		FolEq(a, b): Some(FolEq(b, a));
		default: None();
	};
	finish = \steps0 : [FolPStep] -> {
		// under an assumption the ladder's contract is `asm → goal`
		steps = switch (asm) {
			None(): steps0;
			Some(af): arrayPush(steps0, FolPStep(FolBin("imp", af, goal), "a1i",
				[FolPRefStep(length(steps0) - 1)]));
		};
		Some(FolStepProof(steps, [], []));
	};
	fold(mizEmitFoundIffTable(), None(), \acc : Maybe<FolStepProof>, row ->
		switch (acc) {
			Some(__): acc;
			None(): {
				// direct instance first — any shape
				direct = switch (mizEmitMatchF(row.second, goal, metas, Some(makeTree()))) {
					None(): None();
					Some(sub): if (mizEmitSubF(row.second, sub) != goal) None()
						else finish([FolPStep(goal, row.first, [])]);
				};
				// ...and an IMPLICATION goal may be an equivalence row's half
				// (unss, ssin, sspss are stated as equivalences and cited as
				// implications): the row is cited, then biimpi / biimpri.
				halves = switch (direct) {
					Some(__): direct;
					None(): switch (row.second) {
						FolBin(op8, l8, r8): if (op8 != "iff") None()
							else fold([Pair(FolBin("imp", l8, r8), "biimpi"),
								Pair(FolBin("imp", r8, l8), "biimpri")], None(),
							\a8 : Maybe<FolStepProof>, sh8 -> switch (a8) {
								Some(__): a8;
								None(): switch (mizEmitMatchF(sh8.first, goal, metas, Some(makeTree()))) {
									None(): None();
									Some(sub8): if (mizEmitSubF(sh8.first, sub8) != goal) None()
										else finish([FolPStep(mizEmitSubF(row.second, sub8), row.first, []),
											FolPStep(goal, sh8.second, [FolPRefStep(0)])]);
								}
							});
						default: None();
					}
				};
				switch (halves) {
					Some(__): halves;
					None(): switch (row.second) {
						FolBin(op0, p0, q0): if (op0 != "iff") None()
						else fold([false, true], None(), \a2 : Maybe<FolStepProof>, swap ->
							switch (a2) {
								Some(__): a2;
								None(): {
									pp = if (swap) Pair(q0, p0) else Pair(p0, q0);
									lVars = concat([Pair(pp.first, false)],
										switch (flipEq(pp.first)) {
											Some(fl): [Pair(fl, true)];
											None(): [];
										});
									rVars = concat([Pair(pp.second, false)],
										switch (flipEq(pp.second)) {
											Some(fr): [Pair(fr, true)];
											None(): [];
										});
									fold(lVars, None(), \a3 : Maybe<FolStepProof>, lv ->
										switch (a3) {
											Some(__): a3;
											None(): fold(rVars, None(), \a4 : Maybe<FolStepProof>, rv ->
												switch (a4) {
													Some(__): a4;
													None(): if (!swap && !lv.second && !rv.second) None()
													else {
														pv = FolBin("iff", lv.first, rv.first);
														switch (mizEmitMatchF(pv, goal, metas, Some(makeTree()))) {
															None(): None();
															Some(sub): if (mizEmitSubF(pv, sub) != goal) None()
															else {
																st : ref [FolPStep] = ref [];
																emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
																	st := arrayPush(^st, FolPStep(form, lemma, refs));
																	length(^st) - 1;
																};
																i0 = emit(mizEmitSubF(row.second, sub), row.first, []);
																s1 = mizEmitSubF(pp.first, sub);
																s2 = mizEmitSubF(pp.second, sub);
																cur = if (!swap) i0
																	else emit(FolBin("iff", s1, s2), "bicomi", [FolPRefStep(i0)]);
																t1 = mizEmitSubF(lv.first, sub);
																t2 = mizEmitSubF(rv.first, sub);
																if (!lv.second && !rv.second) finish(^st)
																else {
																	c1 = if (lv.second) emit(FolBin("iff", s1, t1), "eqcom", [])
																		else emit(FolBin("iff", s1, s1), "biid", []);
																	c2 = if (rv.second) emit(FolBin("iff", s2, t2), "eqcom", [])
																		else emit(FolBin("iff", s2, s2), "biid", []);
																	bb = emit(FolBin("iff", FolBin("iff", s1, s2), goal),
																		"bibi12i", [FolPRefStep(c1), FolPRefStep(c2)]);
																	f9 = emit(goal, "mpbi", [FolPRefStep(cur), FolPRefStep(bb)]);
																	finish(^st);
																}
															}
														}
													}
												});
										});
								}
							});
						default: None();
					}
				}
			}
		});
}

// A conjunction's conjuncts in the checker's spelling, which nests them to the
// RIGHT: `A ∧ (B ∧ C)` is [A, B, C].
mizEmitConjsR(f : FolForm) -> [FolForm] {
	switch (f) {
		FolBin(op, l, r): if (op != "and") [f] else concat([l], mizEmitConjsR(r));
		default: [f];
	}
}

// ---- THE NEGATION NORMAL FORM BRIDGE ----
// The checker states a by-step goal as `¬ (A₁ ∧ (A₂ ∧ … ∧ ¬ C))` — never as
// the implication `(A₁ ∧ … ∧ Aₙ) → C` that the library states. That spelling
// alone hid every implication row from the whole transitivity family
// (sstr, psstr, ssnpss, unss, ssin …), so a two-atom library fact was
// re-derived by the flat search. The row is matched against the IMPLICATION
// and the proof walks back to the goal's spelling:
//   (P → C)              iman     ¬ ( P ∧ ¬ C )        (C negated in the goal)
//   (P → ¬ L)            imnan    ¬ ( P ∧ L )          (it is not)
//   ((X ∧ Y) ∧ Z)        anass    (X ∧ (Y ∧ Z))        once per extra conjunct,
//                                                       lifted by notbii
mizEmitFoundNegGoal(goal : FolForm, asm : Maybe<FolForm>) -> Maybe<FolStepProof> {
	switch (goal) {
		FolNeg(body): {
			cs = mizEmitConjsR(body);
			n = length(cs) - 1;
			if (n < 1 || n > 4) None() else {
				lastc = cs[n];
				// the antecedent is the library's: conjuncts nested to the LEFT
				pf0 = subrange(cs, 0, n);
				pForm = fold(tail(pf0), pf0[0], \a, f -> FolBin("and", a, f));
				pair = switch (lastc) {
					FolNeg(c9): Pair(c9, "iman");
					default: Pair(FolNeg(lastc), "imnan");
				};
				impForm = FolBin("imp", pForm, pair.first);
				inner = switch (mizEmitFoundIffGoal(impForm, None())) {
					Some(r7): Some(r7);
					None(): mizEmitFoundGuardedEq(impForm, None());
				};
				switch (inner) {
					None(): None();
					Some(pf): {
						st = ref pf.steps;
						ok = length(^st) > 0 && (^st)[length(^st) - 1].form == impForm;
						if (!ok) None() else {
							emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
								st := arrayPush(^st, FolPStep(form, lemma, refs));
								length(^st) - 1;
							};
							k0 = length(^st) - 1;
							// the implication becomes a denied conjunction
							neg0 = FolNeg(FolBin("and", pForm, lastc));
							b0 = emit(FolBin("iff", impForm, neg0), pair.second, []);
							c0 = emit(neg0, "mpbi", [FolPRefStep(k0), FolPRefStep(b0)]);
							// ...and its left nesting is re-associated to the right,
							// one conjunct at a time, under the negation
							res = foldi(subrange(cs, 1, n - 1), Pair(neg0, c0),
								\i, ac : Pair<FolForm, int>, __ -> {
								inner9 = switch (ac.first) { FolNeg(f9): f9; default: ac.first; };
								switch (inner9) {
									FolBin(__, l9, r9): switch (l9) {
										FolBin(__, x9, y9): {
											rhs = FolBin("and", x9, FolBin("and", y9, r9));
											a1 = emit(FolBin("iff", inner9, rhs), "anass", []);
											a2 = emit(FolBin("iff", FolNeg(inner9), FolNeg(rhs)),
												"notbii", [FolPRefStep(a1)]);
											a3 = emit(FolNeg(rhs), "mpbi",
												[FolPRefStep(ac.second), FolPRefStep(a2)]);
											Pair(FolNeg(rhs), a3);
										}
										default: ac;
									}
									default: ac;
								}
							});
							if (res.first != goal) None() else {
								steps = switch (asm) {
									None(): ^st;
									Some(af): arrayPush(^st, FolPStep(FolBin("imp", af, goal),
										"a1i", [FolPRefStep(length(^st) - 1)]));
								};
								Some(FolStepProof(steps, pf.factRefs, pf.disjs));
							}
						}
					}
				}
			}
		}
		default: None();
	}
}


// The SKELETON of a statement: its connective/predicate structure with all
// terms erased, ignoring the universal prefix. Instantiation cannot change it,
// so two statements can only stand in the instance relation when their
// skeletons are equal — which makes it an exact index for finding the premise a
// recorded fact came from when the step cites nothing (Mizar applies
// definitional expansions and requirements with no `by` reference at all, and
// those were most of the record: 91 of 132 facts on xboole_1 had no citation
// whose statement could be resolved).
mizEmitPieceSkeletons(f : FolForm) -> [string] {
	body = (mizEmitPrefixOf(f, [])).second;
	// ...and under the skeleton of what it CONCLUDES: a constructor-type axiom
	// states its type fact under the argument guards, so the statement that
	// gives `element (k4 …) 𝒫 X` is indexed at `imp(and(…),…)` and a search for
	// the type fact alone would never reach it. The index only offers
	// candidates; matching still decides.
	concl = mizEmitConcl(body);
	extra = if (concl == body) [] else map(mizEmitPieces(concl, [], 2), \pc -> mizEmitSkeleton(pc.form));
	uniq(concat(map(mizEmitPieces(body, [], 2), \pc -> mizEmitSkeleton(pc.form)), extra));
}

mizEmitSkeleton(f : FolForm) -> string {
	switch (f) {
		FolQuant(q, vs, b): if (q == "forall") mizEmitSkeleton(b)
			else "E" + i2s(length(vs)) + "(" + mizEmitSkeleton(b) + ")";
		FolPred(n, args): "P" + n + "/" + i2s(length(args));
		FolEq(__, __): "=";
		FolNeg(g): "~(" + mizEmitSkeleton(g) + ")";
		FolBin(op, l, r): op + "(" + mizEmitSkeleton(l) + "," + mizEmitSkeleton(r) + ")";
	}
}

// ---- reaching the recorded fact through a DECOMPOSITION of the premise ----
// The checker normalizes before it uses a premise, so what it records is often
// one PIECE of the cited statement: a definitional biconditional is split into
// its two implications, a conjunction into its conjuncts. Matching the whole
// statement then fails even though the premise is right there. Each piece is
// one Hilbert step away from the instantiated statement (biimpi / biimpri /
// simpl+ax-mp / simpr+ax-mp), so the pieces are offered as match candidates and
// the step that produced them is appended to the elimination.
MizEmitPiece(form : FolForm, ops : [string]);

mizEmitPieces(f : FolForm, ops : [string], depth : int) -> [MizEmitPiece] {
	self = arrayPush([], MizEmitPiece(f, ops));
	if (depth <= 0) self
	else switch (f) {
		FolBin(op, l, r):
			if (op == "iff") concatA([self,
				mizEmitPieces(FolBin("imp", l, r), arrayPush(ops, "biimpi"), depth - 1),
				mizEmitPieces(FolBin("imp", r, l), arrayPush(ops, "biimpri"), depth - 1)])
			else if (op == "and") concatA([self,
				mizEmitPieces(l, arrayPush(ops, "simpl"), depth - 1),
				mizEmitPieces(r, arrayPush(ops, "simpr"), depth - 1)])
			// a conjunction UNDER an antecedent splits by the deduction-form
			// projections: the checker splits `v1 X → (eq ∧ eq)` into two
			// guarded premises, and the record's fact is one of them
			else if (op == "imp") switch (r) {
				FolBin(op2, a2, b2): if (op2 != "and") self else concatA([self,
					mizEmitPieces(FolBin("imp", l, a2), arrayPush(ops, "simpld"), depth - 1),
					mizEmitPieces(FolBin("imp", l, b2), arrayPush(ops, "simprd"), depth - 1)]);
				default: self;
			}
			else self;
		default: self;
	}
}

// apply the recorded decomposition to an already-instantiated statement
mizEmitApplyOps(steps : ref [FolPStep], form : FolForm, idx : int,
	ops : [string]) -> Maybe<Pair<FolForm, int>> {
	emit = \fm : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(fm, lemma, refs));
		length(^steps) - 1;
	};
	fold(ops, Some(Pair(form, idx)), \acc : Maybe<Pair<FolForm, int>>, op ->
		switch (acc) {
			None(): None();
			Some(st): switch (st.first) {
				FolBin(bop, l, r): {
					if (op == "biimpi" && bop == "iff") {
						g = FolBin("imp", l, r);
						Some(Pair(g, emit(g, "biimpi", [FolPRefStep(st.second)])));
					} else if (op == "biimpri" && bop == "iff") {
						g = FolBin("imp", r, l);
						Some(Pair(g, emit(g, "biimpri", [FolPRefStep(st.second)])));
					} else if (op == "simpl" && bop == "and") {
						// simpl : (φ ∧ ψ) → φ
						im = emit(FolBin("imp", st.first, l), "simpl", []);
						Some(Pair(l, emit(l, "ax-mp", [FolPRefStep(st.second), FolPRefStep(im)])));
					} else if (op == "eqidmp") {
						// a MEANS-definition instantiated at the term it defines reads
						// `(t = t) ↔ B`; eqid discharges the left side and mpbi leaves B
						eqOk = switch (l) { FolEq(a, b): a == b; default: false; };
						if (eqOk) {
							e = emit(l, "eqid", []);
							Some(Pair(r, emit(r, "mpbi", [FolPRefStep(e), FolPRefStep(st.second)])));
						} else if (bop == "imp") switch (r) {
							// the DEDUCTION TWIN (twin table +1: mpbi → mpbid): a
							// GUARDED means-definition (relat_1's d8/d10 family,
							// `relation-like it → ((it = f(ā)) ↔ B)`) discharges
							// under the guard — eqid lifted by a1i, then mpbid
							FolBin(rop, rl, rr): if (rop != "iff") None() else {
								eqOk2 = switch (rl) { FolEq(a2, b2): a2 == b2; default: false; };
								if (!eqOk2) None() else {
									e = emit(rl, "eqid", []);
									ai = emit(FolBin("imp", l, rl), "a1i", [FolPRefStep(e)]);
									g = FolBin("imp", l, rr);
									Some(Pair(g, emit(g, "mpbid",
										[FolPRefStep(ai), FolPRefStep(st.second)])));
								}
							}
							default: None();
						} else None();
					} else if (op == "simpr" && bop == "and") {
						im = emit(FolBin("imp", st.first, r), "simpr", []);
						Some(Pair(r, emit(r, "ax-mp", [FolPRefStep(st.second), FolPRefStep(im)])));
					} else if ((op == "simpld" || op == "simprd") && bop == "imp") {
						// deduction-form projection: |- (g → (a ∧ b)) ⊢ |- (g → a/b)
						switch (r) {
							FolBin(rop, ra, rb): if (rop != "and") None() else {
								g = FolBin("imp", l, if (op == "simpld") ra else rb);
								Some(Pair(g, emit(g, op, [FolPRefStep(st.second)])));
							}
							default: None();
						}
					} else None();
				}
				default: None();
			}
		});
}

// The congruence walk over an ARTICLE predicate. The foundation's ∈/⊆ have
// their own lemmas; every other predicate (a Mizar relation, mode or attribute
// — `element`, `are_mutually_distinct`, …) carries the congruences the
// translator generates for it, one per argument slot:
//   pr_<p>_cong<k>d : (a = b) → (p(..a..) ↔ p(..b..))
// Rewriting slot by slot and chaining with bitrd gives (x = T) → (p(u) ↔ p(u')).
// Without this the walk stopped at any article predicate, which is why 33 of
// subset_1's 48 matched premises could not be eliminated: they are about
// `Element of`.
mizEmitWalkPred(steps : ref [FolPStep], x : string, t : FolTerm, f : FolForm,
	name : string, args : [FolTerm],
	mkIff : (FolForm, FolForm, string, [FolPRef]) -> int) -> Maybe<Pair<int, FolForm>> {
	if (!exists(args, \a -> mizEmitTermHas(x, a))) None()
	else {
		start : Maybe<Pair<int, FolForm>> = Some(Pair(mkIff(f, f, "biidd", []), f));
		foldi(args, start, \i, acc : Maybe<Pair<int, FolForm>>, a ->
			switch (acc) {
				None(): None();
				Some(st): if (!mizEmitTermHas(x, a)) acc else
					switch (mizEmitWalkTerm(steps, x, t, a)) {
						None(): None();
						Some(w): {
							cur = st.second;
							curArgs = switch (cur) { FolPred(__, aa): aa; default: []; };
							if (length(curArgs) != length(args)) None()
							else {
								nxt = FolPred(name, replace(curArgs, i, w.second));
								lem = "pr_" + folRuleId(name) + "_cong" + i2s(i + 1) + "d";
								// (a = b) → (cur ↔ nxt), then lift by syl and chain by bitrd
								ci = {
									steps := arrayPush(^steps, FolPStep(
										FolBin("imp", FolEq(curArgs[i], w.second),
											FolBin("iff", cur, nxt)), lem, []));
									length(^steps) - 1;
								};
								sy = mkIff(cur, nxt, "syl", [FolPRefStep(w.first), FolPRefStep(ci)]);
								tr = mkIff(f, nxt, "bitrd", [FolPRefStep(st.first), FolPRefStep(sy)]);
								Some(Pair(tr, nxt));
							}
						}
					}
			});
	}
}

// ---- membership NORMAL FORM: rewrite instead of deciding ----
// A membership equivalence `v ∈ A ↔ v ∈ B` between compound set terms is what
// the `one step short` population is made of, and the generic proof
// cannot emit it economically: each unfold enters the tableau as a
// BICONDITIONAL FACT, and the cost is driven by their number, not by the three
// or four atoms underneath. The ∀-matrix of x5 ∩ (x7 ∖ x9) = (x5 ∩ x7) ∖ x9 is
// decided from four unfolds and then runs past 600 emitted steps.
//
// So the unfolds are applied STRUCTURALLY instead: each side is rewritten to a
// propositional combination of `v ∈ <variable>` atoms by chaining the
// foundation's own membership lemmas (elun/elin/eldif) through orbi12i /
// anbi12i / notbii and bitri. What is left for the proof is a pure
// propositional equivalence over those atoms, with no biconditional facts at
// all — linear in the term, instead of exponential in the unfold count.

// steps proving |- ((v ∈ t) ↔ NF), and NF
mizEmitMemNF(steps : ref [FolPStep], v : FolTerm, t : FolTerm,
	depth : int) -> Maybe<Pair<int, FolForm>> {
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	mem = \tt : FolTerm -> FolPred("∈", [v, tt]);
	self = \ -> Some(Pair(emit(FolBin("iff", mem(t), mem(t)), "biid", []), mem(t)));
	if (depth > 8) self()
	else switch (t) {
		FolApp(op, args): {
			if (length(args) == 2 && op == "△") {
				// symmetric difference: x ∈ A△B ↔ ¬(x∈A ↔ x∈B), then normalize
				// both memberships and carry the ¬↔ through bibi12i/notbii
				raw = FolNeg(FolBin("iff", mem(args[0]), mem(args[1])));
				un = emit(FolBin("iff", mem(t), raw), "elsymdif", []);
				switch (mizEmitMemNF(steps, v, args[0], depth + 1)) {
					None(): None();
					Some(wa): switch (mizEmitMemNF(steps, v, args[1], depth + 1)) {
						None(): None();
						Some(wb): {
							inner = FolBin("iff", wa.second, wb.second);
							b1 = emit(FolBin("iff", FolBin("iff", mem(args[0]), mem(args[1])), inner),
								"bibi12i", [FolPRefStep(wa.first), FolPRefStep(wb.first)]);
							nf = FolNeg(inner);
							b2 = emit(FolBin("iff", raw, nf), "notbii", [FolPRefStep(b1)]);
							Some(Pair(emit(FolBin("iff", mem(t), nf), "bitri",
								[FolPRefStep(un), FolPRefStep(b2)]), nf));
						}
					}
				}
			}
			else if (mizEmitIsVar(v) && op == "singleton" && length(args) == 1) {
				nf = FolEq(v, args[0]);
				Some(Pair(emit(FolBin("iff", mem(t), nf), "velsn", []), nf));
			}
			else if (mizEmitIsVar(v) && op == "pair" && length(args) == 2) {
				nf = FolBin("or", FolEq(v, args[0]), FolEq(v, args[1]));
				Some(Pair(emit(FolBin("iff", mem(t), nf), "velpr", []), nf));
			}
			else if (mizEmitIsVar(v) && op == "triple" && length(args) == 3) {
				nf = FolBin("or", FolBin("or", FolEq(v, args[0]), FolEq(v, args[1])),
					FolEq(v, args[2]));
				Some(Pair(emit(FolBin("iff", mem(t), nf), "veltp", []), nf));
			}
			else if (mizEmitIsVar(v) && op == "𝒫" && length(args) == 1) {
				nf = mizEmitSs(v, args[0]);
				Some(Pair(emit(FolBin("iff", mem(t), nf), "velpw", []), nf));
			}
			else if (op == "×." && length(args) == 2 && switch (v) {
				FolApp(vf, va): vf == "opair" && length(va) == 2;
				default: false;
			}) {
				// an explicit pair in a product: opelxp, then normalize both
				// component memberships (each with its own element)
				switch (v) {
					FolApp(__, va): {
						raw = FolBin("and", FolPred("∈", [va[0], args[0]]),
							FolPred("∈", [va[1], args[1]]));
						un = emit(FolBin("iff", mem(t), raw), "opelxp", []);
						switch (mizEmitMemNF(steps, va[0], args[0], depth + 1)) {
							None(): None();
							Some(wa): switch (mizEmitMemNF(steps, va[1], args[1], depth + 1)) {
								None(): None();
								Some(wb): {
									nf = FolBin("and", wa.second, wb.second);
									cb = emit(FolBin("iff", raw, nf), "anbi12i",
										[FolPRefStep(wa.first), FolPRefStep(wb.first)]);
									Some(Pair(emit(FolBin("iff", mem(t), nf), "bitri",
										[FolPRefStep(un), FolPRefStep(cb)]), nf));
								}
							}
						}
					}
					default: None();
				}
			}
			else if (length(args) != 2 || (op != "∪" && op != "∩" && op != "∖"))
				switch (mizEmitMemNFDef(steps, v, t)) {
					Some(w): Some(w);
					None(): self();
				}
			else {
				lemma = if (op == "∪") "elun" else if (op == "∩") "elin" else "eldif";
				comb = if (op == "∪") "orbi12i" else "anbi12i";
				body = \na : FolForm, nb : FolForm -> if (op == "∪") FolBin("or", na, nb)
					else if (op == "∩") FolBin("and", na, nb)
					else FolBin("and", na, FolNeg(nb));
				raw = body(mem(args[0]), mem(args[1]));
				un = emit(FolBin("iff", mem(t), raw), lemma, []);
				switch (mizEmitMemNF(steps, v, args[0], depth + 1)) {
					None(): None();
					Some(wa): switch (mizEmitMemNF(steps, v, args[1], depth + 1)) {
						None(): None();
						Some(wb): {
							// the difference's right side sits under a negation
							rb = if (op != "∖") wb
								else Pair(emit(FolBin("iff", FolNeg(mem(args[1])), FolNeg(wb.second)),
									"notbii", [FolPRefStep(wb.first)]), FolNeg(wb.second));
							la = if (op != "∖") wa.second else wa.second;
							nf = if (op == "∪") FolBin("or", wa.second, rb.second)
								else if (op == "∩") FolBin("and", wa.second, rb.second)
								else FolBin("and", la, rb.second);
							cb = emit(FolBin("iff", raw, nf), comb,
								[FolPRefStep(wa.first), FolPRefStep(rb.first)]);
							Some(Pair(emit(FolBin("iff", mem(t), nf), "bitri",
								[FolPRefStep(un), FolPRefStep(cb)]), nf));
						}
					}
				}
			}
		}
		default: self();
	}
}

// unfold `v ∈ f(ā)` through the ARTICLE's own definition of f: the
// instantiated definition iff — built exactly as the ladder's gDefsI channel
// builds it (DefInstance steered at the term, CleanIff, ∀-eliminated at the
// member) — is spliced as a proof block and its conclusion cited like a
// foundation lemma. This is what turns the k-way enum matrices from a
// case-split refutation into a linear biconditional chain. Only an
// UNGUARDED, fact-ref-free instance qualifies; the elimination's
// disjointedness lands in mizEmitNFDjRef for the rewrite's consumer.
// re-state the ELIMINATED (quantifier-free) def instance as an equivalence:
// CleanIff over the block, whose conversion steps join st2. No-op when the
// instance is not the block's last step or nothing changes.
mizEmitNFDefClean(st2 : ref [FolPStep], dj2 : ref [Pair<string, string>],
	fin0 : Pair<FolForm, int>) -> Pair<FolForm, int> {
	if (fin0.second != length(^st2) - 1) fin0
	else {
		d1 = mizEmitCleanIff(MizEmitDrv(fin0.first, ^st2, [], ^dj2));
		if (d1.form == fin0.first) fin0
		else {
			st2 := d1.steps;
			dj2 := d1.disjs;
			Pair(d1.form, length(d1.steps) - 1);
		}
	}
}

// the eliminated def instance as `memF ↔ C`: an iff with memF on a side is
// taken (re-oriented by bicomi); the checker's PAIR shape
// `(memF → X) ∧ (Y ∨ memF)` is assembled by hand — both X (a curried
// implication chain) and ¬Y canonicalize by the ∨-walk, and when they meet
// in the same C the equivalence is impbii of two sylib/sylbi legs. This is
// what CleanIff's internal proof could not do within its caps for the
// k-ary enum definitions.
mizEmitNFDefIff(st2 : ref [FolPStep], memF : FolForm,
	fin : Pair<FolForm, int>) -> Maybe<Pair<int, FolForm>> {
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		st2 := arrayPush(^st2, FolPStep(form, lemma, refs));
		length(^st2) - 1;
	};
	switch (fin.first) {
		FolBin(op2, l2, r2): if (op2 == "iff") {
			if (l2 == memF) Some(Pair(fin.second, r2))
			else if (r2 == memF)
				Some(Pair(emit(FolBin("iff", memF, l2), "bicomi",
					[FolPRefStep(fin.second)]), l2))
			else None();
		} else if (op2 == "and") {
			// the left conjunct in either dialect: `memF → X`, or the raw
			// `¬(memF ∧ Y)` which imnan re-states as `memF → ¬Y`
			left = switch (l2) {
				FolBin(opl, a1, x): if (opl != "imp" || a1 != memF) None()
					else {
						sA0 = emit(FolBin("imp", fin.first, l2), "simpl", []);
						sA = emit(l2, "ax-mp", [FolPRefStep(fin.second), FolPRefStep(sA0)]);
						Some(Pair(sA, x));
					}
				FolNeg(g2): switch (g2) {
					FolBin(opg, a1, y1): if (opg != "and" || a1 != memF) None()
						else {
							sA0 = emit(FolBin("imp", fin.first, l2), "simpl", []);
							sA = emit(l2, "ax-mp", [FolPRefStep(fin.second), FolPRefStep(sA0)]);
							imn = emit(FolBin("iff",
								FolBin("imp", memF, FolNeg(y1)), l2), "imnan", []);
							sImp = emit(FolBin("imp", memF, FolNeg(y1)), "mpbir",
								[FolPRefStep(sA), FolPRefStep(imn)]);
							Some(Pair(sImp, FolNeg(y1)));
						}
					default: None();
				}
				default: None();
			};
			switch (left) {
				None(): None();
				Some(lf): switch (r2) {
					FolBin(opr, y, a2): if (opr != "or" || a2 != memF) None()
					else {
						sB0 = emit(FolBin("imp", fin.first, r2), "simpr", []);
						sB = emit(r2, "ax-mp", [FolPRefStep(fin.second), FolPRefStep(sB0)]);
						cX = mizEmitOrCanon(st2, lf.second);
						cY = mizEmitOrCanon(st2, FolNeg(y));
						if (cX.second != cY.second) None()
						else {
							s1 = emit(FolBin("imp", memF, cX.second), "sylib",
								[FolPRefStep(lf.first), FolPRefStep(cX.first)]);
							p53 = emit(FolBin("imp", r2, FolBin("imp", FolNeg(y), memF)),
								"pm2.53", []);
							sNY = emit(FolBin("imp", FolNeg(y), memF), "ax-mp",
								[FolPRefStep(sB), FolPRefStep(p53)]);
							cc = emit(FolBin("iff", cX.second, FolNeg(y)), "bicomi",
								[FolPRefStep(cY.first)]);
							s2 = emit(FolBin("imp", cX.second, memF), "sylbi",
								[FolPRefStep(cc), FolPRefStep(sNY)]);
							Some(Pair(emit(FolBin("iff", memF, cX.second), "impbii",
								[FolPRefStep(s1), FolPRefStep(s2)]), cX.second));
						}
					}
					default: None();
				}
			}
		} else None();
		default: None();
	}
}

mizEmitMemNFDef(steps : ref [FolPStep], v : FolTerm, t : FolTerm) -> Maybe<Pair<int, FolForm>> {
	memF = FolPred("∈", [v, t]);
	switch (t) {
		FolApp(f, __): if (!mizEmitIsArticleSym(f)) None() else {
			ds0 = (^mizEmitDefsOfSymRef)(f);
			ds = if (length(ds0) > 1) subrange(ds0, 0, 1) else ds0;
			if (ds == []) None() else {
				avoid = ref buildSet(concat(mizEmitTermVars(t), mizEmitTermVars(v)));
				ctr = ref 0;
				stmtOfL = \nm9 : string -> switch ((^mizEmitStmtOfRef)(nm9)) {
					None(): None();
					Some(st9): Some(mizFreshenBound(st9, avoid, ctr));
				};
				dbg9 = ^mizEmitDbg && getUrlParameterDef("dbg-orwalk", "") == "1";
				fold(ds, None(), \ac : Maybe<Pair<int, FolForm>>, nm -> switch (ac) {
					Some(__): ac;
					None(): switch (mizEmitDefInstance(nm, f, [FolPred("$dt", [t])],
							stmtOfL, ^mizEmitShOfRef)) {
						None(): { if (dbg9) println("  NFDEF no-inst " + nm
							+ " @ " + mizEmitTKey(t)); None(); }
						Some(d): {
							if (d.refs != [] || d.steps == []) None()
							else switch (d.form) {
								FolQuant(q, vs, __): if (q != "forall" || length(vs) != 1) {
									if (dbg9) println("  NFDEF bad-prefix " + nm
										+ " :: " + strGlue(folFormToks(d.form), " "));
									None();
								}
								else {
									st2 : ref [FolPStep] = ref d.steps;
									dj2 : ref [Pair<string, string>] = ref d.disjs;
									switch (mizEmitElimAt(st2, dj2, d.form, length(d.steps) - 1,
											vs[0], v, ^mizEmitShOfRef, 0)) {
										None(): { if (dbg9) println("  NFDEF elim-fail " + nm); None(); }
										Some(fin0): {
											// the instance is quantifier-free NOW; the pair
											// shape is assembled by hand, an iff re-oriented
											switch (mizEmitNFDefIff(st2, memF, fin0)) {
												None(): {
													if (dbg9) println("  NFDEF no-iff " + nm
														+ " :: " + strGlue(folFormToks(fin0.first), " "));
													None();
												}
												Some(cv): if (exists(^st2, \cs -> exists(cs.refs, \rr ->
														switch (rr) { FolPRefFact(__): true; default: false; })))
													// a fact reference would dangle in the splice —
													// cannot happen for an axiom-rooted drv, checked anyway
													None()
												else {
													// splice the block; its refs are all local steps
													base = length(^steps);
													iter(^st2, \cs -> {
														steps := arrayPush(^steps, FolPStep(cs.form, cs.assertion,
															map(cs.refs, \rr -> switch (rr) {
																FolPRefStep(k): FolPRefStep(base + k);
																FolPRefFact(k): rr;
															})));
													});
													mizEmitNFDjRef := concat(^mizEmitNFDjRef, ^dj2);
													Some(Pair(base + cv.first, cv.second));
												}
											}
										}
									}
								}
								default: None();
							}
						}
					}
				});
			}
		}
		default: None();
	}
}

// ---- the ∨-TREE WALK: residue equivalence by CITATION, not refutation ----
// The k-way membership residues (`D(v) ↔ NF`, both sides disjunctions of the
// same `v = aᵢ` atoms in different groupings) were decided by G3cp — a case
// split exponential in the leaf count, and the mass driver of the enum
// family. But ∨-tree equality modulo associativity, commutativity and
// idempotence is a CANONICAL FORM: an insertion sort with a proof, each move
// one foundation citation (orass / orcom / or12 / oridm, lifted by
// orbi1i/orbi2i, glued by bitri). Linear in the tree, no context, no split —
// the citation style the size campaign demands ([[proofs-cite-libraries]]).

mizEmitIsOr(f : FolForm) -> bool {
	switch (f) {
		FolBin(op, __, __): op == "or";
		default: false;
	}
}

// |- f ↔ C, C the right-nested, key-sorted, duplicate-free ∨-form. The
// checker's dialect writes disjunctions as curried implications over
// negations, so → (imor), ¬¬ (notnotb) and ¬∧ (ianor) open into ∨ on the
// way — every rung one foundation citation.
mizEmitOrCanon(steps : ref [FolPStep], f : FolForm) -> Pair<int, FolForm> {
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	viaAt = \g : FolForm, s1 : int -> {
		w = mizEmitOrCanon(steps, g);
		if (w.second == g) Pair(s1, g)
		else Pair(emit(FolBin("iff", f, w.second), "bitri",
			[FolPRefStep(s1), FolPRefStep(w.first)]), w.second);
	};
	via = \g : FolForm, lemma : string ->
		viaAt(g, emit(FolBin("iff", f, g), lemma, []));
	switch (f) {
		FolBin(op, l, r): if (op == "or") {
			wl = mizEmitOrCanon(steps, l);
			wr = mizEmitOrCanon(steps, r);
			mid = FolBin("or", wl.second, wr.second);
			base = emit(FolBin("iff", f, mid), "orbi12i",
				[FolPRefStep(wl.first), FolPRefStep(wr.first)]);
			m = mizEmitOrMerge(steps, wl.second, wr.second);
			Pair(emit(FolBin("iff", f, m.second), "bitri",
				[FolPRefStep(base), FolPRefStep(m.first)]), m.second);
		}
		else if (op == "imp") via(FolBin("or", FolNeg(l), r), "imor")
		else Pair(emit(FolBin("iff", f, f), "biid", []), f);
		FolNeg(g): switch (g) {
			FolNeg(h): {
				// notnotb is stated `φ ↔ ¬¬φ` — commute before chaining
				nb = emit(FolBin("iff", h, f), "notnotb", []);
				viaAt(h, emit(FolBin("iff", f, h), "bicomi", [FolPRefStep(nb)]));
			}
			FolBin(opg, gl, gr): if (opg == "and")
					via(FolBin("or", FolNeg(gl), FolNeg(gr)), "ianor")
				else Pair(emit(FolBin("iff", f, f), "biid", []), f);
			default: Pair(emit(FolBin("iff", f, f), "biid", []), f);
		}
		default: Pair(emit(FolBin("iff", f, f), "biid", []), f);
	}
}

// |- (a ∨ b) ↔ M, a and b already canonical
mizEmitOrMerge(steps : ref [FolPStep], a : FolForm, b : FolForm) -> Pair<int, FolForm> {
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	if (!mizEmitIsOr(a)) mizEmitOrIns(steps, a, b)
	else switch (a) {
		FolBin(__, a1, a2): {
			f0 = FolBin("or", a, b);
			g1 = FolBin("or", a1, FolBin("or", a2, b));
			s1 = emit(FolBin("iff", f0, g1), "orass", []);
			m2 = mizEmitOrMerge(steps, a2, b);
			g2 = FolBin("or", a1, m2.second);
			s2 = emit(FolBin("iff", g1, g2), "orbi2i", [FolPRefStep(m2.first)]);
			s12 = emit(FolBin("iff", f0, g2), "bitri",
				[FolPRefStep(s1), FolPRefStep(s2)]);
			m3 = mizEmitOrIns(steps, a1, m2.second);
			Pair(emit(FolBin("iff", f0, m3.second), "bitri",
				[FolPRefStep(s12), FolPRefStep(m3.first)]), m3.second);
		}
		default: mizEmitOrIns(steps, a, b);
	}
}

// |- (x ∨ c) ↔ M, x a leaf, c canonical: insert x at its sorted place
mizEmitOrIns(steps : ref [FolPStep], x : FolForm, c : FolForm) -> Pair<int, FolForm> {
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	kx = mizEmitKey(x);
	f0 = FolBin("or", x, c);
	if (!mizEmitIsOr(c)) {
		kc = mizEmitKey(c);
		if (kx == kc) Pair(emit(FolBin("iff", f0, x), "oridm", []), x)
		else if (kx < kc) Pair(emit(FolBin("iff", f0, f0), "biid", []), f0)
		else {
			g = FolBin("or", c, x);
			Pair(emit(FolBin("iff", f0, g), "orcom", []), g);
		}
	} else switch (c) {
		FolBin(__, h, t): {
			kh = mizEmitKey(h);
			if (kx == kh) {
				// x ∨ (x ∨ t) ↔ (x ∨ x) ∨ t ↔ x ∨ t
				g1 = FolBin("or", FolBin("or", x, x), t);
				sa = emit(FolBin("iff", g1, f0), "orass", []);
				sb = emit(FolBin("iff", f0, g1), "bicomi", [FolPRefStep(sa)]);
				so = emit(FolBin("iff", FolBin("or", x, x), x), "oridm", []);
				g2 = FolBin("or", x, t);
				sc = emit(FolBin("iff", g1, g2), "orbi1i", [FolPRefStep(so)]);
				Pair(emit(FolBin("iff", f0, g2), "bitri",
					[FolPRefStep(sb), FolPRefStep(sc)]), g2);
			} else if (kx < kh)
				Pair(emit(FolBin("iff", f0, f0), "biid", []), f0)
			else {
				g1 = FolBin("or", h, FolBin("or", x, t));
				s1 = emit(FolBin("iff", f0, g1), "or12", []);
				m = mizEmitOrIns(steps, x, t);
				g2 = FolBin("or", h, m.second);
				s2 = emit(FolBin("iff", g1, g2), "orbi2i", [FolPRefStep(m.first)]);
				Pair(emit(FolBin("iff", f0, g2), "bitri",
					[FolPRefStep(s1), FolPRefStep(s2)]), g2);
			}
		}
		default: Pair(emit(FolBin("iff", f0, f0), "biid", []), f0);
	}
}

// ---- the DNF WALK: ∧/∨ residues by the same citation style ----
// The pointwise pair-membership steps (zfmisc_1's ×.-distribution family)
// leave residues like `(p ∨ q) ∧ r ↔ (p ∧ r) ∨ (q ∧ r)` — ∧/∨ DISTRIBUTIONS,
// which the ∨-walk cannot see and G3cp case-splits. The same insertion-sort
// idea extends: canonical form = right-nested key-sorted ∨ of right-nested
// key-sorted ∧, reached by andir/andi (distribution), anass/ancom/an12/anidm
// (the ∧-sort), ioran (¬ over ∨), each move one foundation citation. The
// ∨-level machinery (OrMerge/OrIns) is reused unchanged — a whole conjunction
// is just a leaf under its key.

mizEmitIsAnd(f : FolForm) -> bool {
	switch (f) {
		FolBin(op, __, __): op == "and";
		default: false;
	}
}

// |- (x ∧ c) ↔ M, x a non-∧ leaf, c canonical ∧-form: insert at sorted place
mizEmitAndIns(steps : ref [FolPStep], x : FolForm, c : FolForm) -> Pair<int, FolForm> {
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	kx = mizEmitKey(x);
	f0 = FolBin("and", x, c);
	if (!mizEmitIsAnd(c)) {
		kc = mizEmitKey(c);
		if (kx == kc) Pair(emit(FolBin("iff", f0, x), "anidm", []), x)
		else if (kx < kc) Pair(emit(FolBin("iff", f0, f0), "biid", []), f0)
		else {
			g = FolBin("and", c, x);
			Pair(emit(FolBin("iff", f0, g), "ancom", []), g);
		}
	} else switch (c) {
		FolBin(__, h, t): {
			kh = mizEmitKey(h);
			if (kx == kh) {
				// x ∧ (x ∧ t) ↔ (x ∧ x) ∧ t ↔ x ∧ t
				g1 = FolBin("and", FolBin("and", x, x), t);
				sa = emit(FolBin("iff", g1, f0), "anass", []);
				sb = emit(FolBin("iff", f0, g1), "bicomi", [FolPRefStep(sa)]);
				so = emit(FolBin("iff", FolBin("and", x, x), x), "anidm", []);
				g2 = FolBin("and", x, t);
				sc = emit(FolBin("iff", g1, g2), "anbi1i", [FolPRefStep(so)]);
				Pair(emit(FolBin("iff", f0, g2), "bitri",
					[FolPRefStep(sb), FolPRefStep(sc)]), g2);
			} else if (kx < kh)
				Pair(emit(FolBin("iff", f0, f0), "biid", []), f0)
			else {
				g1 = FolBin("and", h, FolBin("and", x, t));
				s1 = emit(FolBin("iff", f0, g1), "an12", []);
				m = mizEmitAndIns(steps, x, t);
				g2 = FolBin("and", h, m.second);
				s2 = emit(FolBin("iff", g1, g2), "anbi2i", [FolPRefStep(m.first)]);
				Pair(emit(FolBin("iff", f0, g2), "bitri",
					[FolPRefStep(s1), FolPRefStep(s2)]), g2);
			}
		}
		default: Pair(emit(FolBin("iff", f0, f0), "biid", []), f0);
	}
}

// |- (a ∧ b) ↔ M, both canonical ∧-forms
mizEmitAndMerge(steps : ref [FolPStep], a : FolForm, b : FolForm) -> Pair<int, FolForm> {
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	if (!mizEmitIsAnd(a)) mizEmitAndIns(steps, a, b)
	else switch (a) {
		FolBin(__, a1, a2): {
			f0 = FolBin("and", a, b);
			g1 = FolBin("and", a1, FolBin("and", a2, b));
			s1 = emit(FolBin("iff", f0, g1), "anass", []);
			m2 = mizEmitAndMerge(steps, a2, b);
			g2 = FolBin("and", a1, m2.second);
			s2 = emit(FolBin("iff", g1, g2), "anbi2i", [FolPRefStep(m2.first)]);
			s12 = emit(FolBin("iff", f0, g2), "bitri",
				[FolPRefStep(s1), FolPRefStep(s2)]);
			m3 = mizEmitAndIns(steps, a1, m2.second);
			Pair(emit(FolBin("iff", f0, m3.second), "bitri",
				[FolPRefStep(s12), FolPRefStep(m3.first)]), m3.second);
		}
		default: mizEmitAndIns(steps, a, b);
	}
}

// |- (a ∧ b) ↔ D, a and b already canonical DNFs: distribute ∧ over the
// ∨-structure (andir left, andi right), then merge conjunctions
mizEmitDnfDistrib(steps : ref [FolPStep], a : FolForm, b : FolForm) -> Pair<int, FolForm> {
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	f0 = FolBin("and", a, b);
	if (mizEmitIsOr(a)) switch (a) {
		FolBin(__, a1, a2): {
			g1 = FolBin("or", FolBin("and", a1, b), FolBin("and", a2, b));
			s1 = emit(FolBin("iff", f0, g1), "andir", []);
			d1 = mizEmitDnfDistrib(steps, a1, b);
			d2 = mizEmitDnfDistrib(steps, a2, b);
			g2 = FolBin("or", d1.second, d2.second);
			s2 = emit(FolBin("iff", g1, g2), "orbi12i",
				[FolPRefStep(d1.first), FolPRefStep(d2.first)]);
			m = mizEmitOrMerge(steps, d1.second, d2.second);
			s12 = emit(FolBin("iff", f0, g2), "bitri",
				[FolPRefStep(s1), FolPRefStep(s2)]);
			Pair(emit(FolBin("iff", f0, m.second), "bitri",
				[FolPRefStep(s12), FolPRefStep(m.first)]), m.second);
		}
		default: mizEmitAndMerge(steps, a, b);
	}
	else if (mizEmitIsOr(b)) switch (b) {
		FolBin(__, b1, b2): {
			g1 = FolBin("or", FolBin("and", a, b1), FolBin("and", a, b2));
			s1 = emit(FolBin("iff", f0, g1), "andi", []);
			d1 = mizEmitDnfDistrib(steps, a, b1);
			d2 = mizEmitDnfDistrib(steps, a, b2);
			g2 = FolBin("or", d1.second, d2.second);
			s2 = emit(FolBin("iff", g1, g2), "orbi12i",
				[FolPRefStep(d1.first), FolPRefStep(d2.first)]);
			m = mizEmitOrMerge(steps, d1.second, d2.second);
			s12 = emit(FolBin("iff", f0, g2), "bitri",
				[FolPRefStep(s1), FolPRefStep(s2)]);
			Pair(emit(FolBin("iff", f0, m.second), "bitri",
				[FolPRefStep(s12), FolPRefStep(m.first)]), m.second);
		}
		default: mizEmitAndMerge(steps, a, b);
	}
	else mizEmitAndMerge(steps, a, b);
}

// |- f ↔ D, D the canonical DNF; the ∨-walk's dialect openers plus ioran
mizEmitDnfCanon(steps : ref [FolPStep], f : FolForm) -> Pair<int, FolForm> {
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	viaAt = \g : FolForm, s1 : int -> {
		w = mizEmitDnfCanon(steps, g);
		if (w.second == g) Pair(s1, g)
		else Pair(emit(FolBin("iff", f, w.second), "bitri",
			[FolPRefStep(s1), FolPRefStep(w.first)]), w.second);
	};
	via = \g : FolForm, lemma : string ->
		viaAt(g, emit(FolBin("iff", f, g), lemma, []));
	switch (f) {
		FolBin(op, l, r): if (op == "or") {
			wl = mizEmitDnfCanon(steps, l);
			wr = mizEmitDnfCanon(steps, r);
			mid = FolBin("or", wl.second, wr.second);
			base = emit(FolBin("iff", f, mid), "orbi12i",
				[FolPRefStep(wl.first), FolPRefStep(wr.first)]);
			m = mizEmitOrMerge(steps, wl.second, wr.second);
			Pair(emit(FolBin("iff", f, m.second), "bitri",
				[FolPRefStep(base), FolPRefStep(m.first)]), m.second);
		}
		else if (op == "and") {
			wl = mizEmitDnfCanon(steps, l);
			wr = mizEmitDnfCanon(steps, r);
			mid = FolBin("and", wl.second, wr.second);
			base = emit(FolBin("iff", f, mid), "anbi12i",
				[FolPRefStep(wl.first), FolPRefStep(wr.first)]);
			m = mizEmitDnfDistrib(steps, wl.second, wr.second);
			Pair(emit(FolBin("iff", f, m.second), "bitri",
				[FolPRefStep(base), FolPRefStep(m.first)]), m.second);
		}
		else if (op == "imp") via(FolBin("or", FolNeg(l), r), "imor")
		// a biconditional opens into its two-case DNF
		else if (op == "iff") via(FolBin("or", FolBin("and", l, r),
			FolBin("and", FolNeg(l), FolNeg(r))), "dfbi3")
		else Pair(emit(FolBin("iff", f, f), "biid", []), f);
		FolNeg(g): switch (g) {
			FolNeg(h): {
				nb = emit(FolBin("iff", h, f), "notnotb", []);
				viaAt(h, emit(FolBin("iff", f, h), "bicomi", [FolPRefStep(nb)]));
			}
			FolBin(opg, gl, gr): if (opg == "and")
					via(FolBin("or", FolNeg(gl), FolNeg(gr)), "ianor")
				else if (opg == "or")
					via(FolBin("and", FolNeg(gl), FolNeg(gr)), "ioran")
				// ¬(φ↔ψ) becomes (φ↔¬ψ), which the iff case then opens
				else if (opg == "iff")
					via(FolBin("iff", gl, FolNeg(gr)), "xor3")
				else Pair(emit(FolBin("iff", f, f), "biid", []), f);
			default: Pair(emit(FolBin("iff", f, f), "biid", []), f);
		}
		default: Pair(emit(FolBin("iff", f, f), "biid", []), f);
	}
}

// ---- ABSORPTION on the joined DNFs ----
// A lattice identity's two sides reach DNFs equal only modulo absorption
// ((X∪Y)∩(Y∪Z)∩(Z∪X) keeps an a∧b∧c conjunct that a∧b absorbs —
// t25_xboole_1). A conjunct whose atom set strictly CONTAINS another's is
// dropped, and the pruned tree is bridged by two implication proofs:
// each disjunct injects (orc/olc chain) or projects to its absorber first
// (simpl/simpr/jca), folded by jaoi, closed by impbii.

mizEmitOrLeavesL(f : FolForm) -> [FolForm] {
	switch (f) {
		FolBin(op, l, r): if (op == "or") concat([l], mizEmitOrLeavesL(r)) else [f];
		default: [f];
	}
}

mizEmitAndKeysL(f : FolForm) -> Set<string> {
	switch (f) {
		FolBin(op, l, r): if (op == "and")
			mergeSets(makeSet1(mizEmitKey(l)), mizEmitAndKeysL(r))
			else makeSet1(mizEmitKey(f));
		default: makeSet1(mizEmitKey(f));
	}
}

// |- x → lf, lf one of x's ∧-leaves
mizEmitImpLeaf(steps : ref [FolPStep], x : FolForm, lf : FolForm) -> int {
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	if (mizEmitKey(x) == mizEmitKey(lf)) emit(FolBin("imp", x, x), "id", [])
	else switch (x) {
		FolBin(op, x1, xr): if (op != "and") emit(FolBin("imp", x, lf), "id", [])
			else if (mizEmitKey(x1) == mizEmitKey(lf))
				emit(FolBin("imp", x, x1), "simpl", [])
			else {
				s = emit(FolBin("imp", x, xr), "simpr", []);
				h = mizEmitImpLeaf(steps, xr, lf);
				emit(FolBin("imp", x, lf), "syl", [FolPRefStep(s), FolPRefStep(h)]);
			}
		default: emit(FolBin("imp", x, lf), "id", []);
	}
}

// |- x → y, every ∧-leaf of y an ∧-leaf of x
mizEmitImpProj(steps : ref [FolPStep], x : FolForm, y : FolForm) -> int {
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	switch (y) {
		FolBin(op, y1, yr): if (op != "and") mizEmitImpLeaf(steps, x, y)
			else {
				a = mizEmitImpLeaf(steps, x, y1);
				b = mizEmitImpProj(steps, x, yr);
				emit(FolBin("imp", x, y), "jca", [FolPRefStep(a), FolPRefStep(b)]);
			}
		default: mizEmitImpLeaf(steps, x, y);
	}
}

// |- d → t, d a disjunct of the right-nested ∨-tree t
mizEmitImpInj(steps : ref [FolPStep], d : FolForm, t : FolForm) -> int {
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	if (mizEmitKey(t) == mizEmitKey(d)) emit(FolBin("imp", d, d), "id", [])
	else switch (t) {
		FolBin(op, t1, tr): if (op != "or") emit(FolBin("imp", d, t), "id", [])
			else if (mizEmitKey(t1) == mizEmitKey(d))
				emit(FolBin("imp", d, t), "orc", [])
			else {
				h = mizEmitImpInj(steps, d, tr);
				o = emit(FolBin("imp", tr, t), "olc", []);
				emit(FolBin("imp", d, t), "syl", [FolPRefStep(h), FolPRefStep(o)]);
			}
		default: emit(FolBin("imp", d, t), "id", []);
	}
}

// |- t ↔ t' with absorbed conjuncts dropped; None when nothing absorbs
mizEmitOrPrune(steps : ref [FolPStep], t : FolForm) -> Maybe<Pair<int, FolForm>> {
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	leaves = mizEmitOrLeavesL(t);
	if (length(leaves) < 2) None()
	else {
		keySets = map(leaves, mizEmitAndKeysL);
		strictSub = \si : Set<string>, sj : Set<string> ->
			sizeSet(si) < sizeSet(sj)
			&& foldSet(si, true, \ok, k -> ok && containsSet(sj, k));
		absorber = mapi(leaves, \i, __ ->
			foldi(leaves, -1, \j, ac, __2 ->
				if (ac >= 0 || j == i) ac
				else if (strictSub(keySets[j], keySets[i])) j else ac));
		kept = foldi(leaves, [], \i, ac, lf -> if (absorber[i] < 0) arrayPush(ac, lf) else ac);
		if (length(kept) == length(leaves)) None()
		else {
			t2 = fold(reverseA(subrange(kept, 0, length(kept) - 1)),
				kept[length(kept) - 1], \ac, lf -> FolBin("or", lf, ac));
			fwd = mizEmitOrPruneFwd(steps, t, t2, leaves, keySets, absorber);
			bwd = mizEmitOrPruneBwd(steps, t2, t);
			Some(Pair(emit(FolBin("iff", t, t2), "impbii",
				[FolPRefStep(fwd), FolPRefStep(bwd)]), t2));
		}
	}
}

// |- d → t2, absorbed disjuncts projected to their absorber first
mizEmitOrPruneLeaf(steps : ref [FolPStep], d : FolForm, t2 : FolForm,
	leaves : [FolForm], absorber : [int]) -> int {
	i = fold(mapi(leaves, \k, lf -> Pair(k, lf)), -1, \ac, pr ->
		if (ac >= 0) ac
		else if (mizEmitKey(pr.second) == mizEmitKey(d)) pr.first else ac);
	if (i < 0 || absorber[i] < 0) mizEmitImpInj(steps, d, t2)
	else {
		p = mizEmitImpProj(steps, d, leaves[absorber[i]]);
		j = mizEmitImpInj(steps, leaves[absorber[i]], t2);
		steps := arrayPush(^steps, FolPStep(FolBin("imp", d, t2), "syl",
			[FolPRefStep(p), FolPRefStep(j)]));
		length(^steps) - 1;
	}
}

// |- t → t2 over t's ∨-structure (jaoi fold)
mizEmitOrPruneFwd(steps : ref [FolPStep], t : FolForm, t2 : FolForm,
	leaves : [FolForm], keySets : [Set<string>], absorber : [int]) -> int {
	switch (t) {
		FolBin(op, f1, fr): if (op != "or")
				mizEmitOrPruneLeaf(steps, t, t2, leaves, absorber)
			else {
				h1 = mizEmitOrPruneLeaf(steps, f1, t2, leaves, absorber);
				h2 = mizEmitOrPruneFwd(steps, fr, t2, leaves, keySets, absorber);
				steps := arrayPush(^steps, FolPStep(FolBin("imp", t, t2), "jaoi",
					[FolPRefStep(h1), FolPRefStep(h2)]));
				length(^steps) - 1;
			}
		default: mizEmitOrPruneLeaf(steps, t, t2, leaves, absorber);
	}
}

// |- t2 → t: every kept disjunct injects back
mizEmitOrPruneBwd(steps : ref [FolPStep], t2 : FolForm, t : FolForm) -> int {
	switch (t2) {
		FolBin(op, f1, fr): if (op != "or") mizEmitImpInj(steps, t2, t)
			else {
				h1 = mizEmitImpInj(steps, f1, t);
				h2 = mizEmitOrPruneBwd(steps, fr, t);
				steps := arrayPush(^steps, FolPStep(FolBin("imp", t2, t), "jaoi",
					[FolPRefStep(h1), FolPRefStep(h2)]));
				length(^steps) - 1;
			}
		default: mizEmitImpInj(steps, t2, t);
	}
}

// the residue closed by the DNF walk: |- (A ↔ B) when both sides reach the
// same canonical DNF; own buffer, discarded on a miss
mizEmitDnfIff(a : FolForm, b : FolForm) -> Maybe<FolStepProof> {
	shaped = \f : FolForm -> switch (f) {
		FolBin(__, __, __): true;
		FolNeg(__): true;
		default: false;
	};
	if (!shaped(a) && !shaped(b)) None()
	else {
		st2 : ref [FolPStep] = ref [];
		ca0 = mizEmitDnfCanon(st2, a);
		cb0 = mizEmitDnfCanon(st2, b);
		// unequal DNFs may still meet after ABSORPTION pruning
		pruned = \c0 : Pair<int, FolForm>, src : FolForm ->
			if (ca0.second == cb0.second) c0
			else switch (mizEmitOrPrune(st2, c0.second)) {
				None(): c0;
				Some(pr): {
					st2 := arrayPush(^st2, FolPStep(FolBin("iff", src, pr.second), "bitri",
						[FolPRefStep(c0.first), FolPRefStep(pr.first)]));
					Pair(length(^st2) - 1, pr.second);
				}
			};
		ca = pruned(ca0, a);
		cb = pruned(cb0, b);
		if (ca.second != cb.second || length(^st2) > 1200) None()
		else {
			bc = {
				st2 := arrayPush(^st2, FolPStep(FolBin("iff", ca.second, b), "bicomi",
					[FolPRefStep(cb.first)]));
				length(^st2) - 1;
			};
			st2 := arrayPush(^st2, FolPStep(FolBin("iff", a, b), "bitri",
				[FolPRefStep(ca.first), FolPRefStep(bc)]));
			Some(FolStepProof(^st2, [], []));
		}
	}
}

// the residue closed by the walk alone: |- (A ↔ B) when both canonicalize to
// the same form; own buffer, discarded when the walk does not apply
mizEmitOrIff(a : FolForm, b : FolForm) -> Maybe<FolStepProof> {
	if (!mizEmitIsOr(a) && !mizEmitIsOr(b)) None()
	else {
		st2 : ref [FolPStep] = ref [];
		ca = mizEmitOrCanon(st2, a);
		cb = mizEmitOrCanon(st2, b);
		if (ca.second != cb.second || length(^st2) > 600) None()
		else {
			bc = {
				st2 := arrayPush(^st2, FolPStep(FolBin("iff", ca.second, b), "bicomi",
					[FolPRefStep(cb.first)]));
				length(^st2) - 1;
			};
			st2 := arrayPush(^st2, FolPStep(FolBin("iff", a, b), "bitri",
				[FolPRefStep(ca.first), FolPRefStep(bc)]));
			Some(FolStepProof(^st2, [], []));
		}
	}
}

// Is this goal a membership relation between two set terms, at least one of
// them compound? Those are the ones worth rewriting.
mizEmitMemPair(goal : FolForm) -> Maybe<Triple<string, FolTerm, Pair<FolTerm, FolTerm>>> {
	compound = \t : FolTerm -> switch (t) {
		FolApp(op, args):
			(length(args) == 2 && (op == "∪" || op == "∩" || op == "∖" || op == "△"))
			|| op == "singleton" || op == "pair" || op == "triple" || op == "𝒫"
			// an article operator with its own definition unfolds through the
			// instantiated def iff (the enum family's k2..k6)
			|| (mizEmitIsArticleSym(op) && (^mizEmitDefsOfSymRef)(op) != []);
		default: false;
	};
	sides = \l : FolForm, r : FolForm -> switch (l) {
		FolPred(n1, a1): switch (r) {
			FolPred(n2, a2):
				if (n1 != "∈" || n2 != "∈" || length(a1) != 2 || length(a2) != 2) None()
				else if (a1[0] != a2[0]) None()
				else if (!compound(a1[1]) && !compound(a2[1])) None()
				else Some(Pair(a1[0], Pair(a1[1], a2[1])));
			default: None();
		}
		default: None();
	};
	switch (goal) {
		FolBin(op, l, r): if (op != "iff" && op != "imp") None()
			else switch (sides(l, r)) {
				None(): None();
				Some(p): Some(Triple(op, p.first, p.second));
			}
		default: None();
	}
}

// `v ∈ A op v ∈ B` with A or B compound: rewrite both sides to normal form and
// let the reduction prove the propositional residue.
mizEmitMemRewrite(hyps : [FolForm], prev : [FolForm], goal : FolForm,
	op : string, v : FolTerm, a : FolTerm, b : FolTerm,
	maxFacts : int, maxSize : int, depth : int,
	fresh : ref int, used : Set<string>, recDrv : [MizEmitDrv]) -> Maybe<FolStepProof> {
	rw : ref [FolPStep] = ref [];
	djBase = length(^mizEmitNFDjRef);
	switch (mizEmitMemNF(rw, v, a, 0)) {
		None(): None();
		Some(wa): switch (mizEmitMemNF(rw, v, b, 0)) {
			None(): None();
			Some(wb): {
				residue = FolBin(op, wa.second, wb.second);
				// nothing gained if the rewriting changed nothing
				if (residue == goal) None()
				else {
					// the ∨-tree walk first: a residue whose sides canonicalize to
					// the same disjunction closes by citation alone, no refutation
					// the ∨-walk first, then the DNF walk — the ∧/∨ distribution
					// residues the pointwise pair-membership steps leave
					walk = if (op != "iff") None()
						else switch (mizEmitOrIff(wa.second, wb.second)) {
							Some(w9): Some(w9);
							None(): mizEmitDnfIff(wa.second, wb.second);
						};
					if (^mizEmitDbg && getUrlParameterDef("dbg-orwalk", "") == "1")
						println("  ORWALK " + (if (isSome(walk)) "ok" else "miss")
							+ " A=" + strGlue(folFormToks(wa.second), " ")
							+ " || B=" + strGlue(folFormToks(wb.second), " "));
					sub = switch (walk) {
						Some(wp): Pair(Some(wp), false);
						None(): mizEmitReduce(hyps, prev, residue, maxFacts, maxSize,
							depth + 1, fresh, used, recDrv);
					};
					switch (sub.first) {
						None(): None();
						Some(pr): {
							// the rewriting block sits after the residue's proof
							base = length(pr.steps);
							ws = mizEmitShift(^rw, base, 0);
							iA = base + wa.first;
							iB = base + wb.first;
							n0 = base + length(ws);
							join = if (op == "iff") {
								// (A↔NA), (NA↔NB), (B↔NB) ⊢ A↔B
								bc = FolPStep(FolBin("iff", wb.second, FolPred("∈", [v, b])),
									"bicomi", [FolPRefStep(iB)]);
								t1 = FolPStep(FolBin("iff", FolPred("∈", [v, a]), wb.second),
									"bitri", [FolPRefStep(iA), FolPRefStep(base - 1)]);
								t2 = FolPStep(goal, "bitri", [FolPRefStep(n0 + 1), FolPRefStep(n0)]);
								[bc, t1, t2];
							} else {
								// (A↔NA), (NA→NB), (B↔NB) ⊢ A→B
								s1 = FolPStep(FolBin("imp", FolPred("∈", [v, a]), wb.second),
									"sylbi", [FolPRefStep(iA), FolPRefStep(base - 1)]);
								bc = FolPStep(FolBin("iff", wb.second, FolPred("∈", [v, b])),
									"bicomi", [FolPRefStep(iB)]);
								s2 = FolPStep(goal, "sylib", [FolPRefStep(n0), FolPRefStep(n0 + 1)]);
								[s1, bc, s2];
							};
							ndj = length(^mizEmitNFDjRef) - djBase;
							Some(FolStepProof(concatA([pr.steps, ws, join]),
								pr.factRefs, uniq(concat(pr.disjs,
									subrange(^mizEmitNFDjRef, djBase, ndj)))));
						}
					}
				}
			}
		}
	}
}

// ---- the same rewriting, at FORMULA level ----
// A goal or a context fact is rewritten by replacing every membership in a
// compound term with its normal form, carrying the equivalence through the
// connectives (notbii / anbi12i / orbi12i / imbi12i / bibi12i). What reaches
// the proof then mentions only `v ∈ <variable>` atoms, whatever the
// shape of the formula — the mem-pair case above is the special case where the
// formula is a relation between two memberships.

// steps proving |- (f ↔ NF), and NF; None when nothing would change
// ---- THE QUANTIFIER NORMALIZER ----
// Mizar's checker has only ¬ ∧ ∀, so every definition arrives with its
// quantifiers buried under negations: `¬∃x(A ∧ ∀ā¬E)` where the meaning is
// `∀x(A → ∃āE)`. The propositional proof cannot push a negation
// through a quantifier, so the rewrite is done HERE, as a proof: each rung
// is one foundation equivalence (alnex, exnal, iman, imnan, notnotb) lifted
// by congruence (notbii/albii/exbii/anbi12i/...) and glued by bitri. Returns
// the step proving `f ↔ f'` and the normalized f'.
mizEmitQNF(steps : ref [FolPStep], f : FolForm, depth : int) -> Maybe<Pair<int, FolForm>> {
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	chain = \i1 : Pair<int, FolForm>, m2 : Maybe<Pair<int, FolForm>> -> switch (m2) {
		None(): Some(i1);
		Some(i2): Some(Pair(emit(FolBin("iff", f, i2.second), "bitri",
			[FolPRefStep(i1.first), FolPRefStep(i2.first)]), i2.second));
	};
	if (depth > 12) None()
	else switch (f) {
		FolNeg(g): switch (g) {
			// ¬∀vφ ↔ ∃v¬φ (exnal, turned by bicomi), ¬∃vφ ↔ ∀v¬φ (alnex),
			// one binder at a time — a multi-binder node prints the same as the
			// nested single-binder one, so the representation is free
			FolQuant(q, vs, b): {
				v = vs[0];
				rest = if (length(vs) == 1) b else FolQuant(q, tail(vs), b);
				fh = FolNeg(FolQuant(q, [v], rest));
				if (q == "forall") {
					nf0 = FolQuant("exists", [v], FolNeg(rest));
					i0 = emit(FolBin("iff", nf0, fh), "exnal", []);
					i1 = Pair(emit(FolBin("iff", fh, nf0), "bicomi", [FolPRefStep(i0)]), nf0);
					chain(i1, mizEmitQNF(steps, nf0, depth + 1));
				} else {
					nf0 = FolQuant("forall", [v], FolNeg(rest));
					i0 = emit(FolBin("iff", nf0, fh), "alnex", []);
					i1 = Pair(emit(FolBin("iff", fh, nf0), "bicomi", [FolPRefStep(i0)]), nf0);
					chain(i1, mizEmitQNF(steps, nf0, depth + 1));
				}
			}
			// ¬¬φ ↔ φ  (notnotb is `φ ↔ ¬¬φ`, turned by bicomi)
			FolNeg(h): {
				i0 = emit(FolBin("iff", h, f), "notnotb", []);
				i1 = Pair(emit(FolBin("iff", f, h), "bicomi", [FolPRefStep(i0)]), h);
				chain(i1, mizEmitQNF(steps, h, depth + 1));
			}
			FolBin(op2, l2, r2): if (op2 != "and") {
				switch (mizEmitQNF(steps, g, depth + 1)) {
					None(): None();
					Some(w): {
						nf = FolNeg(w.second);
						Some(Pair(emit(FolBin("iff", f, nf), "notbii", [FolPRefStep(w.first)]), nf));
					}
				}
			} else {
				// ¬(φ ∧ ¬ψ) ↔ (φ → ψ)  (iman, turned);  ¬(φ ∧ ψ) ↔ (φ → ¬ψ)  (imnan)
				nf0 = switch (r2) {
					FolNeg(r0): Pair(FolBin("imp", l2, r0), "iman");
					default: Pair(FolBin("imp", l2, FolNeg(r2)), "imnan");
				};
				i0 = emit(FolBin("iff", nf0.first, f), nf0.second, []);
				i1 = Pair(emit(FolBin("iff", f, nf0.first), "bicomi", [FolPRefStep(i0)]), nf0.first);
				chain(i1, mizEmitQNF(steps, nf0.first, depth + 1));
			}
			default: None();
		}
		FolQuant(q, vs, b): {
			// one binder at a time; the multi-binder node prints identically
			v = vs[0];
			rest = if (length(vs) == 1) b else FolQuant(q, tail(vs), b);
			switch (mizEmitQNF(steps, rest, depth + 1)) {
				None(): None();
				Some(w): {
					lem = if (q == "forall") "albii" else "exbii";
					nf = FolQuant(q, [v], w.second);
					Some(Pair(emit(FolBin("iff", FolQuant(q, [v], rest), nf), lem,
						[FolPRefStep(w.first)]), nf));
				}
			}
		}
		FolBin(op, l, r): {
			lem = if (op == "and") "anbi12i" else if (op == "or") "orbi12i"
				else if (op == "imp") "imbi12i" else "bibi12i";
			wl = mizEmitQNF(steps, l, depth + 1);
			wr = mizEmitQNF(steps, r, depth + 1);
			if (isNone(wl) && isNone(wr)) None()
			else {
				il = switch (wl) { Some(w): w; None(): Pair(emit(FolBin("iff", l, l), "biid", []), l); };
				ir = switch (wr) { Some(w): w; None(): Pair(emit(FolBin("iff", r, r), "biid", []), r); };
				nf = FolBin(op, il.second, ir.second);
				Some(Pair(emit(FolBin("iff", f, nf), lem,
					[FolPRefStep(il.first), FolPRefStep(ir.first)]), nf));
			}
		}
		default: None();
	}
}

mizEmitFormNF(steps : ref [FolPStep], f : FolForm, depth : int) -> Maybe<Pair<int, FolForm>> {
	emit = \form : FolForm, lemma : string, refs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(form, lemma, refs));
		length(^steps) - 1;
	};
	if (depth > 8) None()
	else switch (f) {
		FolPred(name, args):
			if (name != "∈" || length(args) != 2) None()
			else switch (args[1]) {
				FolApp(op, as2): if (length(as2) == 2 && (op == "∪" || op == "∩" || op == "∖"))
						mizEmitMemNF(steps, args[0], args[1], 0)
					// an explicit pair in a product opens by opelxp
					else if (op == "×." && length(as2) == 2 && switch (args[0]) {
						FolApp(vf, va): vf == "opair" && length(va) == 2;
						default: false;
					}) mizEmitMemNF(steps, args[0], args[1], 0)
					else None();
				default: None();
			}
		FolNeg(g): switch (mizEmitFormNF(steps, g, depth + 1)) {
			None(): None();
			Some(w): {
				nf = FolNeg(w.second);
				Some(Pair(emit(FolBin("iff", f, nf), "notbii", [FolPRefStep(w.first)]), nf));
			}
		}
		FolBin(op, l, r): {
			lem = if (op == "and") "anbi12i" else if (op == "or") "orbi12i"
				else if (op == "imp") "imbi12i" else "bibi12i";
			wl = mizEmitFormNF(steps, l, depth + 1);
			wr = mizEmitFormNF(steps, r, depth + 1);
			if (isNone(wl) && isNone(wr)) None()
			else {
				il = switch (wl) {
					Some(w): w;
					None(): Pair(emit(FolBin("iff", l, l), "biid", []), l);
				};
				ir = switch (wr) {
					Some(w): w;
					None(): Pair(emit(FolBin("iff", r, r), "biid", []), r);
				};
				nf = FolBin(op, il.second, ir.second);
				Some(Pair(emit(FolBin("iff", f, nf), lem,
					[FolPRefStep(il.first), FolPRefStep(ir.first)]), nf));
			}
		}
		default: None();
	}
}

// The context facts that mention a compound membership, as DERIVED facts in
// normal form: `F` (a hypothesis or an earlier step) gives `NF(F)` by mpbi.
mizEmitCtxNF(ctx : [Pair<FolForm, RuParseRef>]) -> [MizEmitDrv] {
	filtermap(ctx, \p -> {
		steps : ref [FolPStep] = ref [];
		djBase = length(^mizEmitNFDjRef);
		switch (mizEmitFormNF(steps, p.first, 0)) {
			None(): None();
			Some(w): {
				nf = w.second;
				i = {
					steps := arrayPush(^steps, FolPStep(nf, "mpbi",
						[FolPRefFact(0), FolPRefStep(w.first)]));
					length(^steps) - 1;
				};
				ndj = length(^mizEmitNFDjRef) - djBase;
				if (i < 0) None() else Some(MizEmitDrv(nf, ^steps, [p.second],
					uniq(subrange(^mizEmitNFDjRef, djBase, ndj))));
			}
		}
	});
}

// ---- S-C: unfold the definitions the CHECKER expanded ----
// Mizar expands a definition with no `by` reference, so a premise that came
// from one has nothing to cite and the emitter could not build it. The
// expansion record names them per inference (mizDerivPosExpansions), and a
// definition's instance is determined by the step's own atoms: match the
// definiendum against an atom that occurs in the step and every binder is
// fixed. This is what subset_1's open steps are made of — the meaning of
// `Element of`, of `𝒫`, of `⊆` — and no amount of propositional work reaches
// them, because they are type-layer facts Mizar never states.

// Does this atom mention a symbol the ARTICLE defines, rather than only the
// foundation's ∈ / ⊆ / = and its operations? A definition's DEFINIENDUM does,
// and matching on it picks the instance the step is actually about — matching
// on any atom instead let `A = B iff A ⊆ B ∧ B ⊆ A` match everything and
// crowd out the type-guarded definitions.
mizEmitIsArticleSym(nm : string) -> bool {
	!folAmapReused(nm) && nm != "∈" && nm != "⊆" && nm != "=" && nm != "_V";
}

// the ARTICLE symbols a form mentions — those whose meaning comes from a
// definition rather than from the foundation
mizFormSymbols(f : FolForm) -> [string] {
	uniq(filter(concatA(map(mizEmitAtomsOf(f, []), \a -> switch (a) {
		FolPred(n, args): concat([n], concatA(map(args, mizTermSymbols)));
		FolEq(l, r):      concat(mizTermSymbols(l), mizTermSymbols(r));
		default:          [];
	})), mizEmitIsArticleSym));
}

mizTermSymbols(t : FolTerm) -> [string] {
	switch (t) {
		FolApp(n, args): concat([n], concatA(map(args, mizTermSymbols)));
		default: [];
	}
}

mizEmitTermHasArticleSym(t : FolTerm) -> bool {
	switch (t) {
		FolVar(__): false;
		FolAbs(__, __): false;
		FolApp(n, args): mizEmitIsArticleSym(n) || exists(args, mizEmitTermHasArticleSym);
	}
}

mizEmitAtomHasArticleSym(f : FolForm) -> bool {
	switch (f) {
		FolPred(n, args): mizEmitIsArticleSym(n) || exists(args, mizEmitTermHasArticleSym);
		FolEq(l, r): mizEmitTermHasArticleSym(l) || mizEmitTermHasArticleSym(r);
		default: false;
	}
}

// every atom (predicate application or equality) of a formula
mizEmitAtomsOf(f : FolForm, acc : [FolForm]) -> [FolForm] {
	switch (f) {
		FolPred(__, __):     arrayPush(acc, f);
		FolEq(__, __):       arrayPush(acc, f);
		FolNeg(g):           mizEmitAtomsOf(g, acc);
		FolBin(__, l, r):    mizEmitAtomsOf(r, mizEmitAtomsOf(l, acc));
		FolQuant(__, __, b): mizEmitAtomsOf(b, acc);
	}
}

// the instantiated definitions, as derived facts; at most `cap` of them
mizEmitDefUnfolds(named : [Pair<string, string>], stepAtoms : [FolForm],
	stmtOf : (string) -> Maybe<FolForm>, shOf : (string) -> string,
	cap : int) -> [MizEmitDrv] {
	// THE SYMBOL DECIDES. The record says which definition fired and, for a
	// functor's `equals` definition, on which symbol — so the instance is the
	// one whose definiendum is that symbol, matched at the step's occurrence of
	// it. Selection by "some atom matches" let the generic
	// `A = B iff A ⊆ B ∧ B ⊆ A` take every slot.
	symOf = pairs2tree(named);
	names = uniq(map(named, \p -> p.first));
	fold(names, [], \acc : [MizEmitDrv], nm ->
		if (length(acc) >= cap) acc
		else {
			r = mizEmitDefInstance(nm, lookupTreeDef(symOf, nm, ""), stepAtoms, stmtOf, shOf);
			if (getUrlParameterDef("dbg-sel", "") == "1")
				println("SEL " + nm + " sym=" + lookupTreeDef(symOf, nm, "-")
					+ " stmt=" + (if (isSome(stmtOf(nm))) "yes" else "NO")
					+ " inst=" + (if (isSome(r)) "yes" else "no"));
			switch (r) { None(): acc; Some(d): arrayPush(acc, d); }
		});
}

// one definition, instantiated at the step's occurrence of its symbol
mizEmitDefInstance(nm : string, sym : string, stepAtoms : [FolForm],
	stmtOf : (string) -> Maybe<FolForm>, shOf : (string) -> string) -> Maybe<MizEmitDrv> {
	switch (stmtOf(nm)) {
		None(): None();
		Some(st): {
			pre = mizEmitPrefixOf(st, []);
			binders = pre.first;
			if (binders == []) None()
			else {
				metas = buildSet(binders);
				// A FUNCTOR definition is matched at the TERM, not at the atom: it
				// says `f(ā) = …`, while the step says something ABOUT `f(ā)`, so
				// the atoms never correspond. Matching the definiendum against the
				// step's occurrence of that symbol is what fixes the binders —
				// this is the whole reason the record carries the symbol.
				byTerm = if (sym == "") None() else {
					pts = mizEmitDefiendumTerms(pre.second, sym);
					tts = uniq(concatA(map(stepAtoms, \a -> mizEmitSymTerms(a, sym))));
					mizEmitFirstTermMatch(pts, tts, metas, binders);
				};
				// A MEANS-definition (`func f(ā) -> set means x ∈ it iff …`) reads
				// `(v = f(L̄)) ↔ ∀x (x ∈ v ↔ φ)`, and `v` — Mizar's `it` — occurs in no
				// definiendum term, so matching left it unbound and the definition
				// was skipped entirely. It is the TERM THE DEFINITION DEFINES: bound
				// to f(ā) the left side becomes `t = t`, which eqid discharges (the
				// `eqidmp` op). Every enumerated set past a triple is defined so.
				means = mizEmitMeansVar(pre.second, sym, metas);
				byMeans = switch (means) {
					None(): None();
					Some(mv): {
						pts = mizEmitDefiendumTerms(pre.second, sym);
						tts = uniq(concatA(map(stepAtoms, \a -> mizEmitSymTerms(a, sym))));
						rest = filter(binders, \b -> b != mv);
						switch (mizEmitFirstTermMatchAt(pts, tts, metas, rest)) {
							None(): None();
							Some(pr): Some(arrayPush(pr.first, Pair(mv, pr.second)));
						}
					}
				};
				ws0 = switch (byTerm) {
					Some(__): byTerm;
					None(): switch (byMeans) {
						Some(__): byMeans;
						None(): {
							hasSym = \a : FolForm -> sym == "" || mizEmitFormHasSym(a, sym);
							pats = mizEmitRankAtoms(filter(mizEmitAtomsOf(pre.second, []), hasSym));
							tgts = mizEmitRankAtoms(filter(stepAtoms, hasSym));
							mizEmitFirstMatch(pats, tgts, metas, binders);
						}
					}
				};
				ops = if (isNone(byTerm) && isSome(byMeans)) ["eqidmp"] else [];
				switch (ws0) {
					// the plain prefix walk failed — a GUARD-INTERLEAVED
					// definition (`∀R (rel R → ∀X ∀it (rel it → (eq ↔ M)))`,
					// d11_relat_1's shape) keeps its inner loci out of the
					// matchable set; retry with the generalized walk
					None(): mizEmitDefInstanceG(nm, sym, stepAtoms, st, binders, shOf);
					Some(ws): mizEmitRecordDrv(nm, st, ws, ops, shOf);
				}
			}
		}
	}
}

// ---- GUARD-INTERLEAVED INSTANCING ----
// A definition whose loci sit behind nested type guards:
//   ∀R (rel R → ∀X ∀it (rel it → (eq ↔ ∀∀matrix)))
// The generalized walk collects binders THROUGH the guards, stopping at
// the iff core so the matrix binders stay quantified; the assembly
// eliminates each binder UNDER the guards (instance implication composed
// by syl / syl6), and a reflexive means-equation is discharged by
// eqid + mpbi/mpbii (two guards first curried together by `imp`).
mizEmitDefInstanceG(nm : string, sym : string, stepAtoms : [FolForm],
	st : FolForm, plainBinders : [string], shOf : (string) -> string) -> Maybe<MizEmitDrv> {
	gp = mizEmitPrefixGm(st, [], 0);
	if (length(gp.first) <= length(plainBinders) || gp.second > 2) None()
	else {
		metas = buildSet(gp.first);
		pts = mizEmitDefiendumTerms(gp.third, sym);
		tts = uniq(concatA(map(stepAtoms, \a -> mizEmitSymTerms(a, sym))));
		byTerm = mizEmitFirstTermMatch(pts, tts, metas, gp.first);
		ws0 = switch (byTerm) {
			Some(__): byTerm;
			None(): switch (mizEmitMeansVar(gp.third, sym, metas)) {
				None(): None();
				Some(mv): {
					rest = filter(gp.first, \b -> b != mv);
					switch (mizEmitFirstTermMatchAt(pts, tts, metas, rest)) {
						None(): None();
						Some(pr): Some(arrayPush(pr.first, Pair(mv, pr.second)));
					}
				}
			}
		};
		switch (ws0) {
			None(): None();
			Some(ws): mizEmitRecordDrvG(nm, st, ws, shOf);
		}
	}
}

// binders and guard count through the interleaved prefix; the iff core
// (and anything else) stops the walk
mizEmitPrefixGm(f : FolForm, accV : [string], guards : int) -> Triple<[string], int, FolForm> {
	switch (f) {
		FolQuant(q, vs, b): if (q == "forall") mizEmitPrefixGm(b, concat(accV, vs), guards)
			else Triple(accV, guards, f);
		FolBin(op, l, r): if (op == "imp") mizEmitPrefixGm(r, accV, guards + 1)
			else Triple(accV, guards, f);
		default: Triple(accV, guards, f);
	}
}

mizEmitRecordDrvG(premName : string, premise : FolForm,
	wits : [Pair<string, FolTerm>], shOf : (string) -> string) -> Maybe<MizEmitDrv> {
	steps : ref [FolPStep] = ref [FolPStep(premise, premName, [])];
	dj : ref [Pair<string, string>] = ref [];
	wt = pairs2tree(wits);
	switch (mizEmitElimUnder(steps, dj, premise, 0, [], wt, shOf)) {
		None(): None();
		Some(fin): if (length(^steps) <= 1) None()
			else switch (mizEmitMapThmDisjs(premName, \g7 ->
					maybeMap(find(wits, \wp7 -> toLowerCase(wp7.first) == toLowerCase(g7)),
						\wp7 -> wp7.second))) {
				None(): None();
				Some(dps7): Some(MizEmitDrv(fin.first, ^steps, [], uniq(concat(^dj, dps7))));
			}
	}
}

// eliminate the current position's ∀-binders at their witnesses, under the
// accumulated guards; a guard is entered only while an eliminable binder
// remains behind it
mizEmitElimUnder(steps : ref [FolPStep], dj : ref [Pair<string, string>],
	form : FolForm, idx : int, guards : [FolForm], wt : Tree<string, FolTerm>,
	shOf : (string) -> string) -> Maybe<Pair<FolForm, int>> {
	emit = \f9 : FolForm, lemma : string, rs : [FolPRef] -> {
		steps := arrayPush(^steps, FolPStep(f9, lemma, rs));
		length(^steps) - 1;
	};
	reattach = \c : FolForm -> foldr(guards, c, \acc, g -> FolBin("imp", g, acc));
	switch (form) {
		FolQuant(q, vs, b): if (q != "forall") Some(Pair(reattach(form), idx)) else {
			v = vs[0];
			switch (lookupTree(wt, v)) {
				None(): Some(Pair(reattach(form), idx));
				Some(w): switch (mizEmitInstImp(steps, dj, form, v, w, shOf, 0)) {
					None(): None();
					Some(im): {
						ni = if (guards == [])
								emit(im.second, "ax-mp",
									[FolPRefStep(idx), FolPRefStep(im.first)])
							else if (length(guards) == 1)
								emit(FolBin("imp", guards[0], im.second), "syl",
									[FolPRefStep(idx), FolPRefStep(im.first)])
							else
								emit(FolBin("imp", guards[0], FolBin("imp", guards[1], im.second)),
									"syl6", [FolPRefStep(idx), FolPRefStep(im.first)]);
						mizEmitElimUnder(steps, dj, im.second, ni, guards, wt, shOf);
					}
				}
			}
		}
		FolBin(op, l, r): if (op == "imp" && length(guards) < 2
				&& (mizEmitNeedsElim(r, wt) || mizEmitIsReflIff(r)))
				mizEmitElimUnder(steps, dj, r, idx, arrayPush(guards, l), wt, shOf)
			else if (op == "iff") switch (l) {
				FolEq(el, er): if (el != er) Some(Pair(reattach(form), idx)) else {
					// the means-equation became `t = t` — discharge it here so
					// the instance's core is the matrix itself
					e = emit(l, "eqid", []);
					fin = if (guards == [])
							emit(r, "mpbi", [FolPRefStep(e), FolPRefStep(idx)])
						else if (length(guards) == 1)
							emit(FolBin("imp", guards[0], r), "mpbii",
								[FolPRefStep(e), FolPRefStep(idx)])
						else {
							gg = FolBin("and", guards[0], guards[1]);
							c = emit(FolBin("imp", gg, form), "imp", [FolPRefStep(idx)]);
							emit(FolBin("imp", gg, r), "mpbii",
								[FolPRefStep(e), FolPRefStep(c)]);
						};
					Some(Pair((^steps)[fin].form, fin));
				}
				default: Some(Pair(reattach(form), idx));
			}
			else Some(Pair(reattach(form), idx));
		default: Some(Pair(reattach(form), idx));
	}
}

// the walk must still ENTER a final guard whose consequent is the
// reflexive-equation core — nothing behind it needs elimination, but the
// equation is discharged there
mizEmitIsReflIff(f : FolForm) -> bool {
	switch (f) {
		FolBin(op2, l2, __): op2 == "iff" && switch (l2) {
			FolEq(a2, b2): a2 == b2;
			default: false;
		};
		default: false;
	}
}

mizEmitNeedsElim(f : FolForm, wt : Tree<string, FolTerm>) -> bool {
	switch (f) {
		FolQuant(q, vs, b): q == "forall"
			&& (exists(vs, \v -> containsKeyTree(wt, v)) || mizEmitNeedsElim(b, wt));
		FolBin(op, __, r): op == "imp" && mizEmitNeedsElim(r, wt);
		default: false;
	}
}

// Mizar's `it`: the binder the definition equates to the definiendum term and
// that occurs in no argument of it. `(v = f(L̄)) ↔ …` — v is that binder.
mizEmitMeansVar(body : FolForm, sym : string, metas : Set<string>) -> Maybe<string> {
	if (sym == "") None() else fold(mizEmitAtomsOf(body, []), None(), \acc : Maybe<string>, a ->
		switch (acc) {
			Some(__): acc;
			None(): switch (a) {
				FolEq(l, r): {
					v = switch (l) { FolVar(n): if (containsSet(metas, n)) n else ""; default: ""; };
					if (v == "" || !mizEmitTermHasSym(r, sym) || mizEmitTermHas(v, r)) None() else Some(v);
				}
				default: None();
			}
		});
}

// the first (pattern, target) term pair fixing every binder in `binders`, with
// the target kept — the means case needs it as the witness for `it`
mizEmitFirstTermMatchAt(pats : [FolTerm], tgts : [FolTerm], metas : Set<string>,
	binders : [string]) -> Maybe<Pair<[Pair<string, FolTerm>], FolTerm>> {
	fold(pats, None(), \acc : Maybe<Pair<[Pair<string, FolTerm>], FolTerm>>, pat -> switch (acc) {
		Some(__): acc;
		None(): fold(tgts, None(), \a2 : Maybe<Pair<[Pair<string, FolTerm>], FolTerm>>, tt ->
			switch (a2) {
				Some(__): a2;
				None(): switch (mizEmitMatchT(pat, tt, metas, Some(makeTree()))) {
					None(): None();
					Some(sub): {
						ws = filtermap(binders, \b -> switch (lookupTree(sub, b)) {
							None(): None();
							Some(t): Some(Pair(b, t));
						});
						if (length(ws) != length(binders)) None() else Some(Pair(ws, tt));
					}
				}
			});
	});
}

// definiendum-like atoms first
mizEmitRankAtoms(as : [FolForm]) -> [FolForm] {
	concat(filter(as, mizEmitAtomHasArticleSym),
		filter(as, \a -> !mizEmitAtomHasArticleSym(a)));
}

// the first (pattern, target) pair that fixes every binder
mizEmitFirstMatch(pats : [FolForm], tgts : [FolForm], metas : Set<string>,
	binders : [string]) -> Maybe<[Pair<string, FolTerm>]> {
	fold(pats, None(), \acc : Maybe<[Pair<string, FolTerm>]>, pat -> switch (acc) {
		Some(__): acc;
		None(): fold(tgts, None(), \a2 : Maybe<[Pair<string, FolTerm>]>, at -> switch (a2) {
			Some(__): a2;
			None(): mizEmitBinderWits(pat, at, metas, binders);
		});
	});
}

mizEmitBinderWits(pat : FolForm, at : FolForm, metas : Set<string>,
	binders : [string]) -> Maybe<[Pair<string, FolTerm>]> {
	switch (mizEmitMatchF(pat, at, metas, Some(makeTree()))) {
		None(): None();
		Some(sub): {
			ws = filtermap(binders, \b -> switch (lookupTree(sub, b)) {
				None(): None();
				Some(t): Some(Pair(b, t));
			});
			if (length(ws) != length(binders)) None() else Some(ws);
		}
	}
}

// does a formula mention this symbol, in predicate or functor position?
mizEmitTermHasSym(t : FolTerm, sym : string) -> bool {
	switch (t) {
		FolApp(n, args): n == sym || exists(args, \a -> mizEmitTermHasSym(a, sym));
		default: false;
	}
}

mizEmitFormHasSym(f : FolForm, sym : string) -> bool {
	switch (f) {
		FolPred(n, args): n == sym || exists(args, \a -> mizEmitTermHasSym(a, sym));
		FolEq(l, r):      mizEmitTermHasSym(l, sym) || mizEmitTermHasSym(r, sym);
		FolNeg(g):        mizEmitFormHasSym(g, sym);
		FolBin(__, l, r): mizEmitFormHasSym(l, sym) || mizEmitFormHasSym(r, sym);
		FolQuant(__, __, b): mizEmitFormHasSym(b, sym);
	}
}

// ---- discharging a TYPE GUARD ----
// A Mizar definition on a soft type is stated under its guard:
//   d4_subset_1 : ∀X ∀A ( A is Element of 𝒫 X → (X ∖ A) = … )
// so its instance arrives as `G → C` and the proof can do nothing with
// it: what the step needs is C, and the equality bridges only harvest an
// equation that stands on its own. When the guard is already in the context —
// a hypothesis of the theorem or an earlier step, which is where a Mizar `let`
// puts it — it is discharged here by ax-mp, and the definition's conclusion
// becomes an ordinary fact.
// A guard the context does NOT carry is usually not a premise at all but a
// TYPE fact — `{}E is Element of bool E`. Mizar never states it in a proof
// because the constructor's own type says it, and the translated article now
// says it too (mizArticleConstrTypes), so the guard is DERIVED here from an
// environment statement and its derivation is spliced in before the ax-mp.
mizEmitDischarge(d : MizEmitDrv, ctx : [Pair<FolForm, RuParseRef>],
	proveGuard : (FolForm) -> [MizEmitDrv]) -> MizEmitDrv {
	if (d.steps == []) d else {
		steps : ref [FolPStep] = ref d.steps;
		refs : ref [RuParseRef] = ref d.refs;
		disjs : ref [Pair<string, string>] = ref d.disjs;
		fin = mizEmitPeel(steps, refs, disjs, d.form, length(d.steps) - 1, ctx, proveGuard, 2);
		if (length(^steps) == length(d.steps)) d
		else {
			mizEmitDischarged := ^mizEmitDischarged + 1;
			MizEmitDrv(fin.first, ^steps, ^refs, uniq(^disjs));
		}
	}
}

// Peel `G → C` off the statement proved at step `idx`, discharging each G by
// ax-mp; returns the statement reached and the step that proves it. At most a
// few guards — a Mizar definition carries one per locus.
mizEmitPeel(steps : ref [FolPStep], refs : ref [RuParseRef],
	disjs : ref [Pair<string, string>], form0 : FolForm, idx0 : int,
	ctx : [Pair<FolForm, RuParseRef>], proveGuard : (FolForm) -> [MizEmitDrv],
	depth : int) -> Pair<FolForm, int> {
	form = ref form0;
	idx = ref idx0;
	go = ref true;
	fori(0, 3, \__ -> if (^go) {
		switch (^form) {
			FolBin(op, l, r): if (op != "imp") go := false else {
				switch (mizEmitMinor(steps, refs, disjs, l, ctx, proveGuard, depth)) {
					None(): go := false;
					Some(mref): {
						steps := arrayPush(^steps, FolPStep(r, "ax-mp", [mref, FolPRefStep(^idx)]));
						idx := length(^steps) - 1;
						form := r;
					}
				}
			}
			default: go := false;
		}
	});
	Pair(^form, ^idx);
}

// A reference to a proof of `g`: a context formula is cited directly, a
// CONJUNCTION of provable guards is joined by pm3.2i (a constructor with two
// typed arguments states its type under both), and anything else is derived
// from an environment statement — whose own guards are peeled the same way,
// because a functor's type holds only for arguments of the right type. On
// failure the appended steps are rolled back, so a block never carries a
// half-built derivation.
mizEmitMinor(steps : ref [FolPStep], refs : ref [RuParseRef],
	disjs : ref [Pair<string, string>], g : FolForm,
	ctx : [Pair<FolForm, RuParseRef>], proveGuard : (FolForm) -> [MizEmitDrv],
	depth : int) -> Maybe<FolPRef> {
	if (getUrlParameterDef("dbg-guard", "") == "1")
		println("GUARD-WANT d=" + i2s(depth) + " " + strGlue(folFormToks(g), " "));
	switch (find(ctx, \p -> p.first == g)) {
		Some(p): {
			k = length(^refs);
			refs := arrayPush(^refs, p.second);
			Some(FolPRefFact(k));
		}
		None(): if (depth <= 0) None() else {
			s0 = ^steps; r0 = ^refs; d0 = ^disjs;
			roll = \ -> { steps := s0; refs := r0; disjs := d0; None(); };
			conj = switch (g) {
				FolBin(op, a, b): if (op == "and") Some(Pair(a, b)) else None();
				default: None();
			};
			switch (conj) {
				Some(ab): switch (mizEmitMinor(steps, refs, disjs, ab.first, ctx, proveGuard, depth - 1)) {
					None(): roll();
					Some(r1): switch (mizEmitMinor(steps, refs, disjs, ab.second, ctx, proveGuard, depth - 1)) {
						None(): roll();
						Some(r2): {
							steps := arrayPush(^steps, FolPStep(g, "pm3.2i", [r1, r2]));
							Some(FolPRefStep(length(^steps) - 1));
						}
					}
				}
				None(): fold(proveGuard(g), None(), \acc : Maybe<FolPRef>, drv -> switch (acc) {
					Some(__): acc;
					None(): if (drv.steps == []) None() else {
						dS = length(^steps); dF = length(^refs);
						steps := concat(^steps, mizEmitShift(drv.steps, dS, dF));
						refs := concat(^refs, drv.refs);
						disjs := concat(^disjs, drv.disjs);
						p = mizEmitPeel(steps, refs, disjs, drv.form, length(^steps) - 1,
							ctx, proveGuard, depth - 1);
						if (p.first == g) Some(FolPRefStep(p.second)) else roll();
					}
				})
			}
		}
	}
}

// the definiendum terms of a definition: the applications of `sym` in it
mizEmitDefiendumTerms(f : FolForm, sym : string) -> [FolTerm] {
	concatA(map(mizEmitAtomsOf(f, []), \a -> mizEmitSymTerms(a, sym)));
}

// every subterm of an atom that applies `sym`
mizEmitSymTermsT(t : FolTerm, sym : string, acc : [FolTerm]) -> [FolTerm] {
	switch (t) {
		FolApp(n, args): {
			a2 = fold(args, acc, \ac, a -> mizEmitSymTermsT(a, sym, ac));
			if (n == sym) arrayPush(a2, t) else a2;
		}
		default: acc;
	}
}

mizEmitSymTerms(f : FolForm, sym : string) -> [FolTerm] {
	switch (f) {
		FolPred(__, args): fold(args, [], \ac, a -> mizEmitSymTermsT(a, sym, ac));
		FolEq(l, r):       mizEmitSymTermsT(r, sym, mizEmitSymTermsT(l, sym, []));
		default:           [];
	}
}

mizEmitFirstTermMatch(pats : [FolTerm], tgts : [FolTerm], metas : Set<string>,
	binders : [string]) -> Maybe<[Pair<string, FolTerm>]> {
	fold(pats, None(), \acc : Maybe<[Pair<string, FolTerm>]>, pat -> switch (acc) {
		Some(__): acc;
		None(): fold(tgts, None(), \a2 : Maybe<[Pair<string, FolTerm>]>, tt -> switch (a2) {
			Some(__): a2;
			None(): switch (mizEmitMatchT(pat, tt, metas, Some(makeTree()))) {
				None(): None();
				Some(sub): {
					ws = filtermap(binders, \b -> switch (lookupTree(sub, b)) {
						None(): None();
						Some(t): Some(Pair(b, t));
					});
					if (length(ws) != length(binders)) None() else Some(ws);
				}
			}
		});
	});
}

// the i-th ∀-binder of a prefix (nested single- or multi-binder nodes), or ""
mizEmitBinderAt(f : FolForm, i : int) -> string {
	switch (f) {
		FolQuant(q, vs, b): if (q != "forall") "" else {
			if (i < length(vs)) vs[i] else mizEmitBinderAt(b, i - length(vs));
		}
		default: "";
	}
}

// every FolEq node of a form's propositional skeleton (never under a
// quantifier — those equations carry bound variables)
mizEmitEqAtoms(f : FolForm, acc : [FolForm]) -> [FolForm] {
	switch (f) {
		FolEq(__, __): arrayPush(acc, f);
		FolNeg(g): mizEmitEqAtoms(g, acc);
		FolBin(__, l, r): mizEmitEqAtoms(r, mizEmitEqAtoms(l, acc));
		default: acc;
	}
}

mizEmitSetThmDisjs(name : string, groups : [[string]]) -> void {
	mizEmitThmDisjsRef := setTree(^mizEmitThmDisjsRef, name, groups);
}

// map a cited assertion's declared disjointedness groups through the
// instantiation — Metamath's DV semantics: a member substituted by a
// COMPOUND term contributes all the term's variables (a ground term
// contributes none; an unmapped member keeps its own name), and the
// requirement becomes every cross pair between two members' variable
// sets, declared on the citing theorem. Only a variable actually SHARED
// between two members makes the citation illegal (decline).
mizEmitMapThmDisjs(name : string, wsub : (string) -> Maybe<FolTerm>) -> Maybe<[Pair<string, string>]> {
	fold(lookupTreeDef(^mizEmitThmDisjsRef, name, []), Some([]),
		\ac7 : Maybe<[Pair<string, string>]>, grp -> switch (ac7) {
			None(): None();
			Some(ps7): {
				vs7 : [[string]] = map(grp, \g7 -> switch (wsub(g7)) {
					None(): [toLowerCase(g7)];
					Some(tv): uniq(map(mizEmitTermVars(tv), toLowerCase));
				});
				pairs7 = concatA(mapi(vs7, \i7, a7 ->
					concatA(map(subrange(vs7, i7 + 1, length(vs7) - i7 - 1),
						\b7 -> concatA(map(a7, \x7 -> map(b7, \y7 -> Pair(x7, y7))))))));
				if (exists(pairs7, \p7 -> p7.first == p7.second)) None()
				else Some(concat(ps7, pairs7));
			}
		});
}
