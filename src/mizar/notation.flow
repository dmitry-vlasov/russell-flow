import mizar/xml;
import mizar/atr;
import ds/tree;
import ds/set;
import string;
import math/math;

// Resolve a constructor to its human notation symbol via the Mizar tables:
//   .eno (Notations: constructor -> formatnr)  ->  .frm (Formats: formatnr -> symbolnr)
//   ->  .dcx (Symbols: symbolnr -> name, e.g. "in", "object", "union").
// We only adopt CLEAN-WORD symbols (in/object/union/empty/misses/…) as readable Russell
// names; operator symbols (c=, \/, /\, …) aren't identifier-safe, so those keep their
// mechanical MPTP names. mizFullSig folds the result into MizSig.readable.

export {
	MizSymbols(dcx : Tree<string, string>, frm : Tree<int, MizFmt>, eno : Tree<string, int>);
		// one .frm <Format>: the symbol kind, its number, the CLOSING bracket's
		// number (0 = not a bracket) and the argument count
		MizFmt(kind : string, symbolnr : int, rightsymbolnr : int, argnr : int);

	mizParseNotation(enoC : string, frmC : string, dcxC : string) -> MizSymbols;
	mizFullSig(xmlC : string, atrC : string, enoC : string, frmC : string, dcxC : string) -> MizSig;
	mizSymbolReadable(syms : MizSymbols, constrkind : string, aid : string, absNr : int, relNr : int) -> string;
	// An article's own constructors -> (surface symbol, arity), "<kind>:<nr>" -> (spelling, arity)
	// (e.g. "K:5" -> ("\+\", 2)). Built by joining the .xml definitions to the .msx definiendum
	// patterns by line; numbering is the article's OWN local constructor number (= def order).
	mizSpellingMap(xmlC : string, msxC : string) -> Tree<string, Pair<string, int>>;
	// Identifier-safe Russell name for a Mizar operator spelling (\/ -> cup, c= -> subset),
	// "" if not a recognised operator (then the symbol keeps its mechanical MPTP name).
	mizOpName(spelling : string) -> string;
	// Name for a bracket functor, disambiguated by arity ({ } 1 -> singleton, { } 2 -> pair,
	// [ ] 2 -> opair). Russell's { } are structural, so a prefix name is used, not the bracket.
	mizBracketName(spelling : string, arity : int) -> string;
	// Is this one of the names mizBracketName produces? Bracket SYMBOLS are not
	// in any article's .dcx (`{`/`}` come with the language, not with a
	// vocabulary), so the .eno/.frm/.dcx chain can never see them and the global
	// name table must not hand these words to some other constructor.
	mizIsBracketName(name : string) -> bool;
	// The Russell name for a Mizar symbol given its (spelling, arity): the math symbol for an
	// operator (∪/⊆/…), the bracket name (singleton/pair/opair), or the clean word (union/in/…);
	// "" when none applies (then keep the MPTP name).
	mizSymbolName(spelling : string, arity : int) -> string;
}

mizParseNotation(enoC : string, frmC : string, dcxC : string) -> MizSymbols {
	dcx = mizFoldTagged(dcxC, "Symbols", "Symbol", makeTree(), \acc, sym ->
		setTree(acc, mizAttr(sym, "kind") + ":" + mizAttr(sym, "nr"), mizAttr(sym, "name")));
	frm = mizFoldTagged(frmC, "Formats", "Format", makeTree(), \acc, fm ->
		setTree(acc, s2i(mizAttr(fm, "nr")), MizFmt(mizAttr(fm, "kind"),
			s2i(mizAttr(fm, "symbolnr")), s2i(mizAttr(fm, "rightsymbolnr")),
			s2i(mizAttr(fm, "argnr")))));
	// An ANTONYMIC pattern spells the constructor's NEGATION (`nin` for ∈, `<>`
	// for =), so it must never supply the constructor's name — three articles
	// ended up declaring a relation called `nin`. Of the remaining patterns the
	// FIRST one wins: a later synonym is an alternative spelling, not a
	// replacement, and letting it overwrite made the name depend on file order.
	eno = mizFoldTagged(enoC, "Notations", "Pattern", makeTree(), \acc, p -> {
		key = mizAttr(p, "constrkind") + ":" + mizAttr(p, "aid") + ":" + mizAttr(p, "constrnr");
		if (mizAttr(p, "antonymic") == "true" || containsKeyTree(acc, key)) acc
		else setTree(acc, key, s2i(mizAttr(p, "formatnr")));
	});
	MizSymbols(dcx, frm, eno);
}

mizFoldTagged(content : string, root : string, tag : string, init : ?, fn : (?, MizXml) -> ?) -> ? {
	switch (mizParseXml(content)) {
		None(): init;
		Some(r): {
			node = if (r.tag == root) Some(r) else mizFindFirst(r.kids, root);
			switch (node) { None(): init; Some(n): fold(mizKidsTagged(n, tag), init, fn); }
		}
	}
}

mizFullSig(xmlC : string, atrC : string, enoC : string, frmC : string, dcxC : string) -> MizSig {
	sig0 = mizParseAtr(atrC);
	// Merge the article's OWN constructors — declared inline in its XML (with relnr = the
	// body index), NOT in the .atr (which lists only the imported environment). Without
	// this, an article's self-defined symbols (xboole_0's ∪/∩/\…) resolve to *_unresolved.
	table = switch (mizParseXml(xmlC)) {
		None(): sig0.table;
		Some(root): fold(mizCollectAll([root], "Constructor"), sig0.table, mizAddConstr);
	};
	syms = mizParseNotation(enoC, frmC, dcxC);
	// The table key is "<kind>:<relnr>" — the ENVIRONMENT index — and that is
	// exactly what a .eno <Pattern> names its constructor by (`constrnr`), NOT
	// the constructor's number inside its defining article. Looking the pattern
	// up by the absolute nr read another constructor's notation (TARSKI's four
	// functors are relnr 81..84 in numbers.atr) and gave a word that changed
	// with the article.
	byKey = foldTree(table, makeTree(), \key, c, acc -> {
		parts = strSplit(key, ":");
		kind = parts[0];
		r = mizSymbolReadable(syms, kind, c.aid, c.nr, s2i(parts[1]));
		if (r == "") acc else setTree(acc, key, r);
	});
	// A CONSTRUCTOR's name, not a key's. The same constructor sits under several
	// table keys (a redefinition aliases HIDDEN's ∈ into TARSKI's entry) and only
	// one of them carries a notation pattern; naming just that key left the other
	// keys mechanical, so one article used both `∈` and `r2_hidden` and its
	// importers declared the constant twice.
	nameOfCtor = foldTree(byKey, makeTree(), \k, v, acc -> {
		cn = switch (lookupTree(table, k)) {
			Some(c): mizConstrName(strSplit(k, ":")[0], c);
			None(): k;
		};
		if (containsKeyTree(acc, cn)) acc else setTree(acc, cn, v);
	});
	readable0 = foldTree(table, makeTree(), \key, c, acc -> {
		cn = mizConstrName(strSplit(key, ":")[0], c);
		switch (lookupTree(nameOfCtor, cn)) {
			None(): acc;
			Some(v): setTree(acc, key, v);
		}
	});
	// Drop readable names that resolve from more than one constructor (would create
	// duplicate Russell rule names). Count DISTINCT constructors, not table keys — a
	// redefinition alias makes the same constructor reachable from two keys, and that
	// must not disqualify its name.
	counts = foldTree(readable0, makeTree(), \k, v, acc -> {
		cn = switch (lookupTree(table, k)) {
			Some(c): mizConstrName(strSplit(k, ":")[0], c);
			None(): k;
		};
		setTree(acc, v, insertSet(lookupTreeDef(acc, v, makeSet()), cn));
	});
	readable = filterTree(readable0, \k, v -> sizeSet(lookupTreeDef(counts, v, makeSet())) == 1);
	MizSig(table, readable);
}

// `absNr` is the constructor's number inside its DEFINING article (the one the
// mechanical name k<nr>_<aid> uses); `relNr` is its index in THIS article's
// environment. The .eno patterns are keyed by the latter — the two differ from
// the first import on — so the lookup takes relNr and only HIDDEN's unnamed
// base modes are decided by absNr.
mizSymbolReadable(syms : MizSymbols, constrkind : string, aid : string, absNr : int, relNr : int) -> string {
	// HIDDEN's two base modes are the universal primitives; `set` has no .dcx notation
	// (it's the implicit base), so name them directly.
	if (aid == "HIDDEN" && constrkind == "M") {
		mizReadableWord(if (absNr == 1) "object" else if (absNr == 2) "set" else "");
	} else
	switch (lookupTree(syms.eno, constrkind + ":" + aid + ":" + i2s(relNr))) {
		None(): "";
		Some(fnr): switch (lookupTree(syms.frm, fnr)) {
			None(): "";
			Some(fmt): mizSymbolName(mizFormatSpelling(syms, fmt), fmt.argnr);
		}
	}
}

// The SPELLING a format displays. The format kind IS the symbol kind in .dcx:
// "O" is an ordinary functor symbol, "R"/"M"/"V"/"G"/"U" their own kinds, and a
// format carrying a rightsymbolnr is a BRACKET whose halves are a "K" and an "L"
// symbol ("{" + "}" -> "{ }"). Reading a bracket as an "O" functor returned an
// unrelated word, and since .dcx numbering is per article the word then changed
// with the article. Rendering the full spelling makes this path agree with the
// .msx one, so operators and brackets get their real names (∪, singleton) here
// too — which is what lets the name table cover them.
mizFormatSpelling(syms : MizSymbols, fmt : MizFmt) -> string {
	if (fmt.rightsymbolnr > 0)
		trim2(lookupTreeDef(syms.dcx, "K:" + i2s(fmt.symbolnr), "") + " "
			+ lookupTreeDef(syms.dcx, "L:" + i2s(fmt.rightsymbolnr), ""), " ")
	else lookupTreeDef(syms.dcx, fmt.kind + ":" + i2s(fmt.symbolnr), "");
}

// A symbol is adopted only if it's a clean identifier word; `set`/`wff` collide with
// Russell type keywords, so they get a trailing underscore.
mizReadableWord(raw : string) -> string {
	if (raw == "" || !mizCleanWord(raw)) ""
	else {
		base = toLowerCase(raw);
		if (containsSet(mizRussellReserved, base)) base + "_" else base;
	}
}

// Every RESERVED WORD of the .ru grammar (src/ru/parse/russell.lingo) plus the declared
// TYPE names. A Mizar symbol that collides with one is not merely ugly — the article does
// not PARSE, and one bad name costs the whole article. Mizar really does spell notions
// this way: `class` is its equivalence-class functor (matrix_0, topreal7), and `set`/`wff`
// were already special-cased here for the same reason.
mizRussellReserved : Set<string> = buildSet([
	// grammar keywords
	"ascii", "axiom", "congruence", "constant", "defiendum", "definiens", "definition",
	"disjointed", "hyp", "import", "latex", "lemma", "meta", "proof", "prop", "rule",
	"step", "symbol", "term", "theorem", "type",
	// declared types
	"wff", "class", "setvar", "set",
]);

mizCleanWord(s : string) -> bool {
	n = strlen(s);
	if (n == 0) false
	else {
		c0 = getCharCodeAt(s, 0);
		if (!((c0 >= 97 && c0 <= 122) || (c0 >= 65 && c0 <= 90))) false
		else mizAllIdent(s, 1, n);
	}
}

mizAllIdent(s : string, i : int, n : int) -> bool {
	if (i >= n) true
	else {
		c = getCharCodeAt(s, i);
		// '-' is allowed INSIDE the word: Mizar spells most of its attributes with
		// one (Relation-like, non-empty, empty-yielding), and rejecting it sent
		// every such attribute to its mechanical MPTP name (v1_relat_1), which is
		// unreadable. The .ru grammar takes a hyphen in a symbol; the derived rule
		// id slugs it to '_' (folRuleId). The first character must still be a
		// letter, so Mizar's suffix spellings (-valued, -defined) stay mechanical.
		if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57)
			|| c == 95 || (c == 45 && i + 1 < n)) mizAllIdent(s, i + 1, n)
		else false;
	}
}

// ---- surface symbol spellings from the analyzed syntax (.msx) ----

// "<kind>:<nr>" -> spelling for an article's OWN constructors. The .msx carries the
// definiendum patterns (<Operation-Functor-Pattern spelling="\/">, <Predicate-Pattern …>,
// …) with their .miz line; the .xml carries the real definitions (redefinitions have no
// line) in constructor order. We join them by line: the i-th line-bearing Definition of a
// kind is that article's constructor nr i, and its spelling is the .msx pattern sitting on
// (or just before) the Definition's line.
mizSpellingMap(xmlC : string, msxC : string) -> Tree<string, Pair<string, int>> {
	// a functor can be prefix/infix (Operation-Functor-Pattern) or a bracket like { }, [ ]
	// (Bracket-Functor-Pattern) — both are kind K and interleave by line.
	patKinds = [Pair("K", "Operation-Functor-Pattern"), Pair("K", "Bracket-Functor-Pattern"),
		Pair("R", "Predicate-Pattern"), Pair("V", "Attribute-Pattern"), Pair("M", "Mode-Pattern")];
	// each pattern -> (line, (spelling, arity)); arity = number of <Locus> in the pattern.
	msxPats = fold(patKinds, makeTree(), \acc, pk ->
		setTree(acc, pk.first, concat(lookupTreeDef(acc, pk.first, []), map(mizCollectTagFrom(msxC, pk.second),
			\n -> Pair(s2i(mizAttr(n, "line")), Pair(mizPatternSpelling(n), length(mizCollectAll([n], "Locus"))))))));
	// ALL definitions in document order, redefinitions included — each creates a constructor,
	// so the i-th definition of a kind is that article's constructor nr i. A redefinition has no
	// line (so no surface symbol) but must still advance the counter to keep nr aligned.
	defs = mizCollectTagFrom(xmlC, "Definition");
	foldi(defs, Pair(makeTree(), makeTree()), \__, acc, d -> {
		kind   = mizAttr(d, "kind");
		counts = acc.first;
		nr     = lookupTreeDef(counts, kind, 0) + 1;
		sa     = mizPatternAtLine(lookupTreeDef(msxPats, kind, []), s2i(mizAttr(d, "line")));
		Pair(setTree(counts, kind, nr),
			if (sa.first == "") acc.second else setTree(acc.second, kind + ":" + i2s(nr), sa));
	}).second;
}

// (spelling, arity) of the pattern with the greatest line <= `line` (the definiendum is on
// or just before the Definition's body line).
mizPatternAtLine(pats : [Pair<int, Pair<string, int>>], line : int) -> Pair<string, int> {
	fold(pats, Pair(-1, Pair("", 0)), \best, p -> if (p.first <= line && p.first > best.first) p else best).second;
}

mizBracketName(spelling : string, arity : int) -> string {
	// A bracket functor's spelling ({ }, [ ], [: :]) says nothing about how many
	// slots it has, so the name has to carry the arity. The English words run out
	// at ten, which is exactly where ENUMSET1 stops.
	tuple = ["", "singleton", "pair", "triple", "quadruple", "quintuple",
		"sextuple", "septuple", "octuple", "nonuple", "decuple"];
	if (spelling == "{ }" && arity >= 1 && arity <= 10) tuple[arity]
	else if (spelling == "[ ]" && arity == 2) "opair"       // ordered pair [ x, y ]
	else if (spelling == "[ ]" && arity >= 3 && arity <= 10) "o" + tuple[arity]
	else if (spelling == "[: :]" && arity == 2) "×."        // binary cartesian [: X, Y :] → foundation cxp ( A ×. B )
	else if (spelling == "[: :]" && arity >= 3) "×." + i2s(arity)
	else "";
}

mizIsBracketName(name : string) -> bool {
	exists(["singleton", "pair", "triple", "opair", "×."], \s -> s == name);
}

mizSymbolName(spelling0 : string, arity : int) -> string {
	// the .dcx spellings still carry XML entities (&#x60; for `, &#x22; for ")
	spelling = mizDecodeEntities(spelling0);
	op = mizOpName(spelling);
	if (op != "") op
	else {
		br = mizBracketName(spelling, arity);
		if (br != "") br
		else {
			w = mizReadableWord(spelling);
			if (w != "") w
			else {
				// Mizar spells its suffix attributes with a leading hyphen
				// (-defined, -valued, X-valued). As a PREFIX symbol the hyphen
				// is noise, and `defined X` reads the way the Mizar does.
				st = if (startsWith(spelling, "-"))
					mizReadableWord(substring(spelling, 1, strlen(spelling) - 1)) else "";
				if (st != "") st
				// an operator spelled in punctuation (~, |, .:, (#), [#], `, ")
				// IS the readable Mizar notation — far better than k7_relat_1
				else mizPunctSymbol(spelling);
			}
		}
	}
}

// A spelling made only of symbol characters is used verbatim. Anything with a
// SPACE is a bracket pair whose arity mizBracketName did not name (never a
// symbol), and the .ru separators (`,` `;`) would split the token.
mizPunctSymbol(s : string) -> string {
	if (s == "" || containsSet(mizRussellReserved, s)) ""
	else {
		ok = ref true;
		fori(0, strlen(s) - 1, \i -> {
			c = getCharCodeAt(s, i);
			if (c <= 32 || c == 44 || c == 59 || c > 126) ok := false;
		});
		if (^ok) s else "";
	}
}

mizCollectTagFrom(content : string, tag : string) -> [MizXml] {
	switch (mizParseXml(content)) { None(): []; Some(r): mizCollectAll([r], tag); }
}

// The displayed spelling of a definiendum pattern; a bracket functor carries its closing
// bracket as a <Right-Circumflex-Symbol> child, so render it as "{ }", "[ ]", etc.
mizPatternSpelling(n : MizXml) -> string {
	left = mizDecodeEntities(mizAttr(n, "spelling"));
	switch (mizFindFirst(n.kids, "Right-Circumflex-Symbol")) {
		None(): left;
		Some(r): trim2(left + " " + mizDecodeEntities(mizAttr(r, "spelling")), " ");
	}
}

// Decode the XML character entities Mizar uses in operator symbols (e.g. \&#x2B;\ -> \+\).
mizDecodeEntities(s : string) -> string {
	fold([
		Pair("&#x2B;", "+"), Pair("&#x7B;", "{"), Pair("&#x7D;", "}"), Pair("&#x3C;", "<"),
		Pair("&#x3E;", ">"), Pair("&#x3D;", "="), Pair("&#x5B;", "["), Pair("&#x5D;", "]"),
		Pair("&#x7C;", "|"), Pair("&#x28;", "("), Pair("&#x29;", ")"), Pair("&#x2C;", ","),
		Pair("&#x5C;", "\\"), Pair("&#x2F;", "/"), Pair("&#x23;", "#"), Pair("&#x2A;", "*"),
		Pair("&#x2E;", "."), Pair("&#x5E;", "^"), Pair("&#x7E;", "~"), Pair("&#x40;", "@"),
		Pair("&#x24;", "$"), Pair("&#x21;", "!"), Pair("&#x3A;", ":"), Pair("&#x3B;", ";"),
		Pair("&#x60;", "`"), Pair("&#x22;", "\""),
		Pair("&amp;", "&"), Pair("&lt;", "<"), Pair("&gt;", ">"), Pair("&quot;", "\"")
	], s, \acc, p -> strReplace(acc, p.first, p.second));
}

// The Mizar set-theory operators rendered as unicode math symbols, used DIRECTLY as the
// Russell constant symbol (Russell allows any non-space symbol). The matching alphanumeric
// rule name is derived separately by folRuleId. Bracket functors ({ }, [ ]) are absent —
// their spelling is ambiguous across arities. "" = keep the mechanical MPTP name.
mizOpName(spelling : string) -> string {
	// keyed by the Mizar SPELLING (\/, c=) AND by the clean-word name (in, union) that the
	// .dcx/.eno resolution yields — both map to the unicode math symbol.
	lookupTreeDef(pairs2tree([
		Pair("\\/", "∪"),     // binary union          X \/ Y
		Pair("/\\", "∩"),     // binary meet           X /\ Y
		Pair("\\", "∖"),      // difference            X \ Y
		Pair("\\+\\", "△"),   // symmetric difference  X \+\ Y
		Pair("{}", "∅"),      // the empty set
		Pair("c=", "⊆"),      // X c= Y
		Pair("c<", "⊊"),      // proper subset         X c< Y
		Pair("c/=", "⊄"),
		Pair("in", "∈"),      // membership            x in X
		Pair("union", "∪."),  // union of a family     union X → foundation cuni (∪. A, bare prefix)
		Pair("bool", "𝒫"),    // power set             bool X  → foundation cpw  (𝒫 A, bare prefix)
	]), spelling, "");
}
