// Debug printing of the expression layer (not a transcription — tooling).

import string;
import ds/vector;
import mizar/original/lexicon;
import mizar/original/correl;

export {
	mizTrm2s(t : MizTrm) -> string;
	mizTrmList2s(l : MizTrmList) -> string;
	mizTyp2s(t : MizTyp) -> string;
	mizFrm2s(f : MizFrm) -> string;
}

mizTrm2s(t : MizTrm) -> string {
	switch (t) {
		MizVarTrm(srt, varNr, __, trmInfo): {
			pfx = if (srt == ikTrmBound) "B"
				else if (srt == ikTrmConstant) "c"
				else if (srt == ikTrmInfConst) "D"
				else if (srt == ikTrmEqConst) "E"
				else if (srt == ikTrmFreeVar) "F"
				else if (srt == ikTrmLocus) "A"
				else if (srt == ikTrmNumeral) "#"
				else "v" + i2s(srt) + "_";
			pfx + i2s(varNr);
		}
		MizFuncTrm(srt, funcNr, args, __, __): {
			k = if (srt == ikTrmFunctor) "K" else if (srt == ikTrmSelector) "U"
				else if (srt == ikTrmAggreg) "G" else "F";
			k + i2s(funcNr) + "(" + mizTrmList2s(args) + ")";
		}
		MizPrivFuncTrm(funcNr, args, __, __, __): "H" + i2s(funcNr) + "(" + mizTrmList2s(args) + ")";
		MizFraenkelTrm(__, scope, __, __, __, __): "{" + mizTrm2s(scope) + ":...}";
		MizQuaTrm(trmProper, __, __, __): mizTrm2s(trmProper) + " qua …";
		MizChoiceTrm(typ, __, __): "the " + mizTyp2s(typ);
		MizBaseTrm(srt, __): if (srt == ikTrmIt) "it" else "?";
	}
}

mizTrmList2s(l : MizTrmList) -> string {
	switch (l) {
		MizTrmNil(): "";
		MizTrmElem(trm, next): {
			rest = mizTrmList2s(next);
			mizTrm2s(trm) + (if (rest == "") "" else "," + rest);
		}
	}
}

mizTyp2s(t : MizTyp) -> string {
	cl = foldVector(t.lower.items, "", \acc, a ->
		acc + (if (a.neg == 0) "non-" else "") + "V" + i2s(a.attrNr)
			+ (switch (a.args) { MizTrmNil(): ""; default: "(" + mizTrmList2s(a.args) + ")"; }) + " ");
	kind = if (t.sort == ikTypMode) "M" else if (t.sort == ikTypStruct) "L" else "?";
	cl + kind + i2s(t.modNr)
		+ (switch (t.modArgs) { MizTrmNil(): ""; default: "(" + mizTrmList2s(t.modArgs) + ")"; });
}

mizFrm2s(f : MizFrm) -> string {
	switch (f) {
		MizPredFrm(srt, predNr, args, __): {
			k = if (srt == ikFrmPred) "R" else if (srt == ikFrmAttr) "V"
				else if (srt == ikFrmSchPred) "P" else "?";
			k + i2s(predNr) + "[" + mizTrmList2s(args) + "]";
		}
		MizLocPredFrm(predNr, args, __, __): "S" + i2s(predNr) + "[" + mizTrmList2s(args) + "]";
		MizQualFrm(trm, typ, __): mizTrm2s(trm) + " is " + mizTyp2s(typ);
		MizNegFrm(arg, __): "¬" + mizFrm2s(arg);
		MizBinFrm(__, l, r, __): "(" + mizFrm2s(l) + " ? " + mizFrm2s(r) + ")";
		MizConjFrm(conjuncts, __): {
			"(" + foldVector(conjuncts, "", \acc, g ->
				acc + (if (acc == "") "" else " ∧ ") + mizFrm2s(g)) + ")";
		}
		MizUnivFrm(__, __, quantified, scope, __):
			"∀[" + mizTyp2s(quantified) + "]" + mizFrm2s(scope);
		MizUniqFrm(srt): if (srt == ikFrmVerum) "⊤" else "?f";
		MizFlexFrm(__, lo, ro, __, __, __, __):
			mizFrm2s(lo) + "...+..." + mizFrm2s(ro);
	}
}
