// Transcription of the WRITER half of ~/dev/system/kernel/iocorrel.pas
// (OutVRFFileObj, lines 1504-3184) — the `<article>.xml` analyzer report the
// checker then consumes. The port's iocorrel.flow is the READER half.
//
// ★ THE .xml IS NOT INDENTED. base/xml_inout.pas XMLOutStreamObj.OutIndent
//   writes nIndent spaces, but kernel/iocorrel.pas overrides it with an
//   `{$IFDEF _XML_INDENTING}` that is never set — so the kernel's stream keeps
//   the nesting counter and emits nothing for it. The `.wsx` writer
//   (wsm_write.flow) DOES indent, because it goes through the base class.
//
// Transf(kind, nr) is the identity for OutVRFFileObj (line 1520): the analyzer
// report speaks the article's own constructor numbers. The MML/env writers
// override it, and those are a separate job.

import ds/vector;
import string;
import loop;
import mizar/original/errhan;
import mizar/original/mobjects;
import mizar/original/lexicon;
import mizar/original/enums;
import mizar/original/correl;
import mizar/original/correl_patt;
import mizar/original/roundcl;
import mizar/original/justhan;
import math/bits;

export {
	MizVrfOut(
		out : Vector<string>,
		mutable indent : int,       // kept, as the original keeps nIndent
		env : MizCorrelEnv,
		// nExpandInferConsts (true by default): an InfConst is written as its
		// DEFINITION, not as a reference
		mutable expandInferConsts : bool,
	);

	mizMakeVrfOut(env : MizCorrelEnv) -> MizVrfOut;
	mizVrfOutContent(o : MizVrfOut) -> string;

	// the raw XML primitives
	mizVOutString(o : MizVrfOut, s : string) -> void;
	mizVOutElStart(o : MizVrfOut, el : string) -> void;
	mizVOutElStart0(o : MizVrfOut, el : string) -> void;
	mizVOutAttrEnd(o : MizVrfOut) -> void;
	mizVOutElEnd0(o : MizVrfOut) -> void;
	mizVOutEl1(o : MizVrfOut, el : string) -> void;
	mizVOutElEnd(o : MizVrfOut, el : string) -> void;
	mizVOutAttr(o : MizVrfOut, at : string, val : string) -> void;
	mizVOutIntAttr(o : MizVrfOut, at : string, val : int) -> void;
	mizVOutNewLine(o : MizVrfOut) -> void;

	// Out_*
	mizVOutPosAsAttrs(o : MizVrfOut, p : MizPos) -> void;
	mizVOutTerm(o : MizVrfOut, t : MizTrm) -> void;
	mizVOutTermList(o : MizVrfOut, l : MizTrmList) -> void;
	mizVOutAttrColl(o : MizVrfOut, c : MizAttrColl) -> void;
	mizVOutType(o : MizVrfOut, t : MizTyp) -> void;
	mizVOutTypeWithId(o : MizVrfOut, t : MizTyp, varId : int) -> void;
	mizVOutTypeList(o : MizVrfOut, v : Vector<MizTyp>) -> void;
	mizVOutArgTypes(o : MizVrfOut, v : Vector<MizTyp>) -> void;
	mizVOutFormula(o : MizVrfOut, f : MizFrm) -> void;
	mizVOutFormulaColl(o : MizVrfOut, v : Vector<MizFrm>) -> void;
	mizVOutPropos(o : MizVrfOut, nr : int, id : int, pos : MizPos, f : MizFrm) -> void;
	mizVOutInt(o : MizVrfOut, i : int) -> void;
	mizVOutPair(o : MizVrfOut, i : int, j : int) -> void;
	mizVOutIntSeq(o : MizVrfOut, el : string, s : MizIntSeq) -> void;
	mizVOutNatFunc(o : MizVrfOut, el : string, f : MizNatFunc) -> void;
	mizVOutIntRel(o : MizVrfOut, el : string, v : Vector<MizIntPair>) -> void;
	mizVOutStructLoci(o : MizVrfOut, f : MizNatFunc) -> void;
	mizVOutEndPos(o : MizVrfOut, p : MizPos) -> void;
	mizVOutRCluster(o : MizVrfOut, c : MizRCluster) -> void;
	mizVOutCCluster(o : MizVrfOut, c : MizCCluster) -> void;
	mizVOutFCluster(o : MizVrfOut, c : MizFCluster) -> void;
	mizVOutErrCluster(o : MizVrfOut, el : string, articleId : string) -> void;
	mizVOutCluster(o : MizVrfOut, c : MizAnyCluster) -> void;
	mizVOutPattern(o : MizVrfOut, p : MizPattern, relNr : int) -> void;
	mizVOutConstructor(o : MizVrfOut, c : MizConstr, relNr : int) -> void;
	mizVOutInference(o : MizVrfOut, inf : MizInference) -> void;
	mizVOutIterStep(o : MizVrfOut, st : MizIterStep) -> void;
	mizVOutProposition(o : MizVrfOut, p : MizProposition) -> void;
	mizVOutPropositions(o : MizVrfOut, v : Vector<MizProposition>) -> void;
	// Prop2XmlElem (xmldict.pas 538)
	mizProp2XmlElem(p : int) -> string;
}

mizMakeVrfOut(env : MizCorrelEnv) -> MizVrfOut {
	MizVrfOut(makeVector(4096), 0, env, true);
}

mizVrfOutContent(o : MizVrfOut) -> string { concatStrings(vector2array(o.out)); }

// --------------------------------------------------------- XML primitives --

mizVOutString(o : MizVrfOut, s : string) -> void { pushVector(o.out, s); }
mizVOutNewLine(o : MizVrfOut) -> void { mizVOutString(o, "\n"); }

// OutIndent writes nothing here — see the file header
mizVOutElStart(o : MizVrfOut, el : string) -> void {
	o.indent ::= o.indent + 1;
	mizVOutString(o, "<" + el);
}

mizVOutAttrEnd(o : MizVrfOut) -> void { mizVOutString(o, ">\n"); }

mizVOutElStart0(o : MizVrfOut, el : string) -> void {
	mizVOutElStart(o, el); mizVOutAttrEnd(o);
}

mizVOutElEnd0(o : MizVrfOut) -> void {
	mizVOutString(o, "/>\n");
	o.indent ::= o.indent - 1;
}

mizVOutEl1(o : MizVrfOut, el : string) -> void {
	mizVOutElStart(o, el); mizVOutElEnd0(o);
}

mizVOutElEnd(o : MizVrfOut, el : string) -> void {
	o.indent ::= o.indent - 1;
	mizVOutString(o, "</" + el + ">\n");
}

mizVOutAttr(o : MizVrfOut, at : string, val : string) -> void {
	mizVOutString(o, " " + at + "=\"" + val + "\"");
}

mizVOutIntAttr(o : MizVrfOut, at : string, val : int) -> void {
	mizVOutAttr(o, at, i2s(val));
}

mizVOutPosAsAttrs(o : MizVrfOut, p : MizPos) -> void {
	mizVOutIntAttr(o, "line", p.line);
	mizVOutIntAttr(o, "col", p.col);
}

// Transf for OutVRFFileObj is the identity (iocorrel.pas 1520)
mizVTransf(o : MizVrfOut, kind : int, nr : int) -> int { nr }

// ------------------------------------------------------- terms and types ---

mizVOutTermList(o : MizVrfOut, l : MizTrmList) -> void {
	cur = ref l;
	while(\ -> switch (^cur) { MizTrmElem(__, __): true; MizTrmNil(): false; }, \ -> {
		switch (^cur) {
			MizTrmElem(trm, next): { mizVOutTerm(o, trm); cur := next; }
			MizTrmNil(): {}
		}
	});
}

// Out_Attr (1565)
mizVOutAttrOne(o : MizVrfOut, a : MizAttr) -> void {
	mizVOutElStart(o, "Adjective");
	mizVOutIntAttr(o, "nr", mizVTransf(o, coAttribute, a.attrNr));
	if (a.neg == 0) mizVOutAttr(o, "value", "false");
	if (a.pattNr != 0) mizVOutIntAttr(o, "pid", a.pattNr);
	switch (a.args) {
		MizTrmNil(): mizVOutElEnd0(o);
		MizTrmElem(__, __): {
			mizVOutAttrEnd(o);
			mizVOutTermList(o, a.args);
			mizVOutElEnd(o, "Adjective");
		}
	}
}

// Out_AttrColl (1589)
mizVOutAttrColl(o : MizVrfOut, c : MizAttrColl) -> void {
	mizVOutElStart(o, "Cluster");
	if (sizeVector(c.items) == 0) mizVOutElEnd0(o)
	else {
		mizVOutAttrEnd(o);
		iterVector(c.items, \a -> mizVOutAttrOne(o, a));
		mizVOutElEnd(o, "Cluster");
	}
}

mizVOutType(o : MizVrfOut, t : MizTyp) -> void { mizVOutTypeWithId(o, t, 0); }

// Out_TypeWithId (1624)
mizVOutTypeWithId(o : MizVrfOut, t : MizTyp, varId : int) -> void {
	mizVOutElStart(o, "Typ");
	if (t.sort == ikTypMode || t.sort == ikTypStruct) {
		mizVOutAttr(o, "kind", fromCharCode(t.sort));
		mizVOutIntAttr(o, "nr", mizVTransf(o, mizConstructorKind(t.sort), t.modNr));
		if (t.pattNr != 0) mizVOutIntAttr(o, "pid", t.pattNr);
		if (varId != 0) mizVOutIntAttr(o, "vid", varId);
		mizVOutAttrEnd(o);
		mizVOutAttrColl(o, t.lower);
		mizVOutAttrColl(o, t.upper);
		mizVOutTermList(o, t.modArgs);
		mizVOutElEnd(o, "Typ");
	} else if (t.sort == ikError) {
		mizVOutAttr(o, "kind", "errortyp");
		mizVOutIntAttr(o, "nr", 0);
		mizVOutAttrEnd(o);
		mizVOutElEnd(o, "Typ");
	} else {
		mizRunTimeError(2039);
	}
}

mizVOutTypeList(o : MizVrfOut, v : Vector<MizTyp>) -> void {
	iterVector(v, \t -> mizVOutType(o, t));
}

mizVOutTypeListWithIds(o : MizVrfOut, v : Vector<MizTyp>, idents : MizIntSeq) -> void {
	mizAssert(2583, mizSeqCount(idents) == sizeVector(v));
	fori(0, sizeVector(v) - 1, \z ->
		mizVOutTypeWithId(o, getVectorUnsafe(v, z), mizSeqValue(idents, z)));
}

// Out_ArgTypes (2164)
mizVOutArgTypes(o : MizVrfOut, v : Vector<MizTyp>) -> void {
	if (sizeVector(v) == 0) mizVOutEl1(o, "ArgTypes")
	else {
		mizVOutElStart0(o, "ArgTypes");
		mizVOutTypeList(o, v);
		mizVOutElEnd(o, "ArgTypes");
	}
}

// XVarTrm2El (the element name of a variable term)
mizVVarTrmEl(srt : int) -> string {
	if (srt == ikTrmBound) "Var"
	else if (srt == ikTrmLocus) "LocusVar"
	else if (srt == ikTrmFreeVar) "FreeVar"
	else if (srt == ikTrmLambdaVar) "LambdaVar"
	else if (srt == ikTrmConstant) "Const"
	else if (srt == ikTrmInfConst) "InfConst"
	else if (srt == ikTrmNumeral) "Num"
	else { mizRunTimeError(2041); "ErrorTrm" }
}

// Out_VarTerm (1935)
mizVOutVarTerm(o : MizVrfOut, t : MizVarTrm) -> void {
	mizVOutElStart(o, mizVVarTrmEl(t.sort));
	mizVOutIntAttr(o, "nr", t.varNr);
	if (t.sort == ikTrmConstant) {
		// FixedVar[VarNr].nIdent — the analyzer's live table. Out of range only
		// outside the analyzer (the round-trip gate), where 0 is written.
		id = if (t.varNr < sizeVector(o.env.fixedVar))
			getVectorUnsafe(o.env.fixedVar, t.varNr).ident else 0;
		mizVOutIntAttr(o, "vid", id);
	}
	mizVOutElEnd0(o);
}

// Out_FuncTerm (1959)
mizVOutFuncTerm(o : MizVrfOut, t : MizFuncTrm) -> void {
	mizVOutElStart(o, "Func");
	mizVOutAttr(o, "kind", fromCharCode(t.sort));
	if (t.sort == ikTrmAggreg || t.sort == ikTrmFunctor || t.sort == ikTrmSelector)
		mizVOutIntAttr(o, "nr", mizVTransf(o, mizConstructorKind(t.sort), t.funcNr))
	else mizVOutIntAttr(o, "nr", t.funcNr);
	if (t.pattNr != 0) mizVOutIntAttr(o, "pid", t.pattNr);
	switch (t.args) {
		MizTrmNil(): mizVOutElEnd0(o);
		MizTrmElem(__, __): {
			mizVOutAttrEnd(o);
			mizVOutTermList(o, t.args);
			mizVOutElEnd(o, "Func");
		}
	}
}

mizVOutTerm(o : MizVrfOut, t : MizTrm) -> void {
	switch (t) {
		MizVarTrm(srt, varNr, __, __): {
			if (srt == ikTrmInfConst && o.expandInferConsts)
				mizVOutTerm(o, getVectorUnsafe(o.env.inferConstDef, varNr).def)
			else mizVOutVarTerm(o, t);
		}
		MizFuncTrm(__, __, __, __, __): mizVOutFuncTerm(o, t);
		MizPrivFuncTrm(funcNr, args, funcExp, __, __): {
			// Out_PrivFuncTerm (1985)
			mizVOutElStart(o, "PrivFunc");
			mizVOutIntAttr(o, "nr", funcNr);
			mizVOutAttrEnd(o);
			mizVOutTerm(o, funcExp);
			mizVOutTermList(o, args);
			mizVOutElEnd(o, "PrivFunc");
		}
		MizFraenkelTrm(lambdaArgs, scope, compr, idents, __, __): {
			// Out_FraenkelTerm (2008)
			mizVOutElStart0(o, "Fraenkel");
			mizVOutTypeListWithIds(o, lambdaArgs, idents);
			mizVOutTerm(o, scope);
			mizVOutFormula(o, compr);
			mizVOutElEnd(o, "Fraenkel");
		}
		MizQuaTrm(trmProper, qua, __, __): {
			mizVOutElStart0(o, "QuaTrm");
			mizVOutTerm(o, trmProper);
			mizVOutType(o, qua);
			mizVOutElEnd(o, "QuaTrm");
		}
		MizChoiceTrm(choiceTyp, __, __): {
			mizVOutElStart0(o, "Choice");
			mizVOutType(o, choiceTyp);
			mizVOutElEnd(o, "Choice");
		}
		MizBaseTrm(srt, __): {
			// Out_UniqTerm (2058)
			if (srt == ikTrmIt) mizVOutEl1(o, "It")
			else if (srt == ikError) mizVOutEl1(o, "ErrorTrm")
			else mizRunTimeError(2041);
		}
	}
}

// ------------------------------------------------------------ formulas -----

mizVOutFormulaColl(o : MizVrfOut, v : Vector<MizFrm>) -> void {
	iterVector(v, \f -> mizVOutFormula(o, f));
}

mizVOutFormula(o : MizVrfOut, f : MizFrm) -> void {
	switch (f) {
		MizNegFrm(arg, pattNr): {
			if (pattNr != 0) {
				mizVOutElStart(o, "Not");
				mizVOutIntAttr(o, "pid", pattNr);
				mizVOutAttrEnd(o);
			} else mizVOutElStart0(o, "Not");
			mizVOutFormula(o, arg);
			mizVOutElEnd(o, "Not");
		}
		MizConjFrm(conjuncts, pattNr): {
			if (pattNr != 0) {
				mizVOutElStart(o, "And");
				mizVOutIntAttr(o, "pid", pattNr);
				mizVOutAttrEnd(o);
			} else mizVOutElStart0(o, "And");
			mizVOutFormulaColl(o, conjuncts);
			mizVOutElEnd(o, "And");
		}
		MizPredFrm(srt, predNr, args, pattNr): {
			// Out_PredFormula (1818)
			mizVOutElStart(o, "Pred");
			mizVOutAttr(o, "kind", fromCharCode(srt));
			if (srt == ikFrmAttr || srt == ikFrmPred)
				mizVOutIntAttr(o, "nr", mizVTransf(o, mizConstructorKind(srt), predNr))
			else mizVOutIntAttr(o, "nr", predNr);
			if (pattNr != 0) mizVOutIntAttr(o, "pid", pattNr);
			switch (args) {
				MizTrmNil(): mizVOutElEnd0(o);
				MizTrmElem(__, __): {
					mizVOutAttrEnd(o);
					mizVOutTermList(o, args);
					mizVOutElEnd(o, "Pred");
				}
			}
		}
		MizLocPredFrm(predNr, args, predExp, __): {
			mizVOutElStart(o, "PrivPred");
			mizVOutIntAttr(o, "nr", predNr);
			mizVOutAttrEnd(o);
			mizVOutTermList(o, args);
			mizVOutFormula(o, predExp);
			mizVOutElEnd(o, "PrivPred");
		}
		MizUnivFrm(__, varId, quantified, scope, pattNr): {
			if (pattNr != 0 || varId != 0) {
				mizVOutElStart(o, "For");
				mizVOutIntAttr(o, "pid", pattNr);
				mizVOutIntAttr(o, "vid", varId);
				mizVOutAttrEnd(o);
			} else mizVOutElStart0(o, "For");
			mizVOutType(o, quantified);
			mizVOutFormula(o, scope);
			mizVOutElEnd(o, "For");
		}
		MizQualFrm(trm, typ, __): {
			mizVOutElStart0(o, "Is");
			mizVOutTerm(o, trm);
			mizVOutType(o, typ);
			mizVOutElEnd(o, "Is");
		}
		MizFlexFrm(__, leftOrig, rightOrig, leftTrm, rightTrm, expansion, pattNr): {
			if (pattNr != 0) {
				mizVOutElStart(o, "FlexFrm");
				mizVOutIntAttr(o, "pid", pattNr);
				mizVOutAttrEnd(o);
			} else mizVOutElStart0(o, "FlexFrm");
			mizVOutFormula(o, leftOrig);
			mizVOutFormula(o, rightOrig);
			mizVOutTerm(o, leftTrm);
			mizVOutTerm(o, rightTrm);
			mizVOutFormula(o, expansion);
			mizVOutElEnd(o, "FlexFrm");
		}
		MizUniqFrm(srt): {
			// Out_UniqFormula (1866): thesis is NOT written
			if (srt == ikFrmVerum) mizVOutEl1(o, "Verum")
			else if (srt == ikError) mizVOutEl1(o, "ErrorFrm");
		}
		MizBinFrm(__, __, __, __): mizRunTimeError(2040);
	}
}

// --------------------------------------------------- propositions, misc ----

// Out_Propos (2129)
mizVOutPropos(o : MizVrfOut, nr : int, id : int, pos : MizPos, f : MizFrm) -> void {
	mizVOutElStart(o, "Proposition");
	mizVOutPosAsAttrs(o, pos);
	if (nr > 0) {
		mizVOutIntAttr(o, "nr", nr);
		mizVOutIntAttr(o, "vid", id);
	}
	mizVOutAttrEnd(o);
	mizVOutFormula(o, f);
	mizVOutElEnd(o, "Proposition");
}

mizVOutInt(o : MizVrfOut, i : int) -> void {
	mizVOutElStart(o, "Int");
	mizVOutIntAttr(o, "x", i);
	mizVOutElEnd0(o);
}

mizVOutPair(o : MizVrfOut, i : int, j : int) -> void {
	mizVOutElStart(o, "Pair");
	mizVOutIntAttr(o, "x", i);
	mizVOutIntAttr(o, "y", j);
	mizVOutElEnd0(o);
}

mizVOutIntSeq(o : MizVrfOut, el : string, s : MizIntSeq) -> void {
	if (mizSeqCount(s) == 0) mizVOutEl1(o, el)
	else {
		mizVOutElStart0(o, el);
		fori(0, mizSeqCount(s) - 1, \k -> mizVOutInt(o, mizSeqValue(s, k)));
		mizVOutElEnd(o, el);
	}
}

mizVOutNatFunc(o : MizVrfOut, el : string, f : MizNatFunc) -> void {
	if (mizNatCount(f) == 0) mizVOutEl1(o, el)
	else {
		mizVOutElStart0(o, el);
		fori(0, mizNatCount(f) - 1, \i -> {
			p = mizNatItem(f, i);
			mizVOutPair(o, p.x, p.y);
		});
		mizVOutElEnd(o, el);
	}
}

mizVOutIntRel(o : MizVrfOut, el : string, v : Vector<MizIntPair>) -> void {
	if (sizeVector(v) == 0) mizVOutEl1(o, el)
	else {
		mizVOutElStart0(o, el);
		iterVector(v, \p -> mizVOutPair(o, p.x, p.y));
		mizVOutElEnd(o, el);
	}
}

// Out_StructLoci (2647)
mizVOutStructLoci(o : MizVrfOut, f : MizNatFunc) -> void {
	if (mizNatCount(f) == 0) mizVOutEl1(o, "StructLoci")
	else {
		mizVOutElStart0(o, "StructLoci");
		fori(0, mizNatCount(f) - 1, \i -> {
			p = mizNatItem(f, i);
			mizVOutPair(o, p.x, mizVTransf(o, coStructMode, p.y));
		});
		mizVOutElEnd(o, "StructLoci");
	}
}

mizVOutEndPos(o : MizVrfOut, p : MizPos) -> void {
	mizVOutElStart(o, "EndPosition");
	mizVOutPosAsAttrs(o, p);
	mizVOutElEnd0(o);
}

// ----------------------------------------------------------- clusters ------

mizVOutRCluster(o : MizVrfOut, c : MizRCluster) -> void {
	mizVOutElStart(o, "RCluster");
	mizVOutAttr(o, "aid", c.article);
	mizVOutIntAttr(o, "nr", c.absNr);
	mizVOutAttrEnd(o);
	mizVOutArgTypes(o, c.primaries);
	mizVOutType(o, c.clusterType);
	mizVOutAttrColl(o, c.consequent.lower);
	mizVOutAttrColl(o, c.consequent.upper);
	mizVOutElEnd(o, "RCluster");
}

mizVOutCCluster(o : MizVrfOut, c : MizCCluster) -> void {
	mizVOutElStart(o, "CCluster");
	mizVOutAttr(o, "aid", c.article);
	mizVOutIntAttr(o, "nr", c.absNr);
	mizVOutAttrEnd(o);
	mizVOutArgTypes(o, c.primaries);
	mizVOutAttrColl(o, c.antecedent);
	mizVOutType(o, c.clusterType);
	mizVOutAttrColl(o, c.consequent.lower);
	mizVOutAttrColl(o, c.consequent.upper);
	mizVOutElEnd(o, "CCluster");
}

mizVOutFCluster(o : MizVrfOut, c : MizFCluster) -> void {
	mizVOutElStart(o, "FCluster");
	mizVOutAttr(o, "aid", c.article);
	mizVOutIntAttr(o, "nr", c.absNr);
	mizVOutAttrEnd(o);
	mizVOutArgTypes(o, c.primaries);
	mizVOutTerm(o, c.clusterTerm);
	mizVOutAttrColl(o, c.consequent.lower);
	mizVOutAttrColl(o, c.consequent.upper);
	switch (c.clusterType) {
		None(): {}
		Some(t): mizVOutType(o, t);
	}
	mizVOutElEnd(o, "FCluster");
}

mizVOutErrCluster(o : MizVrfOut, el : string, articleId : string) -> void {
	mizVOutElStart(o, el);
	mizVOutAttr(o, "aid", articleId);
	mizVOutIntAttr(o, "nr", 0);
	mizVOutAttrEnd(o);
	mizVOutEl1(o, "ErrorCluster");
	mizVOutElEnd(o, el);
}

mizVOutCluster(o : MizVrfOut, c : MizAnyCluster) -> void {
	switch (c) {
		MizRCluster(__, __, __, __, __): mizVOutRCluster(o, c);
		MizFCluster(__, __, __, __, __, __): mizVOutFCluster(o, c);
		MizCCluster(__, __, __, __, __, __): mizVOutCCluster(o, c);
	}
}

// ------------------------------------------------------------ patterns -----

// Out_Pattern (2909) — a pattern with no format number is NOT written
mizVOutPattern(o : MizVrfOut, p : MizPattern, relNr : int) -> void {
	if (p.formNr != 0) {
		mizVOutElStart(o, "Pattern");
		mizVOutAttr(o, "kind", fromCharCode(mizNotationRepr(p.kind)));
		mizVOutIntAttr(o, "nr", p.absNr);
		mizVOutAttr(o, "aid", p.article);
		mizVOutIntAttr(o, "formatnr", p.formNr);
		mizVOutAttr(o, "constrkind", fromCharCode(p.constrKind));
		mizVOutIntAttr(o, "constrnr",
			mizVTransf(o, mizConstructorKind(p.constrKind), p.constrNr));
		if (p.antonymic) mizVOutAttr(o, "antonymic", "true");
		if (relNr != 0) mizVOutIntAttr(o, "relnr", relNr);
		if (p.redefNr != 0) mizVOutIntAttr(o, "redefnr", p.redefNr);
		mizVOutAttrEnd(o);
		mizVOutArgTypes(o, p.primTypes);
		mizVOutIntSeq(o, "Visible", p.visible);
		switch (p.expansion) {
			None(): {}
			Some(t): {
				mizVOutElStart0(o, "Expansion");
				mizVOutType(o, t);
				mizVOutElEnd(o, "Expansion");
			}
		}
		mizVOutElEnd(o, "Pattern");
	}
}

// ------------------------------------------------------- constructors ------

mizProp2XmlElem(p : int) -> string {
	if (p == sySymmetry) "Symmetry"
	else if (p == syReflexivity) "Reflexivity"
	else if (p == syIrreflexivity) "Irreflexivity"
	else if (p == syAssociativity) "Associativity"
	else if (p == syTransitivity) "Transitivity"
	else if (p == syCommutativity) "Commutativity"
	else if (p == syConnectedness) "Connectedness"
	else if (p == syAsymmetry) "Asymmetry"
	else if (p == syIdempotence) "Idempotence"
	else if (p == syInvolutiveness) "Involutiveness"
	else if (p == syProjectivity) "Projectivity"
	else if (p == sySethood) "Sethood"
	else if (p == syAbstractness) "Abstractness"
	else "UnexpectedProp";
}

// Out_Constructor (2730). The nested Out_ConstrTypes writes the argument types
// and, for a TYPED kind, the result type.
mizVOutConstrTypes(o : MizVrfOut, c : MizConstr) -> void {
	mizVOutArgTypes(o, c.primaries);
	// TypedConstrKinds = [coFunctor, coMode, coAttribute, coAggregate, coSelector]
	if (c.kind == coFunctor || c.kind == coMode || c.kind == coAttribute
		|| c.kind == coAggregate || c.kind == coSelector) {
		switch (c.typ) {
			Some(t): mizVOutType(o, t);
			None(): mizVOutType(o, mizNewIncorTyp());
		}
	}
}

mizVOutConstructor(o : MizVrfOut, c : MizConstr, relNr : int) -> void {
	mizVOutElStart(o, "Constructor");
	mizVOutAttr(o, "kind", fromCharCode(mizConstructorRepr(c.kind)));
	mizVOutIntAttr(o, "nr", c.absNr);
	mizVOutAttr(o, "aid", c.article);
	if (relNr != 0) mizVOutIntAttr(o, "relnr", relNr);
	if (c.kind == coStructMode) {
		mizVOutIntAttr(o, "structmodeaggrnr",
			mizVTransf(o, c.kind, c.structModeAggrNr));
		mizVOutAttrEnd(o);
		mizVOutConstrTypes(o, c);
		mizVOutTypeList(o, c.prefixes);
		mizVOutElStart0(o, "Fields");
		fori(0, mizNatCount(c.fields) - 1, \j -> {
			mizVOutElStart(o, "Field");
			mizVOutIntAttr(o, "nr", mizVTransf(o, coSelector, mizNatItem(c.fields, j).x));
			mizVOutElEnd0(o);
		});
		mizVOutElEnd(o, "Fields");
	} else if (c.kind == coAggregate) {
		mizVOutIntAttr(o, "aggregbase", c.aggregBase);
		mizVOutAttrEnd(o);
		mizVOutConstrTypes(o, c);
		mizVOutElStart0(o, "Fields");
		fori(0, mizSeqCount(c.aggrFields) - 1, \j -> {
			mizVOutElStart(o, "Field");
			mizVOutIntAttr(o, "nr", mizVTransf(o, coSelector, mizSeqValue(c.aggrFields, j)));
			mizVOutElEnd0(o);
		});
		mizVOutElEnd(o, "Fields");
	} else {
		if (c.whichConstrNr > 0) {
			mizVOutIntAttr(o, "redefnr", mizVTransf(o, c.kind, c.whichConstrNr));
			mizVOutIntAttr(o, "superfluous", c.superfluous);
		}
		mizVOutAttrEnd(o);
		if (c.properties != 0) {
			mizVOutElStart(o, "Properties");
			mizVOutIntAttr(o, "propertyarg1", c.firstArg);
			mizVOutIntAttr(o, "propertyarg2", c.secondArg);
			mizVOutAttrEnd(o);
			fori(0, 13, \pk -> if (bitAnd(c.properties, bitShl(1, pk)) != 0)
				mizVOutEl1(o, mizProp2XmlElem(pk)));
			mizVOutElEnd(o, "Properties");
		}
		mizVOutConstrTypes(o, c);
	}
	mizVOutElEnd(o, "Constructor");
}

// ----------------------------------------------------- propositions --------

mizVOutProposition(o : MizVrfOut, p : MizProposition) -> void {
	mizVOutPropos(o, p.labNr, p.labId, p.pos, p.sentence);
}

mizVOutPropositions(o : MizVrfOut, v : Vector<MizProposition>) -> void {
	iterVector(v, \p -> mizVOutProposition(o, p));
}

// ------------------------------------------------------- inferences --------

// Out_Inference (3106)
mizVOutInference(o : MizVrfOut, inf : MizInference) -> void {
	if (inf.inferSort == ikError) mizVOutEl1(o, "ErrorInf")
	else if (inf.inferSort == ikBlcIgnoreProof) mizVOutEl1(o, "SkippedProof")
	else {
		byInf = inf.inferSort == ikInfBy;
		if (byInf) {
			mizVOutElStart(o, "By");
			if (inf.linked) mizVOutAttr(o, "linked", "true");
		} else {
			mizVOutElStart(o, "From");
			mizVOutIntAttr(o, "articlenr", inf.schFileNr);
			mizVOutIntAttr(o, "nr", inf.schemeNr);
		}
		mizVOutPosAsAttrs(o, inf.pos);
		if (sizeVector(inf.references) == 0) mizVOutElEnd0(o)
		else {
			mizVOutAttrEnd(o);
			iterVector(inf.references, \rf -> switch (rf) {
				MizPrivateRef(pos, labNr, labId): {
					mizVOutElStart(o, "Ref");
					mizVOutIntAttr(o, "nr", labNr);
					if (labId != 0) mizVOutIntAttr(o, "vid", labId);
					mizVOutPosAsAttrs(o, pos);
					mizVOutElEnd0(o);
				}
				MizTheoremRef2(pos, articleNr, theoNr): {
					mizVOutElStart(o, "Ref");
					mizVOutIntAttr(o, "nr", theoNr);
					mizVOutIntAttr(o, "articlenr", articleNr);
					mizVOutAttr(o, "kind", "T");
					mizVOutPosAsAttrs(o, pos);
					mizVOutElEnd0(o);
				}
				MizDefinitionRef2(pos, articleNr, defNr): {
					mizVOutElStart(o, "Ref");
					mizVOutIntAttr(o, "nr", defNr);
					mizVOutIntAttr(o, "articlenr", articleNr);
					mizVOutAttr(o, "kind", "D");
					mizVOutPosAsAttrs(o, pos);
					mizVOutElEnd0(o);
				}
			});
			mizVOutElEnd(o, if (byInf) "By" else "From");
		}
	}
}

mizVOutIterStep(o : MizVrfOut, st : MizIterStep) -> void {
	mizVOutElStart0(o, "IterStep");
	mizVOutTerm(o, st.equatedTrm);
	mizVOutInference(o, st.inf);
	mizVOutElEnd(o, "IterStep");
}
