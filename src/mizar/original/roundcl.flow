// Transcription of ~/dev/system/kernel/roundcl.pas (MCondClList: indexed
// conditional-cluster rounding by graph-chasing) together with the cluster
// registrations and the functor-cluster rounding from correl.pas
// (RoundUpWith at 4278, RoundUpTrmTypeWithType at 1104).
//
// The registries (RegisteredCluster / FunctorCluster / ConditionalCluster
// unit globals) become MizClusters, one per article. Wiring into
// MizCorrelEnv is by the two hooks env.roundUpTrmType / env.roundUpCluster
// (mizWireRoundcl) so correl-level code reaches rounding without a circular
// import.

import ds/vector;
import ds/tree;
import string;
import loop;
import math/math;
import mizar/original/errhan;
import mizar/original/mobjects;
import mizar/original/limits;
import mizar/original/lexicon;
import mizar/original/builtin;
import mizar/original/correl;
import mizar/original/correl_inst;
import mizar/original/correl_match;
import mizar/original/print;
import net/url_parameter;

export {
	// ClusterRec: Lower/Upper consequent pair
	MizClusterRec(lower : MizAttrColl, upper : MizAttrColl);

	MizRCluster(article : string, absNr : int, primaries : Vector<MizTyp>,
		consequent : MizClusterRec, clusterType : MizTyp);
	MizCCluster(article : string, absNr : int, primaries : Vector<MizTyp>,
		antecedent : MizAttrColl, consequent : MizClusterRec, clusterType : MizTyp);
	MizFCluster(article : string, absNr : int, primaries : Vector<MizTyp>,
		consequent : MizClusterRec, clusterTerm : MizTrm,
		clusterType : Maybe<MizTyp>);

	// one registration, whatever its kind (ClusterPtr)
	MizAnyCluster ::= MizRCluster, MizFCluster, MizCCluster;

	MizClusters(
		// correl.pas 470-472. THE REGISTRIES ARE THE ORIGINAL'S CONTAINERS:
		// RegisteredCluster is an MExtList, FunctorCluster an MSortedExtList,
		// ConditionalCluster an MCondClList (an MExtList whose AddExtObject
		// also indexes the antecedent — roundcl.pas 132).
		//   * the EXT TAIL: a registration the analyzer makes inside a block
		//     is PENDING and the rounding does not see it until CloseDef
		//     commits it (AddExtItems).
		//   * FunctorCluster keeps TWO ORDERS: Items in INSERTION order —
		//     what the env round-up (iocorrel.pas 3318), the equalizer
		//     (equalizer.pas 2078) and the accommodator (acc_han.pas 1005)
		//     walk — and fIndex in CmpFuncCluster order, which ONLY
		//     FindInterval/AtIndex (correl.pas 1123, analyzer.pas 6168) use.
		registered : MizExtList<MizRCluster>,
		functor : MizSortedExtList<MizFCluster>,
		conditional : MizExtList<MizCCluster>,
		// nAttrClusters[neg][adjusted attr nr] -> set of conditional indices
		condIndexPos : Vector<MizNatFunc>,    // index = adjusted attr nr
		condIndexNeg : Vector<MizNatFunc>,
		initClFire : MizIntSeq,               // antecedent sizes
		mutable nRoundCluster : int,          // perf counters (debug only)
		mutable nTryRounding : int,
		mutable nRoundTrmType : int,
		// re-entrant scratch pool for RoundUpCluster (the original uses fixed
		// arrays + move(); allocating per call dominated the profile)
		scratchFire : Vector<Vector<int>>,
		scratchStack : Vector<Vector<int>>,
		scratchIn : Vector<Vector<bool>>,
		mutable scratchDepth : int,
		// rounded-type memo, keyed by a structural term key. RoundUpTrmType is
		// a pure function of (term, cluster registry), and the registry is
		// fixed within an inference — the original amortizes the same work
		// through gTermCollection (InsertTermInTTColl). Cleared per inference.
		mutable roundMemo : Tree<string, MizTyp>,
		// THE ORIGINAL HAS NO MEMO: RoundUpTrmType recomputes every call and is
		// amortised only through gTermCollection, which is Mark/Remove scoped.
		// The port's memo is keyed by term STRUCTURE, so a constant number, and
		// the analyzer re-uses constant numbers across blocks without ever
		// clearing it. OFF on the analyzer path.
		mutable useRoundMemo : bool,
		// debug tooling only: trace the rounding of terms of this functor
		// number (`dbg-round=<nr>`); 0 = off
		mutable roundDbg : int,
		// S-C: THE TYPE-DERIVATION RECORD. Mizar derives type facts silently and
		// uses them as free premises; Russell has to prove each one, and could not
		// even see which registration produced which adjective. Every FIRING of a
		// registration during rounding is recorded here — the same
		// instrument-then-replay chain the checker's derivation record follows.
		// Off by default (`dump-rounding=` / the in-process switch), and the
		// rounded-type MEMO is bypassed while it is on, or a firing that a cached
		// type would have skipped goes unrecorded.
		roundRec : Vector<string>,
		mutable roundRecOn : bool,
		// perf diagnosis: the current and the deepest RoundUpTrmType nesting.
		// The original recurses here too, but its arguments are collected
		// InfConsts, so it bottoms out at depth 1; deep nesting means the port
		// is rounding RAW functor terms.
		mutable roundDepth : int,
		mutable roundMaxDepth : int,
	);

	mizClearRoundMemo(cl : MizClusters) -> void;
	// The recorded firings of the article's rounding. The sink is a module
	// global, as the checker's derivation switch is: the analyzer pass builds
	// its MizClusters internally and returns only the report, so threading a
	// record out through it would touch every caller for a debug artifact.
	mizRoundRecord() -> [string];
	mizRoundRecReset(on : bool) -> void;
	// the same sink, for the OTHER half of the type layer: the definitional
	// expansions the checker applies with no citation (definientia.flow)
	mizRoundRecOn() -> bool;
	// switch recording on without clearing what is already recorded (the
	// checker turns it on whenever the derivation record is on)
	mizRoundRecEnable() -> void;
	mizRoundRecPush(line : string) -> void;
	// install the structured term serializer used by the F half of the type
	// record (checker.flow passes mizDerivTrmXml)
	mizSetRoundTrmSer(f : (MizCorrelEnv, MizTrm) -> string) -> void;
	// the same lines, but only those recorded since the last clear — the
	// checker empties this at the start of each inference and flushes it into
	// that inference's derivation block, which is what attributes an expansion
	// to the by-step it served
	mizRoundPendingTake() -> [string];
	// XML attribute quoting for the record's payloads
	mizXmlQuote(s : string) -> string;

	mizMakeClusters() -> MizClusters;
	mizInsertRCluster(cl : MizClusters, r : MizRCluster) -> void;
	mizInsertCCluster(env : MizCorrelEnv, cl : MizClusters, c : MizCCluster) -> void;
	mizInsertFCluster(env : MizCorrelEnv, cl : MizClusters, f : MizFCluster) -> void;

	// MExtList.InsertExt / AddExtItems over the three cluster registries
	mizInsertRClusterExt(cl : MizClusters, r : MizRCluster) -> void;
	mizInsertCClusterExt(cl : MizClusters, c : MizCCluster) -> void;
	mizInsertFClusterExt(env : MizCorrelEnv, cl : MizClusters, f : MizFCluster) -> void;
	mizClustersAddExtItems(env : MizCorrelEnv, cl : MizClusters) -> void;

	// wire the rounding hooks of the env to these registries
	mizWireRoundcl(env : MizCorrelEnv, cl : MizClusters) -> void;

	// MCondClList.RoundUpCluster: round aCluster (of aTyp) up in place
	mizRoundUpCluster(env : MizCorrelEnv, cl : MizClusters,
		cluster : MizAttrColl, typ : MizTyp) -> void;

	// RoundUpTrmType: the term's type with functor + conditional rounding
	mizRoundUpTrmType(env : MizCorrelEnv, cl : MizClusters, t : MizTrm) -> MizTyp;

	// TypObj.RoundUp — round up a type's upper cluster in place
	mizTypRoundUp(env : MizCorrelEnv, cl : MizClusters, typ : MizTyp) -> void;

	mizSwapArguments(l : MizTrmList, first : int, second : int) -> MizTrmList;

	// MAttrCollection.EnlargeBy (correl.pas 2716): merge another cluster in
	mizAttrCollEnlargeBy(env : MizCorrelEnv, target : MizAttrColl, src : MizAttrColl) -> void;

	// The tail of Load_EnvConstructors (iocorrel.pas 3280-3341): once the
	// constructors and the registrations are in, round up the registrations'
	// types and EVERY mode/functor/selector constructor's result type, then
	// switch the env reader into its `AfterClusters` mode. Without this the
	// upper cluster of a derived mode's type never inherits the attributes of
	// the mode's own result type, and no `x is T` derivation works.
	mizEnvRoundUp(env : MizCorrelEnv, cl : MizClusters) -> void;

	// CmpFuncTrm / RoundUpWith(FClusterPtr,...) — needed by the re-rounding of
	// already-collected constants when the article declares a registration
	// (stdprep.pas FinishConditionalCluster / FinishFunctorCluster)
	mizCmpFuncTrm(env : MizCorrelEnv, a : MizTrm, b : MizTrm) -> int;

	// MSortedExtList.FindInterval over the functor clusters
	mizFClusterAt(cl : MizClusters, i : int) -> MizFCluster;
	mizFClusterInterval(env : MizCorrelEnv, cl : MizClusters,
		t : MizTrm) -> Maybe<Pair<int, int>>;
	// LocArgTyp[1..] := these primaries (the Pascal `move(...)` before every
	// RoundUpWith that may meet a LocusVar)
	mizSetLocArgTyp(env : MizCorrelEnv, prims : Vector<MizTyp>) -> void;
	mizFClusterRoundUpWith(env : MizCorrelEnv, fc : MizFCluster, t : MizTrm,
		typ : MizTyp, cluster : MizAttrColl) -> bool;
	// TryRounding for ONE conditional cluster against one type (the body the
	// FinishConditionalCluster loop repeats per collected constant)
	mizTryRounding(env : MizCorrelEnv, cond : MizCCluster, typ : MizTyp,
		cluster : MizAttrColl) -> bool;
}

mizMakeClusters() -> MizClusters {
	MizClusters(mizNewExtList(16),
		// the comparison is refreshed from the current environment at every
		// insert and every search (mizFClusterCompare); CmpFuncCluster reads
		// the constructor table, which the original has as a global.
		mizNewSortedExtList(16, \a : MizFCluster, b : MizFCluster -> 0),
		mizNewExtList(16),
		makeVector(64), makeVector(64), mizInitIntSeq(16), 0, 0, 0,
		makeVector(8), makeVector(8), makeVector(8), 0, makeTree(), true,
		s2i(getUrlParameterDef("dbg-round", "0")),
		makeVector(1), getUrlParameterDef("dump-rounding", "") != "" || ^mizRoundRecFlag,
		0, 0);
}

mizWireRoundcl(env : MizCorrelEnv, cl : MizClusters) -> void {
	env.roundUpTrmType ::= \e, t -> mizRoundUpTrmType(e, cl, t);
	env.roundUpCluster ::= \e, c, ty -> mizRoundUpCluster(e, cl, c, ty);
	env.enlargeBy ::= \e, t, src -> mizAttrCollEnlargeBy(e, t, src);
}

mizInsertRCluster(cl : MizClusters, r : MizRCluster) -> void {
	mizExtListInsert(cl.registered, r);
}

mizCondIndex(cl : MizClusters, neg : int) -> Vector<MizNatFunc> {
	if (neg == 0) cl.condIndexNeg else cl.condIndexPos;
}

mizCondIndexAt(cl : MizClusters, neg : int, adjNr : int) -> MizNatFunc {
	idx = mizCondIndex(cl, neg);
	while(\ -> sizeVector(idx) <= adjNr, \ -> pushVector(idx, mizInitNatSet(4)));
	getVectorUnsafe(idx, adjNr);
}

// MCondClList.Insert (roundcl.pas 154) = InsertExt + AddExtObject
mizInsertCCluster(env : MizCorrelEnv, cl : MizClusters, c : MizCCluster) -> void {
	if (mizTryAllDbg()) println("CCL " + c.article + ":" + i2s(c.absNr)
		+ " ante=[" + mizCluster2s(c.antecedent) + "]"
		+ " cons=[" + mizCluster2s(c.consequent.upper) + "]"
		+ " typ=" + mizFullTyp2s(c.clusterType)
		+ " prims=" + strGlue(map(vector2array(c.primaries), mizFullTyp2s), " "));
	mizExtListInsert(cl.conditional, c);
	mizIndexCCluster(env, cl, c, mizExtListCount(cl.conditional) - 1);
}

// The rest of MCondClList.AddExtObject (roundcl.pas 132): the committed
// cluster's number goes into the slot of every attribute of its antecedent,
// and its antecedent's size is the initial fire count.
mizIndexCCluster(env : MizCorrelEnv, cl : MizClusters, c : MizCCluster, nr : int) -> void {
	iterVector(c.antecedent.items, \a -> {
		mizNatInsertElem(mizCondIndexAt(cl, a.neg, mizAdjustedAttrNr(env, a)), nr);
	});
	mizSeqInsert(cl.initClFire, sizeVector(c.antecedent.items));
	{}
}

// FuncRedefNr — adjusted functor number
mizFuncRedefNr(env : MizCorrelEnv, funcNr : int) -> int {
	c = mizConstr(env, coFunctor, funcNr);
	if (c.whichConstrNr != 0) c.whichConstrNr else funcNr;
}

mizCmpFuncTrm(env : MizCorrelEnv, a : MizTrm, b : MizTrm) -> int {
	fa = mizTrmSort(a) == ikTrmFunctor;
	fb = mizTrmSort(b) == ikTrmFunctor;
	if (!fa) {
		if (!fb) 0 else -1;
	} else if (!fb) {
		1;
	} else {
		na = switch (a) { MizFuncTrm(__, funcNr, __, __, __): funcNr; default: 0; };
		nb = switch (b) { MizFuncTrm(__, funcNr, __, __, __): funcNr; default: 0; };
		mizCmpInt(mizFuncRedefNr(env, na), mizFuncRedefNr(env, nb));
	}
}

// MExtList.InsertExt over the three registries (mobjects.pas 1002)
mizInsertRClusterExt(cl : MizClusters, r : MizRCluster) -> void {
	mizExtListInsertExt(cl.registered, r);
}
mizInsertCClusterExt(cl : MizClusters, c : MizCCluster) -> void {
	mizExtListInsertExt(cl.conditional, c);
}
mizInsertFClusterExt(env : MizCorrelEnv, cl : MizClusters, f : MizFCluster) -> void {
	mizFClusterCompare(env, cl);
	mizSortedExtListInsertExt(cl.functor, f);
}

// AddExtItems (mobjects.pas 1058/1236, roundcl.pas 151). RegisteredCluster
// only moves the boundary; ConditionalCluster's own AddExtObject also indexes
// the antecedent (roundcl.pas 132); FunctorCluster's threads the item's
// position into fIndex through FindRight.
mizClustersAddExtItems(env : MizCorrelEnv, cl : MizClusters) -> void {
	mizExtListAddExtItems(cl.registered);
	while(\ -> mizExtListExtCount(cl.conditional) > 0, \ -> {
		c = mizExtListAtExt(cl.conditional, mizExtListCount(cl.conditional));
		mizExtListAddExtObject(cl.conditional);
		mizIndexCCluster(env, cl, c, mizExtListCount(cl.conditional) - 1);
	});
	mizFClusterCompare(env, cl);
	mizSortedExtListAddExtItems(cl.functor);
}

// CmpFuncCluster (correl.pas 1697) needs the constructor table, which the
// original reads from a global. Refresh the container's comparison with the
// current environment before any insert or search goes through fIndex.
mizFClusterCompare(env : MizCorrelEnv, cl : MizClusters) -> void {
	fc = cl.functor;
	fc.compare ::= \a : MizFCluster, b : MizFCluster ->
		mizCmpFuncTrm(env, a.clusterTerm, b.clusterTerm);
}

// MSortedExtList.Insert -> InsertExt + AddExtObject (mobjects.pas 1148/1224)
mizInsertFCluster(env : MizCorrelEnv, cl : MizClusters, f : MizFCluster) -> void {
	mizFClusterCompare(env, cl);
	mizSortedExtListInsert(cl.functor, f);
}

// AtIndex (mobjects.pas 1141) — Items^[fIndex^[i]]
mizFClusterAt(cl : MizClusters, i : int) -> MizFCluster {
	mizSortedExtListAtIndex(cl.functor, i);
}

// FindInterval (mobjects.pas 1128) — a BINARY search over fIndex, inclusive
// on both ends. It is a binary search over an order that the original never
// re-sorts, so it must stay one: a linear scan is not the same function once
// the order is stale.
mizFClusterInterval(env : MizCorrelEnv, cl : MizClusters, t : MizTrm) -> Maybe<Pair<int, int>> {
	mizFClusterCompare(env, cl);
	// FindInterval keys on a CLUSTER, and CmpFuncCluster compares the cluster
	// TERMS; the key is the sought term wrapped in a throw-away registration.
	key = MizFCluster("", 0, makeVector(0),
		MizClusterRec(MizAttrColl(makeVector(0), true, None()), MizAttrColl(makeVector(0), true, None())), t, None());
	r = mizSortedExtListFindInterval(cl.functor, key);
	if (r.first) Some(Pair(r.second, r.third)) else None();
}

// EnlargeBy under the loci substitution: insert instantiated copies
// InitInst; fCl^.EnlargeBy(consequent); StopInst — roundcl.pas 95 (TryRounding)
// and correl.pas 4324 (RoundUpWith). It is the MERGE, not an insert loop: a
// registration's consequent instantiated with the actual arguments can hold two
// TEXTUALLY IDENTICAL adjectives (two distinct loci collapsing onto one term),
// and the merge appends the exhausted-side tail without comparing, so both
// survive. field_4's reserved type keeps `<Adjective nr="326">` twice.
mizEnlargeByInst(env : MizCorrelEnv, target : MizAttrColl, src : MizAttrColl) -> void {
	mizInstFromSubstLocal(env);
	mizAttrCollMergeBy(env, target, src, \a -> MizAttr(a.neg, a.attrNr,
		mizInstCopyTrmList(env, a.args), false, a.pattNr));
	env.instantiated ::= false;
}

mizInstFromSubstLocal(env : MizCorrelEnv) -> void {
	clearVector(env.instantiation);
	pushVector(env.instantiation, mizNewIncorTrm());
	brk = ref false;
	k = ref 1;
	while(\ -> !^brk && ^k < sizeVector(env.substTrm), \ -> {
		switch (mizSubstTrmGet(env, ^k)) {
			Some(t): pushVector(env.instantiation, t);
			None(): brk := true;
		}
		k := ^k + 1;
	});
	env.instantiated ::= true;
	env.boundBase ::= env.boundVarNbr;
}

// TryRounding (roundcl.pas:78)
// debug tooling: trace every conditional cluster whose consequent carries
// this attribute number (`dbg-try=<nr>`); 0 = off
gMizTryDbg : ref int = ref -1;
gMizTryAll : ref int = ref -1;

mizTryRoundingDbg(cond : MizCCluster) -> bool {
	if (^gMizTryDbg < 0) gMizTryDbg := s2i(getUrlParameterDef("dbg-try", "0"));
	^gMizTryDbg != 0 && exists(vector2array(cond.consequent.upper.items),
		\a -> a.attrNr == ^gMizTryDbg);
}

// the DUAL-TRACE tap: `dbg-tryall=1` prints one line per TryRounding call in
// exactly the shape the oracle's own -dMDEBUG tap writes into <article>.inf,
// so the two decision streams diff line for line.
mizTryRoundLine(env : MizCorrelEnv, cond : MizCCluster, typ : MizTyp,
		cluster : MizAttrColl, r : int, a : int, w : int, c : int,
		l : int, k : int) -> void {
	println("TRYR " + cond.article + ":" + i2s(cond.absNr)
		+ " r" + i2s(r) + " a" + i2s(a) + " w" + i2s(w)
		+ " c" + i2s(c) + " l" + i2s(l) + " k" + i2s(k)
		+ " typ=" + mizFullTyp2s(typ) + " cl=[" + mizCluster2s(cluster) + "]");
}

mizTryAllDbg() -> bool {
	if (^gMizTryAll < 0) gMizTryAll := s2i(getUrlParameterDef("dbg-tryall", "0"));
	^gMizTryAll != 0;
}

mizTryRounding(env : MizCorrelEnv, cond : MizCCluster, typ : MizTyp,
		cluster : MizAttrColl) -> bool {
	if (!mizTypReachable(env, cond.clusterType, typ)) {
		if (mizTryAllDbg()) mizTryRoundLine(env, cond, typ, cluster, 0,0,0,0,0,0);
		false;
	} else {
		mizDisposeSubstTrm(env);
		ok = mizAttrCollIsSubsetOf(env, cond.antecedent, cluster,
				\x, y -> mizEsAttrRev(env, x, y))
			&& !mizAttrCollIsSubsetOf(env, cond.consequent.upper, cluster,
				\x, y -> mizAttrEquals(env, x, y));
		res = if (ok) {
			switch (mizWideningOf(env, cond.clusterType, mizCopyTyp(typ))) {
				Some(lTyp): {
					gEs = mizCompEsTyp(env, cond.clusterType, lTyp, false);
					gLo = gEs && mizAttrCollIsSubsetOf(env, cond.clusterType.lower,
						lTyp.upper, \x, y -> mizEsAttrRev(env, x, y));
					gLoci = gLo && mizCheckLociTypes(env, cond.primaries);
					if (gLoci) {
						if (mizTryRoundingDbg(cond)) {
							println("  TRY " + cond.article + ":" + i2s(cond.absNr)
								+ " typ=" + mizFullTyp2s(typ) + " FIRED"
								+ " ante=[" + mizCluster2s(cond.antecedent) + "]"
								+ " clTyp=" + mizFullTyp2s(cond.clusterType)
								+ " conseq=[" + mizCluster2s(cond.consequent.upper) + "]"
								+ " subst=[" + strGlue(mapi(vector2array(env.substTrm),
									\si, sm -> switch (sm) {
										Some(st): "A" + i2s(si + 1) + "/" + mizTrm2s(st);
										None(): "";
									}), " ") + "]");
						}
						mizEnlargeByInst(env, cluster, cond.consequent.upper);
						if (mizTryAllDbg()) mizTryRoundLine(env, cond, typ, cluster,
							1, 1, 1, 1, 1, 1);
						if (mizTryRoundingDbg(cond)) {
							println("      -> cluster=[" + mizCluster2s(cluster) + "]");
						}
						true;
					} else {
						if (mizTryRoundingDbg(cond)) {
							println("  TRY " + cond.article + ":" + i2s(cond.absNr)
								+ " typ=" + mizFullTyp2s(typ)
								+ " compEsTyp=" + b2s(gEs) + " lowerSubset=" + b2s(gLo)
								+ " checkLoci=" + b2s(gLoci));
						}
						if (mizTryAllDbg()) mizTryRoundLine(env, cond, typ, cluster,
							1, 1, 1, b2i(gEs), b2i(gLo), b2i(gLoci));
						false;
					}
				}
				None(): {
					if (mizTryAllDbg()) mizTryRoundLine(env, cond, typ, cluster,
						1, 1, 0, 0, 0, 0);
					if (mizTryRoundingDbg(cond)) {
						println("  TRY " + cond.article + ":" + i2s(cond.absNr)
							+ " typ=" + mizFullTyp2s(typ) + " NO WIDENING onto "
							+ mizFullTyp2s(cond.clusterType));
					}
					false;
				}
			}
		} else {
			if (mizTryAllDbg()) mizTryRoundLine(env, cond, typ, cluster,
				1, 0, 0, 0, 0, 0);
			if (mizTryRoundingDbg(cond)) {
				// is either collection actually sorted by CompAbsAttr? every
				// subset/search over them is a binary search and assumes it
				sortedness = \cc : MizAttrColl -> {
					bad = ref 0;
					fori(1, sizeVector(cc.items) - 1, \k ->
						if (mizCompAbsAttr(env, getVectorUnsafe(cc.items, k - 1),
								getVectorUnsafe(cc.items, k)) > 0) bad := ^bad + 1);
					^bad;
				};
				println("  TRY " + cond.article + ":" + i2s(cond.absNr)
					+ " guard: anteOrAlready"
					+ " ante=[" + mizCluster2s(cond.antecedent) + "]"
					+ " have=[" + mizCluster2s(cluster) + "]"
					+ " anteAdj=[" + strGlue(map(vector2array(cond.antecedent.items),
						\aa -> i2s(mizAdjustedAttrNr(env, aa))), ",") + "]"
					+ " unsortedAnte=" + i2s(sortedness(cond.antecedent))
					+ " unsortedHave=" + i2s(sortedness(cluster)));
			}
			false;
		}
		mizDisposeSubstTrm(env);
		res;
	}
}

// MCondClList.RoundUpCluster — the graph-chasing loop
mizRoundUpCluster(env : MizCorrelEnv, cl : MizClusters,
		cluster : MizAttrColl, typ : MizTyp) -> void {
	cl.nRoundCluster ::= cl.nRoundCluster + 1;
	nCond = mizExtListCount(cl.conditional);
	if (nCond > 0) {
		// this recursion level's scratch buffers (grown once, then reused)
		depth = cl.scratchDepth;
		cl.scratchDepth ::= depth + 1;
		while(\ -> sizeVector(cl.scratchFire) <= depth, \ -> {
			pushVector(cl.scratchFire, makeVector(nCond));
			pushVector(cl.scratchStack, makeVector(32));
			pushVector(cl.scratchIn, makeVector(nCond));
		});
		clFire : Vector<int> = getVectorUnsafe(cl.scratchFire, depth);
		jobStack : Vector<int> = getVectorUnsafe(cl.scratchStack, depth);
		inJobs : Vector<bool> = getVectorUnsafe(cl.scratchIn, depth);
		clearVector(jobStack);
		while(\ -> sizeVector(clFire) < nCond, \ -> pushVector(clFire, 0));
		while(\ -> sizeVector(inJobs) < nCond, \ -> pushVector(inJobs, false));
		fori(0, nCond - 1, \j -> {
			setVectorUnsafe(clFire, j, mizSeqValue(cl.initClFire, j));
			setVectorUnsafe(inJobs, j, false);
		});
		// lJobs is a NatSet (roundcl.pas 197) and PopNatSet takes Items[Count-1]
		// — the LARGEST cluster number pending, not the most recently pushed.
		// The order is semantic: TryRounding skips a cluster whose consequent is
		// already a subset of the cluster BY ADJUSTED ATTRIBUTE NUMBER, so
		// whichever cluster supplies an attribute first decides the ARGUMENTS
		// that attribute keeps. A LIFO stack reaches FINSEQ_1:7 (`V4({})`)
		// before RELSET_1:2 (`V4(A1) V5(A2)`) and the type ends up with the
		// constant arguments instead of its own (mfold_2 65:16).
		oldPos = mizInitNatFunc(32);
		oldNeg = mizInitNatFunc(32);

		// clusters with empty antecedent fire immediately. This one stays a
		// `fori`: its trip count is nCond, the whole environment's conditional
		// cluster count, so recursion here would add that many frames under an
		// already deeply nested RoundUpCluster.
		fori(0, nCond - 1, \j -> {
			if (getVectorUnsafe(clFire, j) == 0) mizRucPushJob(jobStack, inJobs, j);
		});
		cur = ref mizRucHandleUsageAndFire(env, cl, cluster, clFire, jobStack,
			inJobs, oldPos, oldNeg);
		// THE JOB LOOP STAYS A `while`: it is a WORK LIST, so its iteration
		// count is not bounded by any structure, and java has no TCE.
		while(\ -> cluster.consistent && sizeVector(jobStack) > 0, \ -> {
			last = getVectorUnsafe(jobStack, sizeVector(jobStack) - 1);
			removeVector(jobStack, sizeVector(jobStack) - 1);
			setVectorUnsafe(inJobs, last, false);
			ccRec = if (!cl.roundRecOn && !^mizRoundRecFlag) "" else mizCluster2s(cluster);
			ccCl = mizExtListAt(cl.conditional, last);
			if (mizTryRounding(env, ccCl, typ, cluster)) {
				if (cl.roundRecOn || ^mizRoundRecFlag)
					pushVector(mizRoundRecSink, "<Round kind=\"C\" article=\"" + ccCl.article
						+ "\" nr=\"" + i2s(ccCl.absNr) + "\" typ=\"" + mizXmlQuote(mizFullTyp2s(typ))
						+ "\" before=\"" + mizXmlQuote(ccRec) + "\" after=\""
						+ mizXmlQuote(mizCluster2s(cluster)) + "\"/>");
				cur := mizRucHandleUsageAndFire(env, cl, cluster, clFire,
					jobStack, inJobs, (^cur).first, (^cur).second);
			}
		});
		cl.scratchDepth ::= depth;
	}
}

// ---- RoundUpCluster's inner routines, hoisted out of the body ----
// They were local lambdas, so every RoundUpCluster call allocated four
// closures (and doSide two more per HandleUsageAndFire) before doing any work.
// The logic is unchanged; the captured state is passed explicitly.

// AddJob (roundcl.pas 197): lJobs is a NatSet, so the stack is kept ASCENDING
// and PopNatSet takes the LARGEST pending cluster number. See the note at the
// call site — the order is semantic, not an implementation choice.
mizRucPushJob(jobStack : Vector<int>, inJobs : Vector<bool>, nr : int) -> void {
	if (!getVectorUnsafe(inJobs, nr)) {
		setVectorUnsafe(inJobs, nr, true);
		mizVectorAtInsert(jobStack,
			mizRucInsertPos(jobStack, 0, sizeVector(jobStack), nr), nr);
	}
}

// the original walks DOWN from the top while the element below is greater,
// which lands on the count of elements <= nr. The stack is ascending and nr is
// never already in it (inJobs guards that), so a binary search for the same
// boundary gives the same index — and its depth is log2, not the stack size.
mizRucInsertPos(jobStack : Vector<int>, lo : int, hi : int, nr : int) -> int {
	if (lo >= hi) {
		lo;
	} else {
		mid = (lo + hi) / 2;
		if (getVectorUnsafe(jobStack, mid) < nr)
			mizRucInsertPos(jobStack, mid + 1, hi, nr)
		else mizRucInsertPos(jobStack, lo, mid, nr);
	}
}

// CountAdjAttrs: occurrences per adjusted attribute number, positive and
// negative sides apart
mizRucCountAdj(env : MizCorrelEnv, c : MizAttrColl) -> Pair<MizNatFunc, MizNatFunc> {
	np = mizInitNatFunc(32);
	nn = mizInitNatFunc(32);
	iterVector(c.items, \a -> {
		if (a.neg == 1) mizNatUp(np, mizAdjustedAttrNr(env, a))
		else mizNatUp(nn, mizAdjustedAttrNr(env, a));
	});
	Pair(np, nn);
}

mizRucDoSide(env : MizCorrelEnv, cl : MizClusters, clFire : Vector<int>,
		jobStack : Vector<int>, inJobs : Vector<bool>, newF : MizNatFunc,
		oldF : MizNatFunc, neg : int) -> void {
	fori(0, mizNatCount(newF) - 1, \i -> {
		it = mizNatItem(newF, i);
		oldVal = if (mizNatHasInDom(oldF, it.x)) mizNatValue(oldF, it.x) else -1;
		if (oldVal < it.y) {
			idxSet = mizCondIndexAt(cl, neg, it.x);
			fori(0, mizNatCount(idxSet) - 1, \k -> {
				clNr = mizNatItem(idxSet, k).x;
				setVectorUnsafe(clFire, clNr, getVectorUnsafe(clFire, clNr) - 1);
				if (getVectorUnsafe(clFire, clNr) <= 0) {
					mizRucPushJob(jobStack, inJobs, clNr);
				}
			});
		}
	});
}

mizRucHandleUsageAndFire(env : MizCorrelEnv, cl : MizClusters,
		cluster : MizAttrColl, clFire : Vector<int>, jobStack : Vector<int>,
		inJobs : Vector<bool>, oldP : MizNatFunc,
		oldN : MizNatFunc) -> Pair<MizNatFunc, MizNatFunc> {
	pq = mizRucCountAdj(env, cluster);
	mizRucDoSide(env, cl, clFire, jobStack, inJobs, pq.first, oldP, 1);
	mizRucDoSide(env, cl, clFire, jobStack, inJobs, pq.second, oldN, 0);
	pq;
}

// SwapArguments (1-based positions)
mizSwapArguments(l : MizTrmList, first : int, second : int) -> MizTrmList {
	v = mizTrmList2Vector(l);
	n = sizeVector(v);
	if (first >= 1 && first <= n && second >= 1 && second <= n) {
		a : MizTrm = getVectorUnsafe(v, first - 1);
		b : MizTrm = getVectorUnsafe(v, second - 1);
		setVectorUnsafe(v, first - 1, b);
		setVectorUnsafe(v, second - 1, a);
	}
	mizVector2TrmList(v);
}

// RoundUpWith for one functor cluster (correl.pas:4278)
mizFClusterRoundUpWith(env : MizCorrelEnv, fc : MizFCluster, t : MizTrm,
		typ : MizTyp, cluster : MizAttrColl) -> bool {
	if (mizTryAllDbg()) println("FRW " + fc.article + ":" + i2s(fc.absNr)
		+ " on=" + mizTrm2s(t));
	mizDisposeSubstTrm(env);
	snap = mizSnapshotSubst(env);   // bitmask; see correl.flow
	lEq0 = mizEsTrm(env, fc.clusterTerm, t) && mizCheckLociTypes(env, fc.primaries);
	lEq = if (!lEq0 && mizTrmSort(t) == ikTrmFunctor) {
		ft = switch (t) {
			MizFuncTrm(__, __, __, __, __): t;
			default: MizFuncTrm(ikError, 0, MizTrmNil(), 0, 0);
		}
		c = mizConstr(env, coFunctor, ft.funcNr);
		if (mizHasProperty(c, syCommutativity)) {
			lTrm = mizNewFuncTrm(ft.funcNr,
				mizSwapArguments(ft.args, c.firstArg, c.secondArg));
			// undo bindings from the failed direct match
			mizResetSubstToSnap(env, snap);
			mizEsTrm(env, fc.clusterTerm, lTrm) && mizCheckLociTypes(env, fc.primaries);
		} else {
			false;
		}
	} else {
		lEq0;
	}
	res = if (lEq) {
		typOk = switch (fc.clusterType) {
			Some(ct): {
				switch (mizWideningOf(env, ct, mizCopyTyp(typ))) {
					Some(lTyp): {
						mizCompEsTyp(env, ct, lTyp, false)
						&& mizAttrCollIsSubsetOf(env, ct.lower, lTyp.upper,
							\x, y -> mizEsAttrRev(env, x, y))
						&& mizCheckLociTypes(env, fc.primaries);
					}
					None(): false;
				}
			}
			None(): true;
		}
		if (typOk) {
			mizEnlargeByInst(env, cluster, fc.consequent.upper);
			true;
		} else {
			false;
		}
	} else {
		false;
	}
	mizDisposeSubstTrm(env);
	res;
}

// the same undo as mizResetNewerSubst, over the bitmask snapshot
mizResetSubstToSnap(env : MizCorrelEnv, snap : int) -> void {
	mizResetNewerSubst(env, snap);
}

// RoundUpTrmTypeWithType (correl.pas:1104)
mizRoundUpTrmTypeWithType(env : MizCorrelEnv, cl : MizClusters,
		typ0 : MizTyp, t : MizTrm) -> MizTyp {
	if (mizTryAllDbg()) println("RUT " + mizTrm2s(t) + " " + mizFullTyp2s(typ0));
	srt = mizTrmSort(t);
	typ = typ0;
	dbg = cl.roundDbg != 0
		&& (srt == ikTrmFunctor || srt == ikTrmSelector || srt == ikTrmAggreg)
		&& (switch (t) { MizFuncTrm(__, fn, __, __, __): fn == cl.roundDbg; default: false; });
	if (dbg) println("ROUND " + mizTrm2s(t) + " start " + mizFullTyp2s(typ)
		+ (switch (t) {
			MizFuncTrm(__, __, aaR, __, __): " args=" + strGlue(map(
				enumFromTo(0, mizTrmListLength(aaR) - 1),
				\zR -> { aR = mizTrmListNth(aaR, zR);
					mizTrm2s(aR) + ":" + mizFullTyp2s(mizCopyTrmType(env, aR)); }), " | ");
			default: "";
		}));
	if (srt == ikTrmFunctor || srt == ikTrmSelector || srt == ikTrmAggreg) {
		switch (mizFClusterInterval(env, cl, t)) {
			None(): {}
			Some(iv): {
				used = mizInitIntSeq(4);
				cluster = ref mizCopyCluster(typ.upper);
				i = ref iv.first;
				inconsistent = ref false;
				while(\ -> !^inconsistent && ^i <= iv.second, \ -> {
					if (mizIntSetIsInSet(used, ^i)) {
						i := ^i + 1;
					} else {
						fc : MizFCluster = mizFClusterAt(cl, ^i);
						// the FUNCTOR registration's own contribution, recorded before the
						// conditional round-up that follows it mixes further attributes in.
						// The C half of the type record has always been written (kind="C"
						// in RoundUpCluster); this is the F half, which was only ever a
						// debug print, so the emitter could not see WHICH registration gave
						// a term its attributes.
						fcRec = if (!cl.roundRecOn && !^mizRoundRecFlag) "" else mizCluster2s(^cluster);
						fired = mizFClusterRoundUpWith(env, fc, t, typ, ^cluster);
						if (dbg) println("  ROUND fc[" + i2s(^i) + "] "
							+ fc.article + ":" + i2s(fc.absNr)
							+ (if (fired) " FIRED -> [" + mizCluster2s(^cluster) + "]"
								else " no"));
						if (fired && (cl.roundRecOn || ^mizRoundRecFlag))
							// the term is serialized STRUCTURALLY as well as displayed: the
							// emitter has to rebuild it in the article's dialect, and a display
							// string cannot be translated back
							pushVector(mizRoundRecSink, "<Round kind=\"F\" article=\"" + fc.article
								+ "\" nr=\"" + i2s(fc.absNr) + "\" trm=\"" + mizXmlQuote(mizTrm2s(t))
								+ "\" typ=\"" + mizXmlQuote(mizFullTyp2s(typ))
								+ "\" before=\"" + mizXmlQuote(fcRec) + "\" after=\""
								+ mizXmlQuote(mizCluster2s(^cluster)) + "\">\n"
								+ (^mizRoundTrmSerRef)(env, t) + "</Round>");
						if (fired) {
							mizRoundUpCluster(env, cl, ^cluster, typ);
							typ.upper ::= ^cluster;
							if (!(^cluster).consistent) {
								inconsistent := true;
							} else {
								cluster := mizCopyCluster(typ.upper);
								__u2 = mizIntSetInsert(used, ^i);
								if (isSome(fc.clusterType)) {
									i := iv.first; // restart the interval
								} else {
									i := ^i + 1;
								}
							}
						} else {
							if (isNone(fc.clusterType)) {
								__u = mizIntSetInsert(used, ^i);
								{}
							}
							i := ^i + 1;
						}
					}
				});
			}
		}
	}
	typ;
}

mizRoundRecSink : Vector<string> = makeVector(1024);
mizRoundRecFlag : ref bool = ref false;
// THE STRUCTURED TERM SERIALIZER, installed from above. roundcl sits below
// the analyzer-report writer in the import order (it imports ds/vector only),
// so the type record reaches the writer the same way rounding reaches correl —
// by a hook. Unset, the record carries the display string alone.
mizRoundTrmSerRef : ref (MizCorrelEnv, MizTrm) -> string = ref \__, __ -> "";

mizRoundRecord() -> [string] { vector2array(mizRoundRecSink); }

mizRoundRecEnable() -> void { mizRoundRecFlag := true; }

mizRoundRecOn() -> bool { ^mizRoundRecFlag || getUrlParameterDef("dump-rounding", "") != ""; }

mizRoundPendingSink : Vector<string> = makeVector(64);

mizRoundRecPush(line : string) -> void {
	pushVector(mizRoundRecSink, line);
	pushVector(mizRoundPendingSink, line);
}

mizSetRoundTrmSer(f : (MizCorrelEnv, MizTrm) -> string) -> void {
	mizRoundTrmSerRef := f;
}

mizRoundPendingTake() -> [string] {
	out = vector2array(mizRoundPendingSink);
	clearVector(mizRoundPendingSink);
	out;
}

mizRoundRecReset(on : bool) -> void {
	clearVector(mizRoundRecSink);
	mizRoundRecFlag := on;
}

mizXmlQuote(s : string) -> string {
	fold([Pair("&", "&amp;"), Pair("\"", "&quot;"), Pair("<", "&lt;"), Pair(">", "&gt;")],
		s, \acc, p -> strReplace(acc, p.first, p.second));
}

mizClearRoundMemo(cl : MizClusters) -> void {
	cl.roundMemo ::= makeTree();
}

// structural key for the rounded-type memo
mizTrmKey(t : MizTrm) -> string {
	switch (t) {
		MizVarTrm(srt, varNr, __, __): "v" + i2s(srt) + ":" + i2s(varNr);
		MizFuncTrm(srt, funcNr, args, __, __):
			"f" + i2s(srt) + ":" + i2s(funcNr) + "(" + mizTrmListKey(args) + ")";
		MizPrivFuncTrm(funcNr, args, __, __, __):
			"p" + i2s(funcNr) + "(" + mizTrmListKey(args) + ")";
		default: "?";
	}
}

mizTrmListKey(l : MizTrmList) -> string {
	switch (l) {
		MizTrmNil(): "";
		MizTrmElem(trm, next): mizTrmKey(trm) + "," + mizTrmListKey(next);
	}
}

mizRoundUpTrmType(env : MizCorrelEnv, cl : MizClusters, t0 : MizTrm) -> MizTyp {
	cl.nRoundTrmType ::= cl.nRoundTrmType + 1;
	cl.roundDepth ::= cl.roundDepth + 1;
	if (cl.roundDepth > cl.roundMaxDepth) {
		cl.roundMaxDepth ::= cl.roundDepth;
		if (cl.roundDepth == s2i(getUrlParameterDef("dbg-depth", "0"))) {
			println("  DEPTH " + i2s(cl.roundDepth) + " reached at " + mizTrm2s(t0));
		}
	}
	res0 = mizRoundUpTrmTypeBody(env, cl, t0);
	cl.roundDepth ::= cl.roundDepth - 1;
	res0;
}

mizRoundUpTrmTypeBody(env : MizCorrelEnv, cl : MizClusters, t0 : MizTrm) -> MizTyp {
	t = mizSkipPrivFunc(t0);
	srt = mizTrmSort(t);
	if (srt == ikTrmFunctor || srt == ikTrmSelector || srt == ikTrmAggreg) {
		key = mizTrmKey(t);
		if (!cl.useRoundMemo || cl.roundRecOn || ^mizRoundRecFlag
			|| getUrlParameterDef("no-round-memo", "") == "1"
			|| key == "?" || strContains(key, "?")) {
			mizRoundUpTrmTypeWithType(env, cl, mizCopyTrmType(env, t), t);
		} else {
			switch (lookupTree(cl.roundMemo, key)) {
				Some(cached): mizCopyTyp(cached);
				None(): {
					res = mizRoundUpTrmTypeWithType(env, cl, mizCopyTrmType(env, t), t);
					cl.roundMemo ::= setTree(cl.roundMemo, key, mizCopyTyp(res));
					res;
				}
			}
		}
	} else {
		mizRoundUpTrmTypeWithType(env, cl, mizCopyTrmType(env, t), t);
	}
}

mizTypRoundUp(env : MizCorrelEnv, cl : MizClusters, typ : MizTyp) -> void {
	cluster = mizCopyCluster(typ.upper);
	mizRoundUpCluster(env, cl, cluster, typ);
	typ.upper ::= cluster;
}

// ---------------- the environment round-up (Load_EnvConstructors tail) ----------------

// MAttrCollection.EnlargeBy (correl.pas 2716) — a LINEAR MERGE of two sorted
// lists, NOT "insert each item of src".
// ★ THE DIFFERENCE IS OBSERVABLE AND IT MATTERS. WithinAttrCollection
//   (ChangeToLoci, instantiation) rewrites the argument terms IN PLACE and
//   never re-sorts, so a collection's order goes stale. The merge only ever
//   compares the two current heads, so an equal pair sitting out of order is
//   never detected and BOTH survive; re-inserting through the binary Search
//   finds the duplicate wherever it is and drops it. field_4's reserved type
//   keeps `<Adjective nr="326">` TWICE. The merge also does not re-sort, so
//   its output order is the merge order — matrtop1's two `<Adjective nr="4">`
//   come out in the stale constant order, not in locus order.
mizAttrCollEnlargeBy(env : MizCorrelEnv, target : MizAttrColl, src : MizAttrColl) -> void {
	mizAttrCollMergeBy(env, target, src, \a -> MizAttr(a.neg, a.attrNr,
		mizCopyTrmList(a.args), false, a.pattNr));
}

// the merge body, parameterised by AttrObj.CopyAttribute — which under the
// instantiation protocol (InitInst) copies the argument terms THROUGH the
// substitution, so TryRounding / RoundUpWith get the same merge with an
// instantiating copy (roundcl.pas 95, correl.pas 4324)
mizAttrCollMergeBy(env : MizCorrelEnv, target : MizAttrColl, src : MizAttrColl,
		copyAttr : (MizAttr) -> MizAttr) -> void {
	if (target.consistent) {
		if (!src.consistent) {
			target.refutedBy ::= src.refutedBy;
			target.consistent ::= false;
			clearVector(target.items);
		} else if (sizeVector(src.items) != 0) {
			lItems : Vector<MizAttr> = makeVector(sizeVector(target.items));
			iterVector(target.items, \a -> pushVector(lItems, a));
			lCount = sizeVector(lItems);
			clearVector(target.items);
			i = ref 0;
			j = ref 0;
			refuted = ref false;
			brk = ref false;
			while(\ -> !^brk && !^refuted && ^i < lCount, \ -> {
				oldA : MizAttr = getVectorUnsafe(lItems, ^i);
				// Pascal builds the copy FIRST and compares against it
				newA : MizAttr = copyAttr(getVectorUnsafe(src.items, ^j));
				c = mizCompAbsAttr(env, oldA, newA);
				if (c < 0) {
					// `continue` WITHOUT inc(j)
					pushVector(target.items, oldA);
					i := ^i + 1;
				} else {
					if (c == 0) {
						if (newA.neg != oldA.neg) {
							target.refutedBy ::= Some(Pair(oldA, newA));
							clearVector(target.items);
							target.consistent ::= false;
							refuted := true;
						} else {
							pushVector(target.items, oldA);
							i := ^i + 1;
						}
					} else {
						pushVector(target.items, newA);
					}
					if (!^refuted) {
						j := ^j + 1;
						if (^j >= sizeVector(src.items)) brk := true;
					}
				}
			});
			if (!^refuted) {
				if (^i >= lCount) {
					fori(^j, sizeVector(src.items) - 1, \k ->
						pushVector(target.items, copyAttr(getVectorUnsafe(src.items, k))));
				} else {
					fori(^i, lCount - 1, \k ->
						pushVector(target.items, getVectorUnsafe(lItems, k)));
				}
			}
		}
	}
}

// LocArgTyp[1..] := the primaries (the Pascal `move(...)` before every
// RoundUpWith that may meet a LocusVar)
mizSetLocArgTyp(env : MizCorrelEnv, prims : Vector<MizTyp>) -> void {
	while(\ -> sizeVector(env.locArgTyp) <= sizeVector(prims), \ ->
		pushVector(env.locArgTyp, mizNewIncorTyp()));
	fori(0, sizeVector(prims) - 1, \i ->
		setVectorUnsafe(env.locArgTyp, i + 1, getVectorUnsafe(prims, i)));
}

// ConstrTypObj.RoundUp (correl.pas 1498): the result type's upper cluster is
// its own lower cluster, PLUS the mode's result-type upper cluster
// instantiated with the type's arguments, all rounded with the conditional
// registrations.
mizConstrTypRoundUp(env : MizCorrelEnv, cl : MizClusters, c : MizConstr) -> void {
	switch (c.typ) {
		None(): {}
		Some(t): {
			cluster = mizCopyCluster(t.lower);
			if (t.sort == ikTypMode) {
				mc = mizConstr(env, coMode, t.modNr);
				switch (mc.typ) {
					Some(mt): {
						inst = mizInstCluster(env, mt.upper, t.modArgs);
						mizAttrCollEnlargeBy(env, cluster, inst);
					}
					None(): {}
				}
			}
			mizSetLocArgTyp(env, c.primaries);
			mizRoundUpCluster(env, cl, cluster, t);
			t.upper ::= cluster;
			// dual-trace tap for ConstrTypObj.RoundUp (correl.pas 1498)
			if (mizTryAllDbg()) println("CRU " + i2s(c.kind) + " " + i2s(c.absNr)
				+ " typ=" + mizFullTyp2s(t) + " upper=[" + mizCluster2s(t.upper) + "]");
		}
	}
}

mizEnvRoundUp(env : MizCorrelEnv, cl : MizClusters) -> void {
	// registered clusters: every primary type, then the consequent
	iter(mizExtListItems(cl.registered), \r -> {
		if (mizTryAllDbg()) println("RCL " + i2s(r.absNr) + " " + r.article
			+ " cons=[" + mizCluster2s(r.consequent.upper) + "]"
			+ " typ=" + mizFullTyp2s(r.clusterType)
			+ " prims=" + strGlue(map(vector2array(r.primaries), mizFullTyp2s), " "));
		iterVector(r.primaries, \ty -> {
			mizSetLocArgTyp(env, r.primaries);
			cluster = mizCopyCluster(ty.upper);
			mizRoundUpCluster(env, cl, cluster, ty);
			ty.upper ::= cluster;
			mizClearRoundMemo(cl);
		mizTTCollFreeAll(env); // gTermCollection.FreeAll
			mizTTCollFreeAll(env); // gTermCollection.FreeAll
		});
		mizSetLocArgTyp(env, r.primaries);
		mizRoundUpCluster(env, cl, r.consequent.upper, r.clusterType);
		mizClearRoundMemo(cl);
		mizTTCollFreeAll(env); // gTermCollection.FreeAll
	});
	// functor clusters: the consequent is enlarged by the cluster type's own
	// upper cluster (the term's rounded type when no type is given)
	iter(mizSortedExtListItems(cl.functor), \f -> {
		if (mizTryAllDbg()) println("FCL " + f.article + ":" + i2s(f.absNr)
			+ " trm=" + mizTrm2s(f.clusterTerm)
			+ " cons=[" + mizCluster2s(f.consequent.upper) + "]"
			+ " prims=" + strGlue(map(vector2array(f.primaries), mizFullTyp2s), " "));
		mizSetLocArgTyp(env, f.primaries);
		ty = switch (f.clusterType) {
			Some(t): t;
			None(): mizRoundUpTrmType(env, cl, f.clusterTerm);
		};
		mizAttrCollEnlargeBy(env, f.consequent.upper, ty.upper);
		mizRoundUpCluster(env, cl, f.consequent.upper, ty);
		mizClearRoundMemo(cl);
		mizTTCollFreeAll(env); // gTermCollection.FreeAll
	});
	// and every mode / functor / selector constructor's result type
	iter([coMode, coFunctor, coSelector], \k -> {
		fori(1, mizConstrCount(env, k), \i -> {
			mizConstrTypRoundUp(env, cl, mizConstr(env, k, i));
			mizClearRoundMemo(cl);
		mizTTCollFreeAll(env); // gTermCollection.FreeAll
			mizTTCollFreeAll(env); // gTermCollection.FreeAll
		});
	});
	env.afterClusters ::= true;
}
