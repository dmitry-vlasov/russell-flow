// Transcription of ~/dev/system/kernel/polynom.pas — the polynomial values:
// monomials (coefficient x power product over class variables) and sorted
// polynomial collections with Add/Mult/Diff/NthPower/NMult, the comparisons,
// and variable substitution (InsertValue). Coefficients are DOUBLES here —
// the recorded deviation from the original's exact rational complex numbers
// (numbers.pas RComplex). Groebner-basis machinery stays staged; only what
// the equalizer pipeline consumes is here.

import ds/vector;
import loop;
import math/math;
import mizar/original/errhan;
import mizar/original/mobjects;
import mizar/original/numbers;
import net/url_parameter;
import mizar/original/identify;

export {
	MizMonomial(
		mutable coeff : MizCplx,
		powers : MizNatFunc,                 // var -> exponent, sorted
	);

	// sorted by CompareMonomials (lex)
	MizPolynomial(monos : Vector<MizMonomial>);

	mizPolyWithNumeric(v : MizCplx) -> MizPolynomial;
	mizPolyWithMonomial(c : MizCplx, varNr : int) -> MizPolynomial;
	mizCopyPoly(p : MizPolynomial) -> MizPolynomial;

	mizPolyIsNumeric(p : MizPolynomial) -> bool;
	mizPolyIsNumericEqualWith(p : MizPolynomial, v : MizCplx) -> bool;
	mizPolyGetNumeric(p : MizPolynomial) -> MizCplx;
	mizPolyIsVariable(p : MizPolynomial) -> int;          // var nr or 0
	mizPolyIsUniVariantVariable(p : MizPolynomial) -> int;
	mizPolyHasTheVariable(p : MizPolynomial, varNr : int) -> bool;

	mizCompareMonomials(a : MizMonomial, b : MizMonomial) -> int;
	mizStdComparePolynomials(a : MizPolynomial, b : MizPolynomial) -> int;
	mizComparePolynomials(a : MizPolynomial, b : MizPolynomial) -> int;

	mizAddPolynomials(a : MizPolynomial, b : MizPolynomial) -> MizPolynomial;
	mizMultPolynomials(a : MizPolynomial, b : MizPolynomial) -> MizPolynomial;
	mizDiffPolynomials(a : MizPolynomial, b : MizPolynomial) -> MizPolynomial;
	mizNMultPolynomial(v : MizCplx, p : MizPolynomial) -> MizPolynomial;

	// substitute varNr := q in place
	mizPolyInsertValue(p : MizPolynomial, varNr : int, q : MizPolynomial) -> void;

	mizPolySortedInsert(v : Vector<MizPolynomial>, p : MizPolynomial) -> void;
	mizPolyInsert(p : MizPolynomial, m : MizMonomial) -> void;
	mizNewMonomialPub(c : MizCplx) -> MizMonomial;
	mizGaussElimination(aEqs0 : Vector<MizPolynomial>) -> Pair<Vector<MizPolynomial>, int>;
	mizLinearEquationReduce(aEq0 : MizPolynomial, equations : Vector<MizPolynomial>) -> MizPolynomial;
	mizNatCompareGraph(f : MizNatFunc, g : MizNatFunc) -> int;
}

// the coefficients are EXACT complex rationals (numbers.flow); these are the
// original's ComplexAdd/Sub/Mult/Neg and CompareComplex
mizCZeroP = mizCplxZero;
mizCOneP = mizCplxOne;

cEq0(v : MizCplx) -> bool { mizCplxIsZero(v) }
cEq1(v : MizCplx) -> bool { mizCplxEq(v, mizCplxOne) }
cAdd(a : MizCplx, b : MizCplx) -> MizCplx { mizCplxAdd(a, b) }
cSub(a : MizCplx, b : MizCplx) -> MizCplx { mizCplxSub(a, b) }
cMul(a : MizCplx, b : MizCplx) -> MizCplx { mizCplxMul(a, b) }
cNeg(a : MizCplx) -> MizCplx { mizCplxNeg(a) }
cCmp(a : MizCplx, b : MizCplx) -> int { mizCplxCmp(a, b) }

mizNewMonomial(c : MizCplx) -> MizMonomial {
	MizMonomial(c, mizInitNatFunc(4));
}

mizCopyMonomial(m : MizMonomial) -> MizMonomial {
	MizMonomial(m.coeff, mizCopyNatFunc(m.powers));
}

mizPolyWithNumeric(v : MizCplx) -> MizPolynomial {
	p = MizPolynomial(makeVector(2));
	pushVector(p.monos, mizNewMonomial(v));
	p;
}

mizPolyWithMonomial(c : MizCplx, varNr : int) -> MizPolynomial {
	m = mizNewMonomial(c);
	mizNatAssign(m.powers, varNr, 1);
	p = MizPolynomial(makeVector(2));
	pushVector(p.monos, m);
	p;
}

mizCopyPoly(p : MizPolynomial) -> MizPolynomial {
	r = MizPolynomial(makeVector(sizeVector(p.monos)));
	iterVector(p.monos, \m -> pushVector(r.monos, mizCopyMonomial(m)));
	r;
}

mizPolyIsNumeric(p : MizPolynomial) -> bool {
	sizeVector(p.monos) == 1 && mizNatCount(getVectorUnsafe(p.monos, 0).powers) == 0;
}

mizPolyIsNumericEqualWith(p : MizPolynomial, v : MizCplx) -> bool {
	mizPolyIsNumeric(p) && cCmp(getVectorUnsafe(p.monos, 0).coeff, v) == 0;
}

mizPolyGetNumeric(p : MizPolynomial) -> MizCplx {
	getVectorUnsafe(p.monos, 0).coeff;
}

mizMonoIsVariable(m : MizMonomial) -> int {
	if (mizNatCount(m.powers) == 1 && mizNatItem(m.powers, 0).y == 1
		&& cEq1(m.coeff)) {
		mizNatItem(m.powers, 0).x;
	} else {
		0;
	}
}

mizPolyIsVariable(p : MizPolynomial) -> int {
	if (sizeVector(p.monos) == 1) mizMonoIsVariable(getVectorUnsafe(p.monos, 0))
	else 0;
}

mizPolyIsUniVariantVariable(p : MizPolynomial) -> int {
	// the head monomial as a plain variable (used for x = polynomial checks)
	if (sizeVector(p.monos) == 1) mizMonoIsVariable(getVectorUnsafe(p.monos, 0))
	else 0;
}

mizPolyHasTheVariable(p : MizPolynomial, varNr : int) -> bool {
	r = ref false;
	iterVector(p.monos, \m -> if (mizNatHasInDom(m.powers, varNr)) r := true);
	^r;
}

// LexCompareMonomials
mizCompareMonomials(a : MizMonomial, b : MizMonomial) -> int {
	na = mizNatCount(a.powers);
	nb = mizNatCount(b.powers);
	res = ref 0;
	i = ref 0;
	while(\ -> ^res == 0 && ^i < na, \ -> {
		if (^i >= nb) {
			res := -1;
		} else {
			pa = mizNatItem(a.powers, ^i);
			pb = mizNatItem(b.powers, ^i);
			c1 = if (pa.x < pb.x) -1 else if (pa.x > pb.x) 1 else 0;
			if (c1 != 0) {
				res := c1;
			} else {
				c2 = if (pa.y < pb.y) 1 else if (pa.y > pb.y) -1 else 0;
				if (c2 != 0) res := c2;
			}
		}
		i := ^i + 1;
	});
	if (^res != 0) ^res
	else if (na < nb) 1 else if (na > nb) -1 else 0;
}

mizStdCompareMonomials(a : MizMonomial, b : MizMonomial) -> int {
	ca = mizNatCountAll(a.powers);
	cb = mizNatCountAll(b.powers);
	if (ca != cb) {
		if (ca < cb) -1 else 1;
	} else {
		mizNatCompareGraph(a.powers, b.powers);
	}
}

mizNatCompareGraph(f : MizNatFunc, g : MizNatFunc) -> int {
	nf = mizNatCount(f);
	ng = mizNatCount(g);
	res = ref 0;
	i = ref 0;
	while(\ -> ^res == 0 && ^i < nf && ^i < ng, \ -> {
		pf = mizNatItem(f, ^i);
		pg = mizNatItem(g, ^i);
		if (pf.x != pg.x) res := if (pf.x < pg.x) -1 else 1
		else if (pf.y != pg.y) res := if (pf.y < pg.y) -1 else 1;
		i := ^i + 1;
	});
	if (^res != 0) ^res
	else if (nf < ng) -1 else if (nf > ng) 1 else 0;
}

mizStdComparePolynomials(a : MizPolynomial, b : MizPolynomial) -> int {
	na = sizeVector(a.monos);
	nb = sizeVector(b.monos);
	if (na != nb) {
		if (na < nb) -1 else 1;
	} else {
		res = ref 0;
		i = ref 0;
		while(\ -> ^res == 0 && ^i < na, \ -> {
			ma = getVectorUnsafe(a.monos, ^i);
			mb = getVectorUnsafe(b.monos, ^i);
			c1 = mizStdCompareMonomials(ma, mb);
			if (c1 != 0) res := c1
			else {
				c2 = cCmp(ma.coeff, mb.coeff);
				if (c2 != 0) res := c2;
			}
			i := ^i + 1;
		});
		^res;
	}
}

mizComparePolynomials(a : MizPolynomial, b : MizPolynomial) -> int {
	na = sizeVector(a.monos);
	nb = sizeVector(b.monos);
	if (nb == 0) 1
	else if (na == 0) -1
	else {
		res = ref 0;
		i = ref 0;
		while(\ -> ^res == 0 && ^i < na && ^i < nb, \ -> {
			ma = getVectorUnsafe(a.monos, ^i);
			mb = getVectorUnsafe(b.monos, ^i);
			c1 = mizCompareMonomials(ma, mb);
			if (c1 != 0) res := c1
			else {
				c2 = cCmp(ma.coeff, mb.coeff);
				if (c2 != 0) res := c2;
			}
			i := ^i + 1;
		});
		if (^res != 0) ^res
		else if (na < nb) -1 else if (na > nb) 1 else 0;
	}
}

// Polynomial.Insert: sorted insert merging equal power products
mizPolyInsert(p : MizPolynomial, m : MizMonomial) -> void {
	n = sizeVector(p.monos);
	// binary search: the monomial list is sorted by CompareMonomials
	lo = ref 0;
	hi = ref n;
	found = ref false;
	while(\ -> !^found && ^lo < ^hi, \ -> {
		mid = (^lo + ^hi) / 2;
		c = mizCompareMonomials(getVectorUnsafe(p.monos, mid), m);
		if (c == 0) {
			lo := mid;
			found := true;
		} else if (c > 0) {
			hi := mid;
		} else {
			lo := mid + 1;
		}
	});
	pos = ref ^lo;
	if (^found) {
		e = getVectorUnsafe(p.monos, ^pos);
		v = cAdd(m.coeff, e.coeff);
		if (cEq0(v)) {
			if (sizeVector(p.monos) > 1) {
				removeVector(p.monos, ^pos);
			} else {
				mizNatDeleteAll(e.powers);
				e.coeff ::= v;
			}
		} else {
			e.coeff ::= v;
		}
	} else {
		if (cEq0(m.coeff) && sizeVector(p.monos) > 0) {
			// drop a zero monomial when something is already present
		} else {
			if (sizeVector(p.monos) > 0
				&& cEq0(getVectorUnsafe(p.monos, 0).coeff)) {
				removeVector(p.monos, 0);
				pos := max(0, ^pos - 1);
			}
			mizVectorAtInsertM(p.monos, ^pos, m);
		}
	}
}

mizVectorAtInsertM(v : Vector<MizMonomial>, pos : int, m : MizMonomial) -> void {
	pushVector(v, m);
	i = ref sizeVector(v) - 1;
	while(\ -> ^i > pos, \ -> {
		setVectorUnsafe(v, ^i, getVectorUnsafe(v, ^i - 1));
		i := ^i - 1;
	});
	setVectorUnsafe(v, pos, m);
}

mizAddPolynomials(a : MizPolynomial, b : MizPolynomial) -> MizPolynomial {
	r = MizPolynomial(makeVector(sizeVector(a.monos) + sizeVector(b.monos)));
	iterVector(a.monos, \m -> mizPolyInsert(r, mizCopyMonomial(m)));
	iterVector(b.monos, \m -> mizPolyInsert(r, mizCopyMonomial(m)));
	if (sizeVector(r.monos) == 0) mizPolyWithNumeric(mizCZeroP) else r;
}

mizDiffPolynomials(a : MizPolynomial, b : MizPolynomial) -> MizPolynomial {
	r = MizPolynomial(makeVector(sizeVector(a.monos) + sizeVector(b.monos)));
	iterVector(a.monos, \m -> mizPolyInsert(r, mizCopyMonomial(m)));
	iterVector(b.monos, \m -> {
		nm = mizCopyMonomial(m);
		nm.coeff ::= cNeg(m.coeff);
		mizPolyInsert(r, nm);
	});
	if (sizeVector(r.monos) == 0) mizPolyWithNumeric(mizCZeroP) else r;
}

mizMultPolynomials(a : MizPolynomial, b : MizPolynomial) -> MizPolynomial {
	if (mizPolyIsNumericEqualWith(a, mizCZeroP)
		|| mizPolyIsNumericEqualWith(b, mizCZeroP)) {
		mizPolyWithNumeric(mizCZeroP);
	} else {
		r = MizPolynomial(makeVector(sizeVector(a.monos) * sizeVector(b.monos)));
		iterVector(a.monos, \ma -> {
			iterVector(b.monos, \mb -> {
				nm = MizMonomial(cMul(ma.coeff, mb.coeff), mizCopyNatFunc(ma.powers));
				mizNatAddPointwise(nm.powers, mb.powers);
				mizPolyInsert(r, nm);
			});
		});
		if (sizeVector(r.monos) == 0) mizPolyWithNumeric(mizCZeroP) else r;
	}
}

mizNatAddPointwise(f : MizNatFunc, g : MizNatFunc) -> void {
	fori(0, mizNatCount(g) - 1, \i -> {
		it = mizNatItem(g, i);
		fori(1, it.y, \__ -> mizNatUp(f, it.x));
	});
}

mizNMultPolynomial(v : MizCplx, p : MizPolynomial) -> MizPolynomial {
	if (cEq0(v)) {
		mizPolyWithNumeric(v);
	} else {
		r = mizCopyPoly(p);
		if (!cEq1(v)) {
			iterVector(r.monos, \m -> m.coeff ::= cMul(v, m.coeff));
		}
		r;
	}
}

mizNthPower(p : MizPolynomial, n : int) -> MizPolynomial {
	if (n == 0) {
		mizPolyWithNumeric(mizCOneP);
	} else {
		r = ref mizCopyPoly(p);
		fori(2, n, \__ -> r := mizMultPolynomials(^r, p));
		^r;
	}
}

mizMMultPolynomial(m : MizMonomial, p : MizPolynomial) -> MizPolynomial {
	r = MizPolynomial(makeVector(sizeVector(p.monos)));
	iterVector(p.monos, \pm -> {
		nm = MizMonomial(cMul(m.coeff, pm.coeff), mizCopyNatFunc(m.powers));
		mizNatAddPointwise(nm.powers, pm.powers);
		mizPolyInsert(r, nm);
	});
	if (sizeVector(r.monos) == 0) mizPolyWithNumeric(mizCZeroP) else r;
}

// InsertValue: substitute varNr := q in place
mizPolyInsertValue(p : MizPolynomial, varNr : int, q : MizPolynomial) -> void {
	old : Vector<MizMonomial> = copyVector(p.monos);
	clearVector(p.monos);
	iterVector(old, \m -> {
		if (mizNatHasInDom(m.powers, varNr)) {
			if (!mizPolyIsNumericEqualWith(q, mizCZeroP)) {
				power = mizNatValue(m.powers, varNr);
				mizNatDeleteElem(m.powers, varNr);
				qp = mizNthPower(q, power);
				mp = mizMMultPolynomial(m, qp);
				iterVector(mp.monos, \nm -> mizPolyInsert(p, nm));
			}
		} else {
			mizPolyInsert(p, m);
		}
	});
	if (sizeVector(p.monos) == 0) {
		pushVector(p.monos, mizNewMonomial(mizCZeroP));
	}
}

// ---------------- Gauss elimination (linear systems over monomial vars) ----------------

// ComplexInv; the callers guard against zero, and mizCplxInv returns None if
// they ever fail to
cInvP(a : MizCplx) -> MizCplx {
	either(mizCplxInv(a), mizCplxZero);
}

// insert keeping ComparePolynomials order; identical equations are dropped
// (a repeated equation adds nothing and would keep the elimination busy)
mizPolySortedInsert(v : Vector<MizPolynomial>, p : MizPolynomial) -> void {
	n = sizeVector(v);
	lo2 = ref 0;
	hi2 = ref n;
	while(\ -> ^lo2 < ^hi2, \ -> {
		mid = (^lo2 + ^hi2) / 2;
		if (mizComparePolynomials(getVectorUnsafe(v, mid), p) >= 0) hi2 := mid
		else lo2 := mid + 1;
	});
	pos = ref ^lo2;
	dupEq = ^lo2 < n && mizComparePolynomials(getVectorUnsafe(v, ^lo2), p) == 0;
	if (dupEq) {
		// already present
	} else {
	pushVector(v, p);
	i = ref sizeVector(v) - 1;
	while(\ -> ^i > ^pos, \ -> {
		setVectorUnsafe(v, ^i, getVectorUnsafe(v, ^i - 1));
		i := ^i - 1;
	});
	setVectorUnsafe(v, ^pos, p);
	}
}

mizPolyHeadVar(p : MizPolynomial) -> int {
	m = getVectorUnsafe(p.monos, 0);
	if (mizNatCount(m.powers) == 0) -1 else mizNatItem(m.powers, 0).x;
}

// GaussElimination: triangularize; returns Pair(triangular system, contr)
mizGaussElimination(aEqs0 : Vector<MizPolynomial>) -> Pair<Vector<MizPolynomial>, int> {
	// normalize head coefficients to 1
	aEqs : Vector<MizPolynomial> = makeVector(sizeVector(aEqs0));
	iterVector(aEqs0, \p -> {
		c0 = getVectorUnsafe(p.monos, 0).coeff;
		if (!cEq1(c0)) {
			mizPolySortedInsert(aEqs, mizNMultPolynomial(cInvP(c0), p));
		} else {
			mizPolySortedInsert(aEqs, p);
		}
	});
	if (sizeVector(aEqs) <= 1) {
		Pair(aEqs, 0);
	} else {
		contr = ref 0;
		iters = ref 0;
		// PROGRESS GUARD: two equations can share a head VARIABLE without
		// sharing a head MONOMIAL (x*y and x*z), so their difference need not
		// cancel the head and can re-enter the queue with the same head — the
		// elimination then fails to make progress. Mizar's own limits bail out
		// gracefully in the same spirit (LatOvfl / coOverflow): stop
		// eliminating and keep what has been triangularized so far.
		maxIters = 64 * (sizeVector(aEqs0) + 4);
		lEquations : Vector<MizPolynomial> = makeVector(sizeVector(aEqs));
		while(\ -> ^contr == 0 && ^iters < maxIters && sizeVector(aEqs) > 0, \ -> {
			lEq = getVectorUnsafe(aEqs, 0);
			lVar = mizPolyHeadVar(lEq);
			removeVector(aEqs, 0);
			inner = ref true;
			while(\ -> ^contr == 0 && ^inner && ^iters < maxIters
					&& sizeVector(aEqs) > 0, \ -> {
				hd = getVectorUnsafe(aEqs, 0);
				if (lVar != mizPolyHeadVar(hd)) {
					inner := false;
				} else {
					iters := ^iters + 1;
					removeVector(aEqs, 0);
					nEq = mizDiffPolynomials(lEq, hd);
					if (mizPolyIsNumeric(nEq)) {
						if (!mizPolyIsNumericEqualWith(nEq, mizCplxZero)) {
							contr := 44;
						}
					} else {
						c0 = getVectorUnsafe(nEq.monos, 0).coeff;
						if (cEq1(c0)) {
							mizPolySortedInsert(aEqs, nEq);
						} else {
							mizPolySortedInsert(aEqs, mizNMultPolynomial(cInvP(c0), nEq));
						}
					}
				}
			});
			if (^contr == 0) mizPolySortedInsert(lEquations, lEq);
		});
		if (^contr == 0) {
			// back-substitution pass
			fori(1, sizeVector(lEquations) - 1, \i -> {
				lEq = getVectorUnsafe(lEquations, i);
				lVar = mizPolyHeadVar(lEq);
				fori(0, i - 1, \j -> {
					pj = getVectorUnsafe(lEquations, j);
					v = ref 0;
					while(\ -> ^v < sizeVector(pj.monos)
						&& mizNatCount(getVectorUnsafe(pj.monos, ^v).powers) > 0
						&& lVar > mizNatItem(getVectorUnsafe(pj.monos, ^v).powers, 0).x, \ ->
						v := ^v + 1);
					if (^v < sizeVector(pj.monos)
						&& mizNatCount(getVectorUnsafe(pj.monos, ^v).powers) > 0
						&& lVar == mizNatItem(getVectorUnsafe(pj.monos, ^v).powers, 0).x) {
						cv = getVectorUnsafe(pj.monos, ^v).coeff;
						tEq = if (cEq1(cv)) {
							mizDiffPolynomials(pj, lEq);
						} else {
							mizDiffPolynomials(pj, mizNMultPolynomial(cv, lEq));
						}
						setVectorUnsafe(lEquations, j, tEq);
					}
				});
			});
		}
		if (getUrlParameterDef("dbg-gauss", "") == "1") {
			mx = ref 0;
			iterVector(lEquations, \p -> if (sizeVector(p.monos) > ^mx) mx := sizeVector(p.monos));
			println("GAUSS eqs=" + i2s(sizeVector(lEquations)) + " iters=" + i2s(^iters)
				+ " maxMonos=" + i2s(^mx));
		}
		Pair(lEquations, ^contr);
	}
}

mizLinearEquationReduce(aEq0 : MizPolynomial, equations : Vector<MizPolynomial>) -> MizPolynomial {
	aEq = ref aEq0;
	i = ref 0;
	brk = ref false;
	while(\ -> !^brk && ^i < sizeVector(equations), \ -> {
		eqi = getVectorUnsafe(equations, ^i);
		if (mizPolyHeadVar(eqi) == mizPolyHeadVar(^aEq) && mizPolyHeadVar(^aEq) >= 0) {
			c0 = getVectorUnsafe((^aEq).monos, 0).coeff;
			tEq = if (cEq1(c0)) {
				mizDiffPolynomials(^aEq, eqi);
			} else {
				mizDiffPolynomials(^aEq, mizNMultPolynomial(c0, eqi));
			}
			aEq := tEq;
			if (mizPolyIsNumeric(^aEq)) brk := true;
		}
		i := ^i + 1;
	});
	^aEq;
}

mizNewMonomialPub(c : MizCplx) -> MizMonomial {
	mizNewMonomial(c);
}
