// Transcription of ~/dev/system/kernel/justhan.pas — the JUSTIFICATION data
// the analyzer builds and hands to the checker: a proposition (label number,
// identifier, position, sentence), a reference (private label / theorem /
// definition) and an inference (`by` or `from`, its references, whether it is
// linked to the previous statement).
//
// The checker path in this port reads these straight out of the `.xml`
// (prep.flow); the ANALYZER builds them, so they need first-class records.

import ds/vector;
import mizar/original/errhan;
import mizar/original/mobjects;
import mizar/original/limits;
import mizar/original/lexicon;
import mizar/original/correl;

export {
	// PropositionObj
	MizProposition(mutable labNr : int, mutable labId : int,
		mutable pos : MizPos, mutable sentence : MizFrm);

	// TReference and its three descendants, told apart by nRefSort
	MizJReference ::= MizPrivateRef, MizTheoremRef2, MizDefinitionRef2;
		MizPrivateRef(mutable pos : MizPos, mutable labNr : int, mutable labId : int);
		MizTheoremRef2(mutable pos : MizPos, mutable articleNr : int, mutable theoNr : int);
		MizDefinitionRef2(mutable pos : MizPos, mutable articleNr : int, mutable defNr : int);

	mizJRefSort(r : MizJReference) -> int;   // 'l' / 't' / 'd'
	mizJRefPos(r : MizJReference) -> MizPos;

	// InferenceObj
	MizInference(
		mutable inferSort : int,       // ikInfBy or ikInfFrom
		mutable schFileNr : int,       // 0 for the current article
		mutable schemeNr : int,        // 0 for a standard inference
		mutable linked : bool,
		references : Vector<MizJReference>,
		mutable pos : MizPos,
	);

	mizMakeInference() -> MizInference;

	// IterStepObj: an inference plus the term the step equates
	MizIterStep(inf : MizInference, mutable equatedTrm : MizTrm);

	// the Proposition array: DefaultPreviousLab .. MaxLabNbr
	DefaultCurrentLab = 0;
	DefaultPreviousLab = -1;

	// EqRefs
	mizEqRefs(a : MizJReference, b : MizJReference) -> bool;
}

mizJRefSort(r : MizJReference) -> int {
	switch (r) {
		MizPrivateRef(__, __, __): 108;      // 'l'
		MizTheoremRef2(__, __, __): 116;     // 't'
		MizDefinitionRef2(__, __, __): 100;  // 'd'
	}
}

mizJRefPos(r : MizJReference) -> MizPos {
	switch (r) {
		MizPrivateRef(p, __, __): p;
		MizTheoremRef2(p, __, __): p;
		MizDefinitionRef2(p, __, __): p;
	}
}

mizMakeInference() -> MizInference {
	MizInference(ikInfBy, 0, 0, false, makeVector(8), mizZeroPos);
}

mizEqRefs(a : MizJReference, b : MizJReference) -> bool {
	switch (a) {
		MizPrivateRef(__, la, __): switch (b) {
			MizPrivateRef(__, lb, __): la == lb;
			default: false;
		}
		MizTheoremRef2(__, aa, ta): switch (b) {
			MizTheoremRef2(__, ab, tb): aa == ab && ta == tb;
			default: false;
		}
		MizDefinitionRef2(__, aa, da): switch (b) {
			MizDefinitionRef2(__, ab, db): aa == ab && da == db;
			default: false;
		}
	}
}
