// Transcription of ~/dev/system/kernel/builtin.pas — the Requirement enum and
// the gBuiltIn table (requirement -> constructor number in the current
// environment; 0 = absent). The table is filled by the environment reader
// (.ere file / prel requirements), one per article.

import ds/vector;

export {
	rqNone = 0;
	rqAny = 1;
	rqSetMode = 2;
	rqEqualsTo = 3;
	rqBelongsTo = 4;
	rqEmpty = 5;
	rqEmptySet = 6;
	rqElement = 7;
	rqPowerSet = 8;
	rqInclusion = 9;
	rqSubDomElem = 10;
	rqRealDom = 11;
	rqNatDom = 12;
	rqRealAdd = 13;
	rqRealMult = 14;
	rqLessOrEqual = 15;
	rqSucc = 16;
	rqUnion = 17;
	rqIntersection = 18;
	rqSubtraction = 19;
	rqSymmetricDifference = 20;
	rqMeets = 21;
	rqRealNeg = 22;
	rqRealInv = 23;
	rqRealDiff = 24;
	rqRealDiv = 25;
	rqReal = 26;
	rqPositive = 27;
	rqNegative = 28;
	rqNatural = 29;
	rqImaginaryUnit = 30;
	rqComplex = 31;
	rqOmega = 32;
	rqZeroNumber = 33;
	rqZero = 34;
	rqDiv = 35;
	rqMod = 36;
	rqDivides = 37;
	rqLCM = 38;
	rqGCD = 39;
	rqPrime = 40;
	rqLAST = 40;

	// gBuiltIn: array[Requirement] of integer — one per article environment.
	MizBuiltIn(nrs : Vector<int>);

	mizMakeBuiltIn() -> MizBuiltIn;
	mizBuiltIn(b : MizBuiltIn, rq : int) -> int;           // gBuiltIn[rq], 0 if unset
	mizSetBuiltIn(b : MizBuiltIn, rq : int, nr : int) -> void;
}

mizMakeBuiltIn() -> MizBuiltIn {
	v = makeVector(rqLAST + 1);
	fori(0, rqLAST, \__ -> pushVector(v, 0));
	MizBuiltIn(v);
}

mizBuiltIn(b : MizBuiltIn, rq : int) -> int {
	getVectorDef(b.nrs, rq, 0);
}

mizSetBuiltIn(b : MizBuiltIn, rq : int, nr : int) -> void {
	setVectorUnsafe(b.nrs, rq, nr);
}
