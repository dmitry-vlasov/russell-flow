// Transcription of the definientia machinery: identify.pas (Matches,
// EqualsExpansion, ExpandTrmIfEqual, InitEssentialsArgs) and the loaders
// (iocorrel LoadDefinitions/LoadEqualities/LoadExpansions over .dfs/.dfe/
// .dfx) plus the prechecker's WellMatchedExpansions — the definitional
// expansion of atomic formulas (definitions enter WITHOUT being cited, but
// only as expansions of atoms that occur).

import string;
import loop;
import ds/vector;
import ds/tree;
import fs/filesystem;
import mizar/original/errhan;
import mizar/original/mobjects;
import mizar/original/limits;
import mizar/original/lexicon;
import mizar/original/builtin;
import mizar/original/xml_parser;
import mizar/original/correl;
import mizar/original/correl_inst;
import mizar/original/correl_match;
import mizar/original/iocorrel;
import mizar/original/identify;
import net/url_parameter;
import mizar/original/print;
import mizar/original/prechecker;

export {
	MizDefBody ::= MizDefFrm, MizDefTrm;
	MizDefFrm(f : MizFrm);
	MizDefTrm(t : MizTrm);

	MizPartDef(body : MizDefBody, guard : MizFrm);

	MizDef(
		sort : int,                          // 'm' 109 / 'e' 101
		partials : Vector<MizPartDef>,
		otherwise : Maybe<MizDefBody>,
	);

	MizDefiniens(
		constrKind : int,                    // ik char of the constructor
		mutable constrNr : int,              // mutable: the accommodator renumbers
		article : string,
		defNr : int,
		labId : int,                         // nLabId — the definiens' own label
		primaries : Vector<MizTyp>,
		essentials : MizIntSeq,
		assumptions : MizFrm,
		def : Maybe<MizDef>,
	);

	MizDefinientia(
		all : Vector<MizDefiniens>,          // Definientia (.dfs)
		expansions : Vector<MizDefiniens>,   // ExDefinientia (.dfx)
		// gEquals: adjusted functor nr -> equals-definitions
		mutable equalsBy : Tree<int, [MizEqualsDef]>,
	);

	MizEqualsDef(
		primaries : Vector<MizTyp>,          // last dropped (the result locus)
		essentials : MizIntSeq,              // last dropped
		expansion : MizTrm,
	);

	mizMakeDefinientia() -> MizDefinientia;
	// gEquals: register one definiens as an equals-expansion, if it is one
	mizAddEqualsDef(env : MizCorrelEnv, defs : MizDefinientia, d : MizDefiniens) -> void;
	// load .dfs/.dfe/.dfx if present; build gEquals; returns counts
	mizLoadDefinientia(env : MizCorrelEnv, defs : MizDefinientia,
		mmlDir : string, article : string) -> void;
	// the original's three separate procedures (iocorrel.pas 1250/1269/1288)
	mizLoadDefinitions(env : MizCorrelEnv, defs : MizDefinientia,
		mmlDir : string, article : string) -> void;
	mizLoadEqualities(env : MizCorrelEnv, defs : MizDefinientia,
		mmlDir : string, article : string) -> void;
	mizLoadExpansions(env : MizCorrelEnv, defs : MizDefinientia,
		mmlDir : string, article : string) -> void;

	// Matches: does the atom's constructor + essential args fit? Fills
	// env.substTrm on success (caller instantiates through it).
	mizMatches(env : MizCorrelEnv, kind : int, nr : int, args : MizTrmList,
		d : MizDefiniens) -> bool;

	// the prechecker hook: expansions of one atomic formula
	mizAtomicExpansions(env : MizCorrelEnv, defs : MizDefinientia, f : MizFrm) -> [MizFrm];

	// the identify hook: eq-const numbers from equals-expansion of a functor
	mizEqualsExpandHook(defs : MizDefinientia, idn : MizIdentify,
		funcNr : int, args : MizTrmList) -> [int];

	// wire both hooks
	mizWireDefinientia(defs : MizDefinientia, pre : MizPre, idn : MizIdentify) -> void;

	mizInDefiniens(r : MizVrfReader) -> MizDefiniens;
	// read one .dfs/.dfe/.dfx (or prel .def) payload into a pool
	mizLoadDefsFile(env : MizCorrelEnv, path : string, into : Vector<MizDefiniens>) -> void;
	mizLoadDefsContent(env : MizCorrelEnv, content : string, into : Vector<MizDefiniens>) -> void;
	mizEqualsExpansionPub(env : MizCorrelEnv, d : MizDefiniens) -> Maybe<MizEqualsDef>;

	// StdItemObj.FinishDefiniens (stdprep.pas 861), the two things it does
	// BESIDES registering the definiens in gEquals:
	//   * the SELF-REFERENCE guard — an expansion that mentions the defined
	//     functor is not registered at all (CollectFuncInTrm, 877-879);
	//   * the RETROACTIVE pass — every constant ALREADY collected for that
	//     functor is expanded now and the new constant joins its fEqConst
	//     (882-900). Without it a term interned before its own `equals`
	//     definition is read never gets the expansion, and the definition is
	//     dead for the rest of the article.
	mizEqualsDefSelfRef(env : MizCorrelEnv, constrNr : int, ed : MizEqualsDef) -> bool;
	mizEqualsDefRetrofit(idn : MizIdentify, constrNr : int, ed : MizEqualsDef) -> void;

	// MakeDefiniens (identify.pas 218) and DefiniensObj.SpreadFrm (254) — the
	// full definitional expansion of an atom, which the ANALYZER needs when it
	// chops a thesis (SpreadAtomicFormula).
	mizMakeDefiniensFrm(negated : bool, d : Maybe<MizDef>) -> MizFrm;
	mizSpreadFrm(env : MizCorrelEnv, d : MizDefiniens, args : MizTrmList,
		negated : bool, conclusion : bool) -> MizFrm;
}

mizEqualsExpansionPub(env : MizCorrelEnv, d : MizDefiniens) -> Maybe<MizEqualsDef> {
	mizEqualsExpansion(env, d);
}

// CollectFuncInTrm (stdprep.pas 814): the functor numbers a term mentions,
// RAW and ADJUSTED. A Fraenkel term contributes NOTHING — the original's body
// for that case is commented out (835-844), and so is the Choice one.
mizCollectFuncInTrmSet(env : MizCorrelEnv, t : MizTrm, acc : Vector<int>) -> void {
	switch (t) {
		MizFuncTrm(srt, funcNr, args, __, __): {
			if (srt == ikTrmFunctor) {
				mizCollectFuncInTrmListSet(env, args, acc);
				ft : MizFuncTrm = t;
				pushVector(acc, funcNr);
				pushVector(acc, mizAdjustTrm(env, ft).first);
			} else {
				// SchFunc / Aggreg / Selector: arguments only
				mizCollectFuncInTrmListSet(env, args, acc);
			}
		}
		MizPrivFuncTrm(__, args, funcExp, __, __): {
			mizCollectFuncInTrmListSet(env, args, acc);
			mizCollectFuncInTrmSet(env, funcExp, acc);
		}
		default: {}   // vars, numerals, Fraenkel, Choice, It, error
	}
}

mizCollectFuncInTrmListSet(env : MizCorrelEnv, l : MizTrmList, acc : Vector<int>) -> void {
	switch (l) {
		MizTrmNil(): {}
		MizTrmElem(t, next): {
			mizCollectFuncInTrmSet(env, t, acc);
			mizCollectFuncInTrmListSet(env, next, acc);
		}
	}
}

mizEqualsDefSelfRef(env : MizCorrelEnv, constrNr : int, ed : MizEqualsDef) -> bool {
	acc : Vector<int> = makeVector(8);
	mizCollectFuncInTrmSet(env, ed.expansion, acc);
	exists(vector2array(acc), \n -> n == constrNr);
}

mizEqualsDefRetrofit(idn : MizIdentify, constrNr : int, ed : MizEqualsDef) -> void {
	env = idn.env;
	// the Pascal `for i:=0 to InferConstDef.Count-1` fixes the bound once
	n = sizeVector(env.inferConstDef);
	i = ref 0;
	while(\ -> ^i < n, \ -> {
		cd : MizConstDef = getVectorUnsafe(env.inferConstDef, ^i);
		switch (cd.def) {
			MizFuncTrm(srt, __, __, __, __): {
				if (srt == ikTrmFunctor) {
					ft : MizFuncTrm = cd.def;
					pa = mizAdjustTrm(env, ft);
					if (pa.first == constrNr) {
						// ExpandTrmIfEqual (identify.pas 642) + CollectConstInTrm
						mizDisposeSubstTrm(env);
						mizInitEssentialsArgs(env, pa.second, ed.essentials);
						if (mizCheckLociTypesN(env, ed.primaries)) {
							lTrm0 = mizInstSubstTrm(env, ed.expansion);
							mizDisposeSubstTrm(env);
							bSaved = env.boundVarNbr;
							env.boundVarNbr ::= 0;
							lTrm = mizCollectConstInTrm(idn, lTrm0);
							env.boundVarNbr ::= bSaved;
							switch (lTrm) {
								MizVarTrm(s2, varNr, __, __): {
									if (s2 == ikTrmInfConst) mizNatInsertElem(cd.eqConst, varNr);
								}
								default: {}
							}
						} else {
							mizDisposeSubstTrm(env);
						}
					}
				}
			}
			default: {}
		}
		i := ^i + 1;
	});
}

mizMakeDefinientia() -> MizDefinientia {
	MizDefinientia(makeVector(16), makeVector(16), makeTree());
}

// ---------------- loading ----------------

mizInIntSeqEl(r : MizVrfReader, elName : string) -> MizIntSeq {
	x = r.x;
	s = mizInitIntSeq(4);
	if (x.nState == MizEStart && x.nElName == elName) {
		mizXmlNextElementState(x);
		while(\ -> x.nState == MizEStart, \ -> {
			if (x.nElName == "Int") {
				__i = mizSeqInsert(s, mizXmlIntAttrDef(x, "x", 0));
				{}
			}
			mizXmlSkipElement(x);
		});
		mizXmlNextElementState(x);
	}
	s;
}

mizInDefBody(r : MizVrfReader, srt : int) -> MizDefBody {
	if (srt == 109) MizDefFrm(mizInFormula(r))   // 'm'
	else MizDefTrm(mizInTerm(r));                // 'e'
}

mizInDef(r : MizVrfReader) -> MizDef {
	x = r.x;
	kindS = mizXmlAttr(x, "kind");
	srt = if (strlen(kindS) > 0) getCharCodeAt(kindS, 0) else 109;
	mizXmlNextElementState(x);
	partials : Vector<MizPartDef> = makeVector(2);
	while(\ -> x.nState == MizEStart && x.nElName == "PartialDef", \ -> {
		mizXmlNextElementState(x);
		body = mizInDefBody(r, srt);
		guard = mizInFormula(r);
		pushVector(partials, MizPartDef(body, guard));
		mizXmlNextElementState(x); // past </PartialDef>
	});
	otherwise = if (x.nState == MizEStart
		&& (mizIsFrmEl(x.nElName) || mizIsTermEl(x.nElName))) {
		Some(mizInDefBody(r, srt));
	} else {
		None();
	}
	mizXmlNextElementState(x); // past the DefMeaning end
	MizDef(srt, partials, otherwise);
}

mizInDefiniens(r : MizVrfReader) -> MizDefiniens {
	x = r.x;
	mizXmlAssert(x.nElName == "Definiens");
	kindS = mizXmlAttr(x, "constrkind");
	kind = if (strlen(kindS) > 0) getCharCodeAt(kindS, 0) else 0;
	nr = mizXmlIntAttrDef(x, "constrnr", 0);
	article = mizXmlAttr(x, "aid");
	defNr = mizXmlIntAttrDef(x, "defnr", 0);
	labId = mizXmlIntAttrDef(x, "vid", 0);
	mizXmlNextElementState(x);
	primaries = mizInTypeCollLoci(r);
	essentials = mizInIntSeqEl(r, "Essentials");
	assumptions = if (x.nState == MizEStart && mizIsFrmEl(x.nElName)) {
		mizInFormula(r);
	} else {
		mizNewVerum();
	}
	def = if (x.nState == MizEStart && x.nElName == "DefMeaning") {
		Some(mizInDef(r));
	} else {
		None();
	}
	mizXmlNextElementState(x); // past </Definiens>
	MizDefiniens(kind, nr, article, defNr, labId, primaries, essentials, assumptions, def);
}

mizLoadDefsFile(env : MizCorrelEnv, path : string, into : Vector<MizDefiniens>) -> void {
	if (fileExists(path)) {
		mizLoadDefsContent(env, getFileContent(path), into);
	}
}

mizLoadDefsContent(env : MizCorrelEnv, content : string, into : Vector<MizDefiniens>) -> void {
	if (content != "") {
		r = mizMakeVrfReader(mizXmlInitParsing(content), env);
		r.mml ::= true;
		x = r.x;
		mizXmlNextElementState(x);
		mizXmlAssert(x.nElName == "Definientia");
		mizXmlNextElementState(x);
		while(\ -> x.nState == MizEStart, \ -> {
			if (x.nElName == "Definiens") {
				pushVector(into, mizInDefiniens(r));
			} else {
				mizXmlSkipElement(x);
			}
			// LoadDefinitions / LoadEqualities / LoadExpansions (iocorrel.pas
			// 1263 / 1281 / 1301) clear gTermCollection after EVERY definiens.
			// EVERY env-file reader does — a term typed while the environment
			// is being read must not survive into what is read next, or
			// GetTrmType hands back its stale ROUNDED type.
			mizTTCollFreeAll(env);
		});
	}
}

// EqualsExpansion: functor definitions of kind 'e' with no assumptions and
// no partials become directly substitutable equalities
mizEqualsExpansion(env : MizCorrelEnv, d : MizDefiniens) -> Maybe<MizEqualsDef> {
	if (d.constrKind != ikTrmFunctor) {
		None();
	} else if (mizFrmSort(d.assumptions) != ikFrmVerum) {
		None();
	} else {
		switch (d.def) {
			None(): None();
			Some(def): {
				if (def.sort != 101 || sizeVector(def.partials) > 0) {
					None();
				} else {
					switch (def.otherwise) {
						None(): None();
						Some(body): {
							switch (body) {
								MizDefTrm(t): {
									prim = mizCopyTypVector(d.primaries);
									if (sizeVector(prim) > 0) {
										removeVector(prim, sizeVector(prim) - 1);
									}
									ess = mizCopyIntSeq(d.essentials);
									if (mizSeqCount(ess) > 0) {
										mizSeqAtDelete(ess, mizSeqCount(ess) - 1);
									}
									Some(MizEqualsDef(prim, ess, mizCopyTrm(t)));
								}
								MizDefFrm(__): None();
							}
						}
					}
				}
			}
		}
	}
}

// THE TWO ENTRY POINTS LOAD DISJOINT DEFINIENS SETS, and the port used to
// load all three files on both paths:
//   Analyze  (analyzer.pas 6680) — Definientia.Init(20); LoadDefinitions,
//     i.e. the `.dfs` ALONE.
//   Prepare  (stdprep.pas 1179-1184) — EqDefinientia.Init; ExDefinientia.Init;
//     LoadEqualities; LoadExpansions, i.e. the `.dfe` and the `.dfx`, with
//     `LoadDefinitions` COMMENTED OUT above them.

// LoadDefinitions (iocorrel.pas 1250) — the `.dfs`. Analyze loads only this.
mizLoadDefinitions(env : MizCorrelEnv, defs : MizDefinientia,
		mmlDir : string, article : string) -> void {
	mizLoadDefsFile(env, mmlDir + "/" + article + ".dfs", defs.all);
}

// LoadExpansions (iocorrel.pas 1288) — the `.dfx`
mizLoadExpansions(env : MizCorrelEnv, defs : MizDefinientia,
		mmlDir : string, article : string) -> void {
	mizLoadDefsFile(env, mmlDir + "/" + article + ".dfx", defs.expansions);
}

// LoadEqualities (iocorrel.pas 1269) — the `.dfe`, plus the gEquals build the
// checker's preparation does over it (stdprep.pas 1191-1200)
mizLoadEqualities(env : MizCorrelEnv, defs : MizDefinientia,
		mmlDir : string, article : string) -> void {
	eqRaw : Vector<MizDefiniens> = makeVector(8);
	mizLoadDefsFile(env, mmlDir + "/" + article + ".dfe", eqRaw);
	iterVector(eqRaw, \d -> mizAddEqualsDef(env, defs, d));
}

// the CHECKER's set. Unchanged for now: the original does NOT read the `.dfs`
// here either, but that path is at 100% and the removal is its own measurement.
mizLoadDefinientia(env : MizCorrelEnv, defs : MizDefinientia,
		mmlDir : string, article : string) -> void {
	mizLoadDefinitions(env, defs, mmlDir, article);
	mizLoadExpansions(env, defs, mmlDir, article);
	mizLoadEqualities(env, defs, mmlDir, article);
}

mizAddEqualsDef(env : MizCorrelEnv, defs : MizDefinientia, d : MizDefiniens) -> void {
	switch (mizEqualsExpansion(env, d)) {
		Some(ed): {
			key = d.constrNr;
			cur = lookupTreeDef(defs.equalsBy, key, []);
			defs.equalsBy ::= setTree(defs.equalsBy, key, arrayPush(cur, ed));
		}
		None(): {}
	}
}

// ---------------- matching ----------------

// InitEssentialsArgs: gSubstTrm[essentials[k]] := args[k]
mizInitEssentialsArgs(env : MizCorrelEnv, args : MizTrmList, ess : MizIntSeq) -> void {
	cur = ref args;
	fori(0, mizSeqCount(ess) - 1, \k -> {
		switch (^cur) {
			MizTrmElem(trm, next): {
				mizSubstTrmSet(env, mizSeqValue(ess, k), Some(trm));
				cur := next;
			}
			MizTrmNil(): {}
		}
	});
}

mizMatches(env : MizCorrelEnv, kind : int, nr : int, args : MizTrmList,
		d : MizDefiniens) -> bool {
	mizDisposeSubstTrm(env);
	if (kind != d.constrKind || nr != d.constrNr) {
		false;
	} else if (mizSeqCount(d.essentials) == 0) {
		true;
	} else {
		mizInitEssentialsArgs(env, args, d.essentials);
		// Matches uses CheckLociTypesN (identify.pas 370), not CheckLociTypes
		mizCheckLociTypesN(env, d.primaries);
	}
}

// ---------------- the prechecker hook ----------------

// WellMatchedExpansions + AtomicFormulaExpansions: expandable 'm'
// definitions with no assumptions and no partials, matched at the atom.
mizAtomicExpansions(env : MizCorrelEnv, defs : MizDefinientia, f : MizFrm) -> [MizFrm] {
	p : Maybe<Pair<Pair<int, int>, MizTrmList>> = switch (f) {
		MizPredFrm(srt, predNr, __, __): {
			pf : MizPredFrm = f;
			if (srt == ikFrmPred) {
				q = mizAdjustFrm(env, pf);
				Some(Pair(Pair(ikFrmPred, q.first), q.second));
			} else if (srt == ikFrmAttr) {
				q = mizAdjustAttrFrm(env, pf);
				Some(Pair(Pair(ikFrmAttr, q.first), q.second));
			} else {
				None();
			}
		}
		default: None();
	}
	switch (p) {
		None(): [];
		Some(pk): {
			out : ref [MizFrm] = ref [];
			iterVector(defs.expansions, \d -> {
				okShape = switch (d.def) {
					Some(def): def.sort == 109 && sizeVector(def.partials) == 0
						&& mizFrmSort(d.assumptions) == ikFrmVerum
						&& isSome(def.otherwise);
					None(): false;
				}
				mt = okShape && mizMatches(env, pk.first.first, pk.first.second, pk.second, d);
				if (mizDbgEq() && okShape) {
					println("  AEX kind=" + i2s(pk.first.first) + " nr=" + i2s(pk.first.second)
						+ " vs def(" + i2s(d.constrKind) + "," + i2s(d.constrNr) + ")"
						+ " match=" + b2s(mt));
				}
				if (mt) {
					switch (d.def) {
						Some(def): switch (def.otherwise) {
							Some(body): switch (body) {
								MizDefFrm(df): {
									if (mizFrmSort(df) != ikError) {
										lFrm1 = mizCopyFrm(df);
										// ChangeBound: shift bound vars by the
										// current binder depth
										w = mizMakeWithin(\__, trm -> {
											switch (trm) {
												MizVarTrm(s2, v2, __, __): {
													if (s2 == ikTrmBound) {
														vt : MizVarTrm = trm;
														vt.varNr ::= v2 + env.boundVarNbr;
													}
													trm;
												}
												default: trm;
											}
										});
										mizWithinFrm(w, lFrm1);
										out := arrayPush(^out, mizInstSubstFrm(env, lFrm1));
									}
								}
								MizDefTrm(__): {}
							}
							None(): {}
						}
						None(): {}
					}
				} else {
					mizDisposeSubstTrm(env);
				}
			});
			mizDisposeSubstTrm(env);
			^out;
		}
	}
}

// ---------------- the identify hook (equals expansion) ----------------

// debug tooling: trace the `equals` expansion (`dbg-eq=1`)
gMizDbgEq : ref int = ref -1;

mizDbgEq() -> bool {
	if (^gMizDbgEq < 0) {
		gMizDbgEq := if (getUrlParameterDef("dbg-eq", "") == "1") 1 else 0;
	}
	^gMizDbgEq == 1;
}

mizEqualsExpandHook(defs : MizDefinientia, idn : MizIdentify,
		funcNr : int, args : MizTrmList) -> [int] {
	env = idn.env;
	// adjust the functor
	c = mizConstr(env, coFunctor, funcNr);
	adjNr = if (c.whichConstrNr != 0) c.whichConstrNr else funcNr;
	adjArgs = if (c.whichConstrNr != 0) mizTrmListDrop(args, c.superfluous) else args;
	// CollectEqualsComst (identify.pas 722): the level cap is NOT the only
	// guard — `InferConsts.IsInSet(lFunc)` stops an equals-expansion of a
	// functor from re-entering an expansion of THAT SAME functor, and the set
	// is maintained around the recursive CollectConstInTrm below (751/757).
	// Without it complex3 never finishes: cfrac/frac expand into each other
	// and the constant table grows without bound.
	if (idn.equalsExpansionLevel >= 3 || mizIntSetIsInSet(env.inferConsts, adjNr)) {
		[];
	} else {
		eds = lookupTreeDef(defs.equalsBy, adjNr, []);
		if (mizDbgEq()) {
			println("  EQX K" + i2s(funcNr) + " adj=K" + i2s(adjNr)
				+ " args=(" + mizTrmList2s(args) + ") defs=" + i2s(length(eds)));
		}
		fold(eds, [], \acc, ed -> {
			mizDisposeSubstTrm(env);
			mizInitEssentialsArgs(env, adjArgs, ed.essentials);
			// ExpandTrmIfEqual uses CheckLociTypesN (identify.pas 642)
			gLoci = mizCheckLociTypesN(env, ed.primaries);
			if (mizDbgEq()) {
				println("    EQX try expansion=" + mizTrm2s(ed.expansion)
					+ " checkLoci=" + b2s(gLoci));
			}
			if (gLoci) {
				lTrm0raw = mizInstSubstTrm(env, ed.expansion);
				mizDisposeSubstTrm(env);
				// ExpPrivFuncInTrm (identify.pas 749) — the original expands
				// private functors BEFORE collecting, and then asserts the
				// result is an InfConst; a private-functor term never is.
				lTrm0 = mizExpPrivFuncInTrm(lTrm0raw);
				idn.equalsExpansionLevel ::= idn.equalsExpansionLevel + 1;
				__ins = mizIntSetInsert(env.inferConsts, adjNr);
				bSaved = env.boundVarNbr;
				env.boundVarNbr ::= 0;
				lTrm = mizCollectConstInTrm(idn, lTrm0);
				env.boundVarNbr ::= bSaved;
				idn.equalsExpansionLevel ::= idn.equalsExpansionLevel - 1;
				__del = mizIntSetDelete(env.inferConsts, adjNr);
				switch (lTrm) {
					MizVarTrm(srt, varNr, __, __): {
						if (srt == ikTrmInfConst) arrayPush(acc, varNr) else acc;
					}
					default: acc;
				}
			} else {
				mizDisposeSubstTrm(env);
				acc;
			}
		});
	}
}

mizWireDefinientia(defs : MizDefinientia, pre : MizPre, idn : MizIdentify) -> void {
	pre.atomicExpansions ::= \f -> mizAtomicExpansions(pre.env, defs, f);
	idn.equalsExpand ::= \idn2, funcNr, args -> mizEqualsExpandHook(defs, idn2, funcNr, args);
}

// ---------------- the analyzer's definitional expansion ----------------

mizDefBodyFrm(b : MizDefBody) -> MizFrm {
	switch (b) {
		MizDefFrm(f): f;
		MizDefTrm(__): mizNewIncorFrm();
	}
}

// MakeDefiniens (identify.pas 218)
mizMakeDefiniensFrm(negated : bool, md : Maybe<MizDef>) -> MizFrm {
	switch (md) {
		None(): mizNewIncorFrm();
		Some(d): {
			if (sizeVector(d.partials) == 0) {
				dFrm = switch (d.otherwise) {
					Some(b): mizCopyFrm(mizDefBodyFrm(b));
					None(): mizNewIncorFrm();
				};
				if (negated) mizNewNeg(dFrm) else dFrm;
			} else {
				dFrm = ref mizNewNeg(mizNewVerum());
				lOtherGuard = ref mizNewVerum();
				iterVector(d.partials, \pd -> {
					body = mizCopyFrm(mizDefBodyFrm(pd.body));
					lFrm = mizNewConj(mizCopyFrm(pd.guard),
						if (negated) mizNewNeg(body) else body);
					dFrm := mizNewDisj(^dFrm, lFrm);
					if (isSome(d.otherwise))
						lOtherGuard := mizNewConj(^lOtherGuard,
							mizNewNeg(mizCopyFrm(pd.guard)));
				});
				switch (d.otherwise) {
					Some(b): {
						ob = mizCopyFrm(mizDefBodyFrm(b));
						lFrm = mizNewConj(^lOtherGuard,
							if (negated) mizNewNeg(ob) else ob);
						dFrm := mizNewDisj(^dFrm, lFrm);
					}
					None(): {}
				}
				^dFrm;
			}
		}
	}
}

// DefiniensObj.SpreadFrm (identify.pas 254)
mizSpreadFrm(env : MizCorrelEnv, d : MizDefiniens, args : MizTrmList,
		negated : bool, conclusion : bool) -> MizFrm {
	lFrm0 = mizMakeDefiniensFrm(negated, d.def);
	if (mizFrmSort(lFrm0) == ikError) mizNewIncorFrm()
	else {
		lFrm = if (mizFrmSort(d.assumptions) == ikFrmVerum) lFrm0
			else if (conclusion) mizNewConj(mizCopyFrm(d.assumptions), lFrm0)
			else mizNewNeg(mizNewConj(mizCopyFrm(d.assumptions), mizNewNeg(lFrm0)));
		mizInstFrm(env, lFrm, args);
	}
}
