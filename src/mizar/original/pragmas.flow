// Transcription of ~/dev/system/base/pragmas.pas — the `$V`/`$S` pragma
// intervals and the `$C` (canceled) pragma parser.
//
// The original keeps six unit-level collections; here they are one struct per
// article, as the CONVENTIONS require. VerifyPragmaOn/Off and SchemePragmaOn/Off
// are NatSets (sorted, deduped); the two Intervals are NatFuncs.

import string;
import loop;
import mizar/original/mobjects;

export {
	MizPragmas(
		verifyOn : MizNatFunc,
		verifyOff : MizNatFunc,
		verifyIntervals : MizNatFunc,
		schemeOn : MizNatFunc,
		schemeOff : MizNatFunc,
		schemeIntervals : MizNatFunc,
		mutable proofPragma : bool,
	);

	mizMakePragmas() -> MizPragmas;

	// procedure InsertPragma(aLine, aPrg)
	mizInsertPragma(p : MizPragmas, line : int, prg : string) -> void;

	// procedure CompletePragmas(aLine)
	mizCompletePragmas(p : MizPragmas, line : int) -> void;

	// procedure CanceledPragma(aPrg, var aKind, var aNbr) — the kind is ' '
	// when the pragma is not a `$C[DST]` one.
	mizCanceledPragma(prg : string) -> Pair<string, int>;
}

mizMakePragmas() -> MizPragmas {
	MizPragmas(mizInitNatSet(10), mizInitNatSet(10), mizInitNatFunc(10),
		mizInitNatSet(10), mizInitNatSet(10), mizInitNatFunc(10), true);
}

mizCanceledPragma(prg : string) -> Pair<string, int> {
	if (strLeft(prg, 2) != "$C") Pair(" ", 0)
	else if (strlen(prg) < 3) Pair(" ", 0)
	else {
		kind = getCharAt(prg, 2);
		if (kind != "D" && kind != "S" && kind != "T") Pair(" ", 0)
		else {
			lStr = trim(substring(prg, 3, strlen(prg) - 3));
			if (strlen(lStr) == 0) Pair(kind, 1)
			else {
				// the original scans the leading digits, deletes the rest and
				// only then converts — a non-numeric head leaves aNbr at 1
				k = ref 0;
				while(\ -> ^k < strlen(lStr) && isDigit(getCharAt(lStr, ^k)), \ -> k := ^k + 1);
				if (^k == 0) Pair(kind, 1) else Pair(kind, s2i(substring(lStr, 0, ^k)));
			}
		}
	}
}

// SetParserPragma lives in parser.flow — the parser owns the $P flag.

mizInsertPragma(p : MizPragmas, line : int, prg : string) -> void {
	h = strLeft(prg, 3);
	if (h == "$V+") mizNatInsertElem(p.verifyOn, line);
	if (h == "$V-") mizNatInsertElem(p.verifyOff, line);
	if (h == "$S+") mizNatInsertElem(p.schemeOn, line);
	if (h == "$S-") mizNatInsertElem(p.schemeOff, line);
}

mizCompleteOne(offSet : MizNatFunc, onSet : MizNatFunc, intervals : MizNatFunc,
		line : int) -> void {
	fori(0, mizNatCount(offSet) - 1, \i -> {
		a = mizNatItem(offSet, i).x;
		f = ref false;
		j = ref 0;
		while(\ -> !^f && ^j < mizNatCount(onSet), \ -> {
			b = mizNatItem(onSet, ^j).x;
			if (b >= a) { mizNatAssign(intervals, a, b); f := true; }
			j := ^j + 1;
		});
		if (!^f) mizNatAssign(intervals, a, line);
	});
}

mizCompletePragmas(p : MizPragmas, line : int) -> void {
	mizCompleteOne(p.verifyOff, p.verifyOn, p.verifyIntervals, line);
	mizCompleteOne(p.schemeOff, p.schemeOn, p.schemeIntervals, line);
}
