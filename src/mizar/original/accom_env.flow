// THE WHOLE ACCOMMODATION as an environment loader: everything the checker,
// the parser and the analyzer read is built from the article's .evl + prel/,
// never from the flat .atr/.ecl/.eth/.dct/.eno/... files. `mizarj article=X
// accom=1` runs this. The construction of the naming/prologue bytes is the
// env-gate's, verified byte-identical to the accommodated files on the whole
// MML — see mizar.flow's env-gate mode.

import ds/vector;
import ds/tree;
import string;
import mizar/original/errhan;
import mizar/original/correl;
import mizar/original/prep;
import mizar/original/accom;
import mizar/original/accom_dict;
import mizar/original/accom_notation;

export {
	mizAccomEnvLoader(mmlDir : string, article : string, mizFiles : string)
		-> MizEnvLoader;
}

// the naming-pass state the byte producers share, built once per article:
// the vocabulary pass (accdict), a PRIVATE constructor frame, the notation
// pass over it — exactly the env-gate's construction
MizAccomFiles(d : MizDict, an : MizAccNotat, env2 : MizCorrelEnv, acc2 : MizAccom);

mizAccomEnvLoader(mmlDir : string, article : string, mizFiles : string)
		-> MizEnvLoader {
	evl = mizLoadEvl(mmlDir + "/" + article + ".evl");
	// the state is shared by the two phases
	accRef : ref Maybe<MizAccom> = ref None();
	filesRef : ref Maybe<MizAccomFiles> = ref None();
	filesOf = \ -> {
		switch (^filesRef) {
			Some(f): f;
			None(): {
				d = mizProcessVocabularies(mizFiles, mmlDir,
					mizEvlDirective(evl, "vocabularies"),
					mizEvlDirective(evl, "theorems"),
					mizEvlDirective(evl, "schemes"));
				env2 = mizMakeCorrelEnv();
				acc2 = mizMakeAccom(env2, mmlDir);
				mizAccomConstructors(acc2, evl);
				an = mizMakeAccNotat(d);
				mizProcessNotation(acc2, d, an, mizEvlDirective(evl, "notations"));
				f = MizAccomFiles(d, an, env2, acc2);
				filesRef := Some(f);
				f;
			}
		}
	}
	MizEnvLoader(
		\env -> {
			acc = mizMakeAccom(env, mmlDir);
			accRef := Some(acc);
			mizAccomConstructors(acc, evl);
			mizAccomRequirements(acc, evl);
		},
		\env, cl -> {
			switch (^accRef) {
				None(): mizRunTimeError(2805);
				Some(acc): mizAccomClusters(acc, cl, evl);
			}
		},
		\env, cl, idn, defs, p -> {
			switch (^accRef) {
				None(): mizRunTimeError(2805);
				Some(acc): {
					// the accommodator reads prel/ in the SOURCE frames, so the
					// AfterClusters treatment must wait until each item has
					// been translated — mizEnvify* applies it afterwards
					env.afterClusters ::= false;
					th = mizAccomTheorems(acc, evl);
					p.theorems ::= th.first;
					p.ownArticleNr ::= th.second;
					mizAccomReductions(acc, evl, idn);
					mizAccomIdentifications(acc, evl, idn);
					iterVector(mizAccomSchemes(acc, evl).items,
						\sc -> pushVector(p.schemes.items, sc));
					iterVector(mizAccomDefinientia(acc, evl, "definitions", true),
						\d -> pushVector(defs.all, d));
					iterVector(mizAccomDefinientia(acc, evl, "expansions", true),
						\d -> pushVector(defs.expansions, d));
					iterVector(mizAccomDefinientia(acc, evl, "equalities", true),
						\d -> mizAddEqualsDef(env, defs, d));
					env.afterClusters ::= true;
				}
			}
		},
		\ext -> {
			f = filesOf();
			aid = toUpperCase(article);
			if (ext == ".dct") mizDctContent(f.d)
			else if (ext == ".dcx") mizDcxContent(f.d, aid, mizFiles)
			else if (ext == ".frm") mizFrmContent(f.an, f.d)
			else if (ext == ".prf") mizPrfContent(f.an, f.d)
			else if (ext == ".eno") mizEnoContent(f.an, f.env2, aid, mizFiles)
			else if (ext == ".dfs") mizDefinientiaContent(f.env2,
				mizAccomDefinientia(f.acc2, evl, "definitions", false),
				mizEvlDirective(evl, "definitions"), aid, mizFiles)
			else if (ext == ".epr") mizEprContent(f.env2,
				mizAccomProperties(f.acc2, evl),
				mizEvlDirective(evl, "registrations"), aid, mizFiles)
			else if (ext == ".atr") mizAtrContent(mmlDir, evl, aid, mizFiles)
			else if (ext == ".eth") mizEthContent(f.acc2, evl, aid, mizFiles)
			else "";
		});
}
