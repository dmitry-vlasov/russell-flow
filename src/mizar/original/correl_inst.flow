// Transcription of ~/dev/system/kernel/correl.pas (part 2): instantiation,
// term typing, and type widening.
//
// The original threads instantiation through CopyTerm via the globals
// Instantiated / Instantiation[] / BoundBase: while Instantiated, copying a
// LOCUS k yields a copy of Instantiation[k] with bound variables above
// BoundBase renumbered by (BoundVarNbr - BoundBase) — RenBound. Here that
// state lives in MizCorrelEnv and the env-aware copy family mizInstCopy*
// implements exactly the same protocol (including EqConst node SHARING:
// CopyTerm returns the same node for ikTrmEqConst — the equalizer relies on
// this identity).
//
// GetTrmType's gTermCollection is NOT a pure memoization: InsertTermInTTColl
// stores the ROUNDED type, so GetTrmType of a functor term is stronger than
// CopyTrmType of it. See mizGetTrmType below.

import ds/vector;
import loop;
import mizar/original/errhan;
import mizar/original/mobjects;
import mizar/original/lexicon;
import mizar/original/builtin;
import mizar/original/correl;
import net/url_parameter;

export {
	// InstTyp/InstTrm/InstFrm/InstCluster: substitute the argument list for
	// loci 1..n and copy. InstTrmInTyp: single-term substitution for locus 1.
	mizInstTyp(env : MizCorrelEnv, typ : MizTyp, args : MizTrmList) -> MizTyp;
	mizInstTrm(env : MizCorrelEnv, trm : MizTrm, args : MizTrmList) -> MizTrm;
	mizInstFrm(env : MizCorrelEnv, frm : MizFrm, args : MizTrmList) -> MizFrm;
	mizInstCluster(env : MizCorrelEnv, clu : MizAttrColl, args : MizTrmList) -> MizAttrColl;
	mizInstTrmInTyp(env : MizCorrelEnv, typ : MizTyp, trm : MizTrm) -> MizTyp;
	mizInstQual(env : MizCorrelEnv, frm : MizFrm, args : MizTrmList, trm : MizTrm) -> MizFrm;

	// the env-aware copy family (CopyTerm/CopyType/CopyFormula/CopyCluster
	// under the instantiation protocol; plain deep copy when not instantiated)
	mizInstCopyTrm(env : MizCorrelEnv, t : MizTrm) -> MizTrm;
	mizInstCopyTrmList(env : MizCorrelEnv, l : MizTrmList) -> MizTrmList;
	mizInstCopyTyp(env : MizCorrelEnv, t : MizTyp) -> MizTyp;
	mizInstCopyCluster(env : MizCorrelEnv, c : MizAttrColl) -> MizAttrColl;
	mizInstCopyFrm(env : MizCorrelEnv, f : MizFrm) -> MizFrm;

	// CopyTrmType / GetTrmType: the type of a term
	mizCopyTrmType(env : MizCorrelEnv, t : MizTrm) -> MizTyp;
	mizGetTrmType(env : MizCorrelEnv, t : MizTrm) -> MizTyp;
	// gTermCollection scoping (MarkTermsInTTColl / RemoveTermsFromTTColl)
	mizTTCollMark(env : MizCorrelEnv) -> int;
	mizTTCollRelease(env : MizCorrelEnv, mark : int) -> void;
	mizTTCollFreeAll(env : MizCorrelEnv) -> void;

	// widening family
	mizEqRadices(env : MizCorrelEnv, a : MizTyp, b : MizTyp) -> bool;
	mizDecreasingAttrs(env : MizCorrelEnv, source : MizTyp, target : MizTyp,
		eqAttr : (MizAttr, MizAttr) -> bool) -> bool;
	mizAttrCollIsSubsetOf(env : MizCorrelEnv, c : MizAttrColl, other : MizAttrColl,
		eqAttr : (MizAttr, MizAttr) -> bool) -> bool;
	mizTypReachable(env : MizCorrelEnv, wider : MizTyp, narrower : MizTyp) -> bool;
	mizWidening(env : MizCorrelEnv, t : MizTyp) -> Maybe<MizTyp>;
	mizWidenToStruct(env : MizCorrelEnv, t : MizTyp) -> Maybe<MizTyp>;
	mizWideningOf(env : MizCorrelEnv, target : MizTyp, source : MizTyp) -> Maybe<MizTyp>;
	mizMotherStructNr(env : MizCorrelEnv, selNr : int) -> int;
	mizReconSelectTrm(env : MizCorrelEnv, selNr : int, lastArg : MizTrm,
		typ : MizTyp) -> Maybe<MizTrm>;
	mizReconAggregTrm(env : MizCorrelEnv, structNr : int, lastArg : MizTrm,
		typ : MizTyp) -> MizTrm;
	mizIsWiderThan(env : MizCorrelEnv, wider : MizTyp, narrower : MizTyp) -> bool;
	mizCopyAllowed(env : MizCorrelEnv, typ : MizTyp, origin : MizAttrColl) -> MizAttrColl;
	mizAdjustedAttrNrOf(env : MizCorrelEnv, a : MizAttr) -> int;

	// CopyExp*: copy while EXPANDING PrivFunc/PrivPred into their expansions
	// (when correct) and flattening conjunctions; EqConst nodes shared.
	mizCopyExpTrm(t : MizTrm) -> MizTrm;
	mizCopyExpTrmList(l : MizTrmList) -> MizTrmList;
	mizCopyExpTyp(t : MizTyp) -> MizTyp;
	mizCopyExpFrm(f : MizFrm) -> MizFrm;
	// ExpPrivFuncInTrm (correl.pas 5031): private functors -> their expansions
	mizExpPrivFuncInTrm(t : MizTrm) -> MizTrm;
	mizNewDisj(a : MizFrm, b : MizFrm) -> MizFrm;
	// InsertTermInTTColl (correl.pas 1151) — the analyzer calls it explicitly
	// after building a functor / selector / aggregate term
	mizInsertTermInTTColl(env : MizCorrelEnv, t : MizTrm) -> void;
	// FrOpVarTypeOK (identify.pas 668): a Fraenkel bound variable's type must
	// be a mode whose constructor has the `sethood` property
}

// RenBound over a freshly copied instantiation term
mizRenBound(env : MizCorrelEnv, t : MizTrm) -> MizTrm {
	w = mizMakeWithin(\__, trm -> {
		switch (trm) {
			MizVarTrm(srt, varNr, __, __): {
				if (srt == ikTrmBound && varNr > env.boundBase) {
					vt = mizAsVarTrmL(trm);
					vt.varNr ::= varNr + (env.boundVarNbr - env.boundBase);
				}
				trm;
			}
			default: trm;
		}
	});
	mizWithinTrm(w, t);
}

mizAsVarTrmL(t : MizTrm) -> MizVarTrm {
	switch (t) {
		MizVarTrm(__, __, __, __): t;
		default: { mizRunTimeError(2901); MizVarTrm(ikError, 0, 0, 0); }
	}
}

// CopyTerm under the instantiation protocol.
mizInstCopyTrm(env : MizCorrelEnv, t : MizTrm) -> MizTrm {
	srt0 = mizTrmSort(t);
	if (srt0 == ikTrmEqConst) {
		t; // SHARED, not copied — identity matters in the equalizer
	} else if (env.instantiated && srt0 == ikTrmLocus) {
		vt = mizAsVarTrmL(t);
		if (vt.varNr >= sizeVector(env.instantiation)) {
			// an unfilled locus slot: the original leaves garbage here and
			// relies on it never being read; an incorrect term poisons the
			// result the same way NewInCorFrm would
			mizNewIncorTrm();
		} else {
			env.instantiated ::= false;
			lTrm = mizInstCopyTrm(env, getVectorUnsafe(env.instantiation, vt.varNr));
			env.instantiated ::= true;
			mizRenBound(env, lTrm);
		}
	} else {
		switch (t) {
			MizVarTrm(srt, varNr, pattNr, __): MizVarTrm(srt, varNr, pattNr, 0);
			MizFuncTrm(srt, funcNr, args, pattNr, __):
				MizFuncTrm(srt, funcNr, mizInstCopyTrmList(env, args), pattNr, 0);
			MizPrivFuncTrm(funcNr, args, funcExp, pattNr, __):
				MizPrivFuncTrm(funcNr, mizInstCopyTrmList(env, args),
					mizInstCopyTrm(env, funcExp), pattNr, 0);
			MizFraenkelTrm(lambdaArgs, scope, compr, idents, pattNr, __): {
				i0 = env.boundVarNbr;
				la : Vector<MizTyp> = makeVector(sizeVector(lambdaArgs));
				iterVector(lambdaArgs, \typ -> {
					env.boundVarNbr ::= env.boundVarNbr + 1;
					pushVector(la, mizInstCopyTyp(env, typ));
				});
				sc = mizInstCopyTrm(env, scope);
				cp = mizInstCopyFrm(env, compr);
				env.boundVarNbr ::= i0;
				MizFraenkelTrm(la, sc, cp, mizCopyIntSeq(idents), pattNr, 0);
			}
			MizChoiceTrm(typ, pattNr, __): MizChoiceTrm(mizInstCopyTyp(env, typ), pattNr, 0);
			MizQuaTrm(trmProper, qua, pattNr, __):
				MizQuaTrm(mizInstCopyTrm(env, trmProper), mizInstCopyTyp(env, qua), pattNr, 0);
			MizBaseTrm(srt, __): MizBaseTrm(srt, 0);
		}
	}
}

mizInstCopyTrmList(env : MizCorrelEnv, l : MizTrmList) -> MizTrmList {
	switch (l) {
		MizTrmNil(): l;
		MizTrmElem(trm, next):
			MizTrmElem(mizInstCopyTrm(env, trm), mizInstCopyTrmList(env, next));
	}
}

mizInstCopyAttr(env : MizCorrelEnv, a : MizAttr) -> MizAttr {
	MizAttr(a.neg, a.attrNr, mizInstCopyTrmList(env, a.args), false, a.pattNr);
}

mizInstCopyCluster(env : MizCorrelEnv, c : MizAttrColl) -> MizAttrColl {
	MizAttrColl(mapVector(c.items, \a -> mizInstCopyAttr(env, a)), c.consistent);
}

mizInstCopyTyp(env : MizCorrelEnv, t : MizTyp) -> MizTyp {
	MizTyp(t.sort, mizInstCopyCluster(env, t.lower), mizInstCopyCluster(env, t.upper),
		t.modNr, mizInstCopyTrmList(env, t.modArgs), t.pattNr);
}

mizInstCopyFrm(env : MizCorrelEnv, f : MizFrm) -> MizFrm {
	switch (f) {
		MizPredFrm(srt, predNr, args, pattNr):
			MizPredFrm(srt, predNr, mizInstCopyTrmList(env, args), pattNr);
		MizLocPredFrm(predNr, args, expn, pattNr):
			MizLocPredFrm(predNr, mizInstCopyTrmList(env, args),
				mizInstCopyFrm(env, expn), pattNr);
		MizQualFrm(trm, typ, pattNr):
			MizQualFrm(mizInstCopyTrm(env, trm), mizInstCopyTyp(env, typ), pattNr);
		MizNegFrm(arg, pattNr): MizNegFrm(mizInstCopyFrm(env, arg), pattNr);
		MizBinFrm(srt, l, r, pattNr):
			MizBinFrm(srt, mizInstCopyFrm(env, l), mizInstCopyFrm(env, r), pattNr);
		MizConjFrm(conjuncts, pattNr):
			MizConjFrm(mapVector(conjuncts, \g -> mizInstCopyFrm(env, g)), pattNr);
		MizUnivFrm(srt, varId, quantified, scope, pattNr): {
			// UnivFrmObj.CopyFormula bumps BoundVarNbr while copying the scope
			q = mizInstCopyTyp(env, quantified);
			env.boundVarNbr ::= env.boundVarNbr + 1;
			s = mizInstCopyFrm(env, scope);
			env.boundVarNbr ::= env.boundVarNbr - 1;
			MizUnivFrm(srt, varId, q, s, pattNr);
		}
		MizUniqFrm(srt): MizUniqFrm(srt);
		MizFlexFrm(srt, lo, ro, lt, rt, expn, pattNr):
			MizFlexFrm(srt, mizInstCopyFrm(env, lo), mizInstCopyFrm(env, ro),
				mizInstCopyTrm(env, lt), mizInstCopyTrm(env, rt),
				mizInstCopyFrm(env, expn), pattNr);
	}
}

// fill Instantiation[1..] from a TrmList (InitInstList pattern)
mizSetInstantiation(env : MizCorrelEnv, args : MizTrmList) -> void {
	clearVector(env.instantiation);
	pushVector(env.instantiation, mizNewIncorTrm()); // dummy slot 0
	cur = ref args;
	while(\ -> switch (^cur) { MizTrmNil(): false; default: true; }, \ -> {
		switch (^cur) {
			MizTrmElem(trm, next): {
				pushVector(env.instantiation, trm);
				cur := next;
			}
			MizTrmNil(): {}
		}
	});
	env.instantiated ::= true;
	env.boundBase ::= env.boundVarNbr;
}

mizStopInst(env : MizCorrelEnv) -> void {
	env.instantiated ::= false;
}

mizInstTyp(env : MizCorrelEnv, typ : MizTyp, args : MizTrmList) -> MizTyp {
	mizSetInstantiation(env, args);
	res = mizInstCopyTyp(env, typ);
	mizStopInst(env);
	res;
}

mizInstTrm(env : MizCorrelEnv, trm : MizTrm, args : MizTrmList) -> MizTrm {
	mizSetInstantiation(env, args);
	res = mizInstCopyTrm(env, trm);
	mizStopInst(env);
	res;
}

mizInstFrm(env : MizCorrelEnv, frm : MizFrm, args : MizTrmList) -> MizFrm {
	mizSetInstantiation(env, args);
	res = mizInstCopyFrm(env, frm);
	mizStopInst(env);
	res;
}

mizInstCluster(env : MizCorrelEnv, clu : MizAttrColl, args : MizTrmList) -> MizAttrColl {
	mizSetInstantiation(env, args);
	res = mizInstCopyCluster(env, clu);
	mizStopInst(env);
	res;
}

mizInstTrmInTyp(env : MizCorrelEnv, typ : MizTyp, trm : MizTrm) -> MizTyp {
	clearVector(env.instantiation);
	pushVector(env.instantiation, mizNewIncorTrm());
	pushVector(env.instantiation, trm);
	env.instantiated ::= true;
	env.boundBase ::= env.boundVarNbr;
	res = mizInstCopyTyp(env, typ);
	mizStopInst(env);
	res;
}

mizInstQual(env : MizCorrelEnv, frm : MizFrm, args : MizTrmList, trm : MizTrm) -> MizFrm {
	mizSetInstantiation(env, args);
	pushVector(env.instantiation, trm); // Instantiation[k] := fTrm after the list
	res = mizInstCopyFrm(env, frm);
	mizStopInst(env);
	res;
}

// ---------------- term typing ----------------

mizCopyTrmType(env : MizCorrelEnv, t : MizTrm) -> MizTyp {
	switch (t) {
		MizVarTrm(srt, varNr, __, __): {
			if (srt == ikTrmBound) {
				mizCopyTyp(mizBoundVar(env, varNr));
			} else if (srt == ikTrmConstant) {
				typ = if (varNr < sizeVector(env.fixedVar)) {
					fv : MizFixedVar = getVectorUnsafe(env.fixedVar, varNr);
					mizCopyTyp(fv.typ);
				} else mizNewIncorTyp();
				// WithinType(ChangeBound): bound vars shift by gBoundBase —
				// in the checker gBoundBase tracks the current binder depth
				w = mizMakeWithin(\__, trm -> {
					switch (trm) {
						MizVarTrm(s2, v2, __, __): {
							if (s2 == ikTrmBound) {
								vt = mizAsVarTrmL(trm);
								vt.varNr ::= v2 + env.boundVarNbr;
							}
							trm;
						}
						default: trm;
					}
				});
				mizWithinTyp(w, typ);
				typ;
			} else if (srt == ikTrmInfConst) {
				if (varNr < sizeVector(env.inferConstDef)) {
					cd : MizConstDef = getVectorUnsafe(env.inferConstDef, varNr);
					mizCopyTyp(cd.typ);
				} else mizNewIncorTyp();
			} else if (srt == ikTrmNumeral) {
				mizCopyTyp(env.nonZeroTyp);
			} else if (srt == ikTrmLocus) {
				mizCopyTyp(getVectorUnsafe(env.locArgTyp, varNr));
			} else {
				mizRunTimeError(2054);
				mizNewIncorTyp();
			}
		}
		MizFuncTrm(srt, funcNr, args, __, __): {
			if (srt == ikTrmSchFunc) {
				// a Pascal MCollection read past Count does not fault; the
				// port must not either (RoundUpItem reaches terms whose
				// scheme context is already gone)
				if (funcNr - 1 < sizeVector(env.curSchFuncTyp))
					mizCopyTyp(getVectorUnsafe(env.curSchFuncTyp, funcNr - 1))
				else mizNewIncorTyp();
			} else {
				// Functor/Selector/Aggreg: instantiate the constructor's type
				kind = if (srt == ikTrmFunctor) coFunctor
					else if (srt == ikTrmSelector) coSelector
					else coAggregate;
				c = mizConstr(env, kind, funcNr);
				switch (c.typ) {
					Some(ct): mizInstTyp(env, ct, args);
					None(): {
						mizRunTimeError(2054);
						mizNewIncorTyp();
					}
				}
			}
		}
		MizPrivFuncTrm(funcNr, args, __, __, __): {
			if (funcNr - 1 < sizeVector(env.locFuncDef)) {
				fd : MizFuncDef = getVectorUnsafe(env.locFuncDef, funcNr - 1);
				mizInstTyp(env, fd.funcTyp, args);
			} else mizNewIncorTyp();
		}
		MizFraenkelTrm(__, __, __, __, __, __):
			mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(),
				mizBuiltIn(env.builtIn, rqSetMode), MizTrmNil());
		MizChoiceTrm(typ, __, __): mizCopyTyp(typ);
		MizQuaTrm(__, qua, __, __): mizCopyTyp(qua);
		MizBaseTrm(srt, __): {
			if (srt == ikTrmIt) mizCopyTyp(env.itTyp)
			else mizNewIncorTyp(); // ikError
		}
	}
}

// gTermCollection lookup: the sorted position of a term, and whether it is
// already there (correl.pas 1175 InsertTermInTTColl / GetTrmType 1157)
mizTTCollSearch(env : MizCorrelEnv, t : MizTrm) -> Pair<bool, int> {
	l = ref 0;
	h = ref sizeVector(env.ttColl) - 1;
	found = ref false;
	while(\ -> ^l <= ^h && !^found, \ -> {
		m = (^l + ^h) / 2;
		c = mizCompTrms(env, getVectorUnsafe(env.ttColl, m).trm, t);
		if (c < 0) l := m + 1
		else if (c > 0) h := m - 1
		else { found := true; l := m; }
	});
	Pair(^found, ^l);
}

// GetTrmType (correl.pas 1157). For a functor/selector/aggregate term this is
// NOT CopyTrmType: the original routes it through gTermCollection, and
// InsertTermInTTColl stores the type ROUNDED (RoundUpTrmTypeWithType plus one
// RoundUpWith of the resulting upper cluster). Returning the raw type here
// gave a weaker type on every non-checker path — CheckLociTypes outside an
// inference, and the scheme instantiations.
// The entry is inserted with its RAW type BEFORE the rounding runs, exactly as
// the original does: that is what stops a rounding which asks for the same
// term's type again from recursing forever.
mizGetTrmType(env : MizCorrelEnv, t : MizTrm) -> MizTyp {
	srt = mizTrmSort(t);
	if (srt == ikTrmFunctor || srt == ikTrmSelector || srt == ikTrmAggreg) {
		p = mizTTCollSearch(env, t);
		if (p.first && getUrlParameterDef("no-tt-cache", "") != "1") {
			mizCopyTyp(getVectorUnsafe(env.ttColl, p.second).typ);
		} else {
			entry = MizTTPair(mizCopyTrm(t), mizCopyTrmType(env, t), env.termScope);
			mizVectorAtInsert(env.ttColl, p.second, entry);
			if (env.termScope > env.ttMaxScope) env.ttMaxScope ::= env.termScope;
			rounded = env.roundUpTrmType(env, t);
			cl = mizCopyCluster(rounded.upper);
			env.roundUpCluster(env, cl, rounded);
			rounded.upper ::= cl;
			entry.typ ::= rounded;
			mizCopyTyp(rounded);
		}
	} else {
		mizCopyTrmType(env, t);
	}
}

// MarkTermsInTTColl / RemoveTermsFromTTColl (checker.pas 335 / 434): the
// collection is scoped to one inference.
// MarkTermsInTTColl (correl.pas 1099) — `inc(gTermScope)`, nothing else.
mizTTCollMark(env : MizCorrelEnv) -> int {
	env.termScope ::= env.termScope + 1;
	env.termScope;
}

// RemoveTermsFromTTColl (correl.pas 1200) — `dec(gTermScope)`, then DELETE
// every entry stamped above the new scope and Pack. The collection is SORTED
// by CompTrms, so the entries a scope created are scattered through it: a
// position mark that pops the tail keeps the wrong ones alive. A surviving
// stale entry poisons GetTrmType, which returns the ROUNDED type it holds —
// commacat's first deffunc gained a `non empty` its argument no longer had.
// The `mark` argument is the scope this release returns to; the original
// simply decrements, so it is used only to keep the port's call sites honest.
mizTTCollRelease(env : MizCorrelEnv, mark : int) -> void {
	mizIgnoreInt(mark);
	env.termScope ::= env.termScope - 1;
	scope = env.termScope;
	// ttMaxScope is the highest stamp present. When nothing is stamped above
	// the new scope the original's loop deletes nothing and Pack is a no-op,
	// so skip the walk — the checker runs this per inference.
	if (env.ttMaxScope > scope) {
		n = sizeVector(env.ttColl);
		w = ref 0;
		mx = ref 0;
		fori(0, n - 1, \i -> {
			e = getVectorUnsafe(env.ttColl, i);
			if (e.termScope <= scope) {
				if (^w != i) setVectorUnsafe(env.ttColl, ^w, e);
				if (e.termScope > ^mx) mx := e.termScope;
				w := ^w + 1;
			}
		});
		while(\ -> sizeVector(env.ttColl) > ^w,
			\ -> removeVector(env.ttColl, sizeVector(env.ttColl) - 1));
		env.ttMaxScope ::= ^mx;
	}
}

mizIgnoreInt(i : int) -> void {}

// gTermCollection.FreeAll (iocorrel.pas 3295) — the whole collection, and the
// scope counter is untouched (the original's FreeAll does not move it).
mizTTCollFreeAll(env : MizCorrelEnv) -> void {
	clearVector(env.ttColl);
	env.ttMaxScope ::= 0;
}

// ---------------- widening ----------------

mizEqRadices(env : MizCorrelEnv, a : MizTyp, b : MizTyp) -> bool {
	if (a.sort != b.sort) {
		false;
	} else if (a.sort == ikTypMode) {
		pa = mizAdjustTyp(env, a);
		pb = mizAdjustTyp(env, b);
		pa.first == pb.first && mizEqTrmList(env, pa.second, pb.second);
	} else if (a.sort == ikTypStruct) {
		a.modNr == b.modNr && mizEqTrmList(env, a.modArgs, b.modArgs);
	} else {
		mizRunTimeError(2051);
		false;
	}
}

mizAdjustedAttrNrOf(env : MizCorrelEnv, a : MizAttr) -> int {
	mizAdjustedAttrNr(env, a);
}

// MAttrCollection.IsSubsetOf (correl.pas 2784).
//
// THE SORTED-MERGE VERSION IS COMMENTED OUT IN THE ORIGINAL (correl.pas 2771,
// marked `//AN!`). The live one is an O(n*m) NESTED LOOP, and the difference
// is not efficiency:
//  * it does not assume either collection is sorted — and they are not. A
//    conditional cluster's antecedent comes out of the .ecl in file order; in
//    chord, XXREAL_2:8's antecedent has adjusted numbers [147, 4, 156]. The
//    merge version walks off the end and reports "not a subset" for every
//    cluster whose antecedent is not ascending.
//  * aEqAttr may be an Es-matcher (EsAttrRev), which BINDS LOCI as a side
//    effect, so the original snapshots gSubstTrm before each attempt and
//    restores it when the attempt fails. The merge version tries each element
//    once and leaves the failed bindings behind.
mizAttrCollIsSubsetOf(env : MizCorrelEnv, c : MizAttrColl, other : MizAttrColl,
		eqAttr : (MizAttr, MizAttr) -> bool) -> bool {
	n = sizeVector(c.items);
	m = sizeVector(other.items);
	if (m < n) {
		false;
	} else {
		matched = ref 0;
		i = ref 0;
		while(\ -> ^i < n, \ -> {
			a : MizAttr = getVectorUnsafe(c.items, ^i);
			found = ref false;
			j = ref 0;
			while(\ -> !^found && ^j < m, \ -> {
				snap = copyVector(env.substTrm);
				if (eqAttr(getVectorUnsafe(other.items, ^j), a)) {
					found := true;
				} else {
					// gSubstTrm := lSubstTrm — restore wholesale
					fori(0, sizeVector(env.substTrm) - 1, \k ->
						setVectorUnsafe(env.substTrm, k, getVectorUnsafe(snap, k)));
				}
				j := ^j + 1;
			});
			if (^found) matched := ^matched + 1;
			i := ^i + 1;
		});
		^matched == n;
	}
}

mizDecreasingAttrs(env : MizCorrelEnv, source : MizTyp, target : MizTyp,
		eqAttr : (MizAttr, MizAttr) -> bool) -> bool {
	// TypObj.DecreasingAttrs: called as narrower.DecreasingAttrs(self) with
	// self = the WIDER type; target's lower attrs must sit in source's upper
	if (sizeVector(target.lower.items) == 0) {
		true;
	} else {
		mizAttrCollIsSubsetOf(env, target.lower, source.upper, eqAttr);
	}
}

mizTypReachable(env : MizCorrelEnv, wider : MizTyp, narrower : MizTyp) -> bool {
	if (wider.sort != ikTypMode || narrower.sort != ikTypMode) {
		true;
	} else if (wider.modNr == mizBuiltIn(env.builtIn, rqAny)) {
		true;
	} else {
		lModNr0 = wider.modNr;
		cw = mizConstr(env, coMode, lModNr0);
		lModNr = if (cw.whichConstrNr != 0) cw.whichConstrNr else lModNr0;
		cur = ref narrower;
		res = ref false;
		brk = ref false;
		while(\ -> !^brk && (^cur).sort == ikTypMode && (^cur).modNr >= lModNr, \ -> {
			cn = mizConstr(env, coMode, (^cur).modNr);
			orig = cn.whichConstrNr;
			if ((^cur).modNr == lModNr || orig == lModNr) {
				res := true;
				brk := true;
			} else {
				switch (cn.typ) {
					Some(ct): cur := ct;
					None(): brk := true;
				}
			}
		});
		^res;
	}
}

mizCopyAllowed(env : MizCorrelEnv, typ : MizTyp, origin : MizAttrColl) -> MizAttrColl {
	res = mizNewEmptyCluster();
	mizAssert(2599, typ.sort == ikTypMode);
	pm = mizAdjustTyp(env, typ);
	lModNr = pm.first;
	iterVector(origin.items, \a -> {
		lAttrNr = mizAdjustedAttrNr(env, a);
		ca = mizConstr(env, coAttribute, lAttrNr);
		switch (ca.typ) {
			Some(ct): {
				if (ct.sort == ikTypMode) {
					if (lModNr != ct.modNr) {
						mizAttrCollInsert(env, res, mizCopyAttr(a));
					}
				} else if (ct.sort == ikTypStruct) {
					mizAttrCollInsert(env, res, mizCopyAttr(a));
				}
			}
			None(): {}
		}
	});
	res;
}

mizWidening(env : MizCorrelEnv, t : MizTyp) -> Maybe<MizTyp> {
	if (t.sort == ikTypMode) {
		if (t.modNr == mizBuiltIn(env.builtIn, rqAny)) {
			None();
		} else {
			c = mizConstr(env, coMode, t.modNr);
			switch (c.typ) {
				Some(ct): {
					lTyp = mizInstTyp(env, ct, t.modArgs);
					lTyp.upper ::= mizCopyAllowed(env, t, t.upper);
					Some(lTyp);
				}
				None(): None();
			}
		}
	} else if (t.sort == ikTypStruct) {
		Some(mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(),
			mizBuiltIn(env.builtIn, rqSetMode), MizTrmNil()));
	} else {
		mizRunTimeError(2223);
		None();
	}
}

mizWidenToStruct(env : MizCorrelEnv, t : MizTyp) -> Maybe<MizTyp> {
	cur = ref mizCopyTyp(t);
	res : ref Maybe<MizTyp> = ref None();
	brk = ref false;
	while(\ -> !^brk, \ -> {
		if ((^cur).sort == ikTypMode) {
			switch (mizWidening(env, ^cur)) {
				Some(w): cur := w;
				None(): brk := true; // ran out — result stays None
			}
		} else {
			res := Some(^cur);
			brk := true;
		}
	});
	^res;
}

mizWideningOf(env : MizCorrelEnv, target : MizTyp, source : MizTyp) -> Maybe<MizTyp> {
	if (target.sort == ikTypMode) {
		pt = mizAdjustTyp(env, target);
		lModNr = pt.first;
		cur = ref source;
		res : ref Maybe<MizTyp> = ref None();
		brk = ref false;
		while(\ -> !^brk && (^cur).sort == ikTypMode && (^cur).modNr >= lModNr, \ -> {
			cm = mizConstr(env, coMode, (^cur).modNr);
			if ((^cur).modNr == lModNr || cm.whichConstrNr == lModNr) {
				res := Some(^cur);
				brk := true;
			} else {
				switch (mizWidening(env, ^cur)) {
					Some(w): cur := w;
					None(): brk := true;
				}
			}
		});
		if (isNone(^res) && (^cur).sort == ikTypStruct) {
			if (lModNr == mizBuiltIn(env.builtIn, rqSetMode)) {
				res := Some(MizTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(),
					mizBuiltIn(env.builtIn, rqSetMode), MizTrmNil(), 0));
			} else if (lModNr == mizBuiltIn(env.builtIn, rqAny)) {
				res := Some(MizTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(),
					mizBuiltIn(env.builtIn, rqAny), MizTrmNil(), 0));
			}
		}
		^res;
	} else if (target.sort == ikTypStruct) {
		switch (mizWidenToStruct(env, source)) {
			None(): None();
			Some(st0): {
				if (target.modNr == st0.modNr) {
					Some(st0);
				} else {
					cs = mizConstr(env, coStructMode, target.modNr);
					co = mizConstr(env, coStructMode, st0.modNr);
					if (mizNatCount(cs.fields) == 0
						|| !mizNatIsSubsetOf(cs.fields, co.fields)) {
						None();
					} else {
						// WidenningPath: DFS through prefixes to target.modNr
						path : Vector<MizTyp> = makeVector(4);
						found = mizWidenningPath(env, st0.modNr, target.modNr, path);
						if (found) {
							cur2 = ref st0;
							// prefixes were pushed root-first along the found path
							iterVector(path, \pref : MizTyp -> {
								cur2 := mizInstTyp(env, pref, (^cur2).modArgs);
							});
							Some(^cur2);
						} else {
							None();
						}
					}
				}
			}
		}
	} else {
		None(); // ikError
	}
}

// WidenningPath: DFS over struct prefixes from struct nr `from` to `target`,
// collecting the prefix types along the successful path (in visit order).
mizWidenningPath(env : MizCorrelEnv, from : int, target : int,
		path : Vector<MizTyp>) -> bool {
	cs = mizConstr(env, coStructMode, from);
	found = ref false;
	i = ref 0;
	// prefixes of a struct are its fPrefixes; stored in c.primaries? NO —
	// StructConstrObj.fPrefixes is separate; kept in MizConstr.prefixes below
	prefs = mizConstrPrefixes(env, from);
	n = sizeVector(prefs);
	while(\ -> !^found && ^i < n, \ -> {
		p : MizTyp = getVectorUnsafe(prefs, ^i);
		if (p.modNr == target) {
			pushVector(path, p);
			found := true;
		} else {
			if (mizWidenningPath(env, p.modNr, target, path)) {
				// insert this prefix BEFORE the deeper ones (original AtPut
				// at the reserved slot): emulate by inserting at position 0
				mizVectorAtInsert(path, 0, p);
				found := true;
			}
		}
		i := ^i + 1;
	});
	^found;
}

mizIsWiderThan(env : MizCorrelEnv, wider : MizTyp, narrower0 : MizTyp) -> bool {
	// TypObj.IsWiderThan: self = wider; the argument is consumed by widening.
	// Gate: wider's lower attrs must sit in narrower's upper (DecreasingAttrs).
	if (!mizDecreasingAttrs(env, narrower0, wider, \x, y -> mizEqAttr(env, x, y))) {
		false;
	} else if (wider.sort == ikTypMode) {
		pw = mizAdjustTyp(env, wider);
		lModNr = pw.first;
		cur = ref narrower0;
		res = ref false;
		brk = ref false;
		while(\ -> !^brk && (^cur).sort == ikTypMode && (^cur).modNr >= lModNr, \ -> {
			if (mizEqRadices(env, wider, ^cur)) {
				res := true;
				brk := true;
			} else {
				switch (mizWidening(env, ^cur)) {
					Some(w): cur := w;
					None(): brk := true;
				}
			}
		});
		if (!^res && (^cur).sort == ikTypStruct) {
			if (lModNr == mizBuiltIn(env.builtIn, rqSetMode)
				|| lModNr == mizBuiltIn(env.builtIn, rqAny)) {
				res := true;
			}
		}
		^res;
	} else if (wider.sort == ikTypStruct) {
		switch (mizWideningOf(env, wider, narrower0)) {
			None(): false;
			Some(w): mizEqRadices(env, wider, w);
		}
	} else {
		false;
	}
}


// ---------------- CopyExp family ----------------

mizCopyExpTrm(t : MizTrm) -> MizTrm {
	if (mizTrmSort(t) == ikTrmEqConst) {
		t; // shared
	} else {
		switch (t) {
			MizVarTrm(srt, varNr, __, __): mizNewVarTrm(srt, varNr);
			MizFuncTrm(srt, funcNr, args, __, __):
				mizNewLocFuncTrm(srt, funcNr, mizCopyExpTrmList(args));
			MizPrivFuncTrm(funcNr, args, funcExp, __, __): {
				if (mizTrmSort(funcExp) != ikError) {
					mizCopyExpTrm(funcExp);
				} else {
					mizNewPrivFuncTrm(funcNr, mizCopyExpTrmList(args), mizCopyExpTrm(funcExp));
				}
			}
			MizFraenkelTrm(lambdaArgs, scope, compr, idents, __, __):
				MizFraenkelTrm(mapVector(lambdaArgs, mizCopyExpTyp), mizCopyExpTrm(scope),
					mizCopyExpFrm(compr), mizCopyIntSeq(idents), 0, 0);
			MizChoiceTrm(typ, __, __): mizNewChoiceTrm(mizCopyExpTyp(typ));
			MizQuaTrm(trmProper, qua, __, __):
				mizNewQuaTrm(mizCopyExpTrm(trmProper), mizCopyExpTyp(qua));
			MizBaseTrm(srt, __): MizBaseTrm(srt, 0);
		}
	}
}

mizCopyExpTrmList(l : MizTrmList) -> MizTrmList {
	switch (l) {
		MizTrmNil(): l;
		MizTrmElem(trm, next): MizTrmElem(mizCopyExpTrm(trm), mizCopyExpTrmList(next));
	}
}

mizCopyExpCluster(c : MizAttrColl) -> MizAttrColl {
	MizAttrColl(mapVector(c.items, \a ->
		MizAttr(a.neg, a.attrNr, mizCopyExpTrmList(a.args), false, 0)), c.consistent);
}

mizCopyExpTyp(t : MizTyp) -> MizTyp {
	MizTyp(t.sort, mizCopyExpCluster(t.lower), mizCopyExpCluster(t.upper),
		t.modNr, mizCopyExpTrmList(t.modArgs), 0);
}

// ExpPrivFuncInTrm (correl.pas 5031): replace every PRIVATE FUNCTOR
// occurrence by its stored expansion, in place. CollectEqualsComst calls it on
// the instantiated right-hand side before collecting it (identify.pas
// 749/802), and the original then ASSERTS the collection returned an
// InfConst — a private functor term never collects to one, so without this the
// equal-constant link is silently lost.
mizExpPrivFuncInTrm(t : MizTrm) -> MizTrm {
	switch (t) {
		MizFuncTrm(__, __, args, __, __): {
			mizExpPrivFuncInTrmList(args);
			t;
		}
		MizPrivFuncTrm(__, __, funcExp, __, __): mizExpPrivFuncInTrm(funcExp);
		MizFraenkelTrm(lambdaArgs, scope, compr, __, __, __): {
			iterVector(lambdaArgs, \ty -> mizExpPrivFuncInTyp(ty));
			fr : MizFraenkelTrm = t;
			fr.scope ::= mizExpPrivFuncInTrm(scope);
			fr.compr ::= mizCopyExpFrm(compr);
			t;
		}
		MizChoiceTrm(typ, __, __): {
			mizExpPrivFuncInTyp(typ);
			t;
		}
		default: t;   // loci, bound/fixed/inference/eq constants, numerals, it
	}
}

mizExpPrivFuncInTrmList(l : MizTrmList) -> void {
	switch (l) {
		MizTrmNil(): {}
		MizTrmElem(trm, next): {
			e : MizTrmElem = l;
			e.trm ::= mizExpPrivFuncInTrm(trm);
			mizExpPrivFuncInTrmList(next);
		}
	}
}

mizExpPrivFuncInTyp(ty : MizTyp) -> void {
	iterVector(ty.lower.items, \a -> mizExpPrivFuncInTrmList(a.args));
	iterVector(ty.upper.items, \a -> mizExpPrivFuncInTrmList(a.args));
	mizExpPrivFuncInTrmList(ty.modArgs);
}

mizCopyExpFrm(f : MizFrm) -> MizFrm {
	switch (f) {
		MizConjFrm(conjuncts, __): {
			out : Vector<MizFrm> = makeVector(sizeVector(conjuncts));
			iterVector(conjuncts, \g -> {
				cg = mizCopyExpFrm(g);
				switch (cg) {
					MizConjFrm(inner, __): iterVector(inner, \h -> pushVector(out, h));
					default: pushVector(out, cg);
				}
			});
			MizConjFrm(out, 0);
		}
		MizUnivFrm(srt, varId, quantified, scope, __):
			MizUnivFrm(srt, varId, mizCopyExpTyp(quantified), mizCopyExpFrm(scope), 0);
		MizQualFrm(trm, typ, __):
			mizNewQualFrm(mizCopyExpTrm(trm), mizCopyExpTyp(typ));
		MizPredFrm(srt, predNr, args, __):
			MizPredFrm(srt, predNr, mizCopyExpTrmList(args), 0);
		MizLocPredFrm(predNr, args, expn, __): {
			if (mizFrmSort(expn) != ikError) {
				mizCopyExpFrm(expn);
			} else {
				MizLocPredFrm(predNr, mizCopyExpTrmList(args), mizCopyExpFrm(expn), 0);
			}
		}
		MizNegFrm(arg, __): mizNewNeg(mizCopyExpFrm(arg));
		MizFlexFrm(__, lo, ro, lt, rt, expn, __):
			MizFlexFrm(ikFrmFlexConj, mizCopyExpFrm(lo), mizCopyExpFrm(ro),
				mizCopyExpTrm(lt), mizCopyExpTrm(rt), mizCopyExpFrm(expn), 0);
		MizUniqFrm(srt): MizUniqFrm(srt);
		MizBinFrm(__, __, __, __): {
			mizRunTimeError(2643);
			f;
		}
	}
}

mizNewDisj(a : MizFrm, b : MizFrm) -> MizFrm {
	lNeg0 = mizNewNeg(a);                mizSetPidIfKind(lNeg0, ikFrmNeg, pid_Or_LeftNot);
	lNeg1 = mizNewNeg(b);                mizSetPidIfKind(lNeg1, ikFrmNeg, pid_Or_RightNot);
	lConj = mizNewConj(lNeg0, lNeg1);    mizSetPidIfKind(lConj, ikFrmConj, pid_Or_And);
	lNeg2 = mizNewNeg(lConj);            mizSetPidIfKind(lNeg2, ikFrmNeg, pid_Or);
	lNeg2;
}

// InsertTermInTTColl (correl.pas 1151) — the same body GetTrmType runs, with
// the type thrown away.
mizInsertTermInTTColl(env : MizCorrelEnv, t : MizTrm) -> void {
	p = mizTTCollSearch(env, t);
	if (!p.first) {
		entry = MizTTPair(mizCopyTrm(t), mizCopyTrmType(env, t), env.termScope);
		mizVectorAtInsert(env.ttColl, p.second, entry);
		if (env.termScope > env.ttMaxScope) env.ttMaxScope ::= env.termScope;
		rounded = env.roundUpTrmType(env, t);
		cl = mizCopyCluster(rounded.upper);
		env.roundUpCluster(env, cl, rounded);
		rounded.upper ::= cl;
		entry.typ ::= rounded;
	}
}

// ---------------- struct reconstruction (correl.pas ReconSelectTrm/ReconAggregTrm) ----------------

// the selector's own struct (MotherStructNr): the struct whose fields contain it
mizMotherStructNr(env : MizCorrelEnv, selNr : int) -> int {
	res = ref 0;
	n = mizConstrCount(env, coStructMode);
	i = ref 1;
	while(\ -> ^res == 0 && ^i <= n, \ -> {
		c = mizConstr(env, coStructMode, ^i);
		if (mizNatHasInDom(c.fields, selNr)) res := ^i;
		i := ^i + 1;
	});
	^res;
}

// ReconSelectTrm: the selector term S(structArgs..., lastArg) for fTyp
mizReconSelectTrm(env : MizCorrelEnv, selNr : int, lastArg : MizTrm,
		typ : MizTyp) -> Maybe<MizTrm> {
	motherNr = mizMotherStructNr(env, selNr);
	if (motherNr == 0) {
		None();
	} else {
		mother = mizNewStandardTyp(ikTypStruct, mizNewEmptyCluster(),
			mizNewEmptyCluster(), motherNr, MizTrmNil());
		switch (mizWideningOf(env, mother, mizCopyTyp(typ))) {
			None(): None();
			Some(wt): {
				args = switch (wt.modArgs) {
					MizTrmNil(): mizNewTrmList(lastArg, MizTrmNil());
					default: mizAppendTrmL(mizCopyTrmList(wt.modArgs), lastArg);
				};
				Some(mizNewLocFuncTrm(ikTrmSelector, selNr, args));
			}
		}
	}
}

mizAppendTrmL(l : MizTrmList, t : MizTrm) -> MizTrmList {
	switch (l) {
		MizTrmNil(): mizNewTrmList(t, MizTrmNil());
		MizTrmElem(__, __): {
			last = mizLastElemL(l);
			last.next ::= mizNewTrmList(t, MizTrmNil());
			l;
		}
	}
}

mizLastElemL(l : MizTrmList) -> MizTrmElem {
	mizLastElem(l);
}

// ReconAggregTrm: the strict struct's aggregate term over its selectors
mizReconAggregTrm(env : MizCorrelEnv, structNr : int, lastArg : MizTrm,
		typ : MizTyp) -> MizTrm {
	sc = mizConstr(env, coStructMode, structNr);
	if (mizNatCount(sc.fields) == 0 || sc.structModeAggrNr == 0) {
		mizNewIncorTrm();
	} else {
		aggrNr = sc.structModeAggrNr;
		base = mizNewStandardTyp(ikTypStruct, mizNewEmptyCluster(),
			mizNewEmptyCluster(), structNr, MizTrmNil());
		switch (mizWideningOf(env, base, typ)) {
			None(): mizNewIncorTrm();
			Some(wt): {
				args = ref mizCopyTrmList(wt.modArgs);
				err = ref false;
				ac = mizConstr(env, coAggregate, aggrNr);
				fori(0, mizSeqCount(ac.aggrFields) - 1, \z -> {
					selNr = mizSeqValue(ac.aggrFields, z);
					switch (mizReconSelectTrm(env, selNr, mizCopyTrm(lastArg), wt)) {
						Some(st): args := mizAppendTrmL(^args, st);
						None(): {
							err := true;
							args := mizAppendTrmL(^args, mizNewIncorTrm());
						}
					}
					selC = mizConstr(env, coSelector, selNr);
					switch (selC.typ) {
						Some(stp): if (stp.sort == ikError) err := true;
						None(): err := true;
					}
				});
				if (^err) mizNewIncorTrm()
				else mizNewLocFuncTrm(ikTrmAggreg, aggrNr, ^args);
			}
		}
	}
}
