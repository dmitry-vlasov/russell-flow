// Transcription of ~/dev/system/kernel/identify.pas (the constant-collection
// part): CollectConstInTrm/Frm/Typ/Cluster and CollectInferConst — the
// hash-consing of closed terms into InfConst numbers with rounded-up types,
// equality-class seeds (fEqConst) and numeric values.
//
// InferConstDef is env.inferConstDef (insertion order — InfConst numbers) plus
// a sorted view here (sortedIdx, ordered by CompRdTrms over the definitions,
// i.e. CompTrms with strictCompare=false).
//
// Numeric values use double-precision complex arithmetic. // DEVIATION:
// the original uses extended precision; exact rational arithmetic arrives
// with polynom.pas. Recorded, revisit with the arithmetic requirements.
//
// Equals-expansion (CollectEqualsComst via gEquals/EqDefinientia) is behind
// the equalsExpand hook until the definientia loading lands. // TODO(M1)

import ds/vector;
import loop;
import math/math;
import mizar/original/errhan;
import mizar/original/mobjects;
import mizar/original/limits;
import mizar/original/lexicon;
import mizar/original/builtin;
import mizar/original/correl;
import mizar/original/correl_inst;
import mizar/original/correl_match;
import mizar/original/numbers;
import mizar/original/print;
import net/url_parameter;

export {

	// the identify unit state, per article
	MizIdentify(
		env : MizCorrelEnv,
		sortedIdx : Vector<int>,             // InfConst nrs sorted by CompRdTrms(def)
		numeric : Vector<Maybe<MizCplx>>, // fNumericValue by InfConst nr
		mutable onlyConstants : bool,        // gOnlyConstants
		mutable equalsExpansionLevel : int,  // gEqualsExpansionLevel
		revReq : Vector<int>,                // gRevReq: functor nr -> rq*
		// equals-expansion hook: eq-const numbers for a functor definition
		mutable equalsExpand : (MizIdentify, int, MizTrmList) -> [int],
		// gReductions (ReductionObj lives in identify.pas)
		reductions : Vector<MizReduction>,
		// gIdentifications, functor kind only (nConstrKind = 'K')
		identifications : Vector<MizFuncIdent>,
	);

	// ReductionObj: nTerms[0] reduces to nTerms[1] under the primary types
	MizReduction(article : string, absNr : int, primaries : Vector<MizTyp>,
		t0 : MizTrm, t1 : MizTrm);

	// IdentifyObj: pattern0 identified with pattern1 under the primary types;
	// eqArgs (x,y) demand locus y := locus x (with a widening check)
	MizFuncIdent(article : string, absNr : int, primaries : Vector<MizTyp>,
		pattern0 : MizTrm, pattern1 : MizTrm, eqArgs : [MizIntPair]);

	mizMakeIdentify(env : MizCorrelEnv) -> MizIdentify;
	// gRevReq wiring: call after the requirements are loaded
	mizInitRevReq(idn : MizIdentify) -> void;

	// find a collected constant whose definition equals the term (CompRdTrms)
	mizInferConstFind(idn : MizIdentify, t : MizTrm) -> Maybe<int>;

	// StdItemObj.FinishIdentify (stdprep.pas 912): when the article declares an
	// `identify`, every constant ALREADY collected is matched against the new
	// pattern and, on success, the instantiated right-hand side is collected
	// and joins that constant's fEqConst. Without it a term interned before
	// the identify is read never learns the equality (fomodel0 3218:42).
	mizIdentifyRetrofit(idn : MizIdentify, idf : MizFuncIdent) -> void;

	// CollectConstInTrm: returns the (possibly replaced) term
	mizCollectConstInTrm(idn : MizIdentify, t : MizTrm) -> MizTrm;
	mizCollectConstInTrmList(idn : MizIdentify, l : MizTrmList) -> void;
	mizCollectConstInFrm(idn : MizIdentify, f : MizFrm) -> void;
	mizCollectConstInTyp(idn : MizIdentify, typ : MizTyp) -> void;
	mizCollectConstInCluster(idn : MizIdentify, c : MizAttrColl) -> MizAttrColl;

	mizNumericValue(idn : MizIdentify, nr : int) -> Maybe<MizCplx>;
	mizSetNumeric(idn : MizIdentify, nr : int, v : Maybe<MizCplx>) -> void;
	mizInferSearch(idn : MizIdentify, t : MizTrm) -> Pair<int, int>;

	// InferConstDef.Mark/FreeItemsFrom: drop constants collected past `mark`
	// (per-inference cleanup in InferenceChecker)
	mizInferRelease(idn : MizIdentify, mark : int) -> void;
}

mizMakeIdentify(env : MizCorrelEnv) -> MizIdentify {
	rv : Vector<int> = makeVector(64);
	MizIdentify(env, makeVector(64), makeVector(64), true, 0, rv,
		\__, __, __ -> [], makeVector(4), makeVector(4));
}

mizInitRevReq(idn : MizIdentify) -> void {
	clearVector(idn.revReq);
	// FunctorRequirement members mapped back: gRevReq[gBuiltIn[r]] := r
	n = mizConstrCount(idn.env, coFunctor);
	fori(0, n, \__ -> pushVector(idn.revReq, rqNone));
	frqs = [rqEmptySet, rqRealAdd, rqRealMult, rqSucc, rqUnion, rqIntersection,
		rqSubtraction, rqSymmetricDifference, rqRealNeg, rqRealInv, rqRealDiff,
		rqRealDiv, rqImaginaryUnit, rqOmega, rqZeroNumber, rqPowerSet,
		rqDiv, rqMod, rqLCM, rqGCD];
	iter(frqs, \r -> {
		nr = mizBuiltIn(idn.env.builtIn, r);
		if (nr > 0 && nr < sizeVector(idn.revReq)) {
			setVectorUnsafe(idn.revReq, nr, r);
		}
	});
}

mizRevReq(idn : MizIdentify, funcNr : int) -> int {
	getVectorDef(idn.revReq, funcNr, rqNone);
}

mizNumericValue(idn : MizIdentify, nr : int) -> Maybe<MizCplx> {
	getVectorDef(idn.numeric, nr, None());
}

mizSetNumeric(idn : MizIdentify, nr : int, v : Maybe<MizCplx>) -> void {
	while(\ -> sizeVector(idn.numeric) <= nr, \ -> pushVector(idn.numeric, None()));
	setVectorUnsafe(idn.numeric, nr, v);
}

// CompRdTrms
mizCompRdTrms(env : MizCorrelEnv, a : MizTrm, b : MizTrm) -> int {
	saved = env.strictCompare;
	env.strictCompare ::= false;
	c = mizCompTrms(env, a, b);
	env.strictCompare ::= saved;
	c;
}

// binary search in the sorted view; Pair(found insertion-nr or -1, position)
// The order is CompConstDef (identify.pas 474) = plain CompTrms, i.e. the
// STRICT comparison: a redefined functor and its origin are DIFFERENT
// constants, each with its own (redefined, hence narrower) type. Comparing
// them redefinition-adjusted merges the two and the narrower type is lost.
mizInferSearch(idn : MizIdentify, t : MizTrm) -> Pair<int, int> {
	env = idn.env;
	l = ref 0;
	h = ref sizeVector(idn.sortedIdx) - 1;
	found = ref -1;
	while(\ -> ^l <= ^h && ^found < 0, \ -> {
		m = (^l + ^h) / 2;
		nr = getVectorUnsafe(idn.sortedIdx, m);
		cd : MizConstDef = getVectorUnsafe(env.inferConstDef, nr);
		c = mizCompTrms(env, cd.def, t);
		if (c < 0) l := m + 1
		else if (c > 0) h := m - 1
		else found := nr;
	});
	Pair(^found, ^l);
}

mizInferConstFind(idn : MizIdentify, t : MizTrm) -> Maybe<int> {
	p = mizInferSearch(idn, t);
	if (p.first >= 0) Some(p.first) else None();
}

// CollectInferConst: intern a closed term; returns its InfConst term.
mizCollectInferConst(idn : MizIdentify, t : MizTrm) -> MizTrm {
	env = idn.env;
	if (!idn.onlyConstants) {
		t;
	} else {
		p = mizInferSearch(idn, t);
		if (p.first >= 0) {
			mizNewVarTrm(ikTrmInfConst, p.first);
		} else {
			lTyp = env.roundUpTrmType(env, t);
			nr = sizeVector(env.inferConstDef);
			// round the type's cluster once more against itself
			lClusterPtr = mizCopyCluster(lTyp.upper);
			env.roundUpCluster(env, lClusterPtr, lTyp);
			lTyp.upper ::= lClusterPtr;
			if (getUrlParameterDef("dbg-icreate", "") != "") {
				fnD = switch (t) {
					MizFuncTrm(__, fnx, __, __, __): fnx;
					default: -1;
				};
				isC = mizTrmSort(t) == ikTrmConstant && getUrlParameterDef("dbg-icreate", "") == "c";
				if (isC || i2s(fnD) == getUrlParameterDef("dbg-icreate", "")) {
					println("ICREATE D" + i2s(nr) + " = " + mizTrm2s(t)
						+ " typ=" + mizFullTyp2s(lTyp)
						+ (switch (t) {
							MizFuncTrm(__, __, aaI, __, __): " args=" + strGlue(map(
								enumFromTo(0, mizTrmListLength(aaI) - 1),
								\zI -> { aI = mizTrmListNth(aaI, zI);
									mizTrm2s(aI) + ":" + mizFullTyp2s(mizCopyTrmType(env, aI)); }), " | ");
							default: "";
						}));
				}
			}
			cd = MizConstDef(t, mizInitNatSet(4), -1, lTyp, false);
			pushVector(env.inferConstDef, cd);
			mizVectorAtInsert(idn.sortedIdx, p.second, nr);
			// numeric value
			numeric : Maybe<MizCplx> = switch (t) {
				MizVarTrm(srt, varNr, __, __): {
					if (srt == ikTrmNumeral) Some(mizCplxFromInt(varNr))
					else None();
				}
				MizFuncTrm(srt, funcNr0, args0, __, __): {
					if (srt == ikTrmFunctor) {
						ft : MizFuncTrm = mizIdAsFunc(t);
						pa = mizAdjustTrm(env, ft);
						rq = mizRevReq(idn, pa.first);
						if (mizDbgIds() && mizTrmListLength(pa.second) > 0) {
							println("   NUM K" + i2s(ft.funcNr) + " adj=K" + i2s(pa.first)
								+ " rq=" + i2s(rq) + " args=(" + mizTrmList2s(pa.second) + ")"
								+ " a1=" + (switch (mizInfNumArg(idn, mizTrmListNth(pa.second, 0))) {
									Some(vv): mizCplx2s(vv); None(): "-";
								}));
						}
						if (rq == rqImaginaryUnit) {
							Some(mizCplxImUnit);
						} else if (rq == rqRealAdd || rq == rqRealMult
							|| rq == rqRealDiff || rq == rqRealDiv) {
							a1 = mizInfNumArg(idn, mizTrmListNth(pa.second, 0));
							a2 = mizInfNumArg(idn, mizTrmListNth(pa.second, 1));
							switch (a1) {
								Some(v1): switch (a2) {
									Some(v2): mizComplexOp(rq, v1, v2);
									None(): None();
								}
								None(): None();
							}
						} else if (rq == rqRealNeg || rq == rqRealInv) {
							switch (mizInfNumArg(idn, mizTrmListNth(pa.second, 0))) {
								Some(v1): {
									if (rq == rqRealNeg) Some(mizCplxNeg(v1))
									else mizCInvM(v1);
								}
								None(): None();
							}
						} else {
							None();
						}
					} else {
						None();
					}
				}
				default: None();
			}
			cd.determined ::= isSome(numeric);
			mizSetNumeric(idn, nr, numeric);
			mizCollectConstInTyp(idn, cd.typ);
			mizNewVarTrm(ikTrmInfConst, nr);
		}
	}
}

mizInfNumArg(idn : MizIdentify, t0 : MizTrm) -> Maybe<MizCplx> {
	t = mizSkipPrivFunc(t0);
	switch (t) {
		MizVarTrm(srt, varNr, __, __): {
			if (srt == ikTrmInfConst) mizNumericValue(idn, varNr) else None();
		}
		default: None();
	}
}

// ComplexAdd / ComplexMult / ComplexSub / ComplexDiv on EXACT rationals.
// Division by zero stays UNDETERMINED, as in the original (RatInv(0) has no
// value there either), which is why the result is a Maybe.
mizComplexOp(rq : int, a : MizCplx, b : MizCplx) -> Maybe<MizCplx> {
	if (rq == rqRealAdd) {
		Some(mizCplxAdd(a, b));
	} else if (rq == rqRealMult) {
		Some(mizCplxMul(a, b));
	} else if (rq == rqRealDiff) {
		Some(mizCplxSub(a, b));
	} else if (rq == rqRealDiv) {
		mizCplxDiv(a, b);
	} else {
		None();
	}
}

// ComplexInv; None for zero — the callers must check
mizCInvM(v : MizCplx) -> Maybe<MizCplx> {
	mizCplxInv(v);
}

// ---------------- the walkers ----------------

mizCollectConstInTrmList(idn : MizIdentify, l : MizTrmList) -> void {
	switch (l) {
		MizTrmNil(): {}
		MizTrmElem(trm, next): {
			e : MizTrmElem = l;
			e.trm ::= mizCollectConstInTrm(idn, trm);
			mizCollectConstInTrmList(idn, next);
		}
	}
}

mizCollectConstInCluster(idn : MizIdentify, c : MizAttrColl) -> MizAttrColl {
	// rebuilt with sorted insertion (the arg terms change, so may the order)
	res = mizNewEmptyCluster();
	iterVector(c.items, \a -> {
		na = MizAttr(a.neg, a.attrNr, mizCopyTrmList(a.args), false, a.pattNr);
		mizCollectConstInTrmList(idn, na.args);
		mizAttrCollInsert(idn.env, res, na);
	});
	res.consistent ::= res.consistent && c.consistent;
	res;
}

mizCollectConstInTyp(idn : MizIdentify, typ : MizTyp) -> void {
	if (typ.sort != ikError) {
		typ.lower ::= mizCollectConstInCluster(idn, typ.lower);
		typ.upper ::= mizCollectConstInCluster(idn, typ.upper);
		mizCollectConstInTrmList(idn, typ.modArgs);
	}
}

mizCollectConstInFrm(idn : MizIdentify, f : MizFrm) -> void {
	env = idn.env;
	switch (f) {
		MizPredFrm(__, __, args, __): mizCollectConstInTrmList(idn, args);
		MizLocPredFrm(__, args, expn, __): {
			mizCollectConstInTrmList(idn, args);
			mizCollectConstInFrm(idn, expn);
		}
		MizQualFrm(trm, typ, __): {
			qf : MizQualFrm = f;
			qf.trm ::= mizCollectConstInTrm(idn, trm);
			mizCollectConstInTyp(idn, typ);
		}
		MizNegFrm(arg, __): mizCollectConstInFrm(idn, arg);
		MizBinFrm(__, l, r, __): {
			mizCollectConstInFrm(idn, l);
			mizCollectConstInFrm(idn, r);
		}
		MizConjFrm(conjuncts, __): iterVector(conjuncts, \g -> mizCollectConstInFrm(idn, g));
		MizUnivFrm(__, __, quantified, scope, __): {
			env.boundVarNbr ::= env.boundVarNbr + 1;
			mizCollectConstInTyp(idn, quantified);
			mizCollectConstInFrm(idn, scope);
			env.boundVarNbr ::= env.boundVarNbr - 1;
		}
		MizUniqFrm(__): {}
		MizFlexFrm(__, lo, ro, __, __, expn, __): {
			mizCollectConstInFrm(idn, lo);
			mizCollectConstInFrm(idn, ro);
			mizCollectConstInFrm(idn, expn);
		}
	}
}

gMizDbgFvDef : ref int = ref -1;
mizDbgFvDef() -> bool {
	if (^gMizDbgFvDef < 0) {
		gMizDbgFvDef := if (getUrlParameterDef("dbg-fvdef", "") == "1") 1 else 0;
	}
	^gMizDbgFvDef == 1;
}

mizCollectConstInTrm(idn : MizIdentify, t : MizTrm) -> MizTrm {
	env = idn.env;
	lOnly = idn.onlyConstants;
	idn.onlyConstants ::= true;
	lLevel = idn.equalsExpansionLevel;
	idn.equalsExpansionLevel ::= 0;
	res = switch (t) {
		MizFuncTrm(srt, funcNr, args, __, __): {
			mizCollectConstInTrmList(idn, args);
			if (srt == ikTrmFunctor) {
				if (idn.onlyConstants) {
					p = mizInferSearch(idn, t);
					if (p.first >= 0) {
						mizNewVarTrm(ikTrmInfConst, p.first);
					} else {
						it = mizCollectInferConst(idn, t);
						// equals-expansion seeds the eq-const set
						idn.equalsExpansionLevel ::= lLevel;
						switch (it) {
							MizVarTrm(__, varNr, __, __): {
								cd : MizConstDef = getVectorUnsafe(env.inferConstDef, varNr);
								eqs = idn.equalsExpand(idn, funcNr, args);
								iter(eqs, \e -> mizNatInsertElem(cd.eqConst, e));
								ids = mizIdentifyEqConsts(idn, t);
								iter(ids, \e -> mizNatInsertElem(cd.eqConst, e));
							}
							default: {}
						}
						it;
					}
				} else {
					t;
				}
			} else {
				// Selector/Aggreg/SchFunc
				mizCollectInferConst(idn, t);
			}
		}
		MizPrivFuncTrm(__, args, funcExp, __, __): {
			mizCollectConstInTrmList(idn, args);
			pt : MizPrivFuncTrm = t;
			pt.funcExp ::= mizCollectConstInTrm(idn, funcExp);
			t;
		}
		MizFraenkelTrm(lambdaArgs, scope, compr, __, __, __): {
			iterVector(lambdaArgs, \typ -> {
				env.boundVarNbr ::= env.boundVarNbr + 1;
				mizCollectConstInTyp(idn, typ);
			});
			ft : MizFraenkelTrm = t;
			ft.scope ::= mizCollectConstInTrm(idn, scope);
			mizCollectConstInFrm(idn, compr);
			env.boundVarNbr ::= env.boundVarNbr - sizeVector(lambdaArgs);
			// closed Fraenkel terms get collected too
			thereAreBound = ref false;
			w = mizMakeWithin(\__, trm -> {
				switch (trm) {
					MizVarTrm(s2, v2, __, __): {
						if (s2 == ikTrmBound && v2 <= env.boundVarNbr) {
							thereAreBound := true;
						}
						trm;
					}
					default: trm;
				}
			});
			__t2 = mizWithinTrm(w, t);
			idn.onlyConstants ::= !^thereAreBound;
			if (idn.onlyConstants) {
				// ChChangeBound: RE-BASE the bound vars of the closed Fraenkel
				// down by the current binder depth, so every occurrence
				// canonicalizes to the same numbering (correl.pas 3070:
				// `if VarNr > BoundVarNbr then dec(VarNr, BoundVarNbr)`)
				w2 = mizMakeWithin(\__, trm -> {
					switch (trm) {
						MizVarTrm(s2, v2, __, __): {
							if (s2 == ikTrmBound && v2 > env.boundVarNbr) {
								vt : MizVarTrm = mizIdAsVar(trm);
								vt.varNr ::= v2 - env.boundVarNbr;
							}
							trm;
						}
						default: trm;
					}
				});
				__t3 = mizWithinTrm(w2, t);
				mizCollectInferConst(idn, t);
			} else {
				t;
			}
		}
		MizChoiceTrm(typ, __, __): {
			mizCollectConstInTyp(idn, typ);
			mizCollectInferConst(idn, t);
		}
		MizVarTrm(srt, varNr, __, __): {
			if (srt == ikTrmNumeral) {
				mizCollectInferConst(idn, t);
			} else if (srt == ikTrmConstant) {
				// a constant with an expandable definition seeds eq-consts
				eqSeeds = mizInitNatSet(4);
				fv : MizFixedVar = getVectorUnsafe(env.fixedVar, varNr);
				switch (fv.def) {
					Some(d): {
						if (mizTrmSort(d) != ikError) {
							lTrm0 = mizCopyExpTrm(d);
							lTrm = mizCollectConstInTrm(idn, lTrm0);
							if (idn.onlyConstants) {
								mizAssert(4382, mizTrmSort(lTrm) == ikTrmInfConst);
								switch (lTrm) {
									MizVarTrm(__, dn, __, __): mizNatInsertElem(eqSeeds, dn);
									default: {}
								}
							}
							idn.onlyConstants ::= true;
						}
					}
					None(): {}
				}
				it = mizCollectInferConst(idn, t);
				if (mizDbgFvDef()) {
					println("FVDEF c" + i2s(varNr) + " hasDef="
						+ b2s(isSome(fv.def)) + " seeds=" + i2s(mizNatCount(eqSeeds))
						+ " bvn=" + i2s(env.boundVarNbr)
						+ " bvars=" + (switch (fv.def) {
							Some(d): {
								seen = ref [];
								ww = mizMakeWithin(\__, trm -> {
									switch (trm) {
										MizVarTrm(s9, v9, __, __): {
											if (s9 == ikTrmBound) seen := arrayPush(^seen, v9);
											trm;
										}
										default: trm;
									}
								});
								__d9 = mizWithinTrm(ww, d);
								strGlue(map(^seen, i2s), ",");
							}
							None(): "-";
						})
						+ " -> " + mizTrm2s(it));
				}
				switch (it) {
					MizVarTrm(s3, nr3, __, __): {
						if (s3 == ikTrmInfConst) {
							cd : MizConstDef = getVectorUnsafe(env.inferConstDef, nr3);
							mizNatEnlargeBy(cd.eqConst, eqSeeds);
							if (mizNatCount(eqSeeds) > 0) {
								cd.setting ::= mizNatItem(eqSeeds, 0).x;
							}
						}
					}
					default: {}
				}
				it;
			} else if (srt == ikTrmLocus || srt == ikTrmFreeVar
				|| srt == ikTrmLambdaVar || srt == ikTrmBound) {
				idn.onlyConstants ::= false;
				t;
			} else {
				// InfConst: already collected
				t;
			}
		}
		MizQuaTrm(__, __, __, __): {
			mizRunTimeError(2845);
			t;
		}
		MizBaseTrm(srt, __): {
			if (srt == ikError) {
				idn.onlyConstants ::= false;
				t;
			} else {
				mizRunTimeError(2845);
				t;
			}
		}
	}
	idn.onlyConstants ::= lOnly && idn.onlyConstants;
	idn.equalsExpansionLevel ::= lLevel;
	res;
}

mizIdAsFunc(t : MizTrm) -> MizFuncTrm {
	switch (t) { MizFuncTrm(__, __, __, __, __): t; default: { mizRunTimeError(2902); MizFuncTrm(ikError, 0, MizTrmNil(), 0, 0); } }
}
mizIdAsVar(t : MizTrm) -> MizVarTrm {
	switch (t) { MizVarTrm(__, __, __, __): t; default: { mizRunTimeError(2901); MizVarTrm(ikError, 0, 0, 0); } }
}


mizInferRelease(idn : MizIdentify, mark : int) -> void {
	env = idn.env;
	if (getUrlParameterDef("dbg-free", "") == "1" && sizeVector(env.inferConstDef) > mark) {
		println("RELEASE mark=" + i2s(mark) + " n=" + i2s(sizeVector(env.inferConstDef)));
	}
	while(\ -> sizeVector(env.inferConstDef) > mark,
		\ -> removeVector(env.inferConstDef, sizeVector(env.inferConstDef) - 1));
	i = ref 0;
	while(\ -> ^i < sizeVector(idn.sortedIdx), \ -> {
		if (getVectorUnsafe(idn.sortedIdx, ^i) >= mark) {
			removeVector(idn.sortedIdx, ^i);
		} else {
			i := ^i + 1;
		}
	});
	while(\ -> sizeVector(idn.numeric) > mark,
		\ -> removeVector(idn.numeric, sizeVector(idn.numeric) - 1));
}

// Identify with equals expansion (identify.pas 758-797): a functor
// identification whose left pattern Es-matches the term makes the
// instantiated right pattern an equal constant
// debug tooling: trace the functor-identification expansion (`dbg-ids=1`)
gMizDbgIds : ref int = ref -1;

mizDbgIds() -> bool {
	if (^gMizDbgIds < 0) {
		gMizDbgIds := if (getUrlParameterDef("dbg-ids", "") == "1") 1 else 0;
	}
	^gMizDbgIds == 1;
}

mizIdentifyRetrofit(idn : MizIdentify, idf : MizFuncIdent) -> void {
	env = idn.env;
	// the Pascal `for i:=0 to InferConstDef.Count-1` fixes the bound once
	n = sizeVector(env.inferConstDef);
	i = ref 0;
	while(\ -> ^i < n, \ -> {
		cd : MizConstDef = getVectorUnsafe(env.inferConstDef, ^i);
		if (mizTrmSort(cd.def) == ikTrmFunctor) {
			mizDisposeSubstTrm(env);
			if (mizEsTrm(env, idf.pattern0, cd.def)
				&& mizCheckLociTypes(env, idf.primaries)) {
				ok = ref true;
				iter(idf.eqArgs, \pxy -> {
					if (^ok) {
						if (!mizIsWiderThan(env,
								getVectorUnsafe(idf.primaries, pxy.y - 1),
								mizCopyTyp(getVectorUnsafe(idf.primaries, pxy.x - 1)))) {
							ok := false;
						} else {
							mizSubstTrmSet(env, pxy.y,
								switch (getVectorDef(env.substTrm, pxy.x, None())) {
									Some(st): Some(mizCopyTrm(st));
									None(): None();
								});
						}
					}
				});
				if (^ok) {
					lTrm = mizInstSubstTrm(env, idf.pattern1);
					lB = env.boundVarNbr;
					env.boundVarNbr ::= 0;
					ct = mizCollectConstInTrm(idn, lTrm);
					env.boundVarNbr ::= lB;
					switch (ct) {
						MizVarTrm(s4, nr4, __, __): {
							if (s4 == ikTrmInfConst) mizNatInsertElem(cd.eqConst, nr4);
						}
						default: {}
					}
				}
			}
			mizDisposeSubstTrm(env);
		}
		i := ^i + 1;
	});
}

mizIdentifyEqConsts(idn : MizIdentify, t : MizTrm) -> [int] {
	env = idn.env;
	if (mizDbgIds()) {
		println("  IDS n=" + i2s(sizeVector(idn.identifications))
			+ " lvl=" + i2s(idn.equalsExpansionLevel) + " for " + mizTrm2s(t));
	}
	ftG : MizFuncTrm = mizIdAsFunc(t);
	paG = mizAdjustTrm(env, ftG);
	// the same InferConsts guard as the equals half (identify.pas 722/804/810)
	if (idn.equalsExpansionLevel >= 3 || sizeVector(idn.identifications) == 0
		|| mizIntSetIsInSet(env.inferConsts, paG.first)) {
		[];
	} else {
		ft : MizFuncTrm = ftG;
		pa = paG;
		res = ref [];
		iterVector(idn.identifications, \idf -> {
			headOk = switch (idf.pattern0) {
				MizFuncTrm(s0, __, __, __, __): {
					if (s0 == ikTrmFunctor) {
						f0 : MizFuncTrm = mizIdAsFunc(idf.pattern0);
						p0 = mizAdjustTrm(env, f0);
						p0.first == pa.first;
					} else {
						false;
					}
				}
				default: false;
			};
			if (headOk) {
				mizDisposeSubstTrm(env);
				gEs = mizEsTrm(env, idf.pattern0, t);
				gLoci = gEs && mizCheckLociTypes(env, idf.primaries);
				if (mizDbgIds()) {
					println("    IDS try " + mizTrm2s(idf.pattern0) + " ~ " + mizTrm2s(t)
						+ " esTrm=" + b2s(gEs) + " checkLoci=" + b2s(gLoci));
				}
				if (gLoci) {
					ok = ref true;
					iter(idf.eqArgs, \pxy -> {
						if (^ok) {
							if (mizDbgIds()) {
								println("    IDS eqArg x=" + i2s(pxy.x) + " y=" + i2s(pxy.y)
									+ " wider=" + mizFullTyp2s(getVectorUnsafe(idf.primaries, pxy.y - 1))
									+ " narrower=" + mizFullTyp2s(getVectorUnsafe(idf.primaries, pxy.x - 1)));
							}
							if (!mizIsWiderThan(env,
									getVectorUnsafe(idf.primaries, pxy.y - 1),
									mizCopyTyp(getVectorUnsafe(idf.primaries, pxy.x - 1)))) {
								ok := false;
							} else {
								mizSubstTrmSet(env, pxy.y,
									switch (getVectorDef(env.substTrm, pxy.x, None())) {
										Some(st): Some(mizCopyTrm(st));
										None(): None();
									});
							}
						}
					});
					if (mizDbgIds()) {
						println("    IDS eqArgs ok=" + b2s(^ok)
							+ " pattern1=" + mizTrm2s(idf.pattern1));
					}
					if (^ok) {
						// ExpPrivFuncInTrm (identify.pas 802)
						lTrm = mizExpPrivFuncInTrm(mizInstSubstTrm(env, idf.pattern1));
						if (mizDbgIds()) {
							println("    IDS inst -> " + mizTrm2s(lTrm));
						}
						idn.equalsExpansionLevel ::= idn.equalsExpansionLevel + 1;
						__insI = mizIntSetInsert(env.inferConsts, pa.first);
						lB = env.boundVarNbr;
						env.boundVarNbr ::= 0;
						ct = mizCollectConstInTrm(idn, lTrm);
						env.boundVarNbr ::= lB;
						idn.equalsExpansionLevel ::= idn.equalsExpansionLevel - 1;
						__delI = mizIntSetDelete(env.inferConsts, pa.first);
						switch (ct) {
							MizVarTrm(s4, nr4, __, __): {
								if (s4 == ikTrmInfConst) res := arrayPush(^res, nr4);
							}
							default: {}
						}
					}
				}
			}
		});
		^res;
	}
}
