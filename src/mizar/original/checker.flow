// Transcription of ~/dev/system/kernel/checker.pas — the decision loop:
//
//   PreCheck -> per disjunct: Equate; PreUnification; Unification
//   success = every disjunct refuted; else ChError(4) "unsolved inference".
//   Resource codes: 1 trivial, 8/9 lattice, 11 constants, 14 terms.
//
// PreUnification derives the INEQUALITIES the Unifier needs: irreflexivity/
// reflexivity property pairs, contradictory attribute clusters between
// classes, and the one-difference rule.
//
// Unification arrives with unifier.flow — the `unification` hook below; until
// wired, an unrefuted disjunct simply yields error 4 (never a false success).

import ds/vector;
import loop;
import math/math;
import mizar/original/errhan;
import mizar/original/mobjects;
import mizar/original/limits;
import mizar/original/lexicon;
import mizar/original/builtin;
import mizar/original/correl;
import mizar/original/correl_inst;
import mizar/original/correl_match;
import mizar/original/roundcl;
import mizar/original/identify;
import mizar/original/numbers;
import mizar/original/prechecker;
import mizar/original/equalizer;
import mizar/original/iocorrel_write;

export {
	MizChecker(
		env : MizCorrelEnv,
		idn : MizIdentify,
		clusters : MizClusters,
		chErrNr : MizIntSeq,                 // ChErrNr (IntSet of error codes)
		// Unification hook (unifier.flow); returns the Contr code (0 = open)
		mutable unification : (MizChecker, MizEqualizer) -> int,
		// definitional expansion hook (definientia.flow), applied per inference
		mutable atomicExpansions : (MizFrm) -> [MizFrm],
		mutable debug : bool,
		census : MizCensus,
		derivation : Vector<string>,         // derivation=1 narration, per inference
		// dump-derivation=: the STRUCTURED derivation — the same records as
		// the narration, but as XML fragments in the analyzer-report dialect
		// (the language the translation front already parses). Per inference:
		// <Disjunct nr of> its <Literal> formulas, the closing evidence
		// (<Verify> premise + witness / <AttrClash>), and <Contr code>.
		derivXml : Vector<string>,
	);

	// The refutation census — the first, verdict-shaped slice of the checker's
	// derivation. Per inference it records the width of the case split (how
	// many disjuncts the negated thesis normalized to; 0 = settled by
	// normalization alone) and, per disjunct, WHICH rule closed it: the
	// SetContr code (1..44 congruence/type rounding in the equalizer, 45..49
	// unification, 50..51 the arithmetic prechecks; 0 = not refuted, i.e. the
	// inference was rejected). Purely observational: nothing reads it back.
	MizCensus(
		codes : Vector<int>,     // contr code -> closed-disjunct count
		dhisto : Vector<int>,    // disjunct count (capped) -> inference count
		mutable inferences : int,
		mutable disjuncts : int,
	);
	mizMakeCensus() -> MizCensus;
	mizCensusMergeInto(target : MizCensus, src : MizCensus) -> void;

	// derivation=1: the checker narrates its refutation as text — per disjunct
	// a header, per closing step the evidence (the unifier pushes the premise
	// it instantiated and the winning substitution). Purely observational;
	// prep.flow prints and clears it per inference. The renderer is gated on
	// the flag, so with it off the cost is one cached int test.
	mizDerivOn() -> bool;
	// dump-derivation=<path> switches the structured records on
	mizDerivXmlOn() -> bool;
	// in-process switch — the translation front enables the records without
	// a URL parameter (russellj task args are not url parameters)
	mizSetDerivXmlOn(on : bool) -> void;
	// one formula in the report dialect, serialized IMMEDIATELY (the checker
	// mutates and reuses its formulas)
	mizDerivFrmXml(env : MizCorrelEnv, f : MizFrm) -> string;

	mizMakeChecker(env : MizCorrelEnv, idn : MizIdentify, clusters : MizClusters) -> MizChecker;

	// InferenceChecker: premises (¬thesis + linked + cited) -> error codes in
	// chk.chErrNr. Empty = the inference is ACCEPTED.
	mizInferenceChecker(chk : MizChecker, inference : Vector<MizFrm>) -> void;

	// PreUnification over a refuted-in-progress disjunct
	mizPreUnification(chk : MizChecker, eq : MizEqualizer) -> void;
}

mizMakeChecker(env : MizCorrelEnv, idn : MizIdentify, clusters : MizClusters) -> MizChecker {
	MizChecker(env, idn, clusters, mizInitIntSeq(4), \__, __ -> 0, \__ -> [], false,
		mizMakeCensus(), makeVector(0), makeVector(0));
}

// one attribute in the derivation narration: ±V<nr>(<args>)
mizDerivAttr2s(a : MizAttr) -> string {
	(if (a.neg == 0) "-" else "+") + "V" + i2s(a.attrNr)
		+ (switch (a.args) {
			MizTrmNil(): "";
			default: "(" + mizTrmList2s(a.args) + ")";
		});
}

// cached derivation=1 flag: -1 = not read yet, then 0/1
gMizDerivOn : ref int = ref -1;

mizDerivOn() -> bool {
	if (^gMizDerivOn < 0)
		gMizDerivOn := if (getUrlParameterDef("derivation", "") == "1") 1 else 0;
	^gMizDerivOn == 1;
}

gMizDerivXmlOn : ref int = ref -1;

mizDerivXmlOn() -> bool {
	if (^gMizDerivXmlOn < 0)
		gMizDerivXmlOn := if (getUrlParameterDef("dump-derivation", "") != "") 1 else 0;
	^gMizDerivXmlOn == 1;
}

mizSetDerivXmlOn(on : bool) -> void {
	gMizDerivXmlOn := if (on) 1 else 0;
}

mizDerivFrmXml(env : MizCorrelEnv, f : MizFrm) -> string {
	o = mizMakeVrfOut(env);
	mizVOutFormula(o, f);
	mizVrfOutContent(o);
}

// minimal XML attribute escape for the SURFACE strings (&, <, >, ")
mizDerivQuote(s : string) -> string {
	strReplaces(s, ["&", "&amp;", "<", "&lt;", ">", "&gt;", "\"", "&quot;"]);
}

mizMakeCensus() -> MizCensus {
	MizCensus(makeVector(8), makeVector(8), 0, 0);
}

// dhisto is capped: an inference with more than 63 disjuncts lands in slot 63
mizCensusCap = 63;

mizCensusBump(v : Vector<int>, i : int) -> void {
	while(\ -> sizeVector(v) <= i, \ -> pushVector(v, 0));
	setVectorUnsafe(v, i, getVectorUnsafe(v, i) + 1);
}

mizCensusMergeInto(target : MizCensus, src : MizCensus) -> void {
	addIn = \tv : Vector<int>, sv : Vector<int> -> iteriVector(sv, \i, n -> {
		while(\ -> sizeVector(tv) <= i, \ -> pushVector(tv, 0));
		setVectorUnsafe(tv, i, getVectorUnsafe(tv, i) + n);
	});
	addIn(target.codes, src.codes);
	addIn(target.dhisto, src.dhisto);
	target.inferences ::= target.inferences + src.inferences;
	target.disjuncts ::= target.disjuncts + src.disjuncts;
}

mizChError(chk : MizChecker, e : int) -> void {
	if (!mizIntSetIsInSet(chk.chErrNr, e)) {
		__x = mizIntSetInsert(chk.chErrNr, e);
		{}
	}
}

// ContradictoryAttrs: merge-walk two sorted clusters, same attr with
// opposite sign
mizContradictoryAttrs(chk : MizChecker, c1 : MizAttrColl, c2 : MizAttrColl) -> bool {
	env = chk.env;
	n1 = sizeVector(c1.items);
	n2 = sizeVector(c2.items);
	if (n1 == 0 || n2 == 0) {
		false;
	} else {
		res = ref false;
		i = ref 0;
		j = ref 0;
		while(\ -> !^res && ^i < n1 && ^j < n2, \ -> {
			a : MizAttr = getVectorUnsafe(c1.items, ^i);
			b : MizAttr = getVectorUnsafe(c2.items, ^j);
			c = mizCompAbsAttr(env, a, b);
			if (c == -1) {
				i := ^i + 1;
			} else {
				if (c == 0) {
					if (a.neg != b.neg) res := true;
					i := ^i + 1;
				}
				j := ^j + 1;
			}
		});
		^res;
	}
}

// AllocInequality: record ¬(t1 = t2) in NegBas (deduplicated) and transfer
// non-empty / non-zero
mizAllocInequality(chk : MizChecker, eq : MizEqualizer, t1 : MizTrm, t2 : MizTrm) -> void {
	env = chk.env;
	i1 = mizTrmInfoOf(t1);
	i2 = mizTrmInfoOf(t2);
	dup = ref false;
	// THE ORIGINAL DEDUPLICATES BY TERM POINTER (`Left = FTrm1`, checker.pas
	// 62-69), and t1/t2 are the CLASS REPRESENTATIVES TrmS[i].Term — so only a
	// frame THIS procedure inserted can ever match. A premise `¬(a = b)` over
	// the same two classes is NOT a duplicate; treating it as one skips the
	// non-empty / non-zero transfer below and loses the refutation
	// (functor2 1083:27, where class 4 is empty and class 6 must not be).
	iterVector(eq.allocIneq, \p -> {
		if ((p.x == i1 && p.y == i2) || (p.x == i2 && p.y == i1)) dup := true;
	});
	if (!^dup) {
		pushVector(eq.allocIneq, MizIntPair(i1, i2));
		pushVector(eq.negBas, mizNewEqFrm(env, t1, t2));
		mizInsertNonEmptyPub(eq, i1, i2);
		mizInsertNonEmptyPub(eq, i2, i1);
		mizInsertNonZeroPub(eq, i1, i2);
		mizInsertNonZeroPub(eq, i2, i1);
	}
}

// OneDiffInTrmLists: exactly one class-different position
mizOneDiffInTrmLists(a0 : MizTrmList, b0 : MizTrmList) -> Maybe<Pair<MizTrm, MizTrm>> {
	diff : ref Maybe<Pair<MizTrm, MizTrm>> = ref None();
	multi = ref false;
	a = ref a0;
	b = ref b0;
	while(\ -> !^multi && switch (^a) { MizTrmNil(): false; default: true; }, \ -> {
		switch (^a) {
			MizTrmElem(ta, na): {
				switch (^b) {
					MizTrmElem(tb, nb): {
						if (mizTrmInfoOf(ta) != mizTrmInfoOf(tb)) {
							switch (^diff) {
								Some(__): multi := true;
								None(): diff := Some(Pair(ta, tb));
							}
						}
						a := na;
						b := nb;
					}
					MizTrmNil(): multi := true;
				}
			}
			MizTrmNil(): {}
		}
	});
	if (^multi) None() else ^diff;
}

mizPreUnification(chk : MizChecker, eq : MizEqualizer) -> void {
	env = chk.env;
	rqEq = mizBuiltIn(env.builtIn, rqEqualsTo);

	// positive irreflexive predicates force the two args apart
	iterVector(copyVector(eq.posBas), \pf -> {
		if (eq.contr == 0) {
			switch (pf) {
				MizPredFrm(srt, predNr, args, __): {
					if (srt == ikFrmPred) {
						c = mizConstr(env, coPredicate, predNr);
						if (mizHasProperty(c, syIrreflexivity)) {
							l = mizTrmListNth(args, c.firstArg - 1);
							r = mizTrmListNth(args, c.secondArg - 1);
							if (mizTrmInfoOf(l) == mizTrmInfoOf(r)) {
								eq.contr ::= 50;
							} else {
								mizAllocInequality(chk, eq,
									mizTrmSAt(eq, mizTrmInfoOf(l)).term,
									mizTrmSAt(eq, mizTrmInfoOf(r)).term);
							}
						}
					}
				}
				default: {}
			}
		}
	});
	if (eq.contr == 0) {
		// negative reflexive predicates likewise
		iterVector(copyVector(eq.negBas), \nf -> {
			if (eq.contr == 0) {
				switch (nf) {
					MizPredFrm(srt, predNr, args, __): {
						if (srt == ikFrmPred) {
							c = mizConstr(env, coPredicate, predNr);
							if (mizHasProperty(c, syReflexivity)) {
								l = mizTrmListNth(args, c.firstArg - 1);
								r = mizTrmListNth(args, c.secondArg - 1);
								if (mizTrmInfoOf(l) == mizTrmInfoOf(r)) {
									eq.contr ::= 51;
								} else {
									mizAllocInequality(chk, eq,
										mizTrmSAt(eq, mizTrmInfoOf(l)).term,
										mizTrmSAt(eq, mizTrmInfoOf(r)).term);
								}
							}
						}
					}
					default: {}
				}
			}
		});
	}
	if (eq.contr == 0) {
		// contradictory attribute clusters between classes
		n = mizTrmNbr(eq);
		fori(1, n, \ii -> {
			if (eq.contr == 0) {
				ri = mizTrmSAt(eq, ii);
				liveI = switch (ri.eqClass) { MizTrmNil(): false; default: true; };
				if (liveI) {
					fori(ii + 1, n, \jj -> {
						if (eq.contr == 0) {
							rj = mizTrmSAt(eq, jj);
							liveJ = switch (rj.eqClass) { MizTrmNil(): false; default: true; };
							if (liveJ && mizContradictoryAttrs(chk, ri.superCluster, rj.superCluster)) {
								mizAllocInequality(chk, eq, ri.term, rj.term);
							}
						}
					});
				}
			}
		});
	}
	if (eq.contr == 0) {
		// the one-difference rule
		ii = ref 0;
		while(\ -> eq.contr == 0 && ^ii < sizeVector(eq.negBas), \ -> {
			nf : MizFrm = getVectorUnsafe(eq.negBas, ^ii);
			switch (nf) {
				MizPredFrm(srt, predNr, args, __): {
					if (srt == ikFrmPred) {
						pfN : MizPredFrm = mizChkAsPred(nf);
						pa = mizAdjustFrm(env, pfN);
						// same-head functor pairs across two class members of a
						// reflexive predicate's args
						c = mizConstr(env, coPredicate, predNr);
						if (mizHasProperty(c, syReflexivity)) {
							l = mizTrmListNth(args, c.firstArg - 1);
							r = mizTrmListNth(args, c.secondArg - 1);
							curL = ref mizTrmSAt(eq, mizTrmInfoOf(l)).eqClass;
							while(\ -> switch (^curL) { MizTrmNil(): false; default: true; }, \ -> {
								switch (^curL) {
									MizTrmElem(tl, nl): {
										sl = mizTrmSort(tl);
										if (sl == ikTrmFunctor || sl == ikTrmSchFunc
											|| sl == ikTrmPrivFunc || sl == ikTrmAggreg
											|| sl == ikTrmSelector) {
											curR = ref mizTrmSAt(eq, mizTrmInfoOf(r)).eqClass;
											while(\ -> switch (^curR) { MizTrmNil(): false; default: true; }, \ -> {
												switch (^curR) {
													MizTrmElem(tr, nr): {
														if (mizTrmSort(tr) == sl
															&& mizChkFuncNr(tl) == mizChkFuncNr(tr)) {
															switch (mizOneDiffInTrmLists(
																mizChkArgs(tl), mizChkArgs(tr))) {
																Some(p): mizAllocInequality(chk, eq, p.first, p.second);
																None(): {}
															}
														}
														curR := nr;
													}
													MizTrmNil(): {}
												}
											});
										}
										curL := nl;
									}
									MizTrmNil(): {}
								}
							});
						}
						// negative vs positive same-head literal, one diff
						if (pa.first != mizBuiltIn(env.builtIn, rqEqualsTo)) {
							iterVector(eq.posBas, \pf -> {
								switch (pf) {
									MizPredFrm(s2, __, __, __): {
										if (s2 == ikFrmPred) {
											pfP : MizPredFrm = mizChkAsPred(pf);
											pb = mizAdjustFrm(env, pfP);
											if (pb.first == pa.first) {
												switch (mizOneDiffInTrmLists(pb.second, pa.second)) {
													Some(p): mizAllocInequality(chk, eq, p.first, p.second);
													None(): {}
												}
											}
										}
									}
									default: {}
								}
							});
						}
					} else {
						// SchPred / PrivPred / Attr: same nr, one diff
						iterVector(eq.posBas, \pf -> {
							switch (pf) {
								MizPredFrm(s2, p2, args2, __): {
									if (s2 == srt && p2 == predNr) {
										switch (mizOneDiffInTrmLists(args2, args)) {
											Some(p): mizAllocInequality(chk, eq, p.first, p.second);
											None(): {}
										}
									}
								}
								default: {}
							}
						});
					}
				}
				MizQualFrm(trm, typ, __): {
					// qualification one-diff: matching types in the class
					rec = mizTrmSAt(eq, mizTrmInfoOf(trm));
					iterVector(rec.xTypClass, \xt -> {
						if (xt.sort == typ.sort
							&& mizAttrCollIsSubsetOf(env, typ.lower, rec.superCluster,
								\x, y -> mizAttrEquals(env, x, y))
							&& xt.sort == ikTypMode) {
							p1 = mizAdjustTyp(env, xt);
							p2 = mizAdjustTyp(env, typ);
							if (p1.first == p2.first) {
								switch (mizOneDiffInTrmLists(p1.second, p2.second)) {
									Some(p): mizAllocInequality(chk, eq, p.first, p.second);
									None(): {}
								}
							}
						}
					});
					// classes with a radix-equal type must differ from this term
					fori(1, mizTrmNbr(eq), \j -> {
						if (j != mizTrmInfoOf(trm)) {
							rj = mizTrmSAt(eq, j);
							liveJ = switch (rj.eqClass) { MizTrmNil(): false; default: true; };
							if (liveJ) {
								hit = ref false;
								iterVector(rj.xTypClass, \xt ->
									if (!^hit && mizEqRadices(env, typ, xt)) hit := true);
								if (^hit) {
									mizAllocInequality(chk, eq, trm, rj.term);
								}
							}
						}
					});
				}
				default: {}
			}
			ii := ^ii + 1;
		});
	}
}

mizChkAsPred(f : MizFrm) -> MizPredFrm {
	switch (f) { MizPredFrm(__, __, __, __): f; default: { mizRunTimeError(2908); MizPredFrm(ikError, 0, MizTrmNil(), 0); } }
}

mizChkFuncNr(t : MizTrm) -> int {
	switch (t) {
		MizFuncTrm(__, funcNr, __, __, __): funcNr;
		MizPrivFuncTrm(funcNr, __, __, __, __): funcNr;
		default: 0;
	}
}

mizChkArgs(t : MizTrm) -> MizTrmList {
	switch (t) {
		MizFuncTrm(__, __, args, __, __): args;
		MizPrivFuncTrm(__, args, __, __, __): args;
		default: MizTrmNil();
	}
}

// ---------------- InferenceChecker ----------------

mizInferenceChecker(chk : MizChecker, inference : Vector<MizFrm>) -> void {
	env = chk.env;
	idn = chk.idn;
	mizSeqClear(chk.chErrNr);
	clearVector(chk.derivation);
	clearVector(chk.derivXml);
	// marks: collected constants added during THIS inference are dropped after
	infMark = sizeVector(env.inferConstDef);
	ttMark = mizTTCollMark(env);   // MarkTermsInTTColl (checker.pas 335)
	fixedMark = env.fixedVarNbr;
	env.boundVarNbr ::= 0;

	pre = mizMakePre(env);
	pre.collectConst ::= \f -> mizCollectConstInFrm(idn, f);
	pre.collectConstTyp ::= \t -> mizCollectConstInTyp(idn, t);
	pre.atomicExpansions ::= chk.atomicExpansions;
	// the rounded-type memo is valid only while the constant base is fixed
	mizClearRoundMemo(chk.clusters);

	// ItIsChecker is set by the original around EACH DISJUNCT only
	// (checker.pas 372/399), NOT around PreCheck. The flag selects the
	// UNCACHED RoundUpTrmType over the gTermCollection-cached GetTrmType
	// inside CheckLociTypes, so leaving it on during PreCheck makes every
	// definiens match re-round its argument types from scratch — and when an
	// argument is a raw nested functor term (bound variables keep it out of
	// InferConstDef) that recursion is exponential in the term's depth.
	pre.debug ::= chk.debug;
	normalForm = mizPreCheck(pre, inference);

	if (pre.trivialError) {
		mizChError(chk, 1);
	} else if (pre.latOvfl) {
		mizChError(chk, 8);
	} else {
		anyTrmOvfl = ref false;
		anyLatOvfl = ref false;
		iteriVector(normalForm.evals, \di, eval -> {
			if (chk.debug) {
				println("Disjunct: " + i2s(di));
				fori(0, mizNatCount(eval) - 1, \z -> {
					it = mizNatItem(eval, z);
					println("  " + (if (it.y == 0) "-" else " ")
						+ mizFrm2s(getVectorUnsafe(pre.basic, it.x)));
				});
			}
			env.itIsChecker ::= true;
			env.boundVarNbr ::= 0;
			if (mizDerivOn()) {
				pushVector(chk.derivation, "disjunct " + i2s(di + 1) + " of "
					+ i2s(sizeVector(normalForm.evals)) + ", literals:");
				fori(0, mizNatCount(eval) - 1, \z -> {
					it = mizNatItem(eval, z);
					pushVector(chk.derivation, "  " + (if (it.y == 0) "-" else "+")
						+ " " + mizFrm2s(getVectorUnsafe(pre.basic, it.x)));
				});
			}
			if (mizDerivXmlOn()) {
				pushVector(chk.derivXml, "<Disjunct nr=\"" + i2s(di + 1)
					+ "\" of=\"" + i2s(sizeVector(normalForm.evals)) + "\">\n");
				fori(0, mizNatCount(eval) - 1, \z -> {
					it = mizNatItem(eval, z);
					// basic= is the checker's index of this literal in pre.basic —
					// the provenance events (<Equation basic=…>) point back to it
					pushVector(chk.derivXml, "<Literal value=\""
						+ (if (it.y == 0) "false" else "true")
						+ "\" basic=\"" + i2s(it.x) + "\">\n"
						+ mizDerivFrmXml(env, getVectorUnsafe(pre.basic, it.x))
						+ "</Literal>\n");
				});
			}
			eq = mizMakeEqualizer(env, idn, chk.clusters, pre);
			eq.logMerges ::= mizDerivXmlOn();
			mizEquate(eq, eval);
			// the congruence-closure proof forest of this disjunct, in issue
			// order — the equality provenance the full replay chains through
			if (mizDerivXmlOn() && sizeVector(eq.mergeLog) > 0) {
				iterVector(eq.mergeLog, \m -> pushVector(chk.derivXml, m));
			}
			if (chk.debug) mizDumpEqClasses(eq);
			if (eq.contr == 0) {
				mizPreUnification(chk, eq);
				if (eq.contr == 0) {
					uContr = chk.unification(chk, eq);
					if (uContr > 0) {
						eq.contr ::= uContr;
					} else {
						mizChError(chk, 4);
					}
				}
			}
			if (eq.trmOvfl) anyTrmOvfl := true;
			env.itIsChecker ::= false;
			if (mizDerivXmlOn() && eq.contr > 0 && eq.contr < 45) {
				fori(1, mizTrmNbr(eq), \ci -> {
					rec = mizTrmSAt(eq, ci);
					if (!rec.superCluster.consistent) {
						surface = switch (rec.eqClass) {
							MizTrmElem(t, __): mizTrm2s(t);
							MizTrmNil(): mizTrm2s(rec.term);
						};
						pushVector(chk.derivXml, "<AttrClash class=\"" + i2s(ci)
							+ "\" surface=\"" + mizDerivQuote(surface) + "\""
							+ (switch (rec.superCluster.refutedBy) {
								Some(pr): " a1=\"" + mizDerivQuote(mizDerivAttr2s(pr.first))
									+ "\" a2=\"" + mizDerivQuote(mizDerivAttr2s(pr.second)) + "\"";
								None(): "";
							}) + "/>\n");
					}
				});
			}
			if (mizDerivOn() && eq.contr > 0 && eq.contr < 45) {
				// the equalizer family: find the class whose supercluster was
				// refuted and name the clashing attribute pair (the equalizer
				// stops at the first inconsistency, so there is at most one)
				fori(1, mizTrmNbr(eq), \ci -> {
					rec = mizTrmSAt(eq, ci);
					if (!rec.superCluster.consistent) {
						surface = switch (rec.eqClass) {
							MizTrmElem(t, __): mizTrm2s(t);
							MizTrmNil(): mizTrm2s(rec.term);
						};
						switch (rec.superCluster.refutedBy) {
							Some(pr): pushVector(chk.derivation,
								"  attribute clash on class E" + i2s(ci)
								+ " (" + surface + "): "
								+ mizDerivAttr2s(pr.first) + " vs "
								+ mizDerivAttr2s(pr.second));
							None(): pushVector(chk.derivation,
								"  attribute clash on class E" + i2s(ci));
						}
					}
				});
			}
			// census: which rule closed this disjunct (0 = not refuted)
			cs = chk.census;
			mizCensusBump(cs.codes, max(0, eq.contr));
			cs.disjuncts ::= cs.disjuncts + 1;
			if (mizDerivOn())
				pushVector(chk.derivation, "  closed by contr " + i2s(eq.contr));
			if (mizDerivXmlOn()) {
				// the CLASS TABLE in its final (renumbered) state: per live class
				// its number and member terms (yielded forms — EqClass references
				// resolve to other classes in this same table). With it the
				// record's equality claims are checkable in-record: two terms are
				// equal iff one class lists both, and the merge/provenance log
				// says why.
				fori(1, mizTrmNbr(eq), \ti -> {
					trec = mizTrmSAt(eq, ti);
					tlive = switch (trec.eqClass) { MizTrmNil(): false; default: true; };
					if (tlive) {
						clNr = switch (trec.term) {
							MizVarTrm(__, vn, __, __): vn;
							default: 0;
						};
						o5 = mizMakeVrfOut(env);
						cur5 = ref trec.eqClass;
						while(\ -> switch (^cur5) { MizTrmNil(): false; default: true; }, \ -> {
							switch (^cur5) {
								MizTrmElem(mtrm, mnext) : {
									mizVOutTerm(o5, mtrm);
									cur5 := mnext;
								}
								MizTrmNil(): {}
							}
						});
						pushVector(chk.derivXml, "<Class nr=\"" + i2s(clNr) + "\">\n"
							+ mizVrfOutContent(o5) + "</Class>\n");
					}
				});
				// the equalizer BASIS in its final state (after unification —
				// AllocInequality extends negBas there): the atoms the <Cand>
				// events' posbas/negbas indices point into. Yielded forms —
				// terms are class references, same dialect as the evidence.
				iteriVector(eq.posBas, \bi, bfrm ->
					pushVector(chk.derivXml, "<PosBas nr=\"" + i2s(bi) + "\">\n"
						+ mizDerivFrmXml(env, bfrm) + "</PosBas>\n"));
				iteriVector(eq.negBas, \bi, bfrm ->
					pushVector(chk.derivXml, "<NegBas nr=\"" + i2s(bi) + "\">\n"
						+ mizDerivFrmXml(env, bfrm) + "</NegBas>\n"));
				pushVector(chk.derivXml, "<Contr code=\"" + i2s(max(0, eq.contr))
					+ "\"/>\n</Disjunct>\n");
			}
		});
		// census: the case-split width; 0 disjuncts = the inference was
		// settled by normalization alone
		cs2 = chk.census;
		cs2.inferences ::= cs2.inferences + 1;
		mizCensusBump(cs2.dhisto,
			min(sizeVector(normalForm.evals), mizCensusCap));
		if (^anyLatOvfl || pre.latOvfl) mizChError(chk, 9);
		if (^anyTrmOvfl) mizChError(chk, 14);
	}
	if (pre.constOvfl) mizChError(chk, 11);

	if (chk.debug && getUrlParameterDef("dbg-icd", "") == "1") {
		// the InferConstDef table BEFORE the per-inference release, in the
		// original's own `InferConstDef[i] <def>` / [lower][upper]M layout
		iteriVector(env.inferConstDef, \i, cd ->
			println("  ICD[" + i2s(i) + "] "
				+ (switch (mizNumericValue(idn, i)) {
					Some(nv): "(" + mizCplx2s(nv) + ") ";
					None(): "";
				})
				+ mizTrm2s(cd.def)
				+ (if (mizNatCount(cd.eqConst) == 0) "" else
					" := " + strGlue(map(enumFromTo(0, mizNatCount(cd.eqConst) - 1),
						\z -> i2s(mizNatItem(cd.eqConst, z).x)), ","))
				+ "\n    " + mizFullTyp2s(cd.typ)));
	}
	env.itIsChecker ::= false;
	// release per-inference state
	env.fixedVarNbr ::= fixedMark;
	mizInferRelease(idn, infMark);
	mizClearRoundMemo(chk.clusters); // the memo is keyed by term STRUCTURE
	mizTTCollRelease(env, ttMark); // RemoveTermsFromTTColl (checker.pas 434)
}
