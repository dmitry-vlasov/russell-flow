// Transcription of ~/dev/system/kernel/lexicon.pas — the internal kind
// characters ("ik*"). They are Pascal char constants; here they are int char
// codes. Values must match the original byte-for-byte: they appear in the
// intermediate files and drive every `case TrmSort of`.

export {
	ikError = 63;          // '?'

	// Internal Term Kind
	ikTrmLocus = 65;       // 'A'
