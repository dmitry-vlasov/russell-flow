	ikTrmQua = 213;        // #213
	ikTrmChoice = 216;     // #216
	ikTrmFraenkel = 232;   // #232
	ikTrmIt = 234;         // #234

	// Internal Type Kind
	ikTypMode = 77;        // 'M'
	ikTypStruct = 71;      // 'G'  (original comment suggests 'L', value is 'G')
