// The CheckerOnly pass: walk a Mizar analyzer report (`.xml`) and check every
// `by` justification — the transcription of the mizprep.pas / prepobj.pas /
// prephan.pas premise assembly reduced to what the checker consumes:
//
//   premises of a `by` = ¬(the justified proposition) + the linked previous
//   proposition + the cited references (private label / theorem / def).
//
// The walker maintains the two per-level facts the checker reads: FixedVar
// (constants introduced by Let/Consider/Given, with their types) and the
// label table. Nested Proof/Now blocks save and restore both.
//
// Environment: constructors from `.atr`, requirements from `.ere`, theorems
// and def-theorems from `.eth`, clusters from `.ecl`.
// STAGED: `from` scheme justifications (schemes.pas) are counted and
// skipped; PerCases/IterEquality blocks likewise; definientia (.dfs) load
// with the expansion machinery. Each skip is COUNTED, never silent.

import string;
import loop;
import ds/vector;
import ds/tree;
import fs/filesystem;
import mizar/original/errhan;
import mizar/original/mobjects;
import mizar/original/lexicon;
import mizar/original/builtin;
import mizar/original/xml_parser;
import mizar/original/correl;
import mizar/original/correl_inst;
import mizar/original/iocorrel;
import mizar/original/roundcl;
import mizar/original/identify;
import mizar/original/numbers;
import mizar/original/prechecker;
import mizar/original/equalizer;
import mizar/original/checker;
import mizar/original/unifier;
import mizar/original/definientia;
import mizar/original/schemes;
import mizar/original/print;
import net/url_parameter;

export {
	MizPrepStats(
		mutable checked : int,       // by-inferences run through the checker
		mutable accepted : int,      // empty error set
		mutable failed : int,        // nonempty error set
		mutable skippedFrom : int,   // scheme justifications (staged)
		mutable skippedBlocks : int, // unrecognized block kinds
		failures : Vector<string>,   // "line:col errs" for the failed ones
	);

	MizPrep(
		chk : MizChecker,
		r : MizVrfReader,
		labeled : Vector<Maybe<MizFrm>>,   // label nr -> proposition (block-scoped)
		permLabeled : Vector<Maybe<MizFrm>>, // article-level labels (Def*/theorems)
		mutable prev : Maybe<MizFrm>,      // the `then` link
	mutable lastBlockThesis : Maybe<MizFrm>, // set when a BlockThesis is read
		mutable theorems : Tree<int, MizFrm>,   // key = kindTag*10^8 + articlenr*10^4 + nr
		defs : MizDefinientia,
		schemes : MizSchemes,
	mutable ownArticleNr : int,
		mutable ownTheoremNr : int,
		mutable ownDefNr : int,
		stats : MizPrepStats,
	);

	// where a checked article's environment comes from. The three phases are
	// the original's: constructors+requirements, then the registrations, then
	// everything that is read AFTER the environment round-up (theorems,
	// schemes, definientia, identifications, reductions) — see
	// Load_EnvConstructors / AfterClusters in iocorrel.pas.
	MizEnvLoader(
		early : (MizCorrelEnv) -> void,
		clusters : (MizCorrelEnv, MizClusters) -> void,
		late : (MizCorrelEnv, MizClusters, MizIdentify, MizDefinientia, MizPrep) -> void,
	);
	mizFileEnvLoader(mmlDir : string, article : string) -> MizEnvLoader;

	// Load the environment and check one article's analyzer report.
	// mmlDir = …/mml, article = base name. Returns the stats.
	mizCheckArticle(mmlDir : string, article : string) -> MizPrepStats;
	mizCheckArticleWith(mmlDir : string, article : string,
		loader : MizEnvLoader) -> MizPrepStats;

	// the schemes registry of a MizPrep (the accommodated loader fills it)
	mizLoadSchemes(p : MizPrep, content : string) -> void;

	// MML-format reader (one cluster per Typ)
	mizMakeVrfReaderMML(x : MizXmlParser, env : MizCorrelEnv) -> MizVrfReader;

	// .ecl / prel .dcl: <Registrations> with RCluster/CCluster/FCluster
	mizLoadClusters(env : MizCorrelEnv, cl : MizClusters, content : string) -> void;

	// read one RCluster/CCluster/FCluster element without registering it —
	// the accommodator renumbers before inserting
	mizReadClusterVal(r2 : MizVrfReader) -> Maybe<MizAnyCluster>;
	mizInsertAnyCluster(env : MizCorrelEnv, cl : MizClusters, c : MizAnyCluster) -> void;

	// .eth: theorem key and payload. kindT/kindD tag the two theorem kinds.
	kindT : int; kindD : int;
	mizThKey(kind : int, articlenr : int, nr : int) -> int;
	mizLoadTheoremTree(env : MizCorrelEnv, content : string) -> Pair<Tree<int, MizFrm>, int>;

	// .esh: schemes into an existing registry
	mizLoadSchemesInto(env : MizCorrelEnv, schemes : MizSchemes, content : string) -> void;

	// .ere: the flat requirement list
	mizLoadRequirementsFile(env : MizCorrelEnv, path : string) -> void;

	// .eid / .erd (and prel .did / .drd): one item into a registry
	mizReadOneIdentify(idn : MizIdentify, r2 : MizVrfReader) -> void;
	mizReadOneReduction(idn : MizIdentify, r2 : MizVrfReader) -> void;
	mizLoadIdentifications(env : MizCorrelEnv, idn : MizIdentify, content : string) -> void;
	mizLoadReductions(env : MizCorrelEnv, idn : MizIdentify, content : string) -> void;
}

kindT = 1;
kindD = 2;

mizThKey(kind : int, articlenr : int, nr : int) -> int {
	kind * 100000000 + articlenr * 10000 + nr;
}

// ---------------- environment loading ----------------

mizLoadRequirementsFile(env : MizCorrelEnv, path : string) -> void {
	content = getFileContent(path);
	lines = strSplit(content, "\n");
	fori(0, min(length(lines) - 1, rqLAST), \i -> {
		v = s2i(trim(lines[i]));
		mizSetBuiltIn(env.builtIn, i, v);
	});
}

mizLoadTheorems(p : MizPrep, content : string) -> void {
	res = mizLoadTheoremTree(p.r.env, content);
	p.theorems ::= res.first;
	p.ownArticleNr ::= res.second;
}

// the .eth payload as (key -> formula, own article nr)
mizLoadTheoremTree(env : MizCorrelEnv, content : string) -> Pair<Tree<int, MizFrm>, int> {
	if (content == "") {
		Pair(makeTree(), 1);
	} else {
		r2 = mizMakeVrfReaderMML(mizXmlInitParsing(content), env);
		x = r2.x;
		mizXmlNextElementState(x);
		mizXmlAssert(x.nElName == "Theorems");
		mizXmlNextElementState(x);
		maxArt = ref 0;
		acc = ref makeTree();
		while(\ -> x.nState == MizEStart, \ -> {
			if (x.nElName == "Theorem") {
				articlenr = mizXmlIntAttrDef(x, "articlenr", 0);
				nr = mizXmlIntAttrDef(x, "nr", 0);
				kindS = mizXmlAttr(x, "kind");
				kind = if (kindS == "T") kindT else kindD;
				if (articlenr > ^maxArt) maxArt := articlenr;
				mizXmlNextElementState(x);
				f = mizInFormula(r2);
				// after the formula: at </Theorem>; advance
				mizXmlNextElementState(x);
				acc := setTree(^acc, mizThKey(kind, articlenr, nr), f);
			} else {
				mizXmlSkipElement(x);
			}
		});
		Pair(^acc, ^maxArt + 1);
	}
}

// .ecl: <Registrations> with RCluster/CCluster/FCluster
mizLoadClusters(env : MizCorrelEnv, cl : MizClusters, content : string) -> void {
	if (content != "") {
	r2 = mizMakeVrfReaderMML(mizXmlInitParsing(content), env);
	x = r2.x;
	mizXmlNextElementState(x);
	mizXmlAssert(x.nElName == "Registrations");
	mizXmlNextElementState(x);
	while(\ -> x.nState == MizEStart, \ -> {
		mizReadOneCluster(env, cl, r2);
	});
	}
}

// one RCluster/CCluster/FCluster element (also used for inline ones in .xml)
mizReadOneCluster(env : MizCorrelEnv, cl : MizClusters, r2 : MizVrfReader) -> void {
	switch (mizReadClusterVal(r2)) {
		Some(c): mizInsertAnyCluster(env, cl, c);
		None(): {}
	}
}

mizInsertAnyCluster(env : MizCorrelEnv, cl : MizClusters, c : MizAnyCluster) -> void {
	switch (c) {
		MizRCluster(__, __, __, __, __): mizInsertRCluster(cl, c);
		MizCCluster(__, __, __, __, __, __): mizInsertCCluster(env, cl, c);
		MizFCluster(__, __, __, __, __, __): mizInsertFCluster(env, cl, c);
	}
}

// the article's OWN registration, met while walking: insert it and then run
// the Finish*Cluster re-rounding of the already-collected constants
mizDeclareCluster(env : MizCorrelEnv, cl : MizClusters, idn : MizIdentify,
		c : MizAnyCluster) -> void {
	mizInsertAnyCluster(env, cl, c);
	switch (c) {
		MizRCluster(__, __, __, __, __): {}  // FinishExistentialCluster: insert only
		MizCCluster(__, __, __, __, __, __): mizFinishCCluster(env, cl, idn, c);
		MizFCluster(__, __, __, __, __, __): mizFinishFCluster(env, cl, idn, c);
	}
}

// ---------------- re-rounding on a newly declared registration ----------------
// stdprep.pas FinishConditionalCluster (1035) / FinishFunctorCluster (1084) /
// FinishExistentialCluster (969) + RoundUpFurther (991).
//
// A constant is collected with the type the registrations known AT THAT MOMENT
// give it, and that type is then frozen in InferConstDef. When the article
// later DECLARES a registration of its own, the original walks the whole
// collected table and re-rounds every entry the new cluster reaches, then
// propagates to the entries that mention those constants as arguments.
// Without this pass a constant interned before a registration keeps a stale,
// weaker type for the rest of the article. (An EXISTENTIAL/registered cluster
// triggers no re-rounding — the original's FinishExistentialCluster only
// inserts, and the authors' own ##TODO above RoundUpFurther lists exactly
// which cases they left out; transcribed as-is, omissions included.)
//
// RoundUpFurther (991): from the first entry that changed to the end of the
// table, an entry whose definition is a functor/selector/aggregate/scheme-functor
// term with an argument among the changed constants is re-rounded from scratch;
// a NUMERAL entry has its upper cluster re-rounded unconditionally.
mizRoundUpFurther(env : MizCorrelEnv, cl : MizClusters, idn : MizIdentify,
		firstRoundedUp : int, roundedUp : MizNatFunc) -> void {
	mizClearRoundMemo(cl);
	reRoundUpper = \cd : MizConstDef -> {
		ty = cd.typ;
		lCl = mizCopyCluster(ty.upper);
		mizRoundUpCluster(env, cl, lCl, ty);
		ty.upper ::= mizCollectConstInCluster(idn, lCl);
	};
	fori(firstRoundedUp, sizeVector(env.inferConstDef) - 1, \i -> {
		cd : MizConstDef = getVectorUnsafe(env.inferConstDef, i);
		srt = mizTrmSort(cd.def);
		if (srt == ikTrmFunctor || srt == ikTrmSelector || srt == ikTrmAggreg
			|| srt == ikTrmSchFunc) {
			args = switch (cd.def) {
				MizFuncTrm(__, __, a, __, __): a;
				default: mizNil;
			};
			touched = ref false;
			l = ref args;
			while(\ -> !^touched && switch (^l) { MizTrmNil(): false; default: true; }, \ -> {
				switch (^l) {
					MizTrmElem(t, next): {
						switch (t) {
							MizVarTrm(vs, vnr, __, __):
								if (vs == ikTrmInfConst && mizNatHasInDom(roundedUp, vnr)) {
									touched := true;
								}
							default: {}
						}
						l := next;
					}
					MizTrmNil(): {}
				}
			});
			if (^touched) {
				// the memo is keyed by term structure and the ARGUMENTS' types
				// have just changed — a stale entry would hand back exactly the
				// type this re-rounding exists to replace
				mizClearRoundMemo(cl);
				cd.typ ::= mizRoundUpTrmType(env, cl, cd.def);
				reRoundUpper(cd);
			}
		} else if (srt == ikTrmNumeral) {
			reRoundUpper(cd);
		}
	});
}

// the shared tail of both Finish*Cluster procedures
mizFinishClusterRound(env : MizCorrelEnv, cl : MizClusters, idn : MizIdentify,
		roundOne : (MizConstDef) -> bool) -> void {
	firstRoundedUp = ref -1;
	roundedUp = mizInitNatSet(8);
	fori(0, sizeVector(env.inferConstDef) - 1, \i -> {
		cd : MizConstDef = getVectorUnsafe(env.inferConstDef, i);
		if (roundOne(cd)) {
			if (^firstRoundedUp < 0) firstRoundedUp := i;
			mizNatInsertElem(roundedUp, i);
		}
	});
	if (^firstRoundedUp >= 0) {
		mizRoundUpFurther(env, cl, idn, ^firstRoundedUp, roundedUp);
	}
}

// FinishConditionalCluster (stdprep.pas 1035): the new conditional cluster is
// TryRounding'd against every collected constant's type, and NonZeroTyp is
// rounded again at the end.
mizFinishCCluster(env : MizCorrelEnv, cl : MizClusters, idn : MizIdentify,
		cc : MizCCluster) -> void {
	mizFinishClusterRound(env, cl, idn, \cd -> {
		ty = cd.typ;
		lCl = mizCopyCluster(ty.upper);
		if (mizTryRounding(env, cc, ty, lCl)) {
			mizRoundUpCluster(env, cl, lCl, ty);
			ty.upper ::= mizCollectConstInCluster(idn, lCl);
			true;
		} else {
			false;
		}
	});
	mizTypRoundUp(env, cl, env.nonZeroTyp);
}

// FinishFunctorCluster (stdprep.pas 1084): the new functor cluster is applied
// to every collected constant whose definition IS that cluster's term.
mizFinishFCluster(env : MizCorrelEnv, cl : MizClusters, idn : MizIdentify,
		fc : MizFCluster) -> void {
	mizFinishClusterRound(env, cl, idn, \cd -> {
		if (mizCmpFuncTrm(env, fc.clusterTerm, cd.def) != 0) {
			false;
		} else {
			ty = cd.typ;
			lCl = mizCopyCluster(ty.upper);
			if (mizFClusterRoundUpWith(env, fc, cd.def, ty, lCl)) {
				mizRoundUpCluster(env, cl, lCl, ty);
				ty.upper ::= mizCollectConstInCluster(idn, lCl);
				true;
			} else {
				false;
			}
		}
	});
}

mizReadClusterVal(r2 : MizVrfReader) -> Maybe<MizAnyCluster> {
	x = r2.x;
	name = x.nElName;
	aid = mizXmlAttr(x, "aid");
	nr = mizXmlIntAttrDef(x, "nr", 0);
	if (name == "RCluster") {
		mizXmlNextElementState(x);
		prims = mizInArgColl(r2);
		typ = mizInType(r2);
		lower = mizInAttrColl(r2);
		// the DB format may carry a second cluster
		upper = if (x.nState == MizEStart && x.nElName == "Cluster") mizInAttrColl(r2)
			else mizCopyCluster(lower);
		mizXmlNextElementState(x);
		Some(MizRCluster(aid, nr, prims, MizClusterRec(lower, upper), typ));
	} else if (name == "CCluster") {
		mizXmlNextElementState(x);
		prims = mizInArgColl(r2);
		ante = mizInAttrColl(r2);
		typ = mizInType(r2);
		lower = mizInAttrColl(r2);
		upper = if (x.nState == MizEStart && x.nElName == "Cluster") mizInAttrColl(r2)
			else mizCopyCluster(lower);
		mizXmlNextElementState(x);
		Some(MizCCluster(aid, nr, prims, ante, MizClusterRec(lower, upper), typ));
	} else if (name == "FCluster") {
		mizXmlNextElementState(x);
		prims = mizInArgColl(r2);
		trm = mizInTerm(r2);
		lower = mizInAttrColl(r2);
		// VRF carries Lower + Upper; MML only one cluster
		upper = if (x.nState == MizEStart && x.nElName == "Cluster") mizInAttrColl(r2)
			else mizCopyCluster(lower);
		typ : Maybe<MizTyp> = if (x.nState == MizEStart && x.nElName == "Typ")
			Some(mizInType(r2)) else None();
		mizXmlNextElementState(x);
		Some(MizFCluster(aid, nr, prims, MizClusterRec(lower, upper), trm, typ));
	} else {
		mizXmlSkipElement(x);
		None();
	}
}

// one <Reduction>: primaries as bare Typ*, then the two terms (In_Reduction)
mizReadOneReduction(idn : MizIdentify, r2 : MizVrfReader) -> void {
	x = r2.x;
	aid = mizXmlAttr(x, "aid");
	nr = mizXmlIntAttrDef(x, "nr", 0);
	mizXmlNextElementState(x);
	if (x.nState == MizEStart && x.nElName == "ErrorReduction") {
		while(\ -> x.nState == MizEStart, \ -> mizXmlSkipElement(x));
	} else {
		prims : Vector<MizTyp> = makeVector(4);
		while(\ -> x.nState == MizEStart && x.nElName == "Typ",
			\ -> pushVector(prims, mizInType(r2)));
		t0 = mizInTerm(r2);
		t1 = mizInTerm(r2);
		pushVector(idn.reductions, MizReduction(aid, nr, prims, t0, t1));
	}
	mizXmlNextElementState(x);
}

// one <Identify>: constrkind, primaries as bare Typ*, two patterns, EqArgs.
// Only the functor kind ('K') is retained (In_Identify)
mizReadOneIdentify(idn : MizIdentify, r2 : MizVrfReader) -> void {
	x = r2.x;
	aid = mizXmlAttr(x, "aid");
	nr = mizXmlIntAttrDef(x, "nr", 0);
	kindS = mizXmlAttr(x, "constrkind");
	mizXmlNextElementState(x);
	if (x.nState == MizEStart && x.nElName == "ErrorIdentify") {
		while(\ -> x.nState == MizEStart, \ -> mizXmlSkipElement(x));
	} else if (kindS == "K") {
		prims : Vector<MizTyp> = makeVector(4);
		while(\ -> x.nState == MizEStart && x.nElName == "Typ",
			\ -> pushVector(prims, mizInType(r2)));
		p0 = mizInTerm(r2);
		p1 = mizInTerm(r2);
		eqArgs = ref [];
		if (x.nState == MizEStart && x.nElName == "EqArgs") {
			mizXmlNextElementState(x);
			while(\ -> x.nState == MizEStart, \ -> {
				if (x.nElName == "Pair") {
					px = mizXmlIntAttrDef(x, "x", 0);
					py = mizXmlIntAttrDef(x, "y", 0);
					eqArgs := arrayPush(^eqArgs, MizIntPair(px, py));
				}
				mizXmlSkipElement(x);
			});
			mizXmlNextElementState(x);
		}
		pushVector(idn.identifications,
			MizFuncIdent(aid, nr, prims, p0, p1, ^eqArgs));
		while(\ -> x.nState == MizEStart, \ -> mizXmlSkipElement(x));
	} else {
		// attribute/predicate identifications — staged
		while(\ -> x.nState == MizEStart, \ -> mizXmlSkipElement(x));
	}
	mizXmlNextElementState(x);
}

// .eid: <IdentifyRegistrations> with Identify*
mizLoadIdentifications(env : MizCorrelEnv, idn : MizIdentify, content : string) -> void {
	if (content != "") {
		r2 = mizMakeVrfReaderMML(mizXmlInitParsing(content), env);
		x = r2.x;
		mizXmlNextElementState(x);
		mizXmlAssert(x.nElName == "IdentifyRegistrations");
		mizXmlNextElementState(x);
		while(\ -> x.nState == MizEStart, \ -> {
			if (x.nElName == "Identify") mizReadOneIdentify(idn, r2)
			else mizXmlSkipElement(x);
		});
	}
}

// .erd: <ReductionRegistrations> with Reduction*
mizLoadReductions(env : MizCorrelEnv, idn : MizIdentify, content : string) -> void {
	if (content != "") {
		r2 = mizMakeVrfReaderMML(mizXmlInitParsing(content), env);
		x = r2.x;
		mizXmlNextElementState(x);
		mizXmlAssert(x.nElName == "ReductionRegistrations");
		mizXmlNextElementState(x);
		while(\ -> x.nState == MizEStart, \ -> {
			if (x.nElName == "Reduction") mizReadOneReduction(idn, r2)
			else mizXmlSkipElement(x);
		});
	}
}

// .esh: <Schemes> with <Scheme articlenr nr>: ArgTypes (the scheme functors'
// result types), then the statement formula followed by the premises
mizLoadSchemes(p : MizPrep, content : string) -> void {
	mizLoadSchemesInto(p.r.env, p.schemes, content);
}

mizLoadSchemesInto(env : MizCorrelEnv, schemes : MizSchemes, content : string) -> void {
	if (content != "") {
		r2 = mizMakeVrfReaderMML(mizXmlInitParsing(content), env);
		x = r2.x;
		mizXmlNextElementState(x);
		mizXmlAssert(x.nElName == "Schemes");
		mizXmlNextElementState(x);
		while(\ -> x.nState == MizEStart, \ -> {
			if (x.nElName == "Scheme") {
				art = mizXmlIntAttrDef(x, "articlenr", 0);
				nr = mizXmlIntAttrDef(x, "nr", 0);
				mizXmlNextElementState(x);
				// In_ArgColl(CurSchFuncTyp): the scheme functors' result types
				// must be in place while the propositions are read
				clearVector(env.curSchFuncTyp);
				if (x.nState == MizEStart && x.nElName == "ArgTypes") {
					mizInArgCollInto(r2, env.curSchFuncTyp);
				}
				types = copyVector(env.curSchFuncTyp);
				props = ref [];
				bad = ref false;
				while(\ -> x.nState == MizEStart, \ -> {
					if (mizIsFrmEl(x.nElName)) {
						props := arrayPush(^props, mizInFormula(r2));
					} else {
						if (x.nElName == "Canceled" || x.nElName == "ErrorScheme") {
							bad := true;
						}
						mizXmlSkipElement(x);
					}
				});
				clearVector(env.curSchFuncTyp);
				pushVector(schemes.items,
					MizSchemeDef(art, nr, types, ^props, !^bad));
				mizXmlNextElementState(x);
			} else {
				mizXmlSkipElement(x);
			}
		});
	}
}

// MML-format reader (one cluster per Typ)
mizMakeVrfReaderMML(x : MizXmlParser, env : MizCorrelEnv) -> MizVrfReader {
	r = mizMakeVrfReader(x, env);
	r.mml ::= true;
	r;
}

// ---------------- the walker ----------------

// The environment can come from the flat files Mizar's accom wrote, or be
// accommodated from `prel/` by accom.flow — hence the two hooks. `early` runs
// before the built-in types are derived (it must supply constructors and
// requirements), `late` after (registrations, theorems, schemes, definientia).
mizCheckArticleWith(mmlDir : string, article : string,
		loader : MizEnvLoader) -> MizPrepStats {
	env = mizMakeCorrelEnv();
	cl = mizMakeClusters();
	mizWireRoundcl(env, cl);
	idn = mizMakeIdentify(env);
	chk = mizMakeChecker(env, idn, cl);
	mizWireUnifier(chk);

	// environment: constructors + requirements
	loader.early(env);
	env.itTyp ::= mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(),
		mizNewEmptyCluster(), mizBuiltIn(env.builtIn, rqAny), mizNil);
	rqElemB = mizBuiltIn(env.builtIn, rqElement);
	rqOmegaB = mizBuiltIn(env.builtIn, rqOmega);
	env.nonZeroTyp ::= if (rqElemB != 0 && rqOmegaB != 0) {
		mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(),
			rqElemB, mizNewTrmList(mizNewFuncTrm(rqOmegaB, mizNil), mizNil));
	} else {
		mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(),
			mizBuiltIn(env.builtIn, rqSetMode), mizNil);
	}
	mizInitRevReq(idn);

	// the registrations, then the environment round-up
	loader.clusters(env, cl);
	// NonZeroTyp upper cluster: non-zero (+ positive), rounded with the
	// loaded registrations (iocorrel.pas 3283-3294)
	nzCl = mizNewEmptyCluster();
	rqZeroB = mizBuiltIn(env.builtIn, rqZero);
	if (rqZeroB != 0) mizAttrCollInsert(env, nzCl, MizAttr(0, rqZeroB, mizNil, false, 0));
	rqPosB = mizBuiltIn(env.builtIn, rqPositive);
	if (rqElemB > 0 && rqOmegaB > 0 && rqPosB > 0) {
		mizAttrCollInsert(env, nzCl, MizAttr(1, rqPosB, mizNil, false, 0));
	}
	env.roundUpCluster(env, nzCl, env.nonZeroTyp);
	nzT = env.nonZeroTyp;
	nzT.upper ::= nzCl;
	mizEnvRoundUp(env, cl);

	stats = MizPrepStats(0, 0, 0, 0, 0, makeVector(8));
	x = mizXmlInitParsingFile(mmlDir + "/" + article + ".xml");
	r = mizMakeVrfReader(x, env);
	defs = mizMakeDefinientia();
	p = MizPrep(chk, r, makeVector(64), makeVector(64), None(), None(), makeTree(), defs, mizMakeSchemes(), 2, 0, 0, stats);
	loader.late(env, cl, idn, defs, p);
	chk.atomicExpansions ::= \f -> mizAtomicExpansions(env, defs, f);
	idn.equalsExpand ::= \idn2, funcNr, args -> mizEqualsExpandHook(defs, idn2, funcNr, args);
	if (getUrlParameterDef("dbg-nzt", "") == "1") {
		println("NZT before collect " + mizFullTyp2s(env.nonZeroTyp));
	}
	{
		md = s2i(getUrlParameterDef("dbg-modetyp", "0"));
		if (md > 0) {
			mc2 = mizConstr(env, coMode, md);
			println("MODE " + i2s(md) + " " + mc2.article + ":" + i2s(mc2.absNr)
				+ " resultTyp=" + (switch (mc2.typ) {
					Some(mt2): mizFullTyp2s(mt2);
					None(): "<none>";
				})
				+ " primaries=" + i2s(sizeVector(mc2.primaries)));
		}
	}
	// stdprep.pas InitPrepData 1214-1224, immediately before
	// CollectConstInEnvConstructors: every IDENTIFICATION's every primary type
	// has its UPPER cluster rebuilt from its LOWER one and rounded, with
	// LocArgTyp set to THAT identification's primaries so a locus inside the
	// type (`Element of the carrier of A3`) can be typed. Without it those
	// primaries keep an empty upper cluster, the EqArgs IsWiderThan guard of
	// CollectEqualsComst fails, and the identification never produces its
	// equal constant — the whole functor-identification family dies silently.
	iterVector(idn.identifications, \idf -> {
		mizSetLocArgTyp(env, idf.primaries);
		iterVector(idf.primaries, \pt -> {
			upper = mizCopyCluster(pt.lower);
			mizRoundUpCluster(env, cl, upper, pt);
			pt.upper ::= upper;
			// gTermCollection.FreeAll after EVERY primary: both caches are
			// keyed by term structure alone, and the next identification types
			// the same loci differently
			mizClearRoundMemo(cl);
			mizTTCollRelease(env, 0);
		});
	});

	mizCollectConstInEnvConstructors(env, idn, cl);
	if (getUrlParameterDef("dbg-nzt", "") == "1") {
		println("NZT after  collect " + mizFullTyp2s(env.nonZeroTyp));
		println("ENV constants interned: " + i2s(sizeVector(env.inferConstDef)));
		iteriVector(env.inferConstDef, \i, cd ->
			println("  ENVICD[" + i2s(i) + "] " + mizTrm2s(cd.def)
				+ " : " + mizFullTyp2s(cd.typ)));
	}

	mizXmlNextElementState(x);
	mizXmlAssert(x.nElName == "Article");
	mizXmlNextElementState(x);
	mizWalkItems(p);
	stats;
}


// stdprep.pas 1116 CollectConstInEnvConstructors, called from InitPrepData
// (stdprep.pas 1226) once the environment is loaded and the identifications'
// primary types are rounded. It turns every TERM sitting in the environment
// into an inference constant: the numeral type, every mode/functor/aggregate/
// selector result type, the struct prefixes, and each registration's
// consequent UPPER cluster. Without it the checker meets RAW functor terms in
// attribute arguments, and rounding one of those re-enters rounding for
// another — the surreal*/fomodel* stack overflow.
// The original deliberately does NOT collect the primary lists, the cluster
// types, the antecedents or the cluster terms (all commented out at 1139-1158).
mizCollectConstInEnvCluster(idn : MizIdentify, c : MizAttrColl) -> void {
	nc = mizCollectConstInCluster(idn, c);
	clearVector(c.items);
	iterVector(nc.items, \a -> pushVector(c.items, a));
	c.consistent ::= nc.consistent;
}

mizCollectConstInEnvConstructors(env : MizCorrelEnv, idn : MizIdentify,
		cl : MizClusters) -> void {
	// The first half (stdprep.pas 1119-1133): NonZeroTyp, every mode/functor/
	// aggregate/selector result type, and the struct prefixes.
	// `collect-types=0` turns it off for A/B runs; it is on by default because
	// the original always does it. It used to regress fdiff_10/fcont_1/sin_cos
	// (the InferConstDef strict-key bug) and then surrealn (the missing
	// Finish*Cluster re-rounding) — both fixed, and the stride is now
	// byte-identical with it on and off.
	if (getUrlParameterDef("collect-types", "") != "0") {
		mizCollectConstInTyp(idn, env.nonZeroTyp);
		// stdprep.pas 1120: ONE loop `for c := Low(ConstructorsKind) to High`,
		// so the kinds are visited in the ENUM's order — coMode, coStructMode
		// (its PREFIXES), coAttribute/coPredicate (skipped), coFunctor,
		// coSelector, coAggregate. The order decides the order the constants
		// are interned in, hence their NUMBERS, hence the order ProcessReductions
		// visits classes (it iterates DTrm) — and a reduction picks the FIRST
		// instantiation, so a different order really does give a different
		// class graph (newton05 836:72).
		iter([coMode, coStructMode, coAttribute, coPredicate,
				coFunctor, coSelector, coAggregate], \k ->
			iteriVector(env.constrs[k], \i, c ->
				if (i > 0) {
					if (k == coStructMode) {
						iterVector(c.prefixes, \t -> mizCollectConstInTyp(idn, t));
					} else if (k == coMode || k == coFunctor || k == coSelector
						|| k == coAggregate) {
						switch (c.typ) {
							Some(t): mizCollectConstInTyp(idn, t);
							None(): {}
						}
					}
				}
			)
		);
	}

	// The registrations' consequent UPPER clusters (stdprep.pas 1135-1159).
	// This is what stops the checker meeting RAW functor terms in attribute
	// arguments; rounding one of those re-enters rounding for another and the
	// recursion never ends (the surreal*/fomodel*/hilb10_1 stack overflows).
	// The original deliberately does NOT collect the primary lists, cluster
	// types, antecedents or cluster terms — all commented out at 1139-1158.
	if (getUrlParameterDef("collect-regs", "") != "0") {
		iterVector(cl.registered, \r -> mizCollectConstInEnvCluster(idn, r.consequent.upper));
		iterVector(cl.conditional, \c -> mizCollectConstInEnvCluster(idn, c.consequent.upper));
		iterVector(cl.functor, \f -> mizCollectConstInEnvCluster(idn, f.consequent.upper));
	}
}

// the environment Mizar's own accom wrote next to the .xml
mizFileEnvLoader(mmlDir : string, article : string) -> MizEnvLoader {
	MizEnvLoader(
		\env -> {
			r0 = mizMakeVrfReader(mizXmlInitParsing(""), env);
			mizLoadConstructors(r0, getFileContent(mmlDir + "/" + article + ".atr"));
			mizLoadRequirementsFile(env, mmlDir + "/" + article + ".ere");
		},
		\env, cl -> mizLoadClusters(env, cl, getFileContent(mmlDir + "/" + article + ".ecl")),
		\env, cl, idn, defs, p -> {
			mizLoadTheorems(p, getFileContent(mmlDir + "/" + article + ".eth"));
			mizLoadReductions(env, idn, getFileContent(mmlDir + "/" + article + ".erd"));
			mizLoadIdentifications(env, idn, getFileContent(mmlDir + "/" + article + ".eid"));
			mizLoadSchemes(p, getFileContent(mmlDir + "/" + article + ".esh"));
			mizLoadDefinientia(env, defs, mmlDir, article);
		});
}

mizCheckArticle(mmlDir : string, article : string) -> MizPrepStats {
	mizCheckArticleWith(mmlDir, article, mizFileEnvLoader(mmlDir, article));
}

mizSetLabeled(p : MizPrep, nr : int, f : MizFrm) -> void {
	while(\ -> sizeVector(p.labeled) <= nr, \ -> pushVector(p.labeled, None()));
	setVectorUnsafe(p.labeled, nr, Some(f));
}

mizGetLabeled(p : MizPrep, nr : int) -> Maybe<MizFrm> {
	switch (getVectorDef(p.labeled, nr, None())) {
		Some(f): Some(f);
		None(): getVectorDef(p.permLabeled, nr, None());
	}
}

// article-level labels: definition and theorem labels survive block exits
mizSetPermLabeled(p : MizPrep, nr : int, f : MizFrm) -> void {
	while(\ -> sizeVector(p.permLabeled) <= nr, \ -> pushVector(p.permLabeled, None()));
	setVectorUnsafe(p.permLabeled, nr, Some(f));
}

// read one Proposition element (already ON it); returns (labelNr, formula)
mizReadProposition(p : MizPrep) -> Pair<int, MizFrm> {
	x = p.r.x;
	nr = mizXmlIntAttrDef(x, "nr", 0);
	mizXmlNextElementState(x); // into the formula
	f = mizInFormula(p.r);
	// now at </Proposition>; advance
	mizXmlNextElementState(x);
	Pair(nr, f);
}

// a justification follows: By / From / Proof / SkippedProof.
// `claim` is the proposition being justified.
mizJustify(p : MizPrep, claim : MizFrm, posLine : int) -> void {
	env = p.chk.env;
	x = p.r.x;
	name = x.nElName;
	if (x.nState != MizEStart) {
		// no justification element (shouldn't happen) — nothing to do
	} else if (name == "By") {
		linked = mizXmlAttr(x, "linked") == "true";
		line = mizXmlIntAttrDef(x, "line", posLine);
		col = mizXmlIntAttrDef(x, "col", 0);
		premises : Vector<MizFrm> = makeVector(8);
		pushVector(premises, mizNewNeg(mizCopyFrm(claim)));
		if (linked) {
			switch (p.prev) {
				Some(pf): pushVector(premises, mizCopyFrm(pf));
				None(): {}
			}
		}
		mizXmlNextElementState(x);
		ok = ref true;
		while(\ -> x.nState == MizEStart, \ -> {
			if (x.nElName == "Ref") {
				nr = mizXmlIntAttrDef(x, "nr", 0);
				if (mizXmlHasAttr(x, "articlenr")) {
					art = mizXmlIntAttr(x, "articlenr");
					kindS = mizXmlAttr(x, "kind");
					kind = if (kindS == "T") kindT else kindD;
					switch (lookupTree(p.theorems, mizThKey(kind, art, nr))) {
						Some(f): pushVector(premises, mizCopyFrm(f));
						None(): ok := false; // unresolvable citation
					}
				} else {
					switch (mizGetLabeled(p, nr)) {
						Some(f): pushVector(premises, mizCopyFrm(f));
						None(): ok := false;
					}
				}
				mizXmlSkipElement(x);
			} else {
				mizXmlSkipElement(x);
			}
		});
		mizXmlNextElementState(x); // past </By>
		if (getUrlParameterDef("trace", "") == "1") {
			println("by at " + i2s(line) + ":" + i2s(col));
		}
		{ st1 = p.stats; st1.checked ::= st1.checked + 1; }
		if (^ok) {
			dbgLine = s2i(getUrlParameterDef("debug-line", "-1"));
			ck = p.chk;
			ck.debug ::= line == dbgLine;
			if (line == dbgLine) {
				println("=== premises at " + i2s(line) + ":" + i2s(col));
				iterVector(premises, \pf2 -> println("  " + mizFrm2s(pf2)));
				{
					env3 = p.chk.env;
					println("  FIXEDVAR n=" + i2s(env3.fixedVarNbr) + " "
						+ strGlue(map(enumFromTo(1, env3.fixedVarNbr), \k -> {
							fv4 : MizFixedVar = getVectorUnsafe(env3.fixedVar, k);
							"c" + i2s(k) + (switch (fv4.def) {
								Some(dd): "=" + mizTrm2s(dd);
								None(): "";
							});
						}), " "));
				}
			}
			t0chk = timestamp();
			clP = p.chk.clusters;
			rc0 = clP.nRoundCluster;
			rt0 = clP.nRoundTrmType;
			tr0 = clP.nTryRounding;
			clP.roundMaxDepth ::= 0;
			mizInferenceChecker(p.chk, premises);
			if (line == dbgLine && getUrlParameterDef("dbg-icd", "") == "1") {
				// the InferConstDef table as the inference left it, printed in the
				// original's own `InferConstDef[i] <def>` / [lower][upper]M layout,
				// so the -dMDEBUG .inf trace diffs against it line by line
				iteriVector(p.chk.env.inferConstDef, \i, cd ->
					println("  ICD[" + i2s(i) + "] "
						+ (switch (mizNumericValue(p.chk.idn, i)) {
							Some(nv): "(" + mizCplx2s(nv) + ") ";
							None(): "";
						})
						+ mizTrm2s(cd.def)
						+ "\n    " + mizFullTyp2s(cd.typ)));
			}
			dtchk = timestamp() - t0chk;
			if (dtchk > 200.0 && getUrlParameterDef("trace", "") == "2") {
				println("SLOW " + i2s(line) + ":" + i2s(col) + " " + d2s(dtchk)
					+ "ms roundCluster=" + i2s(clP.nRoundCluster - rc0)
					+ " roundTrmType=" + i2s(clP.nRoundTrmType - rt0)
					+ " maxRoundDepth=" + i2s(clP.roundMaxDepth));
			}
			ck.debug ::= false;
			if (mizSeqCount(p.chk.chErrNr) == 0) {
				{ st2 = p.stats; st2.accepted ::= st2.accepted + 1; }
			} else {
				{ st3 = p.stats; st3.failed ::= st3.failed + 1; }
				errs = fold(enumFromTo(0, mizSeqCount(p.chk.chErrNr) - 1), "",
					\acc, i -> acc + " " + i2s(mizSeqValue(p.chk.chErrNr, i)));
				pushVector(p.stats.failures, i2s(line) + ":" + i2s(col) + errs);
			}
		} else {
			{ st4 = p.stats; st4.failed ::= st4.failed + 1; }
			pushVector(p.stats.failures, i2s(line) + ":" + i2s(col) + " unresolved-ref");
		}
	} else if (name == "From") {
		// scheme justification: match [claim, premise*] against the scheme
		artF = mizXmlIntAttrDef(x, "articlenr", 0);
		nrF = mizXmlIntAttrDef(x, "nr", 0);
		lineF = mizXmlIntAttrDef(x, "line", posLine);
		colF = mizXmlIntAttrDef(x, "col", 0);
		snts = ref [mizCopyFrm(claim)];
		okF = ref true;
		mizXmlNextElementState(x);
		while(\ -> x.nState == MizEStart, \ -> {
			if (x.nElName == "Ref") {
				nr2 = mizXmlIntAttrDef(x, "nr", 0);
				if (mizXmlHasAttr(x, "articlenr")) {
					art2 = mizXmlIntAttr(x, "articlenr");
					kindS2 = mizXmlAttr(x, "kind");
					kind2 = if (kindS2 == "T") kindT else kindD;
					switch (lookupTree(p.theorems, mizThKey(kind2, art2, nr2))) {
						Some(f): snts := arrayPush(^snts, mizCopyFrm(f));
						None(): okF := false;
					}
				} else {
					switch (mizGetLabeled(p, nr2)) {
						Some(f): snts := arrayPush(^snts, mizCopyFrm(f));
						None(): okF := false;
					}
				}
				mizXmlSkipElement(x);
			} else {
				mizXmlSkipElement(x);
			}
		});
		mizXmlNextElementState(x);
		{ st5 = p.stats; st5.checked ::= st5.checked + 1; }
		schemeM = mizSchemeFind(p.schemes, artF, nrF);
		errPair = if (^okF) {
			switch (schemeM) {
				Some(sch): mizSchematizeErr(p.chk.env, p.chk.clusters, sch, ^snts);
				None(): Pair(-1, -1);
			}
		} else {
			Pair(-2, -1);
		}
		if (errPair.first == 0) {
			{ st5a = p.stats; st5a.accepted ::= st5a.accepted + 1; }
		} else {
			{ st5f = p.stats; st5f.failed ::= st5f.failed + 1; }
			why = if (errPair.first == -2) " from-unresolved-ref"
				else if (errPair.first == -1) " from-missing-scheme"
				else " from-mismatch err=" + i2s(errPair.first)
					+ " snt=" + i2s(errPair.second);
			pushVector(p.stats.failures, i2s(lineF) + ":" + i2s(colF) + why);
		}
	} else if (name == "Proof" || name == "PerCasesReasoning") {
		// PerCasesReasoning as a justification: CaseBlock/SupposeBlock items
		// and the final PerCases split — all handled by the item walker
		mizWalkBlock(p, if (name == "Proof") relTruncate else relFreeConst);
	} else if (name == "SkippedProof") {
		mizXmlSkipElement(x);
	} else {
		// unknown justification
		{ st6 = p.stats; st6.skippedBlocks ::= st6.skippedBlocks + 1; }
		mizXmlSkipElement(x);
	}
}

// The block-exit release of InferConstDef (stdprep.pas 497-570). A block marks
// the collection on entry (StdBlockObj.Init 228) and releases on exit, and the
// release is BLOCK-KIND SPECIFIC:
//   relNone      — not a block of the original at all, keep everything
//   relTruncate  — FinishMain/Notation/Case/Suppose/CaseList/Proof: plain
//                  FreeItemsFrom(mark)
//   relFreeConst — FinishDefinition/Registration/Diffuse: FreeConstDef, which
//                  KEEPS every constant at or above the mark whose definition
//                  and type do NOT mention a variable local to the block
//                  (transitively — the scan restarts whenever a new
//                  local-dependent constant is found), disposes the rest,
//                  RENUMBERS the survivors and rewrites every reference.
relNone = 0;
relTruncate = 1;
relFreeConst = 2;

// FreeConstDef (stdprep.pas 415-480)
mizFreeConstDef(p : MizPrep, varNbrBase : int, mark : int) -> void {
	env = p.chk.env;
	idn = p.chk.idn;
	n = sizeVector(env.inferConstDef);
	if (mark >= n) {
		mizInferRelease(idn, mark);
		mizClearRoundMemo(p.chk.clusters);
		mizTTCollRelease(p.chk.env, 0);
	} else {
		// 1. which of the constants from `mark` on are LOCAL to the block?
		local : ref [bool] = ref map(enumFromTo(0, n - 1), \__ -> false);
		occ = ref false;
		checkW = mizMakeWithin(\__, t -> {
			switch (t) {
				MizVarTrm(srt, varNr, __, __): {
					if (srt == ikTrmConstant) {
						if (varNr > varNbrBase) occ := true;
					} else if (srt == ikTrmInfConst) {
						if (varNr >= 0 && varNr < n && ^local[varNr]) occ := true;
					}
					t;
				}
				default: t;
			}
		});
		i = ref mark;
		while(\ -> ^i < n, \ -> {
			if (^local[^i]) {
				i := ^i + 1;
			} else {
				cd : MizConstDef = getVectorUnsafe(env.inferConstDef, ^i);
				occ := false;
				__c1 = mizWithinTrm(checkW, cd.def);
				if (!^occ) mizWithinTyp(checkW, cd.typ);
				if (^occ) {
					local := replace(^local, ^i, true);
					i := mark;          // the original restarts the scan
				} else {
					i := ^i + 1;
				}
			}
		});
		// 2. keep the survivors in order, recording old -> new
		renum = ref makeTree();
		survivors : Vector<MizConstDef> = makeVector(n - mark);
		numerics : Vector<Maybe<MizCplx>> = makeVector(n - mark);
		fori(mark, n - 1, \k -> {
			if (!^local[k]) {
				renum := setTree(^renum, k, mark + sizeVector(survivors));
				pushVector(survivors, getVectorUnsafe(env.inferConstDef, k));
				pushVector(numerics, mizNumericValue(idn, k));
			}
		});
		renumW = mizMakeWithin(\__, t -> {
			switch (t) {
				MizVarTrm(srt, varNr, __, __): {
					if (srt == ikTrmInfConst) {
						switch (lookupTree(^renum, varNr)) {
							Some(nn): { vt = mizPrepAsVar(t); vt.varNr ::= nn; }
							None(): {}
						}
					}
					t;
				}
				default: t;
			}
		});
		// 3. renumber the survivors' own definitions and types FIRST — the
		// definition is the search key, so it must be final before the entry
		// goes back into the sorted index
		iterVector(survivors, \cd -> {
			__c2 = mizWithinTrm(renumW, cd.def);
			mizWithinTyp(renumW, cd.typ);
		});
		if (getUrlParameterDef("dbg-free", "") == "1") {
			println("FREECONST mark=" + i2s(mark) + " varBase=" + i2s(varNbrBase)
				+ " n=" + i2s(n) + " kept=" + i2s(sizeVector(survivors))
				+ " [" + strGlue(map(vector2array(survivors), \cdS -> mizTrm2s(cdS.def)), " ") + "]");
		}
		mizInferRelease(idn, mark);
		mizClearRoundMemo(p.chk.clusters);
		mizTTCollRelease(p.chk.env, 0);
		// re-add each survivor THROUGH THE INDEX. Dropping this is what makes
		// the same fixed variable collect twice: the entry is in
		// inferConstDef but invisible to mizInferSearch, so the next
		// occurrence allocates a fresh constant and nothing matches any more.
		iteriVector(survivors, \si, cd -> {
			nr = sizeVector(env.inferConstDef);
			ps = mizInferSearch(idn, cd.def);
			pushVector(env.inferConstDef, cd);
			mizVectorAtInsert(idn.sortedIdx, ps.second, nr);
			mizSetNumeric(idn, nr, getVectorUnsafe(numerics, si));
		});
		// 4. the equal-constant lists, over the WHOLE table
		cnt = sizeVector(env.inferConstDef);
		fori(0, cnt - 1, \k -> {
			cd : MizConstDef = getVectorUnsafe(env.inferConstDef, k);
			changed = ref false;
			fori(0, mizNatCount(cd.eqConst) - 1, \j -> {
				if (containsKeyTree(^renum, mizNatItem(cd.eqConst, j).x)) changed := true;
			});
			if (^changed) {
				fresh = mizInitNatSet(4);
				fori(0, mizNatCount(cd.eqConst) - 1, \j -> {
					v = mizNatItem(cd.eqConst, j).x;
					switch (lookupTree(^renum, v)) {
						Some(nn): mizNatInsertElem(fresh, nn);
						None(): if (v < cnt) mizNatInsertElem(fresh, v);
					}
				});
				mizNatDeleteAll(cd.eqConst);
				mizNatEnlargeBy(cd.eqConst, fresh);
			}
		});
		// 5. the block's own output: the diffuse thesis (FinishDiffuse 566).
		// The defined constructors and registered clusters (FinishDefinition
		// 507-523, FinishRegistration 532-533) are already installed in the
		// environment by the loader and carry no inference constants here.
		switch (p.lastBlockThesis) {
			Some(th): mizWithinFrm(renumW, th);
			None(): {}
		}
	}
}

// ExpandInferConsts (correl.pas 4288), the inverse of the collection: replace
// every inference constant by a COPY of its definition, shifting the copied
// term's bound variables by the current binder depth (FrRenBound). The
// original applies it to a PUBLIC SCHEME's stored types and formulas at
// FinishPublicScheme (stdprep.pas 674-680) — with IncBounVarNbr on — and only
// then frees the block's constants. Without it the scheme keeps references to
// constants that the release has just dropped.
mizExpandInferConstsW(env : MizCorrelEnv) -> MizWithin {
	w = MizWithin(\ww, t -> {
		switch (t) {
			MizVarTrm(srt, varNr, __, __): {
				if (srt == ikTrmInfConst && varNr < sizeVector(env.inferConstDef)) {
					cd : MizConstDef = getVectorUnsafe(env.inferConstDef, varNr);
					lTrm = mizCopyTrm(cd.def);
					base = ww.boundVarNbr;
					if (base != 0) {
						shift = mizMakeWithin(\__, t2 -> {
							switch (t2) {
								MizVarTrm(s2, v2, __, __): {
									if (s2 == ikTrmBound) {
										vt = mizPrepAsVar(t2);
										vt.varNr ::= v2 + base;
									}
									t2;
								}
								default: t2;
							}
						});
						__sh = mizWithinTrm(shift, lTrm);
						{}
					}
					// the definition may itself mention inference constants
					mizWithinTrm(ww, lTrm);
				} else {
					t;
				}
			}
			default: t;
		}
	}, true, 0);   // IncBounVarNbr := true
	w;
}

mizPrepAsVar(t : MizTrm) -> MizVarTrm {
	switch (t) { MizVarTrm(__, __, __, __): t; default: { mizRunTimeError(2901); MizVarTrm(ikError, 0, 0, 0); } }
}

// THE ROUNDED-TYPE MEMO IS KEYED BY TERM STRUCTURE ALONE (roundcl.flow), and
// `D26` means a different constant after a release — so every release must
// invalidate it. Without this a term interned in one block hands its rounded
// type to a structurally identical term in the next, whose argument constant
// now has a STRONGER type: gtarski1's `the carrier of N` kept a bare `set`
// where the registration gives `non empty set`.
mizReleaseBlock(p : MizPrep, kind : int, varMark : int, infMark : int) -> void {
	if (kind == relTruncate) {
		mizInferRelease(p.chk.idn, infMark);
		mizClearRoundMemo(p.chk.clusters);
		mizTTCollRelease(p.chk.env, 0);
	} else if (kind == relFreeConst) {
		mizFreeConstDef(p, varMark, infMark);
	}
}

// walk a Proof/Now/CaseBlock-style block: save scope, process items, restore
mizWalkBlock(p : MizPrep, relKind : int) -> void {
	env = p.chk.env;
	x = p.r.x;
	fixedMark = env.fixedVarNbr;
	labelMark = sizeVector(p.labeled);
	prevMark = p.prev;
	locFuncMark = sizeVector(env.locFuncDef);
	infMark = sizeVector(env.inferConstDef);
	mizXmlNextElementState(x); // into the block
	mizWalkItems(p);
	// at </block>; advance
	mizXmlNextElementState(x);
	while(\ -> sizeVector(env.locFuncDef) > locFuncMark,
		\ -> removeVector(env.locFuncDef, sizeVector(env.locFuncDef) - 1));
	mizReleaseBlock(p, relKind, fixedMark, infMark);
	env.fixedVarNbr ::= fixedMark;
	while(\ -> sizeVector(p.labeled) > labelMark,
		\ -> removeVector(p.labeled, sizeVector(p.labeled) - 1));
	p.prev ::= prevMark;
}

// ---------------- the walk-time collection (stdprep.pas 256-288) ----------
// StdBlockObj gives the parser six hooks — ProcessProposition, ProcessFormula,
// ProcessTerm, ProcessType, ProcessTypeList, ProcessIterSteps — and each one
// collects the inference constants of the element that was just read
// (prephan.pas 363/372/379/386/395/414). Two consequences, and the SECOND is
// the one that matters:
//   * the constants accumulate across the article, so a later inference meets
//     terms that are already hash-consed together;
//   * the collection REWRITES THE ELEMENT IN PLACE. A fixed variable's stored
//     definition therefore loses its raw sub-terms — a Fraenkel inside it
//     becomes an interned constant — and only then does the closed-ness test
//     (`VarNr <= BoundVarNbr`) see it as closed at a nested depth.
// The original resets BoundVarNbr to 0 before each collection: these are
// top-level elements, nothing is bound around them.
mizPrepCollectFrm(p : MizPrep, f : MizFrm) -> void {
	env = p.chk.env;
	saved = env.boundVarNbr;
	env.boundVarNbr ::= 0;
	mizCollectConstInFrm(p.chk.idn, f);
	env.boundVarNbr ::= saved;
}

mizPrepCollectTrm(p : MizPrep, t : MizTrm) -> MizTrm {
	env = p.chk.env;
	saved = env.boundVarNbr;
	env.boundVarNbr ::= 0;
	res = mizCollectConstInTrm(p.chk.idn, t);
	env.boundVarNbr ::= saved;
	res;
}

mizPrepCollectTyp(p : MizPrep, typ : MizTyp) -> void {
	env = p.chk.env;
	saved = env.boundVarNbr;
	env.boundVarNbr ::= 0;
	mizCollectConstInTyp(p.chk.idn, typ);
	env.boundVarNbr ::= saved;
}

// push a fixed constant with the given type
mizPushFixed(p : MizPrep, typ : MizTyp) -> void {
	env = p.chk.env;
	env.fixedVarNbr ::= env.fixedVarNbr + 1;
	while(\ -> sizeVector(env.fixedVar) <= env.fixedVarNbr,
		\ -> pushVector(env.fixedVar, MizFixedVar(0, mizNewIncorTyp(), false, None(), 0)));
	fv : MizFixedVar = getVectorUnsafe(env.fixedVar, env.fixedVarNbr);
	fv.typ ::= typ;
	fv.def ::= None();
	if (getUrlParameterDef("dbg-fix", "") == "1") {
		println("PUSHFIX c" + i2s(env.fixedVarNbr) + " " + mizFullTyp2s(typ));
	}
}

// process the items of the current level until the enclosing end tag
mizWalkItems(p : MizPrep) -> void {
	env = p.chk.env;
	x = p.r.x;
	while(\ -> x.nState == MizEStart && x.nCurTokenKind != MizXTEOTX, \ -> {
		name = x.nElName;
		if (name == "Proposition") {
			pr = mizReadProposition(p);
			mizPrepCollectFrm(p, pr.second);   // ProcessProposition
			mizJustify(p, pr.second, 0);
			if (pr.first > 0) mizSetLabeled(p, pr.first, pr.second);
			p.prev ::= Some(pr.second);
		} else if (name == "JustifiedTheorem") {
			mizXmlNextElementState(x);
			// Proposition + justification (or SkippedProof)
			if (x.nState == MizEStart && x.nElName == "Proposition") {
				pr = mizReadProposition(p);
				mizPrepCollectFrm(p, pr.second);   // ProcessProposition
				mizJustify(p, pr.second, 0);
				p.ownTheoremNr ::= p.ownTheoremNr + 1;
				p.theorems ::= setTree(p.theorems,
					mizThKey(kindT, p.ownArticleNr, p.ownTheoremNr), pr.second);
				if (pr.first > 0) mizSetPermLabeled(p, pr.first, pr.second);
				// a theorem's statement IS a quotable proposition
				// (StdItemObj.FinishQuotableProposition, stdprep.pas 1331), so
				// the NEXT item's `then` links to it (MPropList.GetPrevProp)
				p.prev ::= Some(pr.second);
			}
			// consume the rest of the JustifiedTheorem element
			while(\ -> x.nState == MizEStart, \ -> mizXmlSkipElement(x));
			mizXmlNextElementState(x);
		} else if (name == "DefTheorem") {
			p.ownDefNr ::= p.ownDefNr + 1;
			mizXmlNextElementState(x);
			if (x.nState == MizEStart && x.nElName == "Proposition") {
				pr = mizReadProposition(p);
				mizPrepCollectFrm(p, pr.second);   // ProcessProposition
				p.theorems ::= setTree(p.theorems,
					mizThKey(kindD, p.ownArticleNr, p.ownDefNr), pr.second);
				if (pr.first > 0) mizSetPermLabeled(p, pr.first, pr.second);
				p.prev ::= Some(pr.second);
			}
			while(\ -> x.nState == MizEStart, \ -> mizXmlSkipElement(x));
			mizXmlNextElementState(x);
		} else if (name == "Let") {
			n = mizXmlIntAttrDef(x, "nr", 1);
			mizXmlNextElementState(x);
			while(\ -> x.nState == MizEStart && x.nElName == "Typ", \ -> {
				typ = mizInType(p.r);
				mizPrepCollectTyp(p, typ);   // ProcessType
				mizPushFixed(p, typ);
			});
			while(\ -> x.nState == MizEStart, \ -> mizXmlSkipElement(x));
			mizXmlNextElementState(x);
		} else if (name == "Assume") {
			mizXmlNextElementState(x);
			while(\ -> x.nState == MizEStart, \ -> {
				if (x.nElName == "Proposition") {
					pr = mizReadProposition(p);
					mizPrepCollectFrm(p, pr.second);   // ProcessProposition
					if (pr.first > 0) mizSetLabeled(p, pr.first, pr.second);
					p.prev ::= Some(pr.second);
				} else {
					mizXmlSkipElement(x);
				}
			});
			mizXmlNextElementState(x);
		} else if (name == "Consider" || name == "Given") {
			// Consider: the existence Proposition is JUSTIFIED; Given
			// (existential assumption) has NO justification after it
			// (Parse_ExistentialAssumption)
			justified = name == "Consider";
			mizXmlNextElementState(x);
			if (x.nState == MizEStart && x.nElName == "Proposition") {
				pr = mizReadProposition(p);
				mizPrepCollectFrm(p, pr.second);   // ProcessProposition
				if (justified) mizJustify(p, pr.second, 0);
			}
			// new constants + assumed property propositions
			while(\ -> x.nState == MizEStart, \ -> {
				if (x.nElName == "Typ") {
					typ = mizInType(p.r);
					mizPrepCollectTyp(p, typ);   // ProcessType
					mizPushFixed(p, typ);
				} else if (x.nElName == "Proposition") {
					pr2 = mizReadProposition(p);
					mizPrepCollectFrm(p, pr2.second);   // ProcessProposition
					if (pr2.first > 0) mizSetLabeled(p, pr2.first, pr2.second);
					p.prev ::= Some(pr2.second);
				} else {
					mizXmlSkipElement(x);
				}
			});
			mizXmlNextElementState(x);
		} else if (name == "Reconsider") {
			// (Typ Term)+ Proposition Justification: each pair makes a new
			// constant of the given type whose definition is the term; the
			// typing proposition is justified (Parse_Reconsidering +
			// StdItemObj.Start/FinishReconsideredTerm)
			mizXmlNextElementState(x);
			while(\ -> x.nState == MizEStart && x.nElName == "Typ", \ -> {
				typ = mizInType(p.r);
				mizPrepCollectTyp(p, typ);   // ProcessType
				mizPushFixed(p, typ);
				trm = mizPrepCollectTrm(p, mizInTerm(p.r));   // ProcessTerm
				fv : MizFixedVar = getVectorUnsafe(env.fixedVar, env.fixedVarNbr);
				fv.def ::= Some(trm);
			});
			if (x.nState == MizEStart && x.nElName == "Proposition") {
				pr = mizReadProposition(p);
				mizPrepCollectFrm(p, pr.second);   // ProcessProposition
				mizJustify(p, pr.second, 0);
			}
			while(\ -> x.nState == MizEStart, \ -> mizXmlSkipElement(x));
			mizXmlNextElementState(x);
		} else if (name == "TakeAsVar") {
			// take c = t: Typ Term — a new constant of the type with the
			// term as its definition (Start/FinishExemplifyingTerm)
			mizXmlNextElementState(x);
			typ3 = mizInType(p.r);
			mizPrepCollectTyp(p, typ3);   // ProcessType
			mizPushFixed(p, typ3);
			trm3 = mizPrepCollectTrm(p, mizInTerm(p.r));   // ProcessTerm
			fv3 : MizFixedVar = getVectorUnsafe(env.fixedVar, env.fixedVarNbr);
			fv3.def ::= Some(trm3);
			while(\ -> x.nState == MizEStart, \ -> mizXmlSkipElement(x));
			mizXmlNextElementState(x);
		} else if (name == "Set") {
			// set c = t: Term Typ — a new constant of the type; the term was
			// already expanded by the analyzer (FinishConstantDefinition:
			// "the term is ignored", nDef stays nil)
			mizXmlNextElementState(x);
			__trm = mizPrepCollectTrm(p, mizInTerm(p.r));   // ProcessTerm
			typ2 = mizInType(p.r);
			mizPrepCollectTyp(p, typ2);   // ProcessType
			mizPushFixed(p, typ2);
			while(\ -> x.nState == MizEStart, \ -> mizXmlSkipElement(x));
			mizXmlNextElementState(x);
		} else if (name == "Conclusion") {
			mizXmlNextElementState(x);
			mizWalkItems(p);
			mizXmlNextElementState(x);
		} else if (name == "Now") {
			// diffuse block: its BlockThesis becomes the labeled fact
			labelNr = mizXmlIntAttrDef(x, "nr", 0);
			env2 = p.chk.env;
			fixedMark = env2.fixedVarNbr;
			labelMark = sizeVector(p.labeled);
			prevMark = p.prev;
			locFuncMark2 = sizeVector(env2.locFuncDef);
			infMark2 = sizeVector(env2.inferConstDef);
			mizXmlNextElementState(x);
			p.lastBlockThesis ::= None();
			mizWalkItems(p);
			mizXmlNextElementState(x);
			// StdBlockObj.FinishBlock (stdprep.pas 493) truncates LocFuncDef
			// for EVERY block kind, the diffuse one included
			while(\ -> sizeVector(env2.locFuncDef) > locFuncMark2,
				\ -> removeVector(env2.locFuncDef, sizeVector(env2.locFuncDef) - 1));
			// FinishDiffuse (stdprep.pas 564): FreeConstDef, then the block's
			// THESIS is rewritten with the new constant numbers
			mizReleaseBlock(p, relFreeConst, fixedMark, infMark2);
			env2.fixedVarNbr ::= fixedMark;
			while(\ -> sizeVector(p.labeled) > labelMark,
				\ -> removeVector(p.labeled, sizeVector(p.labeled) - 1));
			p.prev ::= prevMark;
			switch (p.lastBlockThesis) {
				Some(th): {
					if (labelNr > 0) mizSetLabeled(p, labelNr, th);
					p.prev ::= Some(th);
				}
				None(): {}
			}
			p.lastBlockThesis ::= None();
		} else if (name == "Proof") {
			mizWalkBlock(p, relTruncate);   // FinishProof
		} else if (name == "BlockThesis") {
			// a Now's BlockThesis = per-item <Thesis> entries, then the block
			// formula LAST; a Proof's = the formula directly. Take the final
			// formula child.
			mizXmlNextElementState(x);
			while(\ -> x.nState == MizEStart, \ -> {
				if (mizIsFrmEl(x.nElName)) {
					bt = mizInFormula(p.r);
					mizPrepCollectFrm(p, bt);   // ProcessFormula
					p.lastBlockThesis ::= Some(bt);
				} else {
					mizXmlSkipElement(x);
				}
			});
			mizXmlNextElementState(x);
		} else if (name == "Thesis"
			|| name == "ThesisExpansions" || name == "EndPosition"
			|| name == "Take" || name == "Reservation"
			|| name == "Section" || name == "DefPred"
			|| name == "SkippedProof") {
			mizXmlSkipElement(x);
		} else if (name == "DefFunc") {
			// deffunc F(args) = term: a private functor with its result type
			// (FinishPrivFuncDefinition -> LocFuncDef)
			mizXmlNextElementState(x);
			argsD = if (x.nState == MizEStart && x.nElName == "ArgTypes") {
				mizInArgColl(p.r);
			} else {
				makeVector(0);
			}
			trmD = mizInTerm(p.r);
			typD = mizInType(p.r);
			pushVector(env.locFuncDef, MizFuncDef(0, argsD, trmD, typD));
			while(\ -> x.nState == MizEStart, \ -> mizXmlSkipElement(x));
			mizXmlNextElementState(x);
		} else if (name == "Constructor") {
			c = mizInConstructor1(p.r);
			__nr = mizPushConstr(p.chk.env, c);
			{}
		} else if (name == "RCluster" || name == "CCluster" || name == "FCluster") {
			// the article's own registration: Finish*Cluster re-rounds the
			// constants collected before this point (stdprep.pas 969/1035/1084)
			switch (mizReadClusterVal(p.r)) {
				Some(c): {
					// StdBlockObj.ProcessRCluster / ProcessCCluster /
					// ProcessFCluster (stdprep.pas 328/341/355): the article's
					// OWN registration has the constants of its consequent
					// UPPER cluster collected — IN PLACE — as it is read. The
					// environment pass (CollectConstInEnvConstructors) cannot
					// do it: these clusters do not exist yet at that point.
					// Without it the consequent keeps a RAW functor term where
					// every eq class holds the interned constant, so
					// LocateTerm never finds the class and the registration
					// silently fails to fire (fomodel2 2234:52).
					switch (c) {
						MizRCluster(__, __, __, cons, __): mizCollectConstInEnvCluster(p.chk.idn, cons.upper);
						MizCCluster(__, __, __, __, cons, __): mizCollectConstInEnvCluster(p.chk.idn, cons.upper);
						MizFCluster(__, __, __, cons, __, __): mizCollectConstInEnvCluster(p.chk.idn, cons.upper);
					}
					if (getUrlParameterDef("dbg-icreate", "") != "") {
						println("DECLCLUSTER " + (switch (c) {
							MizRCluster(ar, an, __, __, __): "R " + ar + ":" + i2s(an);
							MizCCluster(ar, an, __, __, __, __): "C " + ar + ":" + i2s(an);
							MizFCluster(ar, an, __, __, __, __): "F " + ar + ":" + i2s(an);
						}));
					}
					mizDeclareCluster(p.chk.env, p.chk.clusters, p.chk.idn, c);
					// a new registration changes what RoundUpTrmType computes
					// for EVERY term — neither cache can survive it
					mizClearRoundMemo(p.chk.clusters);
					mizTTCollRelease(p.chk.env, 0);
				}
				None(): {}
			}
		} else if (name == "Reduction") {
			mizReadOneReduction(p.chk.idn, p.r);
		} else if (name == "Identify") {
			idnBefore = sizeVector(p.chk.idn.identifications);
			mizReadOneIdentify(p.chk.idn, p.r);
			// FinishIdentify's retroactive pass (stdprep.pas 922-952)
			if (sizeVector(p.chk.idn.identifications) > idnBefore) {
				mizIdentifyRetrofit(p.chk.idn,
					getVectorUnsafe(p.chk.idn.identifications,
						sizeVector(p.chk.idn.identifications) - 1));
			}
		} else if (name == "DefinitionBlock" || name == "RegistrationBlock"
			|| name == "NotationBlock" || name == "Registration"
			|| name == "Definition" || name == "JustifiedProperty"
			|| name == "Coherence" || name == "Existence" || name == "Uniqueness"
			|| name == "Compatibility" || name == "Correctness"
			|| name == "CaseBlock" || name == "SupposeBlock"
			|| name == "ReductionRegistration" || name == "Reducibility"
			|| name == "IdentifyRegistration" || name == "Compatibility") {
			// walk inside: these contain items/justifications of the same shape.
			// Only the ones that ARE blocks of the original release; the
			// correctness-condition wrappers are not blocks and keep everything.
			relKind = if (name == "DefinitionBlock" || name == "Definition"
					|| name == "RegistrationBlock" || name == "Registration"
					|| name == "ReductionRegistration"
					|| name == "IdentifyRegistration") relFreeConst
				else if (name == "NotationBlock" || name == "CaseBlock"
					|| name == "SupposeBlock") relTruncate
				else relNone;
			mizWalkBlock(p, relKind);
		} else if (name == "Definiens") {
			// the article's own definientia arrive inline; equals-definitions
			// feed the equals-expansion, the rest the atom expansion pool
			d = mizInDefiniens(p.r);
			pushVector(p.defs.all, d);
			pushVector(p.defs.expansions, d);
			switch (mizEqualsExpansionPub(p.chk.env, d)) {
				Some(ed): {
					key = d.constrNr;
					// StdItemObj.FinishDefiniens (stdprep.pas 870-903): the
					// self-reference guard, then the RETROACTIVE expansion of
					// every constant collected for this functor BEFORE the
					// definition was read, and only then the registration.
					selfRef = mizEqualsDefSelfRef(p.chk.env, key, ed);
					if (getUrlParameterDef("dbg-defs", "") == "1") {
						println("DEFINIENS K" + i2s(key) + " selfRef=" + b2s(selfRef));
					}
					if (!selfRef) mizEqualsDefRetrofit(p.chk.idn, key, ed);
					cur = lookupTreeDef(p.defs.equalsBy, key, []);
					df = p.defs;
					if (!selfRef) df.equalsBy ::= setTree(df.equalsBy, key, arrayPush(cur, ed));
				}
				None(): {}
			}
		} else if (name == "IterEquality") {
			// A = T1 by ... .= T2 by ... : each step justifies T(i-1) = Ti; the
			// whole yields A = Tlast as the (labeled) fact
			labelNr = mizXmlIntAttrDef(x, "nr", 0);
			mizXmlNextElementState(x);
			t0 = mizPrepCollectTrm(p, mizInTerm(p.r));   // ProcessTerm
			cur = ref t0;
			// ProcessIterSteps collects every step's equated term; the original
			// does it once after the whole list is parsed, which is equivalent
			// because each step's term is independent
			while(\ -> x.nState == MizEStart && x.nElName == "IterStep", \ -> {
				mizXmlNextElementState(x);
				ti = mizPrepCollectTrm(p, mizInTerm(p.r));
				stepClaim = mizNewEqFrm(p.chk.env, mizCopyTrm(^cur), mizCopyTrm(ti));
				mizJustify(p, stepClaim, 0);
				cur := ti;
				// consume to </IterStep>
				while(\ -> x.nState == MizEStart, \ -> mizXmlSkipElement(x));
				mizXmlNextElementState(x);
			});
			while(\ -> x.nState == MizEStart, \ -> mizXmlSkipElement(x));
			mizXmlNextElementState(x);
			resultF = mizNewEqFrm(p.chk.env, t0, ^cur);
			if (labelNr > 0) mizSetLabeled(p, labelNr, resultF);
			p.prev ::= Some(resultF);
		} else if (name == "Case" || name == "Suppose") {
			// the case assumption(s): quotable (labeled) propositions
			mizXmlNextElementState(x);
			while(\ -> x.nState == MizEStart, \ -> {
				if (x.nElName == "Proposition") {
					prC = mizReadProposition(p);
					mizPrepCollectFrm(p, prC.second);   // ProcessProposition
					if (prC.first > 0) mizSetLabeled(p, prC.first, prC.second);
					p.prev ::= Some(prC.second);
				} else {
					mizXmlSkipElement(x);
				}
			});
			mizXmlNextElementState(x);
		} else if (name == "PerCases") {
			// the case-split disjunction with its justification
			mizXmlNextElementState(x);
			if (x.nState == MizEStart && x.nElName == "Proposition") {
				prS = mizReadProposition(p);
				mizPrepCollectFrm(p, prS.second);   // ProcessProposition
				mizJustify(p, prS.second, 0);
			}
			while(\ -> x.nState == MizEStart, \ -> mizXmlSkipElement(x));
			mizXmlNextElementState(x);
		} else if (name == "PerCasesReasoning") {
			// diffuse per-cases item: like Now, the trailing BlockThesis is
			// the labeled fact
			labelNrP = mizXmlIntAttrDef(x, "nr", 0);
			envP = p.chk.env;
			fixedMarkP = envP.fixedVarNbr;
			labelMarkP = sizeVector(p.labeled);
			prevMarkP = p.prev;
			infMarkP = sizeVector(envP.inferConstDef);
			mizXmlNextElementState(x);
			p.lastBlockThesis ::= None();
			mizWalkItems(p);
			mizXmlNextElementState(x);
			mizReleaseBlock(p, relFreeConst, fixedMarkP, infMarkP);
			envP.fixedVarNbr ::= fixedMarkP;
			while(\ -> sizeVector(p.labeled) > labelMarkP,
				\ -> removeVector(p.labeled, sizeVector(p.labeled) - 1));
			p.prev ::= prevMarkP;
			switch (p.lastBlockThesis) {
				Some(thP): {
					if (labelNrP > 0) mizSetLabeled(p, labelNrP, thP);
					p.prev ::= Some(thP);
				}
				None(): {}
			}
			p.lastBlockThesis ::= None();
		} else if (name == "SchemeBlock") {
			// the article's own scheme: functor result types, premises, the
			// statement with its (checked) proof; registered for `from`
			schemeNr = mizXmlIntAttrDef(x, "schemenr", 0);
			envS = p.chk.env;
			fixedMarkS = envS.fixedVarNbr;
			labelMarkS = sizeVector(p.labeled);
			prevMarkS = p.prev;
			infMarkS = sizeVector(envS.inferConstDef);
			schTypes : Vector<MizTyp> = makeVector(4);
			schPremises = ref [];
			schStmt : ref Maybe<MizFrm> = ref None();
			// the scheme functors' types feed GetTrmType inside the block
			savedSchFuncTyp = copyVector(envS.curSchFuncTyp);
			clearVector(envS.curSchFuncTyp);
			mizXmlNextElementState(x);
			while(\ -> x.nState == MizEStart, \ -> {
				nm = x.nElName;
				if (nm == "SchemeFuncDecl") {
					fnr = mizXmlIntAttrDef(x, "nr", 0);
					mizXmlNextElementState(x);
					if (x.nState == MizEStart && x.nElName == "ArgTypes") {
						__args = mizInArgColl(p.r);
						{}
					}
					resTyp = mizInType(p.r);
					while(\ -> sizeVector(schTypes) < fnr,
						\ -> pushVector(schTypes, mizNewIncorTyp()));
					setVectorUnsafe(schTypes, fnr - 1, resTyp);
					while(\ -> sizeVector(envS.curSchFuncTyp) < fnr,
						\ -> pushVector(envS.curSchFuncTyp, mizNewIncorTyp()));
					setVectorUnsafe(envS.curSchFuncTyp, fnr - 1, resTyp);
					while(\ -> x.nState == MizEStart, \ -> mizXmlSkipElement(x));
					mizXmlNextElementState(x);
				} else if (nm == "SchemePredDecl") {
					mizXmlSkipElement(x);
				} else if (nm == "SchemePremises") {
					mizXmlNextElementState(x);
					while(\ -> x.nState == MizEStart, \ -> {
						if (x.nElName == "Proposition") {
							prP = mizReadProposition(p);
							mizPrepCollectFrm(p, prP.second);   // ProcessProposition
							if (prP.first > 0) mizSetLabeled(p, prP.first, prP.second);
							schPremises := arrayPush(^schPremises, prP.second);
						} else {
							mizXmlSkipElement(x);
						}
					});
					mizXmlNextElementState(x);
				} else if (nm == "Proposition") {
					prS = mizReadProposition(p);
				mizPrepCollectFrm(p, prS.second);   // ProcessProposition
					schStmt := Some(prS.second);
					mizJustify(p, prS.second, 0);
				} else {
					mizXmlSkipElement(x);
				}
			});
			mizXmlNextElementState(x);
			// FinishPublicScheme (stdprep.pas 671-682): expand the collected
			// constants back out of the scheme's types and formulas, THEN free
			// the block's constants
			expW = mizExpandInferConstsW(envS);
			iterVector(schTypes, \tE -> mizWithinTyp(expW, tE));
			iter(^schPremises, \fE -> mizWithinFrm(expW, fE));
			switch (^schStmt) { Some(stE): mizWithinFrm(expW, stE); None(): {} }
			mizInferRelease(p.chk.idn, infMarkS);
			mizClearRoundMemo(p.chk.clusters);
		mizTTCollRelease(p.chk.env, 0);
			envS.fixedVarNbr ::= fixedMarkS;
			while(\ -> sizeVector(p.labeled) > labelMarkS,
				\ -> removeVector(p.labeled, sizeVector(p.labeled) - 1));
			p.prev ::= prevMarkS;
			clearVector(envS.curSchFuncTyp);
			iterVector(savedSchFuncTyp, \tS -> pushVector(envS.curSchFuncTyp, tS));
			switch (^schStmt) {
				Some(st): {
					pushVector(p.schemes.items, MizSchemeDef(0, schemeNr,
						schTypes, concat([st], ^schPremises), true));
				}
				None(): {}
			}
		} else if (name == "Canceled" || name == "Pattern") {
			{ st7 = p.stats; st7.skippedBlocks ::= st7.skippedBlocks + 1; }
			mizXmlSkipElement(x);
		} else {
			// anything unrecognized: skip and count
			{ st8 = p.stats; st8.skippedBlocks ::= st8.skippedBlocks + 1; }
			mizXmlSkipElement(x);
		}
	});
}
