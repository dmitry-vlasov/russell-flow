// Shared test harness for src/mizar/original tests.
// Each component test exports run<Unit>Tests(t : MizTest) -> void; the
// integration runner (test_all.flow) calls all of them and exits 1 on failure.

import runtime;
import string;
import net/url_parameter;
import fs/filesystem;

export {
	MizTest(
		mutable passed : int,
		mutable failed : int,
	);

	mizMakeTest() -> MizTest;
	mizCheck(t : MizTest, name : string, cond : bool) -> void;
	mizCheckEq(t : MizTest, name : string, got : string, expected : string) -> void;
	mizCheckEqI(t : MizTest, name : string, got : int, expected : int) -> void;
	mizTestSummary(t : MizTest, suite : string) -> void; // prints totals
	mizTestExit(t : MizTest) -> void;                    // quit(1) on failures

	// Root of the WORKING COPY of the MML (never the pristine MML).
	// Passed as `mml=<dir>` program argument by the wrapper (no env access
	// in flow9 Java); defaults to ~/dev/math/MML-test.
	mizTestMml() -> string;
}

mizMakeTest() -> MizTest {
	MizTest(0, 0);
}

mizCheck(t : MizTest, name : string, cond : bool) -> void {
	if (cond) {
		t.passed ::= t.passed + 1;
	} else {
		t.failed ::= t.failed + 1;
		println("FAIL " + name);
	}
}

mizCheckEq(t : MizTest, name : string, got : string, expected : string) -> void {
	if (got == expected) {
		t.passed ::= t.passed + 1;
	} else {
		t.failed ::= t.failed + 1;
		println("FAIL " + name + ": got '" + got + "', expected '" + expected + "'");
	}
}

mizCheckEqI(t : MizTest, name : string, got : int, expected : int) -> void {
	if (got == expected) {
		t.passed ::= t.passed + 1;
	} else {
		t.failed ::= t.failed + 1;
		println("FAIL " + name + ": got " + i2s(got) + ", expected " + i2s(expected));
	}
}

mizTestSummary(t : MizTest, suite : string) -> void {
	println(suite + ": " + i2s(t.passed) + " passed, " + i2s(t.failed) + " failed");
}

mizTestExit(t : MizTest) -> void {
	quit(if (t.failed > 0) 1 else 0);
}

mizTestMml() -> string {
	getUrlParameterDef("mml", "/home/dmitry/dev/math/MML-test");
}
