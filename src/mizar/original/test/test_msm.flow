// M3 gate 4 — the MSM step. Parses the article, runs the first-identification
// pass over the tree and writes the `.msx` to stdout, for a byte compare
// against ~/mizar_oracle/m3ref.

import mizar/original/errhan;
import mizar/original/scanner;
import mizar/original/formats;
import mizar/original/wsm;
import mizar/original/wsm_write;
import mizar/original/parseraddition;
import mizar/original/parser;
import mizar/original/msm;
import net/url_parameter;
import ds/vector;
import string;
import runtime;

main() {
	mml = getUrlParameterDef("mml", "/home/dmitry/dev/math/MML-test") + "/mml";
	a = getUrlParameterDef("article", "numerals");
	base = mml + "/" + a;
	eh = mizMakeErrHan();
	sc = mizInitScanning(base + ".miz", base + ".dct");
	formats = mizLoadFormats(base + ".frm");
	prf = mizLoadPrf(base + ".prf");
	p = mizMakeParser(eh, sc, formats, prf, toUpperCase(a), ".miz");
	mizStartScanner(p);
	mizCreateBlock(p, mizBlMain);
	mizParse(p);
	// msmprocessor reloads the formats from .frx — the collection AFTER the
	// article's own patterns were collected. The parser leaves exactly that in
	// p.formats, so it is passed straight through.
	mizMsmProcessArticle(p.textProper, eh, p.formats);
	byNr : Vector<string> = makeVector(sizeVector(sc.idents) + 1);
	fori(0, sizeVector(sc.idents) - 1, \__ -> pushVector(byNr, ""));
	iterVector(sc.idents, \t -> setVector(byNr, t.nr - 1, t.spelling));
	names = mizWsInitScannerNames(base + ".dct", vector2array(byNr));
	print(mizWriteMSMizArticle(p.textProper, names));
	quit(0);
}
