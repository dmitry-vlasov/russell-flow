// MML integration test: run the CheckerOnly pass over real articles from the
// working copy and pin the acceptance baselines. Baselines may only go UP
// as slice-2 pieces land; a drop is a regression.

import mizar/original/prep;
import mizar/original/test/test_utils;
import fs/filesystem;
import ds/vector;

export {
	runMmlTests(t : MizTest) -> void;
}

runMmlTests(t : MizTest) -> void {
	mml = mizTestMml() + "/mml";
	if (!fileExists(mml + "/xboole_0.xml")) {
		println("SKIP mml.*: MML-test not found");
	} else {
		// baselines 2026-07-31
		s0 = mizCheckArticle(mml, "xboole_0");
		mizCheckEqI(t, "mml.xboole_0.checked", s0.checked, 34);
		mizCheckEqI(t, "mml.xboole_0.accepted", s0.accepted, 34); // FULL
		s1 = mizCheckArticle(mml, "tarski");
		mizCheckEqI(t, "mml.tarski.checked", s1.checked, 22);
		mizCheckEqI(t, "mml.tarski.accepted", s1.accepted, 22); // FULL
		s2 = mizCheckArticle(mml, "enumset1");
		mizCheckEqI(t, "mml.enumset1.checked", s2.checked, 82);
		mizCheckEqI(t, "mml.enumset1.accepted", s2.accepted, 82); // FULL
		s3 = mizCheckArticle(mml, "xboole_1");
		mizCheckEqI(t, "mml.xboole_1.checked", s3.checked, 353);
		mizCheck(t, "mml.xboole_1.accepted", s3.accepted >= 343);
	}
}
