// MML integration test: run the CheckerOnly pass over real articles from the
// working copy and pin the acceptance baselines. Baselines may only go UP
// as slice-2 pieces land; a drop is a regression.

import mizar/original/prep;
import mizar/original/accom;
import mizar/original/test/test_utils;
import fs/filesystem;
import ds/vector;

export {
	runMmlTests(t : MizTest) -> void;
}

runMmlTests(t : MizTest) -> void {
	mml = mizTestMml() + "/mml";
	if (!fileExists(mml + "/xboole_0.xml")) {
		println("SKIP mml.*: MML-test not found");
	} else {
		// baselines 2026-07-31 — all six articles FULL
		s0 = mizCheckArticle(mml, "xboole_0");
		mizCheckEqI(t, "mml.xboole_0.checked", s0.checked, 81);
		mizCheckEqI(t, "mml.xboole_0.accepted", s0.accepted, 81);
		s1 = mizCheckArticle(mml, "tarski");
		mizCheckEqI(t, "mml.tarski.checked", s1.checked, 23);
		mizCheckEqI(t, "mml.tarski.accepted", s1.accepted, 23);
		s2 = mizCheckArticle(mml, "enumset1");
		mizCheckEqI(t, "mml.enumset1.checked", s2.checked, 312);
		mizCheckEqI(t, "mml.enumset1.accepted", s2.accepted, 312);
		s3 = mizCheckArticle(mml, "xboole_1");
		mizCheckEqI(t, "mml.xboole_1.checked", s3.checked, 437);
		mizCheckEqI(t, "mml.xboole_1.accepted", s3.accepted, 437);
		s4 = mizCheckArticle(mml, "zfmisc_1");
		mizCheckEqI(t, "mml.zfmisc_1.checked", s4.checked, 728);
		mizCheckEqI(t, "mml.zfmisc_1.accepted", s4.accepted, 728);
		s5 = mizCheckArticle(mml, "subset_1");
		mizCheckEqI(t, "mml.subset_1.checked", s5.checked, 378);
		mizCheckEqI(t, "mml.subset_1.accepted", s5.accepted, 378);
		s6 = mizCheckArticle(mml, "setfam_1");
		mizCheckEqI(t, "mml.setfam_1.checked", s6.checked, 361);
		mizCheckEqI(t, "mml.setfam_1.accepted", s6.accepted, 361);
		s7 = mizCheckArticle(mml, "relat_1");
		mizCheckEqI(t, "mml.relat_1.checked", s7.checked, 848);
		mizCheckEqI(t, "mml.relat_1.accepted", s7.accepted, 848);
		s8 = mizCheckArticle(mml, "funct_1");
		mizCheckEqI(t, "mml.funct_1.checked", s8.checked, 1024);
		mizCheckEqI(t, "mml.funct_1.accepted", s8.accepted, 1024);

		// M2's closing criterion, kept as a regression: an environment the
		// port accommodated ITSELF must give the checker the same verdicts
		// as the flat files Mizar's own accom wrote
		iter(["tarski", "xboole_1"], \art -> {
			ref0 = mizCheckArticle(mml, art);
			acc = mizCheckArticleWith(mml, art, mizAccomEnvLoader(mml, art));
			mizCheckEqI(t, "accomrun." + art + ".checked", acc.checked, ref0.checked);
			mizCheckEqI(t, "accomrun." + art + ".accepted", acc.accepted, ref0.accepted);
		});
	}
}
