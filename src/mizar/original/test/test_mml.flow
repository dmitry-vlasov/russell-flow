// MML integration test: run the CheckerOnly pass over real articles from the
// working copy and pin the acceptance baselines. Baselines may only go UP
// as slice-2 pieces land; a drop is a regression.

import mizar/original/prep;
import mizar/original/test/test_utils;
import fs/filesystem;
import ds/vector;

export {
	runMmlTests(t : MizTest) -> void;
}

runMmlTests(t : MizTest) -> void {
	mml = mizTestMml() + "/mml";
	if (!fileExists(mml + "/xboole_0.xml")) {
		println("SKIP mml.*: MML-test not found");
	} else {
		// baselines 2026-07-31 — all six articles FULL
		s0 = mizCheckArticle(mml, "xboole_0");
		mizCheckEqI(t, "mml.xboole_0.checked", s0.checked, 68);
		mizCheckEqI(t, "mml.xboole_0.accepted", s0.accepted, 68);
		s1 = mizCheckArticle(mml, "tarski");
		mizCheckEqI(t, "mml.tarski.checked", s1.checked, 22);
		mizCheckEqI(t, "mml.tarski.accepted", s1.accepted, 22);
		s2 = mizCheckArticle(mml, "enumset1");
		mizCheckEqI(t, "mml.enumset1.checked", s2.checked, 304);
		mizCheckEqI(t, "mml.enumset1.accepted", s2.accepted, 304);
		s3 = mizCheckArticle(mml, "xboole_1");
		mizCheckEqI(t, "mml.xboole_1.checked", s3.checked, 437);
		mizCheckEqI(t, "mml.xboole_1.accepted", s3.accepted, 437);
		s4 = mizCheckArticle(mml, "zfmisc_1");
		mizCheckEqI(t, "mml.zfmisc_1.checked", s4.checked, 683);
		mizCheckEqI(t, "mml.zfmisc_1.accepted", s4.accepted, 683);
		s5 = mizCheckArticle(mml, "subset_1");
		mizCheckEqI(t, "mml.subset_1.checked", s5.checked, 327);
		mizCheckEqI(t, "mml.subset_1.accepted", s5.accepted, 327);
		s6 = mizCheckArticle(mml, "setfam_1");
		mizCheckEqI(t, "mml.setfam_1.checked", s6.checked, 337);
		mizCheckEqI(t, "mml.setfam_1.accepted", s6.accepted, 337);
		s7 = mizCheckArticle(mml, "relat_1");
		mizCheckEqI(t, "mml.relat_1.checked", s7.checked, 797);
		mizCheckEqI(t, "mml.relat_1.accepted", s7.accepted, 797);
		// funct_1: 2 open resolvent-shape failures (3257, 3285)
		s8 = mizCheckArticle(mml, "funct_1");
		mizCheckEqI(t, "mml.funct_1.checked", s8.checked, 902);
		mizCheck(t, "mml.funct_1.accepted", s8.accepted >= 900);
	}
}
