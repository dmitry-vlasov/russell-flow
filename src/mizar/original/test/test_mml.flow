// MML integration test: run the CheckerOnly pass over real articles from the
// working copy and pin the acceptance baseline. The baseline may only go UP
// as slice-2 pieces land; a drop is a regression.

import mizar/original/prep;
import mizar/original/test/test_utils;
import fs/filesystem;
import ds/vector;

export {
	runMmlTests(t : MizTest) -> void;
}

runMmlTests(t : MizTest) -> void {
	mml = mizTestMml() + "/mml";
	if (!fileExists(mml + "/xboole_0.xml")) {
		println("SKIP mml.*: MML-test not found");
	} else {
		s = mizCheckArticle(mml, "xboole_0");
		mizCheckEqI(t, "mml.xboole_0.checked", s.checked, 34);
		// baseline 2026-07-31: 24/34 with slice-2 gaps staged (definientia,
		// schemes, PerCases, arithmetic). Only allowed to grow.
		mizCheck(t, "mml.xboole_0.accepted", s.accepted >= 24);
		mizCheck(t, "mml.xboole_0.nofalsepositives", s.accepted + s.failed == s.checked);
	}
}
