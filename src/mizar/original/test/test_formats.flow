import mizar/original/test/test_utils;
import mizar/original/formats;
import net/url_parameter;
import runtime;
main() {
	mml = mizTestMml() + "/mml";
	a = getUrlParameterDef("article", "numerals");
	f = mizLoadFormats(mml + "/" + a + ".frm");
	println("FORMATS " + i2s(mizFormatsCount(f)));
	fori(1, mizFormatsCount(f), \i -> {
		fm = mizFormatAt(f, i);
		println("FMT " + i2s(i) + " " + fromCharCode(fm.kind) + " sym=" + i2s(fm.symNr)
			+ " r=" + i2s(fm.rightArgsNbr) + " l=" + i2s(fm.leftArgsNbr)
			+ " rsym=" + i2s(fm.rightSymNr) + " args=" + i2s(fm.argsNbr));
	});
	iterVector(f.priority, \t -> println("PRI " + fromCharCode(t.first) + " "
		+ i2s(t.second) + " " + i2s(t.third)));
	p = mizLoadPrf(mml + "/" + a + ".prf");
	println("PRF mode=" + i2s(length(p.modeMaxArgs)) + " struct=" + i2s(length(p.structModeMaxArgs))
		+ " pred=" + i2s(length(p.predMaxArgs)));
	println("PRF modeArgs=" + strGlue(map(p.modeMaxArgs, i2s), ",")
		+ " structArgs=" + strGlue(map(p.structModeMaxArgs, i2s), ",")
		+ " predArgs=" + strGlue(map(p.predMaxArgs, i2s), ","));
	quit(0);
}
