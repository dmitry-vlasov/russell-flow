// M4 gate 1 — Transfer2Analyzer. Parses the article, runs the MSM step, then
// the transfer, and writes the `.par` byte stream to `out=<file>` for a byte
// compare against ~/mizar_oracle/m4ref/<article>.par.
//
// The stream holds bytes above 127, so it is written with setFileContentBytes
// (never printed): stdout would UTF-8 encode them.

import mizar/original/errhan;
import mizar/original/scanner;
import mizar/original/formats;
import mizar/original/wsm;
import mizar/original/parseraddition;
import mizar/original/parser;
import mizar/original/msm;
import mizar/original/pragmas;
import mizar/original/trans2analyzer;
import net/url_parameter;
import ds/vector;
import sys/system;
import string;
import runtime;

main() {
	mml = getUrlParameterDef("mml", "/home/dmitry/dev/math/MML-test") + "/mml";
	a = getUrlParameterDef("article", "numerals");
	out = getUrlParameterDef("out", "/tmp/port.par");
	refOut = getUrlParameterDef("refout", "");
	base = mml + "/" + a;
	eh = mizMakeErrHan();
	sc = mizInitScanning(base + ".miz", base + ".dct");
	formats = mizLoadFormats(base + ".frm");
	prf = mizLoadPrf(base + ".prf");
	p = mizMakeParser(eh, sc, formats, prf, toUpperCase(a), ".miz");
	mizStartScanner(p);
	mizCreateBlock(p, mizBlMain);
	mizParse(p);
	mizMsmProcessArticle(p.textProper, eh, p.formats);
	// Transfer2AnalyserObj.Init reloads the collection from `.frx`, which is
	// exactly what the parser left in p.formats.
	t = mizTransfer2Analyzer(p.textProper, eh, p.formats, mizMakePragmas());
	ok = setFileContentBytes(out, mizT2AParContent(t));
	if (!ok) println("cannot write " + out);
	if (refOut != "") {
		ok2 = setFileContentBytes(refOut, mizT2ARefContent(t));
		if (!ok2) println("cannot write " + refOut);
	}
	quit(0);
}
