// Component test for mizar/original/mobjects.flow (NatSet/NatFunc/IntSet
// and the generic containers of mobjects.pas).

import mizar/original/mobjects;
import mizar/original/test/test_utils;

export {
	runMobjectsTests(t : MizTest) -> void;
}

runMobjectsTests(t : MizTest) -> void {
	// NatSet: sorted insert, membership, no duplicates
	s = mizInitNatSet(0);
	mizNatInsertElem(s, 5);
	mizNatInsertElem(s, 2);
	mizNatInsertElem(s, 9);
	mizNatInsertElem(s, 5); // duplicate — ignored
	mizCheckEqI(t, "natset.count", mizNatCount(s), 3);
	mizCheck(t, "natset.sorted",
		mizNatItem(s, 0).x == 2 && mizNatItem(s, 1).x == 5 && mizNatItem(s, 2).x == 9);
	mizCheck(t, "natset.hasInDom", mizNatHasInDom(s, 5) && !mizNatHasInDom(s, 4));
	mizCheckEqI(t, "natset.elemNr", mizNatElemNr(s, 9), 2);
	mizCheckEqI(t, "natset.elemNr.absent", mizNatElemNr(s, 4), -1);

	mizNatDeleteElem(s, 5);
	mizCheckEqI(t, "natset.delete", mizNatCount(s), 2);
	mizCheck(t, "natset.delete.gone", !mizNatHasInDom(s, 5));

	// NatSet relations
	a = mizInitNatSet(0);
	mizNatInsertElem(a, 1);
	mizNatInsertElem(a, 3);
	b = mizInitNatSet(0);
	mizNatInsertElem(b, 1);
	mizNatInsertElem(b, 2);
	mizNatInsertElem(b, 3);
	mizCheck(t, "natset.subset", mizNatIsSubsetOf(a, b) && !mizNatIsSubsetOf(b, a));
	c = mizInitNatSet(0);
	mizNatInsertElem(c, 7);
	mizCheck(t, "natset.misses", mizNatMisses(a, c) && !mizNatMisses(a, b));
	mizNatEnlargeBy(a, c);
	mizCheck(t, "natset.enlargeBy", mizNatCount(a) == 3 && mizNatHasInDom(a, 7));
	mizNatComplementOf(a, c);
	mizCheck(t, "natset.complementOf", mizNatCount(a) == 2 && !mizNatHasInDom(a, 7));
	mizNatIntersectWith(a, b);
	mizCheck(t, "natset.intersect", mizNatCount(a) == 2);

	// NatFunc: Assign semantics — conflicting assignment REFUTES
	f = mizInitNatFunc(0);
	mizNatAssign(f, 1, 10);
	mizNatAssign(f, 2, 20);
	mizCheck(t, "natfunc.consistent", f.consistent);
	mizCheckEqI(t, "natfunc.value", mizNatValue(f, 2), 20);
	mizNatAssign(f, 1, 10); // same value — fine
	mizCheck(t, "natfunc.reassign.same", f.consistent && mizNatCount(f) == 2);
	mizNatAssign(f, 1, 11); // conflict — refuted
	mizCheck(t, "natfunc.refuted", !f.consistent && mizNatCount(f) == 0);
	mizNatAssign(f, 3, 30); // no-op on inconsistent
	mizCheck(t, "natfunc.refuted.sticky", !f.consistent && mizNatCount(f) == 0);

	// Up / Down / CountAll
	u = mizInitNatFunc(0);
	mizNatUp(u, 4);
	mizNatUp(u, 4);
	mizNatUp(u, 6);
	mizCheckEqI(t, "natfunc.up", mizNatValue(u, 4), 2);
	mizCheckEqI(t, "natfunc.countAll", mizNatCountAll(u), 3);
	mizNatDown(u, 4);
	mizCheckEqI(t, "natfunc.down", mizNatValue(u, 4), 1);
	mizNatDown(u, 4);
	mizCheck(t, "natfunc.down.drop", !mizNatHasInDom(u, 4));

	// Join: union with conflict detection
	g1 = mizInitNatFunc(0);
	mizNatAssign(g1, 1, 10);
	mizNatAssign(g1, 2, 20);
	g2 = mizInitNatFunc(0);
	mizNatAssign(g2, 2, 20);
	mizNatAssign(g2, 3, 30);
	mizNatJoin(g1, g2);
	mizCheck(t, "natfunc.join", g1.consistent && mizNatCount(g1) == 3
		&& mizNatValue(g1, 3) == 30);
	g3 = mizInitNatFunc(0);
	mizNatAssign(g3, 2, 99);
	mizNatJoin(g1, g3);
	mizCheck(t, "natfunc.join.conflict", !g1.consistent);

	// JoinAtom: non-destructive join
	h1 = mizInitNatFunc(0);
	mizNatAssign(h1, 1, 1);
	h2 = mizInitNatFunc(0);
	mizNatAssign(h2, 2, 2);
	switch (mizNatJoinAtom(h1, h2)) {
		Some(j): mizCheck(t, "natfunc.joinAtom",
			mizNatCount(j) == 2 && mizNatCount(h1) == 1);
		None(): mizCheck(t, "natfunc.joinAtom", false);
	}
	h3 = mizInitNatFunc(0);
	mizNatAssign(h3, 1, 2);
	mizCheck(t, "natfunc.joinAtom.conflict", isNone(mizNatJoinAtom(h1, h3)));

	// WeakerThan / CompareWith
	w1 = mizInitNatFunc(0);
	mizNatAssign(w1, 1, 10);
	w2 = mizInitNatFunc(0);
	mizNatAssign(w2, 1, 10);
	mizNatAssign(w2, 2, 20);
	mizCheck(t, "natfunc.weakerThan", mizNatWeakerThan(w1, w2) && !mizNatWeakerThan(w2, w1));
	mizCheckEqI(t, "natfunc.compareWith.-1", mizNatCompareWith(w1, w2), -1);
	mizCheckEqI(t, "natfunc.compareWith.1", mizNatCompareWith(w2, w1), 1);
	w3 = mizInitNatFunc(0);
	mizNatAssign(w3, 9, 9);
	mizCheckEqI(t, "natfunc.compareWith.0", mizNatCompareWith(w1, w3), 0);

	// LCM: pointwise max
	l1 = mizInitNatFunc(0);
	mizNatAssign(l1, 1, 3);
	mizNatAssign(l1, 2, 1);
	l2 = mizInitNatFunc(0);
	mizNatAssign(l2, 2, 5);
	mizNatAssign(l2, 4, 2);
	lcm = mizNatLCM(l1, l2);
	mizCheck(t, "natfunc.lcm", mizNatCount(lcm) == 3
		&& mizNatValue(lcm, 1) == 3 && mizNatValue(lcm, 2) == 5 && mizNatValue(lcm, 4) == 2);

	// IntSeq
	q = mizInitIntSeq(0);
	i0 = mizSeqInsert(q, 10);
	mizSeqInsert(q, 20);
	mizSeqInsert(q, 30);
	mizCheck(t, "intseq.insert", i0 == 0 && mizSeqCount(q) == 3 && mizSeqValue(q, 1) == 20);
	mizSeqAtPut(q, 1, 25);
	mizCheckEqI(t, "intseq.atPut", mizSeqValue(q, 1), 25);
	mizCheckEqI(t, "intseq.indexOf", mizSeqIndexOf(q, 30), 2);
	mizCheckEqI(t, "intseq.indexOf.absent", mizSeqIndexOf(q, 99), -1);
	mizSeqAtDelete(q, 0);
	mizCheck(t, "intseq.atDelete", mizSeqCount(q) == 2 && mizSeqValue(q, 0) == 25);

	// IntSet: sorted, no duplicates
	z = mizInitIntSeq(0);
	mizIntSetInsert(z, 5);
	mizIntSetInsert(z, 1);
	mizIntSetInsert(z, 3);
	mizIntSetInsert(z, 5);
	mizCheck(t, "intset.sorted", mizSeqCount(z) == 3
		&& mizSeqValue(z, 0) == 1 && mizSeqValue(z, 1) == 3 && mizSeqValue(z, 2) == 5);
	mizCheck(t, "intset.isInSet", mizIntSetIsInSet(z, 3) && !mizIntSetIsInSet(z, 4));
	z2 = mizInitIntSeq(0);
	mizIntSetInsert(z2, 3);
	mizIntSetInsert(z2, 5);
	mizCheck(t, "intset.subset", mizIntSetIsSubsetOf(z2, z) && !mizIntSetIsSubsetOf(z, z2));
	mizIntSetDelete(z, 3);
	mizCheck(t, "intset.delete", mizSeqCount(z) == 2 && !mizIntSetIsInSet(z, 3));
	z3 = mizInitIntSeq(0);
	mizIntSetInsert(z3, 2);
	mizCheck(t, "intset.misses", mizIntSetMisses(z, z3));

	runContainerTests(t);
}

// The semantics each of these checks has already cost the port a bug.
runContainerTests(t : MizTest) -> void {
	// MExtList: the pending tail is INVISIBLE to a Count-bounded read
	// until AddExtObject commits it, one item at a time.
	e : MizExtList<int> = mizNewExtList(0);
	mizExtListInsert(e, 10);
	mizExtListInsertExt(e, 20);
	mizExtListInsertExt(e, 30);
	mizCheck(t, "extlist.pending.invisible",
		mizExtListCount(e) == 1 && mizExtListExtCount(e) == 2);
	mizExtListAddExtObject(e);
	mizCheck(t, "extlist.addExtObject",
		mizExtListCount(e) == 2 && mizExtListExtCount(e) == 1
		&& mizExtListAt(e, 1) == 20);
	mizExtListAddExtItems(e);
	mizCheck(t, "extlist.addExtItems",
		mizExtListCount(e) == 3 && mizExtListExtCount(e) == 0);
	mizExtListInsertExt(e, 40);
	mizExtListDeleteExtItems(e);
	mizCheck(t, "extlist.deleteExtItems",
		mizExtListCount(e) == 3 && mizExtListExtCount(e) == 0);
	mizExtListFreeItemsFrom(e, 1);
	mizCheck(t, "extlist.freeItemsFrom", mizExtListCount(e) == 1);

	cmpI = \a : int, b : int -> if (a < b) -1 else if (a > b) 1 else 0;

	// MSortedList: TWO ORDERS. Items keeps the insertion order — that
	// order is the numbering at every use site — and fIndex is sorted.
	sl : MizSortedList<int> = mizNewSortedListSorted(0, cmpI);
	mizSortedListInsert(sl, 30);
	mizSortedListInsert(sl, 10);
	mizSortedListInsert(sl, 20);
	mizSortedListInsert(sl, 10); // duplicate — Insert drops it
	mizCheck(t, "sortedlist.count", mizSortedListCount(sl) == 3);
	mizCheck(t, "sortedlist.items.insertionOrder",
		mizSortedListAt(sl, 0) == 30 && mizSortedListAt(sl, 1) == 10
		&& mizSortedListAt(sl, 2) == 20);
	mizCheck(t, "sortedlist.atIndex.sortedOrder",
		mizSortedListAtIndex(sl, 0) == 10 && mizSortedListAtIndex(sl, 1) == 20
		&& mizSortedListAtIndex(sl, 2) == 30);
	// Search returns the position in ITEMS, Find the position in fIndex.
	mizCheck(t, "sortedlist.search", mizSortedListSearch(sl, 30) == Pair(true, 0));
	mizCheck(t, "sortedlist.find", mizSortedListFind(sl, 30) == Pair(true, 2));
	mizCheck(t, "sortedlist.indexOf", mizSortedListIndexOf(sl, 20) == 2);
	mizCheck(t, "sortedlist.absent", !mizSortedListFind(sl, 25).first);
	// FreeItemsFrom drops the tail of Items and compacts fIndex, keeping
	// the survivors in their sorted order.
	mizSortedListFreeItemsFrom(sl, 2);
	mizCheck(t, "sortedlist.freeItemsFrom",
		mizSortedListCount(sl) == 2 && mizSortedListAtIndex(sl, 0) == 10
		&& mizSortedListAtIndex(sl, 1) == 30);
	// Sort installs a comparison and rebuilds the index only.
	sl2 : MizSortedList<int> = mizNewSortedList(0);
	mizSortedListInsert(sl2, 3);
	mizSortedListInsert(sl2, 1);
	mizSortedListInsert(sl2, 2);
	mizCheck(t, "sortedlist.nilCompare.appends", mizSortedListAt(sl2, 0) == 3);
	mizSortedListSort(sl2, cmpI);
	mizCheck(t, "sortedlist.sort",
		mizSortedListAt(sl2, 0) == 3 && mizSortedListAtIndex(sl2, 0) == 1
		&& mizSortedListAtIndex(sl2, 2) == 3);

	// MSortedExtList: duplicate keys are KEPT, and among themselves they
	// stay in INSERTION order, because AddExtObject inserts through
	// FindRight. Keying on the first component makes that observable.
	cmpFst = \a : Pair<int, int>, b : Pair<int, int> -> cmpI(a.first, b.first);
	sx : MizSortedExtList<Pair<int, int>> = mizNewSortedExtList(0, cmpFst);
	mizSortedExtListInsert(sx, Pair(2, 1));
	mizSortedExtListInsert(sx, Pair(1, 1));
	mizSortedExtListInsert(sx, Pair(2, 2));
	mizSortedExtListInsert(sx, Pair(2, 3));
	mizCheck(t, "sortedextlist.items.insertionOrder",
		mizSortedExtListAt(sx, 0) == Pair(2, 1) && mizSortedExtListAt(sx, 1) == Pair(1, 1));
	mizCheck(t, "sortedextlist.equalKeysKeepInsertionOrder",
		mizSortedExtListAtIndex(sx, 0) == Pair(1, 1)
		&& mizSortedExtListAtIndex(sx, 1) == Pair(2, 1)
		&& mizSortedExtListAtIndex(sx, 2) == Pair(2, 2)
		&& mizSortedExtListAtIndex(sx, 3) == Pair(2, 3));
	// Find is the LEFTMOST equal; FindInterval is inclusive on both ends.
	mizCheck(t, "sortedextlist.find.leftmost",
		mizSortedExtListFind(sx, Pair(2, 0)) == Pair(true, 1));
	mizCheck(t, "sortedextlist.findRight",
		mizSortedExtListFindRight(sx, Pair(2, 0)) == Pair(true, 4));
	mizCheck(t, "sortedextlist.findInterval",
		mizSortedExtListFindInterval(sx, Pair(2, 0)) == Triple(true, 1, 3));
	mizCheck(t, "sortedextlist.findInterval.miss",
		mizSortedExtListFindInterval(sx, Pair(3, 0)) == Triple(false, 4, 3));
	// The ext tail is invisible to the index search until it is committed.
	mizSortedExtListInsertExt(sx, Pair(0, 9));
	mizCheck(t, "sortedextlist.pending.invisible",
		mizSortedExtListCount(sx) == 4 && !mizSortedExtListFind(sx, Pair(0, 0)).first);
	mizSortedExtListAddExtItems(sx);
	mizCheck(t, "sortedextlist.pending.committed",
		mizSortedExtListCount(sx) == 5 && mizSortedExtListAtIndex(sx, 0) == Pair(0, 9));

	// MSortedCollection is PHYSICALLY sorted — no second order.
	sc : MizSortedColl<int> = mizNewSortedColl(0, cmpI);
	mizSortedCollInsert(sc, 30);
	mizSortedCollInsert(sc, 10);
	mizSortedCollInsert(sc, 20);
	mizSortedCollInsert(sc, 10); // dropped: Duplicates is false
	mizCheck(t, "sortedcoll.sortedInPlace",
		mizSortedCollCount(sc) == 3 && mizSortedCollAt(sc, 0) == 10
		&& mizSortedCollAt(sc, 2) == 30);
	mizCheck(t, "sortedcoll.search", mizSortedCollSearch(sc, 20) == Pair(true, 1));
	mizCheck(t, "sortedcoll.search.miss", mizSortedCollSearch(sc, 25) == Pair(false, 2));
	mizCheck(t, "sortedcoll.indexOf", mizSortedCollIndexOf(sc, 30) == 2);
	sc.duplicates ::= true;
	mizSortedCollInsert(sc, 20);
	mizCheck(t, "sortedcoll.duplicates", mizSortedCollCount(sc) == 4);

	// MList / MCollection.
	ml : MizList<int> = mizNewList(0);
	mizListInsert(ml, 1);
	mizListInsert(ml, 2);
	mizListAtInsert(ml, 1, 3);
	mizCheck(t, "list.atInsert.shifts",
		mizListItems(ml) == [1, 3, 2] && mizListLast(ml) == 2);
	mizListAtDelete(ml, 0);
	mizCheck(t, "list.atDelete", mizListItems(ml) == [3, 2]);
	mizCheck(t, "list.indexOf", mizListIndexOf(ml, 2) == 1 && mizListIndexOf(ml, 9) == -1);
	mizListFreeItemsFrom(ml, 1);
	mizCheck(t, "list.freeItemsFrom", mizListCount(ml) == 1);
}
