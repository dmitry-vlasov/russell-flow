// Component test for mizar/original/mobjects.flow (NatSet/NatFunc/IntSet).

import mizar/original/mobjects;
import mizar/original/test/test_utils;

export {
	runMobjectsTests(t : MizTest) -> void;
}

runMobjectsTests(t : MizTest) -> void {
	// NatSet: sorted insert, membership, no duplicates
	s = mizInitNatSet(0);
	mizNatInsertElem(s, 5);
	mizNatInsertElem(s, 2);
	mizNatInsertElem(s, 9);
	mizNatInsertElem(s, 5); // duplicate — ignored
	mizCheckEqI(t, "natset.count", mizNatCount(s), 3);
	mizCheck(t, "natset.sorted",
		mizNatItem(s, 0).x == 2 && mizNatItem(s, 1).x == 5 && mizNatItem(s, 2).x == 9);
	mizCheck(t, "natset.hasInDom", mizNatHasInDom(s, 5) && !mizNatHasInDom(s, 4));
	mizCheckEqI(t, "natset.elemNr", mizNatElemNr(s, 9), 2);
	mizCheckEqI(t, "natset.elemNr.absent", mizNatElemNr(s, 4), -1);

	mizNatDeleteElem(s, 5);
	mizCheckEqI(t, "natset.delete", mizNatCount(s), 2);
	mizCheck(t, "natset.delete.gone", !mizNatHasInDom(s, 5));

	// NatSet relations
	a = mizInitNatSet(0);
	mizNatInsertElem(a, 1);
	mizNatInsertElem(a, 3);
	b = mizInitNatSet(0);
	mizNatInsertElem(b, 1);
	mizNatInsertElem(b, 2);
	mizNatInsertElem(b, 3);
	mizCheck(t, "natset.subset", mizNatIsSubsetOf(a, b) && !mizNatIsSubsetOf(b, a));
	c = mizInitNatSet(0);
	mizNatInsertElem(c, 7);
	mizCheck(t, "natset.misses", mizNatMisses(a, c) && !mizNatMisses(a, b));
	mizNatEnlargeBy(a, c);
	mizCheck(t, "natset.enlargeBy", mizNatCount(a) == 3 && mizNatHasInDom(a, 7));
	mizNatComplementOf(a, c);
	mizCheck(t, "natset.complementOf", mizNatCount(a) == 2 && !mizNatHasInDom(a, 7));
	mizNatIntersectWith(a, b);
	mizCheck(t, "natset.intersect", mizNatCount(a) == 2);

	// NatFunc: Assign semantics — conflicting assignment REFUTES
	f = mizInitNatFunc(0);
	mizNatAssign(f, 1, 10);
	mizNatAssign(f, 2, 20);
	mizCheck(t, "natfunc.consistent", f.consistent);
	mizCheckEqI(t, "natfunc.value", mizNatValue(f, 2), 20);
	mizNatAssign(f, 1, 10); // same value — fine
	mizCheck(t, "natfunc.reassign.same", f.consistent && mizNatCount(f) == 2);
	mizNatAssign(f, 1, 11); // conflict — refuted
	mizCheck(t, "natfunc.refuted", !f.consistent && mizNatCount(f) == 0);
	mizNatAssign(f, 3, 30); // no-op on inconsistent
	mizCheck(t, "natfunc.refuted.sticky", !f.consistent && mizNatCount(f) == 0);

	// Up / Down / CountAll
	u = mizInitNatFunc(0);
	mizNatUp(u, 4);
	mizNatUp(u, 4);
	mizNatUp(u, 6);
	mizCheckEqI(t, "natfunc.up", mizNatValue(u, 4), 2);
	mizCheckEqI(t, "natfunc.countAll", mizNatCountAll(u), 3);
	mizNatDown(u, 4);
	mizCheckEqI(t, "natfunc.down", mizNatValue(u, 4), 1);
	mizNatDown(u, 4);
	mizCheck(t, "natfunc.down.drop", !mizNatHasInDom(u, 4));

	// Join: union with conflict detection
	g1 = mizInitNatFunc(0);
	mizNatAssign(g1, 1, 10);
	mizNatAssign(g1, 2, 20);
	g2 = mizInitNatFunc(0);
	mizNatAssign(g2, 2, 20);
	mizNatAssign(g2, 3, 30);
	mizNatJoin(g1, g2);
	mizCheck(t, "natfunc.join", g1.consistent && mizNatCount(g1) == 3
		&& mizNatValue(g1, 3) == 30);
	g3 = mizInitNatFunc(0);
	mizNatAssign(g3, 2, 99);
	mizNatJoin(g1, g3);
	mizCheck(t, "natfunc.join.conflict", !g1.consistent);

	// JoinAtom: non-destructive join
	h1 = mizInitNatFunc(0);
	mizNatAssign(h1, 1, 1);
	h2 = mizInitNatFunc(0);
	mizNatAssign(h2, 2, 2);
	switch (mizNatJoinAtom(h1, h2)) {
		Some(j): mizCheck(t, "natfunc.joinAtom",
			mizNatCount(j) == 2 && mizNatCount(h1) == 1);
		None(): mizCheck(t, "natfunc.joinAtom", false);
	}
	h3 = mizInitNatFunc(0);
	mizNatAssign(h3, 1, 2);
	mizCheck(t, "natfunc.joinAtom.conflict", isNone(mizNatJoinAtom(h1, h3)));

	// WeakerThan / CompareWith
	w1 = mizInitNatFunc(0);
	mizNatAssign(w1, 1, 10);
	w2 = mizInitNatFunc(0);
	mizNatAssign(w2, 1, 10);
	mizNatAssign(w2, 2, 20);
	mizCheck(t, "natfunc.weakerThan", mizNatWeakerThan(w1, w2) && !mizNatWeakerThan(w2, w1));
	mizCheckEqI(t, "natfunc.compareWith.-1", mizNatCompareWith(w1, w2), -1);
	mizCheckEqI(t, "natfunc.compareWith.1", mizNatCompareWith(w2, w1), 1);
	w3 = mizInitNatFunc(0);
	mizNatAssign(w3, 9, 9);
	mizCheckEqI(t, "natfunc.compareWith.0", mizNatCompareWith(w1, w3), 0);

	// LCM: pointwise max
	l1 = mizInitNatFunc(0);
	mizNatAssign(l1, 1, 3);
	mizNatAssign(l1, 2, 1);
	l2 = mizInitNatFunc(0);
	mizNatAssign(l2, 2, 5);
	mizNatAssign(l2, 4, 2);
	lcm = mizNatLCM(l1, l2);
	mizCheck(t, "natfunc.lcm", mizNatCount(lcm) == 3
		&& mizNatValue(lcm, 1) == 3 && mizNatValue(lcm, 2) == 5 && mizNatValue(lcm, 4) == 2);

	// IntSeq
	q = mizInitIntSeq(0);
	i0 = mizSeqInsert(q, 10);
	mizSeqInsert(q, 20);
	mizSeqInsert(q, 30);
	mizCheck(t, "intseq.insert", i0 == 0 && mizSeqCount(q) == 3 && mizSeqValue(q, 1) == 20);
	mizSeqAtPut(q, 1, 25);
	mizCheckEqI(t, "intseq.atPut", mizSeqValue(q, 1), 25);
	mizCheckEqI(t, "intseq.indexOf", mizSeqIndexOf(q, 30), 2);
	mizCheckEqI(t, "intseq.indexOf.absent", mizSeqIndexOf(q, 99), -1);
	mizSeqAtDelete(q, 0);
	mizCheck(t, "intseq.atDelete", mizSeqCount(q) == 2 && mizSeqValue(q, 0) == 25);

	// IntSet: sorted, no duplicates
	z = mizInitIntSeq(0);
	mizIntSetInsert(z, 5);
	mizIntSetInsert(z, 1);
	mizIntSetInsert(z, 3);
	mizIntSetInsert(z, 5);
	mizCheck(t, "intset.sorted", mizSeqCount(z) == 3
		&& mizSeqValue(z, 0) == 1 && mizSeqValue(z, 1) == 3 && mizSeqValue(z, 2) == 5);
	mizCheck(t, "intset.isInSet", mizIntSetIsInSet(z, 3) && !mizIntSetIsInSet(z, 4));
	z2 = mizInitIntSeq(0);
	mizIntSetInsert(z2, 3);
	mizIntSetInsert(z2, 5);
	mizCheck(t, "intset.subset", mizIntSetIsSubsetOf(z2, z) && !mizIntSetIsSubsetOf(z, z2));
	mizIntSetDelete(z, 3);
	mizCheck(t, "intset.delete", mizSeqCount(z) == 2 && !mizIntSetIsInSet(z, 3));
	z3 = mizInitIntSeq(0);
	mizIntSetInsert(z3, 2);
	mizCheck(t, "intset.misses", mizIntSetMisses(z, z3));
}
