// M2 validation: the accommodated constructor table must equal the table
// Mizar's own accom wrote into the article's .atr — same order, same kinds,
// same articles, same arities, same translated references.

import mizar/original/accom;
import mizar/original/correl;
import mizar/original/iocorrel;
import mizar/original/xml_parser;
import mizar/original/print;
import mizar/original/test/test_utils;
import fs/filesystem;
import ds/vector;

export {
	runAccomTests(t : MizTest) -> void;
}

accSig(env : MizCorrelEnv) -> [string] {
	out = ref [];
	fori(0, coLAST, \k -> {
		n = mizConstrCount(env, k);
		fori(1, n, \i -> {
			c = mizConstr(env, k, i);
			ty = switch (c.typ) { Some(tt): mizTyp2s(tt); None(): "-"; };
			prims = strGlue(map(vector2array(c.primaries), mizTyp2s), ";");
			out := arrayPush(^out, i2s(k) + ":" + i2s(i) + ":" + c.article
				+ ":" + i2s(sizeVector(c.primaries)) + ":" + prims + ":" + ty);
		});
	});
	^out;
}

runAccomTests(t : MizTest) -> void {
	mml = mizTestMml() + "/mml";
	if (!fileExists(mml + "/xboole_1.evl")) {
		println("SKIP accom.*: MML-test not found");
	} else {
		iter(["xboole_1", "enumset1", "zfmisc_1", "setfam_1", "relat_1",
			"funct_1", "ordinal2", "wellord1", "finset_1", "card_1",
			"absvalue", "recdef_1", "borsuk_1", "vectsp_6", "isocat_2",
			"waybel14", "sin_cos", "algstr_3", "funcsdom", "polnot_1"], \art -> {
			evl = mizLoadEvl(mml + "/" + art + ".evl");
			mizCheck(t, "accom." + art + ".evl.article", evl.article != "");

			// reference: the .atr Mizar produced
			envRef = mizMakeCorrelEnv();
			rRef = mizMakeVrfReader(mizXmlInitParsing(""), envRef);
			mizLoadConstructors(rRef, getFileContent(mml + "/" + art + ".atr"));

			// ours: accommodated from prel/*.dco
			envAcc = mizMakeCorrelEnv();
			__loaded = mizAccomConstructors(envAcc, mml, evl);

			ref0 = accSig(envRef);
			acc0 = accSig(envAcc);
			mizCheckEqI(t, "accom." + art + ".count", length(acc0), length(ref0));
			// first differing entry, for a readable failure
			n = min(length(ref0), length(acc0));
			bad = ref -1;
			fori(0, n - 1, \i -> if (^bad < 0 && ref0[i] != acc0[i]) bad := i);
			if (^bad >= 0) {
				println("  accom." + art + " first diff at " + i2s(^bad)
					+ "\n    ref = " + ref0[^bad]
					+ "\n    acc = " + acc0[^bad]);
			}
			mizCheckEqI(t, "accom." + art + ".firstDiff", ^bad, -1);
		});
	}
}
