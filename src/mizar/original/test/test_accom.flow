// M2 validation: the accommodated environment must equal the one Mizar's own
// accom wrote — the constructor table against `.atr`, the registrations
// against `.ecl`: same order, same kinds, same articles, same numbers, same
// translated references.

import mizar/original/accom;
import mizar/original/correl;
import mizar/original/iocorrel;
import mizar/original/roundcl;
import mizar/original/schemes;
import mizar/original/definientia;
import mizar/original/identify;
import mizar/original/builtin;
import mizar/original/mobjects;
import mizar/original/prep;
import mizar/original/xml_parser;
import mizar/original/print;
import mizar/original/test/test_utils;
import fs/filesystem;
import ds/vector;

export {
	runAccomTests(t : MizTest) -> void;
}

// a stride across the whole MML: set theory, algebra, topology, categories,
// analysis, computer models — 80 articles, ~4s
accArticles = [
	"xboole_1", "enumset1", "zfmisc_1", "setfam_1", "relat_1", "funct_1", "ordinal2", "wellord1",
	"finset_1", "card_1", "absvalue", "recdef_1", "borsuk_1", "vectsp_6", "isocat_2", "waybel14",
	"sin_cos", "algstr_3", "funcsdom", "polnot_1", "tarski", "funct_3", "partfun2", "int_2",
	"margrel1", "rewrite1", "genealg1", "extreal1", "afinsq_1", "bvfunc11", "integr12", "rinfsup2",
	"qc_lang1", "qc_trans", "vectsp_1", "real_lat", "matrix_3", "projred2", "tbsp_1", "altcat_1",
	"msualg_3", "yellow12", "ranknull", "goboard4", "autalg_1", "functor1", "graph_3", "waybel20",
	"complsp2", "uniroots", "matrix14", "urysohn3", "waybel25", "hilbasis", "osalg_1", "kurato_1",
	"csspace3", "groeb_3", "lexbfs", "int_7", "integr11", "c0sp2", "pdiff_8", "ndiff_5",
	"altcat_5", "huffman1", "compos_2", "scmfsa8c", "altcat_6", "lattad_1", "dualsp04", "cardfil4",
	"basel_1", "glib_006", "field_1", "prsubset", "latwal_1", "fuzzy_6", "integr26", "dualsp06"
];

accSig(env : MizCorrelEnv) -> [string] {
	out = ref [];
	fori(0, coLAST, \k -> {
		n = mizConstrCount(env, k);
		fori(1, n, \i -> {
			c = mizConstr(env, k, i);
			ty = switch (c.typ) { Some(tt): mizTyp2s(tt); None(): "-"; };
			prims = strGlue(map(vector2array(c.primaries), mizTyp2s), ";");
			out := arrayPush(^out, i2s(k) + ":" + i2s(i) + ":" + c.article
				+ ":" + i2s(sizeVector(c.primaries)) + ":" + prims + ":" + ty
				+ ":w" + i2s(c.whichConstrNr) + ":s" + i2s(c.superfluous)
				+ ":p" + i2s(c.properties) + ":a" + i2s(c.firstArg) + "," + i2s(c.secondArg)
				+ ":g" + i2s(c.structModeAggrNr) + ":b" + i2s(c.aggregBase)
				+ ":f" + strGlue(map(enumFromTo(0, mizNatCount(c.fields) - 1),
					\z -> i2s(mizNatItem(c.fields, z).x)), ",")
				+ ":q" + strGlue(map(enumFromTo(0, mizSeqCount(c.aggrFields) - 1),
					\z -> i2s(mizSeqValue(c.aggrFields, z))), ",")
				+ ":x" + strGlue(map(vector2array(c.prefixes), mizTyp2s), ";"));
		});
	});
	^out;
}

accAttrs2s(c : MizAttrColl) -> string {
	strGlue(map(vector2array(c.items), \a -> (if (a.neg == 0) "non-" else "")
		+ "V" + i2s(a.attrNr) + "(" + mizTrmList2s(a.args) + ")"), ",");
}

accPrims2s(v : Vector<MizTyp>) -> string {
	strGlue(map(vector2array(v), mizTyp2s), ";");
}

// one line per registration, in registry order
accClSig(cl : MizClusters) -> [string] {
	concat(concat(
		mapi(mizExtListItems(cl.registered), \i, r -> "R" + i2s(i) + ":" + r.article
			+ ":" + i2s(r.absNr) + ":" + accPrims2s(r.primaries)
			+ ":" + mizTyp2s(r.clusterType)
			+ ":" + accAttrs2s(r.consequent.lower)),
		mapi(mizSortedExtListItems(cl.functor), \i, f -> "F" + i2s(i) + ":" + f.article
			+ ":" + i2s(f.absNr) + ":" + accPrims2s(f.primaries)
			+ ":" + mizTrm2s(f.clusterTerm)
			+ ":" + (switch (f.clusterType) { Some(tt): mizTyp2s(tt); None(): "-"; })
			+ ":" + accAttrs2s(f.consequent.lower))),
		mapi(mizExtListItems(cl.conditional), \i, c -> "C" + i2s(i) + ":" + c.article
			+ ":" + i2s(c.absNr) + ":" + accPrims2s(c.primaries)
			+ ":" + accAttrs2s(c.antecedent)
			+ ":" + mizTyp2s(c.clusterType)
			+ ":" + accAttrs2s(c.consequent.lower)));
}

// one line per theorem, in key order
accThSig(th : Pair<Tree<int, MizFrm>, int>) -> [string] {
	map(tree2pairs(th.first), \kv -> i2s(kv.first) + ":" + mizFrm2s(kv.second));
}

// one line per scheme, in registry order
accSchSig(sc : MizSchemes) -> [string] {
	map(vector2array(sc.items), \s -> i2s(s.articleNr) + ":" + i2s(s.nr)
		+ ":" + b2s(s.valid) + ":" + accPrims2s(s.schTypes)
		+ ":" + strGlue(map(s.schProps, mizFrm2s), "|"));
}

// one line per definiens, in pool order
accDefBody2s(b : MizDefBody) -> string {
	switch (b) { MizDefFrm(f): mizFrm2s(f); MizDefTrm(t): mizTrm2s(t); }
}

accDefSig(v : Vector<MizDefiniens>) -> [string] {
	map(vector2array(v), \d -> i2s(d.constrKind) + ":" + i2s(d.constrNr)
		+ ":" + d.article + ":" + i2s(d.defNr)
		+ ":" + accPrims2s(d.primaries) + ":" + mizFrm2s(d.assumptions)
		+ ":" + (switch (d.def) {
			None(): "-";
			Some(def): i2s(def.sort)
				+ "{" + strGlue(map(vector2array(def.partials), \pd ->
					accDefBody2s(pd.body) + " if " + mizFrm2s(pd.guard)), ";") + "}"
				+ (switch (def.otherwise) { Some(b): accDefBody2s(b); None(): "-"; });
		}));
}

accIdSig(idn : MizIdentify) -> [string] {
	concat(
		map(vector2array(idn.identifications), \it -> "I:" + it.article + ":"
			+ i2s(it.absNr) + ":" + accPrims2s(it.primaries)
			+ ":" + mizTrm2s(it.pattern0) + ":" + mizTrm2s(it.pattern1)
			+ ":" + strGlue(map(it.eqArgs, \pr -> i2s(pr.x) + "," + i2s(pr.y)), ";")),
		map(vector2array(idn.reductions), \rd -> "R:" + rd.article + ":"
			+ i2s(rd.absNr) + ":" + accPrims2s(rd.primaries)
			+ ":" + mizTrm2s(rd.t0) + ":" + mizTrm2s(rd.t1)));
}

accReq2s(env : MizCorrelEnv) -> [string] {
	map(enumFromTo(0, rqLAST), \i -> i2s(i) + ":" + i2s(mizBuiltIn(env.builtIn, i)));
}

// report the first differing line, then pin the count and the diff position
accDiff(t : MizTest, name : string, ref0 : [string], got : [string]) -> void {
	mizCheckEqI(t, name + ".count", length(got), length(ref0));
	n = min(length(ref0), length(got));
	bad = ref -1;
	fori(0, n - 1, \i -> if (^bad < 0 && ref0[i] != got[i]) bad := i);
	if (^bad >= 0) {
		println("  " + name + " first diff at " + i2s(^bad)
			+ "\n    ref = " + ref0[^bad]
			+ "\n    acc = " + got[^bad]);
	}
	mizCheckEqI(t, name + ".firstDiff", ^bad, -1);
}

runAccomTests(t : MizTest) -> void {
	mml = mizTestMml() + "/mml";
	if (!fileExists(mml + "/xboole_1.evl")) {
		println("SKIP accom.*: MML-test not found");
	} else {
		idTotal = ref 0;
		iter(accArticles, \art -> {
			evl = mizLoadEvl(mml + "/" + art + ".evl");
			mizCheck(t, "accom." + art + ".evl.article", evl.article != "");

			// reference: the .atr / .ecl Mizar produced
			envRef = mizMakeCorrelEnv();
			clRef = mizMakeClusters();
			rRef = mizMakeVrfReader(mizXmlInitParsing(""), envRef);
			mizLoadConstructors(rRef, getFileContent(mml + "/" + art + ".atr"));
			mizLoadClusters(envRef, clRef, getFileContent(mml + "/" + art + ".ecl"));

			// ours: accommodated from prel/*.dco and prel/*.dcl
			envAcc = mizMakeCorrelEnv();
			clAcc = mizMakeClusters();
			acc = mizMakeAccom(envAcc, mml);
			__loaded = mizAccomConstructors(acc, evl);
			mizAccomClusters(acc, clAcc, evl);

			accDiff(t, "accom." + art, accSig(envRef), accSig(envAcc));
			refCl = accClSig(clRef);
			// a vacuous 0 == 0 comparison would prove nothing — unless the
			// article really imports no registrations (enumset1)
			mizCheck(t, "accomcl." + art + ".nonempty",
				length(refCl) > 0 || mizEvlDirective(evl, "registrations") == []);
			accDiff(t, "accomcl." + art, refCl, accClSig(clAcc));

			refTh = mizLoadTheoremTree(envRef, getFileContent(mml + "/" + art + ".eth"));
			accTh = mizAccomTheorems(acc, evl);
			mizCheck(t, "accomth." + art + ".nonempty",
				sizeTree(refTh.first) > 0 || mizEvlDirective(evl, "theorems") == []);
			accDiff(t, "accomth." + art, accThSig(refTh), accThSig(accTh));

			refSch = mizMakeSchemes();
			mizLoadSchemesInto(envRef, refSch, getFileContent(mml + "/" + art + ".esh"));
			mizCheck(t, "accomsch." + art + ".nonempty",
				sizeVector(refSch.items) > 0 || mizEvlDirective(evl, "schemes") == []);
			accDiff(t, "accomsch." + art, accSchSig(refSch), accSchSig(mizAccomSchemes(acc, evl)));

			// requirements: the .ere is a flat list of constructor numbers
			mizLoadRequirementsFile(envRef, mml + "/" + art + ".ere");
			mizAccomRequirements(acc, evl);
			accDiff(t, "accomreq." + art, accReq2s(envRef), accReq2s(envAcc));

			idnRef = mizMakeIdentify(envRef);
			mizLoadIdentifications(envRef, idnRef, getFileContent(mml + "/" + art + ".eid"));
			mizLoadReductions(envRef, idnRef, getFileContent(mml + "/" + art + ".erd"));
			idnAcc = mizMakeIdentify(envAcc);
			mizAccomIdentifications(acc, evl, idnAcc);
			mizAccomReductions(acc, evl, idnAcc);
			idTotal := ^idTotal + length(accIdSig(idnRef));
			accDiff(t, "accomid." + art, accIdSig(idnRef), accIdSig(idnAcc));

			iter([Pair("definitions", ".dfs"), Pair("equalities", ".dfe"),
				Pair("expansions", ".dfx")], \dd -> {
				refD : Vector<MizDefiniens> = makeVector(8);
				mizLoadDefsFile(envRef, mml + "/" + art + dd.second, refD);
				mizCheck(t, "accomdef." + art + dd.second + ".nonempty",
					sizeVector(refD) > 0 || mizEvlDirective(evl, dd.first) == []);
				accDiff(t, "accomdef." + art + dd.second, accDefSig(refD),
					accDefSig(mizAccomDefinientia(acc, evl, dd.first, true)));
			});
		});
		// the identification/reduction diff must not be vacuous across the run
		mizCheck(t, "accomid.nonempty", ^idTotal > 0);
	}
}

