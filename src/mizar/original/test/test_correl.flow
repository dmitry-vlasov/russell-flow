// Component test for mizar/original/correl.flow — the expression layer.

import mizar/original/correl;
import mizar/original/lexicon;
import mizar/original/builtin;
import mizar/original/test/test_utils;
import ds/vector;

export {
	runCorrelTests(t : MizTest) -> void;
}

// x1, x2 as bound vars; f(x1, x2); g redefined to f with 1 superfluous arg.
runCorrelTests(t : MizTest) -> void {
	env = mizMakeCorrelEnv();
	// constructor tables: functor 1 = f/2; functor 2 = g/3 redefined -> f skip 1;
	// predicate 1 = "=" (wired as rqEqualsTo); attribute 1 = v/1.
	f = mizMakeConstr(coFunctor, "T", 1);
	fNr = mizPushConstr(env, f);
	g = mizMakeConstr(coFunctor, "T", 2);
	g.whichConstrNr ::= fNr;
	g.superfluous ::= 1;
	gNr = mizPushConstr(env, g);
	eqC = mizMakeConstr(coPredicate, "H", 1);
	eqNr = mizPushConstr(env, eqC);
	mizSetBuiltIn(env.builtIn, rqEqualsTo, eqNr);
	att = mizMakeConstr(coAttribute, "T", 1);
	attNr = mizPushConstr(env, att);

	b1 = mizNewVarTrm(ikTrmBound, 1);
	b2 = mizNewVarTrm(ikTrmBound, 2);
	c1 = mizNewVarTrm(ikTrmConstant, 1);

	// TrmList
	l2 = mizNewTrmList(b1, mizNewTrmList(b2, mizNil));
	mizCheckEqI(t, "correl.list.len", mizTrmListLength(l2), 2);
	mizCheckEqI(t, "correl.list.nth", mizAsVarNr(mizTrmListNth(l2, 1)), 2);
	l3 = mizAddToTrmList(mizCopyTrmList(l2), c1);
	mizCheckEqI(t, "correl.list.append", mizTrmListLength(l3), 3);
	mizCheckEqI(t, "correl.list.drop", mizTrmListLength(mizTrmListDrop(l3, 1)), 2);

	// terms
	ft = mizNewFuncTrm(fNr, l2);
	mizCheckEqI(t, "correl.trm.sort", mizTrmSort(ft), ikTrmFunctor);
	mizCheck(t, "correl.trm.incor", mizTrmSort(mizNewFuncTrm(0, mizNil)) == ikError);
	mizCheckEqI(t, "correl.trm.size", mizSizeOfTrm(ft), 3);

	// g(c1, b1, b2) must EQUAL f(b1, b2) after adjustment (skip 1 superfluous)
	gt = mizNewFuncTrm(gNr, mizNewTrmList(c1, mizCopyTrmList(l2)));
	mizCheck(t, "correl.eq.adjusted", mizEqTrm(env, gt, ft));
	// but structurally (Compare) they differ
	mizCheck(t, "correl.cmp.structural", mizCompareTrms(gt, ft) != 0);

	// copy is deep: mutating the copy leaves the original intact
	ftc = mizCopyTrm(ft);
	mizCheck(t, "correl.copy.eq", mizEqTrm(env, ft, ftc) && mizCompareTrms(ft, ftc) == 0);

	// formulas: equality predicate is symmetric under EqFrm
	eqAB = mizNewEqFrm(env, mizCopyTrm(b1), mizCopyTrm(b2));
	eqBA = mizNewEqFrm(env, mizCopyTrm(b2), mizCopyTrm(b1));
	mizCheck(t, "correl.eqfrm.symm", mizEqFrm(env, eqAB, eqBA));
	// non-equality predicate is not symmetric: use attr formula
	aAB = mizNewPredFrm(ikFrmAttr, attNr, mizNewTrmList(mizCopyTrm(b1), mizNil), 0);
	aBA = mizNewPredFrm(ikFrmAttr, attNr, mizNewTrmList(mizCopyTrm(b2), mizNil), 0);
	mizCheck(t, "correl.attrfrm.noteq", !mizEqFrm(env, aAB, aBA));

	// NewNeg collapses double negation
	n1 = mizNewNeg(eqAB);
	n2 = mizNewNeg(n1);
	mizCheck(t, "correl.neg.collapse", mizFrmSort(n1) == ikFrmNeg && mizEqFrm(env, n2, eqAB));

	// NewConj flattens
	cj = mizNewConj(mizNewConj(mizCopyFrm(eqAB), mizCopyFrm(eqBA)), mizCopyFrm(eqAB));
	switch (cj) {
		MizConjFrm(conjuncts, __): mizCheckEqI(t, "correl.conj.flatten", sizeVector(conjuncts), 3);
		default: mizCheck(t, "correl.conj.flatten", false);
	}
	mizCheck(t, "correl.conj.verum",
		mizFrmSort(mizNewConj(mizNewVerum(), mizCopyFrm(eqAB))) == ikFrmPred);

	// EqFrm on conj with different nesting (flattening comparison)
	cA = mizNewConj(mizCopyFrm(eqAB), mizNewConj(mizCopyFrm(eqBA), mizCopyFrm(eqAB)));
	vB : Vector<MizFrm> = makeVector(3);
	pushVector(vB, mizCopyFrm(eqAB));
	pushVector(vB, mizCopyFrm(eqBA));
	pushVector(vB, mizCopyFrm(eqAB));
	cB = mizNewConjFrm(vB);
	mizCheck(t, "correl.conj.eq", mizEqFrm(env, cA, cB));

	// types: mode typ with cluster; EqTyp via adjusted mode
	m1 = mizMakeConstr(coMode, "H", 1);
	mNr = mizPushConstr(env, m1);
	ty1 = mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(), mNr, mizNil);
	ty2 = mizCopyTyp(ty1);
	mizCheck(t, "correl.typ.eq", mizEqTyp(env, ty1, ty2));
	mizCheck(t, "correl.typ.cmp", mizCompareTyps(ty1, ty2) == 0);

	// walker: rename bound var 1 -> constant 7 (ChangeToConst pattern)
	w = mizMakeWithin(\__, trm -> {
		switch (trm) {
			MizVarTrm(srt, varNr, __, __): {
				if (srt == ikTrmBound && varNr == 1) mizNewVarTrm(ikTrmConstant, 7)
				else trm;
			}
			default: trm;
		}
	});
	ft2 = mizCopyTrm(ft);
	__unused = mizWithinTrm(w, ft2);
	a0 = mizTrmListNth(mizAsArgs(ft2), 0);
	mizCheck(t, "correl.within.replace",
		mizTrmSort(a0) == ikTrmConstant && mizAsVarNr(a0) == 7);
	a1 = mizTrmListNth(mizAsArgs(ft2), 1);
	mizCheck(t, "correl.within.keep", mizTrmSort(a1) == ikTrmBound);

	// univ walker: incBound counts binders
	depth = ref -1;
	w2 = mizMakeWithin(\ww, trm -> {
		switch (trm) {
			MizVarTrm(srt, __, __, __): {
				if (srt == ikTrmBound) depth := ww.boundVarNbr;
				trm;
			}
			default: trm;
		}
	});
	w2.incBound ::= true;
	uf = mizNewUniv(mizCopyTyp(ty1), mizNewUniv(mizCopyTyp(ty1),
		mizNewPredFrm(ikFrmAttr, attNr, mizNewTrmList(mizCopyTrm(b1), mizNil), 0)));
	mizWithinFrm(w2, uf);
	mizCheckEqI(t, "correl.within.bound.depth", ^depth, 2);
}

// small local accessors for the test
mizAsVarNr(t : MizTrm) -> int {
	switch (t) {
		MizVarTrm(__, varNr, __, __): varNr;
		default: -1;
	}
}

mizAsArgs(t : MizTrm) -> MizTrmList {
	switch (t) {
		MizFuncTrm(__, __, args, __, __): args;
		default: mizNil;
	}
}

