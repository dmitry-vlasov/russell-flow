// M4 gate 2 — the ANALYZER. Runs the chain in one process through the real
// driver (verfinit.flow, MSMVerifyArticle with AnalyzerOnly set):
//   .miz --parser--> WSM --MSM--> MSM --Transfer2Analyzer--> .par
//        --Analyze--> .xml
// and writes the report to `out=<file>` for a byte compare against
// ~/mizar_oracle/m4ref/<article>.xml.

import mizar/original/verfinit;
import net/url_parameter;
import sys/system;
import fs/filesystem;
import string;
import runtime;

main() {
	mmlRoot = getUrlParameterDef("mml", "/home/dmitry/dev/math/MML-test");
	mml = mmlRoot + "/mml";
	a = getUrlParameterDef("article", "xboole_0");
	out = getUrlParameterDef("out", "/tmp/port.xml");
	mizFiles = getUrlParameterDef("mizfiles", "/usr/local/share/mizar/");

	r = mizMSMVerifyArticle(mml, a, mizFiles, mizFileEnvLoader(mml, a),
		false, false, true); // AnalyzerOnly

	ok = setFileContentBytes(out, r.xml);
	if (!ok) println("cannot write " + out);
	if (r.stoppedAt != 0) println("stopped at kind " + i2s(r.stoppedAt));
	if (getUrlParameterDef("errs", "") == "1") {
		println("errors " + i2s(r.eh.errorNbr));
		print(mizErrors2s(r.eh));
	}
	quit(0);
}
