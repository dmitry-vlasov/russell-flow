// Component test for mizar/original/prechecker.flow — the DNF normal form.

import mizar/original/correl;
import mizar/original/correl_inst;
import mizar/original/prechecker;
import mizar/original/lexicon;
import mizar/original/builtin;
import mizar/original/mobjects;
import mizar/original/test/test_utils;
import ds/vector;

export {
	runPrecheckerTests(t : MizTest) -> void;
}

runPrecheckerTests(t : MizTest) -> void {
	env = mizMakeCorrelEnv();
	// mode M1 (Any), preds P/1 (nr 1), Q/1 (nr 2)
	m1 = mizMakeConstr(coMode, "H", 1);
	m1nr = mizPushConstr(env, m1);
	mizSetBuiltIn(env.builtIn, rqAny, m1nr);
	pP = mizPushConstr(env, mizMakeConstr(coPredicate, "T", 1));
	pQ = mizPushConstr(env, mizMakeConstr(coPredicate, "T", 2));
	tyM = \ -> mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(), m1nr, mizNil);
	pA = \nr, trm -> mizNewPredFrm(ikFrmPred, nr, mizNewTrmList(trm, mizNil), 0);
	c1 = \ -> mizNewVarTrm(ikTrmConstant, 1);

	// --- lattice basics ---
	a1 = mizInitNatFunc(2); mizNatAssign(a1, 0, 1);
	a0 = mizInitNatFunc(2); mizNatAssign(a0, 0, 0);
	b1 = mizInitNatFunc(2); mizNatAssign(b1, 1, 1);
	pre0 = mizMakePre(env);
	pj = mizPreInstSingle(mizCopyNatFunc(a1));
	qj = mizPreInstSingle(mizCopyNatFunc(b1));
	mizPreInstJoinWith(pre0, pj, qj);
	mizCheck(t, "pre.join.merge", mizPreInstCount(pj) == 1
		&& mizNatCount(getVectorUnsafe(pj.evals, 0)) == 2);
	pk = mizPreInstSingle(mizCopyNatFunc(a1));
	qk = mizPreInstSingle(mizCopyNatFunc(a0));
	mizPreInstJoinWith(pre0, pk, qk);
	mizCheckEqI(t, "pre.join.contradiction", mizPreInstCount(pk), 0);
	// absorption: {A} ∪ {A,B} keeps only {A} (weaker absorbs)
	pu = mizPreInstSingle(mizCopyNatFunc(a1));
	ab = mizCopyNatFunc(a1); mizNatAssign(ab, 1, 1);
	qu = mizPreInstSingle(ab);
	mizPreInstUnionWith(pre0, pu, qu);
	mizCheck(t, "pre.union.absorb", mizPreInstCount(pu) == 1
		&& mizNatCount(getVectorUnsafe(pu.evals, 0)) == 1);

	// --- PreCheck: ¬(P(c) ∧ Q(c)) -> two disjuncts, one negative literal each ---
	pre1 = mizMakePre(env);
	f1 = mizNewNeg(mizNewConj(pA(pP, c1()), pA(pQ, c1())));
	inf1 : Vector<MizFrm> = makeVector(1);
	pushVector(inf1, f1);
	nf1 = mizPreCheck(pre1, inf1);
	mizCheckEqI(t, "pre.check.disjuncts", mizPreInstCount(nf1), 2);
	mizCheckEqI(t, "pre.check.basic", sizeVector(pre1.basic), 2);
	if (mizPreInstCount(nf1) == 2) {
		e0 : MizNatFunc = getVectorUnsafe(nf1.evals, 0);
		mizCheck(t, "pre.check.neg", mizNatCount(e0) == 1
			&& mizNatValue(e0, mizNatItem(e0, 0).x) == 0);
	}

	// --- contradiction P(c) ∧ ¬P(c) -> empty normal form (already refuted) ---
	pre2 = mizMakePre(env);
	inf2 : Vector<MizFrm> = makeVector(2);
	pushVector(inf2, pA(pP, c1()));
	pushVector(inf2, mizNewNeg(pA(pP, c1())));
	nf2 = mizPreCheck(pre2, inf2);
	mizCheckEqI(t, "pre.check.contradiction", mizPreInstCount(nf2), 0);

	// --- positive universal premise survives as one Basic literal ---
	pre3 = mizMakePre(env);
	u3 = mizNewUniv(tyM(), pA(pP, mizNewVarTrm(ikTrmBound, 1)));
	inf3 : Vector<MizFrm> = makeVector(1);
	pushVector(inf3, u3);
	nf3 = mizPreCheck(pre3, inf3);
	mizCheckEqI(t, "pre.univ.disjuncts", mizPreInstCount(nf3), 1);
	mizCheck(t, "pre.univ.literal", sizeVector(pre3.basic) == 1
		&& mizFrmSort(getVectorUnsafe(pre3.basic, 0)) == ikFrmUniv);

	// --- ¬∀x P(x): skolemized to ¬P(const) with a FRESH constant ---
	base = env.fixedVarNbr;
	pre4 = mizMakePre(env);
	u4 = mizNewNeg(mizNewUniv(tyM(), pA(pP, mizNewVarTrm(ikTrmBound, 1))));
	inf4 : Vector<MizFrm> = makeVector(1);
	pushVector(inf4, u4);
	nf4 = mizPreCheck(pre4, inf4);
	mizCheckEqI(t, "pre.skolem.disjuncts", mizPreInstCount(nf4), 1);
	mizCheckEqI(t, "pre.skolem.newconst", env.fixedVarNbr, base + 1);
	if (sizeVector(pre4.basic) == 1) {
		switch (getVectorUnsafe(pre4.basic, 0)) {
			MizPredFrm(__, __, args, __): {
				arg = mizTrmListNth(args, 0);
				switch (arg) {
					MizVarTrm(srt, varNr, __, __):
						mizCheck(t, "pre.skolem.constant",
							srt == ikTrmConstant && varNr == base + 1);
					default: mizCheck(t, "pre.skolem.constant", false);
				}
			}
			default: mizCheck(t, "pre.skolem.constant", false);
		}
	} else {
		mizCheck(t, "pre.skolem.constant", false);
	}

	// --- CreateInference: negative Qual with an attribute splits ---
	// attribute V1 on M1 with constructor type M1
	v1 = mizMakeConstr(coAttribute, "T", 1);
	v1.typ ::= Some(tyM());
	v1nr = mizPushConstr(env, v1);
	pre5 = mizMakePre(env);
	lower = mizNewEmptyCluster();
	mizAttrCollInsert(env, lower, MizAttr(1, v1nr, mizNil, false, 0));
	tyAttr = MizTyp(ikTypMode, lower, mizCopyCluster(lower), m1nr, mizNil, 0);
	q5 = mizNewNeg(mizNewQualFrm(c1(), tyAttr));
	inf5 : Vector<MizFrm> = makeVector(1);
	pushVector(inf5, q5);
	nf5 = mizPreCheck(pre5, inf5);
	// ¬(c is V1-M1) -> either ¬(c is M1-bare) or (c is (¬V1)-M1)
	mizCheckEqI(t, "pre.qualsplit.disjuncts", mizPreInstCount(nf5), 2);
	mizCheckEqI(t, "pre.qualsplit.basic", sizeVector(pre5.basic), 3);
}

