// M3 gate: dump the token stream of an article in the same shape as the
// ORIGINAL's ReadToken tap (mscanner.pas 642, under -dMDEBUG):
//     TOK <kindcode> <nr> "<spelling>" <line>:<col>
// so the two can be diffed line for line.
//
//   java -jar test_scanner.jar article=<name> [mml=<dir>]

import runtime;
import string;
import net/url_parameter;
import fs/filesystem;
import ds/vector;
import mizar/original/scanner;

main() {
	article = getUrlParameterDef("article", "");
	mml = getUrlParameterDef("mml", "/home/dmitry/dev/math/MML-test") + "/mml";
	if (article == "") {
		println("usage: test_scanner article=<name> [mml=<dir>]");
		quit(1);
	} else {
		sc = mizInitScanning(mml + "/" + article + ".miz", mml + "/" + article + ".dct");
		// the parser's ReadToken keeps a one-token lookahead: CurWord is the
		// token BEFORE the one the scanner just produced. The dump prints
		// CurWord, so replay that pipeline: prev <- cur <- ahead.
		cur = ref MizScLexem(32, 0, "", 0, 0);
		ahead = ref sc.lexem;
		go = ref true;
		n = ref 0;
		while(\ -> ^go, \ -> {
			cur := ^ahead;
			// '_' stops being an identifier letter at `begin` (mscanner.pas 650)
			if ((^cur).kind == 178) mizScAllowUnderscore(sc, false);  // sy_begin
			println("TOK " + i2s((^cur).kind) + " " + i2s((^cur).nr)
				+ " \"" + (^cur).spelling + "\" "
				+ i2s((^cur).line) + ":" + i2s((^cur).col));
			n := ^n + 1;
			if ((^cur).kind == mizScEOT) {
				go := false;
			} else {
				mizScGetToken(sc);
				ahead := sc.lexem;
			}
		});
		quit(0);
	}
}
