// Component test for mizar/original/identify.flow — constant collection.

import mizar/original/correl;
import mizar/original/correl_inst;
import mizar/original/correl_match;
import mizar/original/identify;
import mizar/original/numbers;
import mizar/original/roundcl;
import mizar/original/lexicon;
import mizar/original/builtin;
import mizar/original/mobjects;
import mizar/original/test/test_utils;
import ds/vector;

export {
	runIdentifyTests(t : MizTest) -> void;
}

runIdentifyTests(t : MizTest) -> void {
	env = mizMakeCorrelEnv();
	cl = mizMakeClusters();
	mizWireRoundcl(env, cl);
	mk = \nr -> mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(), nr, mizNil);
	m1 = mizMakeConstr(coMode, "H", 1);
	m1nr = mizPushConstr(env, m1);
	mizSetBuiltIn(env.builtIn, rqAny, m1nr);
	env.nonZeroTyp ::= mk(m1nr);
	fC = mizMakeConstr(coFunctor, "T", 1);
	fC.typ ::= Some(mk(m1nr));
	fNr = mizPushConstr(env, fC);
	gC = mizMakeConstr(coFunctor, "T", 2);
	gC.typ ::= Some(mk(m1nr));
	gNr = mizPushConstr(env, gC);
	pP = mizPushConstr(env, mizMakeConstr(coPredicate, "T", 1));
	// FixedVar c1 : M1
	env.fixedVarNbr ::= 1;
	pushVector(env.fixedVar, MizFixedVar(0, mk(m1nr), false, None(), 0));

	idn = mizMakeIdentify(env);
	c1 = \ -> mizNewVarTrm(ikTrmConstant, 1);
	fT = \ -> mizNewFuncTrm(fNr, mizNewTrmList(c1(), mizNil));

	// two occurrences of f(c1) intern to the SAME InfConst
	frm1 = mizNewPredFrm(ikFrmPred, pP, mizNewTrmList(fT(), mizNil), 0);
	frm2 = mizNewPredFrm(ikFrmPred, pP, mizNewTrmList(fT(), mizNil), 0);
	mizCollectConstInFrm(idn, frm1);
	mizCollectConstInFrm(idn, frm2);
	getArg = \f : MizFrm -> {
		switch (f) {
			MizPredFrm(__, __, args, __): mizTrmListNth(args, 0);
			default: mizNewIncorTrm();
		}
	};
	a1 = getArg(frm1);
	a2 = getArg(frm2);
	nrOf = \tm : MizTrm -> switch (tm) { MizVarTrm(__, varNr, __, __): varNr; default: -1; };
	mizCheck(t, "identify.interned",
		mizTrmSort(a1) == ikTrmInfConst && mizTrmSort(a2) == ikTrmInfConst);
	mizCheckEqI(t, "identify.shared", nrOf(a1), nrOf(a2));
	// c1 itself was interned first (argument before the functor term)
	mizCheckEqI(t, "identify.count", sizeVector(env.inferConstDef), 2);

	// g(c1, c1): argument occurrences point at the SAME InfConst as before
	gT = mizNewFuncTrm(gNr, mizNewTrmList(c1(), mizNewTrmList(c1(), mizNil)));
	frm3 = mizNewPredFrm(ikFrmPred, pP, mizNewTrmList(gT, mizNil), 0);
	mizCollectConstInFrm(idn, frm3);
	mizCheckEqI(t, "identify.count.g", sizeVector(env.inferConstDef), 3);

	// EsTrm (matching) sees through InfConst definitions; EqTrm does NOT
	// chase mixed sorts — that is the original's behavior too.
	mizCheck(t, "identify.es.through", mizEsTrm(env, fT(), a1));

	// numerals get numeric values
	numFrm = mizNewPredFrm(ikFrmPred, pP,
		mizNewTrmList(mizNewVarTrm(ikTrmNumeral, 5), mizNil), 0);
	mizCollectConstInFrm(idn, numFrm);
	n5 = getArg(numFrm);
	mizCheck(t, "identify.numeral", mizTrmSort(n5) == ikTrmInfConst);
	switch (mizNumericValue(idn, nrOf(n5))) {
		Some(v): mizCheck(t, "identify.numeral.value", mizCplxEqInt(v, 5));
		None(): mizCheck(t, "identify.numeral.value", false);
	}

	// a term under a binder is NOT collected
	uf = mizNewUniv(mk(m1nr), mizNewPredFrm(ikFrmPred, pP,
		mizNewTrmList(mizNewFuncTrm(fNr,
			mizNewTrmList(mizNewVarTrm(ikTrmBound, 1), mizNil)), mizNil), 0));
	nBefore = sizeVector(env.inferConstDef);
	mizCollectConstInFrm(idn, uf);
	mizCheckEqI(t, "identify.bound.skipped", sizeVector(env.inferConstDef), nBefore);

	// the InfConst's type is the constructor's result type
	cd : MizConstDef = getVectorUnsafe(env.inferConstDef, nrOf(a1));
	mizCheckEqI(t, "identify.typ", cd.typ.modNr, m1nr);
}

