// Component test for mizar/original/iocorrel.flow against the real MML
// working copy: load xboole_0.atr constructors, then read EVERY Proposition
// formula in xboole_0.xml and check copy/equality roundtrips.

import mizar/original/iocorrel;
import mizar/original/correl;
import mizar/original/xml_parser;
import mizar/original/test/test_utils;
import fs/filesystem;
import ds/vector;
import loop;

export {
	runIocorrelTests(t : MizTest) -> void;
}

runIocorrelTests(t : MizTest) -> void {
	atrPath = mizTestMml() + "/mml/xboole_0.atr";
	xmlPath = mizTestMml() + "/mml/xboole_0.xml";
	if (!fileExists(atrPath) || !fileExists(xmlPath)) {
		println("SKIP iocorrel.*: MML-test files not found");
	} else {
		env = mizMakeCorrelEnv();
		r0 = mizMakeVrfReader(mizXmlInitParsing(""), env);
		mizLoadConstructors(r0, getFileContent(atrPath));
		// ground truth: grep kind counts in xboole_0.atr
		mizCheckEqI(t, "iocorrel.atr.functors", mizConstrCount(env, coFunctor), 4);
		mizCheckEqI(t, "iocorrel.atr.modes", mizConstrCount(env, coMode), 2);
		mizCheckEqI(t, "iocorrel.atr.preds", mizConstrCount(env, coPredicate), 5);
		// TARSKI K2 (union of two sets) carries Commutativity
		k2 = mizConstr(env, coFunctor, 2);
		mizCheck(t, "iocorrel.atr.commut", mizHasProperty(k2, syCommutativity));
		mizCheckEqI(t, "iocorrel.atr.k2.args", sizeVector(k2.primaries), 2);
		mizCheck(t, "iocorrel.atr.k2.typ", isSome(k2.typ));

		// read every Proposition formula in the analyzer report; the article's
		// OWN constructors appear inline as <Constructor> and must be ingested
		// as they come (the .atr carries only the imported signature)
		x = mizXmlInitParsingFile(xmlPath);
		r = mizMakeVrfReader(x, env);
		nProps = ref 0;
		nOk = ref 0;
		nOwnConstrs = ref 0;
		mizXmlNextElementState(x);
		while(\ -> x.nCurTokenKind != MizXTEOTX, \ -> {
			if (x.nState == MizEStart && x.nElName == "Constructor") {
				c = mizInConstructor1(r);
				mizPushConstr(env, c);
				nOwnConstrs := ^nOwnConstrs + 1;
				// the reader already advanced past the element
			} else if (x.nState == MizEStart && x.nElName == "Proposition") {
				nProps := ^nProps + 1;
				mizXmlNextElementState(x); // into the formula
				f = mizInFormula(r);
				// after the formula the parser stands at </Proposition>
				okEnd = x.nState == MizEEnd;
				okEq = mizEqFrm(env, f, mizCopyFrm(f));
				// NOTE: CompareFrms is NOT reflexive on PrivPred-containing
				// formulas (the original skips PrivPred only on the left) —
				// EqFrm is the real equality, Compare is only an order.
				if (okEnd && okEq) nOk := ^nOk + 1;
			} else {
				mizXmlNextElementState(x);
			}
		});
		mizCheckEqI(t, "iocorrel.xml.ownconstrs", ^nOwnConstrs, 9);
		mizCheckEqI(t, "iocorrel.xml.propositions", ^nProps, 142);
		mizCheckEqI(t, "iocorrel.xml.roundtrip", ^nOk, 142);
		mizCheckEqI(t, "iocorrel.xml.boundbalance", env.boundVarNbr, 0);
	}
}
