// M3 gate 3 — the PARSER. Reads <article>.miz/.dct/.frm/.prf, parses it and
// writes the `.wsx` to stdout, for a byte compare against ~/mizar_oracle/m3ref.

import mizar/original/test/test_utils;
import mizar/original/errhan;
import mizar/original/scanner;
import mizar/original/formats;
import mizar/original/wsm;
import mizar/original/wsm_write;
import mizar/original/parseraddition;
import mizar/original/parser;
import net/url_parameter;
import ds/vector;
import string;
import runtime;

main() {
	mml = mizTestMml() + "/mml";
	a = getUrlParameterDef("article", "numerals");
	base = mml + "/" + a;
	eh = mizMakeErrHan();
	sc = mizInitScanning(base + ".miz", base + ".dct");
	formats = mizLoadFormats(base + ".frm");
	prf = mizLoadPrf(base + ".prf");
	p = mizMakeParser(eh, sc, formats, prf, toUpperCase(a), ".miz");
	mizStartScanner(p);
	mizCreateBlock(p, mizBlMain);
	mizParse(p);
	// the scanner's identifier collection is SORTED by spelling; the identifier
	// NUMBER is the insertion order, and that is what the .wsx records.
	byNr : Vector<string> = makeVector(sizeVector(sc.idents) + 1);
	fori(0, sizeVector(sc.idents) - 1, \__ -> pushVector(byNr, ""));
	iterVector(sc.idents, \t -> setVector(byNr, t.nr - 1, t.spelling));
	idents = vector2array(byNr);
	names = mizWsInitScannerNames(base + ".dct", idents);
	print(mizWriteWSMizArticle(p.textProper, names));
	quit(0);
}
