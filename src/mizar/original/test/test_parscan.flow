// Gate for the `.par` INPUT STREAM (generato.flow's MizInStream): scan the
// whole file token by token with InWord until the terminating '!' and report
// how many tokens were read and how many bytes are left over.
//
// A correct scan ends with the cursor on the last byte of the file: '!' is the
// last thing Transfer2Analyzer wrote. Anything else means the capital-letter
// rule or the number reader is off, and the analyzer would then read garbage.

import mizar/original/test/test_utils;
import mizar/original/errhan;
import mizar/original/generato;
import net/url_parameter;
import sys/system;
import string;
import runtime;

main() {
	mml = mizTestMml() + "/mml";
	a = getUrlParameterDef("article", "xboole_0");
	par = getUrlParameterDef("par", mml + "/" + a + ".par");
	content = getFileContentBinary(par);
	eh = mizMakeErrHan();
	s = mizInOpen(content, eh);
	n = ref 0;
	mizInWord(s);
	while(\ -> s.curKind != 33, \ -> {   // '!'
		n := ^n + 1;
		mizInWord(s);
	});
	println("tokens " + i2s(^n) + " consumed " + i2s(s.ind)
		+ " of " + i2s(strlen(content)));
	quit(0);
}
