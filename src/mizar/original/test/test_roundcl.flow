// Component test for mizar/original/roundcl.flow — cluster rounding-up.
// Hierarchy: M1 Any; M2 set -> M1. Attributes V1, V2, V3 on M2.
// Conditional: V1(M2) -> V2; V2(M2) -> V3 (chained firing).
// Functor: K0() -> M2 with functor cluster asserting V1 on K0().

import mizar/original/correl;
import mizar/original/correl_inst;
import mizar/original/correl_match;
import mizar/original/roundcl;
import mizar/original/lexicon;
import mizar/original/builtin;
import mizar/original/test/test_utils;
import ds/vector;

export {
	runRoundclTests(t : MizTest) -> void;
}

runRoundclTests(t : MizTest) -> void {
	env = mizMakeCorrelEnv();
	mk = \nr -> mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(), nr, mizNil);
	m1 = mizMakeConstr(coMode, "H", 1);
	m1nr = mizPushConstr(env, m1);
	mizSetBuiltIn(env.builtIn, rqAny, m1nr);
	m2 = mizMakeConstr(coMode, "H", 2);
	m2.typ ::= Some(mk(m1nr));
	m2nr = mizPushConstr(env, m2);
	mizSetBuiltIn(env.builtIn, rqSetMode, m2nr);
	mkAttr = \ -> {
		v = mizMakeConstr(coAttribute, "T", 0);
		v.typ ::= Some(mk(m2nr));
		mizPushConstr(env, v);
	};
	v1 = mkAttr();
	v2 = mkAttr();
	v3 = mkAttr();
	k0c = mizMakeConstr(coFunctor, "T", 1);
	k0c.typ ::= Some(mk(m2nr));
	k0 = mizPushConstr(env, k0c);

	cl = mizMakeClusters();
	mizWireRoundcl(env, cl);

	att = \nr, neg -> MizAttr(neg, nr, mizNil, false, 0);
	clOf = \attrs : [MizAttr] -> {
		c = mizNewEmptyCluster();
		iter(attrs, \a -> mizAttrCollInsert(env, c, a));
		c;
	};

	// conditional clusters: V1 -> V2, then V2 -> V3
	mizInsertCCluster(env, cl, MizCCluster("T", 1, makeVector(0),
		clOf([att(v1, 1)]), MizClusterRec(clOf([att(v2, 1)]), clOf([att(v2, 1)])), mk(m2nr)));
	mizInsertCCluster(env, cl, MizCCluster("T", 2, makeVector(0),
		clOf([att(v2, 1)]), MizClusterRec(clOf([att(v3, 1)]), clOf([att(v3, 1)])), mk(m2nr)));

	// round up a cluster containing V1 on a type M2: gains V2 AND V3
	c0 = clOf([att(v1, 1)]);
	ty2 = mk(m2nr);
	mizRoundUpCluster(env, cl, c0, ty2);
	mizCheckEqI(t, "roundcl.chain.count", sizeVector(c0.items), 3);
	has = \c : MizAttrColl, nr : int -> {
		found = ref false;
		iterVector(c.items, \a -> if (a.attrNr == nr && a.neg == 1) found := true);
		^found;
	};
	mizCheck(t, "roundcl.chain.v2", has(c0, v2));
	mizCheck(t, "roundcl.chain.v3", has(c0, v3));
	mizCheck(t, "roundcl.consistent", c0.consistent);

	// contradiction: cluster with ¬V2 and V1 -> firing V1->V2 refutes it
	c1 = clOf([att(v1, 1), att(v2, 0)]);
	mizRoundUpCluster(env, cl, c1, mk(m2nr));
	mizCheck(t, "roundcl.refuted", !c1.consistent);

	// functor cluster: K0() is V1 => RoundUpTrmType(K0()) has V1..V3 in upper
	mizInsertFCluster(env, cl, MizFCluster("T", 1, makeVector(0),
		MizClusterRec(clOf([att(v1, 1)]), clOf([att(v1, 1)])),
		mizNewFuncTrm(k0, mizNil), None()));
	tyK = mizRoundUpTrmType(env, cl, mizNewFuncTrm(k0, mizNil));
	mizCheck(t, "roundcl.functor.v1", has(tyK.upper, v1));
	mizCheck(t, "roundcl.functor.v2", has(tyK.upper, v2));
	mizCheck(t, "roundcl.functor.v3", has(tyK.upper, v3));
	mizCheckEqI(t, "roundcl.functor.modnr", tyK.modNr, m2nr);

	// a term of an unrelated functor is untouched
	kOther = mizPushConstr(env, {
		c = mizMakeConstr(coFunctor, "T", 2);
		c.typ ::= Some(mk(m2nr));
		c;
	});
	tyO = mizRoundUpTrmType(env, cl, mizNewFuncTrm(kOther, mizNil));
	mizCheckEqI(t, "roundcl.other.untouched", sizeVector(tyO.upper.items), 0);
}
