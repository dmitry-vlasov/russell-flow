// The INTEGRATION test suite for src/mizar/original — runs every component
// test. Every finished phase must be confirmed by running this suite:
//
//   src/mizar/original/build.sh test    (or: flowc1 jar=1 mizar/original/test/test_all)
//
// Exit code 0 = all green.

import mizar/original/test/test_utils;
import mizar/original/test/test_mobjects;
import mizar/original/test/test_xml_parser;

main() {
	t = mizMakeTest();

	runMobjectsTests(t);
	runXmlParserTests(t);

	mizTestSummary(t, "mizar/original");
	mizTestExit(t);
}
