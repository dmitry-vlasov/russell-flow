// The COMPONENT test suite for src/mizar/original — every unit test, in one
// program. Every finished phase must be confirmed by running it:
//
//   test/test.sh                 all component suites
//   test/test.sh correl          ONE suite (test.sh passes suite=correl)
//
// The whole-MML integration test is a separate program, test_verifier.flow.
// Exit code 0 = all green.
//
// One program rather than one per unit ON PURPOSE: the port is built on
// flow9's Vector, whose natives exist only in the java runtime
// (ds/vector.flow:10), so every test has to be compiled to a jar — and one
// jar for all the units beats twenty.

import mizar/original/test/test_utils;
import mizar/original/test/test_mobjects;
import mizar/original/test/test_numbers;
import mizar/original/test/test_xml_parser;
import mizar/original/test/test_correl;
import mizar/original/test/test_iocorrel;
import mizar/original/test/test_correl_inst;
import mizar/original/test/test_prechecker;
import mizar/original/test/test_roundcl;
import mizar/original/test/test_identify;
import mizar/original/test/test_equalizer;
import mizar/original/test/test_checker;
import mizar/original/test/test_mml;
import mizar/original/test/test_accom;
import net/url_parameter;
import runtime;
import string;

// suite name -> the unit's entry point. `test.sh <name>` selects one.
mizTestSuites() -> [Pair<string, (MizTest) -> void>] {
	[
		Pair("mobjects", runMobjectsTests),
		Pair("numbers", runNumbersTests),
		Pair("xml_parser", runXmlParserTests),
		Pair("correl", runCorrelTests),
		Pair("iocorrel", runIocorrelTests),
		Pair("correl_inst", runCorrelInstTests),
		Pair("prechecker", runPrecheckerTests),
		Pair("roundcl", runRoundclTests),
		Pair("identify", runIdentifyTests),
		Pair("equalizer", runEqualizerTests),
		Pair("checker", runCheckerTests),
		Pair("mml", runMmlTests),
		Pair("accom", runAccomTests),
	];
}

main() {
	t = mizMakeTest();
	suites = mizTestSuites();
	only = getUrlParameterDef("suite", "");

	if (only == "") {
		iter(suites, \s -> s.second(t));
		mizTestSummary(t, "mizar/original");
	} else {
		chosen = filter(suites, \s -> s.first == only);
		if (chosen == []) {
			println("no such suite: " + only);
			println("suites: " + strGlue(map(suites, \s -> s.first), " "));
			quit(1);
		} else {
			iter(chosen, \s -> s.second(t));
			mizTestSummary(t, only);
		}
	}
	mizTestExit(t);
}
