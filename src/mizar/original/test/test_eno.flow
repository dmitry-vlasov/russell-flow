// Smoke test for In_Pattern: read an article's `.eno` (the accommodated
// notations) and report how many patterns of each kind it holds. The count is
// checked against a plain grep of the file by the caller — the only cheap gate
// available before the analyzer runs.

import mizar/original/errhan;
import mizar/original/xml_parser;
import mizar/original/correl;
import mizar/original/correl_patt;
import mizar/original/iocorrel;
import mizar/original/enums;
import net/url_parameter;
import ds/vector;
import sys/system;
import string;
import loop;
import runtime;

main() {
	mml = getUrlParameterDef("mml", "/home/dmitry/dev/math/MML-test") + "/mml";
	a = getUrlParameterDef("article", "xboole_0");
	env = mizMakeCorrelEnv();
	x = mizXmlInitParsing(getFileContentBinary(mml + "/" + a + ".eno"));
	r = mizMakeVrfReader(x, env);
	// InEnvFileObj derives from InMMLFileObj — the `.eno` is MML format
	r.mml ::= true;
	mizXmlNextElementState(x);
	mizXmlAssert(x.nElName == "Notations");
	mizXmlNextElementState(x);
	counts = makeVector(mizNotationKindCount);
	fori(0, mizNotationKindCount - 1, \__ -> pushVector(counts, 0));
	total = ref 0;
	while(\ -> x.nState != MizEEnd, \ -> {
		mizXmlAssert(x.nElName == "Pattern");
		p = mizInPattern(r);
		setVectorUnsafe(counts, p.kind, getVectorUnsafe(counts, p.kind) + 1);
		total := ^total + 1;
	});
	println("patterns " + i2s(^total));
	fori(0, mizNotationKindCount - 1, \k ->
		println("  kind " + i2s(k) + " " + i2s(getVectorUnsafe(counts, k))));
	quit(0);
}
