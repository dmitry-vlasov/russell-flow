// Component test for mizar/original/checker.flow — the decision loop.

import mizar/original/correl;
import mizar/original/correl_inst;
import mizar/original/prechecker;
import mizar/original/identify;
import mizar/original/roundcl;
import mizar/original/equalizer;
import mizar/original/checker;
import mizar/original/lexicon;
import mizar/original/builtin;
import mizar/original/mobjects;
import mizar/original/test/test_utils;
import ds/vector;

export {
	runCheckerTests(t : MizTest) -> void;
}

MizChkTestEnv(
	env : MizCorrelEnv,
	chk : MizChecker,
	m1nr : int,
	eqNr : int,
	pP : int,
	ltNr : int,
);

mkChkTestEnv() -> MizChkTestEnv {
	env = mizMakeCorrelEnv();
	cl = mizMakeClusters();
	mizWireRoundcl(env, cl);
	mk = \nr -> mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(), nr, mizNil);
	m1nr = mizPushConstr(env, mizMakeConstr(coMode, "H", 1));
	mizSetBuiltIn(env.builtIn, rqAny, m1nr);
	env.nonZeroTyp ::= mk(m1nr);
	eqC = mizMakeConstr(coPredicate, "H", 1);
	eqC.properties ::= bitOr(bitShl(1, syReflexivity), bitShl(1, sySymmetry));
	eqC.firstArg ::= 1;
	eqC.secondArg ::= 2;
	eqNr = mizPushConstr(env, eqC);
	mizSetBuiltIn(env.builtIn, rqEqualsTo, eqNr);
	pP = mizPushConstr(env, mizMakeConstr(coPredicate, "T", 1));
	// `<` irreflexive on args 1,2
	ltC = mizMakeConstr(coPredicate, "T", 2);
	ltC.properties ::= bitShl(1, syIrreflexivity);
	ltC.firstArg ::= 1;
	ltC.secondArg ::= 2;
	ltNr = mizPushConstr(env, ltC);
	env.fixedVarNbr ::= 2;
	pushVector(env.fixedVar, MizFixedVar(0, mk(m1nr), false, None(), 0));
	pushVector(env.fixedVar, MizFixedVar(0, mk(m1nr), false, None(), 0));
	idn = mizMakeIdentify(env);
	chk = mizMakeChecker(env, idn, cl);
	MizChkTestEnv(env, chk, m1nr, eqNr, pP, ltNr);
}

check(te : MizChkTestEnv, premises : [MizFrm]) -> [int] {
	inf : Vector<MizFrm> = makeVector(4);
	iter(premises, \p -> pushVector(inf, p));
	mizInferenceChecker(te.chk, inf);
	map(enumFromTo(0, mizSeqCount(te.chk.chErrNr) - 1),
		\i -> mizSeqValue(te.chk.chErrNr, i));
}

runCheckerTests(t : MizTest) -> void {
	cT = \n -> mizNewVarTrm(ikTrmConstant, n);
	pair = \a, b -> mizNewTrmList(a, mizNewTrmList(b, mizNil));

	// accepted: a = b, P(a), ¬P(b) refutes
	te1 = mkChkTestEnv();
	eqF = \te : MizChkTestEnv, a, b -> mizNewPredFrm(ikFrmPred, te.eqNr, pair(a, b), 0);
	pA = \te : MizChkTestEnv, trm -> mizNewPredFrm(ikFrmPred, te.pP, mizNewTrmList(trm, mizNil), 0);
	e1 = check(te1, [eqF(te1, cT(1), cT(2)), pA(te1, cT(1)), mizNewNeg(pA(te1, cT(2)))]);
	mizCheckEqI(t, "checker.accepted", length(e1), 0);

	// unsolved: P(a), ¬P(b) -> error 4
	te2 = mkChkTestEnv();
	e2 = check(te2, [pA(te2, cT(1)), mizNewNeg(pA(te2, cT(2)))]);
	mizCheck(t, "checker.unsolved", e2 == [4]);

	// irreflexivity: a < a is refuted alone
	te3 = mkChkTestEnv();
	ltF = \te : MizChkTestEnv, a, b -> mizNewPredFrm(ikFrmPred, te.ltNr, pair(a, b), 0);
	e3 = check(te3, [ltF(te3, cT(1), cT(1))]);
	mizCheckEqI(t, "checker.irreflexive", length(e3), 0);

	// irreflexivity through equality: a = b, a < b
	te4 = mkChkTestEnv();
	e4 = check(te4, [eqF(te4, cT(1), cT(2)), ltF(te4, cT(1), cT(2))]);
	mizCheckEqI(t, "checker.irreflexive.eq", length(e4), 0);

	// per-inference constant release: two checks on the same checker
	te5 = mkChkTestEnv();
	__e5a = check(te5, [pA(te5, cT(1)), mizNewNeg(pA(te5, cT(2)))]);
	nAfterFirst = sizeVector(te5.env.inferConstDef);
	__e5b = check(te5, [pA(te5, cT(1)), mizNewNeg(pA(te5, cT(2)))]);
	mizCheckEqI(t, "checker.const.release", sizeVector(te5.env.inferConstDef), nAfterFirst);
	mizCheckEqI(t, "checker.const.released.all", nAfterFirst, 0);
}
