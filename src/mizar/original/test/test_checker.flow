// Component test for mizar/original/checker.flow — the decision loop.

import mizar/original/correl;
import mizar/original/correl_inst;
import mizar/original/prechecker;
import mizar/original/identify;
import mizar/original/roundcl;
import mizar/original/equalizer;
import mizar/original/checker;
import mizar/original/unifier;
import mizar/original/lexicon;
import mizar/original/builtin;
import mizar/original/mobjects;
import mizar/original/test/test_utils;
import ds/vector;

export {
	runCheckerTests(t : MizTest) -> void;
}

MizChkTestEnv(
	env : MizCorrelEnv,
	chk : MizChecker,
	cl : MizClusters,
	m1nr : int,
	eqNr : int,
	pP : int,
	ltNr : int,
);

mkChkTestEnv() -> MizChkTestEnv {
	env = mizMakeCorrelEnv();
	cl = mizMakeClusters();
	mizWireRoundcl(env, cl);
	mk = \nr -> mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(), nr, mizNil);
	m1nr = mizPushConstr(env, mizMakeConstr(coMode, "H", 1));
	mizSetBuiltIn(env.builtIn, rqAny, m1nr);
	env.nonZeroTyp ::= mk(m1nr);
	eqC = mizMakeConstr(coPredicate, "H", 1);
	eqC.properties ::= bitOr(bitShl(1, syReflexivity), bitShl(1, sySymmetry));
	eqC.firstArg ::= 1;
	eqC.secondArg ::= 2;
	eqNr = mizPushConstr(env, eqC);
	mizSetBuiltIn(env.builtIn, rqEqualsTo, eqNr);
	pP = mizPushConstr(env, mizMakeConstr(coPredicate, "T", 1));
	// `<` irreflexive on args 1,2
	ltC = mizMakeConstr(coPredicate, "T", 2);
	ltC.properties ::= bitShl(1, syIrreflexivity);
	ltC.firstArg ::= 1;
	ltC.secondArg ::= 2;
	ltNr = mizPushConstr(env, ltC);
	env.fixedVarNbr ::= 2;
	pushVector(env.fixedVar, MizFixedVar(0, mk(m1nr), false, None(), 0));
	pushVector(env.fixedVar, MizFixedVar(0, mk(m1nr), false, None(), 0));
	idn = mizMakeIdentify(env);
	chk = mizMakeChecker(env, idn, cl);
	mizWireUnifier(chk);
	MizChkTestEnv(env, chk, cl, m1nr, eqNr, pP, ltNr);
}

check(te : MizChkTestEnv, premises : [MizFrm]) -> [int] {
	inf : Vector<MizFrm> = makeVector(4);
	iter(premises, \p -> pushVector(inf, p));
	mizInferenceChecker(te.chk, inf);
	map(enumFromTo(0, mizSeqCount(te.chk.chErrNr) - 1),
		\i -> mizSeqValue(te.chk.chErrNr, i));
}

runCheckerTests(t : MizTest) -> void {
	cT = \n -> mizNewVarTrm(ikTrmConstant, n);
	pair = \a, b -> mizNewTrmList(a, mizNewTrmList(b, mizNil));

	// accepted: a = b, P(a), ¬P(b) refutes
	te1 = mkChkTestEnv();
	eqF = \te : MizChkTestEnv, a, b -> mizNewPredFrm(ikFrmPred, te.eqNr, pair(a, b), 0);
	pA = \te : MizChkTestEnv, trm -> mizNewPredFrm(ikFrmPred, te.pP, mizNewTrmList(trm, mizNil), 0);
	e1 = check(te1, [eqF(te1, cT(1), cT(2)), pA(te1, cT(1)), mizNewNeg(pA(te1, cT(2)))]);
	mizCheckEqI(t, "checker.accepted", length(e1), 0);

	// unsolved: P(a), ¬P(b) -> error 4
	te2 = mkChkTestEnv();
	e2 = check(te2, [pA(te2, cT(1)), mizNewNeg(pA(te2, cT(2)))]);
	mizCheck(t, "checker.unsolved", e2 == [4]);

	// irreflexivity: a < a is refuted alone
	te3 = mkChkTestEnv();
	ltF = \te : MizChkTestEnv, a, b -> mizNewPredFrm(ikFrmPred, te.ltNr, pair(a, b), 0);
	e3 = check(te3, [ltF(te3, cT(1), cT(1))]);
	mizCheckEqI(t, "checker.irreflexive", length(e3), 0);

	// irreflexivity through equality: a = b, a < b
	te4 = mkChkTestEnv();
	e4 = check(te4, [eqF(te4, cT(1), cT(2)), ltF(te4, cT(1), cT(2))]);
	mizCheckEqI(t, "checker.irreflexive.eq", length(e4), 0);

	// UNIFIER: universal instantiation — for x:M holds P(x); ¬P(a) refutes
	te6 = mkChkTestEnv();
	tyM6 = mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(), te6.m1nr, mizNil);
	u6 = mizNewUniv(tyM6, pA(te6, mizNewVarTrm(ikTrmBound, 1)));
	e6 = check(te6, [u6, mizNewNeg(pA(te6, cT(1)))]);
	mizCheckEqI(t, "checker.unifier.instantiation", length(e6), 0);

	// unifier does NOT fabricate: for x holds P(x); ¬Q(a) stays unsolved
	te7 = mkChkTestEnv();
	qP7 = mizPushConstr(te7.env, mizMakeConstr(coPredicate, "T", 9));
	tyM7 = mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(), te7.m1nr, mizNil);
	u7 = mizNewUniv(tyM7, pA(te7, mizNewVarTrm(ikTrmBound, 1)));
	e7 = check(te7, [u7,
		mizNewNeg(mizNewPredFrm(ikFrmPred, qP7, mizNewTrmList(cT(1), mizNil), 0))]);
	mizCheck(t, "checker.unifier.open", e7 == [4]);

	// universal with a functor body: for x holds P(f(x)); ¬P(f(a))
	te8 = mkChkTestEnv();
	tyM8 = mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(), te8.m1nr, mizNil);
	fC8 = mizMakeConstr(coFunctor, "T", 5);
	fC8.typ ::= Some(mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(), te8.m1nr, mizNil));
	f8 = mizPushConstr(te8.env, fC8);
	u8 = mizNewUniv(tyM8, pA(te8, mizNewFuncTrm(f8,
		mizNewTrmList(mizNewVarTrm(ikTrmBound, 1), mizNil))));
	e8 = check(te8, [u8, mizNewNeg(pA(te8, mizNewFuncTrm(f8, mizNewTrmList(cT(1), mizNil))))]);
	mizCheckEqI(t, "checker.unifier.functor", length(e8), 0);

	// RESOLUTION (Contr 47): two chained universals
	te9 = mkChkTestEnv();
	qP9 = mizPushConstr(te9.env, mizMakeConstr(coPredicate, "T", 9));
	rP9 = mizPushConstr(te9.env, mizMakeConstr(coPredicate, "T", 10));
	tyM9 = \ -> mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(), te9.m1nr, mizNil);
	atom9 = \nr, trm -> mizNewPredFrm(ikFrmPred, nr, mizNewTrmList(trm, mizNil), 0);
	imp9 = \a2, b2 -> mizNewNeg(mizNewConj(a2, mizNewNeg(b2)));
	u9a = mizNewUniv(tyM9(), imp9(atom9(te9.pP, mizNewVarTrm(ikTrmBound, 1)),
		atom9(qP9, mizNewVarTrm(ikTrmBound, 1))));
	u9b = mizNewUniv(tyM9(), imp9(atom9(qP9, mizNewVarTrm(ikTrmBound, 1)),
		atom9(rP9, mizNewVarTrm(ikTrmBound, 1))));
	e9 = check(te9, [u9a, u9b, atom9(te9.pP, cT(1)), mizNewNeg(atom9(rP9, cT(1)))]);
	mizCheckEqI(t, "checker.resolution.chain", length(e9), 0);

	// SUPERCLUSTER ROUNDING, conditional: attrN a + (attrN -> attrE) + ¬attrE a
	teC = mkChkTestEnv();
	att = \nr, neg -> MizAttr(neg, nr, mizNil, false, 0);
	clOfC = \attrs : [MizAttr] -> {
		c = mizNewEmptyCluster();
		iter(attrs, \a -> mizAttrCollInsert(teC.env, c, a));
		c;
	};
	vNc = mizPushConstr(teC.env, mizMakeConstr(coAttribute, "V", 1));
	vEc = mizPushConstr(teC.env, mizMakeConstr(coAttribute, "V", 2));
	attrFrm = \nr, subj -> mizNewPredFrm(ikFrmAttr, nr, mizNewTrmList(subj, mizNil), 0);
	tyC = \ -> mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(),
		teC.m1nr, mizNil);
	mizInsertCCluster(teC.env, teC.cl, MizCCluster("T", 1, makeVector(0),
		clOfC([att(vNc, 1)]),
		MizClusterRec(clOfC([att(vEc, 1)]), clOfC([att(vEc, 1)])), tyC()));
	eC = check(teC, [attrFrm(vNc, cT(1)), mizNewNeg(attrFrm(vEc, cT(1)))]);
	mizCheckEqI(t, "checker.supercluster.ccluster", length(eC), 0);

	// SUPERCLUSTER ROUNDING, functor with loci: k(x,y) is attrE when x is attrN
	teF = mkChkTestEnv();
	clOfF = \attrs : [MizAttr] -> {
		c = mizNewEmptyCluster();
		iter(attrs, \a -> mizAttrCollInsert(teF.env, c, a));
		c;
	};
	vNf = mizPushConstr(teF.env, mizMakeConstr(coAttribute, "V", 3));
	vEf = mizPushConstr(teF.env, mizMakeConstr(coAttribute, "V", 4));
	tyF = \ -> mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(),
		teF.m1nr, mizNil);
	tyFN = mizNewStandardTyp(ikTypMode, clOfF([att(vNf, 1)]), clOfF([att(vNf, 1)]),
		teF.m1nr, mizNil);
	kFc = mizMakeConstr(coFunctor, "T", 6);
	kFc.typ ::= Some(tyF());
	kF = mizPushConstr(teF.env, kFc);
	primF : Vector<MizTyp> = makeVector(2);
	pushVector(primF, tyFN);
	pushVector(primF, tyF());
	loc = \n -> mizNewVarTrm(ikTrmLocus, n);
	mizInsertFCluster(teF.env, teF.cl, MizFCluster("T", 1, primF,
		MizClusterRec(clOfF([att(vEf, 1)]), clOfF([att(vEf, 1)])),
		mizNewFuncTrm(kF, pair(loc(1), loc(2))), None()));
	kAB = \ -> mizNewFuncTrm(kF, pair(cT(1), cT(2)));
	eF = check(teF, [attrFrm(vNf, cT(1)), mizNewNeg(attrFrm(vEf, kAB()))]);
	mizCheckEqI(t, "checker.supercluster.fcluster", length(eF), 0);

	// control: without `attrN a` the registration must NOT fire
	teF2 = mkChkTestEnv();
	clOfF2 = \attrs : [MizAttr] -> {
		c = mizNewEmptyCluster();
		iter(attrs, \a -> mizAttrCollInsert(teF2.env, c, a));
		c;
	};
	vNf2 = mizPushConstr(teF2.env, mizMakeConstr(coAttribute, "V", 3));
	vEf2 = mizPushConstr(teF2.env, mizMakeConstr(coAttribute, "V", 4));
	tyF2 = \ -> mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(),
		teF2.m1nr, mizNil);
	tyFN2 = mizNewStandardTyp(ikTypMode, clOfF2([att(vNf2, 1)]), clOfF2([att(vNf2, 1)]),
		teF2.m1nr, mizNil);
	kFc2 = mizMakeConstr(coFunctor, "T", 6);
	kFc2.typ ::= Some(tyF2());
	kF2 = mizPushConstr(teF2.env, kFc2);
	primF2 : Vector<MizTyp> = makeVector(2);
	pushVector(primF2, tyFN2);
	pushVector(primF2, tyF2());
	mizInsertFCluster(teF2.env, teF2.cl, MizFCluster("T", 1, primF2,
		MizClusterRec(clOfF2([att(vEf2, 1)]), clOfF2([att(vEf2, 1)])),
		mizNewFuncTrm(kF2, pair(loc(1), loc(2))), None()));
	eF2 = check(teF2, [mizNewNeg(attrFrm(vEf2,
		mizNewFuncTrm(kF2, pair(cT(1), cT(2)))))]);
	mizCheck(t, "checker.supercluster.control", eF2 == [4]);

	// per-inference constant release: two checks on the same checker
	te5 = mkChkTestEnv();
	__e5a = check(te5, [pA(te5, cT(1)), mizNewNeg(pA(te5, cT(2)))]);
	nAfterFirst = sizeVector(te5.env.inferConstDef);
	__e5b = check(te5, [pA(te5, cT(1)), mizNewNeg(pA(te5, cT(2)))]);
	mizCheckEqI(t, "checker.const.release", sizeVector(te5.env.inferConstDef), nAfterFirst);
	mizCheckEqI(t, "checker.const.released.all", nAfterFirst, 0);
}
