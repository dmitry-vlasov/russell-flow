// Component test for mizar/original/equalizer.flow — Equate on small
// refutations, driven end-to-end through PreCheck + constant collection.

import mizar/original/correl;
import mizar/original/correl_inst;
import mizar/original/prechecker;
import mizar/original/identify;
import mizar/original/roundcl;
import mizar/original/equalizer;
import mizar/original/lexicon;
import mizar/original/builtin;
import mizar/original/mobjects;
import mizar/original/test/test_utils;
import ds/vector;

export {
	runEqualizerTests(t : MizTest) -> void;
}

MizEqTestEnv(
	env : MizCorrelEnv,
	idn : MizIdentify,
	cl : MizClusters,
	m1nr : int,
	eqNr : int,
	pP : int,
	fNr : int,
	v1 : int,
);

mkEqTestEnv() -> MizEqTestEnv {
	env = mizMakeCorrelEnv();
	cl = mizMakeClusters();
	mizWireRoundcl(env, cl);
	mk = \nr -> mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(), nr, mizNil);
	m1 = mizMakeConstr(coMode, "H", 1);
	m1nr = mizPushConstr(env, m1);
	mizSetBuiltIn(env.builtIn, rqAny, m1nr);
	env.nonZeroTyp ::= mk(m1nr);
	// '=' predicate with reflexivity + symmetry on args 1,2
	eqC = mizMakeConstr(coPredicate, "H", 1);
	eqC.properties ::= bitOr(bitShl(1, syReflexivity), bitShl(1, sySymmetry));
	eqC.firstArg ::= 1;
	eqC.secondArg ::= 2;
	eqNr = mizPushConstr(env, eqC);
	mizSetBuiltIn(env.builtIn, rqEqualsTo, eqNr);
	pP = mizPushConstr(env, mizMakeConstr(coPredicate, "T", 1));
	fC = mizMakeConstr(coFunctor, "T", 1);
	fC.typ ::= Some(mk(m1nr));
	fNr = mizPushConstr(env, fC);
	v1C = mizMakeConstr(coAttribute, "T", 1);
	v1C.typ ::= Some(mk(m1nr));
	v1 = mizPushConstr(env, v1C);
	// two fixed constants c1 c2 : M1
	env.fixedVarNbr ::= 2;
	pushVector(env.fixedVar, MizFixedVar(0, mk(m1nr), false, None(), 0));
	pushVector(env.fixedVar, MizFixedVar(0, mk(m1nr), false, None(), 0));
	idn = mizMakeIdentify(env);
	MizEqTestEnv(env, idn, cl, m1nr, eqNr, pP, fNr, v1);
}

// run PreCheck + Equate on the premises; returns contr of the FIRST disjunct
// (the tests build single-disjunct premise sets)
runOne(te : MizEqTestEnv, premises : [MizFrm]) -> int {
	pre = mizMakePre(te.env);
	pre.collectConst ::= \f -> mizCollectConstInFrm(te.idn, f);
	inf : Vector<MizFrm> = makeVector(4);
	iter(premises, \p -> pushVector(inf, p));
	nf = mizPreCheck(pre, inf);
	if (mizPreInstCount(nf) == 0) {
		-1; // refuted propositionally before the equalizer
	} else {
		eq = mizMakeEqualizer(te.env, te.idn, te.cl, pre);
		mizEquate(eq, getVectorUnsafe(nf.evals, 0));
		eq.contr;
	}
}

runEqualizerTests(t : MizTest) -> void {
	cT = \n -> mizNewVarTrm(ikTrmConstant, n);
	pair = \a, b -> mizNewTrmList(a, mizNewTrmList(b, mizNil));

	// 1. a = b, P(a), ¬P(b) — refuted through the equality
	te1 = mkEqTestEnv();
	pA = \te : MizEqTestEnv, trm -> mizNewPredFrm(ikFrmPred, te.pP, mizNewTrmList(trm, mizNil), 0);
	eqF = \te : MizEqTestEnv, a, b -> mizNewPredFrm(ikFrmPred, te.eqNr, pair(a, b), 0);
	c1 = runOne(te1, [eqF(te1, cT(1), cT(2)), pA(te1, cT(1)), mizNewNeg(pA(te1, cT(2)))]);
	mizCheck(t, "equalizer.eq.pred", c1 > 0);

	// 2. congruence: a = b, ¬(f(a) = f(b))
	te2 = mkEqTestEnv();
	fT = \te : MizEqTestEnv, trm -> mizNewFuncTrm(te.fNr, mizNewTrmList(trm, mizNil));
	c2 = runOne(te2, [eqF(te2, cT(1), cT(2)),
		mizNewNeg(eqF(te2, fT(te2, cT(1)), fT(te2, cT(2))))]);
	mizCheck(t, "equalizer.congruence", c2 > 0);

	// 3. attributes through equality: v(a), a = b, ¬v(b)
	te3 = mkEqTestEnv();
	vF = \te : MizEqTestEnv, trm -> mizNewPredFrm(ikFrmAttr, te.v1, mizNewTrmList(trm, mizNil), 0);
	c3 = runOne(te3, [vF(te3, cT(1)), eqF(te3, cT(1), cT(2)), mizNewNeg(vF(te3, cT(2)))]);
	mizCheck(t, "equalizer.attr", c3 > 0);

	// 4. reflexivity: ¬(a = a)
	te4 = mkEqTestEnv();
	c4 = runOne(te4, [mizNewNeg(eqF(te4, cT(1), cT(1)))]);
	mizCheck(t, "equalizer.reflexivity", c4 > 0);

	// 5. NOT refutable: P(a), ¬P(b) without a = b
	te5 = mkEqTestEnv();
	c5 = runOne(te5, [pA(te5, cT(1)), mizNewNeg(pA(te5, cT(2)))]);
	mizCheckEqI(t, "equalizer.open", c5, 0);

	// 6. symmetry of '=': a = b, ¬(b = a)
	te6 = mkEqTestEnv();
	c6 = runOne(te6, [eqF(te6, cT(1), cT(2)), mizNewNeg(eqF(te6, cT(2), cT(1)))]);
	// symmetric '=' collapses to the SAME Basic atom (EqFrm is symmetric on
	// '='), so the disjunct dies propositionally (-1) — original behavior
	mizCheck(t, "equalizer.eq.symmetric", c6 != 0);

	// 7. deeper congruence chain: a = b, ¬(f(f(a)) = f(f(b)))
	te7 = mkEqTestEnv();
	c7 = runOne(te7, [eqF(te7, cT(1), cT(2)),
		mizNewNeg(eqF(te7, fT(te7, fT(te7, cT(1))), fT(te7, fT(te7, cT(2)))))]);
	mizCheck(t, "equalizer.congruence.deep", c7 > 0);
}

