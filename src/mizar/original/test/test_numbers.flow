// Component test for mizar/original/numbers.flow — the EXACT arithmetic layer.
//
// The point of this unit is that it is exact, so the tests are the cases where
// doubles are wrong: values past 2^53, rationals with no binary expansion, and
// divisibility/primality on big integers.

import mizar/original/numbers;
import mizar/original/test/test_utils;

export {
	runNumbersTests(t : MizTest) -> void;
}

bi(s : string) -> MizBigInt { mizBigFromString(s); }

runNumbersTests(t : MizTest) -> void {
	// ---- string round trip, including the limb boundaries ----
	mizCheckEq(t, "big.s.zero", mizBig2s(bi("0")), "0");
	mizCheckEq(t, "big.s.one", mizBig2s(bi("1")), "1");
	mizCheckEq(t, "big.s.9999", mizBig2s(bi("9999")), "9999");
	mizCheckEq(t, "big.s.10000", mizBig2s(bi("10000")), "10000");
	mizCheckEq(t, "big.s.10001", mizBig2s(bi("10001")), "10001");
	// a limb boundary with interior zeroes — the lpad case
	mizCheckEq(t, "big.s.100000001", mizBig2s(bi("100000001")), "100000001");
	mizCheckEq(t, "big.s.neg", mizBig2s(bi("-4200000000000000000042")),
		"-4200000000000000000042");
	mizCheckEq(t, "big.s.fromInt", mizBig2s(mizBigFromInt(-70123)), "-70123");
	mizCheckEq(t, "big.s.leadingzero", mizBig2s(bi("000123")), "123");

	// ---- add / sub, with the sign cases ----
	mizCheckEq(t, "big.add.carry", mizBig2s(mizBigAdd(bi("9999"), bi("1"))), "10000");
	mizCheckEq(t, "big.add.big",
		mizBig2s(mizBigAdd(bi("99999999999999999999"), bi("1"))), "100000000000000000000");
	mizCheckEq(t, "big.sub.borrow", mizBig2s(mizBigSub(bi("10000"), bi("1"))), "9999");
	mizCheckEq(t, "big.sub.toneg", mizBig2s(mizBigSub(bi("5"), bi("9"))), "-4");
	mizCheckEq(t, "big.sub.tozero", mizBig2s(mizBigSub(bi("777"), bi("777"))), "0");
	mizCheck(t, "big.zero.notneg", !mizBigSub(bi("5"), bi("5")).neg);
	mizCheckEq(t, "big.add.mixedsign", mizBig2s(mizBigAdd(bi("-100"), bi("30"))), "-70");

	// ---- multiplication past 2^53, where doubles start lying ----
	// 9007199254740993 = 2^53 + 1 is not representable as a double
	mizCheckEq(t, "big.mul.2p53p1",
		mizBig2s(mizBigAdd(bi("9007199254740992"), bi("1"))), "9007199254740993");
	mizCheckEq(t, "big.mul.squares",
		mizBig2s(mizBigMul(bi("123456789"), bi("987654321"))), "121932631112635269");
	mizCheckEq(t, "big.mul.neg",
		mizBig2s(mizBigMul(bi("-99999999999"), bi("99999999999"))),
		"-9999999999800000000001");
	mizCheckEq(t, "big.mul.zero", mizBig2s(mizBigMul(bi("0"), bi("12345"))), "0");

	// ---- division and remainder, truncating toward zero ----
	dm1 = mizBigDivMod(bi("121932631112635269"), bi("123456789"));
	mizCheckEq(t, "big.div.exact.q", mizBig2s(dm1.first), "987654321");
	mizCheckEq(t, "big.div.exact.r", mizBig2s(dm1.second), "0");
	dm2 = mizBigDivMod(bi("1000000000000000000007"), bi("13"));
	mizCheckEq(t, "big.div.q", mizBig2s(dm2.first), "76923076923076923077");
	mizCheckEq(t, "big.div.r", mizBig2s(dm2.second), "6");
	dm3 = mizBigDivMod(bi("-17"), bi("5"));
	mizCheckEq(t, "big.div.negq", mizBig2s(dm3.first), "-3");
	mizCheckEq(t, "big.div.negr", mizBig2s(dm3.second), "-2");
	dm4 = mizBigDivMod(bi("7"), bi("100"));
	mizCheckEq(t, "big.div.small.q", mizBig2s(dm4.first), "0");
	mizCheckEq(t, "big.div.small.r", mizBig2s(dm4.second), "7");

	// ---- gcd / lcm / divides ----
	mizCheckEq(t, "big.gcd", mizBig2s(mizBigGcd(bi("462"), bi("1071"))), "21");
	mizCheckEq(t, "big.gcd.neg", mizBig2s(mizBigGcd(bi("-462"), bi("1071"))), "21");
	mizCheckEq(t, "big.gcd.zero", mizBig2s(mizBigGcd(bi("0"), bi("17"))), "17");
	mizCheckEq(t, "big.lcm", mizBig2s(mizBigLcm(bi("4"), bi("6"))), "12");
	// 999999999999999999999999 = 13 * 76923076923076923076923 (checked independently)
	mizCheck(t, "big.divides.yes", mizBigDivides(bi("13"), bi("999999999999999999999999")));
	mizCheck(t, "big.divides.no", !mizBigDivides(bi("13"), bi("1000000000000000000000000")));
	// THE case doubles get wrong: both operands are past 2^53 and differ only
	// in their low bits, so (b/a) == floor(b/a) is meaningless in floating point
	mizCheck(t, "big.divides.past2p53",
		mizBigDivides(bi("3"), bi("9007199254740993")));
	mizCheck(t, "big.divides.past2p53.no",
		!mizBigDivides(bi("3"), bi("9007199254740994")));

	// ---- primality ----
	mizCheck(t, "big.prime.2", mizBigIsPrime(bi("2")));
	mizCheck(t, "big.prime.97", mizBigIsPrime(bi("97")));
	mizCheck(t, "big.prime.1.no", !mizBigIsPrime(bi("1")));
	mizCheck(t, "big.prime.0.no", !mizBigIsPrime(bi("0")));
	mizCheck(t, "big.prime.91.no", !mizBigIsPrime(bi("91")));   // 7*13
	mizCheck(t, "big.prime.neg.no", !mizBigIsPrime(bi("-7")));
	mizCheck(t, "big.prime.104729", mizBigIsPrime(bi("104729"))); // the 10000th prime
	mizCheck(t, "big.prime.104730.no", !mizBigIsPrime(bi("104730")));

	// ---- comparison ----
	mizCheckEqI(t, "big.cmp.lt", mizBigCmp(bi("999"), bi("1000")), -1);
	mizCheckEqI(t, "big.cmp.gt", mizBigCmp(bi("1000"), bi("999")), 1);
	mizCheckEqI(t, "big.cmp.eq", mizBigCmp(bi("-5"), bi("-5")), 0);
	mizCheckEqI(t, "big.cmp.signs", mizBigCmp(bi("-1000000"), bi("1")), -1);

	// ---- int conversion ----
	mizCheck(t, "big.2i.small", mizBig2i(bi("70123")) == Some(70123));
	mizCheck(t, "big.2i.neg", mizBig2i(bi("-70123")) == Some(-70123));
	mizCheck(t, "big.2i.zero", mizBig2i(bi("0")) == Some(0));
	mizCheck(t, "big.2i.toobig", mizBig2i(bi("999999999999")) == None());

	// ---- rationals: reduction and the sign convention ----
	r13 = mizRatMake(bi("1"), bi("3"));
	mizCheckEq(t, "rat.reduce", mizRat2s(mizRatMake(bi("6"), bi("8"))), "3/4");
	mizCheckEq(t, "rat.sign", mizRat2s(mizRatMake(bi("1"), bi("-2"))), "-1/2");
	mizCheckEq(t, "rat.int", mizRat2s(mizRatMake(bi("8"), bi("4"))), "2");
	mizCheckEq(t, "rat.zero", mizRat2s(mizRatMake(bi("0"), bi("5"))), "0");

	// THE case doubles get wrong: 1/3 + 1/3 + 1/3 must be exactly 1
	third3 = mizRatAdd(mizRatAdd(r13, r13), r13);
	mizCheck(t, "rat.thirds.exact", mizRatEq(third3, mizRatOne));
	// and 0.1 + 0.2 must be exactly 3/10
	tenth = mizRatMake(bi("1"), bi("10"));
	fifth = mizRatMake(bi("2"), bi("10"));
	mizCheck(t, "rat.tenths.exact",
		mizRatEq(mizRatAdd(tenth, fifth), mizRatMake(bi("3"), bi("10"))));

	mizCheckEq(t, "rat.mul", mizRat2s(mizRatMul(r13, mizRatMake(bi("3"), bi("5")))), "1/5");
	mizCheck(t, "rat.inv", mizRatInv(r13) == Some(mizRatMake(bi("3"), bi("1"))));
	mizCheck(t, "rat.inv.zero", mizRatInv(mizRatZero) == None());
	mizCheck(t, "rat.div.zero", mizRatDiv(mizRatOne, mizRatZero) == None());
	mizCheckEqI(t, "rat.cmp", mizRatCmp(r13, mizRatMake(bi("1"), bi("2"))), -1);
	mizCheckEqI(t, "rat.cmp.negs", mizRatCmp(mizRatMake(bi("-1"), bi("3")),
		mizRatMake(bi("-1"), bi("2"))), 1);
	mizCheck(t, "rat.isInt", mizRatIsInt(mizRatMake(bi("8"), bi("4")))
		&& !mizRatIsInt(r13));

	// ---- complex rationals ----
	i1 = mizCplxImUnit;
	mizCheck(t, "cplx.i2", mizCplxEq(mizCplxMul(i1, i1), mizCplxMinusOne));
	mizCheck(t, "cplx.add", mizCplxEq(mizCplxAdd(mizCplxOne, mizCplxMinusOne), mizCplxZero));
	mizCheck(t, "cplx.inv.zero", mizCplxInv(mizCplxZero) == None());
	// (1+i)*(1-i) = 2
	onePlusI = MizCplx(mizRatOne, mizRatOne);
	oneMinusI = MizCplx(mizRatOne, mizRatNeg(mizRatOne));
	mizCheck(t, "cplx.conj", mizCplxEq(mizCplxMul(onePlusI, oneMinusI), mizCplxFromInt(2)));
	mizCheck(t, "cplx.div", mizCplxDiv(mizCplxFromInt(6), mizCplxFromInt(3))
		== Some(mizCplxFromInt(2)));
	mizCheck(t, "cplx.eqInt", mizCplxEqInt(mizCplxFromInt(-3), -3)
		&& !mizCplxEqInt(onePlusI, 1));
	mizCheck(t, "cplx.isInteger", mizCplxIsInteger(mizCplxFromInt(5))
		&& !mizCplxIsInteger(MizCplx(r13, mizRatZero))
		&& !mizCplxIsInteger(onePlusI));
	mizCheck(t, "cplx.isNatural", mizCplxIsNatural(mizCplxFromInt(5))
		&& !mizCplxIsNatural(mizCplxFromInt(-5)));
	mizCheck(t, "cplx.isPrime", mizCplxIsPrime(mizCplxFromInt(97))
		&& !mizCplxIsPrime(mizCplxFromInt(91)));
	mizCheck(t, "cplx.le", mizCplxLE(mizCplxFromInt(2), mizCplxFromInt(3))
		&& !mizCplxLE(mizCplxFromInt(3), mizCplxFromInt(2)));
	mizCheck(t, "cplx.gt", mizCplxGT(mizCplxFromInt(3), mizCplxFromInt(2)));
	// 1/3 <= 1/2 must not depend on rounding
	mizCheck(t, "cplx.le.exact",
		mizCplxLE(MizCplx(r13, mizRatZero), MizCplx(mizRatMake(bi("1"), bi("2")), mizRatZero)));
}

