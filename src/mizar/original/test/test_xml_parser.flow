// Component test for mizar/original/xml_parser.flow.
// Small literal documents first, then a real MML analyzer report from the
// working copy ($RUSSELL_MATH/MML-test): walk xboole_0.xml entirely and check
// element counts against `grep -c` ground truth.

import mizar/original/xml_parser;
import mizar/original/test/test_utils;
import fs/filesystem;
import loop;

export {
	runXmlParserTests(t : MizTest) -> void;
}

runXmlParserTests(t : MizTest) -> void {
	// --- literal document: prolog, nesting, attributes, empty elements ---
	doc = "<?xml version=\"1.0\"?>\n"
		+ "<Article aid=\"XBOOLE_0\" mizfiles=\"/usr/local/share/mizar/\">\n"
		+ "<JustifiedTheorem line=\"3\" col=\"7\">\n"
		+ "<Proposition nr=\"1\"/>\n"
		+ "</JustifiedTheorem>\n"
		+ "</Article>\n";
	p = mizXmlInitParsing(doc);

	mizXmlNextElementState(p);
	mizCheck(t, "xml.root.start", p.nState == MizEStart);
	mizCheckEq(t, "xml.root.name", p.nElName, "Article");
	mizCheckEq(t, "xml.root.attr", mizXmlAttr(p, "aid"), "XBOOLE_0");
	mizCheckEq(t, "xml.root.attr2", mizXmlAttr(p, "mizfiles"), "/usr/local/share/mizar/");
	mizCheck(t, "xml.attr.absent", !mizXmlHasAttr(p, "nosuch"));

	mizXmlNextElementState(p);
	mizCheck(t, "xml.jt.start", p.nState == MizEStart && p.nElName == "JustifiedTheorem");
	mizCheckEqI(t, "xml.jt.line", mizXmlIntAttr(p, "line"), 3);
	mizCheckEqI(t, "xml.jt.col", mizXmlIntAttr(p, "col"), 7);
	mizCheckEqI(t, "xml.jt.intAttrDef", mizXmlIntAttrDef(p, "nosuch", 42), 42);

	mizXmlNextElementState(p);
	mizCheck(t, "xml.prop.start", p.nState == MizEStart && p.nElName == "Proposition");
	mizXmlNextElementState(p); // /> of Proposition
	mizCheck(t, "xml.prop.end", p.nState == MizEEnd);
	mizXmlNextElementState(p); // </JustifiedTheorem>
	mizCheck(t, "xml.jt.end", p.nState == MizEEnd);
	mizXmlNextElementState(p); // </Article>
	mizCheck(t, "xml.root.end", p.nState == MizEEnd);
	mizXmlNextElementState(p); // EOTX
	mizCheck(t, "xml.eotx", p.nState == MizEEnd && p.nCurTokenKind == MizXTEOTX);

	// --- attribute value with spaces; multi-line elements ---
	doc2 = "<A x=\"a b c\"\n y=\"2\">\n<B/>\n</A>\n";
	p2 = mizXmlInitParsing(doc2);
	mizXmlNextElementState(p2);
	mizCheckEq(t, "xml.attr.spaces", mizXmlAttr(p2, "x"), "a b c");
	mizCheckEqI(t, "xml.attr.multiline", mizXmlIntAttr(p2, "y"), 2);

	// --- onOpenTag hook fires with each element name ---
	names = ref "";
	p3 = mizXmlInitParsing("<A><B/><C/></A>");
	p3.onOpenTag ::= \nm -> names := ^names + nm;
	mizXmlNextElementState(p3); // A
	mizXmlNextElementState(p3); // B
	mizXmlNextElementState(p3); // B end
	mizXmlNextElementState(p3); // C
	mizCheckEq(t, "xml.onOpenTag", ^names, "ABC");

	// --- NextTag skips attributes but tracks structure ---
	p4 = mizXmlInitParsing(doc);
	mizXmlNextTag(p4);
	mizCheck(t, "xml.nextTag", p4.nState == MizEStart && p4.nElName == "Article");
	mizXmlNextTag(p4);
	mizCheck(t, "xml.nextTag2", p4.nElName == "JustifiedTheorem");

	// --- real MML file: walk it fully, count starts/ends ---
	xb0 = mizTestMml() + "/mml/xboole_0.xml";
	if (fileExists(xb0)) {
		pr = mizXmlInitParsingFile(xb0);
		starts = ref 0;
		ends = ref 0;
		typs = ref 0;
		while(\ -> pr.nCurTokenKind != MizXTEOTX, \ -> {
			mizXmlNextElementState(pr);
			if (pr.nState == MizEStart) {
				starts := ^starts + 1;
				if (pr.nElName == "Typ") typs := ^typs + 1;
			} else {
				ends := ^ends + 1;
			}
		});
		// ground truth for the shipped MML xboole_0.xml:
		//   grep -o '<[A-Za-z]' = 6925 start tags, grep -o '<Typ[ />]' = 396
		mizCheckEqI(t, "xml.mml.starts", ^starts, 6925);
		mizCheckEqI(t, "xml.mml.typs", ^typs, 396);
		mizCheckEqI(t, "xml.mml.balanced", ^ends, 6925);
	} else {
		println("SKIP xml.mml.*: " + xb0 + " not found");
	}
}
