// Transcription of ~/dev/system/kernel/equalizer.pas — Equate, the Equalizer:
// per disjunct, hash-cons every term into an equality class (YTerm), union
// classes by the positive `=` literals (UnionTrms with congruence through the
// per-functor occurrence lists), carry types and superclusters per class, and
// look for a contradiction (SetContr codes match the original).
//
// SLICE 1 — this file covers the non-arithmetic core:
//   Y-phase, YYTerm, UnionTrms (numeric merge, no polynomials),
//   InitEmptyInEqClass, InitStructuresInEqClass (strict-struct equations),
//   asymmetry/connectedness closure, requirement rules (LessOrEqual sign
//   propagation, BelongsTo/Inclusion element-types, the powerset rule),
//   RenumEqClasses, ContradictionVerify, the negative-basis sweeps.
// Also here: RoundUpSuperCluster — registration rounding over classes
//   through the ANInstCollection lattice (bottom of this file).
// STAGED for slice 2 (explicit no-op stubs below, each marked):
//   polynomial values (polynom.pas), Identities (gIdentifications +
//   arithmetic), reductions (gReductions), the complex-number supercluster.
//   Faithful for premises that use none of them;
//   missing pieces can only LOSE refutations (error 4), never fabricate one.

import ds/vector;
import loop;
import math/math;
import mizar/original/errhan;
import mizar/original/mobjects;
import mizar/original/limits;
import mizar/original/lexicon;
import mizar/original/builtin;
import mizar/original/correl;
import mizar/original/correl_inst;
import mizar/original/correl_match;
import mizar/original/roundcl;
import mizar/original/identify;
import net/url_parameter;
import mizar/original/prechecker;
import mizar/original/polynom;

export {
	// TrmS[i]
	MizTrmSRec(
		mutable term : MizTrm,               // the EqConst representative
		mutable numDetermined : bool,
		mutable numValue : MizComplex,
		mutable eqClass : MizTrmList,        // nil when merged away
		xTypClass : Vector<MizTyp>,
		mutable superCluster : MizAttrColl,
		polynomialValues : Vector<MizPolynomial>,   // sorted by StdComparePolynomials
	);

	MizEqualizer(
		env : MizCorrelEnv,
		idn : MizIdentify,
		clusters : MizClusters,
		pre : MizPre,                        // Basic lives here
		trmS : Vector<MizTrmSRec>,           // slot 0 dummy; TrmNbr = size-1
		mutable trmOvfl : bool,
		mutable contr : int,
		mutable eqClassNbr : int,
		posBas : Vector<MizFrm>,
		negBas : Vector<MizFrm>,
		dTrm : Vector<Maybe<MizTrm>>,        // by InfConst nr
		// FuncTrmList[kind]: funcNr -> occurrence terms
		funcTrmIdx : Vector<Vector<Pair<int, Vector<MizTrm>>>>, // by exp kind 0..4
		frOper : Vector<MizTrm>,
		choiceTerm : Vector<MizTrm>,
		mutable clash : bool,
		eqPend : Vector<MizIntPair>,         // lEqPendings
		settings : Vector<MizIntPair>,       // lSetting
		// RoundUpSuperCluster state (the AN machinery)
		allowedC : Vector<Pair<int, MizAttrColl>>, // AllowedCCluster: (cond idx, filtered upper)
		allowedF : Vector<Pair<int, MizAttrColl>>, // AllowedFCluster: (func idx, filtered upper)
		anDeps : Vector<Maybe<MizNatFunc>>,  // gDependencies, per class (index-1)
		anStack : MizNatFunc,                // ANEqStack (NatSet)
		mutable anInst : MizNatFunc,         // gANInstantiation
	);

	mizMakeEqualizer(env : MizCorrelEnv, idn : MizIdentify, clusters : MizClusters,
		pre : MizPre) -> MizEqualizer;

	// the phase: refute one disjunct. eq.contr > 0 = refuted.
	mizEquate(eq : MizEqualizer, eval : MizNatFunc) -> void;

	mizTrmNbr(eq : MizEqualizer) -> int;
	mizTrmSAt(eq : MizEqualizer, i : int) -> MizTrmSRec;
	mizEqTrms(eq : MizEqualizer, a : MizTrm, b : MizTrm) -> bool;
	mizEqTrmListsE(eq : MizEqualizer, a : MizTrmList, b : MizTrmList) -> bool;
	mizEqFrmsE(eq : MizEqualizer, a : MizFrm, b : MizFrm) -> bool;
	mizYTerm(eq : MizEqualizer, t : MizTrm) -> MizTrm;
	mizTrmInfoOf(t : MizTrm) -> int;
	mizInsertNonEmptyPub(eq : MizEqualizer, i1 : int, i2 : int) -> void;
	mizInsertNonZeroPub(eq : MizEqualizer, i1 : int, i2 : int) -> void;
}

// exp kinds for funcTrmIdx
expFunctor = 0;
expAggreg = 1;
expSelector = 2;
expPrivFunc = 3;
expSchFunc = 4;

mizMakeEqualizer(env : MizCorrelEnv, idn : MizIdentify, clusters : MizClusters,
		pre : MizPre) -> MizEqualizer {
	fti : Vector<Vector<Pair<int, Vector<MizTrm>>>> = makeVector(5);
	fori(0, 4, \__ -> pushVector(fti, makeVector(8)));
	ts : Vector<MizTrmSRec> = makeVector(64);
	pushVector(ts, MizTrmSRec(mizNewIncorTrm(), false, MizComplex(0.0, 0.0),
		MizTrmNil(), makeVector(0), mizNewEmptyCluster(), makeVector(2)));
	MizEqualizer(env, idn, clusters, pre, ts, false, 0, 0,
		makeVector(8), makeVector(8), makeVector(16), fti,
		makeVector(4), makeVector(4), false, makeVector(8), makeVector(8),
		makeVector(4), makeVector(4), makeVector(16), mizInitNatSet(16),
		mizInitNatFunc(1));
}

mizTrmNbr(eq : MizEqualizer) -> int {
	sizeVector(eq.trmS) - 1;
}

mizTrmSAt(eq : MizEqualizer, i : int) -> MizTrmSRec {
	getVectorUnsafe(eq.trmS, i);
}

mizSetContr(eq : MizEqualizer, i : int) -> void {
	eq.contr ::= i;
}

mizTrmInfoOf(t : MizTrm) -> int {
	switch (t) {
		MizVarTrm(__, __, __, trmInfo): trmInfo;
		MizFuncTrm(__, __, __, __, trmInfo): trmInfo;
		MizPrivFuncTrm(__, __, __, __, trmInfo): trmInfo;
		MizFraenkelTrm(__, __, __, __, __, trmInfo): trmInfo;
		MizQuaTrm(__, __, __, trmInfo): trmInfo;
		MizChoiceTrm(__, __, trmInfo): trmInfo;
		MizBaseTrm(__, trmInfo): trmInfo;
	}
}

mizSetTrmInfo(t : MizTrm, v : int) -> void {
	switch (t) {
		MizVarTrm(__, __, __, __): { x : MizVarTrm = t; x.trmInfo ::= v; }
		MizFuncTrm(__, __, __, __, __): { x : MizFuncTrm = t; x.trmInfo ::= v; }
		MizPrivFuncTrm(__, __, __, __, __): { x : MizPrivFuncTrm = t; x.trmInfo ::= v; }
		MizFraenkelTrm(__, __, __, __, __, __): { x : MizFraenkelTrm = t; x.trmInfo ::= v; }
		MizQuaTrm(__, __, __, __): { x : MizQuaTrm = t; x.trmInfo ::= v; }
		MizChoiceTrm(__, __, __): { x : MizChoiceTrm = t; x.trmInfo ::= v; }
		MizBaseTrm(__, __): { x : MizBaseTrm = t; x.trmInfo ::= v; }
	}
}

// class representative index: TrmS[TrmS[i].Term^.TrmInfo]
mizClassOf(eq : MizEqualizer, i : int) -> int {
	mizTrmInfoOf(mizTrmSAt(eq, i).term);
}

// ---------------- supercluster access ----------------

// MAttrCollection.GetAttr: find by attr nr + args (CompAbsAttr order)
mizGetAttr(eq : MizEqualizer, c : MizAttrColl, attrNr : int, args : MizTrmList) -> Maybe<MizAttr> {
	probe = MizAttr(0, attrNr, args, false, 0);
	p = mizAttrCollSearch(eq.env, c, probe);
	if (p.first) Some(getVectorUnsafe(c.items, p.second)) else None();
}

mizInsertAttrE(eq : MizEqualizer, c : MizAttrColl, attrNr : int, neg : int,
		args : MizTrmList) -> void {
	mizAttrCollInsert(eq.env, c, MizAttr(neg, attrNr, args, false, 0));
}

// ---------------- equalizer equality (over TrmInfo) ----------------

mizEqTrms(eq : MizEqualizer, a : MizTrm, b : MizTrm) -> bool {
	ia = mizTrmInfoOf(a);
	if (ia != 0) {
		ia == mizTrmInfoOf(b);
	} else if (mizTrmSort(a) != mizTrmSort(b)) {
		false;
	} else {
		switch (a) {
			MizVarTrm(__, varNr, __, __): {
				vb : MizVarTrm = mizEqAsVar(b);
				varNr == vb.varNr;
			}
			MizFuncTrm(srt, funcNr, args, __, __): {
				fb : MizFuncTrm = mizEqAsFunc(b);
				if (srt == ikTrmFunctor) {
					fa : MizFuncTrm = mizEqAsFunc(a);
					pa = mizAdjustTrm(eq.env, fa);
					pb = mizAdjustTrm(eq.env, fb);
					pa.first == pb.first && mizEqTrmListsE(eq, pa.second, pb.second);
				} else {
					funcNr == fb.funcNr && mizEqTrmListsE(eq, args, fb.args);
				}
			}
			MizPrivFuncTrm(funcNr, args, __, __, __): {
				pb : MizPrivFuncTrm = mizEqAsPriv(b);
				funcNr == pb.funcNr && mizEqTrmListsE(eq, args, pb.args);
			}
			MizFraenkelTrm(lambdaArgs, scope, compr, __, __, __): {
				kb : MizFraenkelTrm = mizEqAsFraenkel(b);
				if (sizeVector(lambdaArgs) != sizeVector(kb.lambdaArgs)) {
					false;
				} else {
					ok = ref true;
					i = ref 0;
					while(\ -> ^i < sizeVector(lambdaArgs) && ^ok, \ -> {
						if (!mizEqTypsE(eq, getVectorUnsafe(lambdaArgs, ^i),
								getVectorUnsafe(kb.lambdaArgs, ^i))) ok := false;
						i := ^i + 1;
					});
					^ok && mizEqTrms(eq, scope, kb.scope) && mizEqFrmsE(eq, compr, kb.compr);
				}
			}
			MizChoiceTrm(typ, __, __): {
				hb : MizChoiceTrm = mizEqAsChoice(b);
				mizEqTypsE(eq, typ, hb.choiceTyp);
			}
			MizBaseTrm(srt, __): srt == ikError;
			MizQuaTrm(__, __, __, __): false;
		}
	}
}

mizEqTrmListsE(eq : MizEqualizer, a : MizTrmList, b : MizTrmList) -> bool {
	switch (a) {
		MizTrmNil(): switch (b) {
			MizTrmNil(): true;
			MizTrmElem(__, __): false;
		}
		MizTrmElem(ta, na): switch (b) {
			MizTrmNil(): false;
			MizTrmElem(tb, nb): mizEqTrms(eq, ta, tb) && mizEqTrmListsE(eq, na, nb);
		}
	}
}

mizEqButLast(eq : MizEqualizer, a0 : MizTrmList, b0 : MizTrmList) -> bool {
	// compare all but the last element
	switch (a0) {
		MizTrmNil(): false;
		MizTrmElem(ta, na): switch (b0) {
			MizTrmNil(): false;
			MizTrmElem(tb, nb): {
				lastA = switch (na) { MizTrmNil(): true; default: false; };
				lastB = switch (nb) { MizTrmNil(): true; default: false; };
				if (lastA || lastB) {
					lastA && lastB;
				} else {
					mizEqTrms(eq, ta, tb) && mizEqButLast(eq, na, nb);
				}
			}
		}
	}
}

mizEqAttrsE(eq : MizEqualizer, a : MizAttr, b : MizAttr) -> bool {
	pa = mizAdjustAttr(eq.env, a);
	pb = mizAdjustAttr(eq.env, b);
	pa.first == pb.first && a.neg == b.neg && mizEqTrmListsE(eq, pa.second, pb.second);
}

mizEqTypsE(eq : MizEqualizer, a : MizTyp, b : MizTyp) -> bool {
	if (a.sort != b.sort) {
		false;
	} else if (a.sort == ikTypMode) {
		pa = mizAdjustTyp(eq.env, a);
		pb = mizAdjustTyp(eq.env, b);
		pa.first == pb.first
			&& mizEqualClusters(a, b, \x, y -> mizEqAttrsE(eq, x, y))
			&& mizEqTrmListsE(eq, pa.second, pb.second);
	} else if (a.sort == ikTypStruct) {
		a.modNr == b.modNr
			&& mizEqualClusters(a, b, \x, y -> mizEqAttrsE(eq, x, y))
			&& mizEqTrmListsE(eq, a.modArgs, b.modArgs);
	} else {
		mizRunTimeError(2020);
		false;
	}
}

mizEqFrmsE(eq : MizEqualizer, a : MizFrm, b : MizFrm) -> bool {
	env = eq.env;
	sa = mizFrmSort(a);
	if (sa != mizFrmSort(b)) {
		false;
	} else if (sa == ikFrmVerum || sa == ikFrmThesis || sa == ikError) {
		true;
	} else {
		switch (a) {
			MizNegFrm(arg, __): {
				nb : MizNegFrm = mizEqAsNeg(b);
				mizEqFrmsE(eq, arg, nb.arg);
			}
			MizQualFrm(trm, typ, __): {
				qb : MizQualFrm = mizEqAsQual(b);
				mizEqTrms(eq, trm, qb.trm) && mizEqTypsE(eq, typ, qb.typ);
			}
			MizConjFrm(conjuncts, __): {
				cb : MizConjFrm = mizEqAsConj(b);
				if (sizeVector(conjuncts) != sizeVector(cb.conjuncts)) {
					false;
				} else {
					ok = ref true;
					i = ref 0;
					while(\ -> ^i < sizeVector(conjuncts) && ^ok, \ -> {
						if (!mizEqFrmsE(eq, getVectorUnsafe(conjuncts, ^i),
								getVectorUnsafe(cb.conjuncts, ^i))) ok := false;
						i := ^i + 1;
					});
					^ok;
				}
			}
			MizPredFrm(srt, predNr, args, __): {
				pb : MizPredFrm = mizEqAsPred(b);
				if (srt == ikFrmSchPred) {
					predNr == pb.predNr && mizEqTrmListsE(eq, args, pb.args);
				} else if (srt == ikFrmAttr) {
					pa2 : MizPredFrm = mizEqAsPred(a);
					qa = mizAdjustAttrFrm(env, pa2);
					qb = mizAdjustAttrFrm(env, pb);
					qa.first == qb.first && mizEqTrmListsE(eq, qa.second, qb.second);
				} else {
					// ikFrmPred with the SYMMETRY retry
					pa3 : MizPredFrm = mizEqAsPred(a);
					qa = mizAdjustFrm(env, pa3);
					qb = mizAdjustFrm(env, pb);
					if (qa.first != qb.first) {
						false;
					} else if (mizEqTrmListsE(eq, qa.second, qb.second)) {
						true;
					} else {
						c1 = mizConstr(env, coPredicate, pa3.predNr);
						if (mizHasProperty(c1, sySymmetry)) {
							sw = mizSwapArguments(pa3.args, c1.firstArg, c1.secondArg);
							swAdj = mizAdjustPredArgs(env, pa3.predNr, sw);
							mizEqTrmListsE(eq, swAdj, qb.second);
						} else {
							c2 = mizConstr(env, coPredicate, pb.predNr);
							if (mizHasProperty(c2, sySymmetry)) {
								sw = mizSwapArguments(pb.args, c2.firstArg, c2.secondArg);
								swAdj = mizAdjustPredArgs(env, pb.predNr, sw);
								mizEqTrmListsE(eq, qa.second, swAdj);
							} else {
								false;
							}
						}
					}
				}
			}
			MizLocPredFrm(predNr, args, __, __): {
				lb : MizLocPredFrm = mizEqAsLocPred(b);
				predNr == lb.predNr && mizEqTrmListsE(eq, args, lb.args);
			}
			MizUnivFrm(__, __, quantified, scope, __): {
				ub : MizUnivFrm = mizEqAsUniv(b);
				mizEqTypsE(eq, quantified, ub.quantified) && mizEqFrmsE(eq, scope, ub.scope);
			}
			default: {
				mizRunTimeError(2021);
				false;
			}
		}
	}
}

// AdjustTrmList for predicate args
mizAdjustPredArgs(env : MizCorrelEnv, predNr : int, args : MizTrmList) -> MizTrmList {
	c = mizConstr(env, coPredicate, predNr);
	if (c.whichConstrNr != 0) mizTrmListDrop(args, c.superfluous) else args;
}

// ---------------- Y-phase ----------------

mizYEqClass(eq : MizEqualizer, t : MizTrm) -> void {
	if (mizTrmNbr(eq) >= MaxTrmNbr) {
		eq.trmOvfl ::= true;
	} else {
		nr = mizTrmNbr(eq) + 1;
		mizSetTrmInfo(t, nr);
		eq.eqClassNbr ::= eq.eqClassNbr + 1;
		rep = mizNewVarTrm(ikTrmEqConst, eq.eqClassNbr);
		mizSetTrmInfo(rep, nr);
		xt : Vector<MizTyp> = makeVector(4);
		pushVector(xt, mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(),
			mizNewEmptyCluster(), mizBuiltIn(eq.env.builtIn, rqAny), MizTrmNil()));
		pushVector(eq.trmS, MizTrmSRec(rep, false, MizComplex(0.0, 0.0),
			MizTrmElem(t, MizTrmNil()), xt, mizNewEmptyCluster(), makeVector(2)));
	}
}

// InsertType: absorb fTyp into the class's type list (consumes fTyp)
mizInsertType(eq : MizEqualizer, fTyp0 : MizTyp, aTrmNr : int) -> void {
	env = eq.env;
	rec = mizTrmSAt(eq, aTrmNr);
	fTyp = ref fTyp0;
	stop = ref false;
	while(\ -> !^stop, \ -> {
		found = ref false;
		iterVector(rec.xTypClass, \xt -> {
			if (!^found && xt.sort == (^fTyp).sort && xt.modNr == (^fTyp).modNr
				&& mizEqTrmListsE(eq, xt.modArgs, (^fTyp).modArgs)) {
				found := true;
				// merge the upper cluster into the supercluster
				if (!mizAttrCollIsSubsetOf(env, (^fTyp).upper, rec.superCluster,
						\x, y -> mizEqAttrsE(eq, x, y))) {
					iterVector((^fTyp).upper.items, \a ->
						mizAttrCollInsert(env, rec.superCluster, mizCopyAttr(a)));
					if (!rec.superCluster.consistent) mizSetContr(eq, 1);
				}
			}
		});
		if (^found) {
			stop := true;
		} else {
			mizYType(eq, ^fTyp);
			iterVector((^fTyp).upper.items, \a ->
				mizAttrCollInsert(env, rec.superCluster, mizCopyAttr(a)));
			if (!rec.superCluster.consistent) mizSetContr(eq, 2);
			pushVector(rec.xTypClass, ^fTyp);
			if ((^fTyp).sort != ikTypMode || (^fTyp).modNr == 1) {
				stop := true;
			} else {
				switch (mizWidening(env, ^fTyp)) {
					Some(w): fTyp := w;
					None(): stop := true;
				}
			}
		}
	});
	// struct prefixes closure
	last = ref sizeVector(rec.xTypClass);
	cur = ref ^fTyp;
	structGo = ref (^cur).sort == ikTypStruct;
	while(\ -> ^structGo, \ -> {
		prefs = mizConstrPrefixes(env, (^cur).modNr);
		iterVector(prefs, \p -> {
			lTypPtr = mizInstTyp(env, p, (^cur).modArgs);
			mizYType(eq, lTypPtr);
			dup = ref false;
			iterVector(rec.xTypClass, \xt -> {
				if (xt.sort == lTypPtr.sort && xt.modNr == lTypPtr.modNr
					&& mizEqTrmListsE(eq, xt.modArgs, lTypPtr.modArgs)) dup := true;
			});
			if (!^dup) pushVector(rec.xTypClass, lTypPtr);
		});
		if (^last >= sizeVector(rec.xTypClass)) {
			structGo := false;
		} else {
			cur := getVectorUnsafe(rec.xTypClass, ^last);
			last := ^last + 1;
			structGo := true;
		}
	});
}

mizYTermList(eq : MizEqualizer, l : MizTrmList) -> void {
	switch (l) {
		MizTrmNil(): {}
		MizTrmElem(trm, next): {
			e : MizTrmElem = l;
			e.trm ::= mizYTerm(eq, trm);
			mizYTermList(eq, next);
		}
	}
}

mizYCluster(eq : MizEqualizer, c : MizAttrColl) -> void {
	iterVector(c.items, \a -> mizYTermList(eq, a.args));
}

mizYType(eq : MizEqualizer, t : MizTyp) -> void {
	mizYCluster(eq, t.lower);
	mizYCluster(eq, t.upper);
	mizYTermList(eq, t.modArgs);
}

mizYFormula(eq : MizEqualizer, f : MizFrm) -> void {
	env = eq.env;
	switch (f) {
		MizNegFrm(arg, __): mizYFormula(eq, arg);
		MizConjFrm(conjuncts, __): iterVector(conjuncts, \g -> mizYFormula(eq, g));
		MizUnivFrm(__, __, quantified, scope, __): {
			env.boundVarNbr ::= env.boundVarNbr + 1;
			mizYType(eq, quantified);
			mizYFormula(eq, scope);
			env.boundVarNbr ::= env.boundVarNbr - 1;
		}
		MizPredFrm(__, __, args, __): mizYTermList(eq, args);
		MizLocPredFrm(__, args, __, __): mizYTermList(eq, args);
		MizQualFrm(trm, typ, __): {
			mizYType(eq, typ);
			qf : MizQualFrm = f;
			qf.trm ::= mizYTerm(eq, trm);
		}
		MizFlexFrm(__, lo, ro, __, __, __, __): {
			mizYFormula(eq, lo);
			mizYFormula(eq, ro);
		}
		MizUniqFrm(__): {}
		MizBinFrm(__, __, __, __): mizRunTimeError(2023);
	}
}

mizYArgList(eq : MizEqualizer, l : MizTrmList) -> bool {
	mizYTermList(eq, l);
	ok = ref true;
	cur = ref l;
	while(\ -> switch (^cur) { MizTrmNil(): false; default: true; }, \ -> {
		switch (^cur) {
			MizTrmElem(trm, next): {
				if (mizTrmInfoOf(trm) == 0) ok := false;
				cur := next;
			}
			MizTrmNil(): {}
		}
	});
	^ok;
}

// funcTrmIdx access
mizFuncIdxFind(eq : MizEqualizer, kind : int, funcNr : int) -> Maybe<Vector<MizTrm>> {
	idx = getVectorUnsafe(eq.funcTrmIdx, kind);
	res : ref Maybe<Vector<MizTrm>> = ref None();
	iterVector(idx, \p -> {
		if (p.first == funcNr) res := Some(p.second);
	});
	^res;
}

mizFuncIdxAlloc(eq : MizEqualizer, kind : int, funcNr : int, t : MizTrm) -> void {
	idx = getVectorUnsafe(eq.funcTrmIdx, kind);
	switch (mizFuncIdxFind(eq, kind, funcNr)) {
		Some(v): pushVector(v, t);
		None(): {
			v : Vector<MizTrm> = makeVector(4);
			pushVector(v, t);
			pushVector(idx, Pair(funcNr, v));
		}
	}
}

mizAllocByTerm(eq : MizEqualizer, kind : int, t : MizTrm) -> void {
	switch (t) {
		MizFuncTrm(__, funcNr, __, __, __): mizFuncIdxAlloc(eq, kind, funcNr, t);
		MizPrivFuncTrm(funcNr, __, __, __, __): mizFuncIdxAlloc(eq, kind, funcNr, t);
		default: {}
	}
}

mizFindEqArgsTerm(eq : MizEqualizer, kind : int, funcNr : int, args : MizTrmList) -> Maybe<MizTrm> {
	switch (mizFuncIdxFind(eq, kind, funcNr)) {
		None(): None();
		Some(v): {
			res : ref Maybe<MizTrm> = ref None();
			i = ref 0;
			while(\ -> ^i < sizeVector(v) && isNone(^res), \ -> {
				cand : MizTrm = getVectorUnsafe(v, ^i);
				cargs = mizArgsOfE(cand);
				if (mizEqTrmListsE(eq, args, cargs)) res := Some(cand);
				i := ^i + 1;
			});
			^res;
		}
	}
}

mizArgsOfE(t : MizTrm) -> MizTrmList {
	switch (t) {
		MizFuncTrm(__, __, args, __, __): args;
		MizPrivFuncTrm(__, args, __, __, __): args;
		default: MizTrmNil();
	}
}

// sorted-collection stand-ins for FrOper/ChoiceTerm: linear Search by CompRdTrms
mizSortedFind(eq : MizEqualizer, v : Vector<MizTrm>, t : MizTrm) -> Maybe<MizTrm> {
	res : ref Maybe<MizTrm> = ref None();
	i = ref 0;
	while(\ -> ^i < sizeVector(v) && isNone(^res), \ -> {
		cand : MizTrm = getVectorUnsafe(v, ^i);
		if (mizCompRdTrmsPub(eq.env, cand, t) == 0) res := Some(cand);
		i := ^i + 1;
	});
	^res;
}

mizCompRdTrmsPub(env : MizCorrelEnv, a : MizTrm, b : MizTrm) -> int {
	saved = env.strictCompare;
	env.strictCompare ::= false;
	c = mizCompTrms(env, a, b);
	env.strictCompare ::= saved;
	c;
}

// YTerm — hash-cons a term into the classes; returns the canonical node.
mizYTerm(eq : MizEqualizer, t0 : MizTrm) -> MizTrm {
	env = eq.env;
	srt = mizTrmSort(t0);
	if (srt == ikTrmBound || srt == ikTrmEqConst || srt == ikError) {
		// ikError: poisoned content passes through unclassed
		t0;
	} else if (srt == ikTrmInfConst) {
		vt : MizVarTrm = mizEqAsVar(t0);
		cached = getVectorDef(eq.dTrm, vt.varNr, None());
		switch (cached) {
			Some(c): c;
			None(): {
				mizYEqClass(eq, t0);
				info = mizTrmInfoOf(t0);
				rep = mizTrmSAt(eq, info).term;
				while(\ -> sizeVector(eq.dTrm) <= vt.varNr,
					\ -> pushVector(eq.dTrm, None()));
				setVectorUnsafe(eq.dTrm, vt.varNr, Some(rep));
				cd : MizConstDef = getVectorUnsafe(env.inferConstDef, vt.varNr);
				switch (mizNumericValue(eq.idn, vt.varNr)) {
					Some(v): {
						rec = mizTrmSAt(eq, info);
						rec.numDetermined ::= true;
						rec.numValue ::= v;
					}
					None(): {}
				}
				aType = mizCopyExpTyp(cd.typ);
				mizYType(eq, aType);
				mizInsertType(eq, aType, info);
				rep;
			}
		}
	} else if (srt == ikTrmFunctor) {
		ft : MizFuncTrm = mizEqAsFunc(t0);
		orgTrm = mizCopyTrm(t0);
		if (!mizYArgList(eq, ft.args)) {
			t0;
		} else {
			lArgList1 = mizCopyTrmList(ft.args);
			// E_free: no EqConst inside the original copy
			eFree = ref true;
			w = mizMakeWithin(\__, trm -> {
				if (mizTrmSort(trm) == ikTrmEqConst) eFree := false;
				trm;
			});
			__w1 = mizWithinTrm(w, orgTrm);
			aType = if (^eFree) env.roundUpTrmType(env, orgTrm)
				else mizCopyTrmType(env, orgTrm);
			pa = mizAdjustTrm(env, ft);
			switch (mizFindEqArgsTerm(eq, expFunctor, pa.first, pa.second)) {
				Some(existing): mizTrmSAt(eq, mizTrmInfoOf(existing)).term;
				None(): {
					nt = mizNewFuncTrm(pa.first, mizCopyTrmList(pa.second));
					mizYEqClass(eq, nt);
					info = mizTrmInfoOf(nt);
					mizFuncIdxAllocT(eq, expFunctor, nt);
					mizYType(eq, aType);
					mizInsertType(eq, aType, info);
					// requirements: 0-number
					if (mizRevReqPub(eq.idn, mizAdjustedFuncNrE(env, nt)) == rqZeroNumber) {
						rec0 = mizTrmSAt(eq, info);
						rec0.numDetermined ::= true;
						rec0.numValue ::= MizComplex(0.0, 0.0);
					}
					// commutativity: add the swapped variant to the class
					c = mizConstr(env, coFunctor, ft.funcNr);
					if (mizHasProperty(c, syCommutativity)) {
						lCommTrm = mizNewFuncTrm(ft.funcNr,
							mizSwapArguments(lArgList1, c.firstArg, c.secondArg));
						swf : MizFuncTrm = mizEqAsFunc(lCommTrm);
						pw = mizAdjustTrm(env, swf);
						lCommTrm1 = mizNewFuncTrm(pw.first, mizCopyTrmList(pw.second));
						mizSetTrmInfo(lCommTrm1, info);
						rec1 = mizTrmSAt(eq, info);
						rec1.eqClass ::= mizAppendTrm(rec1.eqClass, lCommTrm1);
						mizFuncIdxAllocT(eq, expFunctor, lCommTrm1);
					}
					mizTrmSAt(eq, info).term;
				}
			}
		}
	} else if (srt == ikTrmSchFunc || srt == ikTrmPrivFunc || srt == ikTrmAggreg
		|| srt == ikTrmSelector) {
		args = mizArgsOfE(t0);
		if (!mizYArgList(eq, args)) {
			t0;
		} else {
			kind = if (srt == ikTrmSchFunc) expSchFunc
				else if (srt == ikTrmPrivFunc) expPrivFunc
				else if (srt == ikTrmAggreg) expAggreg
				else expSelector;
			fn = mizFuncNrOfE(t0);
			hit = if (srt == ikTrmSchFunc) None()
				else mizFindEqArgsTerm(eq, kind, fn, args);
			switch (hit) {
				Some(existing): mizTrmSAt(eq, mizTrmInfoOf(existing)).term;
				None(): {
					mizYEqClass(eq, t0);
					info2 = mizTrmInfoOf(t0);
					if (srt != ikTrmSchFunc) mizFuncIdxAllocT(eq, kind, t0);
					aType2 = mizCopyTrmType(env, t0);
					mizYType(eq, aType2);
					mizInsertType(eq, aType2, info2);
					mizTrmSAt(eq, info2).term;
				}
			}
		}
	} else if (srt == ikTrmFraenkel) {
		kt : MizFraenkelTrm = mizEqAsFraenkel(t0);
		lB = env.boundVarNbr;
		iterVector(kt.lambdaArgs, \typ -> {
			env.boundVarNbr ::= env.boundVarNbr + 1;
			mizYType(eq, typ);
		});
		kt.scope ::= mizYTerm(eq, kt.scope);
		mizYFormula(eq, kt.compr);
		env.boundVarNbr ::= lB;
		// bound vars must remain — Fraenkel operators stay unclassed here
		t0;
	} else if (srt == ikTrmChoice) {
		ct : MizChoiceTrm = mizEqAsChoice(t0);
		mizYType(eq, ct.choiceTyp);
		bound = mizHasBoundE(eq, t0);
		if (bound) {
			t0;
		} else {
			switch (mizSortedFind(eq, eq.choiceTerm, t0)) {
				Some(existing): mizTrmSAt(eq, mizTrmInfoOf(existing)).term;
				None(): {
					mizYEqClass(eq, t0);
					info3 = mizTrmInfoOf(t0);
					pushVector(eq.choiceTerm, t0);
					aType3 = mizCopyTrmType(env, t0);
					mizYType(eq, aType3);
					mizInsertType(eq, aType3, info3);
					mizTrmSAt(eq, info3).term;
				}
			}
		}
	} else if (srt == ikTrmNumeral) {
		// A numeral normally reaches the equalizer already collected into an
		// InfConst (CollectInferConst), which is why the original's YTerm has
		// no numeral case. Some paths (reduction/identification instantiation)
		// can still present one: give it a class by VALUE, as YYTerm does,
		// rather than aborting.
		vt4 : MizVarTrm = mizEqAsVar(t0);
		found4 : ref Maybe<MizTrm> = ref None();
		i4 = ref 1;
		while(\ -> ^found4 == None() && ^i4 <= mizTrmNbr(eq), \ -> {
			rec4 = mizTrmSAt(eq, ^i4);
			live4 = switch (rec4.eqClass) { MizTrmNil(): false; default: true; };
			if (live4 && rec4.numDetermined && rec4.numValue.im == 0.0
				&& rec4.numValue.re == i2d(vt4.varNr)) {
				found4 := Some(rec4.term);
			}
			i4 := ^i4 + 1;
		});
		switch (^found4) {
			Some(rep4): rep4;
			None(): {
				mizYEqClass(eq, t0);
				info4 = mizTrmInfoOf(t0);
				rec5 = mizTrmSAt(eq, info4);
				rec5.numDetermined ::= true;
				rec5.numValue ::= MizComplex(i2d(vt4.varNr), 0.0);
				aType4 = mizCopyTrmType(env, t0);
				mizYType(eq, aType4);
				mizInsertType(eq, aType4, info4);
				mizTrmSAt(eq, info4).term;
			}
		}
	} else {
		mizRunTimeError(2024);
		t0;
	}
}

mizHasBoundE(eq : MizEqualizer, t : MizTrm) -> bool {
	env = eq.env;
	found = ref false;
	w = mizMakeWithin(\__, trm -> {
		switch (trm) {
			MizVarTrm(s2, v2, __, __): {
				if (s2 == ikTrmBound && v2 <= env.boundVarNbr) found := true;
				trm;
			}
			default: trm;
		}
	});
	__x = mizWithinTrm(w, t);
	^found;
}

mizFuncIdxAllocT(eq : MizEqualizer, kind : int, t : MizTrm) -> void {
	mizAllocByTerm(eq, kind, t);
}

mizFuncNrOfE(t : MizTrm) -> int {
	switch (t) {
		MizFuncTrm(__, funcNr, __, __, __): funcNr;
		MizPrivFuncTrm(funcNr, __, __, __, __): funcNr;
		default: 0;
	}
}

mizAdjustedFuncNrE(env : MizCorrelEnv, t : MizTrm) -> int {
	switch (t) {
		MizFuncTrm(srt, funcNr, __, __, __): {
			if (srt == ikTrmFunctor) {
				c = mizConstr(env, coFunctor, funcNr);
				if (c.whichConstrNr == 0) funcNr else c.whichConstrNr;
			} else {
				funcNr;
			}
		}
		default: 0;
	}
}

mizRevReqPub(idn : MizIdentify, funcNr : int) -> int {
	if (funcNr >= 0 && funcNr < sizeVector(idn.revReq))
		getVectorUnsafe(idn.revReq, funcNr)
	else rqNone;
}

mizAppendTrm(l : MizTrmList, t : MizTrm) -> MizTrmList {
	switch (l) {
		MizTrmNil(): MizTrmElem(t, MizTrmNil());
		MizTrmElem(__, __): {
			last = mizLastElem(l);
			last.next ::= MizTrmElem(t, MizTrmNil());
			l;
		}
	}
}

// YYTerm: Y the parts of fTrm and merge it into class fi (or find its class)
mizYYTerm(eq : MizEqualizer, t0 : MizTrm, fi0 : int) -> int {
	env = eq.env;
	fi = ref fi0;
	srt = mizTrmSort(t0);
	handled = ref false;
	if (srt == ikTrmNumeral) {
		vt : MizVarTrm = mizEqAsVar(t0);
		i = ref 1;
		while(\ -> !^handled && ^i <= mizTrmNbr(eq), \ -> {
			rec = mizTrmSAt(eq, ^i);
			isNil = switch (rec.eqClass) { MizTrmNil(): true; default: false; };
			if (!isNil && rec.numDetermined
				&& rec.numValue.re == i2d(vt.varNr) && rec.numValue.im == 0.0) {
				fi := mizTrmInfoOf(rec.term);
				handled := true;
			}
			i := ^i + 1;
		});
	} else if (srt == ikTrmFunctor) {
		ft : MizFuncTrm = mizEqAsFunc(t0);
		mizYTermList(eq, ft.args);
		pa = mizAdjustTrm(env, ft);
		switch (mizFindEqArgsTerm(eq, expFunctor, pa.first, pa.second)) {
			Some(existing): {
				fi := mizTrmInfoOf(existing);
				handled := true;
			}
			None(): {
				c = mizConstr(env, coFunctor, ft.funcNr);
				if (mizHasProperty(c, syCommutativity)) {
					lCommTrm = mizNewFuncTrm(ft.funcNr,
						mizSwapArguments(ft.args, c.firstArg, c.secondArg));
					cf : MizFuncTrm = mizEqAsFunc(lCommTrm);
					pw = mizAdjustTrm(env, cf);
					switch (mizFindEqArgsTerm(eq, expFunctor, pw.first, pw.second)) {
						Some(existing2): {
							fi := mizTrmInfoOf(existing2);
							handled := true;
						}
						None(): {}
					}
				}
			}
		}
	} else if (srt == ikTrmSchFunc || srt == ikTrmPrivFunc || srt == ikTrmSelector) {
		args = mizArgsOfE(t0);
		mizYTermList(eq, args);
		kind = if (srt == ikTrmSchFunc) expSchFunc
			else if (srt == ikTrmPrivFunc) expPrivFunc else expSelector;
		switch (mizFindEqArgsTerm(eq, kind, mizFuncNrOfE(t0), args)) {
			Some(existing): {
				fi := mizTrmInfoOf(existing);
				handled := true;
			}
			None(): {}
		}
	} else if (srt == ikTrmAggreg) {
		ft2 : MizFuncTrm = mizEqAsFunc(t0);
		mizYTermList(eq, ft2.args);
		ca = mizConstr(env, coAggregate, ft2.funcNr);
		base = ca.aggregBase;
		switch (mizFuncIdxFind(eq, expAggreg, ft2.funcNr)) {
			Some(v): {
				i = ref 0;
				while(\ -> !^handled && ^i < sizeVector(v), \ -> {
					cand : MizTrm = getVectorUnsafe(v, ^i);
					if (mizEqTrmListsE(eq, mizTrmListDrop(ft2.args, base),
							mizTrmListDrop(mizArgsOfE(cand), base))) {
						fi := mizTrmInfoOf(cand);
						handled := true;
					}
					i := ^i + 1;
				});
			}
			None(): {}
		}
	} else if (srt == ikTrmFraenkel) {
		kt : MizFraenkelTrm = mizEqAsFraenkel(t0);
		iterVector(kt.lambdaArgs, \typ -> {
			env.boundVarNbr ::= env.boundVarNbr + 1;
			mizYType(eq, typ);
		});
		kt.scope ::= mizYTerm(eq, kt.scope);
		mizYFormula(eq, kt.compr);
		env.boundVarNbr ::= env.boundVarNbr - sizeVector(kt.lambdaArgs);
		if (mizHasBoundE(eq, t0)) {
			handled := true; // dropped
		} else {
			// ChChangeBound: re-base the closed Fraenkel's bound vars to a
			// canonical numbering before hash-consing (correl.pas 3070)
			mizChChangeBoundE(eq, t0);
			switch (mizSortedFind(eq, eq.frOper, t0)) {
				Some(existing): {
					fi := mizTrmInfoOf(existing);
					handled := true;
				}
				None(): {}
			}
		}
	} else if (srt == ikTrmChoice) {
		ct : MizChoiceTrm = mizEqAsChoice(t0);
		mizYType(eq, ct.choiceTyp);
		switch (mizSortedFind(eq, eq.choiceTerm, t0)) {
			Some(existing): {
				fi := mizTrmInfoOf(existing);
				handled := true;
			}
			None(): {}
		}
	} else if (srt == ikTrmInfConst || srt == ikTrmConstant) {
		handled := true;
	} else {
		mizRunTimeError(2026);
		handled := true;
	}
	if (!^handled) {
		// insert t0 into the class of fi
		clNr = mizClassOf(eq, ^fi);
		rec = mizTrmSAt(eq, clNr);
		if (srt == ikTrmNumeral) {
			vt2 : MizVarTrm = mizEqAsVar(t0);
			if (!rec.numDetermined) {
				rec.numDetermined ::= true;
				rec.numValue ::= MizComplex(i2d(vt2.varNr), 0.0);
			} else if (!(rec.numValue.re == i2d(vt2.varNr) && rec.numValue.im == 0.0)) {
				mizSetContr(eq, 3);
			}
			mizSetTrmInfo(t0, ^fi);
		} else if (srt == ikTrmFunctor) {
			ft3 : MizFuncTrm = mizEqAsFunc(t0);
			iNr = mizAdjustedFuncNrE(env, t0);
			if (mizRevReqPub(eq.idn, iNr) == rqImaginaryUnit) {
				rec.numDetermined ::= true;
				rec.numValue ::= MizComplex(0.0, 1.0);
			}
			if (mizRevReqPub(eq.idn, iNr) == rqZeroNumber) {
				rec.numDetermined ::= true;
				rec.numValue ::= MizComplex(0.0, 0.0);
			}
			pa2 = mizAdjustTrm(env, ft3);
			nt = mizNewFuncTrm(pa2.first, mizCopyTrmList(pa2.second));
			mizSetTrmInfo(nt, ^fi);
			mizFuncIdxAllocT(eq, expFunctor, nt);
			rec.eqClass ::= MizTrmElem(nt, rec.eqClass);
			c3 = mizConstr(env, coFunctor, ft3.funcNr);
			if (mizHasProperty(c3, syCommutativity)) {
				lc = mizNewFuncTrm(ft3.funcNr,
					mizSwapArguments(ft3.args, c3.firstArg, c3.secondArg));
				cf3 : MizFuncTrm = mizEqAsFunc(lc);
				pw3 = mizAdjustTrm(env, cf3);
				lc1 = mizNewFuncTrm(pw3.first, mizCopyTrmList(pw3.second));
				mizSetTrmInfo(lc1, ^fi);
				rec.eqClass ::= MizTrmElem(lc1, rec.eqClass);
				mizFuncIdxAllocT(eq, expFunctor, lc1);
			}
		} else {
			mizSetTrmInfo(t0, ^fi);
			rec.eqClass ::= MizTrmElem(t0, rec.eqClass);
			if (srt == ikTrmSchFunc) mizFuncIdxAllocT(eq, expSchFunc, t0)
			else if (srt == ikTrmPrivFunc) mizFuncIdxAllocT(eq, expPrivFunc, t0)
			else if (srt == ikTrmSelector) mizFuncIdxAllocT(eq, expSelector, t0)
			else if (srt == ikTrmAggreg) mizFuncIdxAllocT(eq, expAggreg, t0)
			else if (srt == ikTrmFraenkel) pushVector(eq.frOper, t0)
			else if (srt == ikTrmChoice) pushVector(eq.choiceTerm, t0);
		}
	}
	^fi;
}

// ---------------- UnionTrms ----------------

mizUnionTrms(eq : MizEqualizer, e1 : int, e2 : int) -> void {
	env = eq.env;
	a0 = mizClassOf(eq, e1);
	b0 = mizClassOf(eq, e2);
	if (a0 != b0) {
		// larger index merges INTO smaller
		a = max(a0, b0);
		b = min(a0, b0);
		eq.clash ::= true;
		ra = mizTrmSAt(eq, a);
		rb = mizTrmSAt(eq, b);
		if (ra.numDetermined) {
			if (rb.numDetermined) {
				if (!(ra.numValue.re == rb.numValue.re && ra.numValue.im == rb.numValue.im)) {
					mizSetContr(eq, 5);
				}
			} else {
				rb.numDetermined ::= true;
				rb.numValue ::= ra.numValue;
			}
		}
		if (eq.contr == 0) {
			// re-point every member of a's class to b
			cur = ref ra.eqClass;
			while(\ -> switch (^cur) { MizTrmNil(): false; default: true; }, \ -> {
				switch (^cur) {
					MizTrmElem(trm, next): {
						mizSetTrmInfo(mizTrmSAt(eq, mizTrmInfoOf(trm)).term, b);
						cur := next;
					}
					MizTrmNil(): {}
				}
			});
			// splice class lists
			rb.eqClass ::= mizConcatTrmLists(rb.eqClass, ra.eqClass);
			ra.eqClass ::= MizTrmNil();
			// merge superclusters
			merged = mizNewEmptyCluster();
			iterVector(rb.superCluster.items, \x ->
				mizAttrCollInsert(env, merged, mizCopyAttr(x)));
			iterVector(ra.superCluster.items, \x ->
				mizAttrCollInsert(env, merged, mizCopyAttr(x)));
			rb.superCluster ::= merged;
			if (!merged.consistent) mizSetContr(eq, 6);
			ra.superCluster ::= mizNewEmptyCluster();
			// merge type lists
			iterVector(ra.xTypClass, \typ -> mizInsertType(eq, typ, b));
			clearVector(ra.xTypClass);
			// polynomial values: absorbed class's values move to the survivor;
			// two values with a plain-variable one eliminate the variable
			iterVector(ra.polynomialValues, \pv -> mizPolyValInsert(rb.polynomialValues, pv));
			clearVector(ra.polynomialValues);
			if (sizeVector(rb.polynomialValues) == 2) {
				pend = mizInitNatSet(8);
				iP = mizPolyIsVariable(getVectorUnsafe(rb.polynomialValues, 0));
				jP = mizPolyIsVariable(getVectorUnsafe(rb.polynomialValues, 1));
				if (iP > 0) {
					if (jP > 0 && iP < jP) {
						removeVector(rb.polynomialValues, 1);
						__sv1 = mizSubstituteVariableP(eq, jP,
							getVectorUnsafe(rb.polynomialValues, 0), pend);
						{}
					} else {
						removeVector(rb.polynomialValues, 0);
						__sv2 = mizSubstituteVariableP(eq, iP,
							getVectorUnsafe(rb.polynomialValues, 0), pend);
						{}
					}
				} else if (jP > 0) {
					removeVector(rb.polynomialValues, 1);
					__sv3 = mizSubstituteVariableP(eq, jP,
						getVectorUnsafe(rb.polynomialValues, 0), pend);
					{}
				}
				mizSubstitutePendingVars(eq, pend);
			}
		}
	}
}

mizConcatTrmLists(a : MizTrmList, b : MizTrmList) -> MizTrmList {
	switch (a) {
		MizTrmNil(): b;
		MizTrmElem(__, __): {
			last = mizLastElem(a);
			last.next ::= b;
			a;
		}
	}
}

// AddEquality with dedup (AddEquality in the original checks IsMember)
mizAddEquality(pend : Vector<MizIntPair>, x : int, y : int) -> void {
	dup = ref false;
	iterVector(pend, \p -> if (p.x == x && p.y == y) dup := true);
	if (!^dup) pushVector(pend, MizIntPair(x, y));
}

// ---------------- Renum + contradiction sweeps ----------------

mizRenumEqClasses(eq : MizEqualizer) -> void {
	env = eq.env;
	eq.eqClassNbr ::= 0;
	fori(1, mizTrmNbr(eq), \ii -> {
		rec = mizTrmSAt(eq, ii);
		live = switch (rec.eqClass) { MizTrmNil(): false; default: true; };
		if (live) {
			eq.eqClassNbr ::= eq.eqClassNbr + 1;
			vt : MizVarTrm = mizEqAsVar(rec.term);
			vt.varNr ::= eq.eqClassNbr;
		}
	});
	fori(1, mizTrmNbr(eq), \ii -> {
		rec = mizTrmSAt(eq, ii);
		repClass = mizTrmInfoOf(rec.term);
		if (repClass > 0 && repClass <= mizTrmNbr(eq)) {
			vRep : MizVarTrm = mizEqAsVar(mizTrmSAt(eq, repClass).term);
			vt2 : MizVarTrm = mizEqAsVar(rec.term);
			vt2.varNr ::= vRep.varNr;
		}
	});
	fori(1, mizTrmNbr(eq), \ii -> {
		rec = mizTrmSAt(eq, ii);
		live = switch (rec.eqClass) { MizTrmNil(): false; default: true; };
		if (live && eq.contr == 0) {
			fresh = mizNewEmptyCluster();
			iterVector(rec.superCluster.items, \x ->
				mizAttrCollInsert(env, fresh, mizCopyAttr(x)));
			if (!fresh.consistent) mizSetContr(eq, 17);
			rec.superCluster ::= fresh;
		}
	});
}

mizLastArgE(l : MizTrmList) -> MizTrm {
	mizLastElem(l).trm;
}

mizAllButLast(l : MizTrmList) -> MizTrmList {
	switch (l) {
		MizTrmNil(): l;
		MizTrmElem(trm, next): {
			switch (next) {
				MizTrmNil(): MizTrmNil();
				MizTrmElem(__, __): MizTrmElem(trm, mizAllButLast(next));
			}
		}
	}
}

// GetArgs2 by property arg positions (1-based)
mizGetArgs2(l : MizTrmList, first : int, second : int) -> Pair<MizTrm, MizTrm> {
	Pair(mizTrmListNth(l, first - 1), mizTrmListNth(l, second - 1));
}

mizContradictionVerify(eq : MizEqualizer) -> void {
	env = eq.env;
	i = ref 0;
	while(\ -> eq.contr == 0 && ^i < sizeVector(eq.negBas), \ -> {
		nf : MizFrm = getVectorUnsafe(eq.negBas, ^i);
		switch (nf) {
			MizPredFrm(srt, predNr, args, __): {
				if (srt == ikFrmAttr) {
					la = mizGetAttr(eq, mizTrmSAt(eq, mizTrmInfoOf(mizLastArgE(args))).superCluster,
						predNr, mizAllButLast(args));
					switch (la) {
						Some(at): if (at.neg == 1) mizSetContr(eq, 18);
						None(): {}
					}
				} else if (srt == ikFrmPred) {
					c = mizConstr(env, coPredicate, predNr);
					if (mizHasProperty(c, syReflexivity)) {
						p2 = mizGetArgs2(args, c.firstArg, c.secondArg);
						if (mizTrmInfoOf(p2.first) == mizTrmInfoOf(p2.second)) {
							mizSetContr(eq, 19);
						}
					}
				}
				if (eq.contr == 0) {
					iterVector(eq.posBas, \pf -> {
						if (eq.contr == 0 && mizEqFrmsE(eq, pf, nf)) mizSetContr(eq, 20);
					});
				}
			}
			MizQualFrm(trm, typ, __): {
				rec = mizTrmSAt(eq, mizTrmInfoOf(trm));
				iterVector(rec.xTypClass, \xt -> {
					if (eq.contr == 0 && mizEqRadices(env, typ, xt)) mizSetContr(eq, 21);
				});
			}
			default: {}
		}
		i := ^i + 1;
	});
}

mizInsertNonEmpty(eq : MizEqualizer, i1 : int, i2 : int) -> void {
	env = eq.env;
	rqE = mizBuiltIn(env.builtIn, rqEmpty);
	if (rqE > 0) {
		switch (mizGetAttr(eq, mizTrmSAt(eq, i1).superCluster, rqE, MizTrmNil())) {
			Some(a): {
				if (a.neg == 1) {
					mizInsertAttrE(eq, mizTrmSAt(eq, i2).superCluster, rqE, 0, MizTrmNil());
					if (!mizTrmSAt(eq, i2).superCluster.consistent) mizSetContr(eq, 22);
				}
			}
			None(): {}
		}
	}
}

mizInsertNonZero(eq : MizEqualizer, i1 : int, i2 : int) -> void {
	env = eq.env;
	rqZ = mizBuiltIn(env.builtIn, rqZero);
	if (rqZ > 0) {
		switch (mizGetAttr(eq, mizTrmSAt(eq, i1).superCluster, rqZ, MizTrmNil())) {
			Some(a): {
				if (a.neg == 1) {
					mizInsertAttrE(eq, mizTrmSAt(eq, i2).superCluster, rqZ, 0, MizTrmNil());
					if (!mizTrmSAt(eq, i2).superCluster.consistent) mizSetContr(eq, 23);
				}
			}
			None(): {}
		}
	}
}

// ---------------- Equate ----------------

mizEquate(eq0 : MizEqualizer, eval : MizNatFunc) -> void {
	// fresh state per disjunct: rebuild through a new equalizer is the caller's
	// job; this function assumes a freshly made eq0.
	eq = eq0;
	env = eq.env;
	pre = eq.pre;
	basic = pre.basic;

	// load POSITIVE literals
	i = ref 0;
	while(\ -> eq.contr == 0 && ^i < sizeVector(basic), \ -> {
		j = ^i;
		if (mizNatHasInDom(eval, j) && mizNatValue(eval, j) == 1) {
			bf : MizFrm = getVectorUnsafe(basic, j);
			switch (bf) {
				MizQualFrm(trm, typ, __): {
					xType = mizCopyTyp(typ);
					xTerm = mizCopyTrm(trm);
					mizYType(eq, xType);
					xTerm2 = mizYTerm(eq, xTerm);
					if (getUrlParameterDef("dbg-qual", "") == "1") {
						println("QUAL insert cls=" + i2s(mizTrmInfoOf(xTerm2)));
					}
					mizInsertType(eq, xType, mizTrmInfoOf(xTerm2));
				}
				MizPredFrm(srt, predNr, args, __): {
					if (srt == ikFrmAttr) {
						lTrmList = mizCopyTrmList(mizAllButLast(args));
						lTrm = mizCopyTrm(mizLastArgE(args));
						mizYTermList(eq, lTrmList);
						lTrm2 = mizYTerm(eq, lTrm);
						cls = mizClassOf(eq, mizTrmInfoOf(lTrm2));
						mizInsertAttrE(eq, mizTrmSAt(eq, cls).superCluster, predNr, 1, lTrmList);
						if (!mizTrmSAt(eq, cls).superCluster.consistent) mizSetContr(eq, 24);
					} else if (srt == ikFrmPred) {
						pfE : MizPredFrm = mizEqAsPred(bf);
						pa = mizAdjustFrm(env, pfE);
						if (pa.first == mizBuiltIn(env.builtIn, rqEqualsTo)) {
							xT = mizYTerm(eq, mizCopyTrm(mizTrmListNth(pa.second, 0)));
							xT1 = mizYTerm(eq, mizCopyTrm(mizTrmListNth(pa.second, 1)));
							if (mizTrmInfoOf(xT) != mizTrmInfoOf(xT1)) {
								mizAddEquality(eq.eqPend, mizTrmInfoOf(xT), mizTrmInfoOf(xT1));
							}
						} else {
							lFrm = mizCopyFrm(bf);
							mizYFormula(eq, lFrm);
							pushVector(eq.posBas, lFrm);
						}
					} else {
						lFrm = mizCopyFrm(bf);
						mizYFormula(eq, lFrm);
						pushVector(eq.posBas, lFrm);
					}
				}
				default: {
					lFrm = mizCopyFrm(bf);
					mizYFormula(eq, lFrm);
					pushVector(eq.posBas, lFrm);
				}
			}
		}
		i := ^i + 1;
	});
	if (eq.contr == 0) {
		// load NEGATIVE literals
		i2 = ref 0;
		while(\ -> eq.contr == 0 && ^i2 < sizeVector(basic), \ -> {
			j = ^i2;
			if (mizNatHasInDom(eval, j) && mizNatValue(eval, j) == 0) {
				bf : MizFrm = getVectorUnsafe(basic, j);
				isNegAttr = switch (bf) {
					MizPredFrm(srt, __, __, __): srt == ikFrmAttr;
					default: false;
				};
				if (isNegAttr) {
					pf : MizPredFrm = mizEqAsPred(bf);
					lTrmList = mizCopyTrmList(mizAllButLast(pf.args));
					lTrm = mizCopyTrm(mizLastArgE(pf.args));
					mizYTermList(eq, lTrmList);
					lTrm2 = mizYTerm(eq, lTrm);
					cls = mizClassOf(eq, mizTrmInfoOf(lTrm2));
					mizInsertAttrE(eq, mizTrmSAt(eq, cls).superCluster, pf.predNr, 0, lTrmList);
					if (!mizTrmSAt(eq, cls).superCluster.consistent) mizSetContr(eq, 25);
				} else {
					lFrm = mizCopyFrm(bf);
					mizYFormula(eq, lFrm);
					pushVector(eq.negBas, lFrm);
				}
			}
			i2 := ^i2 + 1;
		});
	}
	if (eq.contr == 0) mizEquatePhase2(eq);
}

// Phase 2 of Equate: closures, unions and the contradiction machinery.
mizEquatePhase2(eq : MizEqualizer) -> void {
	env = eq.env;

	// registrations restricted to available constants (InitAllowedClusters)
	mizInitAllowedClusters(eq);

	// asymmetry: a positive asymmetric P(x,y) yields the negative P(y,x)
	iterVector(copyVector(eq.posBas), \pf -> {
		switch (pf) {
			MizPredFrm(srt, predNr, args, __): {
				if (srt == ikFrmPred) {
					c = mizConstr(env, coPredicate, predNr);
					if (mizHasProperty(c, syAsymmetry)) {
						there = ref false;
						iterVector(eq.negBas, \g -> if (mizEqFrmsE(eq, pf, g)) there := true);
						if (!^there) {
							pushVector(eq.negBas, mizNewPredFrm(srt, predNr,
								mizSwapArguments(args, c.firstArg, c.secondArg), 0));
						}
					}
				}
			}
			default: {}
		}
	});
	// connectedness: a negative connected P(x,y) yields the positive P(y,x)
	iterVector(copyVector(eq.negBas), \nf -> {
		switch (nf) {
			MizPredFrm(srt, predNr, args, __): {
				if (srt == ikFrmPred) {
					c = mizConstr(env, coPredicate, predNr);
					if (mizHasProperty(c, syConnectedness)) {
						there = ref false;
						iterVector(eq.posBas, \g -> if (mizEqFrmsE(eq, nf, g)) there := true);
						if (!^there) {
							pushVector(eq.posBas, mizNewPredFrm(srt, predNr,
								mizSwapArguments(args, c.firstArg, c.secondArg), 0));
						}
					}
				}
			}
			default: {}
		}
	});

	// InfConst members: pull in fEqConst equalities and the definitional term
	ii = ref 1;
	while(\ -> eq.contr == 0 && ^ii <= mizTrmNbr(eq), \ -> {
		rec = mizTrmSAt(eq, ^ii);
		cur = ref rec.eqClass;
		while(\ -> switch (^cur) { MizTrmNil(): false; default: true; }, \ -> {
			switch (^cur) {
				MizTrmElem(trm, next): {
					switch (trm) {
						MizVarTrm(srt, varNr, __, __): {
							if (srt == ikTrmInfConst) {
								cd : MizConstDef = getVectorUnsafe(env.inferConstDef, varNr);
								fori(0, mizNatCount(cd.eqConst) - 1, \z -> {
									other = mizNatItem(cd.eqConst, z).x;
									lTrm = mizYTerm(eq, mizNewVarTrm(ikTrmInfConst, other));
									if (^ii != mizTrmInfoOf(lTrm)) {
										mizAddEquality(eq.eqPend, ^ii, mizTrmInfoOf(lTrm));
									}
								});
								dTrm = mizCopyExpTrm(cd.def);
								xi = mizYYTerm(eq, dTrm, ^ii);
								if (^ii != xi) {
									mizAddEquality(eq.settings, ^ii, xi);
								}
							}
						}
						default: {}
					}
					cur := next;
				}
				MizTrmNil(): {}
			}
		});
		ii := ^ii + 1;
	});
	if (eq.contr == 0) mizInitEmptyInEqClass(eq);
	if (eq.contr == 0 && !eq.trmOvfl) mizInitStructuresInEqClass(eq);
	if (eq.contr == 0) mizProcessReductions(eq);

	// the polynomial pipeline (equalizer.pas 4230-4300)
	if (eq.contr == 0) mizInitSuperClusterForComplex(eq);
	if (eq.contr == 0) mizUnionEqualsForNonComplex(eq);
	if (eq.contr == 0) mizInitPolynomialValues(eq);
	if (eq.contr == 0) mizSubstituteSettings(eq);
	if (eq.contr == 0) mizClearPolynomialValues(eq);
	if (eq.contr == 0) mizEquatePolynomialValues(eq);
	if (eq.contr == 0) mizEquatePolynomials(eq);
	if (eq.contr == 0) mizClearPolynomialValues(eq);
	if (eq.contr == 0) mizProcessLinearEquations(eq);
	if (eq.contr == 0) {
		iterVector(eq.eqPend, \p -> if (eq.contr == 0) mizUnionTrms(eq, p.x, p.y));
		clearVector(eq.eqPend);
	}
	if (eq.contr == 0) mizEquatePolynomials(eq);
	// the congruence + polynomial fixpoint
	outerCl = ref true;
	while(\ -> eq.contr == 0 && ^outerCl, \ -> {
		mizClearPolynomialValues(eq);
		if (eq.contr == 0) mizIdentities(eq);
		if (eq.contr == 0) {
			savedClash = eq.clash;
			eq.clash ::= false;
			mizEquatePolynomials(eq);
			outerCl := eq.clash;
			eq.clash ::= savedClash;
		} else {
			outerCl := false;
		}
	});
	if (eq.contr == 0) mizRenumEqClasses(eq);
	if (eq.contr == 0) mizContradictionVerify(eq);

	// reflexivity of negatives: transfer non-empty / non-zero between args
	if (eq.contr == 0) {
		iterVector(eq.negBas, \nf -> {
			if (eq.contr == 0) {
				switch (nf) {
					MizPredFrm(srt, predNr, args, __): {
						if (srt == ikFrmPred) {
							c = mizConstr(env, coPredicate, predNr);
							if (mizHasProperty(c, syReflexivity)) {
								p2 = mizGetArgs2(args, c.firstArg, c.secondArg);
								i1 = mizTrmInfoOf(p2.first);
								i2 = mizTrmInfoOf(p2.second);
								mizInsertNonEmpty(eq, i1, i2);
								mizInsertNonEmpty(eq, i2, i1);
								mizInsertNonZero(eq, i1, i2);
								mizInsertNonZero(eq, i2, i1);
							}
						}
					}
					default: {}
				}
			}
		});
	}
	if (eq.contr == 0) mizPositiveRequirementRules(eq);
	if (eq.contr == 0) mizPowersetRule(eq);
	if (eq.contr == 0) mizNegativeSweep(eq);
	// RoundUpSuperCluster over the dependency stack (the EqStack loop)
	if (eq.contr == 0) mizSuperClusterRoundLoop(eq);
	// rqPrime numeric check — slice 2 (polynom.pas exact integers)
}

// InitEmptyInEqClass: classes with the `empty` attribute all equal {} (and 0)
mizInitEmptyInEqClass(eq : MizEqualizer) -> void {
	env = eq.env;
	doOne = \attrRq : int, funcRq : int -> {
		fRq = mizBuiltIn(env.builtIn, funcRq);
		aRq = mizBuiltIn(env.builtIn, attrRq);
		if (fRq != 0) {
			ii = ref 1;
			while(\ -> ^ii <= mizTrmNbr(eq), \ -> {
				rec = mizTrmSAt(eq, ^ii);
				live = switch (rec.eqClass) { MizTrmNil(): false; default: true; };
				if (live) {
					switch (mizGetAttr(eq, rec.superCluster, aRq, MizTrmNil())) {
						Some(a): {
							if (a.neg == 1) {
								lUnique = mizYTerm(eq, mizNewFuncTrm(fRq, MizTrmNil()));
								if (^ii != mizTrmInfoOf(lUnique)) {
									mizAddEquality(eq.eqPend, ^ii, mizTrmInfoOf(lUnique));
								}
							}
						}
						None(): {}
					}
				}
				ii := ^ii + 1;
			});
		}
	};
	doOne(rqEmpty, rqEmptySet);
	doOne(rqZero, rqZeroNumber);
}

// InitStructuresInEqClass: strict-struct scan; ReconAggregTrm equations are
// slice 2 (struct support).
mizInitStructuresInEqClass(eq : MizEqualizer) -> void {
	env = eq.env;
	ii = ref 1;
	while(\ -> eq.contr == 0 && ^ii <= mizTrmNbr(eq), \ -> {
		rec = mizTrmSAt(eq, ^ii);
		live = switch (rec.eqClass) { MizTrmNil(): false; default: true; };
		if (live) {
			strictStruct = ref 0;
			iterVector(rec.superCluster.items, \a -> {
				ca = mizConstr(env, coAttribute, a.attrNr);
				isStrict = mizHasProperty(ca, syAbstractness) && a.neg == 1;
				if (isStrict && eq.contr == 0) {
					switch (ca.typ) {
						Some(ct): {
							if (^strictStruct == 0) strictStruct := ct.modNr
							else if (ct.modNr != ^strictStruct) mizSetContr(eq, 12);
						}
						None(): {}
					}
				}
			});
			// the strict struct's aggregate reconstruction: for every struct
			// type of the class, aggregate(selectors of the representative)
			// must equal the representative (equalizer.pas 2790-2815)
			if (^strictStruct != 0 && eq.contr == 0) {
				lEqs : Vector<MizIntPair> = makeVector(4);
				iterVector(copyVector(rec.xTypClass), \xt -> {
					if (xt.sort == ikTypStruct && xt.modNr == ^strictStruct) {
						lTrm = mizReconAggregTrm(env, ^strictStruct, rec.term,
							mizCopyTyp(xt));
						if (mizTrmSort(lTrm) != ikError) {
							lTrm2 = mizYTerm(eq, lTrm);
							if (mizTrmInfoOf(lTrm2) != mizTrmInfoOf(rec.term)) {
								mizAddEquality(lEqs, mizTrmInfoOf(lTrm2),
									mizTrmInfoOf(rec.term));
							}
						}
					}
				});
				iterVector(lEqs, \p -> if (eq.contr == 0) mizUnionTrms(eq, p.x, p.y));
			}
		}
		ii := ^ii + 1;
	});
}

// positive requirement rules over PosBas
mizPositiveRequirementRules(eq : MizEqualizer) -> void {
	env = eq.env;
	rqLE = mizBuiltIn(env.builtIn, rqLessOrEqual);
	rqBel = mizBuiltIn(env.builtIn, rqBelongsTo);
	rqIncl = mizBuiltIn(env.builtIn, rqInclusion);
	rqElem = mizBuiltIn(env.builtIn, rqElement);
	rqPow = mizBuiltIn(env.builtIn, rqPowerSet);
	rqEmp = mizBuiltIn(env.builtIn, rqEmpty);
	added = ref true;
	while(\ -> eq.contr == 0 && ^added, \ -> {
		added := false;
		iterVector(eq.posBas, \pf -> {
			if (eq.contr == 0) {
				switch (pf) {
					MizPredFrm(srt, __, __, __): {
						if (srt == ikFrmPred) {
							pfP : MizPredFrm = mizEqAsPred(pf);
							pa = mizAdjustFrm(env, pfP);
							lPred = pa.first;
							if (lPred == rqBel && lPred != 0) {
								lLeft = mizTrmListNth(pa.second, 0);
								lRight = mizTrmListNth(pa.second, 1);
								if (rqEmp > 0) {
									mizInsertAttrE(eq, mizTrmSAt(eq, mizTrmInfoOf(lRight)).superCluster,
										rqEmp, 0, MizTrmNil());
									if (!mizTrmSAt(eq, mizTrmInfoOf(lRight)).superCluster.consistent) {
										mizSetContr(eq, 33);
									}
								}
								if (eq.contr == 0 && rqElem > 0) {
									lInsTyp = mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(),
										mizNewEmptyCluster(), rqElem,
										mizNewTrmList(lRight, MizTrmNil()));
									mizInsertType(eq, lInsTyp, mizTrmInfoOf(lLeft));
								}
							} else if (lPred == rqIncl && lPred != 0 && rqElem > 0 && rqPow > 0) {
								lLeft = mizTrmListNth(pa.second, 0);
								lRight = mizTrmListNth(pa.second, 1);
								lRight2 = mizYTerm(eq, mizNewFuncTrm(rqPow,
									mizNewTrmList(mizCopyTrm(lRight), MizTrmNil())));
								lInsTyp = mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(),
									mizNewEmptyCluster(), rqElem,
									mizNewTrmList(lRight2, MizTrmNil()));
								mizInsertType(eq, lInsTyp, mizTrmInfoOf(lLeft));
							} else if (lPred == rqLE && lPred != 0) {
								mizLESignRules(eq, pa.second, added, true);
							}
						}
					}
					default: {}
				}
			}
		});
	});
}

// sign propagation for `<=`; numeric comparison is slice 2 (exact rationals)
mizLESignRules(eq : MizEqualizer, args : MizTrmList, added : ref bool, positive : bool) -> void {
	env = eq.env;
	rqPos = mizBuiltIn(env.builtIn, rqPositive);
	rqNeg = mizBuiltIn(env.builtIn, rqNegative);
	if (rqPos > 0 && rqNeg > 0) {
		lLeft = mizTrmListNth(args, 0);
		lRight = mizTrmListNth(args, 1);
		scL = mizTrmSAt(eq, mizTrmInfoOf(lLeft)).superCluster;
		scR = mizTrmSAt(eq, mizTrmInfoOf(lRight)).superCluster;
		att = \sc : MizAttrColl, nr : int -> mizGetAttr(eq, sc, nr, MizTrmNil());
		negOf = \m : Maybe<MizAttr> -> switch (m) { Some(a): a.neg; None(): -1; };
		ins = \sc : MizAttrColl, nr : int, neg : int, code : int -> {
			if (isNone(mizGetAttr(eq, sc, nr, MizTrmNil()))) added := true;
			mizInsertAttrE(eq, sc, nr, neg, MizTrmNil());
			if (!sc.consistent) mizSetContr(eq, code);
		};
		if (positive) {
			if (negOf(att(scL, rqPos)) == 1) ins(scR, rqPos, 1, 26);
			if (eq.contr == 0 && negOf(att(scR, rqNeg)) == 1) ins(scL, rqNeg, 1, 27);
			if (eq.contr == 0 && negOf(att(scL, rqNeg)) == 0) ins(scR, rqNeg, 0, 28);
			if (eq.contr == 0 && negOf(att(scR, rqPos)) == 0) ins(scL, rqPos, 0, 29);
		} else {
			if (negOf(att(scL, rqPos)) == 0) ins(scR, rqNeg, 1, 37);
			if (eq.contr == 0 && negOf(att(scR, rqNeg)) == 0) ins(scL, rqPos, 1, 38);
		}
	}
	// numeric comparison: both sides with determined real values
	// (IsRationalGT/IsRationalLE — doubles here, the recorded deviation)
	if (eq.contr == 0) {
		lLeft2 = mizTrmListNth(args, 0);
		lRight2 = mizTrmListNth(args, 1);
		rl = mizTrmSAt(eq, mizClassOf(eq, mizTrmInfoOf(lLeft2)));
		rr = mizTrmSAt(eq, mizClassOf(eq, mizTrmInfoOf(lRight2)));
		if (rl.numDetermined && rr.numDetermined
			&& rl.numValue.im == 0.0 && rr.numValue.im == 0.0) {
			if (positive) {
				if (rl.numValue.re > rr.numValue.re) mizSetContr(eq, 32);
			} else {
				if (rl.numValue.re <= rr.numValue.re) mizSetContr(eq, 39);
			}
		}
	}
}

// the BOOLE:11 powerset rule
mizPowersetRule(eq : MizEqualizer) -> void {
	env = eq.env;
	rqBel = mizBuiltIn(env.builtIn, rqBelongsTo);
	rqElem = mizBuiltIn(env.builtIn, rqElement);
	rqPow = mizBuiltIn(env.builtIn, rqPowerSet);
	rqEmp = mizBuiltIn(env.builtIn, rqEmpty);
	if (rqBel > 0 && rqElem > 0 && rqPow > 0) {
		// the original runs the whole sweep PosBas.Count times (`for b11`),
		// so Element-of-powerset types propagate along membership chains
		b11 = ref 0;
		while(\ -> eq.contr == 0 && ^b11 < sizeVector(eq.posBas), \ -> {
		b11 := ^b11 + 1;
		iterVector(copyVector(eq.posBas), \pf -> {
			if (eq.contr == 0) {
				switch (pf) {
					MizPredFrm(srt, __, __, __): {
						if (srt == ikFrmPred) {
							pfP : MizPredFrm = mizEqAsPred(pf);
							pa = mizAdjustFrm(env, pfP);
							if (pa.first == rqBel) {
								lLeft = mizTrmListNth(pa.second, 0);
								lRight = mizTrmListNth(pa.second, 1);
								newTyps : Vector<MizTyp> = makeVector(2);
								iterVector(mizTrmSAt(eq, mizTrmInfoOf(lRight)).xTypClass, \xt -> {
									pt = mizAdjustTyp(env, xt);
									if (xt.sort == ikTypMode && pt.first == rqElem) {
										arg0 = mizTrmListNth(pt.second, 0);
										cur = ref mizTrmSAt(eq, mizTrmInfoOf(arg0)).eqClass;
										while(\ -> switch (^cur) { MizTrmNil(): false; default: true; }, \ -> {
											switch (^cur) {
												MizTrmElem(trm, next): {
													powHit = switch (trm) {
														MizFuncTrm(s2, fn2, __, __, __):
															s2 == ikTrmFunctor && fn2 == rqPow;
														default: false;
													};
													if (powHit) {
														pargs = mizArgsOfE(trm);
														inner = mizTrmListNth(pargs, 0);
														innerInfo = mizTrmInfoOf(inner);
														if (rqEmp > 0) {
															mizInsertAttrE(eq,
																mizTrmSAt(eq, innerInfo).superCluster,
																rqEmp, 0, MizTrmNil());
															if (!mizTrmSAt(eq, innerInfo).superCluster.consistent) {
																mizSetContr(eq, 34);
															}
														}
														pushVector(newTyps, mizNewStandardTyp(ikTypMode,
															mizNewEmptyCluster(), mizNewEmptyCluster(),
															rqElem, mizNewTrmList(inner, MizTrmNil())));
													}
													cur := next;
												}
												MizTrmNil(): {}
											}
										});
									}
								});
								if (eq.contr == 0) {
									iterVector(newTyps, \nt ->
										mizInsertType(eq, nt, mizTrmInfoOf(lLeft)));
								}
							}
						}
					}
					default: {}
				}
			}
		});
		});
	}
}

// the final negative-basis sweep
mizNegativeSweep(eq : MizEqualizer) -> void {
	env = eq.env;
	rqLE = mizBuiltIn(env.builtIn, rqLessOrEqual);
	rqBel = mizBuiltIn(env.builtIn, rqBelongsTo);
	rqIncl = mizBuiltIn(env.builtIn, rqInclusion);
	rqElem = mizBuiltIn(env.builtIn, rqElement);
	rqPow = mizBuiltIn(env.builtIn, rqPowerSet);
	rqEmp = mizBuiltIn(env.builtIn, rqEmpty);
	added = ref true;
	while(\ -> eq.contr == 0 && ^added, \ -> {
		added := false;
		ii = ref 0;
		while(\ -> eq.contr == 0 && ^ii < sizeVector(eq.negBas), \ -> {
			nf : MizFrm = getVectorUnsafe(eq.negBas, ^ii);
			switch (nf) {
				MizPredFrm(srt, predNr, args, __): {
					if (srt == ikFrmAttr) {
						la = mizGetAttr(eq,
							mizTrmSAt(eq, mizTrmInfoOf(mizLastArgE(args))).superCluster,
							predNr, mizAllButLast(args));
						switch (la) {
							Some(at): if (at.neg == 1) mizSetContr(eq, 35);
							None(): {}
						}
						if (eq.contr == 0) mizNegPairSweep(eq, nf, 36);
					} else if (srt == ikFrmSchPred || srt == ikFrmPrivPred) {
						mizNegPairSweep(eq, nf, 36);
					} else if (srt == ikFrmPred) {
						pfN : MizPredFrm = mizEqAsPred(nf);
						pa = mizAdjustFrm(env, pfN);
						lPred = pa.first;
						if (lPred == rqLE && lPred != 0) {
							mizLESignRules(eq, pa.second, added, false);
						} else if (lPred == rqBel && lPred != 0 && rqElem > 0) {
							lLeft = mizTrmListNth(pa.second, 0);
							lRight = mizTrmListNth(pa.second, 1);
							if (getUrlParameterDef("dbg-neg", "") == "1") {
								println("NEG-BEL rhs-cls=" + i2s(mizClassOf(eq, mizTrmInfoOf(lRight)))
									+ " empty-attr=" + switch (mizGetAttr(eq,
										mizTrmSAt(eq, mizTrmInfoOf(lRight)).superCluster,
										rqEmp, MizTrmNil())) {
										Some(a0): i2s(a0.neg);
										None(): "none";
									});
							}
							switch (mizGetAttr(eq,
								mizTrmSAt(eq, mizTrmInfoOf(lRight)).superCluster,
								rqEmp, MizTrmNil())) {
								Some(a): {
									if (a.neg == 0) {
										lTyp = mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(),
											mizNewEmptyCluster(), rqElem,
											mizNewTrmList(mizCopyTrm(lRight), MizTrmNil()));
										iterVector(mizTrmSAt(eq, mizTrmInfoOf(lLeft)).xTypClass, \xt -> {
											if (eq.contr == 0
												&& mizDecreasingAttrs(env, xt, lTyp,
													\x, y -> mizEqAttrsE(eq, x, y))
												&& mizEqRadices(env, lTyp, xt)) {
												mizSetContr(eq, 40);
											}
										});
									}
								}
								None(): {}
							}
						} else if (lPred == rqIncl && lPred != 0 && rqElem > 0 && rqPow > 0) {
							lLeft = mizTrmListNth(pa.second, 0);
							lRight = mizTrmListNth(pa.second, 1);
							lRight2 = mizYTerm(eq, mizNewFuncTrm(rqPow,
								mizNewTrmList(mizCopyTrm(lRight), MizTrmNil())));
							lTyp = mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(),
								mizNewEmptyCluster(), rqElem,
								mizNewTrmList(lRight2, MizTrmNil()));
							iterVector(mizTrmSAt(eq, mizTrmInfoOf(lLeft)).xTypClass, \xt -> {
								if (eq.contr == 0
									&& mizDecreasingAttrs(env, xt, lTyp,
										\x, y -> mizEqAttrsE(eq, x, y))
									&& mizEqRadices(env, lTyp, xt)) {
									mizSetContr(eq, 41);
								}
							});
						}
						if (eq.contr == 0) mizNegPairSweep(eq, nf, 42);
					}
				}
				MizQualFrm(trm, typ, __): {
					rec = mizTrmSAt(eq, mizTrmInfoOf(trm));
					iterVector(rec.xTypClass, \xt -> {
						if (eq.contr == 0 && mizEqRadices(env, typ, xt)) mizSetContr(eq, 43);
					});
				}
				default: {}
			}
			ii := ^ii + 1;
		});
	});
}

mizNegPairSweep(eq : MizEqualizer, nf : MizFrm, code : int) -> void {
	iterVector(eq.posBas, \pf -> {
		if (eq.contr == 0 && mizEqFrmsE(eq, pf, nf)) mizSetContr(eq, code);
	});
}

// local downcasts
mizEqAsVar(t : MizTrm) -> MizVarTrm {
	switch (t) { MizVarTrm(__, __, __, __): t; default: { mizRunTimeError(2901); MizVarTrm(ikError, 0, 0, 0); } }
}
mizEqAsFunc(t : MizTrm) -> MizFuncTrm {
	switch (t) { MizFuncTrm(__, __, __, __, __): t; default: { mizRunTimeError(2902); MizFuncTrm(ikError, 0, MizTrmNil(), 0, 0); } }
}
mizEqAsPriv(t : MizTrm) -> MizPrivFuncTrm {
	switch (t) { MizPrivFuncTrm(__, __, __, __, __): t; default: { mizRunTimeError(2903); MizPrivFuncTrm(0, MizTrmNil(), MizBaseTrm(ikError, 0), 0, 0); } }
}
mizEqAsFraenkel(t : MizTrm) -> MizFraenkelTrm {
	switch (t) { MizFraenkelTrm(__, __, __, __, __, __): t; default: { mizRunTimeError(2904); MizFraenkelTrm(makeVector(0), MizBaseTrm(ikError, 0), MizUniqFrm(ikError), mizInitIntSeq(0), 0, 0); } }
}
mizEqAsChoice(t : MizTrm) -> MizChoiceTrm {
	switch (t) { MizChoiceTrm(__, __, __): t; default: { mizRunTimeError(2906); MizChoiceTrm(mizNewIncorTyp(), 0, 0); } }
}
mizEqAsNeg(f : MizFrm) -> MizNegFrm {
	switch (f) { MizNegFrm(__, __): f; default: { mizRunTimeError(2911); MizNegFrm(MizUniqFrm(ikError), 0); } }
}
mizEqAsQual(f : MizFrm) -> MizQualFrm {
	switch (f) { MizQualFrm(__, __, __): f; default: { mizRunTimeError(2910); MizQualFrm(MizBaseTrm(ikError, 0), mizNewIncorTyp(), 0); } }
}
mizEqAsConj(f : MizFrm) -> MizConjFrm {
	switch (f) { MizConjFrm(__, __): f; default: { mizRunTimeError(2912); MizConjFrm(makeVector(0), 0); } }
}
mizEqAsPred(f : MizFrm) -> MizPredFrm {
	switch (f) { MizPredFrm(__, __, __, __): f; default: { mizRunTimeError(2908); MizPredFrm(ikError, 0, MizTrmNil(), 0); } }
}
mizEqAsLocPred(f : MizFrm) -> MizLocPredFrm {
	switch (f) { MizLocPredFrm(__, __, __, __): f; default: { mizRunTimeError(2909); MizLocPredFrm(0, MizTrmNil(), MizUniqFrm(ikError), 0); } }
}
mizEqAsUniv(f : MizFrm) -> MizUnivFrm {
	switch (f) { MizUnivFrm(__, __, __, __, __): f; default: { mizRunTimeError(2913); MizUnivFrm(ikError, 0, mizNewIncorTyp(), MizUniqFrm(ikError), 0); } }
}

// ---------------- Identities: the congruence fixpoint ----------------
// XXX(kind, terms): union classes of same-head terms whose arguments became
// class-equal. Property rules: idempotence, involutiveness, projectivity;
// the BOOLE empty-set simplifications. Arithmetic (aArithmIncl parts) is
// slice 2 (polynom.pas).

mizIsItEmptySet(eq : MizEqualizer, cls : MizTrmList) -> bool {
	env = eq.env;
	rqES = mizBuiltIn(env.builtIn, rqEmptySet);
	found = ref false;
	cur = ref cls;
	while(\ -> !^found && switch (^cur) { MizTrmNil(): false; default: true; }, \ -> {
		switch (^cur) {
			MizTrmElem(trm, next): {
				switch (trm) {
					MizFuncTrm(srt, funcNr, __, __, __): {
						if (srt == ikTrmFunctor && rqES != 0 && funcNr == rqES) found := true;
					}
					default: {}
				}
				cur := next;
			}
			MizTrmNil(): {}
		}
	});
	^found;
}

// Identities, the FIRST block (equalizer.pas 3056-3086) — the converse of the
// aggregate congruence sweep: when two aggregate terms of the same functor are
// already in ONE class, their corresponding arguments must be equal. This is
// what makes `the carrier of S(#A,...#)` equal A: the strict-struct
// reconstruction puts S(U1(s),U2(s),…) in the class of S(A,…), and the rule
// then unions U1(s) with A. The leading `over` arguments are skipped.
mizAggregIdentities(eq : MizEqualizer) -> void {
	env = eq.env;
	idx = getVectorUnsafe(eq.funcTrmIdx, expAggreg);
	iterVector(idx, \bucket -> {
		terms = bucket.second;
		n = sizeVector(terms);
		fori(0, n - 1, \ii -> {
			if (eq.contr == 0) {
				t1 : MizTrm = getVectorUnsafe(terms, ii);
				c1 = mizClassOf(eq, mizTrmInfoOf(t1));
				// the FIRST later term of the same class (Pascal: goto Found)
				found = ref -1;
				fori(ii + 1, n - 1, \ll -> {
					if (^found < 0
						&& mizClassOf(eq, mizTrmInfoOf(getVectorUnsafe(terms, ll))) == c1) {
						found := ll;
					}
				});
				if (^found >= 0) {
					t2 : MizTrm = getVectorUnsafe(terms, ^found);
					base = mizConstr(env, coAggregate, mizFuncNrOfE(t1)).aggregBase;
					a1 = ref mizTrmListDrop(mizArgsOfE(t1), base);
					a2 = ref mizTrmListDrop(mizArgsOfE(t2), base);
					while(\ -> eq.contr == 0 && ^a1 != mizNil && ^a2 != mizNil, \ -> {
						x1 = mizTrmListNth(^a1, 0);
						x2 = mizTrmListNth(^a2, 0);
						e1 = mizClassOf(eq, mizTrmInfoOf(x1));
						e2 = mizClassOf(eq, mizTrmInfoOf(x2));
						if (e1 != e2) mizUnionTrms(eq, e1, e2);
						a1 := mizTrmListDrop(^a1, 1);
						a2 := mizTrmListDrop(^a2, 1);
					});
				}
			}
		});
	});
}

mizIdentities(eq : MizEqualizer) -> void {
	env = eq.env;
	go = ref true;
	while(\ -> eq.contr == 0 && ^go, \ -> {
		clashBefore = eq.clash;
		eq.clash ::= false;

		// the aggregate argument identities run FIRST in the original's round
		if (eq.contr == 0) mizAggregIdentities(eq);

		// congruence sweeps per kind
		fori(0, 4, \kind -> {
			if (eq.contr == 0) {
				idx = getVectorUnsafe(eq.funcTrmIdx, kind);
				iterVector(idx, \bucket -> {
					terms = bucket.second;
					n = sizeVector(terms);
					fori(0, n - 2, \l1 -> {
						if (eq.contr == 0) {
							t1 : MizTrm = getVectorUnsafe(terms, l1);
							fori(l1 + 1, n - 1, \l2 -> {
								if (eq.contr == 0) {
									t2 : MizTrm = getVectorUnsafe(terms, l2);
									c1 = mizClassOf(eq, mizTrmInfoOf(t1));
									c2 = mizClassOf(eq, mizTrmInfoOf(t2));
									if (c1 != c2) {
										same = if (kind == expAggreg) {
											fn = mizFuncNrOfE(t2);
											ca = mizConstr(env, coAggregate, fn);
											mizEqTrmListsE(eq,
												mizTrmListDrop(mizArgsOfE(t1), ca.aggregBase),
												mizTrmListDrop(mizArgsOfE(t2), ca.aggregBase));
										} else if (kind == expSelector) {
											mizEqTrms(eq, mizLastArgE(mizArgsOfE(t1)),
												mizLastArgE(mizArgsOfE(t2)));
										} else {
											mizEqTrmListsE(eq, mizArgsOfE(t1), mizArgsOfE(t2));
										}
										if (same) {
											mizUnionTrms(eq, mizTrmInfoOf(t1), mizTrmInfoOf(t2));
										}
									}
								}
							});
						}
					});
				});
			}
		});

		// Fraenkel / Choice congruence — compare the PARTS, not the whole
		// term (XXX in the original: EqTyps/EqTrms/EqFrms on components;
		// a whole-term compare would short-circuit on the class stamps
		// that are exactly what we are about to merge)
		samePartsE = \t1 : MizTrm, t2 : MizTrm -> {
			switch (t1) {
				MizChoiceTrm(ct1, __, __): {
					switch (t2) {
						MizChoiceTrm(ct2, __, __): mizEqTypsE(eq, ct1, ct2);
						default: false;
					}
				}
				MizFraenkelTrm(la1, sc1, co1, __, __, __): {
					switch (t2) {
						MizFraenkelTrm(la2, sc2, co2, __, __, __): {
							if (sizeVector(la1) != sizeVector(la2)) {
								false;
							} else {
								ok2 = ref true;
								i2b = ref 0;
								while(\ -> ^ok2 && ^i2b < sizeVector(la1), \ -> {
									if (!mizEqTypsE(eq, getVectorUnsafe(la1, ^i2b),
											getVectorUnsafe(la2, ^i2b))) ok2 := false;
									i2b := ^i2b + 1;
								});
								^ok2 && mizEqTrms(eq, sc1, sc2) && mizEqFrmsE(eq, co1, co2);
							}
						}
						default: false;
					}
				}
				default: false;
			}
		};
		doList = \v : Vector<MizTrm> -> {
			n = sizeVector(v);
			fori(0, n - 2, \l1 -> {
				if (eq.contr == 0) {
					t1 : MizTrm = getVectorUnsafe(v, l1);
					fori(l1 + 1, n - 1, \l2 -> {
						if (eq.contr == 0) {
							t2 : MizTrm = getVectorUnsafe(v, l2);
							if (mizClassOf(eq, mizTrmInfoOf(t1)) != mizClassOf(eq, mizTrmInfoOf(t2))
								&& samePartsE(t1, t2)) {
								mizUnionTrms(eq, mizTrmInfoOf(t1), mizTrmInfoOf(t2));
							}
						}
					});
				}
			});
		};
		if (eq.contr == 0) doList(eq.frOper);
		if (eq.contr == 0) doList(eq.choiceTerm);

		// property rules over functor buckets
		if (eq.contr == 0) {
			idxF = getVectorUnsafe(eq.funcTrmIdx, expFunctor);
			iterVector(idxF, \bucket -> {
				if (eq.contr == 0) {
					fn = bucket.first;
					c = mizConstr(env, coFunctor, fn);
					terms = bucket.second;
					// Idempotence: f(x, x) = x
					if (mizHasProperty(c, syIdempotence)) {
						iterVector(terms, \t -> {
							if (eq.contr == 0) {
								p2 = mizGetArgs2(mizArgsOfE(t), c.firstArg, c.secondArg);
								if (mizClassOf(eq, mizTrmInfoOf(p2.first))
									== mizClassOf(eq, mizTrmInfoOf(p2.second))) {
									mizUnionTrms(eq, mizTrmInfoOf(t), mizTrmInfoOf(p2.first));
								}
							}
						});
					}
					// Involutiveness: f(f(x)) = x ; Projectivity: f(f(x)) = f(x)
					doInvProj = \proj : bool -> {
						iterVector(terms, \t -> {
							if (eq.contr == 0) {
								arg1 = mizTrmListNth(mizArgsOfE(t), c.firstArg - 1);
								argClass = mizClassOf(eq, mizTrmInfoOf(arg1));
								cur = ref mizTrmSAt(eq, argClass).eqClass;
								while(\ -> eq.contr == 0
										&& switch (^cur) { MizTrmNil(): false; default: true; }, \ -> {
									switch (^cur) {
										MizTrmElem(member, next): {
											hit = switch (member) {
												MizFuncTrm(s2, fn2, __, __, __):
													s2 == ikTrmFunctor && fn2 == fn;
												default: false;
											};
											if (hit && mizEqButLast(eq, mizArgsOfE(t), mizArgsOfE(member))) {
												if (proj) {
													mizUnionTrms(eq, mizTrmInfoOf(t), mizTrmInfoOf(arg1));
												} else {
													inner = mizTrmListNth(mizArgsOfE(member), c.firstArg - 1);
													mizUnionTrms(eq, mizTrmInfoOf(t), mizTrmInfoOf(inner));
												}
											}
											cur := next;
										}
										MizTrmNil(): {}
									}
								});
							}
						});
					};
					if (mizHasProperty(c, syInvolutiveness)) doInvProj(false);
					if (eq.contr == 0 && mizHasProperty(c, syProjectivity)) doInvProj(true);

					// BOOLE empty-set simplifications
					rq = mizRevReqPub(eq.idn, fn);
					if (eq.contr == 0 && (rq == rqUnion || rq == rqIntersection
						|| rq == rqSubtraction || rq == rqSymmetricDifference)) {
						iterVector(terms, \t -> {
							if (eq.contr == 0) {
								args = mizArgsOfE(t);
								lt1 = mizTrmListNth(args, 0);
								lt2 = mizTrmListNth(args, 1);
								ti = mizTrmInfoOf(t);
								e1 = mizIsItEmptySet(eq,
									mizTrmSAt(eq, mizClassOf(eq, mizTrmInfoOf(lt1))).eqClass);
								e2 = mizIsItEmptySet(eq,
									mizTrmSAt(eq, mizClassOf(eq, mizTrmInfoOf(lt2))).eqClass);
								if (rq == rqUnion) {
									if (e1) mizUnionTrms(eq, ti, mizTrmInfoOf(lt2));
								} else if (rq == rqIntersection) {
									if (e1) mizUnionTrms(eq, ti, mizTrmInfoOf(lt1));
								} else if (rq == rqSubtraction) {
									if (e1) mizUnionTrms(eq, ti, mizTrmInfoOf(lt1));
									if (eq.contr == 0 && e2) mizUnionTrms(eq, ti, mizTrmInfoOf(lt1));
								} else {
									// symmetric difference
									if (e2) mizUnionTrms(eq, ti, mizTrmInfoOf(lt1));
								}
							}
						});
					}
					// NUMERALS: succ n has value n+1 (EquateComplexValue)
					if (eq.contr == 0 && rq == rqSucc) {
						iterVector(terms, \t -> {
							if (eq.contr == 0) {
								lt1 = mizTrmListNth(mizArgsOfE(t), 0);
								ra = mizTrmSAt(eq, mizClassOf(eq, mizTrmInfoOf(lt1)));
								if (ra.numDetermined && ra.numValue.im == 0.0) {
									mizEquateComplexValue(eq,
										mizClassOf(eq, mizTrmInfoOf(t)),
										MizComplex(ra.numValue.re + 1.0, 0.0));
								}
							}
						});
					}
					// COMPLEX arithmetic requirement evaluation, with the
					// zero/one simplification unions (equalizer.pas 3222-3460).
					// Values are doubles — the recorded deviation from the
					// original's exact rationals.
					if (eq.contr == 0 && (rq == rqRealAdd || rq == rqRealMult
						|| rq == rqRealNeg || rq == rqRealInv || rq == rqRealDiff
						|| rq == rqRealDiv)) {
						iterVector(terms, \t -> {
							if (eq.contr == 0) mizEvalComplexReq(eq, rq, t);
						});
					}
				}
			});
		}
		// Pascal: after the congruence fixpoint each round, apply the
		// reductions; their unions set clash and re-enter the loop
		if (eq.contr == 0) mizProcessReductions(eq);
		go := eq.clash;
		if (!^go) eq.clash ::= clashBefore;
	});
}


// EquateComplexValue: give the class a numeric value; merge with any class
// already carrying it; conflicting determined values refute (Contr 14)
mizEquateComplexValue(eq : MizEqualizer, aTrmInfo : int, v : MizComplex) -> void {
	rec = mizTrmSAt(eq, aTrmInfo);
	if (rec.numDetermined) {
		if (rec.numValue != v) mizSetContr(eq, 14);
	} else {
		merged = ref false;
		i = ref 1;
		while(\ -> eq.contr == 0 && !^merged && ^i <= mizTrmNbr(eq), \ -> {
			ri = mizTrmSAt(eq, ^i);
			live = switch (ri.eqClass) { MizTrmNil(): false; default: true; };
			if (live && ri.numDetermined && ri.numValue == v) {
				mizUnionTrms(eq, aTrmInfo, ^i);
				merged := true;
			}
			i := ^i + 1;
		});
		if (eq.contr == 0) {
			eq.clash ::= true;
			rec.numDetermined ::= true;
			rec.numValue ::= v;
		}
	}
}

mizInsertNonEmptyPub(eq : MizEqualizer, i1 : int, i2 : int) -> void {
	mizInsertNonEmpty(eq, i1, i2);
}

mizInsertNonZeroPub(eq : MizEqualizer, i1 : int, i2 : int) -> void {
	mizInsertNonZero(eq, i1, i2);
}

// ==================== RoundUpSuperCluster (equalizer.pas 1821-2716) ====================
// Registration rounding over equality classes: every conditional and functor
// registration whose consequent survives the D-constant filter is matched
// against each class through the ANInstCollection lattice (loci -> classes),
// and the located consequent attributes are merged into the class supercluster
// until a fixpoint (order-independent: the inner `while added` plus the outer
// dependency stack). Contr codes 8/9 (conditional) and 10/11 (functor).

// ---------------- the AN instantiation lattice ----------------
// ANInstCollection = PreInstCollection minus the MaxInstNbr cap. We reuse the
// MizPreInst struct; union/join here are the uncapped AN variants.

mizANUnionWith(p : MizPreInst, q : MizPreInst) -> void {
	if (p.top) {
	} else if (q.top) {
		clearVector(p.evals);
		p.top ::= true;
	} else {
		iterVector(q.evals, \e -> mizPreInstInsertAndAbsorb(p, e));
	}
}

mizANJoinWith(p : MizPreInst, q : MizPreInst) -> void {
	if (q.top) {
	} else if (p.top) {
		p.top ::= false;
		clearVector(p.evals);
		iterVector(q.evals, \e -> pushVector(p.evals, e));
	} else if (sizeVector(q.evals) == 0) {
		clearVector(p.evals);
	} else if (sizeVector(p.evals) == 0) {
	} else {
		tmp : Vector<MizNatFunc> = makeVector(sizeVector(p.evals) * sizeVector(q.evals));
		iterVector(p.evals, \a ->
			iterVector(q.evals, \b -> {
				switch (mizNatJoinAtom(a, b)) {
					Some(j): pushVector(tmp, j);
					None(): {}
				}
			}));
		clearVector(p.evals);
		iterVector(tmp, \e -> pushVector(p.evals, e));
	}
}

// ---------------- allowed clusters (CheckForDConsts filter) ----------------

// an attribute is allowed if every InfConst in its arguments is available in
// this inference (has a DTrm entry)
mizANAttrHasForeignDConst(eq : MizEqualizer, a : MizAttr) -> bool {
	found = ref false;
	w = mizMakeWithin(\__, t -> {
		switch (t) {
			MizVarTrm(srt, varNr, __, __): {
				if (srt == ikTrmInfConst && !^found) {
					avail = varNr < sizeVector(eq.dTrm) && switch (getVectorUnsafe(eq.dTrm, varNr)) {
						Some(__): true;
						None(): false;
					};
					if (!avail) found := true;
				}
			}
			default: {}
		}
		t;
	});
	mizWithinTrmList(w, a.args);
	^found;
}

mizANAllowedAttrsIn(eq : MizEqualizer, cluster : MizAttrColl) -> MizAttrColl {
	r = mizNewEmptyCluster();
	iterVector(cluster.items, \a ->
		if (!mizANAttrHasForeignDConst(eq, a)) mizAttrCollInsert(eq.env, r, mizCopyAttr(a)));
	r;
}

mizInitAllowedClusters(eq : MizEqualizer) -> void {
	clearVector(eq.allowedC);
	clearVector(eq.allowedF);
	i = ref 0;
	while(\ -> ^i < sizeVector(eq.clusters.conditional), \ -> {
		cc : MizCCluster = getVectorUnsafe(eq.clusters.conditional, ^i);
		lC = mizANAllowedAttrsIn(eq, cc.consequent.upper);
		if (sizeVector(lC.items) > 0) pushVector(eq.allowedC, Pair(^i, lC));
		i := ^i + 1;
	});
	j = ref 0;
	while(\ -> ^j < sizeVector(eq.clusters.functor), \ -> {
		fc : MizFCluster = getVectorUnsafe(eq.clusters.functor, ^j);
		lF = mizANAllowedAttrsIn(eq, fc.consequent.upper);
		if (sizeVector(lF.items) > 0) pushVector(eq.allowedF, Pair(^j, lF));
		j := ^j + 1;
	});
}

// ---------------- class dependencies ----------------

// DependsOn(x,y): class y's EqConst occurs inside class x (members, types
// or supercluster)
mizANDependsOn(eq : MizEqualizer, x : int, y : int) -> bool {
	rx = mizTrmSAt(eq, x);
	ry = mizTrmSAt(eq, y);
	liveX = switch (rx.eqClass) { MizTrmNil(): false; default: true; };
	liveY = switch (ry.eqClass) { MizTrmNil(): false; default: true; };
	if (liveX && liveY) {
		found = ref false;
		w = mizMakeWithin(\__, t -> {
			switch (t) {
				MizVarTrm(srt, __, __, info): {
					if (srt == ikTrmEqConst && !^found && mizClassOf(eq, info) == y) {
						found := true;
					}
				}
				default: {}
			}
			t;
		});
		cur = ref rx.eqClass;
		while(\ -> !^found && switch (^cur) { MizTrmNil(): false; default: true; }, \ -> {
			switch (^cur) {
				MizTrmElem(trm, next): {
					mizWithinTrm(w, trm);
					{}
					cur := next;
				}
				MizTrmNil(): {}
			}
		});
		if (!^found) mizWithinTypVector(w, rx.xTypClass);
		if (!^found) mizWithinCluster(w, rx.superCluster);
		^found;
	} else {
		false;
	}
}

mizANDependentClasses(eq : MizEqualizer, enr : int) -> Maybe<MizNatFunc> {
	rec = mizTrmSAt(eq, enr);
	live = switch (rec.eqClass) { MizTrmNil(): false; default: true; };
	if (live) {
		r = mizInitNatSet(10);
		i = ref 1;
		while(\ -> ^i <= mizTrmNbr(eq), \ -> {
			if (mizANDependsOn(eq, ^i, enr)) mizNatInsertElem(r, ^i);
			i := ^i + 1;
		});
		Some(r);
	} else {
		None();
	}
}

// ---------------- matching loci against classes (Instantiate*) ----------------

// FuncNr/args of a functor-like term, adjusted for real functors
mizANAdjustedArgs(env : MizCorrelEnv, t : MizTrm) -> Pair<int, MizTrmList> {
	ft : MizFuncTrm = mizEqAsFunc(t);
	if (ft.sort == ikTrmFunctor) {
		mizAdjustTrm(env, ft);
	} else {
		Pair(ft.funcNr, ft.args);
	}
}

// pairwise join of argument instantiations
mizANJoinArgs(eq : MizEqualizer, prim : Vector<MizTyp>, el0 : MizTrmList,
		al0 : MizTrmList) -> MizPreInst {
	r = mizPreInstTop();
	el = ref el0;
	al = ref al0;
	while(\ -> switch (^al) { MizTrmNil(): false; default: true; }, \ -> {
		switch (^al) {
			MizTrmElem(at, an) : {
				switch (^el) {
					MizTrmElem(et, en): {
						mizANJoinWith(r, mizANInstTerm(eq, prim, et, at));
						el := en;
					}
					MizTrmNil(): {}
				}
				al := an;
			}
			MizTrmNil(): {}
		}
	});
	r;
}

// InstantiateTerm: match the class-side term eTrm against the registration
// term aTrm (loci as variables to solve for)
mizANInstTerm(eq : MizEqualizer, prim : Vector<MizTyp>, eTrm : MizTrm,
		aTrm : MizTrm) -> MizPreInst {
	env = eq.env;
	eSort = mizTrmSort(eTrm);
	if (eSort != ikTrmEqConst) {
		if (eSort == ikTrmNumeral) {
			ev : MizVarTrm = mizEqAsVar(eTrm);
			same = mizTrmSort(aTrm) == ikTrmNumeral && {
				av : MizVarTrm = mizEqAsVar(aTrm);
				av.varNr == ev.varNr;
			};
			if (same) mizPreInstTop() else mizPreInstBottom();
		} else if (eSort == mizTrmSort(aTrm)) {
			ep = mizANAdjustedArgs(env, eTrm);
			ap = mizANAdjustedArgs(env, aTrm);
			if (ep.first == ap.first) {
				mizANJoinArgs(eq, prim, ep.second, ap.second);
			} else {
				// same sort, different functor: fall through to the class view
				mizANInstTermClass(eq, prim, mizClassOf(eq, mizTrmInfoOf(eTrm)), aTrm);
			}
		} else {
			mizPreInstBottom();
		}
	} else {
		mizANInstTermClass(eq, prim, mizClassOf(eq, mizTrmInfoOf(eTrm)), aTrm);
	}
}

mizANInstTermClass(eq : MizEqualizer, prim : Vector<MizTyp>, enr : int,
		aTrm : MizTrm) -> MizPreInst {
	env = eq.env;
	aSort = mizTrmSort(aTrm);
	if (aSort == ikTrmLocus) {
		av : MizVarTrm = mizEqAsVar(aTrm);
		t1 : MizTyp = getVectorUnsafe(prim, av.varNr - 1);
		z = mizANInstType(eq, prim, enr, t1);
		if (mizPreInstCount(z) == 0) {
			z;
		} else {
			rep : MizVarTrm = mizEqAsVar(mizTrmSAt(eq, enr).term);
			n = mizInitNatFunc(1);
			mizNatAssign(n, av.varNr, rep.varNr);
			mizANJoinWith(z, mizPreInstSingle(n));
			z;
		}
	} else if (aSort == ikTrmNumeral) {
		av : MizVarTrm = mizEqAsVar(aTrm);
		rec = mizTrmSAt(eq, enr);
		if (rec.numDetermined && rec.numValue.re == i2d(av.varNr) && rec.numValue.im == 0.0) {
			mizPreInstTop();
		} else {
			mizPreInstBottom();
		}
	} else {
		// functor / selector / aggregate: match against the class members
		ap = mizANAdjustedArgs(env, aTrm);
		r = mizPreInstBottom();
		if (getUrlParameterDef("dbg-rus3", "") != "") {
			mems3 = ref "";
			cur3 = ref mizTrmSAt(eq, enr).eqClass;
			while(\ -> switch (^cur3) { MizTrmNil(): false; default: true; }, \ -> {
				switch (^cur3) {
					MizTrmElem(m3, n3): {
						mems3 := ^mems3 + " " + i2s(mizTrmSort(m3))
							+ (switch (m3) {
								MizFuncTrm(__, fn3, __, __, __): ":" + i2s(fn3);
								MizVarTrm(__, vn3, __, __): "#" + i2s(vn3);
								default: "";
							});
						cur3 := n3;
					}
					MizTrmNil(): {}
				}
			});
			println("      ITC enr=" + i2s(enr) + " aSort=" + i2s(aSort)
				+ " aNr=" + i2s(ap.first) + " mems:" + ^mems3);
		}
		cur = ref mizTrmSAt(eq, enr).eqClass;
		while(\ -> switch (^cur) { MizTrmNil(): false; default: true; }, \ -> {
			switch (^cur) {
				MizTrmElem(mem, next): {
					if (mizTrmSort(mem) == aSort) {
						mp = mizANAdjustedArgs(env, mem);
						if (mp.first == ap.first) {
							z = mizANJoinArgs(eq, prim, mp.second, ap.second);
							mizANUnionWith(r, z);
						}
					}
					cur := next;
				}
				MizTrmNil(): {}
			}
		});
		r;
	}
}

mizANInstRadixType(eq : MizEqualizer, prim : Vector<MizTyp>, enr0 : int,
		atyp : MizTyp) -> MizPreInst {
	env = eq.env;
	enr = mizClassOf(eq, enr0);
	ap = mizAdjustTyp(env, atyp);
	rec = mizTrmSAt(eq, enr);
	r = mizPreInstBottom();
	stop = ref false;
	i = ref 0;
	while(\ -> !^stop && ^i < sizeVector(rec.xTypClass), \ -> {
		xt : MizTyp = getVectorUnsafe(rec.xTypClass, ^i);
		mp = mizAdjustTyp(env, xt);
		if (xt.sort == atyp.sort && mp.first == ap.first) {
			noArgs = switch (ap.second) { MizTrmNil(): true; default: false; };
			if (noArgs) {
				// registration type takes no arguments: any match is total
				r.top ::= true;
				clearVector(r.evals);
				stop := true;
			} else {
				z = mizANJoinArgs(eq, prim, mp.second, ap.second);
				mizANUnionWith(r, z);
			}
		}
		i := ^i + 1;
	});
	r;
}

mizANInstAttr(eq : MizEqualizer, prim : Vector<MizTyp>, enr : int,
		aa : MizAttr) -> MizPreInst {
	env = eq.env;
	ap = mizAdjustAttr(env, aa);
	rec = mizTrmSAt(eq, enr);
	r = mizPreInstBottom();
	stop = ref false;
	i = ref 0;
	while(\ -> !^stop && ^i < sizeVector(rec.superCluster.items), \ -> {
		sa : MizAttr = getVectorUnsafe(rec.superCluster.items, ^i);
		sp = mizAdjustAttr(env, sa);
		if (sp.first == ap.first && sa.neg == aa.neg) {
			noArgs = switch (ap.second) { MizTrmNil(): true; default: false; };
			if (noArgs) {
				r.top ::= true;
				clearVector(r.evals);
				stop := true;
			} else {
				v = mizANJoinArgs(eq, prim, sp.second, ap.second);
				mizANUnionWith(r, v);
			}
		}
		i := ^i + 1;
	});
	r;
}

mizANInstAttrs(eq : MizEqualizer, prim : Vector<MizTyp>, enr : int,
		alc : MizAttrColl) -> MizPreInst {
	r = mizPreInstTop();
	iterVector(alc.items, \a -> mizANJoinWith(r, mizANInstAttr(eq, prim, enr, a)));
	r;
}

mizANInstType(eq : MizEqualizer, prim : Vector<MizTyp>, enr : int,
		atyp : MizTyp) -> MizPreInst {
	r = mizANInstRadixType(eq, prim, enr, atyp);
	if (getUrlParameterDef("dbg-rus2", "") == i2s(enr)) {
		println("     ITY radix -> " + (if (r.top) "top" else i2s(mizPreInstCount(r)))
			+ " lowerN=" + i2s(sizeVector(atyp.lower.items)));
	}
	mizANJoinWith(r, mizANInstAttrs(eq, prim, enr, atyp.lower));
	r;
}

mizANInstFCluster(eq : MizEqualizer, fc : MizFCluster, enr : int) -> MizPreInst {
	r = mizANInstTerm(eq, fc.primaries, mizTrmSAt(eq, enr).term, fc.clusterTerm);
	switch (fc.clusterType) {
		Some(ct): mizANJoinWith(r, mizANInstType(eq, fc.primaries, enr, ct));
		None(): {}
	}
	r;
}

mizANInstCCluster(eq : MizEqualizer, cc : MizCCluster, enr : int) -> MizPreInst {
	r = mizANInstType(eq, cc.primaries, enr, cc.clusterType);
	dbg = getUrlParameterDef("dbg-rus2", "") == i2s(enr);
	if (dbg) {
		println("  ICC " + cc.article + ":" + i2s(cc.absNr)
			+ " typM=" + i2s(cc.clusterType.modNr)
			+ " instType -> " + (if (r.top) "top" else i2s(mizPreInstCount(r))));
	}
	a = mizANInstAttrs(eq, cc.primaries, enr, cc.antecedent);
	if (dbg) {
		println("  ICC ante -> " + (if (a.top) "top" else i2s(mizPreInstCount(a))));
	}
	mizANJoinWith(r, a);
	r;
}

// ---------------- locating registration terms in the class graph ----------------

mizANLocateTermList(eq : MizEqualizer, l0 : MizTrmList) -> Maybe<MizTrmList> {
	res = ref mizNil;
	ok = ref true;
	l = ref l0;
	while(\ -> ^ok && switch (^l) { MizTrmNil(): false; default: true; }, \ -> {
		switch (^l) {
			MizTrmElem(t, next): {
				switch (mizANLocateTerm(eq, t)) {
					Some(lt): res := mizAppendTrm(^res, lt);
					None(): ok := false;
				}
				l := next;
			}
			MizTrmNil(): {}
		}
	});
	if (^ok) Some(^res) else None();
}

// LocateTerm: map a registration-side term (under eq.anInst) to the
// representative of an existing class
mizANLocateTerm(eq : MizEqualizer, aTrm : MizTrm) -> Maybe<MizTrm> {
	aSort = mizTrmSort(aTrm);
	if (aSort == ikTrmLocus) {
		av : MizVarTrm = mizEqAsVar(aTrm);
		if (mizNatHasInDom(eq.anInst, av.varNr)) {
			g = mizNatValue(eq.anInst, av.varNr);
			found : ref Maybe<MizTrm> = ref None();
			i = ref 1;
			while(\ -> ^i <= mizTrmNbr(eq) && ^found == None(), \ -> {
				rep : MizVarTrm = mizEqAsVar(mizTrmSAt(eq, ^i).term);
				if (rep.varNr == g) found := Some(mizTrmSAt(eq, ^i).term);
				i := ^i + 1;
			});
			^found;
		} else {
			None();
		}
	} else if (aSort == ikTrmInfConst) {
		av : MizVarTrm = mizEqAsVar(aTrm);
		found : ref Maybe<MizTrm> = ref None();
		i = ref 1;
		while(\ -> ^i <= mizTrmNbr(eq) && ^found == None(), \ -> {
			cur = ref mizTrmSAt(eq, ^i).eqClass;
			while(\ -> ^found == None() && switch (^cur) { MizTrmNil(): false; default: true; }, \ -> {
				switch (^cur) {
					MizTrmElem(mem, next): {
						hit = switch (mem) {
							MizVarTrm(srt, varNr, __, __): srt == ikTrmInfConst && varNr == av.varNr;
							default: false;
						};
						if (hit) found := Some(mizTrmSAt(eq, ^i).term);
						cur := next;
					}
					MizTrmNil(): {}
				}
			});
			i := ^i + 1;
		});
		^found;
	} else if (aSort == ikTrmNumeral) {
		av : MizVarTrm = mizEqAsVar(aTrm);
		found : ref Maybe<MizTrm> = ref None();
		i = ref 1;
		while(\ -> ^i <= mizTrmNbr(eq) && ^found == None(), \ -> {
			rec = mizTrmSAt(eq, ^i);
			live = switch (rec.eqClass) { MizTrmNil(): false; default: true; };
			if (live && rec.numDetermined && rec.numValue.re == i2d(av.varNr)
					&& rec.numValue.im == 0.0) {
				found := Some(rec.term);
			}
			i := ^i + 1;
		});
		^found;
	} else if (aSort == ikTrmFunctor || aSort == ikTrmSelector || aSort == ikTrmAggreg) {
		af : MizFuncTrm = mizEqAsFunc(aTrm);
		found : ref Maybe<MizTrm> = ref None();
		i = ref 1;
		while(\ -> ^i <= mizTrmNbr(eq) && ^found == None(), \ -> {
			rec = mizTrmSAt(eq, ^i);
			cur = ref rec.eqClass;
			while(\ -> ^found == None() && switch (^cur) { MizTrmNil(): false; default: true; }, \ -> {
				switch (^cur) {
					MizTrmElem(mem, next): {
						if (mizTrmSort(mem) == aSort) {
							mf : MizFuncTrm = mizEqAsFunc(mem);
							if (mf.funcNr == af.funcNr) {
								noArgs = switch (mf.args) { MizTrmNil(): true; default: false; };
								if (noArgs) {
									found := Some(rec.term);
								} else {
									switch (mizANLocateTermList(eq, af.args)) {
										Some(la): {
											if (mizEqTrmListsE(eq, la, mf.args)) {
												found := Some(rec.term);
											}
										}
										None(): {}
									}
								}
							}
						}
						cur := next;
					}
					MizTrmNil(): {}
				}
			});
			i := ^i + 1;
		});
		^found;
	} else {
		None();
	}
}

mizANLocatedAttr(eq : MizEqualizer, a : MizAttr) -> Maybe<MizAttr> {
	noArgs = switch (a.args) { MizTrmNil(): true; default: false; };
	if (noArgs) {
		Some(mizCopyAttr(a));
	} else {
		switch (mizANLocateTermList(eq, a.args)) {
			Some(la): Some(MizAttr(a.neg, a.attrNr, la, a.collected, a.pattNr));
			None(): None();
		}
	}
}

mizANLocatedCluster(eq : MizEqualizer, aCluster : MizAttrColl) -> MizAttrColl {
	r = mizNewEmptyCluster();
	iterVector(aCluster.items, \a -> {
		switch (mizANLocatedAttr(eq, a)) {
			Some(la): mizAttrCollInsert(eq.env, r, la);
			None(): {}
		}
	});
	r;
}

// ---------------- the rounding itself ----------------

// EnlargeBy into the supercluster; true when it grew
mizANEnlarge(eq : MizEqualizer, sc : MizAttrColl, lc : MizAttrColl) -> bool {
	c0 = sizeVector(sc.items);
	iterVector(lc.items, \a -> mizAttrCollInsert(eq.env, sc, mizCopyAttr(a)));
	sizeVector(sc.items) != c0;
}

mizRoundUpSuperCluster(eq : MizEqualizer, enr : int) -> bool {
	rec = mizTrmSAt(eq, enr);
	live = switch (rec.eqClass) { MizTrmNil(): false; default: true; };
	if (!live) {
		false;
	} else {
		r = ref false;
		stop = ref false;
		added = ref true;
		applyOne = \allowed : MizAttrColl, contrTop : int, contrInst : int, inst : MizPreInst -> {
			if (inst.top) {
				lC = mizANLocatedCluster(eq, allowed);
				if (mizANEnlarge(eq, rec.superCluster, lC)) {
					r := true;
					added := true;
				}
				if (!rec.superCluster.consistent) {
					mizSetContr(eq, contrTop);
					r := true;
					stop := true;
				}
			} else {
				iterVector(inst.evals, \atom -> {
					if (!^stop) {
						eq.anInst ::= atom;
						lC = mizANLocatedCluster(eq, allowed);
						if (mizANEnlarge(eq, rec.superCluster, lC)) {
							r := true;
							added := true;
						}
						if (!rec.superCluster.consistent) {
							mizSetContr(eq, contrInst);
							r := true;
							stop := true;
						}
					}
				});
			}
		};
		while(\ -> ^added && !^stop, \ -> {
			added := false;
			iterVector(eq.allowedC, \pc -> {
				if (!^stop) {
					cc : MizCCluster = getVectorUnsafe(eq.clusters.conditional, pc.first);
					instC = mizANInstCCluster(eq, cc, enr);
					if (getUrlParameterDef("dbg-rus", "") == i2s(enr)) {
						println("RUS cls " + i2s(enr) + " CC " + cc.article + ":"
							+ i2s(cc.absNr) + " -> "
							+ (if (instC.top) "top" else i2s(mizPreInstCount(instC))));
					}
					applyOne(pc.second, 8, 9, instC);
				}
			});
			iterVector(eq.allowedF, \pf -> {
				if (!^stop) {
					fc : MizFCluster = getVectorUnsafe(eq.clusters.functor, pf.first);
					applyOne(pf.second, 10, 11, mizANInstFCluster(eq, fc, enr));
				}
			});
		});
		^r;
	}
}

// the EqStack loop at the end of Equate: round every class, re-round the
// dependents of every class whose supercluster changed
mizSuperClusterRoundLoop(eq : MizEqualizer) -> void {
	clearVector(eq.anDeps);
	i = ref 1;
	while(\ -> ^i <= mizTrmNbr(eq), \ -> {
		pushVector(eq.anDeps, mizANDependentClasses(eq, ^i));
		i := ^i + 1;
	});
	j = ref 1;
	while(\ -> ^j <= mizTrmNbr(eq), \ -> {
		live = switch (mizTrmSAt(eq, ^j).eqClass) { MizTrmNil(): false; default: true; };
		if (live) mizNatInsertElem(eq.anStack, ^j);
		j := ^j + 1;
	});
	while(\ -> eq.contr == 0 && mizNatCount(eq.anStack) > 0, \ -> {
		ani = mizNatItem(eq.anStack, 0).x;
		mizNatDeleteElem(eq.anStack, ani);
		if (mizRoundUpSuperCluster(eq, ani) && eq.contr == 0) {
			// refresh the dependency sets with the classes now mentioning ani
			anj = ref 1;
			while(\ -> ^anj <= mizTrmNbr(eq), \ -> {
				if (mizANDependsOn(eq, ani, ^anj)) {
					switch (getVectorUnsafe(eq.anDeps, ^anj - 1)) {
						Some(ns): if (!mizNatHasInDom(ns, ani)) mizNatInsertElem(ns, ani);
						None(): {}
					}
				}
				anj := ^anj + 1;
			});
			// re-round everything that depends on ani
			switch (mizANDependentClasses(eq, ani)) {
				Some(ns1): {
					z = ref 0;
					while(\ -> ^z < mizNatCount(ns1), \ -> {
						mizNatInsertElem(eq.anStack, mizNatItem(ns1, ^z).x);
						z := ^z + 1;
					});
				}
				None(): {}
			}
		}
	});
}

// ---------------- reductions (equalizer.pas 2820-2880) ----------------

// ExecuteReduction: union the class with the located reduced term
mizExecuteReduction(eq : MizEqualizer, enr : int, red : MizReduction) -> void {
	t1 = red.t1;
	target = if (mizTrmSort(t1) == ikTrmFunctor) {
		f1 : MizFuncTrm = mizEqAsFunc(t1);
		pa = mizAdjustTrm(eq.env, f1);
		mizANLocateTerm(eq, mizNewFuncTrm(pa.first, pa.second));
	} else {
		mizANLocateTerm(eq, t1);
	}
	switch (target) {
		Some(t): mizUnionTrms(eq, enr, mizTrmInfoOf(t));
		None(): {}
	}
}

// ProcessReductionsAN: apply every reduction matching the class
mizProcessReductionsAN(eq : MizEqualizer, enr : int) -> void {
	rec = mizTrmSAt(eq, enr);
	live = switch (rec.eqClass) { MizTrmNil(): false; default: true; };
	if (live) {
		iterVector(eq.idn.reductions, \red -> {
			if (eq.contr == 0) {
				inst0 = mizANInstTerm(eq, red.primaries, rec.term, red.t0);
				if (inst0.top) {
					mizExecuteReduction(eq, enr, red);
				} else if (sizeVector(inst0.evals) > 0) {
					eq.anInst ::= getVectorUnsafe(inst0.evals, 0);
					mizExecuteReduction(eq, enr, red);
				}
			}
		});
	}
}

// ProcessReductions: over the classes of all available constants (DTrm)
mizProcessReductions(eq : MizEqualizer) -> void {
	if (sizeVector(eq.idn.reductions) > 0 && mizTrmNbr(eq) > 0) {
		k = ref 0;
		while(\ -> eq.contr == 0 && ^k < sizeVector(eq.dTrm), \ -> {
			switch (getVectorUnsafe(eq.dTrm, ^k)) {
				Some(t): mizProcessReductionsAN(eq, mizTrmInfoOf(t));
				None(): {}
			}
			k := ^k + 1;
		});
	}
}

// ChChangeBound: bound vars above the current binder depth are re-based down
mizChChangeBoundE(eq : MizEqualizer, t : MizTrm) -> void {
	env = eq.env;
	if (env.boundVarNbr > 0) {
		w = mizMakeWithin(\__, trm -> {
			switch (trm) {
				MizVarTrm(s2, v2, __, __): {
					if (s2 == ikTrmBound && v2 > env.boundVarNbr) {
						vt : MizVarTrm = mizEqAsVar(trm);
						vt.varNr ::= v2 - env.boundVarNbr;
					}
					trm;
				}
				default: trm;
			}
		});
		__t = mizWithinTrm(w, t);
		{}
	}
}

// one COMPLEX-requirement functor occurrence: zero/one unions + value
// evaluation into EquateComplexValue (equalizer.pas 3222-3376)
mizEvalComplexReq(eq : MizEqualizer, rq : int, t : MizTrm) -> void {
	args = mizArgsOfE(t);
	ti = mizTrmInfoOf(t);
	lTrmInfo = mizClassOf(eq, ti);
	valOf = \a : MizTrm -> {
		ra = mizTrmSAt(eq, mizClassOf(eq, mizTrmInfoOf(a)));
		if (ra.numDetermined) Some(ra.numValue) else None();
	};
	isInt = \v : MizComplex, n : int -> v.im == 0.0 && v.re == i2d(n);
	if (rq == rqRealAdd) {
		lt1 = mizTrmListNth(args, 0);
		lt2 = mizTrmListNth(args, 1);
		switch (valOf(lt1)) {
			Some(v1): {
				if (isInt(v1, 0)) mizUnionTrms(eq, lTrmInfo, mizTrmInfoOf(lt2));
				if (eq.contr == 0) {
					switch (valOf(lt2)) {
						Some(v2): mizEquateComplexValue(eq, mizClassOf(eq, ti),
							MizComplex(v1.re + v2.re, v1.im + v2.im));
						None(): {}
					}
				}
			}
			None(): {}
		}
	} else if (rq == rqRealMult) {
		lt1 = mizTrmListNth(args, 0);
		lt2 = mizTrmListNth(args, 1);
		switch (valOf(lt1)) {
			Some(v1): {
				if (isInt(v1, 0)) mizUnionTrms(eq, ti, mizTrmInfoOf(lt1))
				else if (isInt(v1, 1)) mizUnionTrms(eq, ti, mizTrmInfoOf(lt2));
				if (eq.contr == 0) {
					switch (valOf(lt2)) {
						Some(v2): mizEquateComplexValue(eq, mizClassOf(eq, ti),
							mizCMul(v1, v2));
						None(): {}
					}
				}
			}
			None(): {}
		}
	} else if (rq == rqRealNeg) {
		lt1 = mizTrmListNth(args, 0);
		switch (valOf(lt1)) {
			Some(v1): mizEquateComplexValue(eq, lTrmInfo,
				MizComplex(-v1.re, -v1.im));
			None(): {}
		}
	} else if (rq == rqRealInv) {
		lt1 = mizTrmListNth(args, 0);
		switch (valOf(lt1)) {
			Some(v1): {
				if (v1.re != 0.0 || v1.im != 0.0) {
					mizEquateComplexValue(eq, lTrmInfo, mizCInvE(v1));
				}
			}
			None(): {}
		}
	} else if (rq == rqRealDiff) {
		lt1 = mizTrmListNth(args, 0);
		lt2 = mizTrmListNth(args, 1);
		switch (valOf(lt2)) {
			Some(v2): {
				if (isInt(v2, 0)) mizUnionTrms(eq, lTrmInfo, mizTrmInfoOf(lt1));
				if (eq.contr == 0) {
					switch (valOf(lt1)) {
						Some(v1): mizEquateComplexValue(eq, mizClassOf(eq, ti),
							MizComplex(v1.re - v2.re, v1.im - v2.im));
						None(): {}
					}
				}
			}
			None(): {}
		}
	} else if (rq == rqRealDiv) {
		lt1 = mizTrmListNth(args, 0);
		lt2 = mizTrmListNth(args, 1);
		switch (valOf(lt1)) {
			Some(v1): if (isInt(v1, 0)) mizUnionTrms(eq, ti, mizTrmInfoOf(lt1));
			None(): {}
		}
		if (eq.contr == 0) {
			switch (valOf(lt2)) {
				Some(v2): {
					if (v2.re != 0.0 || v2.im != 0.0) {
						inv = mizCInvE(v2);
						if (isInt(inv, 1)) mizUnionTrms(eq, ti, mizTrmInfoOf(lt1));
						if (eq.contr == 0) {
							switch (valOf(lt1)) {
								Some(v1): mizEquateComplexValue(eq, mizClassOf(eq, ti),
									mizCMul(v1, inv));
								None(): {}
							}
						}
					}
				}
				None(): {}
			}
		}
	}
}

mizCMul(a : MizComplex, b : MizComplex) -> MizComplex {
	MizComplex(a.re * b.re - a.im * b.im, a.re * b.im + a.im * b.re);
}

mizCInvE(a : MizComplex) -> MizComplex {
	d = a.re * a.re + a.im * a.im;
	MizComplex(a.re / d, -a.im / d);
}

// ==================== polynomial values (equalizer.pas 3480-3826) ====================

// sorted insert into a class's PolynomialValues (StdComparePolynomials, dedup)
mizPolyValInsert(v : Vector<MizPolynomial>, p : MizPolynomial) -> void {
	n = sizeVector(v);
	lo = ref 0;
	hi = ref n;
	dup = ref false;
	while(\ -> !^dup && ^lo < ^hi, \ -> {
		mid = (^lo + ^hi) / 2;
		c = mizStdComparePolynomials(getVectorUnsafe(v, mid), p);
		if (c == 0) {
			lo := mid;
			dup := true;
		} else if (c > 0) {
			hi := mid;
		} else {
			lo := mid + 1;
		}
	});
	pos = ref ^lo;
	if (!^dup) {
		pushVector(v, p);
		i = ref sizeVector(v) - 1;
		while(\ -> ^i > ^pos, \ -> {
			setVectorUnsafe(v, ^i, getVectorUnsafe(v, ^i - 1));
			i := ^i - 1;
		});
		setVectorUnsafe(v, ^pos, p);
	}
}

mizIsComplexNumberE(eq : MizEqualizer, sc : MizAttrColl) -> bool {
	rqC = mizBuiltIn(eq.env.builtIn, rqComplex);
	switch (mizGetAttr(eq, sc, rqC, MizTrmNil())) {
		Some(a): a.neg == 1;
		None(): false;
	}
}

mizInsertComplexE(eq : MizEqualizer, nr : int) -> void {
	rqC = mizBuiltIn(eq.env.builtIn, rqComplex);
	rec = mizTrmSAt(eq, mizClassOf(eq, nr));
	if (!mizIsComplexNumberE(eq, rec.superCluster)) {
		mizInsertAttrE(eq, rec.superCluster, rqC, 1, MizTrmNil());
		if (!rec.superCluster.consistent) mizSetContr(eq, 13);
	}
}

// classes containing complex operations (or their arguments) become complex
mizInitSuperClusterForComplex(eq : MizEqualizer) -> void {
	env = eq.env;
	if (mizBuiltIn(env.builtIn, rqComplex) != 0) {
		ii = ref 1;
		while(\ -> eq.contr == 0 && ^ii <= mizTrmNbr(eq), \ -> {
			rec = mizTrmSAt(eq, ^ii);
			cur = ref rec.eqClass;
			while(\ -> eq.contr == 0
					&& switch (^cur) { MizTrmNil(): false; default: true; }, \ -> {
				switch (^cur) {
					MizTrmElem(trm, next): {
						switch (trm) {
							MizVarTrm(srt, __, __, __): {
								if (srt == ikTrmInfConst && rec.numDetermined) {
									mizInsertComplexE(eq, ^ii);
								}
							}
							MizFuncTrm(srt, funcNr, args, __, __): {
								if (srt == ikTrmFunctor) {
									rq = mizRevReqPub(eq.idn, funcNr);
									if (rq == rqImaginaryUnit) {
										mizInsertComplexE(eq, ^ii);
									} else if (rq == rqRealAdd || rq == rqRealMult
										|| rq == rqRealDiff || rq == rqRealDiv) {
										mizInsertComplexE(eq,
											mizClassOf(eq, mizTrmInfoOf(mizTrmListNth(args, 0))));
										if (eq.contr == 0) mizInsertComplexE(eq,
											mizClassOf(eq, mizTrmInfoOf(mizTrmListNth(args, 1))));
										if (eq.contr == 0) mizInsertComplexE(eq, ^ii);
									} else if (rq == rqRealNeg || rq == rqRealInv) {
										mizInsertComplexE(eq,
											mizClassOf(eq, mizTrmInfoOf(mizTrmListNth(args, 0))));
										if (eq.contr == 0) mizInsertComplexE(eq, ^ii);
									}
								}
							}
							default: {}
						}
						cur := next;
					}
					MizTrmNil(): {}
				}
			});
			ii := ^ii + 1;
		});
	}
}

// SubstituteVariable: replace aVar by aTerm in every class's values (Contr 4)
mizSubstituteVariableP(eq : MizEqualizer, aVar : int, aTerm : MizPolynomial,
		pend : MizNatFunc) -> bool {
	res = ref false;
	if (!mizPolyHasTheVariable(aTerm, aVar)) {
		lVar = mizClassOf(eq, aVar);
		t = ref 1;
		while(\ -> ^t <= mizTrmNbr(eq), \ -> {
			rec = mizTrmSAt(eq, ^t);
			live = switch (rec.eqClass) { MizTrmNil(): false; default: true; };
			if (^t != lVar && live) {
				changed : Vector<MizPolynomial> = makeVector(2);
				i = ref 0;
				while(\ -> ^i < sizeVector(rec.polynomialValues), \ -> {
					pv : MizPolynomial = getVectorUnsafe(rec.polynomialValues, ^i);
					if (mizPolyHasTheVariable(pv, aVar)) {
						mizPolyInsertValue(pv, aVar, aTerm);
						if (mizPolyIsNumeric(pv)) {
							if (!rec.numDetermined) {
								mizNatInsertElem(pend, ^t);
								rec.numDetermined ::= true;
								rec.numValue ::= mizPolyGetNumeric(pv);
							} else if (!mizPolyIsNumericEqualWith(pv, rec.numValue)) {
								mizSetContr(eq, 4);
							}
						}
						pushVector(changed, pv);
						removeVector(rec.polynomialValues, ^i);
						res := true;
					} else {
						i := ^i + 1;
					}
				});
				iterVector(changed, \pv -> mizPolyValInsert(rec.polynomialValues, pv));
			}
			t := ^t + 1;
		});
	}
	^res;
}

// SubstVar: replace lVar by the plain variable sVar (Contr 15)
mizSubstVarP(eq : MizEqualizer, lVar : int, sVar : int) -> void {
	lPoly = mizPolyWithMonomial(MizComplex(1.0, 0.0), sVar);
	t = ref 1;
	while(\ -> ^t <= mizTrmNbr(eq), \ -> {
		rec = mizTrmSAt(eq, ^t);
		live = switch (rec.eqClass) { MizTrmNil(): false; default: true; };
		if (^t != lVar && live) {
			changed : Vector<MizPolynomial> = makeVector(2);
			i = ref 0;
			while(\ -> ^i < sizeVector(rec.polynomialValues), \ -> {
				pv : MizPolynomial = getVectorUnsafe(rec.polynomialValues, ^i);
				if (mizPolyHasTheVariable(pv, lVar)) {
					mizPolyInsertValue(pv, lVar, lPoly);
					if (mizPolyIsNumeric(pv)) {
						if (!rec.numDetermined) {
							rec.numDetermined ::= true;
							rec.numValue ::= mizPolyGetNumeric(pv);
						} else if (!mizPolyIsNumericEqualWith(pv, rec.numValue)) {
							mizSetContr(eq, 15);
						}
					}
					pushVector(changed, pv);
					removeVector(rec.polynomialValues, ^i);
				} else {
					i := ^i + 1;
				}
			});
			iterVector(changed, \pv -> mizPolyValInsert(rec.polynomialValues, pv));
		}
		t := ^t + 1;
	});
}

mizSubstitutePendingVars(eq : MizEqualizer, pend : MizNatFunc) -> void {
	while(\ -> mizNatCount(pend) > 0, \ -> {
		k = mizClassOf(eq, mizNatItem(pend, 0).x);
		mizNatDeleteElem(pend, mizNatItem(pend, 0).x);
		rec = mizTrmSAt(eq, k);
		if (sizeVector(rec.polynomialValues) == 1) {
			__s = mizSubstituteVariableP(eq, k,
				getVectorUnsafe(rec.polynomialValues, 0), pend);
			{}
		}
	});
	go = ref true;
	while(\ -> ^go, \ -> {
		t = ref 1;
		while(\ -> ^t <= mizTrmNbr(eq), \ -> {
			rec = mizTrmSAt(eq, ^t);
			live = switch (rec.eqClass) { MizTrmNil(): false; default: true; };
			if (live && rec.numDetermined && sizeVector(rec.polynomialValues) == 1) {
				mizNatInsertElem(pend, ^t);
			}
			t := ^t + 1;
		});
		subst = ref false;
		while(\ -> mizNatCount(pend) > 0, \ -> {
			k = mizClassOf(eq, mizNatItem(pend, 0).x);
			mizNatDeleteElem(pend, mizNatItem(pend, 0).x);
			rec = mizTrmSAt(eq, k);
			if (sizeVector(rec.polynomialValues) == 1) {
				if (mizSubstituteVariableP(eq, k,
						getVectorUnsafe(rec.polynomialValues, 0), pend)) {
					subst := true;
				}
			}
		});
		go := ^subst;
	});
}

// InitPolynomialValues: give every class member its polynomial reading
mizInitPolynomialValues(eq : MizEqualizer) -> void {
	env = eq.env;
	if (mizBuiltIn(env.builtIn, rqComplex) != 0) {
		pend = mizInitNatSet(8);
		cOne = MizComplex(1.0, 0.0);
		t = ref 1;
		while(\ -> ^t <= mizTrmNbr(eq), \ -> {
			rec = mizTrmSAt(eq, ^t);
			live = switch (rec.eqClass) { MizTrmNil(): false; default: true; };
			if (live) {
				tt = ^t;
				cur = ref rec.eqClass;
				while(\ -> switch (^cur) { MizTrmNil(): false; default: true; }, \ -> {
					switch (^cur) {
						MizTrmElem(trm, next): {
							srt = mizTrmSort(trm);
							if (srt == ikTrmSchFunc || srt == ikTrmPrivFunc
								|| srt == ikTrmAggreg || srt == ikTrmSelector
								|| srt == ikTrmFraenkel || srt == ikTrmEqConst) {
								if (mizIsComplexNumberE(eq, rec.superCluster)) {
									mizPolyValInsert(rec.polynomialValues,
										mizPolyWithMonomial(cOne, tt));
								}
							} else if (srt == ikTrmInfConst) {
								if (rec.numDetermined) {
									mizPolyValInsert(rec.polynomialValues,
										mizPolyWithNumeric(rec.numValue));
									mizNatInsertElem(pend, tt);
								} else if (mizIsComplexNumberE(eq, rec.superCluster)) {
									if (sizeVector(rec.polynomialValues) == 0) {
										mizPolyValInsert(rec.polynomialValues,
											mizPolyWithMonomial(cOne, tt));
									}
								}
							} else if (srt == ikTrmFunctor) {
								ft : MizFuncTrm = mizEqAsFunc(trm);
								rq = mizRevReqPub(eq.idn, ft.funcNr);
								if (rq == rqImaginaryUnit) {
									mizPolyValInsert(rec.polynomialValues,
										mizPolyWithNumeric(MizComplex(0.0, 1.0)));
									mizNatInsertElem(pend, tt);
								} else if (rq == rqRealAdd || rq == rqRealMult
									|| rq == rqRealDiff) {
									a1 = mizClassOf(eq, mizTrmInfoOf(mizTrmListNth(ft.args, 0)));
									a2 = mizClassOf(eq, mizTrmInfoOf(mizTrmListNth(ft.args, 1)));
									p1 = mizPolyWithMonomial(cOne, a1);
									p2 = mizPolyWithMonomial(cOne, a2);
									pv = if (rq == rqRealAdd) mizAddPolynomials(p1, p2)
										else if (rq == rqRealMult) mizMultPolynomials(p1, p2)
										else mizDiffPolynomials(p1, p2);
									mizPolyValInsert(rec.polynomialValues, pv);
									mizNatInsertElem(pend, tt);
								} else if (rq == rqRealNeg) {
									a1 = mizClassOf(eq, mizTrmInfoOf(mizTrmListNth(ft.args, 0)));
									p1 = mizPolyWithMonomial(cOne, a1);
									mizPolyValInsert(rec.polynomialValues,
										mizNMultPolynomial(MizComplex(-1.0, 0.0), p1));
									mizNatInsertElem(pend, tt);
								} else if (rq == rqRealInv) {
									mizPolyValInsert(rec.polynomialValues,
										mizPolyWithMonomial(cOne, tt));
								} else if (rq == rqRealDiv) {
									a1 = mizClassOf(eq, mizTrmInfoOf(mizTrmListNth(ft.args, 0)));
									a2r = mizTrmSAt(eq,
										mizClassOf(eq, mizTrmInfoOf(mizTrmListNth(ft.args, 1))));
									inv : Maybe<MizComplex> = if (a2r.numDetermined
										&& !(a2r.numValue.re == 0.0 && a2r.numValue.im == 0.0)) {
										d = a2r.numValue.re * a2r.numValue.re
											+ a2r.numValue.im * a2r.numValue.im;
										Some(MizComplex(a2r.numValue.re / d, -a2r.numValue.im / d));
									} else None();
									switch (inv) {
										Some(iv): {
											p1 = mizPolyWithMonomial(cOne, a1);
											mizPolyValInsert(rec.polynomialValues,
												mizNMultPolynomial(iv, p1));
											mizNatInsertElem(pend, tt);
										}
										None(): {
											mizPolyValInsert(rec.polynomialValues,
												mizPolyWithMonomial(cOne, tt));
										}
									}
								} else if (rec.numDetermined) {
									mizPolyValInsert(rec.polynomialValues,
										mizPolyWithNumeric(rec.numValue));
									mizNatInsertElem(pend, tt);
								} else if (mizIsComplexNumberE(eq, rec.superCluster)) {
									mizPolyValInsert(rec.polynomialValues,
										mizPolyWithMonomial(cOne, tt));
								}
							}
							cur := next;
						}
						MizTrmNil(): {}
					}
				});
				// drop the plain self-variable when other values exist
				if (sizeVector(rec.polynomialValues) > 1) {
					k = ref 0;
					done1 = ref false;
					while(\ -> !^done1 && ^k < sizeVector(rec.polynomialValues), \ -> {
						if (mizPolyIsVariable(getVectorUnsafe(rec.polynomialValues, ^k)) == tt) {
							removeVector(rec.polynomialValues, ^k);
							done1 := true;
						} else {
							k := ^k + 1;
						}
					});
				}
			}
			t := ^t + 1;
		});
		mizSubstitutePendingVars(eq, pend);
	}
}

// ClearPolynomialValues: re-point values of merged-away classes
mizClearPolynomialValues(eq : MizEqualizer) -> void {
	t = ref 1;
	while(\ -> ^t <= mizTrmNbr(eq), \ -> {
		rec = mizTrmSAt(eq, ^t);
		repNr = mizClassOf(eq, ^t);
		if (repNr != ^t && sizeVector(mizTrmSAt(eq, repNr).polynomialValues) > 0) {
			mizSubstVarP(eq, ^t, repNr);
		}
		t := ^t + 1;
	});
}

// SubsituteSettings: union the InfConst settings, substituting where valued
mizSubstituteSettings(eq : MizEqualizer) -> void {
	pend = mizInitNatSet(8);
	iterVector(eq.settings, \p -> {
		if (eq.contr == 0) {
			rx = mizTrmSAt(eq, mizClassOf(eq, p.x));
			ry = mizTrmSAt(eq, mizClassOf(eq, p.y));
			if (sizeVector(rx.polynomialValues) > 0
				&& sizeVector(ry.polynomialValues) > 0) {
				__s = mizSubstituteVariableP(eq, p.x,
					getVectorUnsafe(ry.polynomialValues, 0), pend);
				{}
			}
			mizUnionTrms(eq, p.x, p.y);
		}
	});
	clearVector(eq.settings);
	mizSubstitutePendingVars(eq, pend);
}

// EquatePolynomialValues over the pending equalities (Contr 16)
mizEquatePolynomialValues(eq : MizEqualizer) -> void {
	if (mizBuiltIn(eq.env.builtIn, rqComplex) != 0) {
		pend = mizInitNatSet(8);
		loop1 = ref true;
		while(\ -> eq.contr == 0 && ^loop1, \ -> {
			t = ref 1;
			while(\ -> eq.contr == 0 && ^t <= mizTrmNbr(eq), \ -> {
				rec = mizTrmSAt(eq, ^t);
				live = switch (rec.eqClass) { MizTrmNil(): false; default: true; };
				if (live && sizeVector(rec.polynomialValues) > 0) {
					iV = mizPolyIsVariable(getVectorUnsafe(rec.polynomialValues, 0));
					if (iV > 0 && iV != ^t) {
						ri = mizTrmSAt(eq, mizClassOf(eq, iV));
						if (sizeVector(ri.polynomialValues) > 0) {
							jV = mizPolyIsVariable(getVectorUnsafe(ri.polynomialValues, 0));
							if (jV == iV) {
								if (^t > iV) {
									__s1 = mizSubstituteVariableP(eq, ^t,
										getVectorUnsafe(ri.polynomialValues, 0), pend);
									{}
								} else {
									lp = mizPolyWithMonomial(MizComplex(1.0, 0.0), ^t);
									__s2 = mizSubstituteVariableP(eq, iV, lp, pend);
									{}
								}
								mizUnionTrms(eq, ^t, iV);
							}
						}
					}
				}
				t := ^t + 1;
			});
			mizSubstitutePendingVars(eq, pend);
			// pending equalities with equal polynomial values
			i = ref 0;
			while(\ -> eq.contr == 0 && ^i < sizeVector(eq.eqPend), \ -> {
				p : MizIntPair = getVectorUnsafe(eq.eqPend, ^i);
				rx = mizTrmSAt(eq, mizClassOf(eq, p.x));
				ry = mizTrmSAt(eq, mizClassOf(eq, p.y));
				matched = ref false;
				if (sizeVector(rx.polynomialValues) > 0
					&& sizeVector(ry.polynomialValues) > 0) {
					iterVector(rx.polynomialValues, \p1 ->
						iterVector(ry.polynomialValues, \p2 -> {
							if (!^matched && mizComparePolynomials(p1, p2) == 0) matched := true;
						}));
					if (^matched) {
						mizUnionTrms(eq, p.x, p.y);
						removeVector(eq.eqPend, ^i);
					} else {
						lVar1 = mizPolyIsUniVariantVariable(getVectorUnsafe(rx.polynomialValues, 0));
						lVar2 = mizPolyIsUniVariantVariable(getVectorUnsafe(ry.polynomialValues, 0));
						if (lVar1 == mizClassOf(eq, p.x)) {
							if (lVar2 == mizClassOf(eq, p.y)) {
								mizUnionTrms(eq, p.x, p.y);
								removeVector(eq.eqPend, ^i);
								matched := true;
							} else if (ry.numDetermined
								&& sizeVector(ry.polynomialValues) == 1) {
								__s3 = mizSubstituteVariableP(eq, p.x,
									getVectorUnsafe(ry.polynomialValues, 0), pend);
								mizUnionTrms(eq, p.x, p.y);
								removeVector(eq.eqPend, ^i);
								matched := true;
							}
						} else if (rx.numDetermined && sizeVector(rx.polynomialValues) == 1) {
							if (lVar2 == mizClassOf(eq, p.y)) {
								__s4 = mizSubstituteVariableP(eq, p.y,
									getVectorUnsafe(rx.polynomialValues, 0), pend);
								mizUnionTrms(eq, p.x, p.y);
								removeVector(eq.eqPend, ^i);
								matched := true;
							} else if (mizPolyIsNumeric(getVectorUnsafe(ry.polynomialValues, 0))) {
								mizSetContr(eq, 16);
							}
						}
					}
				}
				if (!^matched) i := ^i + 1;
			});
			loop1 := mizNatCount(pend) != 0;
		});
	}
}

// EquatePolynomials: classes sharing a polynomial value merge
mizPoly2s(p : MizPolynomial) -> string {
	strGlue(map(vector2array(p.monos), \m -> {
		vars = strGlue(map(enumFromTo(0, mizNatCount(m.powers) - 1), \z -> {
			pr = mizNatItem(m.powers, z);
			"E" + i2s(pr.x) + "^" + i2s(pr.y);
		}), "*");
		d2s(m.coeff.re) + (if (vars == "") "" else "*" + vars);
	}), " + ");
}

mizDumpPolys(eq : MizEqualizer, tag : string) -> void {
	if (getUrlParameterDef("dbg-poly", "") == "1") {
		i = ref 1;
		while(\ -> ^i <= mizTrmNbr(eq), \ -> {
			r = mizTrmSAt(eq, ^i);
			live = switch (r.eqClass) { MizTrmNil(): false; default: true; };
			if (live && sizeVector(r.polynomialValues) > 0) {
				println("  POLY[" + tag + "] E" + i2s(^i) + " = "
					+ strGlue(map(vector2array(r.polynomialValues), mizPoly2s), " | "));
			}
			i := ^i + 1;
		});
	}
}

mizEquatePolynomials(eq : MizEqualizer) -> void {
	mizDumpPolys(eq, "eq");
	i1 = ref 1;
	while(\ -> eq.contr == 0 && ^i1 <= mizTrmNbr(eq), \ -> {
		r1 = mizTrmSAt(eq, ^i1);
		live1 = switch (r1.eqClass) { MizTrmNil(): false; default: true; };
		if (live1 && sizeVector(r1.polynomialValues) > 0) {
			i2 = ref ^i1 + 1;
			while(\ -> eq.contr == 0 && ^i2 <= mizTrmNbr(eq), \ -> {
				r2 = mizTrmSAt(eq, ^i2);
				live2 = switch (r2.eqClass) { MizTrmNil(): false; default: true; };
				if (live2 && sizeVector(r2.polynomialValues) > 0) {
					hit = ref false;
					iterVector(r1.polynomialValues, \p1 ->
						iterVector(r2.polynomialValues, \p2 -> {
							if (!^hit && mizComparePolynomials(p1, p2) == 0) hit := true;
						}));
					if (^hit) mizUnionTrms(eq, ^i1, ^i2);
				}
				i2 := ^i2 + 1;
			});
		}
		i1 := ^i1 + 1;
	});
}

// UnionEqualsForNonComplex: non-complex pendings union now; complex ones stay
mizUnionEqualsForNonComplex(eq : MizEqualizer) -> void {
	before = sizeVector(eq.eqPend);
	i = ref 0;
	while(\ -> eq.contr == 0 && ^i < sizeVector(eq.eqPend), \ -> {
		p : MizIntPair = getVectorUnsafe(eq.eqPend, ^i);
		cx = mizIsComplexNumberE(eq, mizTrmSAt(eq, mizClassOf(eq, p.x)).superCluster)
			|| mizIsComplexNumberE(eq, mizTrmSAt(eq, mizClassOf(eq, p.y)).superCluster);
		if (cx) {
			mizInsertComplexE(eq, p.x);
			if (eq.contr == 0) mizInsertComplexE(eq, p.y);
			i := ^i + 1;
		} else {
			mizUnionTrms(eq, p.x, p.y);
			removeVector(eq.eqPend, ^i);
		}
	});
	if (eq.contr == 0 && before != sizeVector(eq.eqPend)) {
		mizIdentities(eq);
	}
}

// ProcessLinearEquations (equalizer.pas 1349-1447): the pending equalities
// as linear equations over MONOMIAL variables (each distinct power product
// recoded as one variable), Gauss-triangularized; numerically impossible
// pendings give Contr 7, an inconsistent system Contr 44, and class pairs
// whose value difference reduces to zero become new pending equalities.
mizProcessLinearEquations(eq : MizEqualizer) -> void {
	if (sizeVector(eq.eqPend) > 0) {
		vars : Vector<MizNatFunc> = makeVector(8);
		// SEARCH-ONLY when the caller demands the variable already exist: the
		// original does `if not lVariables.Search(...) then goto 1` — inserting
		// there would shift every later variable index
		lookupVar = \pp : MizNatFunc, mayInsert : bool -> {
			n = sizeVector(vars);
			lo = ref 0;
			hi = ref n;
			found = ref false;
			while(\ -> !^found && ^lo < ^hi, \ -> {
				mid = (^lo + ^hi) / 2;
				c = mizNatCompareGraph(getVectorUnsafe(vars, mid), pp);
				if (c == 0) {
					lo := mid;
					found := true;
				} else if (c > 0) {
					hi := mid;
				} else {
					lo := mid + 1;
				}
			});
			pos = ref ^lo;
			if (!^found && mayInsert) {
				pushVector(vars, pp);
				i = ref sizeVector(vars) - 1;
				while(\ -> ^i > ^pos, \ -> {
					setVectorUnsafe(vars, ^i, getVectorUnsafe(vars, ^i - 1));
					i := ^i - 1;
				});
				setVectorUnsafe(vars, ^pos, pp);
			}
			Pair(^found, ^pos);
		};
		recode = \p : MizPolynomial, mustExist : bool -> {
			r = MizPolynomial(makeVector(sizeVector(p.monos)));
			ok = ref true;
			iterVector(p.monos, \m -> {
				if (^ok) {
					if (mizNatCount(m.powers) == 0) {
						mizPolyInsert(r, mizNewMonomialPub(m.coeff));
					} else {
						lp = lookupVar(m.powers, !mustExist);
						if (mustExist && !lp.first) {
							ok := false;
						} else {
							nm = mizNewMonomialPub(m.coeff);
							mizNatAssign(nm.powers, lp.second, 1);
							mizPolyInsert(r, nm);
						}
					}
				}
			});
			if (^ok) Some(r) else None();
		};
		lPolys : Vector<MizPolynomial> = makeVector(8);
		iterVector(eq.eqPend, \p -> {
			if (eq.contr == 0) {
				rx = mizTrmSAt(eq, mizClassOf(eq, p.x));
				ry = mizTrmSAt(eq, mizClassOf(eq, p.y));
				if (sizeVector(rx.polynomialValues) > 0
					&& sizeVector(ry.polynomialValues) > 0) {
					d = mizDiffPolynomials(getVectorUnsafe(rx.polynomialValues, 0),
						getVectorUnsafe(ry.polynomialValues, 0));
					if (mizPolyIsNumeric(d)) {
						if (!mizPolyIsNumericEqualWith(d, MizComplex(0.0, 0.0))) {
							mizSetContr(eq, 7);
						}
					} else {
						pushVector(lPolys, d);
					}
				}
			}
		});
		if (getUrlParameterDef("dbg-lin", "") == "1" && sizeVector(lPolys) > 0) {
			println("LIN eqs=" + i2s(sizeVector(lPolys))
				+ " pendings=" + i2s(sizeVector(eq.eqPend))
				+ " classes=" + i2s(mizTrmNbr(eq)));
		}
		if (getUrlParameterDef("dbg-poly", "") == "1") {
			iterVector(eq.eqPend, \pp -> println("  PEND-IN " + i2s(pp.x) + "~" + i2s(pp.y)));
		}
		if (eq.contr == 0 && sizeVector(lPolys) > 0) {
			// REGISTER EVERY VARIABLE FIRST. `vars` is sorted, so an insert
			// shifts every later index — recoding while inserting would leave
			// the equations built earlier pointing at the wrong variables and
			// Gauss would then "prove" equalities that do not hold. (The
			// original inserts as it recodes, iocorrel 1395-1398; it gets away
			// with it only when no later insert lands before an earlier one.)
			iterVector(lPolys, \p -> iterVector(p.monos, \m -> {
				if (mizNatCount(m.powers) != 0) {
					ignore = lookupVar(m.powers, true);
					{}
				}
			}));
			raw : Vector<MizPolynomial> = makeVector(sizeVector(lPolys));
			iterVector(lPolys, \p -> {
				switch (recode(p, true)) {
					Some(r): pushVector(raw, r);
					None(): {}
				}
			});
			if (getUrlParameterDef("dbg-poly", "") == "1") {
				iterVector(raw, \rr -> println("  RAW " + mizPoly2s(rr)));
			}
			gp = mizGaussElimination(raw);
			if (getUrlParameterDef("dbg-poly", "") == "1") {
				iterVector(gp.first, \rr -> println("  GEQ " + mizPoly2s(rr)));
			}
			if (gp.second != 0) {
				mizSetContr(eq, gp.second);
			} else {
				lEquations = gp.first;
				// class pairs whose value difference reduces to zero
				t1 = ref 1;
				while(\ -> eq.contr == 0 && ^t1 <= mizTrmNbr(eq), \ -> {
					r1 = mizTrmSAt(eq, ^t1);
					live1 = switch (r1.eqClass) { MizTrmNil(): false; default: true; };
					if (live1 && sizeVector(r1.polynomialValues) > 0) {
						t2 = ref ^t1 + 1;
						while(\ -> eq.contr == 0 && ^t2 <= mizTrmNbr(eq), \ -> {
							r2 = mizTrmSAt(eq, ^t2);
							live2 = switch (r2.eqClass) { MizTrmNil(): false; default: true; };
							already = ref false;
							iterVector(eq.eqPend, \pp2 -> {
								if ((pp2.x == ^t1 && pp2.y == ^t2)
									|| (pp2.x == ^t2 && pp2.y == ^t1)) already := true;
							});
							if (live2 && !^already && sizeVector(r2.polynomialValues) > 0) {
								hit = ref false;
								iterVector(r1.polynomialValues, \p1 -> {
									iterVector(r2.polynomialValues, \p2 -> {
										if (!^hit) {
											d = mizDiffPolynomials(p1, p2);
											switch (recode(d, true)) {
												Some(le0): {
													le = if (mizPolyIsNumeric(le0)) le0
														else mizLinearEquationReduce(le0, lEquations);
													if (mizPolyIsNumeric(le)
														&& mizPolyIsNumericEqualWith(le,
															MizComplex(0.0, 0.0))) {
														if (getUrlParameterDef("dbg-poly", "") == "1") {
															println("  PEND-NEW " + i2s(^t1) + "~" + i2s(^t2)
																+ " [" + mizPoly2s(p1) + "] vs [" + mizPoly2s(p2) + "]"
																+ " recoded=[" + mizPoly2s(le0) + "] reduced=[" + mizPoly2s(le) + "]");
														}
														mizAddEquality(eq.eqPend, ^t1, ^t2);
														hit := true;
													}
												}
												None(): {}
											}
										}
									});
								});
							}
							t2 := ^t2 + 1;
						});
					}
					t1 := ^t1 + 1;
				});
			}
		}
	}
}
