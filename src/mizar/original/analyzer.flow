// Transcription of ~/dev/system/kernel/analyzer.pas — THE ANALYZER: it reads
// the `.par` token stream Transfer2Analyzer wrote, resolves every expression
// against the notation patterns (generato.flow), checks the correctness
// conditions, and writes the `<article>.xml` analyzer report the CHECKER
// consumes (iocorrel_write.flow).
//
// The unit's globals (analyzer.pas 58-80) become MizAnalyzer, one per article,
// as CONVENTIONS.md requires. The `g` level record lives on MizGen, because
// generato declares it and both units write it.
//
// STATUS: the driver's spine — the main dispatch loop and the items that need
// no definitional machinery. The remaining item kinds abort with the Pascal's
// own RunTimeError code so a partial run says exactly where it stopped.

import ds/vector;
import string;
import loop;
import mizar/original/errhan;
import mizar/original/mobjects;
import mizar/original/lexicon;
import mizar/original/limits;
import mizar/original/enums;
import mizar/original/builtin;
import mizar/original/correl;
import mizar/original/correl_inst;
import mizar/original/correl_match;
import mizar/original/correl_patt;
import mizar/original/roundcl;
import mizar/original/identify;
import mizar/original/definientia;
import mizar/original/schemes;
import mizar/original/justhan;
import mizar/original/generato;
import mizar/original/iocorrel_write;
import math/bits;

export {
	// PropertiesRec (correl.pas) — what a definition declared
	MizPropertiesRec(mutable properties : int, mutable firstArg : int,
		mutable secondArg : int);

	MizAnalyzer(
		env : MizCorrelEnv,
		eh : MizErrHan,
		clusters : MizClusters,
		gen : MizGen,
		out : MizVrfOut,
		inf : MizInStream,
		defs : MizDefinientia,
		idents : MizIdentify,
		schemes : MizSchemes,
		articleId : string,

		// ---- analyzer.pas 58-80 ----
		mutable redefAntonym : bool,
		mutable gRedef : bool,
		mutable gSpecified : bool,
		mutable gPropertiesOcc : bool,
		mutable resNbr : int,
		mutable anyTyp : MizTyp,
		gProperties : MizPropertiesRec,
		mutable statusOfProperties : int,
		mutable gDefiniens : Maybe<MizDefiniens>,
		mutable gDefPos : MizPos,
		mutable gSuperfluous : int,
		mutable dPrimLength : int,
		mutable gWhichOne : int,
		constNr : Vector<int>,          // [1..2*MaxArgNbr]
		locusAsConst : Vector<int>,
		gPrimaries : Vector<MizTyp>,
		lociOcc : Vector<bool>,
		mutable gNonPermissive : bool,
		mutable gPrimNbr : int,
		mutable gBoundInc : int,
		mutable gBoundForFirst : int,
		mutable gBoundForSecond : int,
		mutable gBoundForIt : int,
		gCorrCond : Vector<MizFrm>,     // [0..CorrCondNbr]
		mutable gMaxArgNbr : int,
		mutable gDefBase : int,

		// SchemeBody's counters
		mutable schPredNbr : int,
		mutable curSchFuncNbr : int,
		mutable schemeThesis : MizFrm,
		// D: LevelRec (analyzer.pas 335)
		d : MizLevelRec,
		// PORT-ONLY, and it goes away with the last item kind: the `.par` kind
		// character the main loop did not know, so a partial run says exactly
		// where it stopped instead of aborting.
		mutable stoppedAt : int,
		// gFixedBase (analyzer.pas 370)
		mutable fixedBase : int,
		// gConstErr (CheckLocConst) and the two globals of ChangeSkFixedToBound
		mutable constErr : bool,
		mutable skListCount : int,
		mutable skFrstConstNr : int,
		// gDefNode (analyzer.pas 545)
		dn : MizDefNode,
		// DefinitionList / gEssentials (1056)
		definitionList : Vector<MizDefNodeItem>,
		mutable gEssentials : MizIntSeq,
		// gDefiniendumArgs / gDefArgsError (520)
		mutable definiendumArgs : MizTrmList,
		mutable defArgsError : bool,
		mutable constrError : bool,
		// gCorrCond[k] <> nil in the original is "this condition was generated";
		// a Flow vector cannot hold nil, so the flag rides beside it
		corrCondSet : Vector<bool>,
		// ConstrBase[kind] (Analyze 6660): where the ARTICLE's own
		// constructors start, so an absolute number can be computed
		constrBase : [int],
		// the property machinery (4830-5398): gVisible1/2 are the two visible
		// LOCI, gFirstArg/gSecondArg the constants they stand for
		mutable gVisible1 : int,
		mutable gVisible2 : int,
		mutable gFirstArg : int,
		mutable gSecondArg : int,
		mutable gPropPos : MizPos,
		// gDefThNr (5537): counts the definitional theorems, canceled included
		mutable gDefThNr : int,
		// RegClusterBase / CondClusterBase / FuncClusterBase (Analyze 6663):
		// where the ARTICLE's own registrations start
		mutable regClusterBase : int,
		mutable condClusterBase : int,
		mutable funcClusterBase : int,
	);

	// gDefNode's record
	MizDefNode(
		mutable meansOccurs : int,     // ' ' / 'm' / 'e'
		mutable specified : bool,
		mutable positive : bool,
		mutable pos1 : MizPos,
		mutable pos2 : MizPos,
		mutable kind : int,            // 'R' 'V' 'M' 'K' 'L'
		mutable labNr : int,
		mutable labId : int,
		mutable len : int,
		primaries : Vector<MizTyp>,
	);

	// DefNodeObj (analyzer.pas 38) — one entry of DefinitionList
	MizDefNodeItem(
		meansOccurs : int,
		constrKind : int,
		constrNr : int,
		skId : int,
		skLabId : int,
		def : Maybe<MizDef>,
		skVarNbr : int,
		skIt : int,
		prefix : Maybe<MizRsnEntry>,
		essentials : MizIntSeq,
		primaryList : Vector<MizTyp>,
	);

	CorrCondNbr = 6;

	mizMakeAnalyzer(env : MizCorrelEnv, eh : MizErrHan, clusters : MizClusters,
		gen : MizGen, defs : MizDefinientia, idents : MizIdentify,
		schemes : MizSchemes, parContent : string, articleId : string,
		mizFiles : string) -> MizAnalyzer;

	// procedure Analyze — the main loop
	mizAnalyze(a : MizAnalyzer) -> void;
	mizAnalyzerXml(a : MizAnalyzer) -> string;
}

mizMakeAnalyzer(env : MizCorrelEnv, eh : MizErrHan, clusters : MizClusters,
		gen : MizGen, defs : MizDefinientia, idents : MizIdentify,
		schemes : MizSchemes, parContent : string, articleId : string,
		mizFiles : string) -> MizAnalyzer {
	n = 2 * MaxArgNbr;
	mk1 = \ -> { v : Vector<int> = makeVector(n + 1); fori(0, n, \__ -> pushVector(v, 0)); v };
	a = MizAnalyzer(env, eh, clusters, gen, mizMakeVrfOut(env),
		mizInOpen(parContent, eh), defs, idents, schemes, articleId,
		false, false, false, false, 0, mizNewIncorTyp(),
		MizPropertiesRec(0, 0, 0), 0, None(), mizZeroPos, 0, 0, 0,
		mk1(), mk1(),
		{ v : Vector<MizTyp> = makeVector(n + 1); fori(0, n, \__ -> pushVector(v, mizNewIncorTyp())); v },
		{ v : Vector<bool> = makeVector(n + 1); fori(0, n, \__ -> pushVector(v, false)); v },
		false, 0, 0, 0, 0, 0,
		{ v : Vector<MizFrm> = makeVector(CorrCondNbr + 1);
		  fori(0, CorrCondNbr, \__ -> pushVector(v, mizNewIncorFrm())); v },
		MaxArgNbr, 0, 0, 0, mizNewIncorFrm(),
		MizLevelRec(0, 0, 0, 0, 0, 0, None(), false, None()), 0, 0,
		false, 0, 0,
		MizDefNode(32, false, false, mizZeroPos, mizZeroPos, 0, 0, 0, 0, makeVector(4)),
		makeVector(4), mizInitIntSeq(4), MizTrmNil(), false, false,
		{ v : Vector<bool> = makeVector(CorrCondNbr + 1);
		  fori(0, CorrCondNbr, \__ -> pushVector(v, false)); v },
		map(enumFromTo(0, coLAST), \k -> mizConstrCount(env, k) - 1),
		0, 0, 0, 0, mizZeroPos, 0, 0, 0, 0);
	// the report's own header (Analyze, analyzer.pas 6672)
	mizVOutString(a.out, "<?xml version=\"1.0\"?>\n");
	mizVOutString(a.out,
		"<?xml-stylesheet type=\"text/xml\" href=\"file://" + mizFiles + "miz.xml\"?>\n");
	mizVOutElStart(a.out, "Article");
	mizVOutAttr(a.out, "aid", articleId);
	mizVOutAttr(a.out, "mizfiles", mizFiles);
	mizVOutAttrEnd(a.out);
	a;
}

mizAnalyzerXml(a : MizAnalyzer) -> string { mizVrfOutContent(a.out); }

mizAError(a : MizAnalyzer, pos : MizPos, nr : int) -> void { mizError(a.eh, pos, nr); }
mizAErrImm(a : MizAnalyzer, nr : int) -> void { mizErrImm(a.eh, nr); }

// BoundVarNbr lives on the correl env; Flow9 cannot assign through `a.env.x`
mizASetBVN(a : MizAnalyzer, n : int) -> void { e = a.env; e.boundVarNbr ::= n; }
mizABVN(a : MizAnalyzer) -> int { a.env.boundVarNbr; }

// --------------------------------------------------------- read helpers ---

// ReadSentence (123)
mizReadSentence(a : MizAnalyzer, negate : bool) -> MizFrm {
	mizASetBVN(a, 0);
	lSnt = mizLoadFormula(a.inf);
	lFrm = mizAnalyzeFrm(a.gen, lSnt);
	if (negate) mizNewNeg(lFrm) else lFrm;
}

// ReadType (134)
mizReadType(a : MizAnalyzer) -> MizTyp {
	mizASetBVN(a, 0);
	mizAnalyzeTyp(a.gen, mizLoadType(a.inf));
}

// AnalyzeTerm (143) — a top-level `qua` is stripped
mizAnalyzeTermTop(a : MizAnalyzer, e : MizExp) -> MizTrm {
	mizASetBVN(a, 0);
	lTrm = mizAnalyzeTrm(a.gen, e);
	switch (lTrm) {
		MizQuaTrm(trmProper, __, __, __): mizCopyTrm(trmProper);
		default: lTrm;
	}
}

// ReadTerm (154)
mizReadTerm(a : MizAnalyzer) -> MizTrm {
	mizASetBVN(a, 0);
	mizAnalyzeTermTop(a, mizLoadTerm(a.inf));
}

// AnalizeArgTypeList (176)
mizAnalizeArgTypeList(a : MizAnalyzer) -> Vector<MizTyp> {
	coll : Vector<MizExp> = makeVector(2);
	mizInWord(a.inf);
	while(\ -> a.inf.curKind != 59, \ -> {
		pushVector(coll, mizLoadType(a.inf));
		mizInWord(a.inf);
	});
	res : Vector<MizTyp> = makeVector(sizeVector(coll));
	n = ref 0;
	iterVector(coll, \e -> {
		if (^n >= a.gMaxArgNbr) mizOverflowError(937);
		n := ^n + 1;
		mizASetBVN(a, 0);
		t = mizAnalyzeTyp(a.gen, e);
		while(\ -> sizeVector(a.env.locArgTyp) <= ^n,
			\ -> pushVector(a.env.locArgTyp, mizNewIncorTyp()));
		setVectorUnsafe(a.env.locArgTyp, ^n, t);
		pushVector(res, t);
	});
	res;
}

// ReadPropositions (201)
mizReadPropositions(a : MizAnalyzer) -> Vector<MizProposition> {
	conds : Vector<MizProposition> = makeVector(2);
	while(\ -> a.inf.curKind != 59, \ -> {
		lLabNr = a.inf.curNr;
		lLabId = mizInInt(a.inf);
		lPos = mizInPos(a.inf);
		mizInWord(a.inf);
		lFrm = mizReadSentence(a, false);
		pushVector(conds, MizProposition(lLabNr, lLabId, lPos, lFrm));
		mizInWord(a.inf);
	});
	conds;
}

// ConjugatePropositions (215)
mizConjugatePropositions(conds : Vector<MizProposition>) -> MizFrm {
	foldVector(conds, mizNewVerum(), \acc, p -> mizNewConj(acc, mizCopyFrm(p.sentence)));
}

// ------------------------------------------------------------- the items ---

// Section (6561)
mizASection(a : MizAnalyzer) -> void {
	mizInPos(a.inf);
	mizVOutEl1(a.out, "Section");
	mizInWord(a.inf);
}

// Canceled (6570)
mizACanceled(a : MizAnalyzer) -> void {
	mizInWord(a.inf);
	if (a.inf.curKind == 84) {          // ikTheoremCanceled 'T'
		mizVOutElStart(a.out, "JustifiedTheorem");
		mizVOutPosAsAttrs(a.out, a.eh.curPos);
		mizVOutAttrEnd(a.out);
		mizVOutPropos(a.out, 0, 0, a.eh.curPos, mizNewVerum());
		mizVOutEl1(a.out, "SkippedProof");
		mizVOutElEnd(a.out, "JustifiedTheorem");
	} else {
		mizVOutElStart(a.out, "Canceled");
		mizVOutAttr(a.out, "kind", fromCharCode(a.inf.curKind));
		mizVOutElEnd0(a.out);
	}
	mizInWord(a.inf);
}

// Reservation (3045)
mizAReservation(a : MizAnalyzer) -> void {
	env = a.env;
	env.boundVarNbr ::= 0;
	mizVOutElStart0(a.out, "Reservation");
	mark = mizTTCollMark(env);
	gn = a.gen;
	gn.exportableItem ::= true;
	gn.constInExportableItemOcc ::= false;
	idents = mizInitIntSeq(4);
	mizInWord(a.inf);
	while(\ -> a.inf.curKind != 59, \ -> {
		mizSeqInsert(idents, a.inf.curNr);
		mizInWord(a.inf);
	});
	fori(0, mizSeqCount(idents) - 1, \k -> {
		mizVOutElStart(a.out, "Ident");
		mizVOutIntAttr(a.out, "vid", mizSeqValue(idents, k));
		mizVOutElEnd0(a.out);
	});
	mizInWord(a.inf);
	while(\ -> a.inf.curKind != 59, \ -> {
		e = mizLoadType(a.inf);
		env.boundVarNbr ::= env.boundVarNbr + 1;
		mizSetBoundVar(env, env.boundVarNbr, mizAnalyzeTyp(a.gen, e));
		mizInWord(a.inf);
	});
	a.resNbr ::= a.resNbr + 1;
	mizAssert(2524, a.resNbr <= MaxResNbr);
	rt = mizAnalyzeTyp(a.gen, mizLoadType(a.inf));
	mizGenSetReservedVar(a.gen, a.resNbr, rt);
	mizVOutType(a.out, rt);
	mizTTCollRelease(env, mark);
	mizInWord(a.inf);
	env.boundVarNbr ::= 0;
	gn.exportableItem ::= false;
	gn.constInExportableItemOcc ::= false;
	mizVOutElEnd(a.out, "Reservation");
}

// ------------------------------------------------------ justifications ----

// LoadInferenceObj (3657)
mizLoadInferenceObj(a : MizAnalyzer) -> MizInference {
	mizInWord(a.inf);
	inf = mizMakeInference();
	inf.inferSort ::= a.inf.curKind;   // ikInfBy / ikInfFrom / ikError
	inf.schFileNr ::= mizInInt(a.inf);
	inf.schemeNr ::= mizInInt(a.inf);
	inf.linked ::= mizInBool(a.inf);
	mizInWord(a.inf);
	while(\ -> a.inf.curKind != 59, \ -> {
		k = a.inf.curKind;
		if (k == 108) {          // 'l'
			n1 = mizInInt(a.inf); n2 = mizInInt(a.inf); pos = mizInPos(a.inf);
			pushVector(inf.references, MizPrivateRef(pos, n1, n2));
		} else if (k == 116) {   // 't'
			n1 = mizInInt(a.inf); n2 = mizInInt(a.inf); pos = mizInPos(a.inf);
			pushVector(inf.references, MizTheoremRef2(pos, n1, n2));
		} else if (k == 100) {   // 'd'
			n1 = mizInInt(a.inf); n2 = mizInInt(a.inf); pos = mizInPos(a.inf);
			pushVector(inf.references, MizDefinitionRef2(pos, n1, n2));
		} else {
			mizRunTimeError(1002);
		}
		mizInWord(a.inf);
	});
	inf.pos ::= mizInPos(a.inf);
	inf;
}

// Justify (4457)
mizAJustify(a : MizAnalyzer, thesisId : int, labId : int, thesis : MizFrm) -> void {
	mizInWord(a.inf);
	k = a.inf.curKind;
	if (k == 34) {                       // '"' — a simple justification
		mizVOutPropos(a.out, thesisId, labId, a.eh.curPos, thesis);
		inf = mizLoadInferenceObj(a);
		mizVOutInference(a.out, inf);
		mizInWord(a.inf);
	} else if (k == ikBlcProof) {
		mizInPos(a.inf);
		mizInWord(a.inf);
		mizADemonstration(a, thesisId, labId, thesis);
	} else {
		mizVOutPropos(a.out, thesisId, labId, a.eh.curPos, thesis);
		mizVOutEl1(a.out, "SkippedProof");
	}
}

// Theorem (6526)
mizATheorem(a : MizAnalyzer) -> void {
	mizInPos(a.inf);
	mizVOutElStart(a.out, "JustifiedTheorem");
	mizVOutPosAsAttrs(a.out, a.eh.curPos);
	mizVOutAttrEnd(a.out);
	mizInWord(a.inf);
	lLabNr = a.inf.curNr;
	lLabId = mizInInt(a.inf);
	mizInPos(a.inf);
	mizInWord(a.inf);
	gn = a.gen;
	gn.exportableItem ::= true;
	gn.constInExportableItemOcc ::= false;
	lFrm = mizReadSentence(a, false);
	gn.exportableItem ::= false;
	gn.constInExportableItemOcc ::= false;
	mizAJustify(a, lLabNr, lLabId, lFrm);
	mizVOutElEnd(a.out, "JustifiedTheorem");
}

// --------------------------------------------------------------- Analyze ---

// procedure Analyze (6649) — the main loop dispatches on the leading kind
// character of each `.par` item.
mizAnalyze(a : MizAnalyzer) -> void {
	// AnyTyp (6666) — the widest mode, the default of an omitted specification
	a.anyTyp ::= mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(),
		mizNewEmptyCluster(), mizBuiltIn(a.env.builtIn, rqAny), MizTrmNil());
	a.regClusterBase ::= sizeVector(a.clusters.registered);
	a.condClusterBase ::= sizeVector(a.clusters.conditional);
	a.funcClusterBase ::= sizeVector(a.clusters.functor);
	mizASetBVN(a, 0);
	mizInWord(a.inf);
	while(\ -> a.inf.curKind != 33 && a.stoppedAt == 0, \ -> {     // '!'
		k = a.inf.curKind;
		if (k == ikBlcSection) mizASection(a)
		else if (k == ikItmReservation) mizAReservation(a)
		else if (k == ikItmCanceled) mizACanceled(a)
		else if (k == ikItmTheorem) mizATheorem(a)
		else if (k == ikBlcScheme) mizAScheme(a)
		else if (k == ikBlcDefinition) mizADefinition(a)
		else if (k == ikBlcNotation) mizANotation(a)
		else if (k == ikBlcRegistration) mizARegistration(a)
		else if (k == 69 || k == ikItmPrivConstant || k == ikItmPrivFunc
			|| k == ikItmPrivPred || k == ikItmReconsidering || k == ikItmChoice)
			mizAStatement(a)
		else a.stoppedAt ::= k;
		if (a.stoppedAt == 0) mizVOutNewLine(a.out);
	});
	if (a.stoppedAt == 0) mizVOutElEnd(a.out, "Article");
}

// ================== the reasoning machinery (3103-4460) ====================

// FixedVar[n], growing (the original is array[1..MaxVarNbr])
mizFixedVarAt(a : MizAnalyzer, n : int) -> MizFixedVar {
	env = a.env;
	while(\ -> sizeVector(env.fixedVar) <= n,
		\ -> pushVector(env.fixedVar, MizFixedVar(0, mizNewIncorTyp(), false, None(), 0)));
	getVectorUnsafe(env.fixedVar, n);
}

mizGVarNbr(a : MizAnalyzer) -> int { a.gen.g.varNbr; }
mizSetGVarNbr(a : MizAnalyzer, n : int) -> void {
	gg = a.gen.g; gg.varNbr ::= n;
	e = a.env; e.fixedVarNbr ::= n;
}

mizThesis(a : MizAnalyzer) -> MizFrm {
	switch (a.gen.g.thesis) { Some(f): f; None(): mizNewIncorFrm(); }
}
mizSetThesis(a : MizAnalyzer, f : MizFrm) -> void { gg = a.gen.g; gg.thesis ::= Some(f); }

// SpreadLocPred (3103) — strip the private-predicate wrappers, and the
// `not P` shape where P's expansion is itself a negation
mizSpreadLocPred(f0 : MizFrm) -> MizFrm {
	f = ref f0;
	go = ref true;
	while(\ -> ^go, \ -> {
		while(\ -> mizFrmSort(^f) == ikFrmPrivPred, \ -> {
			switch (^f) { MizLocPredFrm(__, __, predExp, __): f := predExp; default: {} }
		});
		done = ref true;
		switch (^f) {
			MizNegFrm(arg, __): switch (arg) {
				MizLocPredFrm(__, __, predExp, __): {
					lFrm1 = ref predExp;
					while(\ -> mizFrmSort(^lFrm1) == ikFrmPrivPred, \ -> {
						switch (^lFrm1) {
							MizLocPredFrm(__, __, pe, __): lFrm1 := pe;
							default: {}
						}
					});
					switch (^lFrm1) {
						MizNegFrm(inner, __): { f := inner; done := false; }
						default: {}
					}
				}
				default: {}
			}
			default: {}
		}
		if (mizFrmSort(^f) != ikFrmPrivPred && ^done) go := false;
	});
	^f;
}

// Decompose (3140): head = the first conjunct, tail = the rest (verum if none)
mizDecompose(f : MizFrm) -> Pair<MizFrm, MizFrm> {
	switch (f) {
		MizConjFrm(conjuncts, __): {
			if (sizeVector(conjuncts) == 0) Pair(f, mizNewVerum())
			else {
				head = getVectorUnsafe(conjuncts, 0);
				rest : Vector<MizFrm> = makeVector(sizeVector(conjuncts) - 1);
				fori(1, sizeVector(conjuncts) - 1, \i -> pushVector(rest, getVectorUnsafe(conjuncts, i)));
				tail = if (sizeVector(rest) == 1) getVectorUnsafe(rest, 0)
					else MizConjFrm(rest, f.pattNr);
				Pair(head, tail);
			}
		}
		default: Pair(f, mizNewVerum());
	}
}

// SpreadAtomicFormula (3162) — returns the Definientia index (1-based) or -1,
// and the replacement formula
mizSpreadAtomicFormula(a : MizAnalyzer, f0 : MizFrm, conclusion : bool) -> Pair<int, MizFrm> {
	env = a.env;
	f1 = mizSpreadLocPred(f0);
	negPair = switch (f1) {
		MizNegFrm(arg, __): Pair(mizSpreadLocPred(arg), true);
		default: Pair(f1, false);
	};
	f = negPair.first;
	negated = negPair.second;
	kind = ref mizFrmSort(f);
	args : ref MizTrmList = ref MizTrmNil();
	nr = ref 0;
	if (^kind == ikFrmPred) {
		switch (f) {
			MizPredFrm(__, __, __, __): { q = mizAdjustFrm(env, f); nr := q.first; args := q.second; }
			default: {}
		}
	} else if (^kind == ikFrmAttr) {
		switch (f) {
			MizPredFrm(__, __, __, __): { q = mizAdjustAttrFrm(env, f); nr := q.first; args := q.second; }
			default: {}
		}
	} else if (^kind == ikFrmQual) {
		switch (f) {
			MizQualFrm(trm, typ, __): {
				if (typ.sort == ikTypMode && sizeVector(typ.lower.items) == 0) {
					kind := ikTypMode;
					q = mizAdjustTyp(env, typ);
					nr := q.first;
					// the qualified TERM becomes the last argument
					last = MizTrmElem(trm, MizTrmNil());
					args := switch (q.second) {
						MizTrmNil(): last;
						MizTrmElem(__, __): {
							le = mizLastElem(q.second);
							le.next ::= last;
							q.second;
						}
					};
				}
			}
			default: {}
		}
	}
	item : ref Maybe<MizDefiniens> = ref None();
	res = ref (-1);
	i = ref (sizeVector(a.defs.all) - 1);
	while(\ -> isNone(^item) && ^i >= 0, \ -> {
		d = getVectorUnsafe(a.defs.all, ^i);
		if (mizMatches(env, ^kind, ^nr, ^args, d)) { item := Some(d); res := ^i + 1; }
		i := ^i - 1;
	});
	switch (^item) {
		None(): Pair(^res, mizNewIncorFrm());
		Some(d): Pair(^res, mizSpreadFrm(env, d,
			mizCreateArgList(env, sizeVector(d.primaries)), negated, conclusion));
	}
}

MaxExpansionNbr = 20;

// Chopped (3223) — destructive on the thesis, as the original is
mizChopped(a : MizAnalyzer, form0 : MizFrm, conclusion : bool) -> Pair<bool, MizNatFunc> {
	defs = mizInitNatFunc(4);
	if (mizFrmSort(mizThesis(a)) == ikError) Pair(true, defs)
	else if (mizFrmSort(form0) == ikError) {
		mizSetThesis(a, mizNewIncorFrm());
		Pair(true, defs);
	} else {
		form = ref form0;
		ok = ref true;
		running = ref true;
		while(\ -> ^running && mizFrmSort(^form) != ikFrmVerum, \ -> {
			dh = mizDecompose(^form);
			fHead = ref dh.first;
			form := dh.second;
			dt = mizDecompose(mizThesis(a));
			tHead = ref dt.first;
			mizSetThesis(a, dt.second);
			matched = ref false;
			ii = ref 1;
			while(\ -> !^matched && ^running && ^ii <= MaxExpansionNbr, \ -> {
				if (mizEqFrm(a.env, ^fHead, ^tHead)) matched := true
				else {
					// the inner repeat: align two private predicates
					inner = ref true;
					while(\ -> ^inner && !^matched, \ -> {
						if (mizFrmSort(^fHead) == ikFrmPrivPred
							&& mizFrmSort(^tHead) == ikFrmPrivPred) {
							pf = switch (^fHead) { MizLocPredFrm(pn, __, __, __): pn; default: 0; };
							pt = switch (^tHead) { MizLocPredFrm(pn, __, __, __): pn; default: 0; };
							if (pf < pt) {
								d2 = mizDecompose(mizNewConj(mizSpreadLocPred(^tHead), mizThesis(a)));
								tHead := d2.first;
								mizSetThesis(a, d2.second);
							} else if (pf == pt) { ok := false; running := false; }
							else {
								d2 = mizDecompose(mizNewConj(mizSpreadLocPred(^fHead), ^form));
								fHead := d2.first;
								form := d2.second;
							}
						}
						if (^running && !^matched) {
							if (mizEqFrm(a.env, ^fHead, ^tHead)) matched := true
							else {
								d3 = mizDecompose(mizNewConj(mizSpreadLocPred(^fHead), ^form));
								fHead := d3.first;
								form := d3.second;
								if (mizEqFrm(a.env, ^fHead, ^tHead)) matched := true
								else {
									d4 = mizDecompose(mizNewConj(mizSpreadLocPred(^tHead), mizThesis(a)));
									tHead := d4.first;
									mizSetThesis(a, d4.second);
									if (mizEqFrm(a.env, ^fHead, ^tHead)) matched := true;
								}
							}
						}
						if (!^running || ^matched
							|| (mizFrmSort(^fHead) != ikFrmPrivPred
								&& mizFrmSort(^tHead) != ikFrmPrivPred)) inner := false;
					});
					if (^running && !^matched) {
						sp = mizSpreadAtomicFormula(a, ^tHead, conclusion);
						tHead := sp.second;
						if (sp.first >= 0) mizNatUp(defs, sp.first);
						if (mizFrmSort(^tHead) == ikError) { ok := false; running := false; }
						else {
							d5 = mizDecompose(mizNewConj(^tHead, mizThesis(a)));
							tHead := d5.first;
							mizSetThesis(a, d5.second);
						}
					}
				}
				ii := ^ii + 1;
			});
			if (^running && !^matched) { ok := false; running := false; }
		});
		if (!^ok) mizNatDeleteAll(defs);
		Pair(^ok, defs);
	}
}

// ChangeBoundToDecl (3287)
mizChangeBoundToDecl(a : MizAnalyzer) -> MizWithin {
	mizMakeWithin(\__, t -> {
		switch (t) {
			MizVarTrm(srt, varNr, __, __): {
				if (srt == ikTrmBound) {
					if (varNr > 1) t.varNr ::= varNr - 1
					else { t.sort ::= ikTrmConstant; t.varNr ::= varNr + a.fixedBase; }
				}
				t;
			}
			default: t;
		}
	});
}

// SetTaken (3295)
mizSetTaken(a : MizAnalyzer) -> MizWithin {
	mizMakeWithin(\__, t -> {
		switch (t) {
			MizVarTrm(srt, varNr, __, __): {
				if (srt == ikTrmConstant && varNr == mizGVarNbr(a)) {
					t.sort ::= ikTrmLocus; t.varNr ::= 1;
				}
				t;
			}
			default: t;
		}
	});
}

// ChopVars (3311)
mizChopVars(a : MizAnalyzer, widenable : bool, conclusion : bool, pos : MizPos) -> MizNatFunc {
	env = a.env;
	lDefs = mizInitNatFunc(4);
	if (mizFrmSort(mizThesis(a)) == ikError) lDefs
	else {
		stop = ref false;
		kk = ref (a.fixedBase + 1);
		while(\ -> !^stop && ^kk <= mizGVarNbr(a), \ -> {
			// expand until the thesis is universal
			found = ref false;
			ii = ref 1;
			while(\ -> !^found && !^stop && ^ii <= MaxExpansionNbr, \ -> {
				mizSetThesis(a, mizSpreadLocPred(mizThesis(a)));
				if (mizFrmSort(mizThesis(a)) == ikFrmUniv) found := true
				else {
					sp = mizSpreadAtomicFormula(a, mizThesis(a), conclusion);
					mizSetThesis(a, sp.second);
					if (sp.first >= 0) mizNatUp(lDefs, sp.first);
					if (mizFrmSort(mizThesis(a)) == ikError) {
						mizAError(a, pos, 55);
						mizNatDeleteAll(lDefs);
						stop := true;
					}
				}
				ii := ^ii + 1;
			});
			if (!^found && !^stop) {
				mizAError(a, pos, 55);
				mizSetThesis(a, mizNewIncorFrm());
				mizNatDeleteAll(lDefs);
				stop := true;
			}
			if (!^stop) {
				mizWithinFrm(mizChangeBoundToDecl(a), mizThesis(a));
				a.fixedBase ::= a.fixedBase + 1;
				fv = mizFixedVarAt(a, ^kk);
				if (fv.typ.sort == ikError) {
					mizSetThesis(a, mizNewIncorFrm());
					mizNatDeleteAll(lDefs);
					stop := true;
				} else {
					th = mizThesis(a);
					switch (th) {
						MizUnivFrm(__, __, quantified, scope, __): {
							// the widenable / non-widenable branches only differ in
							// which comparison licenses the step; both keep the scope
							okStep = if (widenable)
								mizIsWiderThan(env, quantified, mizCopyTyp(fv.typ))
								else mizEqTyp(env, quantified, fv.typ);
							if (okStep) {
								mizSetThesis(a, scope);
							} else if (mizIsWiderThan(env, fv.typ, mizCopyTyp(quantified))
								&& mizEqualClusters(fv.typ, quantified, \x, y -> mizEqAttr(env, x, y))) {
								// re-qualify: `for x being T holds P` becomes
								// `x is T1 implies … implies P`
								lTh = ref mizCopyFrm(scope);
								lTyp = ref mizCopyTyp(quantified);
								loop = ref true;
								while(\ -> ^loop, \ -> {
									lTh := mizNewImpl(mizNewQualFrm(
										mizNewVarTrm(ikTrmConstant, ^kk), mizCopyTyp(^lTyp)), ^lTh);
									switch (mizWidening(env, ^lTyp)) {
										None(): loop := false;
										Some(w): {
											lTyp := w;
											if (mizEqRadices(env, w, fv.typ)) loop := false;
										}
									}
								});
								mizSetThesis(a, ^lTh);
								stop := true;
							} else {
								if (widenable) mizAError(a, pos, 57) else mizAErrImm(a, 56);
								mizSetThesis(a, mizNewIncorFrm());
								mizNatDeleteAll(lDefs);
								stop := true;
							}
						}
						default: {
							mizSetThesis(a, mizNewIncorFrm());
							stop := true;
						}
					}
				}
			}
			kk := ^kk + 1;
		});
		lDefs;
	}
}

// ChopConcl (3411) / ChopAssum (3428)
mizChopConcl(a : MizAnalyzer, form : MizFrm, pos : MizPos) -> MizNatFunc {
	p = mizChopped(a, form, true);
	if (!p.first) { mizSetThesis(a, mizNewIncorFrm()); mizAError(a, pos, 51); }
	p.second;
}

mizChopAssum(a : MizAnalyzer, form : MizFrm, pos : MizPos) -> MizNatFunc {
	mizSetThesis(a, mizNewNeg(mizThesis(a)));
	p = mizChopped(a, form, false);
	if (!p.first) { mizSetThesis(a, mizNewIncorFrm()); mizAError(a, pos, 52); }
	mizSetThesis(a, mizNewNeg(mizThesis(a)));
	p.second;
}

// ChangeFixedToBound (372) / xFormula (383)
mizChangeFixedToBound(a : MizAnalyzer) -> MizWithin {
	mizMakeWithin(\__, t -> {
		switch (t) {
			MizVarTrm(srt, varNr, __, __): {
				if (srt == ikTrmBound) t.varNr ::= varNr + (mizGVarNbr(a) - a.fixedBase)
				else if (srt == ikTrmConstant && varNr > a.fixedBase) {
					t.sort ::= ikTrmBound; t.varNr ::= varNr - a.fixedBase;
				}
				t;
			}
			default: t;
		}
	});
}

mizXFormula(a : MizAnalyzer, form0 : MizFrm) -> MizFrm {
	form = ref mizNewNeg(form0);
	bad = ref false;
	kk = ref mizGVarNbr(a);
	while(\ -> !^bad && ^kk >= a.fixedBase + 1, \ -> {
		lTyp = mizFixedVarAt(a, ^kk).typ;
		if (lTyp.sort == ikError) bad := true
		else form := mizNewUnivI(mizFixedVarAt(a, ^kk).ident, mizCopyTyp(lTyp), ^form);
		kk := ^kk - 1;
	});
	if (^bad) mizNewIncorFrm()
	else {
		mizWithinFrm(mizChangeFixedToBound(a), ^form);
		mizNewNeg(^form);
	}
}

// GetQualifiedList (396) / WriteQualified (449)
mizGetQualifiedList(a : MizAnalyzer, skelConstNr : int) -> void {
	a.fixedBase ::= mizGVarNbr(a);
	mizInWord(a.inf);
	while(\ -> a.inf.curKind == 81, \ -> {          // 'Q'
		lNbr = mizGVarNbr(a);
		cnt = a.inf.curNr;
		mizSetGVarNbr(a, lNbr + cnt);
		fori(1, cnt, \i -> {
			mizInWord(a.inf);                        // 'I'
			fv = mizFixedVarAt(a, lNbr + i);
			fv.ident ::= a.inf.curNr;
		});
		lTyp = mizReadType(a);
		fori(lNbr + 1, mizGVarNbr(a), \i -> {
			fv = mizFixedVarAt(a, i);
			fv.skelConstNr ::= skelConstNr;
			fv.typ ::= if (i == mizGVarNbr(a)) lTyp else mizCopyTyp(lTyp);
			fv.expandable ::= false;
		});
		mizInWord(a.inf);
	});
}

mizWriteQualified(a : MizAnalyzer) -> void {
	fori(a.fixedBase + 1, mizGVarNbr(a), \i -> {
		fv = mizFixedVarAt(a, i);
		mizVOutTypeWithId(a.out, fv.typ, fv.ident);
	});
}

// DisposeLevel (3445)
mizDisposeLevel(a : MizAnalyzer, f : MizLevelRec, mark : int) -> void {
	env = a.env;
	while(\ -> sizeVector(env.locPredDef) > f.locPredNbr,
		\ -> removeVector(env.locPredDef, sizeVector(env.locPredDef) - 1));
	while(\ -> sizeVector(env.locFuncDef) > f.locFuncNbr,
		\ -> removeVector(env.locFuncDef, sizeVector(env.locFuncDef) - 1));
	gg = a.gen.g;
	gg.locPredNbr ::= f.locPredNbr;
	gg.locFuncNbr ::= f.locFuncNbr;
	gg.varNbr ::= f.varNbr;
	gg.skelConstNbr ::= f.skelConstNbr;
	gg.demBase ::= f.demBase;
	gg.genCount ::= f.genCount;
	gg.lastEntry ::= f.lastEntry;
	gg.err ::= f.err;
	gg.thesis ::= f.thesis;
	e2 = a.env; e2.fixedVarNbr ::= f.varNbr;
	mizTTCollRelease(env, mark);
}

mizCopyLevel(g : MizLevelRec) -> MizLevelRec {
	MizLevelRec(g.locPredNbr, g.locFuncNbr, g.varNbr, g.skelConstNbr,
		g.demBase, g.genCount, g.lastEntry, g.err, g.thesis);
}

// ------------------------------------- Reasoning / Demonstration / Statement

// WriteThesis, the local of Reasoning (3476)
mizWriteThesis(a : MizAnalyzer, lDefs : MizNatFunc) -> void {
	mizVOutElStart0(a.out, "Thesis");
	mizVOutFormula(a.out, mizThesis(a));
	mizVOutNatFunc(a.out, "ThesisExpansions", lDefs);
	mizVOutElEnd(a.out, "Thesis");
}

// Reasoning (3466) — the skeleton items of a proof
mizAReasoning(a : MizAnalyzer) -> void {
	env = a.env;
	// Reasoning `exit`s on these three — that is a normal return to the caller,
	// not a stop (analyzer.pas 3649-3650)
	leave = ref false;
	while(\ -> !^leave && a.inf.curKind != ikMscEndBlock && a.stoppedAt == 0, \ -> {
		k = a.inf.curKind;
		if (k == ikItmGeneralization) {
			lPos = mizInPos(a.inf);
			mizVOutElStart(a.out, "Let");
			mizVOutIntAttr(a.out, "nr", mizGVarNbr(a) + 1);
			mizVOutAttrEnd(a.out);
			switch (mizThesis(a)) {
				MizFlexFrm(__, __, __, __, __, expansion, __): mizSetThesis(a, expansion);
				default: {}
			}
			mizGetQualifiedList(a, 0);
			gg = a.gen.g;
			fori(a.fixedBase + 1, mizGVarNbr(a), \i -> {
				gg.genCount ::= gg.genCount + 1;
				fv = mizFixedVarAt(a, i);
				fv.skelConstNr ::= gg.genCount;
			});
			mizWriteQualified(a);
			mizVOutElEnd(a.out, "Let");
			lDefs = mizChopVars(a, false, false, lPos);
			mizWriteThesis(a, lDefs);
		} else if (k == ikItmAssumption) {
			lPos = mizInPos(a.inf);
			mizVOutElStart0(a.out, "Assume");
			mizInWord(a.inf);
			conds = mizReadPropositions(a);
			mizVOutPropositions(a.out, conds);
			mizVOutElEnd(a.out, "Assume");
			mizInWord(a.inf);
			lFrm = mizConjugatePropositions(conds);
			lDefs = mizChopAssum(a, lFrm, lPos);
			mizWriteThesis(a, lDefs);
		} else if (k == ikItmExAssumption) {
			lVarBase = mizGVarNbr(a);
			lPos = mizInPos(a.inf);
			mizVOutElStart(a.out, "Given");
			mizVOutIntAttr(a.out, "nr", mizGVarNbr(a) + 1);
			mizVOutAttrEnd(a.out);
			mizGetQualifiedList(a, 0);
			conds = mizReadPropositions(a);
			mizInWord(a.inf);
			lFrm = mizXFormula(a, mizConjugatePropositions(conds));
			mizVOutPropos(a.out, 0, 0, a.eh.curPos, lFrm);
			lDefs = mizChopAssum(a, lFrm, lPos);
			mizWriteQualified(a);
			mizVOutPropositions(a.out, conds);
			mizVOutElEnd(a.out, "Given");
			fori(lVarBase + 1, mizGVarNbr(a), \i -> {
				fv = mizFixedVarAt(a, i); fv.skelConstNr ::= 0;
			});
			mizWriteThesis(a, lDefs);
		} else if (k == ikItmExemplifWithEq) {
			lPos = mizInPos(a.inf);
			mizVOutElStart(a.out, "TakeAsVar");
			mizVOutIntAttr(a.out, "nr", mizGVarNbr(a) + 1);
			mizVOutAttrEnd(a.out);
			mizInWord(a.inf);                      // 'I'
			lId = a.inf.curNr;
			lTrm = mizReadTerm(a);
			a.fixedBase ::= mizGVarNbr(a);
			mizSetGVarNbr(a, mizGVarNbr(a) + 1);
			mizAssert(2521, mizGVarNbr(a) <= MaxVarNbr);
			fv = mizFixedVarAt(a, mizGVarNbr(a));
			fv.expandable ::= false;
			fv.ident ::= lId;
			fv.typ ::= mizGetTrmType(env, lTrm);
			mizAStripFlexUnderNeg(a);
			mizSetThesis(a, mizNewNeg(mizThesis(a)));
			lDefs = mizChopVars(a, true, true, lPos);
			mizSetThesis(a, mizNewNeg(mizThesis(a)));
			mizVOutTypeWithId(a.out, fv.typ, fv.ident);
			mizVOutTerm(a.out, lTrm);
			mizVOutElEnd(a.out, "TakeAsVar");
			mizWriteThesis(a, lDefs);
			mizInWord(a.inf);
		} else if (k == ikItmSimpleExemplif) {
			lPos = mizInPos(a.inf);
			mizVOutElStart0(a.out, "Take");
			lTrm = mizReadTerm(a);
			mizVOutTerm(a.out, lTrm);
			mizVOutElEnd(a.out, "Take");
			a.fixedBase ::= mizGVarNbr(a);
			mizSetGVarNbr(a, mizGVarNbr(a) + 1);
			fv = mizFixedVarAt(a, mizGVarNbr(a));
			fv.ident ::= 0;
			fv.typ ::= mizGetTrmType(env, lTrm);
			fv.expandable ::= false;
			mizAStripFlexUnderNeg(a);
			mizSetThesis(a, mizNewNeg(mizThesis(a)));
			lDefs = mizChopVars(a, true, true, lPos);
			mizSetThesis(a, mizNewNeg(mizThesis(a)));
			mizWithinFrm(mizSetTaken(a), mizThesis(a));
			mizSetThesis(a, mizInstFrm(env, mizThesis(a), MizTrmElem(lTrm, MizTrmNil())));
			mizSetGVarNbr(a, mizGVarNbr(a) - 1);
			mizInWord(a.inf);
			mizWriteThesis(a, lDefs);
		} else if (k == ikItmConclusion) {
			lPos = mizInPos(a.inf);
			mizVOutElStart0(a.out, "Conclusion");
			mizInWord(a.inf);
			lFrm = if (a.inf.curKind == ikBlcHereby) mizAHereBy(a)
				else mizARegularStatement(a);
			if (a.stoppedAt == 0) {
				lDefs = mizChopConcl(a, lFrm, lPos);
				mizVOutElEnd(a.out, "Conclusion");
				mizWriteThesis(a, lDefs);
			}
		} else if (k == ikBlcPerCases || k == ikBlcCase || k == ikBlcSuppose) {
			leave := true;
		} else {
			mizAStatement(a);
		}
	});
}

// the two exemplification branches strip a flex expansion under a negation
mizAStripFlexUnderNeg(a : MizAnalyzer) -> void {
	switch (mizThesis(a)) {
		MizNegFrm(arg, __): switch (arg) {
			MizFlexFrm(__, __, __, __, __, expansion, __):
				mizSetThesis(a, mizNewNeg(expansion));
			default: {}
		}
		default: {}
	}
}

// Demonstration (3906)
mizADemonstration(a : MizAnalyzer, thesisId : int, labId : int, thesis : MizFrm) -> void {
	env = a.env;
	mizVOutPropos(a.out, thesisId, labId, a.eh.curPos, thesis);
	mizVOutElStart(a.out, "Proof");
	if (thesisId != 0) {
		mizVOutIntAttr(a.out, "nr", thesisId);
		mizVOutIntAttr(a.out, "vid", labId);
	}
	mizVOutPosAsAttrs(a.out, a.eh.curPos);
	mizVOutAttrEnd(a.out);
	mizVOutElStart0(a.out, "BlockThesis");
	mizVOutFormula(a.out, thesis);
	mizVOutElEnd(a.out, "BlockThesis");
	l = mizCopyLevel(a.gen.g);
	l.locPredNbr ::= sizeVector(env.locPredDef);
	l.locFuncNbr ::= sizeVector(env.locFuncDef);
	mark = mizTTCollMark(env);
	mizSetThesis(a, mizCopyFrm(thesis));
	mizAReasoning(a);
	if (a.stoppedAt == 0) {
		if (a.inf.curKind == ikBlcPerCases) {
			mizAPerCasesReasoning(a);
			if (a.stoppedAt == 0) { mizInPos(a.inf); mizInWord(a.inf); }
		} else {
			mizInPos(a.inf);
			mizInWord(a.inf);                // ikMscEndBlock
			th = mizThesis(a);
			if (mizFrmSort(th) != ikFrmVerum && mizFrmSort(th) != ikError) {
				d = mizDecompose(th);
				head = ref d.first;
				mizSetThesis(a, d.second);
				fin = ref false;
				ii = ref 1;
				while(\ -> !^fin && ^ii <= MaxExpansionNbr, \ -> {
					if (mizFrmSort(^head) == ikFrmVerum) fin := true
					else {
						sp = mizSpreadAtomicFormula(a, ^head, true);
						head := sp.second;
						if (mizFrmSort(^head) == ikError) fin := true
						else {
							d2 = mizDecompose(mizNewConj(^head, mizThesis(a)));
							head := d2.first;
							mizSetThesis(a, d2.second);
						}
					}
					ii := ^ii + 1;
				});
			}
		}
	}
	if (a.stoppedAt == 0) {
		mizVOutEndPos(a.out, a.eh.curPos);
		mizVOutElEnd(a.out, "Proof");
	}
	mizDisposeLevel(a, l, mark);
}

// RegularStatement (4492)
mizARegularStatement(a : MizAnalyzer) -> MizFrm {
	env = a.env;
	lLabelNr = a.inf.curNr;
	lLabId = mizInInt(a.inf);
	mizInPos(a.inf);
	mizInWord(a.inf);
	if (a.inf.curKind == ikBlcDiffuse) {
		mizInPos(a.inf);
		mizVOutElStart(a.out, "Now");
		if (lLabelNr != 0) {
			mizVOutIntAttr(a.out, "nr", lLabelNr);
			mizVOutIntAttr(a.out, "vid", lLabId);
		}
		mizVOutPosAsAttrs(a.out, a.eh.curPos);
		mizVOutAttrEnd(a.out);
		res = mizADiffuseStatement(a);
		mizInWord(a.inf);
		if (a.stoppedAt == 0) {
			mizVOutEndPos(a.out, a.eh.curPos);
			mizAOutBlockThesis(a, res);
			mizVOutElEnd(a.out, "Now");
		}
		res.first;
	} else {
		lFrm = mizReadSentence(a, false);
		mizInWord(a.inf);
		k = a.inf.curKind;
		if (k == 34) {                     // '"'
			inf = mizLoadInferenceObj(a);
			mizInWord(a.inf);
			if (a.inf.curKind == ikItmIterEquality) {
				mizAIterEquality(a, lLabelNr, lLabId, lFrm, inf);
			} else {
				mizVOutPropos(a.out, lLabelNr, lLabId, a.eh.curPos, lFrm);
				mizVOutInference(a.out, inf);
				lFrm;
			}
		} else if (k == ikBlcProof) {
			mizInPos(a.inf);
			mizInWord(a.inf);
			mizADemonstration(a, lLabelNr, lLabId, lFrm);
			lFrm;
		} else {
			mizVOutPropos(a.out, lLabelNr, lLabId, a.eh.curPos, lFrm);
			mizVOutEl1(a.out, "SkippedProof");
			lFrm;
		}
	}
}

// the iterative-equality branch of RegularStatement (4557)
mizAIterEquality(a : MizAnalyzer, labelNr : int, labId : int, lFrm : MizFrm,
		inf0 : MizInference) -> MizFrm {
	env = a.env;
	pr : ref Maybe<Pair<MizTrm, MizTrm>> = ref None();
	switch (lFrm) {
		MizPredFrm(srt, __, __, __): if (srt == ikFrmPred) {
			q = mizAdjustFrm(env, lFrm);
			if (q.first == mizBuiltIn(env.builtIn, rqEqualsTo)) {
				l = mizTrmListNth(q.second, 0);
				r = mizTrmListNth(q.second, 1);
				pr := Some(Pair(mizCopyTrm(l), mizCopyTrm(r)));
			}
		}
		default: {}
	}
	sides = switch (^pr) {
		Some(p): p;
		None(): {
			if (mizFrmSort(lFrm) != ikError) mizAErrImm(a, 159);
			Pair(mizNewIncorTrm(), mizNewIncorTrm());
		}
	};
	leftSide = sides.first;
	steps : Vector<MizIterStep> = makeVector(4);
	pushVector(steps, MizIterStep(inf0, sides.second));
	last = ref sides.second;
	go = ref true;
	while(\ -> ^go, \ -> {
		mizInPos(a.inf);
		lTrm = mizReadTerm(a);
		mizInWord(a.inf);
		inf = mizLoadInferenceObj(a);
		mizInWord(a.inf);
		pushVector(steps, MizIterStep(inf, lTrm));
		last := lTrm;
		if (a.inf.curKind != ikItmIterEquality) go := false;
	});
	mizVOutElStart(a.out, "IterEquality");
	if (labelNr != 0) {
		mizVOutIntAttr(a.out, "nr", labelNr);
		mizVOutIntAttr(a.out, "vid", labId);
	}
	mizVOutPosAsAttrs(a.out, a.eh.curPos);
	mizVOutAttrEnd(a.out);
	mizVOutTerm(a.out, leftSide);
	iterVector(steps, \st -> mizVOutIterStep(a.out, st));
	mizVOutElEnd(a.out, "IterEquality");
	mizNewEqFrm(env, leftSide, mizCopyTrm(^last));
}

// Statement (4651)
mizAStatement(a : MizAnalyzer) -> void {
	env = a.env;
	lVarBase = mizGVarNbr(a);
	k = a.inf.curKind;
	if (k == ikItmPrivConstant) {
		mizVOutElStart(a.out, "Set");
		mizVOutIntAttr(a.out, "nr", mizGVarNbr(a) + 1);
		mizVOutAttrEnd(a.out);
		mizInWord(a.inf);                    // 'I'
		lId = a.inf.curNr;
		lTrm = mizReadTerm(a);
		mizInWord(a.inf);
		mizSetGVarNbr(a, mizGVarNbr(a) + 1);
		mizAssert(2520, mizGVarNbr(a) <= MaxVarNbr);
		fv = mizFixedVarAt(a, mizGVarNbr(a));
		fv.ident ::= lId;
		fv.expandable ::= true;
		fv.def ::= Some(lTrm);
		fv.typ ::= mizCopyTrmType(env, lTrm);
		mizVOutTerm(a.out, lTrm);
		mizVOutTypeWithId(a.out, fv.typ, fv.ident);
		mizVOutElEnd(a.out, "Set");
	} else if (k == ikItmPrivFunc) {
		mark = mizTTCollMark(env);
		mizInWord(a.inf);
		lId = a.inf.curNr;
		mizVOutElStart(a.out, "DefFunc");
		lArgs = mizAnalizeArgTypeList(a);
		lTrm = mizReadTerm(a);
		lTyp0 = mizGetTrmType(env, lTrm);
		lTyp = if (lTyp0.sort == ikError) mizCopyTyp(a.anyTyp) else lTyp0;
		pushVector(env.locFuncDef, MizFuncDef(lId, lArgs, lTrm, lTyp));
		mizInWord(a.inf);
		mizVOutIntAttr(a.out, "nr", sizeVector(env.locFuncDef));
		mizVOutIntAttr(a.out, "vid", lId);
		mizVOutAttrEnd(a.out);
		mizVOutArgTypes(a.out, lArgs);
		mizVOutTerm(a.out, lTrm);
		mizVOutType(a.out, lTyp);
		mizVOutElEnd(a.out, "DefFunc");
		mizTTCollRelease(env, mark);
	} else if (k == ikItmPrivPred) {
		mark = mizTTCollMark(env);
		mizInWord(a.inf);
		lId = a.inf.curNr;
		mizVOutElStart(a.out, "DefPred");
		lArgs = mizAnalizeArgTypeList(a);
		mizASetBVN(a, 0);
		lFrm = mizReadSentence(a, false);
		mizInWord(a.inf);
		mizTTCollRelease(env, mark);
		pushVector(env.locPredDef, MizPredDef(lId, lArgs, lFrm));
		mizVOutIntAttr(a.out, "nr", sizeVector(env.locPredDef));
		mizVOutIntAttr(a.out, "vid", lId);
		mizVOutAttrEnd(a.out);
		mizVOutArgTypes(a.out, lArgs);
		mizVOutFormula(a.out, lFrm);
		mizVOutElEnd(a.out, "DefPred");
	} else if (k == ikItmReconsidering) {
		mizVOutElStart(a.out, "Reconsider");
		mizVOutIntAttr(a.out, "nr", mizGVarNbr(a) + 1);
		mizVOutAttrEnd(a.out);
		locBase = mizGVarNbr(a);
		mizInWord(a.inf);
		while(\ -> a.inf.curKind != 59, \ -> {
			mizSetGVarNbr(a, mizGVarNbr(a) + 1);
			mizAssert(2522, mizGVarNbr(a) <= MaxVarNbr);
			mizASetBVN(a, 0);
			mizInWord(a.inf);                  // 'I'
			fv = mizFixedVarAt(a, mizGVarNbr(a));
			fv.ident ::= a.inf.curNr;
			lTrm0 = mizAnalyzeTrm(a.gen, mizLoadTerm(a.inf));
			lTrm = switch (lTrm0) {
				MizQuaTrm(trmProper, __, __, __): trmProper;
				default: lTrm0;
			};
			fv.expandable ::= false;
			fv.def ::= Some(lTrm);
			mizInWord(a.inf);
		});
		mizInWord(a.inf);
		lTyp = mizReadType(a);
		fori(locBase + 1, mizGVarNbr(a), \i -> {
			fv = mizFixedVarAt(a, i);
			mizVOutTypeWithId(a.out, lTyp, fv.ident);
			switch (fv.def) { Some(d): mizVOutTerm(a.out, d); None(): {} }
		});
		fori(locBase + 1, mizGVarNbr(a), \i -> {
			fv = mizFixedVarAt(a, i); fv.typ ::= mizCopyTyp(lTyp);
		});
		lFrm = ref mizNewVerum();
		fori(locBase + 1, mizGVarNbr(a), \i -> {
			fv = mizFixedVarAt(a, i);
			switch (fv.def) {
				Some(d): lFrm := mizNewConj(^lFrm, mizNewQualFrm(d, mizCopyTyp(lTyp)));
				None(): {}
			}
		});
		mizAJustify(a, 0, 0, ^lFrm);
		mizVOutElEnd(a.out, "Reconsider");
	} else if (k == ikItmChoice) {
		mizVOutElStart(a.out, "Consider");
		mizVOutIntAttr(a.out, "nr", mizGVarNbr(a) + 1);
		mizVOutAttrEnd(a.out);
		mizGetQualifiedList(a, 0);
		conds = mizReadPropositions(a);
		lFrm = mizXFormula(a, mizConjugatePropositions(conds));
		mizAJustify(a, 0, 0, lFrm);
		mizWriteQualified(a);
		mizVOutPropositions(a.out, conds);
		mizVOutElEnd(a.out, "Consider");
	} else if (k == 69) {                   // 'E' — a labelled regular statement
		mizARegularStatement(a) |> \__ -> {};
	} else {
		mizRunTimeError(2070);
	}
	fori(lVarBase + 1, mizGVarNbr(a), \i -> {
		fv = mizFixedVarAt(a, i); fv.skelConstNr ::= 0;
	});
}

// ============ the DIFFUSE (`now`) family (analyzer.pas 3974-4453) ==========

// CheckLocConst (911): a constant of THIS block that is not a skeleton
// constant may not escape into a diffuse statement's result
mizCheckLocConst(a : MizAnalyzer) -> MizWithin {
	mizMakeWithin(\__, t -> {
		switch (t) {
			MizVarTrm(srt, varNr, __, __): {
				if (srt == ikTrmConstant && varNr > a.gen.g.demBase
					&& mizFixedVarAt(a, varNr).skelConstNr == 0) a.constErr ::= true;
				t;
			}
			default: t;
		}
	});
}

// ChangeDeclConstToBound (3974)
mizChangeDeclConstToBound(a : MizAnalyzer) -> MizWithin {
	mizMakeWithin(\__, t -> {
		switch (t) {
			MizVarTrm(srt, varNr, __, __): {
				if (srt == ikTrmLocus) t.sort ::= ikTrmBound
				else if (srt == ikTrmBound) t.varNr ::= varNr + a.gen.g.genCount
				else if (srt == ikTrmConstant) {
					if (varNr > a.gen.g.demBase && mizFixedVarAt(a, varNr).skelConstNr != 0) {
						t.varNr ::= mizFixedVarAt(a, varNr).skelConstNr;
						t.sort ::= ikTrmBound;
					}
				}
				t;
			}
			MizBaseTrm(srt, __):
				if (srt == ikTrmIt) mizNewVarTrm(ikTrmBound, a.gen.g.genCount) else t;
			default: t;
		}
	});
}

// SkelList (3991)
mizSkelList(a : MizAnalyzer, form : int, frst : int) -> void {
	gg = a.gen.g;
	skList : Vector<MizTyp> = makeVector(4);
	skOrig : Vector<MizTyp> = makeVector(4);
	skIdents = mizInitIntSeq(4);
	bad = ref false;
	fori(frst + 1, mizGVarNbr(a), \k -> {
		if (!^bad) {
			lTyp0 = mizCopyTyp(mizFixedVarAt(a, k).typ);
			a.constErr ::= false;
			mizWithinTyp(mizCheckLocConst(a), lTyp0);
			lTyp = if (a.constErr) { mizAErrImm(a, 50); mizNewIncorTyp() } else lTyp0;
			if (lTyp.sort == ikError) { gg.err ::= true; bad := true; }
			else {
				pushVector(skOrig, mizCopyTyp(lTyp));
				mizWithinTyp(mizChangeDeclConstToBound(a), lTyp);
				pushVector(skList, lTyp);
				mizSeqInsert(skIdents, mizFixedVarAt(a, k).ident);
				{}
			}
		}
	});
	if (!^bad)
		gg.lastEntry ::= Some(MizRsnConst(gg.lastEntry, form, skList, skIdents,
			skOrig, frst));
}

// SkelSnt (4016)
mizSkelSnt(a : MizAnalyzer, form : int, f : MizFrm) -> void {
	gg = a.gen.g;
	a.constErr ::= false;
	mizWithinFrm(mizCheckLocConst(a), f);
	if (a.constErr) { mizAErrImm(a, 68); gg.err ::= true; }
	else if (mizFrmSort(f) == ikError) gg.err ::= true
	else {
		dSnt = mizCopyFrm(f);
		mizWithinFrm(mizChangeDeclConstToBound(a), f);
		gg.lastEntry ::= Some(MizRsnSnt(gg.lastEntry, form, f, dSnt));
	}
}

// NewUnivList (4161)
mizNewUnivList(fl : Vector<MizTyp>, ids : MizIntSeq, f0 : MizFrm) -> MizFrm {
	if (mizFrmSort(f0) == ikError) mizNewIncorFrm()
	else {
		f = ref f0;
		k = ref (sizeVector(fl) - 1);
		while(\ -> ^k >= 0, \ -> {
			f := mizNewUnivI(mizSeqValue(ids, ^k), mizCopyTyp(getVectorUnsafe(fl, ^k)), ^f);
			k := ^k - 1;
		});
		^f;
	}
}

// ChangeSkFixedToBound (4171)
mizChangeSkFixedToBound(a : MizAnalyzer) -> MizWithin {
	mizMakeWithin(\__, t -> {
		switch (t) {
			MizVarTrm(srt, varNr, __, __): {
				if (srt == ikTrmBound) t.varNr ::= varNr + a.skListCount
				else if (srt == ikTrmConstant && varNr > a.skFrstConstNr) {
					t.sort ::= ikTrmBound;
					t.varNr ::= varNr - a.skFrstConstNr;
				}
				t;
			}
			default: t;
		}
	});
}

// NewUnivList1 (4183) — fixes the local constants one level at a time
mizNewUnivList1(a : MizAnalyzer, fl : Vector<MizTyp>, ids : MizIntSeq,
		f0 : MizFrm, frstConstNr : int) -> MizFrm {
	if (mizFrmSort(f0) == ikError) mizNewIncorFrm()
	else {
		a.skFrstConstNr ::= frstConstNr;
		a.skListCount ::= sizeVector(fl);
		mizWithinFrm(mizChangeSkFixedToBound(a), f0);
		f = ref f0;
		k = ref (sizeVector(fl) - 1);
		while(\ -> ^k >= 0, \ -> {
			a.skListCount ::= a.skListCount - 1;
			lTyp = mizCopyTyp(getVectorUnsafe(fl, ^k));
			mizWithinTyp(mizChangeSkFixedToBound(a), lTyp);
			f := mizNewUnivI(mizSeqValue(ids, ^k), lTyp, ^f);
			k := ^k - 1;
		});
		^f;
	}
}

// ReasResult (4202) — unwind the skeleton chain into the block's result, and
// the sub-results the block thesis reports in reverse
mizReasResult(a : MizAnalyzer, f0 : MizFrm) -> Pair<MizFrm, Vector<MizFrm>> {
	gg = a.gen.g;
	subResults : Vector<MizFrm> = makeVector(4);
	if (gg.err) Pair(mizNewIncorFrm(), subResults)
	else {
		fFrm = ref f0;
		lFrm = ref mizCopyFrm(f0);
		while(\ -> isSome(gg.lastEntry), \ -> {
			pushVector(subResults, mizCopyFrm(^lFrm));
			switch (gg.lastEntry) {
				None(): {}
				Some(e): {
					switch (e) {
						MizRsnSnt(prev, form, skSnt, dSnt): {
							if (form == 65) {          // 'A'
								fFrm := mizNewImpl(skSnt, ^fFrm);
								lFrm := mizNewImpl(dSnt, ^lFrm);
							} else if (form == 66) {   // 'B'
								fFrm := mizNewConj(skSnt, ^fFrm);
								lFrm := mizNewConj(dSnt, ^lFrm);
							} else mizRunTimeError(2008);
							gg.lastEntry ::= prev;
						}
						MizRsnConst(prev, form, skList, skIdents, skOrigTyps, skFrstConstNr): {
							if (form == 67) {          // 'C'
								fFrm := mizNewNeg(mizNewUnivList(skList, skIdents,
									mizNewNeg(^fFrm)));
								lFrm := mizNewNeg(mizNewUnivList1(a, skOrigTyps, skIdents,
									mizNewNeg(^lFrm), skFrstConstNr));
							} else if (form == 68) {   // 'D'
								fFrm := mizNewUnivList(skList, skIdents, ^fFrm);
								lFrm := mizNewUnivList1(a, skOrigTyps, skIdents, ^lFrm,
									skFrstConstNr);
							} else mizRunTimeError(2008);
							gg.lastEntry ::= prev;
						}
					}
				}
			}
		});
		Pair(^fFrm, subResults);
	}
}

// DiffReasoning (4032)
mizADiffReasoning(a : MizAnalyzer) -> void {
	env = a.env;
	leave = ref false;
	while(\ -> !^leave && a.inf.curKind != ikMscEndBlock && a.stoppedAt == 0, \ -> {
		k = a.inf.curKind;
		gg = a.gen.g;
		if (k == ikItmGeneralization) {
			mizInPos(a.inf);
			mizVOutElStart(a.out, "Let");
			mizVOutIntAttr(a.out, "nr", mizGVarNbr(a) + 1);
			mizVOutAttrEnd(a.out);
			mizGetQualifiedList(a, 0);
			fori(a.fixedBase + 1, mizGVarNbr(a), \i -> {
				gg.genCount ::= gg.genCount + 1;
				fv = mizFixedVarAt(a, i);
				fv.skelConstNr ::= gg.genCount;
			});
			mizWriteQualified(a);
			mizVOutElEnd(a.out, "Let");
			mizSkelList(a, 68, a.fixedBase);          // 'D'
		} else if (k == ikItmAssumption) {
			mizInPos(a.inf);
			mizVOutElStart0(a.out, "Assume");
			mizInWord(a.inf);
			conds = mizReadPropositions(a);
			mizVOutPropositions(a.out, conds);
			mizVOutElEnd(a.out, "Assume");
			mizInWord(a.inf);
			mizSkelSnt(a, 65, mizConjugatePropositions(conds));   // 'A'
		} else if (k == ikItmExAssumption) {
			lVarBase = mizGVarNbr(a);
			mizInPos(a.inf);
			mizVOutElStart(a.out, "Given");
			mizVOutIntAttr(a.out, "nr", mizGVarNbr(a) + 1);
			mizVOutAttrEnd(a.out);
			mizGetQualifiedList(a, 0);
			conds = mizReadPropositions(a);
			mizInWord(a.inf);
			lFrm = mizXFormula(a, mizConjugatePropositions(conds));
			mizVOutPropos(a.out, 0, 0, a.eh.curPos, lFrm);
			mizSkelSnt(a, 65, lFrm);
			mizWriteQualified(a);
			mizVOutPropositions(a.out, conds);
			mizVOutElEnd(a.out, "Given");
			fori(lVarBase + 1, mizGVarNbr(a), \i -> {
				fv = mizFixedVarAt(a, i); fv.skelConstNr ::= 0;
			});
		} else if (k == ikItmExemplifWithEq) {
			mizVOutElStart(a.out, "TakeAsVar");
			mizVOutIntAttr(a.out, "nr", mizGVarNbr(a) + 1);
			mizVOutAttrEnd(a.out);
			mizInPos(a.inf);
			mizInWord(a.inf);                       // 'I'
			lId = a.inf.curNr;
			lTrm = mizReadTerm(a);
			mizSetGVarNbr(a, mizGVarNbr(a) + 1);
			mizAssert(2521, mizGVarNbr(a) <= MaxVarNbr);
			fv = mizFixedVarAt(a, mizGVarNbr(a));
			fv.expandable ::= false;
			fv.ident ::= lId;
			fv.typ ::= mizGetTrmType(env, lTrm);
			mizVOutTypeWithId(a.out, fv.typ, fv.ident);
			mizVOutTerm(a.out, lTrm);
			mizVOutElEnd(a.out, "TakeAsVar");
			gg.genCount ::= gg.genCount + 1;
			fv.skelConstNr ::= gg.genCount;
			mizSkelList(a, 67, mizGVarNbr(a) - 1);   // 'C'
			mizInWord(a.inf);
		} else if (k == ikItmSimpleExemplif) {
			mizInPos(a.inf);
			mizAErrImm(a, 64);
			gg.err ::= true;
			mizReadTerm(a) |> \__ -> {};
			mizInWord(a.inf);
		} else if (k == ikItmConclusion) {
			mizInPos(a.inf);
			mizVOutElStart0(a.out, "Conclusion");
			mizInWord(a.inf);
			lFrm = if (a.inf.curKind == ikBlcHereby) mizAHereBy(a)
				else mizARegularStatement(a);
			mizVOutElEnd(a.out, "Conclusion");
			if (a.stoppedAt == 0) mizSkelSnt(a, 66, lFrm);       // 'B'
		} else if (k == ikBlcPerCases || k == ikBlcCase || k == ikBlcSuppose) {
			leave := true;
		} else {
			mizAStatement(a);
		}
	});
}

// DiffuseStatement (4403)
mizADiffuseStatement(a : MizAnalyzer) -> Pair<MizFrm, Vector<MizFrm>> {
	env = a.env;
	l = mizCopyLevel(a.gen.g);
	l.locPredNbr ::= sizeVector(env.locPredDef);
	l.locFuncNbr ::= sizeVector(env.locFuncDef);
	mark = mizTTCollMark(env);
	gg = a.gen.g;
	gg.lastEntry ::= None();
	gg.err ::= false;
	gg.genCount ::= 0;
	gg.demBase ::= mizGVarNbr(a);
	mizInWord(a.inf);
	mizADiffReasoning(a);
	lResult = if (a.inf.curKind == ikBlcPerCases) mizADiffPerCasesReasoning(a)
		else mizNewVerum();
	res = mizReasResult(a, lResult);
	mizDisposeLevel(a, l, mark);
	mizInPos(a.inf);
	res;
}

// the BlockThesis of a `now` block: the sub-results in REVERSE, then the result
mizAOutBlockThesis(a : MizAnalyzer, res : Pair<MizFrm, Vector<MizFrm>>) -> void {
	mizVOutElStart0(a.out, "BlockThesis");
	z = ref (sizeVector(res.second) - 1);
	while(\ -> ^z >= 0, \ -> {
		mizVOutElStart0(a.out, "Thesis");
		mizVOutFormula(a.out, getVectorUnsafe(res.second, ^z));
		mizVOutNatFunc(a.out, "ThesisExpansions", mizInitNatFunc(1));
		mizVOutElEnd(a.out, "Thesis");
		z := ^z - 1;
	});
	mizVOutFormula(a.out, res.first);
	mizVOutElEnd(a.out, "BlockThesis");
}

// HereBy (4426)
mizAHereBy(a : MizAnalyzer) -> MizFrm {
	mizInPos(a.inf);
	mizVOutElStart(a.out, "Now");
	mizVOutPosAsAttrs(a.out, a.eh.curPos);
	mizVOutAttrEnd(a.out);
	res = mizADiffuseStatement(a);
	mizInWord(a.inf);
	if (a.stoppedAt == 0) {
		mizVOutEndPos(a.out, a.eh.curPos);
		mizAOutBlockThesis(a, res);
		mizVOutElEnd(a.out, "Now");
	}
	res.first;
}

// ============ the PER-CASES families (3702 and 4238) ======================

// PerCasesReasoning (3702) — inside a proof, where the thesis is known
mizAPerCasesReasoning(a : MizAnalyzer) -> void {
	env = a.env;
	mizInPos(a.inf);
	mizVOutElStart(a.out, "PerCasesReasoning");
	mizVOutPosAsAttrs(a.out, a.eh.curPos);
	mizVOutAttrEnd(a.out);
	mizVOutElStart0(a.out, "BlockThesis");
	mizVOutFormula(a.out, mizThesis(a));
	mizVOutElEnd(a.out, "BlockThesis");
	mizInWord(a.inf);
	lInference = mizLoadInferenceObj(a);
	mizInWord(a.inf);
	perCasesFrm = ref mizNewNeg(mizNewVerum());
	c = mizCopyLevel(a.gen.g);
	c.locPredNbr ::= sizeVector(env.locPredDef);
	c.locFuncNbr ::= sizeVector(env.locFuncDef);
	lThesis = ref mizCopyFrm(mizThesis(a));
	perCasesDefs = ref mizInitNatFunc(4);
	perCasesDefsOk = ref true;
	itisCase = ref false;
	while(\ -> a.inf.curKind != ikMscEndBlock && a.stoppedAt == 0, \ -> {
		k = a.inf.curKind;
		mark = ref 0;
		casePos = ref a.eh.curPos;
		if (k == ikBlcCase) {
			itisCase := true;
			casePos := mizInPos(a.inf);
			mizVOutElStart(a.out, "CaseBlock");
			mizVOutPosAsAttrs(a.out, ^casePos);
			mizVOutAttrEnd(a.out);
			mark := mizTTCollMark(env);
			mizInWord(a.inf);
			conds = mizReadPropositions(a);
			mizInWord(a.inf);
			lFrm0 = mizConjugatePropositions(conds);
			perCasesFrm := mizNewDisj(^perCasesFrm, mizCopyFrm(lFrm0));
			if (mizFrmSort(lFrm0) == ikError) lThesis := mizNewIncorFrm();
			firstDisjunct = ref mizNewIncorFrm();
			if (mizFrmSort(^lThesis) == ikError) {
				mizSetThesis(a, mizNewIncorFrm());
			} else {
				d = mizDecompose(mizNewNeg(^lThesis));
				firstDisjunct := mizNewNeg(d.first);
				lThesis := mizNewNeg(d.second);
				mizSetThesis(a, mizCopyFrm(^firstDisjunct));
				// spread the first disjunct until the case guard chops
				chopping = ref true;
				while(\ -> ^chopping, \ -> {
					p = mizChopped(a, mizCopyFrm(lFrm0), true);
					if (p.first) {
						if (^perCasesDefsOk) mizNatJoin(^perCasesDefs, p.second);
						chopping := false;
					} else {
						sp = mizSpreadAtomicFormula(a, ^firstDisjunct, true);
						firstDisjunct := sp.second;
						if (sp.first >= 0 && ^perCasesDefsOk) mizNatUp(^perCasesDefs, sp.first);
						if (mizFrmSort(^firstDisjunct) == ikError) {
							mizAError(a, ^casePos, 53);
							mizSetThesis(a, mizNewIncorFrm());
							lThesis := mizNewIncorFrm();
							perCasesDefsOk := false;
							chopping := false;
						} else {
							d2 = mizDecompose(mizNewNeg(^firstDisjunct));
							firstDisjunct := mizNewNeg(d2.first);
							lThesis := mizNewDisj(mizNewNeg(d2.second), ^lThesis);
							mizSetThesis(a, mizCopyFrm(^firstDisjunct));
						}
					}
				});
			}
			lFrm = mizNewImpl(lFrm0, mizCopyFrm(mizThesis(a)));
			mizVOutElStart0(a.out, "BlockThesis");
			mizVOutFormula(a.out, lFrm);
			mizVOutElEnd(a.out, "BlockThesis");
			mizVOutElStart0(a.out, "Case");
			mizVOutPropositions(a.out, conds);
			mizVOutElEnd(a.out, "Case");
			mizVOutElStart0(a.out, "Thesis");
			mizVOutFormula(a.out, mizThesis(a));
			mizVOutNatFunc(a.out, "ThesisExpansions", mizInitNatFunc(1));
			mizVOutElEnd(a.out, "Thesis");
		} else if (k == ikBlcSuppose) {
			itisCase := false;
			casePos := mizInPos(a.inf);
			mizVOutElStart(a.out, "SupposeBlock");
			mizVOutPosAsAttrs(a.out, ^casePos);
			mizVOutAttrEnd(a.out);
			lThesis := switch (c.thesis) { Some(t): mizCopyFrm(t); None(): mizNewIncorFrm(); };
			mark := mizTTCollMark(env);
			mizInWord(a.inf);
			conds = mizReadPropositions(a);
			mizInWord(a.inf);
			lFrm0 = mizConjugatePropositions(conds);
			llThesis = mizNewImpl(mizCopyFrm(lFrm0), mizCopyFrm(^lThesis));
			mizVOutElStart0(a.out, "BlockThesis");
			mizVOutFormula(a.out, llThesis);
			mizVOutElEnd(a.out, "BlockThesis");
			mizVOutElStart0(a.out, "Suppose");
			mizVOutPropositions(a.out, conds);
			mizVOutElEnd(a.out, "Suppose");
			mizVOutElStart0(a.out, "Thesis");
			mizVOutFormula(a.out, ^lThesis);
			mizVOutNatFunc(a.out, "ThesisExpansions", mizInitNatFunc(1));
			mizVOutElEnd(a.out, "Thesis");
			perCasesFrm := mizNewDisj(^perCasesFrm, lFrm0);
			mizSetThesis(a, ^lThesis);
			lThesis := mizCopyFrm(^lThesis);
		} else {
			mizRunTimeError(2641);
		}
		if (a.stoppedAt == 0) {
			mizAReasoning(a);
			if (a.inf.curKind == ikBlcPerCases) mizAPerCasesReasoning(a)
			else if (mizFrmSort(mizThesis(a)) != ikFrmVerum
				&& mizFrmSort(mizThesis(a)) != ikError) mizAError(a, ^casePos, 60);
			if (a.stoppedAt == 0) {
				mizAssert(2310, a.inf.curKind == ikMscEndBlock);
				mizInPos(a.inf);
				mizInWord(a.inf);
				mizVOutEndPos(a.out, a.eh.curPos);
				mizVOutElEnd(a.out, if (^itisCase) "CaseBlock" else "SupposeBlock");
				mizDisposeLevel(a, c, ^mark);
			}
		}
	});
	if (a.stoppedAt == 0) {
		mizVOutElStart0(a.out, "PerCases");
		mizVOutPropos(a.out, 0, 0, a.eh.curPos, ^perCasesFrm);
		mizVOutInference(a.out, lInference);
		mizVOutElEnd(a.out, "PerCases");
		mizVOutElStart0(a.out, "Thesis");
		mizVOutFormula(a.out, ^lThesis);
		mizVOutNatFunc(a.out, "ThesisExpansions",
			if (^perCasesDefsOk) ^perCasesDefs else mizInitNatFunc(1));
		mizVOutElEnd(a.out, "Thesis");
		mizVOutEndPos(a.out, a.eh.curPos);
		mizVOutElEnd(a.out, "PerCasesReasoning");
		if (^itisCase && mizFrmSort(^lThesis) != ikError) {
			ok = switch (^lThesis) {
				MizNegFrm(arg, __): mizFrmSort(arg) == ikFrmVerum;
				default: false;
			};
			if (!ok) mizAErrImm(a, 54);
		}
	}
}

// DiffPerCasesReasoning (4238) — inside a `now` block, where it is not
mizADiffPerCasesReasoning(a : MizAnalyzer) -> MizFrm {
	env = a.env;
	mizInPos(a.inf);
	mizVOutElStart(a.out, "PerCasesReasoning");
	mizVOutPosAsAttrs(a.out, a.eh.curPos);
	mizVOutAttrEnd(a.out);
	mizInWord(a.inf);
	lInference = mizLoadInferenceObj(a);
	mizInWord(a.inf);
	lPerCases = ref mizNewNeg(mizNewVerum());
	c = mizCopyLevel(a.gen.g);
	c.locPredNbr ::= sizeVector(env.locPredDef);
	c.locFuncNbr ::= sizeVector(env.locFuncDef);
	lResult : ref Maybe<MizFrm> = ref None();
	isCase = a.inf.curKind == ikBlcCase;
	if (!isCase && a.inf.curKind != ikBlcSuppose) mizRunTimeError(2493);
	if (isCase) lResult := Some(mizNewNeg(mizNewVerum()));
	mark = mizTTCollMark(env);
	go = ref true;
	while(\ -> ^go && a.stoppedAt == 0, \ -> {
		casePos = mizInPos(a.inf);
		mizVOutElStart(a.out, if (isCase) "CaseBlock" else "SupposeBlock");
		mizVOutPosAsAttrs(a.out, casePos);
		mizVOutAttrEnd(a.out);
		mizInWord(a.inf);
		conds = mizReadPropositions(a);
		mizVOutElStart0(a.out, if (isCase) "Case" else "Suppose");
		mizVOutPropositions(a.out, conds);
		mizVOutElEnd(a.out, if (isCase) "Case" else "Suppose");
		mizInWord(a.inf);
		lGuard = mizConjugatePropositions(conds);
		lPerCases := mizNewDisj(^lPerCases, mizCopyFrm(lGuard));
		gg = a.gen.g;
		gg.err ::= false;
		gg.lastEntry ::= None();
		if (isCase) mizSkelSnt(a, 66, mizCopyFrm(lGuard));      // 'B'
		mizADiffReasoning(a);
		rr = mizReasResult(a, mizNewVerum());
		lFrm = ref rr.first;
		subResults = rr.second;
		if (a.inf.curKind == ikBlcPerCases) {
			inner = mizADiffPerCasesReasoning(a);
			if (mizFrmSort(inner) == ikError) c.err ::= true
			else lFrm := mizNewConj(^lFrm, inner);
		}
		if (a.stoppedAt == 0) {
			mizInPos(a.inf);
			mizInWord(a.inf);
			llThesis = mizNewImpl(lGuard, mizCopyFrm(^lFrm));
			mizVOutEndPos(a.out, a.eh.curPos);
			mizVOutElStart0(a.out, "BlockThesis");
			// a suppose block reports its own result as the LAST sub-thesis
			if (!isCase) pushVector(subResults, ^lFrm);
			z = ref (sizeVector(subResults) - 1);
			while(\ -> ^z >= 0, \ -> {
				mizVOutElStart0(a.out, "Thesis");
				mizVOutFormula(a.out, getVectorUnsafe(subResults, ^z));
				mizVOutNatFunc(a.out, "ThesisExpansions", mizInitNatFunc(1));
				mizVOutElEnd(a.out, "Thesis");
				z := ^z - 1;
			});
			mizVOutFormula(a.out, llThesis);
			mizVOutElEnd(a.out, "BlockThesis");
			mizVOutElEnd(a.out, if (isCase) "CaseBlock" else "SupposeBlock");
			if (mizFrmSort(^lFrm) == ikError) c.err ::= true;
			if (isCase) {
				if (mizFrmSort(^lFrm) != ikError)
					lResult := Some(mizNewDisj(either(^lResult, mizNewIncorFrm()), ^lFrm));
			} else {
				switch (^lResult) {
					None(): lResult := Some(^lFrm);
					Some(prev): if (!mizEqFrm(env, prev, ^lFrm)) mizAErrImm(a, 59);
				}
			}
			mizDisposeLevel(a, c, mark);
			if (a.inf.curKind != (if (isCase) ikBlcCase else ikBlcSuppose)) go := false;
		}
	});
	if (a.stoppedAt == 0) {
		mizVOutElStart0(a.out, "PerCases");
		mizVOutPropos(a.out, 0, 0, a.eh.curPos, ^lPerCases);
		mizVOutInference(a.out, lInference);
		mizVOutElEnd(a.out, "PerCases");
		mizVOutEndPos(a.out, a.eh.curPos);
		mizVOutElStart0(a.out, "BlockThesis");
		mizVOutFormula(a.out, either(^lResult, mizNewIncorFrm()));
		mizVOutElEnd(a.out, "BlockThesis");
		mizVOutElEnd(a.out, "PerCasesReasoning");
	}
	either(^lResult, mizNewIncorFrm());
}

// ==================== SchemeBody (226) and Scheme (6476) ==================

mizASchemeBody(a : MizAnalyzer) -> void {
	env = a.env;
	gen = a.gen;
	mizInWord(a.inf);
	lSchId = mizInInt(a.inf);
	mizVOutElStart(a.out, "SchemeBlock");
	mizVOutPosAsAttrs(a.out, a.eh.curPos);
	mizVOutIntAttr(a.out, "schemenr", a.inf.curNr);
	mizVOutIntAttr(a.out, "vid", lSchId);
	mizVOutAttrEnd(a.out);
	mizInPos(a.inf);
	mizInWord(a.inf);
	a.schPredNbr ::= 0;
	a.curSchFuncNbr ::= 0;
	clearVector(env.curSchFuncTyp);
	while(\ -> a.inf.curKind != 59, \ -> {
		k = a.inf.curKind;
		if (k == ikTrmSchFunc) {
			lSchVarNbr = ref 0;
			while(\ -> a.inf.curKind != 59, \ -> {
				lSchVarNbr := ^lSchVarNbr + 1;
				ar = mizGenArity(gen.schFuncArity, a.curSchFuncNbr + ^lSchVarNbr);
				ar.id ::= a.inf.curNr;
				mizInWord(a.inf);
			});
			mizAssert(2616, a.curSchFuncNbr + ^lSchVarNbr <= MaxFuncVarNbr);
			lTypList = mizAnalizeArgTypeList(a);
			mizInWord(a.inf);
			lTyp = mizReadType(a);
			fori(1, ^lSchVarNbr, \kk -> {
				ar = mizGenArity(gen.schFuncArity, a.curSchFuncNbr + kk);
				clearVector(ar.arity);
				iterVector(lTypList, \t -> pushVector(ar.arity, mizCopyTyp(t)));
				mizVOutElStart(a.out, "SchemeFuncDecl");
				mizVOutIntAttr(a.out, "nr", a.curSchFuncNbr + kk);
				mizVOutIntAttr(a.out, "vid", ar.id);
				mizVOutAttrEnd(a.out);
				mizVOutArgTypes(a.out, lTypList);
				mizVOutType(a.out, lTyp);
				mizVOutElEnd(a.out, "SchemeFuncDecl");
				pushVector(env.curSchFuncTyp, mizCopyTyp(lTyp));
			});
			a.curSchFuncNbr ::= a.curSchFuncNbr + ^lSchVarNbr;
			mizInWord(a.inf);
		} else if (k == ikFrmSchPred) {
			lSchVarNbr = ref 0;
			while(\ -> a.inf.curKind != 59, \ -> {
				lSchVarNbr := ^lSchVarNbr + 1;
				ar = mizGenArity(gen.schPredArity, a.schPredNbr + ^lSchVarNbr);
				ar.id ::= a.inf.curNr;
				mizInWord(a.inf);
			});
			mizAssert(2517, a.schPredNbr + ^lSchVarNbr <= MaxPredVarNbr);
			lTypList = mizAnalizeArgTypeList(a);
			fori(1, ^lSchVarNbr, \kk -> {
				ar = mizGenArity(gen.schPredArity, a.schPredNbr + kk);
				mizVOutElStart(a.out, "SchemePredDecl");
				mizVOutIntAttr(a.out, "nr", a.schPredNbr + kk);
				mizVOutIntAttr(a.out, "vid", ar.id);
				mizVOutAttrEnd(a.out);
				mizVOutArgTypes(a.out, lTypList);
				mizVOutElEnd(a.out, "SchemePredDecl");
				clearVector(ar.arity);
				iterVector(lTypList, \t -> pushVector(ar.arity, mizCopyTyp(t)));
			});
			a.schPredNbr ::= a.schPredNbr + ^lSchVarNbr;
			mizInWord(a.inf);
		} else {
			mizRunTimeError(2064);
		}
	});
	mizInWord(a.inf);
	a.schemeThesis ::= mizReadSentence(a, false);
	mizInWord(a.inf);
	conds = mizReadPropositions(a);
	mizVOutElStart0(a.out, "SchemePremises");
	mizVOutPropositions(a.out, conds);
	mizVOutElEnd(a.out, "SchemePremises");
}

// Scheme (6476)
mizAScheme(a : MizAnalyzer) -> void {
	env = a.env;
	mizInPos(a.inf);
	mark = mizTTCollMark(env);
	gn = a.gen;
	gn.exportableItem ::= true;
	gn.constInExportableItemOcc ::= false;
	mizASchemeBody(a);
	gn.exportableItem ::= false;
	gn.constInExportableItemOcc ::= false;
	mizInWord(a.inf);
	mizADemonstration(a, 0, 0, a.schemeThesis);
	if (a.stoppedAt == 0) {
		mizVOutEndPos(a.out, a.eh.curPos);
		mizVOutElEnd(a.out, "SchemeBlock");
	}
	mizTTCollRelease(env, mark);
}

// ============ the DEFINITION block (analyzer.pas 458-2710, 5735) ===========

// ChangeBoundAndIt (494) / …It1 (790) / …It2 (811): `it` becomes a bound
// variable and the existing bound variables shift out of its way
mizChangeBoundAndItN(itNr : int, inc0 : int) -> MizWithin {
	mizMakeWithin(\__, t -> {
		switch (t) {
			MizBaseTrm(srt, __):
				if (srt == ikTrmIt) mizNewVarTrm(ikTrmBound, itNr) else t;
			MizVarTrm(srt, varNr, __, __): {
				if (srt == ikTrmBound) t.varNr ::= varNr + inc0;
				t;
			}
			default: t;
		}
	});
}

// LociList (507)
mizLociList(a : MizAnalyzer, len : int) -> MizTrmList {
	l = ref MizTrmNil();
	k = ref len;
	while(\ -> ^k >= a.gSuperfluous + 1, \ -> {
		l := MizTrmElem(mizNewVarTrm(ikTrmConstant,
			getVectorUnsafe(a.locusAsConst, ^k)), ^l);
		k := ^k - 1;
	});
	^l;
}

// CreateConstList (1238) / CreateTrmList (1247)
mizCreateConstList(a : MizAnalyzer, list : MizIntSeq) -> MizTrmList {
	l = ref MizTrmNil();
	k = ref (mizSeqCount(list) - 1);
	while(\ -> ^k >= 0, \ -> {
		l := MizTrmElem(mizNewVarTrm(ikTrmConstant,
			getVectorUnsafe(a.constNr, mizSeqValue(list, ^k))), ^l);
		k := ^k - 1;
	});
	^l;
}

mizItTyp(a : MizAnalyzer) -> MizTyp { a.env.itTyp; }

// ReNewArgs (601): drop the leading elements past aNbr
mizReNewArgs(nbr : int, args : MizTrmList) -> MizTrmList {
	mizDropCells(args, mizTrmListLength(args) - nbr);
}

mizDefPartials(a : MizAnalyzer) -> Vector<MizPartDef> {
	switch (a.gDefiniens) {
		Some(d): switch (d.def) { Some(dd): dd.partials; None(): makeVector(0); };
		None(): makeVector(0);
	}
}

mizDefOtherwise(a : MizAnalyzer) -> Maybe<MizDefBody> {
	switch (a.gDefiniens) {
		Some(d): switch (d.def) { Some(dd): dd.otherwise; None(): None(); };
		None(): None();
	}
}

mizDefSort(a : MizAnalyzer) -> int {
	switch (a.gDefiniens) {
		Some(d): switch (d.def) { Some(dd): dd.sort; None(): 0; };
		None(): 0;
	}
}

mizBodyAsFrm(a : MizAnalyzer, b : MizDefBody) -> MizFrm {
	switch (b) {
		MizDefFrm(f): f;
		MizDefTrm(t): mizNewEqFrm(a.env, mizNewItTrm(), t);
	}
}

// Coherence (573)
mizCoherence(a : MizAnalyzer, ff : int) -> MizFrm {
	env = a.env;
	if (ff == 77) {                    // 'M'
		p = mizNotatAt(a.gen, noMode, mizNotatCount(a.gen, noMode) - 1);
		lArgs = mizLociList(a, sizeVector(p.primTypes));
		c = mizConstr(env, coMode, a.gWhichOne);
		upper = switch (c.typ) {
			Some(ct): mizInstCluster(env, ct.upper, lArgs);
			None(): mizNewEmptyCluster();
		};
		oldType = mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), upper,
			a.gWhichOne, lArgs);
		mizNewUniv(oldType, mizNewQualFrm(mizNewVarTrm(ikTrmBound, 1),
			mizCopyTyp(mizItTyp(a))));
	} else if (ff == 75) {             // 'K'
		p = mizNotatAt(a.gen, noFunctor, mizNotatCount(a.gen, noFunctor) - 1);
		lArgs = mizLociList(a, sizeVector(p.primTypes));
		mizNewQualFrm(mizNewFuncTrm(a.gWhichOne, lArgs), mizCopyTyp(mizItTyp(a)));
	} else { mizRunTimeError(2005); mizNewIncorFrm() }
}

// Compatibility (614)
mizCompatibility(a : MizAnalyzer, ff : int) -> MizFrm {
	env = a.env;
	if (isNone(a.gDefiniens) || a.defArgsError || a.gWhichOne == 0) mizNewIncorFrm()
	else {
		args = a.definiendumArgs;
		lDefiniendum = if (ff == 77) {
			mizNewQualFrm(mizNewItTrm(), mizNewStandardTyp(ikTypMode,
				mizNewEmptyCluster(), mizInstCluster(env, mizItTyp(a).upper, args),
				a.gWhichOne, args));
		} else if (ff == 75) {
			n = sizeVector(mizConstr(env, coFunctor, a.gWhichOne).primaries);
			mizNewEqFrm(env, mizNewItTrm(), mizNewFuncTrm(a.gWhichOne, mizReNewArgs(n, args)));
		} else if (ff == 82) {         // 'R'
			mizNewPredFrm(ikFrmPred, a.gWhichOne, args, 0);
		} else if (ff == 86) {         // 'V'
			n = sizeVector(mizConstr(env, coAttribute, a.gWhichOne).primaries);
			mizNewPredFrm(ikFrmAttr, a.gWhichOne, mizReNewArgs(n, args), 0);
		} else { mizRunTimeError(2006); mizNewIncorFrm() };
		a.definiendumArgs ::= MizTrmNil();
		partBiCond = \f -> mizNewBicond(mizCopyFrm(lDefiniendum), mizCopyFrm(f));
		lOth = ref mizNewVerum();
		cFrm = ref mizNewVerum();
		hasOther = isSome(mizDefOtherwise(a));
		iterVector(mizDefPartials(a), \pd -> {
			if (hasOther) lOth := mizNewConj(^lOth, mizNewNeg(mizCopyFrm(pd.guard)));
			lFrm = mizBodyAsFrm(a, pd.body);
			cFrm := mizNewConj(^cFrm, mizNewImpl(mizCopyFrm(pd.guard), partBiCond(lFrm)));
		});
		switch (mizDefOtherwise(a)) {
			Some(b): cFrm := mizNewConj(^cFrm, mizNewImpl(^lOth, partBiCond(mizBodyAsFrm(a, b))));
			None(): {}
		}
		if (ff == 75 || ff == 77) {
			mizWithinFrm(mizChangeBoundAndItN(1, 1), ^cFrm);
			mizNewUniv(mizCopyTyp(mizItTyp(a)), ^cFrm);
		} else ^cFrm;
	}
}

// Consistency (683)
mizConsistency(a : MizAnalyzer, ff : int) -> MizFrm {
	env = a.env;
	if (isNone(a.gDefiniens)) mizNewIncorFrm()
	else {
		partials = mizDefPartials(a);
		mizAssert(2522, sizeVector(partials) != 0);
		srt = mizDefSort(a);
		cFrm = ref mizNewVerum();
		fori(0, sizeVector(partials) - 1, \i -> {
			pi = getVectorUnsafe(partials, i);
			fori(i + 1, sizeVector(partials) - 1, \j -> {
				pj = getVectorUnsafe(partials, j);
				cFrm2 = mizNewConj(mizCopyFrm(pi.guard), mizCopyFrm(pj.guard));
				pair = if (srt == 109) {                // 'm'
					Pair(mizCopyFrm(mizBodyAsFrm(a, pi.body)),
						mizCopyFrm(mizBodyAsFrm(a, pj.body)));
				} else {                                 // 'e'
					mk = \b -> switch (b) {
						MizDefTrm(t): mizNewEqFrm(env, mizNewItTrm(), mizCopyTrm(t));
						MizDefFrm(f): mizCopyFrm(f);
					};
					Pair(mk(pi.body), mk(pj.body));
				};
				eq = mizNewBicond(pair.first, pair.second);
				cFrm := mizNewConj(^cFrm, mizNewImpl(cFrm2, eq));
			});
		});
		if (ff == 77 || ff == 75) {
			mizWithinFrm(mizChangeBoundAndItN(1, 1), ^cFrm);
			mizNewUniv(mizCopyTyp(mizItTyp(a)), ^cFrm);
		} else ^cFrm;
	}
}

// Existence (729)
mizExistence(a : MizAnalyzer, ff : int) -> MizFrm {
	if (isNone(a.gDefiniens)) mizNewIncorFrm()
	else {
		partExCond = \f0 -> {
			f = mizCopyFrm(f0);
			if (mizFrmSort(f) == ikError) f
			else {
				mizWithinFrm(mizChangeBoundAndItN(1, 1), f);
				mizNewExis(mizCopyTyp(mizItTyp(a)), f);
			}
		};
		hasOther = isSome(mizDefOtherwise(a));
		lOth = ref mizNewVerum();
		cFrm = ref mizNewVerum();
		iterVector(mizDefPartials(a), \pd -> {
			if (hasOther) lOth := mizNewConj(^lOth, mizNewNeg(mizCopyFrm(pd.guard)));
			cFrm := mizNewConj(^cFrm, mizNewImpl(mizCopyFrm(pd.guard),
				partExCond(mizBodyAsFrm(a, pd.body))));
		});
		switch (mizDefOtherwise(a)) {
			Some(b): cFrm := mizNewConj(^cFrm,
				mizNewImpl(^lOth, partExCond(mizBodyAsFrm(a, b))));
			None(): {}
		}
		^cFrm;
	}
}

// CoherenceEq (761)
mizCoherenceEq(a : MizAnalyzer) -> MizFrm {
	if (isNone(a.gDefiniens)) mizNewIncorFrm()
	else {
		mizAssert(2598, mizDefSort(a) == 101);   // 'e'
		hasOther = isSome(mizDefOtherwise(a));
		lOth = ref mizNewVerum();
		cFrm = ref mizNewVerum();
		trmOf = \b -> switch (b) { MizDefTrm(t): mizCopyTrm(t); MizDefFrm(__): mizNewIncorTrm(); };
		iterVector(mizDefPartials(a), \pd -> {
			if (hasOther) lOth := mizNewConj(^lOth, mizNewNeg(mizCopyFrm(pd.guard)));
			cFrm := mizNewConj(^cFrm, mizNewImpl(mizCopyFrm(pd.guard),
				mizNewQualFrm(trmOf(pd.body), mizCopyTyp(mizItTyp(a)))));
		});
		switch (mizDefOtherwise(a)) {
			Some(b): cFrm := mizNewConj(^cFrm, mizNewImpl(^lOth,
				mizNewQualFrm(trmOf(b), mizCopyTyp(mizItTyp(a)))));
			None(): {}
		}
		^cFrm;
	}
}

// NewGuard (804) / PartUniCond (825) / Uniqueness (840)
mizNewGuard(f0 : MizFrm) -> MizFrm {
	if (mizFrmSort(f0) == ikError) f0
	else {
		f = mizCopyFrm(f0);
		mizWithinFrm(mizChangeBoundAndItN(1, 2), f);
		f;
	}
}

mizPartUniCond(a : MizAnalyzer, f0 : MizFrm) -> MizFrm {
	if (mizFrmSort(f0) == ikError) f0
	else {
		c1 = mizCopyFrm(f0);
		c2 = mizCopyFrm(f0);
		mizWithinFrm(mizChangeBoundAndItN(1, 2), c1);
		mizWithinFrm(mizChangeBoundAndItN(2, 2), c2);
		mizNewImpl(mizNewConj(c1, c2), mizNewEqFrm(a.env,
			mizNewVarTrm(ikTrmBound, 1), mizNewVarTrm(ikTrmBound, 2)));
	}
}

mizUniqueness(a : MizAnalyzer) -> MizFrm {
	if (isNone(a.gDefiniens)) mizNewIncorFrm()
	else {
		hasOther = isSome(mizDefOtherwise(a));
		lOth = ref mizNewVerum();
		cFrm = ref mizNewVerum();
		iterVector(mizDefPartials(a), \pd -> {
			if (hasOther) lOth := mizNewConj(^lOth, mizNewNeg(mizNewGuard(pd.guard)));
			cFrm := mizNewConj(^cFrm, mizNewImpl(mizNewGuard(pd.guard),
				mizPartUniCond(a, mizBodyAsFrm(a, pd.body))));
		});
		switch (mizDefOtherwise(a)) {
			Some(b): cFrm := mizNewConj(^cFrm,
				mizNewImpl(^lOth, mizPartUniCond(a, mizBodyAsFrm(a, b))));
			None(): {}
		}
		lTyp = mizCopyTyp(mizItTyp(a));
		mizNewUniv(mizCopyTyp(lTyp), mizNewUniv(lTyp, ^cFrm));
	}
}

// Nr2CorrEl (xmldict.pas)
mizNr2CorrEl(n : int) -> string {
	if (n == 1) "Coherence"
	else if (n == 2) "Compatibility"
	else if (n == 3) "Consistency"
	else if (n == 4) "Existence"
	else if (n == 5) "Uniqueness"
	else if (n == 6) "Reducibility"
	else "UnknownCorrCond";
}

mizCorrCondAt(a : MizAnalyzer, n : int) -> MizFrm { getVectorUnsafe(a.gCorrCond, n); }
mizSetCorrCond(a : MizAnalyzer, n : int, f : MizFrm) -> void {
	setVectorUnsafe(a.gCorrCond, n, f);
}
mizClearCorrConds(a : MizAnalyzer) -> void {
	fori(1, CorrCondNbr, \k -> setVectorUnsafe(a.gCorrCond, k, mizNewVerum()));
	fori(1, CorrCondNbr, \k -> setVectorUnsafe(a.corrCondSet, k, false));
}

// Correctness (865)
mizACorrectness(a : MizAnalyzer) -> void {
	while(\ -> a.inf.curKind == 89 && a.stoppedAt == 0, \ -> {     // 'Y'
		nr = a.inf.curNr;
		mizInPos(a.inf);
		mizAssert(2514, getVectorUnsafe(a.corrCondSet, nr) || nr == 0);
		mizVOutElStart0(a.out, mizNr2CorrEl(nr));
		mizAJustify(a, 0, 0, mizCorrCondAt(a, nr));
		if (nr != 0) setVectorUnsafe(a.corrCondSet, nr, false);
		mizVOutElEnd(a.out, mizNr2CorrEl(nr));
	});
	if (a.inf.curKind == ikItmCorrectness && a.stoppedAt == 0) {
		mizVOutElStart0(a.out, "Correctness");
		mizInPos(a.inf);
		cFrm = ref mizNewVerum();
		fori(1, CorrCondNbr, \k -> {
			if (getVectorUnsafe(a.corrCondSet, k)) {
				cFrm := mizNewConj(^cFrm, mizCorrCondAt(a, k));
				mizVOutElStart0(a.out, mizNr2CorrEl(k));
				mizVOutFormula(a.out, mizCorrCondAt(a, k));
				mizVOutElEnd(a.out, mizNr2CorrEl(k));
			}
		});
		mizAJustify(a, 0, 0, ^cFrm);
		mizVOutElEnd(a.out, "Correctness");
	}
}

// -------------------- patterns and constructors (1090-1420) ---------------

// ChangeToLoci (correl.pas 1372): a constant of this definition becomes its
// locus. gDefBase is the analyzer's own OpenDef mark.
mizChangeToLoci(a : MizAnalyzer) -> MizWithin {
	mizMakeWithin(\__, t -> {
		switch (t) {
			MizVarTrm(srt, varNr, __, __): {
				if (srt == ikTrmConstant && varNr > a.gDefBase
					&& mizFixedVarAt(a, varNr).skelConstNr != 0) {
					t.sort ::= ikTrmLocus;
					t.varNr ::= mizFixedVarAt(a, varNr).skelConstNr;
				}
				t;
			}
			default: t;
		}
	});
}

// SetLociOcc (91)
mizSetLociOccW(a : MizAnalyzer) -> MizWithin {
	mizMakeWithin(\__, t -> {
		switch (t) {
			MizVarTrm(srt, varNr, __, __): {
				if (srt == ikTrmLocus) mizSetLociOcc(a, varNr, true);
				t;
			}
			default: t;
		}
	});
}

mizSetLociOcc(a : MizAnalyzer, i : int, b : bool) -> void {
	while(\ -> sizeVector(a.lociOcc) <= i, \ -> pushVector(a.lociOcc, false));
	setVectorUnsafe(a.lociOcc, i, b);
}
mizLociOccAt(a : MizAnalyzer, i : int) -> bool {
	if (i < sizeVector(a.lociOcc)) getVectorUnsafe(a.lociOcc, i) else false;
}

// AdjustedType (correl.pas 3184): the type with its mode adjusted to the
// redefinition origin
mizAdjustedType(env : MizCorrelEnv, t : MizTyp) -> MizTyp {
	if (t.sort == ikTypMode) {
		q = mizAdjustTyp(env, t);
		mizNewStandardTyp(ikTypMode, mizCopyCluster(t.lower), mizCopyCluster(t.upper),
			q.first, mizCopyTrmList(q.second));
	} else if (t.sort == ikTypStruct) {
		mizNewStandardTyp(ikTypStruct, mizCopyCluster(t.lower), mizCopyCluster(t.upper),
			t.modNr, mizCopyTrmList(t.modArgs));
	} else if (t.sort == ikError) {
		mizNewIncorTyp();
	} else { mizRunTimeError(2133); mizNewIncorTyp() }
}

// AbsNotatNr (1116)
mizAbsNotatNr(a : MizAnalyzer, nk : int) -> int {
	1 + mizNotatCount(a.gen, nk) - getVectorUnsafe(a.gen.notatBase, nk);
}

// ReadPattern (1102)
mizAReadPattern(a : MizAnalyzer) -> Pair<int, MizIntSeq> {
	formNr = a.inf.curNr;
	mizInPos(a.inf);
	vis = mizInitIntSeq(4);
	mizInWord(a.inf);
	while(\ -> a.inf.curKind != 59, \ -> {
		mizSeqInsert(vis, a.inf.curNr);
		mizInWord(a.inf);
	});
	Pair(formNr, vis);
}

// GetPattern (1121)
mizAGetPattern(a : MizAnalyzer, kind : int) -> MizPattern {
	p = mizMakePattern(kind, mizAbsNotatNr(a, kind), a.articleId);
	rp = mizAReadPattern(a);
	p.formNr ::= rp.first;
	fori(0, mizSeqCount(rp.second) - 1, \k -> { mizSeqInsert(p.visible, mizSeqValue(rp.second, k)); {} });
	fori(1, a.dPrimLength, \k ->
		pushVector(p.primTypes, mizCopyTyp(getVectorUnsafe(a.gPrimaries, k))));
	// the visible list is remapped from constant numbers to loci
	fori(0, mizSeqCount(p.visible) - 1, \k -> {
		v = mizSeqValue(p.visible, k);
		if (v != 0) mizSeqAtPut(p.visible, k, mizFixedVarAt(a, v).skelConstNr)
		else { mizSeqAtPut(p.visible, k, 0); p.formNr ::= 0; }
	});
	p;
}

mizInitAccess(a : MizAnalyzer) -> void {
	fori(0, sizeVector(a.lociOcc) - 1, \i -> setVectorUnsafe(a.lociOcc, i, false));
}

// CheckAccess (1145) — every locus must be reachable from the visible ones
mizCheckAccess(a : MizAnalyzer, p : MizPattern) -> void {
	mizInitAccess(a);
	if (p.formNr != 0) {
		fori(0, mizSeqCount(p.visible) - 1, \k -> {
			v = mizSeqValue(p.visible, k);
			if (v != 0) mizSetLociOcc(a, v, true);
		});
		stop = ref false;
		i = ref (sizeVector(p.primTypes) - 1);
		while(\ -> !^stop && ^i >= 0, \ -> {
			t = getVectorUnsafe(p.primTypes, ^i);
			if (t.sort == ikError) { p.formNr ::= 0; stop := true; }
			else if (!mizLociOccAt(a, ^i + 1)) {
				p.formNr ::= 0;
				mizAErrImm(a, 100);
				stop := true;
			} else {
				mizWithinTyp(mizSetLociOccW(a), t);
				i := ^i - 1;
			}
		});
	}
}

// the last pattern of a kind — the one just inserted as EXT
mizLastPattern(a : MizAnalyzer, kind : int) -> MizPattern {
	mizNotatAt(a.gen, kind, mizNotatCount(a.gen, kind) - 1);
}

// CompatibleArgs (523)
mizCompatibleArgs(a : MizAnalyzer, l : int) -> bool {
	env = a.env;
	s = a.dPrimLength - l;
	a.defArgsError ::= false;
	if (s < 0) { mizAErrImm(a, 107); a.defArgsError ::= true; false }
	else {
		ok = ref true;
		fori(1, l, \i -> {
			if (^ok) {
				switch (mizSubstTrmGet(env, i)) {
					Some(t): switch (t) {
						MizVarTrm(srt, varNr, __, __): {
							if (srt == ikTrmConstant && mizFixedVarAt(a, varNr).skelConstNr != 0) {
								if (mizFixedVarAt(a, varNr).skelConstNr != s + i) {
									mizAErrImm(a, 109); a.defArgsError ::= true; ok := false;
								}
							} else { mizAErrImm(a, 108); a.defArgsError ::= true; ok := false; }
						}
						default: { mizAErrImm(a, 108); a.defArgsError ::= true; ok := false; }
					}
					None(): { mizAErrImm(a, 108); a.defArgsError ::= true; ok := false; }
				}
			}
		});
		if (^ok) {
			args = ref MizTrmNil();
			i = ref l;
			while(\ -> ^i >= 1, \ -> {
				switch (mizSubstTrmGet(env, ^i)) {
					Some(t): args := MizTrmElem(mizCopyTrm(t), ^args);
					None(): {}
				}
				i := ^i - 1;
			});
			a.definiendumArgs ::= ^args;
		}
		^ok;
	}
}

// ReadDefiniens (960)
mizAReadDefiniens(a : MizAnalyzer, negate : bool, prim : Vector<MizTyp>,
		typ : Maybe<MizTyp>) -> void {
	env = a.env;
	dn = a.dn;
	dn.meansOccurs ::= 32;      // ' '
	dn.specified ::= false;
	a.gDefiniens ::= None();
	k0 = a.inf.curKind;
	if (k0 == 109 || k0 == 101) {      // 'm' / 'e'
		dn.meansOccurs ::= k0;
		mizInWord(a.inf);
		lLabId = mizInInt(a.inf);
		dn.pos1 ::= a.eh.curPos;
		clearVector(dn.primaries);
		fori(1, dn.len, \k -> pushVector(dn.primaries,
			mizCopyTyp(getVectorUnsafe(prim, k - 1))));
		switch (typ) {
			Some(t0): {
				dn.specified ::= true;
				t = mizAdjustedType(env, t0);
				mizWithinTyp(mizChangeToLoci(a), t);
				pushVector(dn.primaries, t);
			}
			None(): {}
		}
		dn.labNr ::= a.inf.curNr;
		dn.labId ::= lLabId;
		dn.pos2 ::= mizInPos(a.inf);
		mizInWord(a.inf);
		defSort = a.inf.curKind;
		rawPartials : Vector<Pair<MizExp, MizExp>> = makeVector(2);
		mizInWord(a.inf);
		while(\ -> a.inf.curKind != 59, \ -> {
			body = if (defSort == 109) mizLoadFormula(a.inf) else mizLoadTerm(a.inf);
			guard = mizLoadFormula(a.inf);
			pushVector(rawPartials, Pair(body, guard));
			mizInWord(a.inf);
		});
		mizInWord(a.inf);
		rawOther : Maybe<MizExp> = if (a.inf.curKind == 110) None()      // 'n'
			else if (a.inf.curKind == 111) {                              // 'o'
				Some(if (defSort == 109) mizLoadFormula(a.inf) else mizLoadTerm(a.inf));
			} else { mizRunTimeError(2520); None() };
		// analyse the pieces in the same order the original does
		partials : Vector<MizPartDef> = makeVector(sizeVector(rawPartials));
		iterVector(rawPartials, \pr -> {
			body : MizDefBody = if (defSort == 109)
				MizDefFrm({ mizASetBVN(a, 0); mizReadSentenceExp(a, pr.first, negate) })
				else MizDefTrm(mizAnalyzeTermTop(a, pr.first));
			guard = { mizASetBVN(a, 0); mizReadSentenceExp(a, pr.second, false) };
			pushVector(partials, MizPartDef(body, guard));
		});
		otherwise : Maybe<MizDefBody> = switch (rawOther) {
			None(): None();
			Some(e): Some(if (defSort == 109)
				MizDefFrm({ mizASetBVN(a, 0); mizReadSentenceExp(a, e, negate) })
				else MizDefTrm(mizAnalyzeTermTop(a, e)));
		};
		def = MizDef(defSort, partials, otherwise);
		a.gDefiniens ::= Some(MizDefiniens(dn.kind, 0, a.articleId, 0, 0,
			makeVector(0), mizInitIntSeq(0), mizNewVerum(), Some(def)));
		// the local-constant check over the definiens
		a.constErr ::= false;
		iterVector(partials, \pd -> {
			switch (pd.body) {
				MizDefFrm(f): mizWithinFrm(mizCheckLocConst(a), f);
				MizDefTrm(t): { mizWithinTrm(mizCheckLocConst(a), t); {} }
			}
			mizWithinFrm(mizCheckLocConst(a), pd.guard);
		});
		switch (otherwise) {
			Some(b): switch (b) {
				MizDefFrm(f): mizWithinFrm(mizCheckLocConst(a), f);
				MizDefTrm(t): { mizWithinTrm(mizCheckLocConst(a), t); {} }
			}
			None(): {}
		}
		if (a.constErr) {
			mizAErrImm(a, 69);
			a.gDefiniens ::= Some(MizDefiniens(ikError, 0, a.articleId, 0, 0,
				makeVector(0), mizInitIntSeq(0), mizNewIncorFrm(), None()));
		}
		if (sizeVector(mizDefPartials(a)) != 0) {
			mizSetCorrCond(a, 3, mizConsistency(a, dn.kind));
			setVectorUnsafe(a.corrCondSet, 3, true);
		}
		if (a.gRedef) {
			mizSetCorrCond(a, 2, mizCompatibility(a, dn.kind));
			setVectorUnsafe(a.corrCondSet, 2, true);
		}
		mizInWord(a.inf);
	}
}

// AnalyzeSnt (944) over an already-loaded expression
mizReadSentenceExp(a : MizAnalyzer, e : MizExp, neg : bool) -> MizFrm {
	f = mizAnalyzeFrm(a.gen, e);
	if (neg) mizNewNeg(f) else f;
}

// WriteDefiniens (1075)
mizAWriteDefiniens(a : MizAnalyzer) -> void {
	dn = a.dn;
	if (dn.meansOccurs != 32) {
		a.gEssentials ::= mizInitIntSeq(4);
		fori(a.gSuperfluous + 1, dn.len, \k -> { mizSeqInsert(a.gEssentials, k); {} });
		if (dn.specified) { mizSeqInsert(a.gEssentials, dn.len + 1); {} }
		skIt0 = a.gen.g.genCount;
		skIt = if (dn.kind == 82 || dn.kind == 86) skIt0 else skIt0 + 1;
		prims : Vector<MizTyp> = makeVector(sizeVector(dn.primaries));
		iterVector(dn.primaries, \t -> pushVector(prims, t));
		pushVector(a.definitionList, MizDefNodeItem(dn.meansOccurs, dn.kind,
			a.gWhichOne, dn.labNr, dn.labId,
			switch (a.gDefiniens) { Some(d): d.def; None(): None(); },
			mizGVarNbr(a), skIt, a.gen.g.lastEntry,
			mizCopyIntSeq(a.gEssentials), prims));
	}
}

// WriteDefiniensLabel (560)
mizAWriteDefiniensLabel(a : MizAnalyzer) -> void {
	if (a.dn.meansOccurs != 32) {
		mizVOutIntAttr(a.out, "nr", a.dn.labNr);
		mizVOutIntAttr(a.out, "vid", a.dn.labId);
		mizVOutPosAsAttrs(a.out, a.dn.pos2);
	}
}

// ------------------------- the PREDICATE definition family (1217-1409) ----

// find the pattern of `kind` whose format matches and whose args type-check,
// scanning the COMMITTED patterns downwards. Returns its index or -1.
mizFindOriginPattern(a : MizAnalyzer, kind : int, coKind : int, formNr : int,
		args : MizTrmList) -> int {
	env = a.env;
	res = ref (-1);
	k = ref (mizNotatCommitted(a.gen, kind) - 1);
	while(\ -> ^res < 0 && ^k >= 0, \ -> {
		p = mizNotatAt(a.gen, kind, ^k);
		if (mizOriginalNr(env, coKind, p.constrNr) == 0 && p.formNr == formNr
			&& mizCheckTypes(env, p, args)) res := ^k;
		k := ^k - 1;
	});
	^res;
}

mizResetProperties(a : MizAnalyzer) -> void {
	gp = a.gProperties;
	gp.properties ::= 0;
	gp.firstArg ::= 0;
	gp.secondArg ::= 0;
}

// the common tail of Redef*/Notat* pattern procedures: adopt the origin's
// constructor, superfluous count and properties
mizAdoptOrigin(a : MizAnalyzer, coKind : int, originNr : int) -> void {
	env = a.env;
	c = mizConstr(env, coKind, originNr);
	a.gWhichOne ::= originNr;
	a.gSuperfluous ::= a.dPrimLength - sizeVector(c.primaries);
	gp = a.gProperties;
	gp.properties ::= c.properties;
	gp.firstArg ::= c.firstArg + a.gSuperfluous;
	gp.secondArg ::= c.secondArg + a.gSuperfluous;
}

// DefPredPattern (1217)
mizDefPredPattern(a : MizAnalyzer) -> void {
	mizInPos(a.inf);
	mizInWord(a.inf);
	a.gDefPos ::= a.eh.curPos;
	p = mizAGetPattern(a, noPredicate);
	mizCheckAccess(a, p);
	mizNotatInsertExt(a.gen, p);
	mizInWord(a.inf);
	p.constrKind ::= ikFrmPred;
	mizResetProperties(a);
	a.redefAntonym ::= false;
	{ dnq1 = a.dn; dnq1.kind ::= 82; }                     // 'R'
	{ dnq2 = a.dn; dnq2.len ::= sizeVector(p.primTypes); }
	mizAReadDefiniens(a, false, p.primTypes, None());
}

// RedefPredPattern (1259)
mizRedefPredPattern(a : MizAnalyzer) -> void {
	env = a.env;
	a.gRedef ::= true;
	mizInPos(a.inf);
	mizInWord(a.inf);
	a.gDefPos ::= a.eh.curPos;
	p = mizAGetPattern(a, noPredicate);
	mizCheckAccess(a, p);
	mizNotatInsertExt(a.gen, p);
	mizInWord(a.inf);
	mizResetProperties(a);
	a.redefAntonym ::= false;
	mizDisposeSubstTrm(env);
	p.constrKind ::= ikFrmPred;
	if (p.formNr != 0) {
		lArgs = mizCreateConstList(a, p.visible);
		k = mizFindOriginPattern(a, noPredicate, coPredicate, p.formNr, lArgs);
		if (k < 0) mizAErrImm(a, 112)
		else {
			op = mizNotatAt(a.gen, noPredicate, k);
			if (op.antonymic) a.redefAntonym ::= true;
			if (mizCompatibleArgs(a, sizeVector(op.primTypes)))
				mizAdoptOrigin(a, coPredicate, op.constrNr);
		}
	}
	mizDisposeSubstTrm(env);
	{ dnq3 = a.dn; dnq3.kind ::= 82; }
	{ dnq4 = a.dn; dnq4.len ::= sizeVector(p.primTypes); }
	mizAReadDefiniens(a, a.redefAntonym, p.primTypes, None());
}

// NotatPredPattern (1315)
mizNotatPredPattern(a : MizAnalyzer) -> void {
	env = a.env;
	a.gRedef ::= true;
	mizInPos(a.inf);
	mizInWord(a.inf);
	a.gDefPos ::= a.eh.curPos;
	p = mizAGetPattern(a, noPredicate);
	mizCheckAccess(a, p);
	mizNotatInsertExt(a.gen, p);
	mizInWord(a.inf);
	lSynonym = a.inf.curKind == ikMscSynonym;
	mizInPos(a.inf);
	mizInWord(a.inf);
	origin = mizAGetPattern(a, noPredicate);
	mizCheckAccess(a, origin);
	mizInWord(a.inf);
	mizResetProperties(a);
	a.redefAntonym ::= false;
	mizDisposeSubstTrm(env);
	origin.constrKind ::= ikFrmPred;
	foundK = ref (-1);
	if (origin.formNr != 0) {
		lArgs = mizCreateConstList(a, origin.visible);
		k = mizFindOriginPattern(a, noPredicate, coPredicate, origin.formNr, lArgs);
		foundK := k;
		if (k < 0) mizAErrImm(a, 112)
		else {
			op = mizNotatAt(a.gen, noPredicate, k);
			if (op.antonymic) a.redefAntonym ::= true;
			if (mizCompatibleArgs(a, sizeVector(op.primTypes))) {
				o = mizOriginalNr(env, coPredicate, op.constrNr);
				mizAdoptOrigin(a, coPredicate, if (o == 0) op.constrNr else o);
			}
		}
	}
	p.constrKind ::= ikFrmPred;
	p.constrNr ::= a.gWhichOne;
	p.antonymic ::= lSynonym == a.redefAntonym;
	p.redefNr ::= ^foundK + 1;
	mizDisposeSubstTrm(env);
	{ dnq5 = a.dn; dnq5.kind ::= 82; }
	{ dnq6 = a.dn; dnq6.len ::= sizeVector(origin.primTypes); }
	mizAReadDefiniens(a, a.redefAntonym, origin.primTypes, None());
}

// InsertPredicate (1386) — creates the constructor and reports it
mizInsertConstructorFor(a : MizAnalyzer, coKind : int, kind : int) -> void {
	env = a.env;
	p = mizLastPattern(a, kind);
	absNr = 1 + mizConstrCount(env, coKind) - 1 - a.constrBase[coKind];
	c = mizMakeConstr(coKind, a.articleId, absNr);
	iterVector(p.primTypes, \t -> pushVector(c.primaries, mizCopyTyp(t)));
	c.properties ::= a.gProperties.properties;
	c.firstArg ::= a.gProperties.firstArg;
	c.secondArg ::= a.gProperties.secondArg;
	c.whichConstrNr ::= a.gWhichOne;
	c.superfluous ::= a.gSuperfluous;
	// gWhichOne is the index the new constructor GETS (Pascal takes Count
	// before the Insert; the port's vector carries a dummy at 0)
	a.gWhichOne ::= mizPushConstr(env, c);
	mizVOutConstructor(a.out, c, a.gWhichOne);
}

// DefPredTail (1402) / DefAttrTail (1410)
mizDefPredTail(a : MizAnalyzer) -> void {
	p = mizLastPattern(a, noPredicate);
	p.constrNr ::= a.gWhichOne;
	p.antonymic ::= a.redefAntonym;
}

mizDefAttrTail(a : MizAnalyzer) -> void {
	p = mizLastPattern(a, noAttribute);
	p.constrNr ::= a.gWhichOne;
	p.antonymic ::= a.redefAntonym;
}

// ---------------- the FUNCTOR / MODE / ATTRIBUTE families (1418-2005) ------

// ChangeToConst (96): a locus of this definition goes back to its constant
mizChangeToConst(a : MizAnalyzer) -> MizWithin {
	mizMakeWithin(\__, t -> {
		switch (t) {
			MizVarTrm(srt, varNr, __, __): {
				if (srt == ikTrmLocus) {
					t.sort ::= ikTrmConstant;
					t.varNr ::= a.gSuperfluous + getVectorUnsafe(a.constNr, varNr);
				}
				t;
			}
			default: t;
		}
	});
}

mizSetItTyp(a : MizAnalyzer, t : MizTyp) -> void { e = a.env; e.itTyp ::= t; }

// Specification (1418)
mizASpecification(a : MizAnalyzer) -> void {
	a.gSpecified ::= a.inf.curKind == ikMscSpecification;
	if (a.inf.curKind == ikMscSpecification) {
		gn = a.gen;
		gn.fraenkelTermAllowed ::= false;
		mizSetItTyp(a, mizReadType(a));
		gn.fraenkelTermAllowed ::= true;
		mizInWord(a.inf);
	} else mizSetItTyp(a, mizCopyTyp(a.anyTyp));
}

// RedefSpecification (1463)
mizRedefSpecification(a : MizAnalyzer, fTyp : MizTyp, err : int) -> void {
	env = a.env;
	if (a.gWhichOne == 0) mizASpecification(a)
	else {
		a.gSpecified ::= a.inf.curKind == ikMscSpecification;
		if (a.inf.curKind == ikMscSpecification) {
			mizSetItTyp(a, mizReadType(a));
			mizInWord(a.inf);
			if (mizItTyp(a).sort != ikError) {
				lTyp = mizCopyTyp(fTyp);
				mizWithinTyp(mizChangeToConst(a), lTyp);
				if (!mizIsWiderThan(env, lTyp, mizCopyTyp(mizItTyp(a)))) mizAErrImm(a, err);
			}
		} else {
			t = mizCopyTyp(fTyp);
			mizWithinTyp(mizChangeToConst(a), t);
			mizSetItTyp(a, t);
		}
	}
}

// the constructor type of a redefinition origin, AnyTyp when it has none
mizOriginConstrTyp(a : MizAnalyzer, coKind : int) -> MizTyp {
	switch (mizConstr(a.env, coKind, a.gWhichOne).typ) {
		Some(t): t;
		None(): a.anyTyp;
	}
}

// the tail of a Redef*/Notat* that must NOT take the origin's properties
// (the mode family does not have any)
mizAdoptOriginNoProps(a : MizAnalyzer, coKind : int, originNr : int) -> void {
	c = mizConstr(a.env, coKind, originNr);
	a.gWhichOne ::= originNr;
	a.gSuperfluous ::= a.dPrimLength - sizeVector(c.primaries);
}

// DefFuncPattern (1431)
mizDefFuncPattern(a : MizAnalyzer) -> void {
	mizInPos(a.inf);
	mizInWord(a.inf);
	a.gDefPos ::= a.eh.curPos;
	p = mizAGetPattern(a, noFunctor);
	mizCheckAccess(a, p);
	mizNotatInsertExt(a.gen, p);
	mizInWord(a.inf);
	p.constrKind ::= ikTrmFunctor;
	mizASpecification(a);
	mizResetProperties(a);
	{ dnq1 = a.dn; dnq1.kind ::= 75; }                       // 'K'
	{ dnq2 = a.dn; dnq2.len ::= sizeVector(p.primTypes); }
	mizAReadDefiniens(a, false, p.primTypes, Some(mizItTyp(a)));
	if (a.dn.meansOccurs == 101) {                          // 'e'
		mizSetCorrCond(a, 1, mizCoherenceEq(a));
		setVectorUnsafe(a.corrCondSet, 1, true);
	} else {
		mizSetCorrCond(a, 4, mizExistence(a, 75));
		setVectorUnsafe(a.corrCondSet, 4, true);
		mizSetCorrCond(a, 5, mizUniqueness(a));
		setVectorUnsafe(a.corrCondSet, 5, true);
	}
}

// RedefFuncPattern (1494)
mizRedefFuncPattern(a : MizAnalyzer) -> void {
	env = a.env;
	a.gRedef ::= true;
	mizInPos(a.inf);
	mizInWord(a.inf);
	a.gDefPos ::= a.eh.curPos;
	p = mizAGetPattern(a, noFunctor);
	mizCheckAccess(a, p);
	mizNotatInsertExt(a.gen, p);
	mizInWord(a.inf);
	mizDisposeSubstTrm(env);
	mizResetProperties(a);
	p.constrKind ::= ikTrmFunctor;
	if (p.formNr != 0) {
		lArgs = mizCreateConstList(a, p.visible);
		k = mizFindOriginPattern(a, noFunctor, coFunctor, p.formNr, lArgs);
		if (k < 0) mizAErrImm(a, 113)
		else {
			op = mizNotatAt(a.gen, noFunctor, k);
			if (mizCompatibleArgs(a, sizeVector(op.primTypes)))
				mizAdoptOrigin(a, coFunctor, op.constrNr);
		}
	}
	mizDisposeSubstTrm(env);
	mizRedefSpecification(a, mizOriginConstrTyp(a, coFunctor), 117);
	if (a.gSpecified) {
		mizSetCorrCond(a, 1, mizCoherence(a, 75));
		setVectorUnsafe(a.corrCondSet, 1, true);
	}
	{ dnq3 = a.dn; dnq3.kind ::= 75; }
	{ dnq4 = a.dn; dnq4.len ::= sizeVector(p.primTypes); }
	mizAReadDefiniens(a, false, p.primTypes, Some(mizItTyp(a)));
}

// NotatFuncPattern (1577)
mizNotatFuncPattern(a : MizAnalyzer) -> void {
	env = a.env;
	a.gRedef ::= true;
	mizInPos(a.inf);
	mizInWord(a.inf);
	a.gDefPos ::= a.eh.curPos;
	synonym = mizAGetPattern(a, noFunctor);
	mizCheckAccess(a, synonym);
	mizNotatInsertExt(a.gen, synonym);
	mizInWord(a.inf);

	mizInPos(a.inf);
	mizInWord(a.inf);
	origin = mizAGetPattern(a, noFunctor);
	mizCheckAccess(a, origin);
	mizInWord(a.inf);

	mizDisposeSubstTrm(env);
	mizResetProperties(a);
	origin.constrKind ::= ikTrmFunctor;
	foundK = ref (-1);
	if (origin.formNr != 0) {
		lArgs = mizCreateConstList(a, origin.visible);
		k = mizFindOriginPattern(a, noFunctor, coFunctor, origin.formNr, lArgs);
		foundK := k;
		if (k < 0) mizAErrImm(a, 113)
		else {
			op = mizNotatAt(a.gen, noFunctor, k);
			if (mizCompatibleArgs(a, sizeVector(op.primTypes))) {
				o = mizOriginalNr(env, coFunctor, op.constrNr);
				mizAdoptOrigin(a, coFunctor, if (o == 0) op.constrNr else o);
			}
		}
	}
	mizDisposeSubstTrm(env);
	{ dnq5 = a.dn; dnq5.kind ::= 75; }
	synonym.constrKind ::= ikTrmFunctor;
	synonym.constrNr ::= a.gWhichOne;
	synonym.redefNr ::= ^foundK + 1;
	{ dnq6 = a.dn; dnq6.len ::= sizeVector(origin.primTypes); }
	mizAReadDefiniens(a, false, origin.primTypes, Some(mizItTyp(a)));
}

// the ConstrTypObj.InitForPattern (correl.pas 1489) half every Insert* shares
mizNewConstrForPattern(a : MizAnalyzer, coKind : int, kind : int,
		typ : MizTyp) -> MizConstr {
	env = a.env;
	p = mizLastPattern(a, kind);
	absNr = 1 + mizConstrCount(env, coKind) - 1 - a.constrBase[coKind];
	c = mizMakeConstr(coKind, a.articleId, absNr);
	iterVector(p.primTypes, \t -> pushVector(c.primaries, mizCopyTyp(t)));
	ct = mizCopyTyp(typ);
	mizWithinTyp(mizChangeToLoci(a), ct);
	c.typ ::= Some(ct);
	c;
}

// InsertFunctor (1644)
mizInsertFunctor(a : MizAnalyzer) -> void {
	env = a.env;
	c = mizNewConstrForPattern(a, coFunctor, noFunctor, mizItTyp(a));
	c.properties ::= a.gProperties.properties;
	c.firstArg ::= a.gProperties.firstArg;
	c.secondArg ::= a.gProperties.secondArg;
	c.whichConstrNr ::= a.gWhichOne;
	c.superfluous ::= a.gSuperfluous;
	// gWhichOne is the index the new constructor GETS (Pascal takes Count
	// before the Insert; the port's vector carries a dummy at 0)
	a.gWhichOne ::= mizPushConstr(env, c);
	mizVOutConstructor(a.out, c, a.gWhichOne);
}

// DefFuncTail (1661)
mizDefFuncTail(a : MizAnalyzer) -> void {
	p = mizLastPattern(a, noFunctor);
	p.constrNr ::= a.gWhichOne;
}

// CreateLociList (1667)
mizCreateLociList(a : MizAnalyzer, low : int, up : int) -> Vector<MizTyp> {
	v : Vector<MizTyp> = makeVector(if (up >= low) up - low + 1 else 1);
	fori(low, up, \k -> pushVector(v, mizCopyTyp(getVectorUnsafe(a.gPrimaries, k))));
	v;
}

// the mode family's origin search: it must see the Expansion of the pattern
// it found, so it cannot go through mizFindOriginPattern
mizFindModeOrigin(a : MizAnalyzer, formNr : int, args : MizTrmList) -> int {
	env = a.env;
	res = ref (-1);
	k = ref (mizNotatCommitted(a.gen, noMode) - 1);
	while(\ -> ^res < 0 && ^k >= 0, \ -> {
		p = mizNotatAt(a.gen, noMode, ^k);
		if (p.formNr == formNr && mizOriginalNr(env, coMode, p.constrNr) == 0
			&& mizCheckTypes(env, p, args)) res := ^k;
		k := ^k - 1;
	});
	^res;
}

// DefModePattern (1674)
mizDefModePattern(a : MizAnalyzer) -> void {
	mizInPos(a.inf);
	mizInWord(a.inf);
	a.gDefPos ::= a.eh.curPos;
	p = mizAGetPattern(a, noMode);
	mizCheckAccess(a, p);
	mizNotatInsertExt(a.gen, p);
	mizInWord(a.inf);
	p.constrKind ::= ikTypMode;
	p.expansion ::= None();
	mizASpecification(a);
	if (mizItTyp(a).sort == ikError) mizSetItTyp(a, mizCopyTyp(a.anyTyp));
	mizResetProperties(a);
	{ dnq7 = a.dn; dnq7.kind ::= 77; }                       // 'M'
	{ dnq8 = a.dn; dnq8.len ::= sizeVector(p.primTypes); }
	mizAReadDefiniens(a, false, p.primTypes, Some(mizItTyp(a)));
	mizSetCorrCond(a, 4, mizExistence(a, 77));
	setVectorUnsafe(a.corrCondSet, 4, true);
}

// RedefModePattern (1701)
mizRedefModePattern(a : MizAnalyzer) -> void {
	env = a.env;
	a.gRedef ::= true;
	mizInPos(a.inf);
	mizInWord(a.inf);
	a.gDefPos ::= a.eh.curPos;
	p = mizAGetPattern(a, noMode);
	mizCheckAccess(a, p);
	mizNotatInsertExt(a.gen, p);
	mizInWord(a.inf);
	mizDisposeSubstTrm(env);
	mizResetProperties(a);
	p.expansion ::= None();
	p.constrKind ::= ikTypMode;
	if (p.formNr != 0) {
		lArgs = mizCreateConstList(a, p.visible);
		k = mizFindModeOrigin(a, p.formNr, lArgs);
		if (k < 0) mizAErrImm(a, 114)
		else {
			op = mizNotatAt(a.gen, noMode, k);
			if (isSome(op.expansion)) mizAErrImm(a, 134)
			else if (mizCompatibleArgs(a, sizeVector(op.primTypes)))
				mizAdoptOriginNoProps(a, coMode, op.constrNr);
		}
	}
	mizDisposeSubstTrm(env);
	mizRedefSpecification(a, mizOriginConstrTyp(a, coMode), 118);
	if (mizItTyp(a).sort == ikError) {
		mizSetItTyp(a, mizCopyTyp(a.anyTyp));
		a.gWhichOne ::= 0;
	}
	if (a.gSpecified) {
		mizSetCorrCond(a, 1, mizCoherence(a, 77));
		setVectorUnsafe(a.corrCondSet, 1, true);
	}
	{ dnq9 = a.dn; dnq9.kind ::= 77; }
	{ dnq10 = a.dn; dnq10.len ::= sizeVector(p.primTypes); }
	mizAReadDefiniens(a, false, p.primTypes, Some(mizItTyp(a)));
}

// NotatModePattern (1754) — the synonym pattern is inserted AFTER the
// definiens is read, which is what the report's element order records
mizNotatModePattern(a : MizAnalyzer) -> void {
	env = a.env;
	a.gRedef ::= true;
	mizInPos(a.inf);
	mizInWord(a.inf);
	a.gDefPos ::= a.eh.curPos;
	synonym = mizAGetPattern(a, noMode);
	mizCheckAccess(a, synonym);
	mizInWord(a.inf);
	mizInPos(a.inf);
	mizInWord(a.inf);
	origin = mizAGetPattern(a, noMode);
	mizCheckAccess(a, origin);
	mizDisposeSubstTrm(env);
	origin.expansion ::= None();
	origin.constrKind ::= ikTypMode;
	foundK = ref (-1);
	if (origin.formNr != 0) {
		lArgs = mizCreateConstList(a, origin.visible);
		k = mizFindModeOrigin(a, origin.formNr, lArgs);
		foundK := k;
		if (k < 0) mizAErrImm(a, 114)
		else {
			op = mizNotatAt(a.gen, noMode, k);
			if (isSome(op.expansion)) mizAErrImm(a, 134)
			else if (mizCompatibleArgs(a, sizeVector(op.primTypes))) {
				o = mizOriginalNr(env, coMode, op.constrNr);
				mizAdoptOriginNoProps(a, coMode, if (o == 0) op.constrNr else o);
			}
		}
	}
	mizDisposeSubstTrm(env);
	mizRedefSpecification(a, mizOriginConstrTyp(a, coMode), 118);
	if (mizItTyp(a).sort == ikError) {
		mizSetItTyp(a, mizCopyTyp(a.anyTyp));
		a.gWhichOne ::= 0;
	}
	{ dnq11 = a.dn; dnq11.kind ::= 77; }
	{ dnq12 = a.dn; dnq12.len ::= sizeVector(origin.primTypes); }
	mizAReadDefiniens(a, false, origin.primTypes, Some(mizItTyp(a)));
	mizNotatInsertExt(a.gen, synonym);
	mizInWord(a.inf);
	synonym.expansion ::= None();
	synonym.constrKind ::= ikTypMode;
	synonym.constrNr ::= a.gWhichOne;
	synonym.redefNr ::= ^foundK + 1;
}

// InsertMode (1818)
mizInsertMode(a : MizAnalyzer) -> void {
	env = a.env;
	c = mizNewConstrForPattern(a, coMode, noMode, mizItTyp(a));
	c.properties ::= a.gProperties.properties;
	c.firstArg ::= a.gProperties.firstArg;
	c.secondArg ::= a.gProperties.secondArg;
	// the sethood property is inherited, either from the result type's own
	// mode or from the redefinition origin
	if (mizConstrCount(env, coMode) - 1 > 1) {
		if (mizItTyp(a).sort == ikTypMode
			&& mizHasProperty(mizConstr(env, coMode, mizItTyp(a).modNr), sySethood)) {
			c.properties ::= bitOr(c.properties, bitShl(1, sySethood));
		} else if (a.gWhichOne != 0
			&& mizHasProperty(mizConstr(env, coMode, a.gWhichOne), sySethood)) {
			c.properties ::= bitOr(c.properties, bitShl(1, sySethood));
		}
	}
	c.whichConstrNr ::= a.gWhichOne;
	c.superfluous ::= a.gSuperfluous;
	// gWhichOne is the index the new constructor GETS (Pascal takes Count
	// before the Insert; the port's vector carries a dummy at 0)
	a.gWhichOne ::= mizPushConstr(env, c);
	mizVOutConstructor(a.out, c, a.gWhichOne);
}

// DefExpandableMode (1842)
mizDefExpandableMode(a : MizAnalyzer) -> void {
	mizInPos(a.inf);
	mizInWord(a.inf);
	a.gDefPos ::= a.eh.curPos;
	p = mizAGetPattern(a, noMode);
	mizCheckAccess(a, p);
	mizNotatInsertExt(a.gen, p);
	p.constrKind ::= ikTypMode;
	p.constrNr ::= 0;
	e0 = mizReadType(a);
	e = if (e0.sort == ikError) mizCopyTyp(a.anyTyp) else e0;
	mizInWord(a.inf);
	mizWithinTyp(mizChangeToLoci(a), e);
	p.expansion ::= Some(e);
}

// DefModeTail (2652)
mizDefModeTail(a : MizAnalyzer) -> void {
	p = mizLastPattern(a, noMode);
	p.constrNr ::= a.gWhichOne;
}

// DefPredAttributePattern (1858)
mizDefPredAttributePattern(a : MizAnalyzer) -> void {
	mizInPos(a.inf);
	mizInWord(a.inf);
	a.gDefPos ::= a.eh.curPos;
	p = mizAGetPattern(a, noAttribute);
	mizCheckAccess(a, p);
	mizNotatInsertExt(a.gen, p);
	mizInWord(a.inf);
	a.redefAntonym ::= false;
	p.constrKind ::= ikFrmAttr;
	{ dnq13 = a.dn; dnq13.kind ::= 86; }                       // 'V'
	{ dnq14 = a.dn; dnq14.len ::= sizeVector(p.primTypes); }
	mizAReadDefiniens(a, false, p.primTypes, None());
}

// RedefPredAttributePattern (1877)
mizRedefPredAttributePattern(a : MizAnalyzer) -> void {
	env = a.env;
	a.gRedef ::= true;
	mizInPos(a.inf);
	mizInWord(a.inf);
	a.gDefPos ::= a.eh.curPos;
	p = mizAGetPattern(a, noAttribute);
	mizCheckAccess(a, p);
	mizNotatInsertExt(a.gen, p);
	mizDisposeSubstTrm(env);
	mizInWord(a.inf);
	a.redefAntonym ::= false;
	p.constrKind ::= ikFrmAttr;
	{ dnq15 = a.dn; dnq15.positive ::= true; }
	if (p.formNr != 0) {
		lArgs = mizCreateConstList(a, p.visible);
		k = mizFindOriginPattern(a, noAttribute, coAttribute, p.formNr, lArgs);
		if (k < 0) mizAErrImm(a, 115)
		else {
			op = mizNotatAt(a.gen, noAttribute, k);
			if (op.antonymic) a.redefAntonym ::= true;
			if (mizCompatibleArgs(a, sizeVector(op.primTypes))) {
				mizAdoptOriginNoProps(a, coAttribute, op.constrNr);
				dnq16 = a.dn; dnq16.positive ::= !op.antonymic;
			}
		}
	}
	mizDisposeSubstTrm(env);
	{ dnq17 = a.dn; dnq17.kind ::= 86; }
	{ dnq18 = a.dn; dnq18.len ::= sizeVector(p.primTypes); }
	mizAReadDefiniens(a, a.redefAntonym, p.primTypes, None());
}

// NotatPredAttributePattern (1924)
mizNotatPredAttributePattern(a : MizAnalyzer) -> void {
	env = a.env;
	a.gRedef ::= true;
	mizInPos(a.inf);
	mizInWord(a.inf);
	a.gDefPos ::= a.eh.curPos;
	synonym = mizAGetPattern(a, noAttribute);
	mizCheckAccess(a, synonym);
	mizNotatInsertExt(a.gen, synonym);

	mizInWord(a.inf);
	lSynonym = a.inf.curKind == ikMscSynonym;
	mizInWord(a.inf);
	mizInPos(a.inf);
	mizInWord(a.inf);
	origin = mizAGetPattern(a, noAttribute);
	mizCheckAccess(a, origin);

	mizDisposeSubstTrm(env);
	mizInWord(a.inf);
	a.redefAntonym ::= false;
	origin.constrKind ::= ikFrmAttr;
	{ dnq19 = a.dn; dnq19.positive ::= true; }
	foundK = ref (-1);
	if (origin.formNr != 0) {
		lArgs = mizCreateConstList(a, origin.visible);
		k = mizFindOriginPattern(a, noAttribute, coAttribute, origin.formNr, lArgs);
		foundK := k;
		if (k < 0) mizAErrImm(a, 115)
		else {
			op = mizNotatAt(a.gen, noAttribute, k);
			if (op.antonymic) a.redefAntonym ::= true;
			if (mizCompatibleArgs(a, sizeVector(op.primTypes))) {
				o = mizOriginalNr(env, coAttribute, op.constrNr);
				mizAdoptOriginNoProps(a, coAttribute, if (o == 0) op.constrNr else o);
				dnq20 = a.dn; dnq20.positive ::= !op.antonymic;
			}
		}
	}
	mizDisposeSubstTrm(env);
	{ dnq21 = a.dn; dnq21.kind ::= 86; }
	synonym.constrKind ::= ikFrmAttr;
	synonym.constrNr ::= a.gWhichOne;
	synonym.redefNr ::= ^foundK + 1;
	synonym.antonymic ::= lSynonym == a.redefAntonym;
	{ dnq22 = a.dn; dnq22.len ::= sizeVector(origin.primTypes); }
	mizAReadDefiniens(a, a.redefAntonym, origin.primTypes, None());
}

// InsertPredAttribute (1988) — its constructor type is the LAST primary
mizInsertPredAttribute(a : MizAnalyzer) -> void {
	env = a.env;
	lTyp = if (a.gPrimNbr > 0) mizCopyTyp(getVectorUnsafe(a.gPrimaries, a.gPrimNbr))
		else mizNewIncorTyp();
	c = mizNewConstrForPattern(a, coAttribute, noAttribute, lTyp);
	c.whichConstrNr ::= a.gWhichOne;
	c.superfluous ::= a.gSuperfluous;
	// gWhichOne is the index the new constructor GETS (Pascal takes Count
	// before the Insert; the port's vector carries a dummy at 0)
	a.gWhichOne ::= mizPushConstr(env, c);
	mizVOutConstructor(a.out, c, a.gWhichOne);
}

// -------------------------- the PROPERTIES (4830-5398) --------------------

// ChangeLociInProperty (4830)
mizChangeLociInProperty(a : MizAnalyzer) -> MizWithin {
	mizMakeWithin(\__, t -> {
		switch (t) {
			MizBaseTrm(srt, __):
				if (srt == ikTrmIt) mizNewVarTrm(ikTrmBound, a.gBoundForIt) else t;
			MizVarTrm(srt, varNr, __, __): {
				if (srt == ikTrmBound) t.varNr ::= varNr + a.gBoundInc
				else if (srt == ikTrmConstant) {
					if (varNr == a.gFirstArg) {
						t.sort ::= ikTrmBound; t.varNr ::= a.gBoundForFirst;
					} else if (varNr == a.gSecondArg) {
						t.sort ::= ikTrmBound; t.varNr ::= a.gBoundForSecond;
					}
				}
				t;
			}
			default: t;
		}
	});
}

// ChangeLociInPropertySethood (4850)
mizChangeLociInPropertySethood(a : MizAnalyzer) -> MizWithin {
	mizMakeWithin(\__, t -> {
		switch (t) {
			MizBaseTrm(srt, __):
				if (srt == ikTrmIt) mizNewVarTrm(ikTrmBound, a.gBoundForIt) else t;
			MizVarTrm(srt, varNr, __, __): {
				if (srt == ikTrmBound) t.varNr ::= varNr + a.gBoundInc;
				t;
			}
			default: t;
		}
	});
}

// SwapLociInType (4863)
mizSwapLociInType(a : MizAnalyzer) -> MizWithin {
	mizMakeWithin(\__, t -> {
		switch (t) {
			MizVarTrm(srt, varNr, __, __): {
				if (srt == ikTrmConstant) {
					if (varNr == a.gFirstArg) t.varNr ::= a.gSecondArg
					else if (varNr == a.gSecondArg) t.varNr ::= a.gFirstArg;
				}
				t;
			}
			default: t;
		}
	});
}

mizIncludeProperty(a : MizAnalyzer, prop : int) -> void {
	gp = a.gProperties;
	gp.properties ::= bitOr(gp.properties, bitShl(1, prop));
}

// PredProperty (4876) — an antonym swaps the two mirror-image pairs
mizPredProperty(a : MizAnalyzer, prop0 : int) -> void {
	prop = if (!a.redefAntonym) prop0
		else if (prop0 == 2) 3 else if (prop0 == 3) 2
		else if (prop0 == 7) 8 else if (prop0 == 8) 7
		else prop0;
	gp = a.gProperties;
	gp.firstArg ::= a.gVisible1;
	gp.secondArg ::= a.gVisible2;
	mizIncludeProperty(a, prop);
}

// FuncProperty (4892)
mizFuncProperty(a : MizAnalyzer, prop : int) -> void {
	gp = a.gProperties;
	gp.firstArg ::= a.gVisible1;
	gp.secondArg ::= a.gVisible2;
	mizIncludeProperty(a, prop);
}

// ModeProperty (4902)
mizModeProperty(a : MizAnalyzer, prop : int) -> void {
	gp = a.gProperties;
	gp.firstArg ::= 0;
	gp.secondArg ::= 0;
	mizIncludeProperty(a, prop);
}

// SetVisible2 (4912)
mizSetVisible2(a : MizAnalyzer, ff : int) -> void {
	env = a.env;
	a.statusOfProperties ::= 2;
	vis = if (ff == 82) mizLastPattern(a, noPredicate).visible          // 'R'
		else if (ff == 75) mizLastPattern(a, noFunctor).visible          // 'K'
		else { mizRunTimeError(2999); mizInitIntSeq(0) };
	if (mizSeqCount(vis) == 2) {
		a.statusOfProperties ::= 3;
		a.gVisible1 ::= mizSeqValue(vis, 0);
		a.gVisible2 ::= mizSeqValue(vis, 1);
		if (a.gVisible1 != 0 && a.gVisible2 != 0) {
			a.gFirstArg ::= getVectorUnsafe(a.locusAsConst, a.gVisible1);
			a.gSecondArg ::= getVectorUnsafe(a.locusAsConst, a.gVisible2);
			if (mizStrictEqTyp(env, mizFixedVarAt(a, a.gFirstArg).typ,
					mizFixedVarAt(a, a.gSecondArg).typ)) {
				a.statusOfProperties ::= 4;
				if (a.gNonPermissive
					&& (isNone(a.gDefiniens) || isSome(mizDefOtherwise(a))))
					a.statusOfProperties ::= 1;
			}
		}
	}
}

// SetVisible1 (4947)
mizSetVisible1(a : MizAnalyzer, ff : int) -> void {
	a.statusOfProperties ::= 2;
	if (ff != 75) mizRunTimeError(2999);
	vis = mizLastPattern(a, noFunctor).visible;
	if (mizSeqCount(vis) == 1) {
		a.statusOfProperties ::= 3;
		a.gVisible1 ::= mizSeqValue(vis, 0);
		a.gVisible2 ::= 0;
		if (a.gVisible1 != 0) {
			a.gFirstArg ::= getVectorUnsafe(a.locusAsConst, a.gVisible1);
			a.gSecondArg ::= 0;
			a.statusOfProperties ::= 4;
			if (a.gNonPermissive
				&& (isNone(a.gDefiniens) || isSome(mizDefOtherwise(a))))
				a.statusOfProperties ::= 1;
		}
	}
}

// TheFormula, the local of ProcessProperties (4966): the definiens as ONE
// formula, with the two argument loci and `it` moved onto bound variables
mizPropTheFormula(a : MizAnalyzer, boundInc : int, itNr : int,
		bound1 : int, bound2 : int) -> MizFrm {
	env = a.env;
	lFrm = if (isNone(a.gDefiniens)) {
		if (a.gRedef) {
			p = mizLastPattern(a, noPredicate);
			mizNewPredFrm(ikFrmPred, a.gWhichOne, mizLociList(a, sizeVector(p.primTypes)),
				mizNotatCount(a.gen, noPredicate));
		} else mizNewIncorFrm();
	} else {
		mizAssert(2601, isSome(mizDefOtherwise(a)));
		srt = mizDefSort(a);
		bodyFrm = \b -> switch (b) {
			MizDefFrm(f): mizCopyFrm(f);
			MizDefTrm(t): mizNewEqFrm(env, mizNewItTrm(), mizCopyTrm(t));
		};
		lOth = ref mizNewVerum();
		acc = ref mizNewVerum();
		iterVector(mizDefPartials(a), \pd -> {
			lOth := mizNewConj(^lOth, mizNewNeg(mizCopyFrm(pd.guard)));
			if (srt != 109 && srt != 101) mizRunTimeError(2511);
			acc := mizNewConj(^acc, mizNewImpl(mizCopyFrm(pd.guard), bodyFrm(pd.body)));
		});
		other = switch (mizDefOtherwise(a)) {
			Some(b): bodyFrm(b);
			None(): { mizRunTimeError(2512); mizNewIncorFrm() };
		};
		mizNewConj(^acc, mizNewImpl(^lOth, other));
	};
	a.gBoundInc ::= boundInc;
	a.gBoundForFirst ::= bound1;
	a.gBoundForSecond ::= bound2;
	a.gBoundForIt ::= itNr;
	mizWithinFrm(mizChangeLociInProperty(a), lFrm);
	lFrm;
}

mizPropFirstTyp(a : MizAnalyzer) -> MizTyp {
	mizCopyTyp(mizFixedVarAt(a, a.gFirstArg).typ);
}
mizPropSecondTyp(a : MizAnalyzer) -> MizTyp {
	mizCopyTyp(mizFixedVarAt(a, a.gSecondArg).typ);
}
mizPropFirstId(a : MizAnalyzer) -> int { mizFixedVarAt(a, a.gFirstArg).ident; }
mizPropSecondId(a : MizAnalyzer) -> int { mizFixedVarAt(a, a.gSecondArg).ident; }

// Reflexivity (5011) / Irreflexivity (5023)
mizPropReflexivity(a : MizAnalyzer, negate : bool) -> MizFrm {
	f = mizPropTheFormula(a, 1, 1, 1, 1);
	mizNewUnivI(mizPropFirstId(a), mizPropFirstTyp(a), if (negate) mizNewNeg(f) else f);
}

// the four binary predicate properties (5035-5090) — each is
// `for x,y holds L(x,y) => R(x,y)`, with the sides negated per property and
// swapped again when the definition is an antonym
mizPropBinary(a : MizAnalyzer, negLeft : bool, negRight : bool) -> MizFrm {
	l0 = mizPropTheFormula(a, 2, 1, 1, 2);
	l = if (negLeft) mizNewNeg(l0) else l0;
	r0 = mizPropTheFormula(a, 2, 1, 2, 1);
	r = if (negRight) mizNewNeg(r0) else r0;
	mizNewUnivI(mizPropFirstId(a), mizPropFirstTyp(a),
		mizNewUnivI(mizPropSecondId(a), mizPropSecondTyp(a), mizNewImpl(l, r)));
}

// Commutativity (5081)
mizPropCommutativity(a : MizAnalyzer) -> MizFrm {
	env = a.env;
	lLength = sizeVector(mizLastPattern(a, noFunctor).primTypes);
	lTypPtr = mizCopyTyp(mizItTyp(a));
	mizWithinTyp(mizSwapLociInType(a), lTypPtr);
	if (!mizEqTyp(env, mizItTyp(a), lTypPtr)) mizAError(a, a.gPropPos, 84);
	if (isNone(a.gDefiniens)) {
		if (a.gRedef) {
			a.gBoundInc ::= 2;
			a.gBoundForFirst ::= 1; a.gBoundForSecond ::= 2;
			lTrm1 = mizNewFuncTrm(a.gWhichOne, mizLociList(a, lLength));
			mizWithinTrm(mizChangeLociInProperty(a), lTrm1) |> \__ -> {};
			a.gBoundForFirst ::= 2; a.gBoundForSecond ::= 1;
			lTrm2 = mizNewFuncTrm(a.gWhichOne, mizLociList(a, lLength));
			mizWithinTrm(mizChangeLociInProperty(a), lTrm2) |> \__ -> {};
			mizNewUnivI(mizPropFirstId(a), mizPropFirstTyp(a),
				mizNewUnivI(mizPropSecondId(a), mizPropSecondTyp(a),
					mizNewEqFrm(env, lTrm1, lTrm2)));
		} else mizNewIncorFrm();
	} else {
		mizNewUniv(mizCopyTyp(mizItTyp(a)),
			mizNewUnivI(mizPropFirstId(a), mizPropFirstTyp(a),
				mizNewUnivI(mizPropSecondId(a), mizPropSecondTyp(a),
					mizNewImpl(mizPropTheFormula(a, 3, 1, 2, 3),
						mizPropTheFormula(a, 3, 1, 3, 2)))));
	}
}

// Idempotence (5117)
mizPropIdempotence(a : MizAnalyzer) -> MizFrm {
	env = a.env;
	lVisible1 = mizSeqValue(mizLastPattern(a, noFunctor).visible, 0);
	lFirstArg = getVectorUnsafe(a.locusAsConst, lVisible1);
	if (!mizIsWiderThan(env, mizItTyp(a), mizCopyTyp(mizFixedVarAt(a, lFirstArg).typ))) {
		mizAError(a, a.gPropPos, 78);
		mizNewIncorFrm();
	} else if (a.gRedef) {
		mizAError(a, a.gPropPos, 89);
		mizNewIncorFrm();
	} else if (isNone(a.gDefiniens)) mizNewIncorFrm()
	else mizNewUnivI(mizPropFirstId(a), mizCopyTyp(mizFixedVarAt(a, lFirstArg).typ),
		mizPropTheFormula(a, 1, 1, 1, 1));
}

// Involutiveness (5138)
mizPropInvolutiveness(a : MizAnalyzer) -> MizFrm {
	env = a.env;
	lVisible1 = mizSeqValue(mizLastPattern(a, noFunctor).visible, 0);
	lFirstArg = getVectorUnsafe(a.locusAsConst, lVisible1);
	if (!mizEqTyp(env, mizItTyp(a), mizFixedVarAt(a, lFirstArg).typ)) {
		mizAError(a, a.gPropPos, 85);
		mizNewIncorFrm();
	} else if (a.gRedef) {
		mizAError(a, a.gPropPos, 89);
		mizNewIncorFrm();
	} else if (isNone(a.gDefiniens)) mizNewIncorFrm()
	else mizNewUniv(mizCopyTyp(mizItTyp(a)), mizNewUniv(mizCopyTyp(mizItTyp(a)),
		mizNewImpl(mizPropTheFormula(a, 2, 1, 2, 0),
			mizPropTheFormula(a, 2, 2, 1, 0))));
}

// Projectivity (5163)
mizPropProjectivity(a : MizAnalyzer) -> MizFrm {
	env = a.env;
	lVisible1 = mizSeqValue(mizLastPattern(a, noFunctor).visible, 0);
	lFirstArg = getVectorUnsafe(a.locusAsConst, lVisible1);
	argTyp = mizFixedVarAt(a, lFirstArg).typ;
	lTyp0 = mizCopyTyp(mizItTyp(a));
	lTyp = if (lTyp0.sort != ikError) mizWideningOf(env, argTyp, lTyp0) else Some(lTyp0);
	bad = switch (lTyp) {
		None(): true;
		Some(t): t.sort == ikError || !mizEqRadices(env, t, argTyp)
			|| !mizAttrCollIsSubsetOf(env, argTyp.lower, t.upper,
				\x, y -> mizEqAttr(env, x, y));
	};
	if (bad) { mizAError(a, a.gPropPos, 85); mizNewIncorFrm() }
	else if (a.gRedef) { mizAError(a, a.gPropPos, 89); mizNewIncorFrm() }
	else if (isNone(a.gDefiniens)) mizNewIncorFrm()
	else mizNewUniv(mizCopyTyp(mizItTyp(a)), mizNewUniv(mizCopyTyp(argTyp),
		mizNewImpl(mizPropTheFormula(a, 2, 1, 2, 0),
			mizPropTheFormula(a, 2, 1, 1, 0))));
}

// Sethood (5252) — `ex the set S st for it st Definiens holds it in S`
mizPropSethoodOf(a : MizAnalyzer, f : MizFrm) -> MizFrm {
	env = a.env;
	mizNewExis(mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), mizNewEmptyCluster(),
			mizBuiltIn(env.builtIn, rqSetMode), MizTrmNil()),
		mizNewUniv(mizCopyTyp(mizItTyp(a)),
			mizNewImpl(f, mizNewPredFrm(ikFrmPred, mizBuiltIn(env.builtIn, rqBelongsTo),
				MizTrmElem(mizNewVarTrm(ikTrmBound, 2),
					MizTrmElem(mizNewVarTrm(ikTrmBound, 1), MizTrmNil())), 0))));
}

mizPropSethood(a : MizAnalyzer) -> MizFrm {
	if (isNone(a.gDefiniens)) mizNewIncorFrm()
	else {
		a.gBoundInc ::= 2;
		a.gBoundForFirst ::= 0; a.gBoundForSecond ::= 0;
		a.gBoundForIt ::= 2;
		partials = mizDefPartials(a);
		if (sizeVector(partials) == 0) {
			mizAssert(2591, isSome(mizDefOtherwise(a)));
			lFrm = switch (mizDefOtherwise(a)) {
				Some(b): switch (b) { MizDefFrm(f): mizCopyFrm(f); MizDefTrm(__): mizNewIncorFrm(); };
				None(): mizNewIncorFrm();
			};
			mizWithinFrm(mizChangeLociInPropertySethood(a), lFrm);
			mizPropSethoodOf(a, lFrm);
		} else {
			mizAssert(2592, isSome(mizDefOtherwise(a)));
			acc : ref Maybe<MizFrm> = ref None();
			lOth = ref mizNewVerum();
			iterVector(partials, \pd -> {
				lOth := mizNewConj(^lOth, mizNewNeg(mizCopyFrm(pd.guard)));
				llFrm = switch (pd.body) {
					MizDefFrm(f): mizCopyFrm(f);
					MizDefTrm(__): mizNewIncorFrm();
				};
				mizWithinFrm(mizChangeLociInProperty(a), llFrm);
				body = mizNewConj(mizCopyFrm(pd.guard), mizPropSethoodOf(a, llFrm));
				acc := Some(switch (^acc) {
					None(): body;
					Some(prev): mizNewDisj(prev, body);
				});
			});
			last = switch (mizDefOtherwise(a)) {
				Some(b): switch (b) { MizDefFrm(f): mizCopyFrm(f); MizDefTrm(__): mizNewIncorFrm(); };
				None(): mizNewIncorFrm();
			};
			mizWithinFrm(mizChangeLociInProperty(a), last);
			tail = mizNewConj(^lOth, mizPropSethoodOf(a, last));
			switch (^acc) {
				None(): tail;
				Some(prev): mizNewDisj(prev, tail);
			}
		}
	}
}

// ProcessProperties (4964)
mizProcessProperties(a : MizAnalyzer, ff : int) -> void {
	while(\ -> a.inf.curKind == 88 && a.stoppedAt == 0, \ -> {       // 'X'
		nr = a.inf.curNr;
		mizVOutElStart0(a.out, "JustifiedProperty");
		mizVOutEl1(a.out, mizProp2XmlElem(nr));
		a.statusOfProperties ::= 0;
		if (ff == 82 || ff == 75) {
			if (nr >= 1 && nr <= 9) mizSetVisible2(a, ff)
			else if (nr == 10 || nr == 11) mizSetVisible1(a, ff)
			else if (nr == 12) a.statusOfProperties ::= 1;
		} else if (ff == 77) {
			if (nr == 12) {
				a.gVisible1 ::= 0; a.gVisible2 ::= 0;
				a.gFirstArg ::= 0; a.gSecondArg ::= 0;
				a.statusOfProperties ::= if (a.gRedef) 5 else 1;
			}
		}
		a.gPropertiesOcc ::= true;
		lPropCond = if (a.statusOfProperties == 0) {
			mizInPos(a.inf);
			mizNewIncorFrm();
		} else if (a.statusOfProperties == 1) {
			mizInPos(a.inf);
			a.gPropPos ::= a.eh.curPos;
			if (nr == 0) mizNewIncorFrm()
			else if (nr == 1) { mizPredProperty(a, 1); mizPropBinary(a, a.redefAntonym, a.redefAntonym) }
			else if (nr == 2) { mizPredProperty(a, 2); mizPropReflexivity(a, a.redefAntonym) }
			else if (nr == 3) { mizPredProperty(a, 3); mizPropReflexivity(a, !a.redefAntonym) }
			else if (nr == 4) { mizFuncProperty(a, 4); mizAErrImm(a, 77); mizNewIncorFrm() }
			else if (nr == 5) { mizPredProperty(a, 5); mizAErrImm(a, 77); mizNewIncorFrm() }
			else if (nr == 6) { mizFuncProperty(a, 6); mizPropCommutativity(a) }
			else if (nr == 7) { mizPredProperty(a, 7); mizPropBinary(a, !a.redefAntonym, a.redefAntonym) }
			else if (nr == 8) { mizPredProperty(a, 8); mizPropBinary(a, a.redefAntonym, !a.redefAntonym) }
			else if (nr == 9) { mizFuncProperty(a, 9); mizPropIdempotence(a) }
			else if (nr == 10) { mizFuncProperty(a, 10); mizPropInvolutiveness(a) }
			else if (nr == 11) { mizFuncProperty(a, 11); mizPropProjectivity(a) }
			else if (nr == 12) { mizModeProperty(a, 12); mizPropSethood(a) }
			else { mizRunTimeError(2013); mizNewIncorFrm() };
		} else {
			mizInPos(a.inf);
			st = a.statusOfProperties;
			if (st == 2) {
				if (nr == 1 || nr == 2 || nr == 3 || nr == 5 || nr == 7 || nr == 8)
					mizAErrImm(a, 81)
				else if (nr == 6 || nr == 9) mizAErrImm(a, 82)
				else if (nr == 10 || nr == 11) mizAErrImm(a, 83)
				else mizRunTimeError(2999);
			} else if (st == 3) mizAErrImm(a, 79)
			else if (st == 4) mizAErrImm(a, 80)
			else if (st == 5) mizAErrImm(a, 77);
			mizNewIncorFrm();
		};
		mizAJustify(a, 0, 0, lPropCond);
		mizVOutElEnd(a.out, "JustifiedProperty");
	});
}

// ---------- Parametrization, the definitional theorems, and the block ------

// ParamDecl (476) — every parameter becomes a locus of the definition
mizParamDecl(a : MizAnalyzer, varBase : int) -> void {
	env = a.env;
	gg = a.gen.g;
	a.dPrimLength ::= gg.genCount + gg.varNbr - varBase;
	if (a.dPrimLength > a.gMaxArgNbr) mizOverflowError(479);
	fori(varBase + 1, gg.varNbr, \i -> {
		if (a.gPrimNbr >= a.gMaxArgNbr) mizOverflowError(937);
		a.gPrimNbr ::= a.gPrimNbr + 1;
		gg.genCount ::= gg.genCount + 1;
		fv = mizFixedVarAt(a, i);
		fv.skelConstNr ::= gg.genCount;
		while(\ -> sizeVector(a.locusAsConst) <= gg.genCount,
			\ -> pushVector(a.locusAsConst, 0));
		setVectorUnsafe(a.locusAsConst, gg.genCount, i);
		while(\ -> sizeVector(a.constNr) <= a.gPrimNbr, \ -> pushVector(a.constNr, 0));
		setVectorUnsafe(a.constNr, a.gPrimNbr, i);
		t = mizAdjustedType(env, fv.typ);
		mizWithinTyp(mizChangeToLoci(a), t);
		while(\ -> sizeVector(a.gPrimaries) <= a.gPrimNbr,
			\ -> pushVector(a.gPrimaries, mizNewIncorTyp()));
		setVectorUnsafe(a.gPrimaries, a.gPrimNbr, t);
	});
}

// Parametrization (5398)
mizAParametrization(a : MizAnalyzer) -> void {
	gg = a.gen.g;
	a.fixedBase ::= gg.varNbr;
	mizInPos(a.inf);
	mizVOutElStart(a.out, "Let");
	mizVOutIntAttr(a.out, "nr", gg.varNbr + 1);
	mizVOutAttrEnd(a.out);
	mizInWord(a.inf);
	while(\ -> a.inf.curKind == 81, \ -> {              // 'Q'
		lNbr = gg.varNbr;
		cnt = a.inf.curNr;
		mizSetGVarNbr(a, lNbr + cnt);
		if (gg.varNbr - a.gDefBase > a.gMaxArgNbr) mizOverflowError(937);
		fori(1, cnt, \i -> {
			mizInWord(a.inf);                            // 'I'
			fv = mizFixedVarAt(a, lNbr + i);
			fv.ident ::= a.inf.curNr;
		});
		gn = a.gen;
		gn.fraenkelTermAllowed ::= false;
		lTyp = mizReadType(a);
		gn.fraenkelTermAllowed ::= true;
		fori(lNbr + 1, gg.varNbr, \i -> {
			fv = mizFixedVarAt(a, i);
			fv.typ ::= if (lTyp.sort != ikError) {
				if (i == gg.varNbr) lTyp else mizCopyTyp(lTyp);
			} else mizNewIncorTyp();
			fv.expandable ::= false;
		});
		mizInWord(a.inf);
	});
	mizWriteQualified(a);
	mizParamDecl(a, a.fixedBase);
	mizVOutElEnd(a.out, "Let");
}

// Meaning (5442) — the definiens of a means-definition as one formula
mizMeaning(a : MizAnalyzer, def : MizDef, definiendum : MizFrm) -> MizFrm {
	mizAssert(2597, def.sort == 109);                  // 'm'
	lOth = ref mizNewVerum();
	acc = ref mizNewVerum();
	hasOther = isSome(def.otherwise);
	iterVector(def.partials, \pd -> {
		if (hasOther) lOth := mizNewConj(^lOth, mizNewNeg(mizCopyFrm(pd.guard)));
		body = switch (pd.body) {
			MizDefFrm(f): f;
			MizDefTrm(__): mizNewIncorFrm();
		};
		acc := mizNewConj(^acc, mizNewImpl(pd.guard,
			mizNewBicond(mizCopyFrm(definiendum), body)));
	});
	switch (def.otherwise) {
		Some(b): {
			body = switch (b) { MizDefFrm(f): f; MizDefTrm(__): mizNewIncorFrm(); };
			acc := mizNewConj(^acc, mizNewImpl(^lOth,
				mizNewBicond(mizCopyFrm(definiendum), body)));
		}
		None(): {}
	}
	mizWithinFrm(mizChangeDeclConstToBound(a), ^acc);
	^acc;
}

// MeaningEq (5479) — the same for an equals-definition
mizMeaningEq(a : MizAnalyzer, def : MizDef, definiendum : MizTrm) -> MizFrm {
	env = a.env;
	mizAssert(2598, def.sort == 101);                  // 'e'
	lOth = ref mizNewVerum();
	acc = ref mizNewVerum();
	hasOther = isSome(def.otherwise);
	iterVector(def.partials, \pd -> {
		if (hasOther) lOth := mizNewConj(^lOth, mizNewNeg(mizCopyFrm(pd.guard)));
		body = switch (pd.body) {
			MizDefTrm(t): mizCopyTrm(t);
			MizDefFrm(__): mizNewIncorTrm();
		};
		acc := mizNewConj(^acc, mizNewImpl(mizCopyFrm(pd.guard),
			mizNewEqFrm(env, mizCopyTrm(definiendum), body)));
	});
	switch (def.otherwise) {
		Some(b): {
			body = switch (b) { MizDefTrm(t): mizCopyTrm(t); MizDefFrm(__): mizNewIncorTrm(); };
			acc := mizNewConj(^acc, mizNewImpl(^lOth,
				mizNewEqFrm(env, mizCopyTrm(definiendum), body)));
		}
		None(): {}
	}
	mizWithinFrm(mizChangeDeclConstToBound(a), ^acc);
	^acc;
}

// CC_FormalArgs (5504) — the definition's own parameters, as constants
mizCCFormalArgs(a : MizAnalyzer) -> MizTrmList {
	gg = a.gen.g;
	l = ref MizTrmNil();
	k = ref gg.varNbr;
	while(\ -> ^k >= gg.demBase + 1, \ -> {
		if (mizFixedVarAt(a, ^k).skelConstNr != 0)
			l := MizTrmElem(mizNewVarTrm(ikTrmConstant, ^k), ^l);
		k := ^k - 1;
	});
	^l;
}

// BB_FormalArgs (5517) — the same list, with the constants made bound
mizBBFormalArgs(a : MizAnalyzer) -> MizTrmList {
	l = mizCCFormalArgs(a);
	mizWithinTrmList(mizChangeDeclConstToBound(a), l);
	l;
}

// ChangeDeclConstToLoci (5524)
mizChangeDeclConstToLoci(a : MizAnalyzer) -> MizWithin {
	mizMakeWithin(\__, t -> {
		switch (t) {
			MizBaseTrm(srt, __):
				if (srt == ikTrmIt) mizNewVarTrm(ikTrmLocus, a.gen.g.genCount) else t;
			MizVarTrm(srt, varNr, __, __): {
				if (srt == ikTrmConstant && varNr > a.gen.g.demBase
					&& mizFixedVarAt(a, varNr).skelConstNr != 0) {
					t.sort ::= ikTrmLocus;
					t.varNr ::= mizFixedVarAt(a, varNr).skelConstNr;
				}
				t;
			}
			default: t;
		}
	});
}

// CreateDefinientia (5539) — the definiens the CHECKER will expand atoms with
mizCreateDefiniens(a : MizAnalyzer, item : MizDefNodeItem) -> void {
	env = a.env;
	if (isNone(item.def) && item.constrKind == 58) {          // ':'
		a.gDefThNr ::= a.gDefThNr + 1;
	}
	switch (item.def) {
		None(): {}
		Some(ddef): {
			gg = a.gen.g;
			gg.genCount ::= item.skIt;
			a.gDefThNr ::= a.gDefThNr + 1;
			lKind = item.constrKind;
			if (lKind != 58) {
				lNr0 = item.constrNr;
				lNr = if (lKind == 77 || lKind == 82 || lKind == 86 || lKind == 75) {
					c = mizConstr(env, mizConstructorKind(lKind), lNr0);
					if (c.whichConstrNr != 0) c.whichConstrNr else lNr0;
				} else lNr0;
				aFrm = ref mizNewVerum();
				entry = ref item.prefix;
				while(\ -> isSome(^entry), \ -> {
					switch (^entry) {
						Some(e): switch (e) {
							MizRsnSnt(prev, form, __, dSnt): {
								if (form == 65)                  // 'A'
									aFrm := mizNewConj(mizCopyFrm(dSnt), ^aFrm);
								entry := prev;
							}
							MizRsnConst(prev, __, __, __, __, __): entry := prev;
						}
						None(): {}
					}
				});
				mizWithinFrm(mizChangeDeclConstToLoci(a), ^aFrm);
				partials : Vector<MizPartDef> = makeVector(sizeVector(ddef.partials));
				iterVector(ddef.partials, \pd -> {
					body : MizDefBody = if (ddef.sort == 109) {
						f = switch (pd.body) { MizDefFrm(x): mizCopyFrm(x); MizDefTrm(__): mizNewIncorFrm(); };
						mizWithinFrm(mizChangeDeclConstToLoci(a), f);
						MizDefFrm(f);
					} else if (ddef.sort == 101) {
						t = switch (pd.body) { MizDefTrm(x): mizCopyTrm(x); MizDefFrm(__): mizNewIncorTrm(); };
						MizDefTrm(mizWithinTrm(mizChangeDeclConstToLoci(a), t));
					} else { mizRunTimeError(2515); MizDefFrm(mizNewIncorFrm()) };
					lGuard = mizCopyFrm(pd.guard);
					mizWithinFrm(mizChangeDeclConstToLoci(a), lGuard);
					pushVector(partials, MizPartDef(body, lGuard));
				});
				lOther : Maybe<MizDefBody> = switch (ddef.otherwise) {
					None(): None();
					Some(b): if (ddef.sort == 109) {
						f = switch (b) { MizDefFrm(x): mizCopyFrm(x); MizDefTrm(__): mizNewIncorFrm(); };
						mizWithinFrm(mizChangeDeclConstToLoci(a), f);
						Some(MizDefFrm(f));
					} else if (ddef.sort == 101) {
						t = switch (b) { MizDefTrm(x): mizCopyTrm(x); MizDefFrm(__): mizNewIncorTrm(); };
						Some(MizDefTrm(mizWithinTrm(mizChangeDeclConstToLoci(a), t)));
					} else { mizRunTimeError(2516); None() };
				};
				prims : Vector<MizTyp> = makeVector(sizeVector(item.primaryList));
				iterVector(item.primaryList, \t -> pushVector(prims, t));
				pushVector(a.defs.all, MizDefiniens(lKind, lNr, a.articleId,
					a.gDefThNr, item.skLabId, prims, mizCopyIntSeq(item.essentials),
					^aFrm, Some(MizDef(ddef.sort, partials, lOther))));
			}
		}
	}
}

mizCreateDefinientia(a : MizAnalyzer) -> void {
	lDefBase = sizeVector(a.defs.all);
	iterVector(a.definitionList, \item -> mizCreateDefiniens(a, item));
	fori(lDefBase, sizeVector(a.defs.all) - 1, \z -> {
		d = getVectorUnsafe(a.defs.all, z);
		if (isSome(d.def)) mizVOutDefiniens(a.out, d, z + 1);
	});
}

// DefinitionalTheorems (5641)
mizProcessDefinition(a : MizAnalyzer, item : MizDefNodeItem) -> void {
	env = a.env;
	gg = a.gen.g;
	mizSetGVarNbr(a, item.skVarNbr);
	lDefProp : ref Maybe<MizProposition> = ref None();
	switch (item.def) {
		Some(ddef): {
			gg.genCount ::= item.skIt;
			k = item.constrKind;
			lFrm0 = if (k == 82) {                                  // 'R'
				mizMeaning(a, ddef, mizNewPredFrm(ikFrmPred, item.constrNr,
					mizCCFormalArgs(a), 0));
			} else if (k == 86) {                                   // 'V'
				if (item.constrNr == 0) mizNewIncorFrm()
				else {
					lFrm1 = mizNewPredFrm(ikFrmAttr, item.constrNr, mizCCFormalArgs(a), 0);
					q = switch (lFrm1) {
						MizPredFrm(__, __, __, __): mizAdjustAttrFrm(env, lFrm1);
						default: Pair(item.constrNr, MizTrmNil());
					};
					mizMeaning(a, ddef, mizNewPredFrm(ikFrmAttr, q.first,
						mizCopyTrmList(q.second), 0));
				}
			} else if (k == 75) {                                   // 'K'
				sample = mizNewFuncTrm(item.constrNr, mizCCFormalArgs(a));
				if (item.meansOccurs == 101) {                       // 'e'
					gg.genCount ::= gg.genCount - 1;
					f = mizMeaningEq(a, ddef, sample);
					gg.genCount ::= gg.genCount + 1;
					f;
				} else {
					lArgs = mizBBFormalArgs(a);
					c = mizConstr(env, coFunctor, item.constrNr);
					lTyp = switch (c.typ) {
						Some(t): mizInstTyp(env, t, lArgs);
						None(): mizNewIncorTyp();
					};
					mizNewUniv(lTyp, mizMeaning(a, ddef,
						mizNewEqFrm(env, mizNewItTrm(), sample)));
				}
			} else if (k == 77) {                                   // 'M'
				c = mizConstr(env, coMode, item.constrNr);
				upper = switch (c.typ) {
					Some(t): mizInstCluster(env, t.upper, mizCCFormalArgs(a));
					None(): mizNewEmptyCluster();
				};
				newType = mizNewStandardTyp(ikTypMode, mizNewEmptyCluster(), upper,
					item.constrNr, mizCCFormalArgs(a));
				lArgs = mizBBFormalArgs(a);
				lTyp = switch (c.typ) {
					Some(t): mizInstTyp(env, t, lArgs);
					None(): mizNewIncorTyp();
				};
				mizNewUniv(lTyp, mizMeaning(a, ddef,
					mizNewQualFrm(mizNewItTrm(), newType)));
			} else mizNewIncorFrm();
			lFrm = ref lFrm0;
			entry = ref item.prefix;
			while(\ -> isSome(^entry), \ -> {
				switch (^entry) {
					Some(e): switch (e) {
						MizRsnConst(prev, form, skList, skIdents, __, __): {
							if (form == 68)                          // 'D'
								lFrm := mizNewUnivList(skList, skIdents, ^lFrm)
							else mizRunTimeError(2010);
							entry := prev;
						}
						MizRsnSnt(prev, form, skSnt, __): {
							if (form == 65)                          // 'A'
								lFrm := mizNewImpl(mizCopyFrm(skSnt), ^lFrm)
							else mizRunTimeError(2010);
							entry := prev;
						}
					}
					None(): {}
				}
			});
			lDefProp := Some(MizProposition(item.skId, item.skLabId, a.eh.curPos, ^lFrm));
		}
		None(): if (item.constrKind == 58) {
			lDefProp := Some(MizProposition(0, 0, a.eh.curPos, mizNewVerum()));
		}
	}
	switch (^lDefProp) {
		None(): {}
		Some(p): {
			mizVOutElStart(a.out, "DefTheorem");
			k = item.constrKind;
			if (k == 75 || k == 77 || k == 82 || k == 86) {
				mizVOutAttr(a.out, "constrkind", fromCharCode(k));
				mizVOutIntAttr(a.out, "constrnr", item.constrNr);
			}
			mizVOutAttrEnd(a.out);
			mizVOutProposition(a.out, p);
			mizVOutElEnd(a.out, "DefTheorem");
		}
	}
}

mizDefinitionalTheorems(a : MizAnalyzer) -> void {
	iterVector(a.definitionList, \item -> mizProcessDefinition(a, item));
	clearVector(a.definitionList);
}

// OpenDef (337) / CloseDef (344)
mizOpenDef(a : MizAnalyzer) -> void {
	mizInWord(a.inf);
	a.gNonPermissive ::= true;
	a.gPrimNbr ::= 0;
	a.dPrimLength ::= 0;
	a.gDefBase ::= a.gen.g.varNbr;
}

mizCloseDef(a : MizAnalyzer) -> void {
	// a mode's expansion carries pids the report must not repeat
	fori(0, mizNotationKindCount - 1, \nk ->
		fori(mizNotatCommitted(a.gen, nk), mizNotatCount(a.gen, nk) - 1, \k -> {
			p = mizNotatAt(a.gen, nk, k);
			if (nk == noMode) switch (p.expansion) {
				Some(t): { mizClearPids(t.lower); mizClearPids(t.upper); }
				None(): {}
			}
		}));
	mizNotatAddExtItems(a.gen);
	a.gPrimNbr ::= 0;
	a.dPrimLength ::= 0;
	mizClustersAddExtItems(a.env, a.clusters);
}

// MAttrCollection.ClearPids (correl.pas 2679)
mizClearPids(c : MizAttrColl) -> void {
	iterVector(c.items, \at -> if (at.pattNr > 0) at.pattNr ::= 0);
}

// Do_Patterns (5744) — every pattern this item added
mizDoPatterns(a : MizAnalyzer, base : [int]) -> void {
	fori(0, mizNotationKindCount - 1, \nk ->
		fori(mizNotatCommitted(a.gen, nk) + base[nk], mizNotatCount(a.gen, nk) - 1,
			\k -> mizVOutPattern(a.out, mizNotatAt(a.gen, nk, k), k + 1)));
}

mizNotatExtCounts(a : MizAnalyzer) -> [int] {
	map(enumFromTo(0, mizNotationKindCount - 1),
		\nk -> mizNotatCount(a.gen, nk) - mizNotatCommitted(a.gen, nk));
}

// Definition (5735) — the definition block's main loop
mizADefinition(a : MizAnalyzer) -> void {
	env = a.env;
	gg = a.gen.g;
	mizInPos(a.inf);
	a.definiendumArgs ::= MizTrmNil();
	l = mizCopyLevel(gg);
	l.locPredNbr ::= sizeVector(env.locPredDef);
	l.locFuncNbr ::= sizeVector(env.locFuncDef);
	mizOpenDef(a);
	mizVOutElStart(a.out, "DefinitionBlock");
	mizVOutPosAsAttrs(a.out, a.eh.curPos);
	mizVOutAttrEnd(a.out);
	mark = mizTTCollMark(env);
	gg.lastEntry ::= None();
	gg.genCount ::= 0;
	gg.demBase ::= gg.varNbr;
	clearVector(a.definitionList);
	while(\ -> a.inf.curKind != ikMscEndBlock && a.stoppedAt == 0, \ -> {
		a.gRedef ::= false;
		mizClearCorrConds(a);
		notatBase = mizNotatExtCounts(a);
		a.gWhichOne ::= 0;
		a.gSuperfluous ::= 0;
		a.gPropertiesOcc ::= false;
		{ dnq23 = a.dn; dnq23.meansOccurs ::= 32; }
		k = a.inf.curKind;
		gn = a.gen;
		defItem = \kindCh : int, redef : bool, expandable : bool, read : () -> void,
				label : bool, prop : int, insert : () -> void, tail : () -> void,
				write : bool -> {
			mizVOutElStart(a.out, "Definition");
			mizVOutAttr(a.out, "kind", fromCharCode(kindCh));
			if (redef) mizVOutAttr(a.out, "redefinition", "true");
			if (expandable) mizVOutAttr(a.out, "expandable", "true");
			gn.exportableItem ::= true;
			gn.constInExportableItemOcc ::= false;
			read();
			gn.exportableItem ::= false;
			gn.constInExportableItemOcc ::= false;
			if (label) mizAWriteDefiniensLabel(a);
			mizVOutAttrEnd(a.out);
			mizACorrectness(a);
			mizProcessProperties(a, prop);
			insert();
			tail();
			if (write) mizAWriteDefiniens(a);
			if (a.stoppedAt == 0) {
				mizDoPatterns(a, notatBase);
				mizVOutElEnd(a.out, "Definition");
			}
		};
		if (k == ikItmGeneralization) {
			lDeclBase = gg.varNbr;
			gn.exportableItem ::= true;
			gn.constInExportableItemOcc ::= false;
			mizAParametrization(a);
			gn.exportableItem ::= false;
			gn.constInExportableItemOcc ::= false;
			mizSkelList(a, 68, lDeclBase);                    // 'D'
		} else if (k == ikItmAssumption) {
			a.gNonPermissive ::= false;
			mizInPos(a.inf);
			mizVOutElStart0(a.out, "Assume");
			mizInWord(a.inf);
			gn.exportableItem ::= true;
			gn.constInExportableItemOcc ::= false;
			conds = mizReadPropositions(a);
			gn.exportableItem ::= false;
			gn.constInExportableItemOcc ::= false;
			mizVOutPropositions(a.out, conds);
			mizVOutElEnd(a.out, "Assume");
			mizInWord(a.inf);
			mizSkelSnt(a, 65, mizConjugatePropositions(conds));   // 'A'
		} else if (k == ikItmExAssumption) {
			a.gNonPermissive ::= false;
			lVarBase = gg.varNbr;
			mizInPos(a.inf);
			mizVOutElStart(a.out, "Given");
			mizVOutIntAttr(a.out, "nr", gg.varNbr + 1);
			mizVOutAttrEnd(a.out);
			gn.exportableItem ::= true;
			gn.constInExportableItemOcc ::= false;
			mizGetQualifiedList(a, -1);
			conds = mizReadPropositions(a);
			gn.exportableItem ::= false;
			gn.constInExportableItemOcc ::= false;
			mizInWord(a.inf);
			lFrm = mizXFormula(a, mizConjugatePropositions(conds));
			mizVOutPropos(a.out, 0, 0, a.eh.curPos, lFrm);
			mizSkelSnt(a, 65, lFrm);
			mizWriteQualified(a);
			mizVOutPropositions(a.out, conds);
			mizVOutElEnd(a.out, "Given");
			fori(lVarBase + 1, gg.varNbr, \i -> {
				fv = mizFixedVarAt(a, i); fv.skelConstNr ::= 0;
			});
		} else if (k == ikItmDefMode) {
			defItem(77, false, false, \ -> mizDefModePattern(a), true, 77,
				\ -> mizInsertMode(a), \ -> mizDefModeTail(a), true);
		} else if (k == ikItmRedefMode) {
			defItem(77, true, false, \ -> mizRedefModePattern(a), true, 77,
				\ -> if (a.gSuperfluous != 0 || a.gSpecified) mizInsertMode(a),
				\ -> mizDefModeTail(a), true);
		} else if (k == ikItmDefExpandMode) {
			defItem(77, false, true, \ -> mizDefExpandableMode(a), true, 77,
				\ -> {}, \ -> {}, false);
		} else if (k == ikItmDefPrAttr) {
			defItem(86, false, false, \ -> mizDefPredAttributePattern(a), true, 86,
				\ -> mizInsertPredAttribute(a), \ -> mizDefAttrTail(a), true);
		} else if (k == ikItmRedefPrAttr) {
			defItem(86, true, false, \ -> mizRedefPredAttributePattern(a), true, 86,
				\ -> if (a.gSuperfluous != 0) mizInsertPredAttribute(a),
				\ -> mizDefAttrTail(a), true);
		} else if (k == ikItmDefPred) {
			defItem(82, false, false, \ -> mizDefPredPattern(a), true, 82,
				\ -> mizInsertConstructorFor(a, coPredicate, noPredicate),
				\ -> mizDefPredTail(a), true);
		} else if (k == ikItmDefFunc) {
			defItem(75, false, false, \ -> mizDefFuncPattern(a), true, 75,
				\ -> mizInsertFunctor(a), \ -> mizDefFuncTail(a), true);
		} else if (k == ikItmRedefPred) {
			defItem(82, true, false, \ -> mizRedefPredPattern(a), true, 82,
				\ -> if (a.gSuperfluous != 0 || a.gPropertiesOcc)
					mizInsertConstructorFor(a, coPredicate, noPredicate),
				\ -> mizDefPredTail(a), true);
		} else if (k == ikItmRedefFunc) {
			defItem(75, true, false, \ -> mizRedefFuncPattern(a), true, 75,
				\ -> if (a.gSuperfluous != 0 || a.gSpecified || a.gPropertiesOcc)
					mizInsertFunctor(a),
				\ -> mizDefFuncTail(a), true);
		} else if (k == ikItmCanceled) {
			mizInWord(a.inf);
			ck = a.inf.curKind;
			if (ck == 68) {                                   // 'D'
				{ dnq24 = a.dn; dnq24.kind ::= 58; }               // ':'
				mizPushCanceledDefNode(a);
			} else if (ck == 84) mizAErrImm(a, 278)            // 'T'
			else if (ck == 83) mizAErrImm(a, 279);             // 'S'
			mizInWord(a.inf);
		} else if (k == 69 || k == ikItmPrivConstant || k == ikItmPrivFunc
			|| k == ikItmPrivPred || k == ikItmReconsidering || k == ikItmChoice) {
			mizAStatement(a);
		} else a.stoppedAt ::= k;
	});
	if (a.stoppedAt == 0) {
		mizInPos(a.inf);
		mizInWord(a.inf);
		mizVOutEndPos(a.out, a.eh.curPos);
		mizVOutElEnd(a.out, "DefinitionBlock");
		mizCreateDefinientia(a);
		pVarNbr = gg.varNbr;
		mizDefinitionalTheorems(a);
		mizSetGVarNbr(a, pVarNbr);
		gg.lastEntry ::= None();
		a.definiendumArgs ::= MizTrmNil();
		mizCloseDef(a);
		mizDisposeLevel(a, l, mark);
	}
}

// the DefNode a `canceled` definition still leaves behind (DefNode.Init 1059,
// called with fKind = ':' and no definiens)
mizPushCanceledDefNode(a : MizAnalyzer) -> void {
	dn = a.dn;
	prims : Vector<MizTyp> = makeVector(sizeVector(dn.primaries));
	iterVector(dn.primaries, \t -> pushVector(prims, t));
	pushVector(a.definitionList, MizDefNodeItem(32, dn.kind, a.gWhichOne, 0, 0,
		None(), mizGVarNbr(a), a.gen.g.genCount + 1, a.gen.g.lastEntry,
		mizCopyIntSeq(a.gEssentials), prims));
}

// Notation (6376) — a block of synonyms and antonyms: each item resolves an
// existing constructor and writes ONE pattern
mizANotation(a : MizAnalyzer) -> void {
	env = a.env;
	gg = a.gen.g;
	mizInPos(a.inf);
	a.definiendumArgs ::= MizTrmNil();
	l = mizCopyLevel(gg);
	l.locPredNbr ::= sizeVector(env.locPredDef);
	l.locFuncNbr ::= sizeVector(env.locFuncDef);
	mizOpenDef(a);
	mizVOutElStart(a.out, "NotationBlock");
	mizVOutPosAsAttrs(a.out, a.eh.curPos);
	mizVOutAttrEnd(a.out);
	mark = mizTTCollMark(env);
	gg.lastEntry ::= None();
	gg.genCount ::= 0;
	gg.demBase ::= gg.varNbr;
	clearVector(a.definitionList);
	while(\ -> a.inf.curKind != ikMscEndBlock && a.stoppedAt == 0, \ -> {
		// noForgetFunctor is the "no pattern written" marker
		nk = ref noForgetFunctor;
		a.gWhichOne ::= 0;
		a.gSuperfluous ::= 0;
		k = a.inf.curKind;
		gn = a.gen;
		notatItem = \kind : int, read : () -> void -> {
			gn.exportableItem ::= true;
			gn.constInExportableItemOcc ::= false;
			read();
			gn.exportableItem ::= false;
			gn.constInExportableItemOcc ::= false;
			nk := kind;
		};
		if (k == ikItmGeneralization) {
			gn.exportableItem ::= true;
			gn.constInExportableItemOcc ::= false;
			mizAParametrization(a);
			gn.exportableItem ::= false;
			gn.constInExportableItemOcc ::= false;
		} else if (k == ikItmDefMode) {
			notatItem(noMode, \ -> mizNotatModePattern(a));
		} else if (k == ikItmDefPred) {
			notatItem(noPredicate, \ -> mizNotatPredPattern(a));
		} else if (k == ikItmDefPrAttr) {
			notatItem(noAttribute, \ -> mizNotatPredAttributePattern(a));
		} else if (k == ikItmDefFunc) {
			notatItem(noFunctor, \ -> mizNotatFuncPattern(a));
		} else if (k == 69 || k == ikItmPrivConstant || k == ikItmPrivFunc
			|| k == ikItmPrivPred || k == ikItmReconsidering || k == ikItmChoice) {
			mizAStatement(a);
		} else a.stoppedAt ::= k;
		if (^nk != noForgetFunctor && a.stoppedAt == 0) {
			n = mizNotatCount(a.gen, ^nk);
			mizVOutPattern(a.out, mizNotatAt(a.gen, ^nk, n - 1), n);
		}
	});
	if (a.stoppedAt == 0) {
		mizInPos(a.inf);
		mizInWord(a.inf);
		mizVOutEndPos(a.out, a.eh.curPos);
		mizVOutElEnd(a.out, "NotationBlock");
		a.definiendumArgs ::= MizTrmNil();
		mizCloseDef(a);
		mizDisposeLevel(a, l, mark);
	}
}

// ============ the REGISTRATION block (2006-2311, 6155-6376) ================

// InitLociForCluster (1173) — mark the loci the cluster itself reaches
mizInitLociForCluster(a : MizAnalyzer, c : MizAttrColl) -> void {
	cc = mizCopyCluster(c);
	mizWithinCluster(mizChangeToLoci(a), cc);
	mizWithinCluster(mizSetLociOccW(a), cc);
}

// AllLociAccessibleInTyp (1181) / AllLociAccessibleInTrm (1199)
mizAllLociAccessibleIn(a : MizAnalyzer, typList : Vector<MizTyp>,
		seed : () -> void) -> bool {
	seed();
	res = ref true;
	stop = ref false;
	i = ref (sizeVector(typList) - 1);
	while(\ -> !^stop && ^i >= 0, \ -> {
		t = getVectorUnsafe(typList, ^i);
		if (t.sort == ikError) { res := false; stop := true; }
		else if (!mizLociOccAt(a, ^i + 1)) { res := false; stop := true; }
		else {
			mizWithinTyp(mizSetLociOccW(a), t);
			i := ^i - 1;
		}
	});
	^res;
}

mizAllLociAccessibleInTyp(a : MizAnalyzer, typList : Vector<MizTyp>,
		typ : MizTyp) -> bool {
	mizAllLociAccessibleIn(a, typList, \ -> {
		t = mizCopyTyp(typ);
		mizWithinTyp(mizChangeToLoci(a), t);
		mizWithinTyp(mizSetLociOccW(a), t);
	});
}

mizAllLociAccessibleInTrm(a : MizAnalyzer, typList : Vector<MizTyp>,
		trm : MizTrm) -> bool {
	mizAllLociAccessibleIn(a, typList, \ -> {
		t = mizCopyTrm(trm);
		mizWithinTrm(mizChangeToLoci(a), t) |> \__ -> {};
		mizWithinTrm(mizSetLociOccW(a), t) |> \__ -> {};
	});
}

// AnalyzeCluster (2006) — the written adjectives of a registration, with the
// sign flipped exactly as AnalyzeAttributes does, but NOT inserted anywhere
mizAnalyzeClusterAttrs(a : MizAnalyzer, list : Vector<MizAttrNode>,
		typ : MizTyp) -> Vector<MizAttr> {
	lTyp = mizCopyTyp(typ);
	res : Vector<MizAttr> = makeVector(sizeVector(list));
	stop = ref false;
	z = ref (sizeVector(list) - 1);
	while(\ -> !^stop && ^z >= 0, \ -> {
		node = getVectorUnsafe(list, ^z);
		switch (mizAnalyzeAttribute(a.gen, node, lTyp)) {
			None(): {
				if (lTyp.sort != ikError && node.nInt != 0)
					mizAError(a, node.pos, 115);
				stop := true;
			}
			Some(attr): {
				if (node.neg) { if (attr.neg != 0) attr.neg ::= 1 }
				else { attr.neg ::= if (attr.neg == 0) 1 else 0 }
				if (!lTyp.lower.consistent) {
					mizAError(a, node.pos, 95);
					lTyp.sort ::= ikError;
					stop := true;
				} else {
					mizVectorAtInsert(res, 0, attr);
					z := ^z - 1;
				}
			}
		}
	});
	res;
}

// AddToCluster (2047)
mizAddToCluster(a : MizAnalyzer, list : Vector<MizAttr>, c : MizAttrColl) -> void {
	iterVector(list, \at -> mizAttrCollInsert(a.env, c, at));
	if (!c.consistent) mizAErrImm(a, 95);
}

// RClusterObj.RegisterCluster (correl.pas 1622)
mizRegisterRCluster(a : MizAnalyzer, absNr : int, clu : MizAttrColl,
		prim : Vector<MizTyp>, typ : MizTyp) -> MizRCluster {
	env = a.env;
	mizSetLocArgTyp(env, prim);
	lower = mizCopyCluster(clu);
	mizAttrCollEnlargeBy(env, lower, typ.upper);
	upper = mizCopyCluster(clu);
	mizAttrCollEnlargeBy(env, upper, typ.upper);
	mizRoundUpCluster(env, a.clusters, upper, typ);
	if (!upper.consistent) mizAError(a, a.eh.curPos, 95);
	mizWithinCluster(mizChangeToLoci(a), lower);
	mizWithinCluster(mizChangeToLoci(a), upper);
	lTyp = mizAdjustedType(env, typ);
	lTyp.lower ::= mizNewEmptyCluster();
	lTyp.upper ::= mizNewEmptyCluster();
	mizWithinTyp(mizChangeToLoci(a), lTyp);
	MizRCluster(a.articleId, absNr, prim, MizClusterRec(lower, upper), lTyp);
}

// CClusterObj.RegisterCluster (correl.pas 1670)
mizRegisterCCluster(a : MizAnalyzer, absNr : int, ante : MizAttrColl,
		cons : MizAttrColl, prim : Vector<MizTyp>, typ : MizTyp) -> MizCCluster {
	lower = cons;
	upper = mizCopyCluster(cons);
	lTyp = mizCopyTyp(typ);
	mizWithinCluster(mizChangeToLoci(a), lower);
	mizWithinCluster(mizChangeToLoci(a), upper);
	mizWithinTyp(mizChangeToLoci(a), lTyp);
	mizWithinCluster(mizChangeToLoci(a), ante);
	MizCCluster(a.articleId, absNr, prim, ante, MizClusterRec(lower, upper), lTyp);
}

// FClusterObj.RegisterCluster (correl.pas 1705)
mizRegisterFCluster(a : MizAnalyzer, absNr : int, clu : MizAttrColl,
		prim : Vector<MizTyp>, trm : MizTrm, typ : Maybe<MizTyp>) -> MizFCluster {
	env = a.env;
	srt = mizTrmSort(trm);
	if (srt == ikTrmFunctor || srt == ikTrmSelector || srt == ikTrmAggreg) {
		clusterTerm = switch (trm) {
			MizFuncTrm(s2, __, __, __, __): if (s2 == ikTrmFunctor) {
				q = mizAdjustTrm(env, trm);
				mizNewFuncTrm(q.first, mizCopyTrmList(q.second));
			} else mizCopyTrm(trm);
			default: mizCopyTrm(trm);
		};
		mizSetLocArgTyp(env, prim);
		clusterType = switch (typ) { Some(t): Some(mizCopyTyp(t)); None(): None(); };
		lTyp = switch (clusterType) {
			Some(t): t;
			None(): mizRoundUpTrmType(env, a.clusters, clusterTerm);
		};
		lower = mizCopyCluster(clu);
		upper = mizCopyCluster(clu);
		mizAttrCollEnlargeBy(env, upper, lTyp.upper);
		mizRoundUpCluster(env, a.clusters, upper, lTyp);
		if (!upper.consistent) mizAError(a, a.eh.curPos, 95);
		mizWithinTrm(mizChangeToLoci(a), clusterTerm) |> \__ -> {};
		mizWithinCluster(mizChangeToLoci(a), lower);
		mizWithinCluster(mizChangeToLoci(a), upper);
		switch (clusterType) {
			Some(t): mizWithinTyp(mizChangeToLoci(a), t);
			None(): {}
		}
		MizFCluster(a.articleId, absNr, prim, MizClusterRec(lower, upper),
			clusterTerm, clusterType);
	} else {
		MizFCluster(a.articleId, absNr, makeVector(0),
			MizClusterRec(mizNewEmptyCluster(), mizNewEmptyCluster()),
			mizNewIncorTrm(), None());
	}
}

// the attributive formula a cluster registration proves: `B1 is <adjectives>`
mizClusterAttrFrm(a : MizAnalyzer, pos : MizPos,
		list : Vector<MizAttrNode>) -> MizFrm {
	mizAnalyzeFrm(a.gen, MizExpAttred(ikFrmAttr, pos,
		MizExpSimple(ikTrmBound, pos, 1), list));
}

// DefExistentialCluster (2058)
mizDefExistentialCluster(a : MizAnalyzer) -> void {
	env = a.env;
	lErrorOcc = ref false;
	mizInPos(a.inf);
	lPos = a.eh.curPos;
	lList = mizLoadIPNColl(a.inf);
	lTyp = mizReadType(a);
	mizInWord(a.inf);
	llTyp = mizAdjustedType(env, lTyp);
	mizASetBVN(a, 1);
	mizSetBoundVar(env, 1, lTyp);
	lFrm = mizClusterAttrFrm(a, lPos, lList);
	lClusterPtr = mizCopyCluster(llTyp.lower);
	lAttrs = mizAnalyzeClusterAttrs(a, lList, lTyp);
	mizAddToCluster(a, lAttrs, lClusterPtr);
	mizSetCorrCond(a, 4, mizNewNeg(mizNewUniv(lTyp, mizNewNeg(lFrm))));
	setVectorUnsafe(a.corrCondSet, 4, true);
	lTypList = mizCreateLociList(a, 1, a.dPrimLength);
	mizInitAccess(a);
	mizInitLociForCluster(a, lClusterPtr);
	if (!mizAllLociAccessibleInTyp(a, lTypList, llTyp)) {
		lErrorOcc := true;
		mizAErrImm(a, 100);
	}
	if (llTyp.sort == ikError || a.gen.constInExportableItemOcc) lErrorOcc := true;
	if (!^lErrorOcc) {
		lAbsNr = 1 + sizeVector(a.clusters.registered)
			+ sizeVector(a.clusters.registeredExt) - a.regClusterBase;
		r = mizRegisterRCluster(a, lAbsNr, lClusterPtr, lTypList, llTyp);
		mizInsertRClusterExt(a.clusters, r);
		mizVOutRCluster(a.out, r);
	} else mizVOutErrCluster(a.out, "RCluster", a.articleId);
	mizASetBVN(a, 0);
}

// DefConditionalCluster (2116)
mizDefConditionalCluster(a : MizAnalyzer) -> void {
	env = a.env;
	lErrorOcc = ref false;
	mizInPos(a.inf);
	lPos = a.eh.curPos;
	lList = mizLoadIPNColl(a.inf);
	lList1 = mizLoadIPNColl(a.inf);
	lTyp = mizReadType(a);
	llTyp = mizAdjustedType(env, lTyp);
	lClusterPtr = mizCopyCluster(llTyp.lower);
	lAttrs1 = mizAnalyzeClusterAttrs(a, lList, lTyp);
	mizAddToCluster(a, lAttrs1, lClusterPtr);
	lClusterPtr1 = mizCopyCluster(llTyp.lower);
	lAttrs2 = mizAnalyzeClusterAttrs(a, lList1, lTyp);
	mizAddToCluster(a, lAttrs2, lClusterPtr1);
	mizASetBVN(a, 1);
	mizSetBoundVar(env, 1, lTyp);
	lFrm = mizClusterAttrFrm(a, lPos, lList);
	lFrm1 = mizClusterAttrFrm(a, lPos, lList1);
	mizSetCorrCond(a, 1, mizNewUniv(lTyp, mizNewImpl(lFrm, lFrm1)));
	setVectorUnsafe(a.corrCondSet, 1, true);
	llTyp.lower ::= mizNewEmptyCluster();
	llTyp.upper ::= mizNewEmptyCluster();
	lTypList = mizCreateLociList(a, 1, a.dPrimLength);
	mizInitAccess(a);
	mizInitLociForCluster(a, lClusterPtr);
	if (!mizAllLociAccessibleInTyp(a, lTypList, llTyp)) {
		lErrorOcc := true;
		mizAErrImm(a, 100);
	}
	if (llTyp.sort == ikError || a.gen.constInExportableItemOcc) lErrorOcc := true;
	if (!^lErrorOcc) {
		lAbsNr = 1 + sizeVector(a.clusters.conditional)
			+ sizeVector(a.clusters.conditionalExt) - a.condClusterBase;
		c = mizRegisterCCluster(a, lAbsNr, lClusterPtr, lClusterPtr1, lTypList, llTyp);
		mizInsertCClusterExt(a.clusters, c);
		mizVOutCCluster(a.out, c);
	} else mizVOutErrCluster(a.out, "CCluster", a.articleId);
	mizInWord(a.inf);
	mizASetBVN(a, 0);
}

// DefFunctorCluster (2182)
mizDefFunctorCluster(a : MizAnalyzer) -> void {
	env = a.env;
	lErrorOcc = ref false;
	mizInPos(a.inf);
	mizASetBVN(a, 0);
	lTrm0 = mizAnalyzeTrm(a.gen, mizLoadTerm(a.inf));
	srt0 = mizTrmSort(lTrm0);
	lTrm = if (srt0 == ikTrmFunctor || srt0 == ikTrmSelector || srt0 == ikTrmAggreg
			|| srt0 == ikError) lTrm0
		else { mizAErrImm(a, 96); lErrorOcc := true; mizNewIncorTrm() };
	llTrm = switch (lTrm) {
		MizFuncTrm(s2, __, __, __, __): if (s2 == ikTrmFunctor) {
			q = mizAdjustTrm(env, lTrm);
			mizNewFuncTrm(q.first, mizCopyTrmList(q.second));
		} else mizCopyTrm(lTrm);
		default: mizCopyTrm(lTrm);
	};
	lList = mizLoadIPNColl(a.inf);
	mizInWord(a.inf);
	llTyp : Maybe<MizTyp> = if (a.inf.curKind == 46) {          // '.'
		t = mizReadType(a);
		mizInWord(a.inf);
		if (t.sort == ikError) None() else Some(t);
	} else None();
	lTyp = switch (llTyp) {
		Some(t): mizCopyTyp(t);
		None(): mizGetTrmType(env, llTrm);
	};
	lClusterPtr = mizCopyCluster(lTyp.lower);
	lAttrs = mizAnalyzeClusterAttrs(a, lList, lTyp);
	condFrm = switch (llTyp) {
		Some(__): {
			mizASetBVN(a, 1);
			mizSetBoundVar(env, 1, lTyp);
			lFrm = mizNewEqFrm(env, mizNewVarTrm(ikTrmBound, 1), mizCopyTrm(lTrm));
			conjuncts : Vector<MizFrm> = makeVector(sizeVector(lAttrs));
			iterVector(lAttrs, \at -> {
				f = mizNewPredFrm(ikFrmAttr, at.attrNr,
					mizAddToTrmList(mizCopyTrmList(at.args),
						mizNewVarTrm(ikTrmBound, 1)), 0);
				pushVector(conjuncts, if (at.neg == 0) mizNewNeg(f) else f);
			});
			res = mizNewUniv(mizCopyTyp(lTyp),
				mizNewImpl(lFrm, mizNewConjFrm(conjuncts)));
			mizASetBVN(a, 0);
			res;
		}
		None(): {
			conjuncts : Vector<MizFrm> = makeVector(sizeVector(lAttrs));
			iterVector(lAttrs, \at -> {
				f = mizNewPredFrm(ikFrmAttr, at.attrNr,
					mizAddToTrmList(mizCopyTrmList(at.args), mizCopyTrm(lTrm)), 0);
				pushVector(conjuncts, if (at.neg == 0) mizNewNeg(f) else f);
			});
			mizNewConjFrm(conjuncts);
		}
	};
	mizSetCorrCond(a, 1, condFrm);
	setVectorUnsafe(a.corrCondSet, 1, true);
	mizAddToCluster(a, lAttrs, lClusterPtr);
	lTypList = mizCreateLociList(a, 1, a.dPrimLength);
	mizInitAccess(a);
	if (!mizAllLociAccessibleInTrm(a, lTypList, llTrm)) {
		lErrorOcc := true;
		mizAErrImm(a, 100);
	}
	if (mizTrmSort(llTrm) == ikError || a.gen.constInExportableItemOcc)
		lErrorOcc := true;
	if (!^lErrorOcc) {
		lAbsNr = 1 + sizeVector(a.clusters.functor)
			+ sizeVector(a.clusters.functorExt) - a.funcClusterBase;
		f = mizRegisterFCluster(a, lAbsNr, lClusterPtr, lTypList, llTrm, llTyp);
		mizInsertFClusterExt(a.clusters, f);
		mizVOutFCluster(a.out, f);
	} else mizVOutErrCluster(a.out, "FCluster", a.articleId);
}

// Registration (6184)
mizARegistration(a : MizAnalyzer) -> void {
	env = a.env;
	gg = a.gen.g;
	mizInPos(a.inf);
	a.gMaxArgNbr ::= 2 * MaxArgNbr;
	a.definiendumArgs ::= MizTrmNil();
	l = mizCopyLevel(gg);
	l.locPredNbr ::= sizeVector(env.locPredDef);
	l.locFuncNbr ::= sizeVector(env.locFuncDef);
	mizOpenDef(a);
	mizVOutElStart(a.out, "RegistrationBlock");
	mizVOutPosAsAttrs(a.out, a.eh.curPos);
	mizVOutAttrEnd(a.out);
	mark = mizTTCollMark(env);
	gg.genCount ::= 0;
	gg.demBase ::= gg.varNbr;
	clearVector(a.definitionList);
	while(\ -> a.inf.curKind != ikMscEndBlock && a.stoppedAt == 0, \ -> {
		mizClearCorrConds(a);
		k = a.inf.curKind;
		gn = a.gen;
		regItem = \el : string, read : () -> void -> {
			mizVOutElStart0(a.out, el);
			gn.exportableItem ::= true;
			gn.constInExportableItemOcc ::= false;
			read();
			gn.exportableItem ::= false;
			gn.constInExportableItemOcc ::= false;
			mizACorrectness(a);
			mizVOutElEnd(a.out, el);
		};
		if (k == ikItmGeneralization) {
			gn.exportableItem ::= true;
			gn.constInExportableItemOcc ::= false;
			mizAParametrization(a);
			gn.exportableItem ::= false;
			gn.constInExportableItemOcc ::= false;
		} else if (k == ikItmCluRegistered) {
			regItem("Registration", \ -> mizDefExistentialCluster(a));
		} else if (k == ikItmCluConditional) {
			regItem("Registration", \ -> mizDefConditionalCluster(a));
		} else if (k == ikItmCluFunctor) {
			regItem("Registration", \ -> mizDefFunctorCluster(a));
			// RETROSPECTIVE ROUNDING: every term already collected is
			// re-rounded with the cluster just registered
			iterVector(env.ttColl, \it -> mizRoundUpItem(a, it));
		} else if (k == 69 || k == ikItmPrivConstant || k == ikItmPrivFunc
			|| k == ikItmPrivPred || k == ikItmReconsidering || k == ikItmChoice) {
			mizAStatement(a);
		} else a.stoppedAt ::= k;
	});
	if (a.stoppedAt == 0) {
		mizInPos(a.inf);
		mizInWord(a.inf);
		mizVOutEndPos(a.out, a.eh.curPos);
		mizVOutElEnd(a.out, "RegistrationBlock");
		lRoundUpClusters = sizeVector(a.clusters.conditionalExt) > 0
			|| sizeVector(a.clusters.functorExt) > 0;
		a.definiendumArgs ::= MizTrmNil();
		mizCloseDef(a);
		mizDisposeLevel(a, l, mark);
		a.gMaxArgNbr ::= MaxArgNbr;
		if (lRoundUpClusters) {
			mizTypRoundUp(env, a.clusters, env.nonZeroTyp);
			iterVector(a.clusters.registered, \r -> {
				mizSetLocArgTyp(env, r.primaries);
				mizRoundUpCluster(env, a.clusters, r.consequent.upper, r.clusterType);
				mizTTCollFreeAll(env);
			});
		}
		mizTTCollRelease(env, mark);
	}
}

// RoundUpItem (6155) — re-round one collected term's type against the
// FUNCTOR clusters, the PENDING ones included
mizRoundUpItem(a : MizAnalyzer, item : MizTTPair) -> void {
	env = a.env;
	cl = a.clusters;
	lClusterPtr = mizCopyCluster(item.typ.upper);
	stop = ref false;
	switch (mizFClusterInterval(env, cl, item.trm)) {
		Some(iv): fori(iv.first, iv.second, \i -> {
			if (!^stop) {
				mizFClusterRoundUpWith(env, getVectorUnsafe(cl.functor, i),
					item.trm, item.typ, lClusterPtr) |> \__ -> {};
				if (!lClusterPtr.consistent) stop := true;
			}
		});
		None(): {}
	}
	iterVector(cl.functorExt, \fc -> {
		if (!^stop) {
			mizFClusterRoundUpWith(env, fc, item.trm, item.typ, lClusterPtr) |> \__ -> {};
			if (!lClusterPtr.consistent) stop := true;
		}
	});
	{ t = item.typ; t.upper ::= lClusterPtr; }
}

// gTermCollection.FreeAll
mizTTCollFreeAll(env : MizCorrelEnv) -> void { clearVector(env.ttColl); }
