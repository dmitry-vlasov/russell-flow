// Transcription of ~/dev/system/kernel/analyzer.pas — THE ANALYZER: it reads
// the `.par` token stream Transfer2Analyzer wrote, resolves every expression
// against the notation patterns (generato.flow), checks the correctness
// conditions, and writes the `<article>.xml` analyzer report the CHECKER
// consumes (iocorrel_write.flow).
//
// The unit's globals (analyzer.pas 58-80) become MizAnalyzer, one per article,
// as CONVENTIONS.md requires. The `g` level record lives on MizGen, because
// generato declares it and both units write it.
//
// STATUS: the driver's spine — the main dispatch loop and the items that need
// no definitional machinery. The remaining item kinds abort with the Pascal's
// own RunTimeError code so a partial run says exactly where it stopped.

import ds/vector;
import string;
import loop;
import mizar/original/errhan;
import mizar/original/mobjects;
import mizar/original/lexicon;
import mizar/original/limits;
import mizar/original/enums;
import mizar/original/builtin;
import mizar/original/correl;
import mizar/original/correl_inst;
import mizar/original/correl_match;
import mizar/original/correl_patt;
import mizar/original/roundcl;
import mizar/original/identify;
import mizar/original/definientia;
import mizar/original/schemes;
import mizar/original/justhan;
import mizar/original/generato;
import mizar/original/iocorrel_write;

export {
	// PropertiesRec (correl.pas) — what a definition declared
	MizPropertiesRec(mutable properties : int, mutable firstArg : int,
		mutable secondArg : int);

	MizAnalyzer(
		env : MizCorrelEnv,
		eh : MizErrHan,
		clusters : MizClusters,
		gen : MizGen,
		out : MizVrfOut,
		inf : MizInStream,
		defs : MizDefinientia,
		idents : MizIdentify,
		schemes : MizSchemes,
		articleId : string,

		// ---- analyzer.pas 58-80 ----
		mutable redefAntonym : bool,
		mutable gRedef : bool,
		mutable gSpecified : bool,
		mutable gPropertiesOcc : bool,
		mutable resNbr : int,
		mutable anyTyp : MizTyp,
		gProperties : MizPropertiesRec,
		mutable statusOfProperties : int,
		mutable gDefiniens : Maybe<MizDefiniens>,
		mutable gDefPos : MizPos,
		mutable gSuperfluous : int,
		mutable dPrimLength : int,
		mutable gWhichOne : int,
		constNr : Vector<int>,          // [1..2*MaxArgNbr]
		locusAsConst : Vector<int>,
		gPrimaries : Vector<MizTyp>,
		lociOcc : Vector<bool>,
		mutable gNonPermissive : bool,
		mutable gPrimNbr : int,
		mutable gBoundInc : int,
		mutable gBoundForFirst : int,
		mutable gBoundForSecond : int,
		mutable gBoundForIt : int,
		gCorrCond : Vector<MizFrm>,     // [0..CorrCondNbr]
		mutable gMaxArgNbr : int,
		mutable gDefBase : int,

		// SchemeBody's counters
		mutable schPredNbr : int,
		mutable curSchFuncNbr : int,
		mutable schemeThesis : MizFrm,
		// D: LevelRec (analyzer.pas 335)
		d : MizLevelRec,
		// PORT-ONLY, and it goes away with the last item kind: the `.par` kind
		// character the main loop did not know, so a partial run says exactly
		// where it stopped instead of aborting.
		mutable stoppedAt : int,
	);

	CorrCondNbr = 6;

	mizMakeAnalyzer(env : MizCorrelEnv, eh : MizErrHan, clusters : MizClusters,
		gen : MizGen, defs : MizDefinientia, idents : MizIdentify,
		schemes : MizSchemes, parContent : string, articleId : string,
		mizFiles : string) -> MizAnalyzer;

	// procedure Analyze — the main loop
	mizAnalyze(a : MizAnalyzer) -> void;
	mizAnalyzerXml(a : MizAnalyzer) -> string;
}

mizMakeAnalyzer(env : MizCorrelEnv, eh : MizErrHan, clusters : MizClusters,
		gen : MizGen, defs : MizDefinientia, idents : MizIdentify,
		schemes : MizSchemes, parContent : string, articleId : string,
		mizFiles : string) -> MizAnalyzer {
	n = 2 * MaxArgNbr;
	mk1 = \ -> { v : Vector<int> = makeVector(n + 1); fori(0, n, \__ -> pushVector(v, 0)); v };
	a = MizAnalyzer(env, eh, clusters, gen, mizMakeVrfOut(env),
		mizInOpen(parContent, eh), defs, idents, schemes, articleId,
		false, false, false, false, 0, mizNewIncorTyp(),
		MizPropertiesRec(0, 0, 0), 0, None(), mizZeroPos, 0, 0, 0,
		mk1(), mk1(),
		{ v : Vector<MizTyp> = makeVector(n + 1); fori(0, n, \__ -> pushVector(v, mizNewIncorTyp())); v },
		{ v : Vector<bool> = makeVector(n + 1); fori(0, n, \__ -> pushVector(v, false)); v },
		false, 0, 0, 0, 0, 0,
		{ v : Vector<MizFrm> = makeVector(CorrCondNbr + 1);
		  fori(0, CorrCondNbr, \__ -> pushVector(v, mizNewIncorFrm())); v },
		MaxArgNbr, 0, 0, 0, mizNewIncorFrm(),
		MizLevelRec(0, 0, 0, 0, 0, 0, None(), false, None()), 0);
	// the report's own header (Analyze, analyzer.pas 6672)
	mizVOutString(a.out, "<?xml version=\"1.0\"?>\n");
	mizVOutString(a.out,
		"<?xml-stylesheet type=\"text/xml\" href=\"file://" + mizFiles + "miz.xml\"?>\n");
	mizVOutElStart(a.out, "Article");
	mizVOutAttr(a.out, "aid", articleId);
	mizVOutAttr(a.out, "mizfiles", mizFiles);
	mizVOutAttrEnd(a.out);
	a;
}

mizAnalyzerXml(a : MizAnalyzer) -> string { mizVrfOutContent(a.out); }

mizAError(a : MizAnalyzer, pos : MizPos, nr : int) -> void { mizError(a.eh, pos, nr); }
mizAErrImm(a : MizAnalyzer, nr : int) -> void { mizErrImm(a.eh, nr); }

// BoundVarNbr lives on the correl env; Flow9 cannot assign through `a.env.x`
mizASetBVN(a : MizAnalyzer, n : int) -> void { e = a.env; e.boundVarNbr ::= n; }
mizABVN(a : MizAnalyzer) -> int { a.env.boundVarNbr; }

// --------------------------------------------------------- read helpers ---

// ReadSentence (123)
mizReadSentence(a : MizAnalyzer, negate : bool) -> MizFrm {
	mizASetBVN(a, 0);
	lSnt = mizLoadFormula(a.inf);
	lFrm = mizAnalyzeFrm(a.gen, lSnt);
	if (negate) mizNewNeg(lFrm) else lFrm;
}

// ReadType (134)
mizReadType(a : MizAnalyzer) -> MizTyp {
	mizASetBVN(a, 0);
	mizAnalyzeTyp(a.gen, mizLoadType(a.inf));
}

// AnalyzeTerm (143) — a top-level `qua` is stripped
mizAnalyzeTermTop(a : MizAnalyzer, e : MizExp) -> MizTrm {
	mizASetBVN(a, 0);
	lTrm = mizAnalyzeTrm(a.gen, e);
	switch (lTrm) {
		MizQuaTrm(trmProper, __, __, __): mizCopyTrm(trmProper);
		default: lTrm;
	}
}

// ReadTerm (154)
mizReadTerm(a : MizAnalyzer) -> MizTrm {
	mizASetBVN(a, 0);
	mizAnalyzeTermTop(a, mizLoadTerm(a.inf));
}

// AnalizeArgTypeList (176)
mizAnalizeArgTypeList(a : MizAnalyzer) -> Vector<MizTyp> {
	coll : Vector<MizExp> = makeVector(2);
	mizInWord(a.inf);
	while(\ -> a.inf.curKind != 59, \ -> {
		pushVector(coll, mizLoadType(a.inf));
		mizInWord(a.inf);
	});
	res : Vector<MizTyp> = makeVector(sizeVector(coll));
	n = ref 0;
	iterVector(coll, \e -> {
		if (^n >= a.gMaxArgNbr) mizOverflowError(937);
		n := ^n + 1;
		mizASetBVN(a, 0);
		t = mizAnalyzeTyp(a.gen, e);
		while(\ -> sizeVector(a.env.locArgTyp) <= ^n,
			\ -> pushVector(a.env.locArgTyp, mizNewIncorTyp()));
		setVectorUnsafe(a.env.locArgTyp, ^n, t);
		pushVector(res, t);
	});
	res;
}

// ReadPropositions (201)
mizReadPropositions(a : MizAnalyzer) -> Vector<MizProposition> {
	conds : Vector<MizProposition> = makeVector(2);
	while(\ -> a.inf.curKind != 59, \ -> {
		lLabNr = a.inf.curNr;
		lLabId = mizInInt(a.inf);
		lPos = mizInPos(a.inf);
		mizInWord(a.inf);
		lFrm = mizReadSentence(a, false);
		pushVector(conds, MizProposition(lLabNr, lLabId, lPos, lFrm));
		mizInWord(a.inf);
	});
	conds;
}

// ConjugatePropositions (215)
mizConjugatePropositions(conds : Vector<MizProposition>) -> MizFrm {
	foldVector(conds, mizNewVerum(), \acc, p -> mizNewConj(acc, mizCopyFrm(p.sentence)));
}

// ------------------------------------------------------------- the items ---

// Section (6561)
mizASection(a : MizAnalyzer) -> void {
	mizInPos(a.inf);
	mizVOutEl1(a.out, "Section");
	mizInWord(a.inf);
}

// Canceled (6570)
mizACanceled(a : MizAnalyzer) -> void {
	mizInWord(a.inf);
	if (a.inf.curKind == 84) {          // ikTheoremCanceled 'T'
		mizVOutElStart(a.out, "JustifiedTheorem");
		mizVOutPosAsAttrs(a.out, a.eh.curPos);
		mizVOutAttrEnd(a.out);
		mizVOutPropos(a.out, 0, 0, a.eh.curPos, mizNewVerum());
		mizVOutEl1(a.out, "SkippedProof");
		mizVOutElEnd(a.out, "JustifiedTheorem");
	} else {
		mizVOutElStart(a.out, "Canceled");
		mizVOutAttr(a.out, "kind", fromCharCode(a.inf.curKind));
		mizVOutElEnd0(a.out);
	}
	mizInWord(a.inf);
}

// Reservation (3045)
mizAReservation(a : MizAnalyzer) -> void {
	env = a.env;
	env.boundVarNbr ::= 0;
	mizVOutElStart0(a.out, "Reservation");
	mark = mizTTCollMark(env);
	gn = a.gen;
	gn.exportableItem ::= true;
	gn.constInExportableItemOcc ::= false;
	idents = mizInitIntSeq(4);
	mizInWord(a.inf);
	while(\ -> a.inf.curKind != 59, \ -> {
		mizSeqInsert(idents, a.inf.curNr);
		mizInWord(a.inf);
	});
	fori(0, mizSeqCount(idents) - 1, \k -> {
		mizVOutElStart(a.out, "Ident");
		mizVOutIntAttr(a.out, "vid", mizSeqValue(idents, k));
		mizVOutElEnd0(a.out);
	});
	mizInWord(a.inf);
	while(\ -> a.inf.curKind != 59, \ -> {
		e = mizLoadType(a.inf);
		env.boundVarNbr ::= env.boundVarNbr + 1;
		mizSetBoundVar(env, env.boundVarNbr, mizAnalyzeTyp(a.gen, e));
		mizInWord(a.inf);
	});
	a.resNbr ::= a.resNbr + 1;
	mizAssert(2524, a.resNbr <= MaxResNbr);
	rt = mizAnalyzeTyp(a.gen, mizLoadType(a.inf));
	mizGenSetReservedVar(a.gen, a.resNbr, rt);
	mizVOutType(a.out, rt);
	mizTTCollRelease(env, mark);
	mizInWord(a.inf);
	env.boundVarNbr ::= 0;
	gn.exportableItem ::= false;
	gn.constInExportableItemOcc ::= false;
	mizVOutElEnd(a.out, "Reservation");
}

// ------------------------------------------------------ justifications ----

// LoadInferenceObj (3657)
mizLoadInferenceObj(a : MizAnalyzer) -> MizInference {
	mizInWord(a.inf);
	inf = mizMakeInference();
	inf.inferSort ::= a.inf.curKind;   // ikInfBy / ikInfFrom / ikError
	inf.schFileNr ::= mizInInt(a.inf);
	inf.schemeNr ::= mizInInt(a.inf);
	inf.linked ::= mizInBool(a.inf);
	mizInWord(a.inf);
	while(\ -> a.inf.curKind != 59, \ -> {
		k = a.inf.curKind;
		if (k == 108) {          // 'l'
			n1 = mizInInt(a.inf); n2 = mizInInt(a.inf); pos = mizInPos(a.inf);
			pushVector(inf.references, MizPrivateRef(pos, n1, n2));
		} else if (k == 116) {   // 't'
			n1 = mizInInt(a.inf); n2 = mizInInt(a.inf); pos = mizInPos(a.inf);
			pushVector(inf.references, MizTheoremRef2(pos, n1, n2));
		} else if (k == 100) {   // 'd'
			n1 = mizInInt(a.inf); n2 = mizInInt(a.inf); pos = mizInPos(a.inf);
			pushVector(inf.references, MizDefinitionRef2(pos, n1, n2));
		} else {
			mizRunTimeError(1002);
		}
		mizInWord(a.inf);
	});
	inf.pos ::= mizInPos(a.inf);
	inf;
}

// Justify (4457)
mizAJustify(a : MizAnalyzer, thesisId : int, labId : int, thesis : MizFrm) -> void {
	mizInWord(a.inf);
	k = a.inf.curKind;
	if (k == 34) {                       // '"' — a simple justification
		mizVOutPropos(a.out, thesisId, labId, a.eh.curPos, thesis);
		inf = mizLoadInferenceObj(a);
		mizVOutInference(a.out, inf);
		mizInWord(a.inf);
	} else if (k == ikBlcProof) {
		mizInPos(a.inf);
		mizInWord(a.inf);
		// Demonstration is not transcribed yet
		a.stoppedAt ::= ikBlcProof;
	} else {
		mizVOutPropos(a.out, thesisId, labId, a.eh.curPos, thesis);
		mizVOutEl1(a.out, "SkippedProof");
	}
}

// Theorem (6526)
mizATheorem(a : MizAnalyzer) -> void {
	mizInPos(a.inf);
	mizVOutElStart(a.out, "JustifiedTheorem");
	mizVOutPosAsAttrs(a.out, a.eh.curPos);
	mizVOutAttrEnd(a.out);
	mizInWord(a.inf);
	lLabNr = a.inf.curNr;
	lLabId = mizInInt(a.inf);
	mizInPos(a.inf);
	mizInWord(a.inf);
	gn = a.gen;
	gn.exportableItem ::= true;
	gn.constInExportableItemOcc ::= false;
	lFrm = mizReadSentence(a, false);
	gn.exportableItem ::= false;
	gn.constInExportableItemOcc ::= false;
	mizAJustify(a, lLabNr, lLabId, lFrm);
	mizVOutElEnd(a.out, "JustifiedTheorem");
}

// --------------------------------------------------------------- Analyze ---

// procedure Analyze (6649) — the main loop dispatches on the leading kind
// character of each `.par` item.
mizAnalyze(a : MizAnalyzer) -> void {
	mizASetBVN(a, 0);
	mizInWord(a.inf);
	while(\ -> a.inf.curKind != 33 && a.stoppedAt == 0, \ -> {     // '!'
		k = a.inf.curKind;
		if (k == ikBlcSection) mizASection(a)
		else if (k == ikItmReservation) mizAReservation(a)
		else if (k == ikItmCanceled) mizACanceled(a)
		else if (k == ikItmTheorem) mizATheorem(a)
		else a.stoppedAt ::= k;
		if (a.stoppedAt == 0) mizVOutNewLine(a.out);
	});
	if (a.stoppedAt == 0) mizVOutElEnd(a.out, "Article");
}
