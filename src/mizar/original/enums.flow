// Transcription of ~/dev/system/kernel/enums.pas — the enumerated kinds and
// the conversions between them and their kind CHARACTERS.
//
// ConstructorsKind already lives in correl.flow (the checker needed it); this
// file adds NotationKind, the notation/constructor character maps and the
// per-kind index limits. Ordinals must match the Pascal enums: they index the
// Notat[] / Constr[] arrays and appear in the intermediate files.

import mizar/original/errhan;
import mizar/original/lexicon;
import mizar/original/limits;

export {
	// NotationKind
	noMode = 0; noStructMode = 1; noAttribute = 2; noPredicate = 3;
	noFunctor = 4; noSelector = 5; noAggregate = 6; noForgetFunctor = 7;
	mizNotationKindCount = 8;

	// ClusterKind
	clRegistered = 0; clConditional = 1; clFunctor = 2;

	// SymbolKind
	symMode = 0; symStructure = 1; symAttribute = 2; symPredicate = 3;
	symFunctor = 4; symLeftBracket = 5; symRightBracket = 6; symSelector = 7;

	mizConstructorRepr(kind : int) -> int;      // ConstructorRepr
	mizConstructorKind(ch : int) -> int;        // ConstructorKind
	mizSgnKind(ch : int) -> int;                // SgnKind
	mizSgnRepr(kind : int) -> int;              // SgnRepr

	mizNotationRepr(kind : int) -> int;         // NotationRepr
	mizNotatKind(ch : int) -> int;              // NotatKind
	mizNotatSgnKind(ch : int) -> int;           // NotatSgnKind
	mizNotationSgnRepr(kind : int) -> int;      // NotationSgnRepr

	mizMaxNotatNbr(kind : int) -> int;          // MaxNotatNbr
}

mizConstructorRepr(kind : int) -> int {
	if (kind == 0) 77           // coMode -> 'M'
	else if (kind == 1) 76      // coStructMode -> 'L'
	else if (kind == 2) 86      // coAttribute -> 'V'
	else if (kind == 3) 82      // coPredicate -> 'R'
	else if (kind == 4) 75      // coFunctor -> 'K'
	else if (kind == 5) 85      // coSelector -> 'U'
	else if (kind == 6) 71      // coAggregate -> 'G'
	else { mizRunTimeError(2210); 0 }
}

mizConstructorKind(ch : int) -> int {
	if (ch == 77) 0
	else if (ch == 76) 1
	else if (ch == 86) 2
	else if (ch == 82) 3
	else if (ch == 75) 4
	else if (ch == 85) 5
	else if (ch == 71 || ch == 74) 6   // 'G', 'J'
	else { mizRunTimeError(2211); 0 }
}

mizNotationRepr(kind : int) -> int {
	if (kind == noFunctor) 75          // 'K'
	else if (kind == noAttribute) 86   // 'V'
	else if (kind == noMode) 77        // 'M'
	else if (kind == noPredicate) 82   // 'R'
	else if (kind == noStructMode) 76  // 'L'
	else if (kind == noAggregate) 71   // 'G'
	else if (kind == noSelector) 85    // 'U'
	else if (kind == noForgetFunctor) 74  // 'J'
	else { mizRunTimeError(2212); 0 }
}

mizNotationSgnRepr(kind : int) -> int {
	if (kind == noFunctor) ikSgnFunctor
	else if (kind == noAttribute) ikSgnAttribute
	else if (kind == noMode) ikSgnMode
	else if (kind == noPredicate) ikSgnPredicate
	else if (kind == noStructMode) ikSgnStructMode
	else if (kind == noAggregate) ikSgnAggregate
	else if (kind == noSelector) ikSgnSelector
	else if (kind == noForgetFunctor) ikSgnForgetFunc
	else { mizRunTimeError(2213); 0 }
}

mizNotatKind(ch : int) -> int {
	if (ch == 75) noFunctor
	else if (ch == 86) noAttribute
	else if (ch == 77) noMode
	else if (ch == 82) noPredicate
	else if (ch == 76) noStructMode
	else if (ch == 71) noAggregate
	else if (ch == 85) noSelector
	else if (ch == 74) noForgetFunctor
	else { mizRunTimeError(2214); 0 }
}

mizNotatSgnKind(ch : int) -> int {
	if (ch == ikSgnFunctor) noFunctor
	else if (ch == ikSgnAttribute) noAttribute
	else if (ch == ikSgnMode) noMode
	else if (ch == ikSgnPredicate) noPredicate
	else if (ch == ikSgnStructMode) noStructMode
	else if (ch == ikSgnAggregate) noAggregate
	else if (ch == ikSgnSelector) noSelector
	else if (ch == ikSgnForgetFunc) noForgetFunctor
	else { mizRunTimeError(2215); 0 }
}

mizSgnKind(ch : int) -> int {
	if (ch == ikSgnMode) 0
	else if (ch == ikSgnStructMode) 1
	else if (ch == ikSgnAttribute) 2
	else if (ch == ikSgnPredicate) 3
	else if (ch == ikSgnFunctor) 4
	else if (ch == ikSgnSelector) 5
	else if (ch == ikSgnAggregate) 6
	else { mizRunTimeError(2217); 0 }
}

mizSgnRepr(kind : int) -> int {
	if (kind == 0) ikSgnMode
	else if (kind == 1) ikSgnStructMode
	else if (kind == 2) ikSgnAttribute
	else if (kind == 3) ikSgnPredicate
	else if (kind == 4) ikSgnFunctor
	else if (kind == 5) ikSgnSelector
	else if (kind == 6) ikSgnAggregate
	else { mizRunTimeError(2218); 0 }
}

// MaxNotatNbr = IndexLimit[NotatIndex(fKind)]
mizMaxNotatNbr(kind : int) -> int {
	// NotatIndex maps to the *PattIndex sorts, not the constructor ones
	if (kind == noFunctor) MaxFuncPattNbr
	else if (kind == noAttribute) MaxAttrPattNbr
	else if (kind == noMode) MaxModePattNbr
	else if (kind == noPredicate) MaxPredPattNbr
	else if (kind == noStructMode || kind == noAggregate
		|| kind == noForgetFunctor) MaxStructPattNbr
	else if (kind == noSelector) MaxSelectPattNbr
	else { mizRunTimeError(2216); 0 }
}
