// The Mizar verifier in Flow9 — entry point.
// Transcription of ~/dev/system/kernel/verifier.dpr + verfinit.pas.
//
// Usage (via bin/mizarj):
//   mizarj article=xboole_0 [mml=<dir>]         CheckerOnly (the default while
//                                               the one-process gate is young):
//                                               the checker over the .xml
//   mizarj article=xboole_0 full=1 [out=<file>] the WHOLE CHAIN in one process
//                                               (.miz -> parse -> MSM -> analyze
//                                               -> check); out= also writes the
//                                               analyzer report it produced
//
// The pass structure is MSMVerifyArticle (verfinit.flow). The original's
// default is the full chain with -c/-p/-a restricting; mizarj keeps
// CheckerOnly as its default until the full chain replaces fullrun.sh's gate.

import runtime;
import string;
import net/url_parameter;
import fs/filesystem;
import ds/vector;
import mizar/original/errhan;
import mizar/original/verfinit;
import mizar/original/accom;

main() {
	article = getUrlParameterDef("article", "");
	mml = getUrlParameterDef("mml", "/home/dmitry/dev/math/MML-test");
	full = getUrlParameterDef("full", "") == "1";
	mizFiles = getUrlParameterDef("mizfiles", "/usr/local/share/mizar/");

	if (article == "") {
		println("mizarj: the Mizar verifier transcribed to Flow9");
		println("usage: mizarj article=<name> [mml=<dir>] [accom=1] [full=1 [out=<file>]]");
		quit(1);
	} else {
		mmlDir = mml + "/mml";
		// accom=1: build the environment from the .evl + prel/ instead of
		// from the flat files Mizar's own accom wrote
		loader = if (getUrlParameterDef("accom", "") == "1")
			mizAccomEnvLoader(mmlDir, article)
			else mizFileEnvLoader(mmlDir, article);
		if (!full && !fileExists(mmlDir + "/" + article + ".xml")) {
			println("mizarj: no analyzer report " + mmlDir + "/" + article + ".xml");
			quit(1);
		} else {
			r = mizMSMVerifyArticle(mmlDir, article, mizFiles, loader,
				!full, false, false); // CheckerOnly unless full=1
			out = getUrlParameterDef("out", "");
			if (full && out != "") {
				if (!setFileContentBytes(out, r.xml)) println("cannot write " + out);
			}
			if (r.stoppedAt != 0) println("stopped at kind " + i2s(r.stoppedAt));
			switch (r.stats) {
				Some(stats): {
					println(article + ": checked=" + i2s(stats.checked)
						+ " accepted=" + i2s(stats.accepted)
						+ " failed=" + i2s(stats.failed)
						+ " from-skipped=" + i2s(stats.skippedFrom)
						+ " blocks-skipped=" + i2s(stats.skippedBlocks));
					iterVector(stats.failures, \f -> println("  FAIL " + f));
					quit(if (stats.failed > 0) 1 else 0);
				}
				None(): quit(1);
			}
		}
	}
}
