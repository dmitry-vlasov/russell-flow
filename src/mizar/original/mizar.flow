// The Mizar verifier in Flow9 — THE entry point, and the only binary.
// Transcription of ~/dev/system/kernel/verifier.dpr + verfinit.pas.
//
//   flowc1 jar=1 mizar/original/mizar.flow     builds it
//   bin/mizarj <args>                          runs it
//
// VERIFY — the default is the whole chain (.miz -> parse -> MSM -> analyze ->
// check) in this process, exactly as MSMVerifyArticle does:
//   article=<name>                  one article
//   article-list=<file>             every article named in the file, in
//                                   parallel — this IS the integration check
//   jobs=<n>                        workers for a list (default 8)
//   mml=<dir>                       the MML working copy
//   ref=<dir>                       ALSO compare the analyzer report, byte for
//                                   byte, against <dir>/<article>.xml
//   quiet=1                         only the tally
//   out=<file>                      write the per-article lines there
//
// RESTRICT, mirroring the original's -c/-p/-a (GetOptions):
//   checker-only=1                  check an existing .xml, run no other pass
//   parser-only=1                   stop after Transfer2Analyzer
//   analyzer-only=1                 stop after Analyze
//
// DUMP AN INTERMEDIATE — nothing is written unless asked for. Every pass hands
// its result to the next IN MEMORY; these are the only way a file appears:
//   dump-xml=<file>                 the analyzer report
//   dump-par=<file>                 the .par Transfer2Analyzer produced
//
// TEST — the component suites are in this same jar; there is no test binary:
//   test=all | test=<suite> | test=list
//
// ACCOMMODATE:
//   accom=1                         build the environment from .evl + prel/
//                                   instead of the flat files accom wrote

import runtime;
import string;
import math/math;
import net/url_parameter;
import fs/filesystem;
import ds/vector;
import sys/concurrent;
import mizar/original/errhan;
import mizar/original/accom_dict;
import mizar/original/accom_notation;
import mizar/original/verfinit;
import mizar/original/roundcl;
import mizar/original/accom;
import mizar/original/accom_env;
import mizar/original/test/test_all;

// one article's outcome. `ms` is the article's own wall time — in a list run
// the articles share a thread pool, so these sum to more than the run's own
// elapsed time.
MizRunOutcome(article : string, ok : bool, line : string,
	checked : int, accepted : int, ms : double,
	// the rejected inferences, so a list run can report WHY an article failed
	// and not merely that it did
	failures : [string],
	census : MizCensus);

// "12.36 sec." / "18 min. 33 sec." / "1 h. 04 min. 09 sec."
mizFmtTime(ms : double) -> string {
	secs = ms / 1000.0;
	if (secs < 60.0) {
		// always two decimals, so a column of times lines up
		hundredths = round(secs * 100.0);
		i2s(hundredths / 100) + "."
			+ (if (hundredths % 100 < 10) "0" else "") + i2s(hundredths % 100)
			+ " sec.";
	} else {
		whole = round(secs);
		h = whole / 3600;
		m = (whole % 3600) / 60;
		s = whole % 60;
		pad = \n -> if (n < 10) "0" + i2s(n) else i2s(n);
		if (h > 0) i2s(h) + " h. " + pad(m) + " min. " + pad(s) + " sec."
		else i2s(m) + " min. " + pad(s) + " sec.";
	}
}

// The report of one run, in the shape both modes print. `brief` is the
// per-article line of a list run; the single-article mode says more.
mizRunOutcome(article : string, r : MizVerifyRun, refDir : string,
		ran : bool, brief : bool, ms : double) -> MizRunOutcome {
	stats = switch (r.stats) {
		Some(s): s;
		None(): MizPrepStats(0, 0, 0, 0, 0, makeVector(0), mizMakeCensus(), makeVector(0));
	}
	refPath = refDir + "/" + article + ".xml";
	xmlBad = if (refDir == "" || r.xml == "") ""
		else if (!fileExists(refPath)) ", report: NO REFERENCE"
		else {
			expected = getFileContent(refPath);
			if (expected == r.xml) "" else {
				n = strlen(r.xml);
				m = strlen(expected);
				i = ref 0;
				while(\ -> ^i < n && ^i < m
						&& getCharAt(r.xml, ^i) == getCharAt(expected, ^i),
					\ -> i := ^i + 1);
				", report: DIFFERS at byte " + i2s(^i + 1)
					+ " (reference " + i2s(m) + " bytes, produced " + i2s(n) + ")";
			}
		};
	// An article that produced NO verdict at all is NOT verified: a pass that
	// dies leaves the default stats, and 0 == 0 would otherwise read as a pass.
	ok = xmlBad == "" && r.stoppedAt == 0 && stats.failed == 0
		&& (!ran || (isSome(r.stats) && stats.checked == stats.accepted));
	// `checked` counts BY-INFERENCES (prep.flow's MizPrepStats) — one per
	// justification the checker runs, not per proof step and not per theorem.
	// When everything is accepted the two numbers are equal, so print one; the
	// moment they are not, the difference is the news and both go out.
	inferences = if (!ran) "" else
		if (stats.accepted == stats.checked) ", inferences: " + i2s(stats.checked)
		else ", inferences: " + i2s(stats.checked)
			+ ", accepted: " + i2s(stats.accepted)
			+ ", rejected: " + i2s(stats.failed);
	detail = xmlBad
		+ (if (r.stoppedAt != 0) ", stoppedAt: " + i2s(r.stoppedAt) else "")
		+ (if (brief) "" else ", from-skipped: " + i2s(stats.skippedFrom)
			+ ", blocks-skipped: " + i2s(stats.skippedBlocks));
	MizRunOutcome(article, ok,
		"article: " + article + ", status: " + (if (ok) "OK" else "FAIL")
			+ inferences + detail + ", time: " + mizFmtTime(ms),
		stats.checked, stats.accepted, ms, vector2array(stats.failures),
		stats.census);
}

// ---- the refutation census report (census=1) ----
// The first, verdict-shaped slice of the checker's derivation: how wide the
// case splits are, and which rule closes each disjunct. The contr codes are
// the original's SetContr arguments; the phase label names the routine family
// that sets the code.
mizCensusPhase(code : int) -> string {
	if (code == 0) "not refuted"
	else if (code >= 300) "arithmetic requirement"
	else if (code >= 50) "arithmetic precheck"
	else if (code >= 45) "unification"
	else "equalizer";
}

// short names for the codes whose SetContr site has been read in the Pascal;
// each cites equalizer.pas / unifier.pas at the commit that added it
mizCensusName(code : int) -> string {
	if (code == 1 || code == 2) "attribute clash at typing"
	else if (code == 6) "attribute clash at class merge"
	else if (code == 8 || code == 9 || code == 10 || code == 11)
		"attribute clash at cluster rounding"
	else if (code == 19) "reflexivity over one class"
	else if (code == 20) "complementary literal pair"
	else if (code == 21) "type membership visible in the class"
	else if (code == 25) "atom vs its negation on one class"
	else if (code == 26 || code == 27 || code == 31) "sign requirement"
	else if (code == 32 || code == 39) "order over computed values"
	else if (code == 33) "membership forces non-empty"
	else if (code == 40 || code == 41 || code == 43)
		"type membership refuted against the class types"
	else if (code == 45) "one universal premise instantiated"
	else if (code == 47) "two universal premises unified"
	else if (code == 48 || code == 49) "Fraenkel membership"
	else mizCensusPhase(code);
}

mizCensusReport(c : MizCensus) -> void {
	println("Refutation census: inferences: " + i2s(c.inferences)
		+ ", disjuncts: " + i2s(c.disjuncts));
	histo = foldi(vector2array(c.dhisto), [], \i, acc, n ->
		if (n == 0) acc else arrayPush(acc, i2s(i) + ": " + i2s(n)));
	println("  split width (disjuncts -> inferences): " + strGlue(histo, ", "));
	codes = foldi(vector2array(c.codes), [], \i, acc, n ->
		if (n == 0) acc else arrayPush(acc, Pair(i, n)));
	sorted = sortCustom(codes, \p : Pair<int, int> -> -p.second, true);
	println("  closing rule (contr code -> disjuncts):");
	iter(sorted, \p ->
		println("    " + lpad(i2s(p.first), " ", 4) + " (" + mizCensusName(p.first)
			+ "): " + i2s(p.second)));
}

mizUsage() -> void {
	println("mizarj: the Mizar verifier transcribed to Flow9");
	println("");
	println("  mizarj article=<name> [mml=<dir>]             verify one article");
	println("  mizarj article-list=<file> [jobs=8]           verify many, in parallel");
	println("  mizarj ... ref=<dir>                          also byte-compare the report");
	println("  mizarj ... dump-xml=<file> | dump-par=<file>  write an intermediate");
	println("  mizarj ... checker-only=1 | parser-only=1 | analyzer-only=1");
	println("  mizarj test=all | test=<suite> | test=list    the component suites");
	println("");
	println("  suites: " + strGlue(mizComponentSuiteNames(), " "));
}

main() {
	mml = getUrlParameterDef("mml", "/home/dmitry/dev/math/MML-test");
	mmlDir = mml + "/mml";
	mizFiles = getUrlParameterDef("mizfiles", "/usr/local/share/mizar/");
	article = getUrlParameterDef("article", "");
	listFile = getUrlParameterDef("article-list", "");
	test = getUrlParameterDef("test", "");
	refDir = getUrlParameterDef("ref", "");
	quiet = getUrlParameterDef("quiet", "") == "1";
	jobs = max(1, s2i(getUrlParameterDef("jobs", "8")));
	checkerOnly = getUrlParameterDef("checker-only", "") == "1";
	parserOnly = getUrlParameterDef("parser-only", "") == "1";
	analyzerOnly = getUrlParameterDef("analyzer-only", "") == "1";
	accom = getUrlParameterDef("accom", "") == "1";
	ran = !parserOnly && !analyzerOnly;   // did the checker pass run

	loaderOf = \a -> if (accom) mizAccomEnvLoader(mmlDir, a, mizFiles)
		else mizFileEnvLoader(mmlDir, a);

	dcxGate = getUrlParameterDef("dcx-gate", "");
	envGate = getUrlParameterDef("env-gate", "");
	if (dcxGate != "" || envGate != "") {
		// ---- byte-gates for the accommodator's naming passes: produce the
		// .dcx (vocabularies) and, for env-gate, the .frm/.eno (notation)
		// in memory from the .evl + prel/, and compare with the
		// accommodated files ----
		sel = if (envGate != "") envGate else dcxGate;
		full = envGate != "";
		arts = if (sel == "list") filtermap(strSplit(getFileContent(listFile), "\n"),
				\l -> { a = trim(l); if (a == "") None() else Some(a); })
			else [sel];
		cmp1 = \a : string, what : string, produced : string, path : string -> {
			expected = getFileContentBinary(path);
			if (produced == expected) {
				if (!quiet) println("   article: " + a + ", " + what + ": identical");
				true;
			} else {
				n = min(strlen(produced), strlen(expected));
				i = ref 0;
				while(\ -> ^i < n && getCharAt(produced, ^i) == getCharAt(expected, ^i),
					\ -> i := ^i + 1);
				println("   article: " + a + ", " + what + ": DIFFERS at byte "
					+ i2s(^i + 1) + " (expected " + i2s(strlen(expected))
					+ " bytes, produced " + i2s(strlen(produced)) + ")");
				println("      expected: ..." + substring(expected, max(0, ^i - 40), 80));
				println("      produced: ..." + substring(produced, max(0, ^i - 40), 80));
				false;
			}
		};
		bad2 = fold(arts, 0, \acc, a -> {
			evl = mizLoadEvl(mmlDir + "/" + a + ".evl");
			d = mizProcessVocabularies(mizFiles, mmlDir,
				mizEvlDirective(evl, "vocabularies"),
				mizEvlDirective(evl, "theorems"),
				mizEvlDirective(evl, "schemes"));
			okDcx = cmp1(a, "dcx", mizDcxContent(d, toUpperCase(a), mizFiles),
				mmlDir + "/" + a + ".dcx");
			okRest = if (!full) true else {
				env = mizMakeCorrelEnv();
				acc2 = mizMakeAccom(env, mmlDir);
				mizAccomConstructors(acc2, evl);
				an = mizMakeAccNotat(d);
				mizProcessNotation(acc2, d, an, mizEvlDirective(evl, "notations"));
				okFrm = cmp1(a, "frm", mizFrmContent(an, d), mmlDir + "/" + a + ".frm");
				okEno = cmp1(a, "eno", mizEnoContent(an, env, toUpperCase(a), mizFiles),
					mmlDir + "/" + a + ".eno");
				okPrf = cmp1(a, "prf", mizPrfContent(an, d), mmlDir + "/" + a + ".prf");
				okEpr = cmp1(a, "epr", mizEprContent(env, mizAccomProperties(acc2, evl),
					mizEvlDirective(evl, "registrations"), toUpperCase(a), mizFiles),
					mmlDir + "/" + a + ".epr");
				cmpDefs = \what : string, directive : string, ext : string -> {
					cmp1(a, what, mizDefinientiaContent(env,
						mizAccomDefinientia(acc2, evl, directive, false),
						mizEvlDirective(evl, directive), toUpperCase(a), mizFiles),
						mmlDir + "/" + a + ext);
				};
				okDfs = cmpDefs("dfs", "definitions", ".dfs");
				okDfe = cmpDefs("dfe", "equalities", ".dfe");
				okDfx = cmpDefs("dfx", "expansions", ".dfx");
				okAtr = cmp1(a, "atr",
					mizAtrContent(mmlDir, evl, toUpperCase(a), mizFiles),
					mmlDir + "/" + a + ".atr");
				okEth = cmp1(a, "eth",
					mizEthContent(acc2, evl, toUpperCase(a), mizFiles),
					mmlDir + "/" + a + ".eth");
				okFrm && okEno && okPrf && okEpr && okDfs && okDfe && okDfx
					&& okAtr && okEth;
			};
			if (okDcx && okRest) acc else acc + 1;
		});
		println((if (full) "env gate: " else "dcx gate: ")
			+ i2s(length(arts) - bad2) + " identical, " + i2s(bad2) + " differ");
		quit(if (bad2 > 0) 1 else 0);
	} else if (test != "") {
		// ---- the component suites, in this same binary ----
		if (test == "list") {
			println("suites: " + strGlue(mizComponentSuiteNames(), " "));
			quit(0);
		} else {
			t = mizRunComponentTests(test);
			quit(if (t.failed > 0) 1 else 0);
		}
	} else if (article == "" && listFile == "") {
		mizUsage();
		quit(1);
	} else if (article != "") {
		// ---- one article; the only mode that dumps intermediates ----
		t0 = timestamp();
		r = mizMSMVerifyArticle(mmlDir, article, mizFiles, loaderOf(article),
			checkerOnly, parserOnly, analyzerOnly);
		dt = timestamp() - t0;
		dumpXml = getUrlParameterDef("dump-xml", "");
		if (dumpXml != "" && !setFileContentBytes(dumpXml, r.xml))
			println("cannot write " + dumpXml);
		dumpPar = getUrlParameterDef("dump-par", "");
		if (dumpPar != "" && !setFileContentBytes(dumpPar, r.par))
			println("cannot write " + dumpPar);
		dumpDeriv = getUrlParameterDef("dump-derivation", "");
		if (dumpDeriv != "") {
			deriv = switch (r.stats) {
				Some(s): "<?xml version=\"1.0\"?>\n<Derivation aid=\""
					+ toUpperCase(article) + "\">\n"
					+ concatStrings(vector2array(s.derivXml))
					+ "</Derivation>\n";
				None(): "";
			};
			if (!setFileContentBytes(dumpDeriv, deriv))
				println("cannot write " + dumpDeriv);
		}
		// S-C: the TYPE-DERIVATION record — every registration that fired during
		// the analyzer's rounding, in order
		dumpRound = getUrlParameterDef("dump-rounding", "");
		if (dumpRound != "" && dumpRound != "1") {
			rec = "<?xml version=\"1.0\"?>\n<Rounding aid=\"" + toUpperCase(article) + "\">\n"
				+ concatStrings(map(mizRoundRecord(), \l -> l + "\n")) + "</Rounding>\n";
			if (!setFileContentBytes(dumpRound, rec)) println("cannot write " + dumpRound);
		}
		o = mizRunOutcome(article, r, refDir, ran, false, dt);
		println(o.line);
		switch (r.stats) {
			Some(s): iterVector(s.failures, \f -> println("  rejected inference at " + f));
			None(): {}
		}
		if (getUrlParameterDef("census", "") == "1") mizCensusReport(o.census);
		quit(if (o.ok) 0 else 1);
	} else {
		// ---- a list of articles, in parallel, in ONE process ----
		articles = filtermap(strSplit(getFileContent(listFile), "\n"), \l -> {
			a = trim(l);
			if (a == "") None() else Some(a);
		});
		if (articles == []) {
			println("mizarj: no articles in " + listFile);
			quit(1);
		} else {
			// The articles are independent: each builds its own MizCorrelEnv,
			// and the port keeps no shared mutable state beyond idempotent
			// debug-flag caches — so they run on a thread pool.
			t0 = timestamp();
			pool = newThreadPool(jobs);
			results = concurrent(pool, map(articles, \a -> \ -> {
				ta = timestamp();
				r = mizMSMVerifyArticle(mmlDir, a, mizFiles, loaderOf(a),
					checkerOnly, parserOnly, analyzerOnly);
				o = mizRunOutcome(a, r, refDir, ran, true, timestamp() - ta);
				if (!quiet) println("   " + o.line);
				o;
			}));
			total = timestamp() - t0;
			chk = fold(results, 0, \acc, o -> acc + o.checked);
			acc2 = fold(results, 0, \acc, o -> acc + o.accepted);
			bad = filter(results, \o -> !o.ok);
			out = getUrlParameterDef("out", "");
			if (out != "" && !setFileContent(out,
					strGlue(map(results, \o -> o.line), "\n") + "\n"))
				println("cannot write " + out);
			if (getUrlParameterDef("census", "") == "1") {
				all = mizMakeCensus();
				iter(results, \o -> mizCensusMergeInto(all, o.census));
				mizCensusReport(all);
			}
			println("Total articles: " + i2s(length(articles))
				+ ", verified: " + i2s(length(articles) - length(bad))
				+ ", failed: " + i2s(length(bad))
				+ (if (!ran) "" else ", inferences: " + i2s(chk)
					+ (if (acc2 == chk) "" else ", accepted: " + i2s(acc2)))
				+ ", time: " + mizFmtTime(total));
			if (bad != []) {
				println("Failed articles:");
				iter(bad, \o -> {
					println("   " + o.line);
					iter(o.failures, \f -> println("      rejected inference at " + f));
				});
			}
			quit(if (bad != []) 1 else 0);
		}
	}
}
