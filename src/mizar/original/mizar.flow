// The Mizar verifier in Flow9 — entry point.
// Transcription of ~/dev/system/kernel/verifier.dpr + verfinit.pas.
//
// Usage (via bin/mizarj):
//   mizarj article=xboole_0 [mml=<dir>]        verify one article
//   mizarj checker-only=1 article=...          run only the checker pass (M1)
//
// Pass structure mirrors MSMVerifyArticle (verfinit.pas): Parser -> MSM ->
// Analyzer -> Checker, with -CheckerOnly / -AnalyzerOnly / -ParserOnly as
// first-class modes. Passes are enabled here as milestones M1-M4 land.

import runtime;
import string;
import net/url_parameter;
import fs/filesystem;
import mizar/original/errhan;
import mizar/original/xml_parser;

main() {
	article = getUrlParameterDef("article", "");
	mml = getUrlParameterDef("mml", "/home/dmitry/dev/math/MML-test");

	if (article == "") {
		println("mizarj: the Mizar verifier transcribed to Flow9");
		println("usage: mizarj article=<name> [mml=<dir>]");
		quit(1);
	} else {
		xmlPath = mml + "/mml/" + article + ".xml";
		if (!fileExists(xmlPath)) {
			println("mizarj: no analyzer report " + xmlPath);
			quit(1);
		} else {
			// M1 (checker pass on the Mizar-produced .xml) lands here next.
			println("mizarj: checker pass not yet ported (M1 in progress); found " + xmlPath);
			quit(0);
		}
	}
}
