// M2, first slice — the ACCOMMODATOR's constructor pass.
//
// Mizar's accom reads the article's environment directives (`.evl`) and
// gathers the imported items from the `prel/` database into the flat files
// the verifier consumes (`.atr`, `.ecl`, `.eth`, ...). This file starts with
// the constructors: the `.atr` is the union of the `constructors` directive
// articles' `prel/*.dco` payloads, in directive order, renumbered per kind.
//
// THE NUMBERING RULE (acc_han.pas ProcessConstructors / iocorrel gTrans):
// every `.dco` numbers constructors in ITS OWN accumulated frame — first the
// constructors of the articles in its <Signature>, in signature order, each
// contributing its own <ConstrCounts>, then its own. Merging into one table
// therefore needs each reference (mode nr, functor nr, attribute nr, predicate
// nr, struct nr, selector nr) translated from the source frame to the merged
// frame. That translation is what mizAccomConstructors does.

import ds/vector;
import ds/tree;
import string;
import loop;
import fs/filesystem;
import mizar/original/errhan;
import mizar/original/mobjects;
import mizar/original/lexicon;
import mizar/original/xml_parser;
import mizar/original/correl;
import mizar/original/iocorrel;
import mizar/original/roundcl;
import mizar/original/schemes;
import mizar/original/definientia;
import mizar/original/identify;
import mizar/original/builtin;
import mizar/original/prep;

export {
	// the parsed .evl: directive name -> article ids, in file order
	MizEvl(article : string, directives : Tree<string, [string]>);

	mizLoadEvl(path : string) -> MizEvl;
	mizEvlDirective(evl : MizEvl, name : string) -> [string];

	// prel/<initial>/<article><ext>
	mizPrelPath(mmlDir : string, article : string, ext : string) -> string;

	// the accommodation in progress: the merged constructor frame plus the
	// per-article bases every later pass translates against
	// per-article .dco header: its <Signature> frame and its own <ConstrCounts>
	MizDcoInfo(signature : [string], ownCounts : Tree<int, int>);

	// running merged totals by kind, and the per-article bases
	MizAccomState(
		mutable merged : Tree<int, int>,                 // kind -> count so far
		mutable info : Tree<string, MizDcoInfo>,         // article -> its .dco header
		// article -> kind -> merged count at the moment that article starts:
		// translations are ARITHMETIC (base + own index), so a constructor may
		// refer forward to one of its own article's later constructors
		mutable baseOf : Tree<string, Tree<int, int>>,
	);

	MizAccom(env : MizCorrelEnv, mmlDir : string, st : MizAccomState);
	mizMakeAccom(env : MizCorrelEnv, mmlDir : string) -> MizAccom;

	// build the merged constructor table into env, exactly as the .atr would
	// have it. Returns the article order actually loaded.
	mizAccomConstructors(acc : MizAccom, evl : MizEvl) -> [string];

	// build the registration table, exactly as the .ecl would have it
	// (acc_han.pas ProcessClusters). Must run after mizAccomConstructors.
	mizAccomClusters(acc : MizAccom, cl : MizClusters, evl : MizEvl) -> void;

	// the imported articles in TOKEN order — the `articlenr` every reference
	// in the .xml uses (accdict ProcessVocabularies: the theorems directive,
	// then the schemes directive articles it does not already contain)
	mizAccomArticleOrder(evl : MizEvl) -> [string];

	// build the theorem table, exactly as the .eth would have it
	// (acc_han.pas ProcessTheorems). Must run after mizAccomConstructors.
	mizAccomTheorems(acc : MizAccom, evl : MizEvl) -> Pair<Tree<int, MizFrm>, int>;

	// build the scheme table, exactly as the .esh would have it
	// (acc_han.pas ProcessSchemes). Must run after mizAccomConstructors.
	mizAccomSchemes(acc : MizAccom, evl : MizEvl) -> MizSchemes;

	// build one definientia pool, exactly as .dfs / .dfe / .dfx would have it
	// (acc_han.pas ProcessDefinitions / ProcessEqualities / ProcessExpansions —
	// three copies of one procedure over three directives, all reading
	// prel/*.def). directive = "definitions" | "equalities" | "expansions".
	mizAccomDefinientia(acc : MizAccom, evl : MizEvl, directive : string)
		-> Vector<MizDefiniens>;

	// build the identification / reduction tables, exactly as .eid and .erd
	// would have them (acc_han.pas ProcessIdentify / ProcessReductions, over
	// prel/*.did and prel/*.drd). Only the functor identifications are kept —
	// the checker consumes no others.
	mizAccomIdentifications(acc : MizAccom, evl : MizEvl, idn : MizIdentify) -> void;
	mizAccomReductions(acc : MizAccom, evl : MizEvl, idn : MizIdentify) -> void;

	// set env.builtIn from prel/*.dre, exactly as the .ere would have it
	// (acc_han.pas ProcessRequirements)
	mizAccomRequirements(acc : MizAccom, evl : MizEvl) -> void;

	// THE WHOLE ACCOMMODATION as an environment loader: everything the checker
	// reads is built from the article's .evl + prel/, never from the flat
	// .atr/.ecl/.eth/... files. `mizarj article=X accom=1` runs this.
	mizAccomEnvLoader(mmlDir : string, article : string) -> MizEnvLoader;
}

mizEvlDirective(evl : MizEvl, name : string) -> [string] {
	lookupTreeDef(evl.directives, name, []);
}

mizPrelPath(mmlDir : string, article : string, ext : string) -> string {
	low = toLowerCase(article);
	initial = if (strlen(low) > 0) substring(low, 0, 1) else "x";
	// mmlDir is .../mml; the database sits next to it as .../prel
	base = if (endsWith(mmlDir, "/mml")) substring(mmlDir, 0, strlen(mmlDir) - 4)
		else mmlDir;
	base + "/prel/" + initial + "/" + low + ext;
}

mizLoadEvl(path : string) -> MizEvl {
	content = getFileContent(path);
	x = mizXmlInitParsing(content);
	mizXmlNextElementState(x);
	mizXmlAssert(x.nElName == "Environ");
	aid = mizXmlAttr(x, "aid");
	dirs = ref makeTree();
	mizXmlNextElementState(x);
	while(\ -> x.nState == MizEStart, \ -> {
		if (x.nElName == "Directive") {
			name = mizXmlAttr(x, "name");
			ids = ref [];
			mizXmlNextElementState(x);
			while(\ -> x.nState == MizEStart, \ -> {
				if (x.nElName == "Ident") {
					ids := arrayPush(^ids, mizXmlAttr(x, "name"));
				}
				mizXmlSkipElement(x);
			});
			mizXmlNextElementState(x);
			dirs := setTree(^dirs, name, ^ids);
		} else {
			mizXmlSkipElement(x);
		}
	});
	MizEvl(aid, ^dirs);
}

// ---------------- the merged constructor table ----------------

mizMakeAccom(env : MizCorrelEnv, mmlDir : string) -> MizAccom {
	MizAccom(env, mmlDir, MizAccomState(makeTree(), makeTree(), makeTree()));
}

mizAccomBase(st : MizAccomState, article : string, kind : int) -> int {
	lookupTreeDef(lookupTreeDef(st.baseOf, article, makeTree()), kind, 0);
}

mizAccomOwn(st : MizAccomState, article : string, kind : int) -> int {
	switch (lookupTree(st.info, article)) {
		Some(inf): lookupTreeDef(inf.ownCounts, kind, 0);
		None(): 0;
	}
}

mizAccomMerged(st : MizAccomState, kind : int) -> int {
	lookupTreeDef(st.merged, kind, 0);
}

// record the frame an article occupies in the merged table: its base is the
// current total, and its own count is added to that total (inlibr ReadConstructors
// / ReadDCOBases both do exactly this — the second without loading anything)
mizAccomOpenFrame(st : MizAccomState, article : string, inf : MizDcoInfo) -> void {
	st.info ::= setTree(st.info, article, inf);
	bases = ref makeTree();
	fori(0, coLAST, \k -> bases := setTree(^bases, k, mizAccomMerged(st, k)));
	st.baseOf ::= setTree(st.baseOf, article, ^bases);
	fori(0, coLAST, \k ->
		st.merged ::= setTree(st.merged, k,
			mizAccomMerged(st, k) + lookupTreeDef(inf.ownCounts, k, 0)));
}

// read a .dco header: <Signature> article ids and <ConstrCounts>
mizReadDcoHeader(x : MizXmlParser) -> MizDcoInfo {
	sig = ref [];
	counts = ref makeTree();
	if (x.nState == MizEStart && x.nElName == "Signature") {
		mizXmlNextElementState(x);
		while(\ -> x.nState == MizEStart, \ -> {
			if (x.nElName == "ArticleID") sig := arrayPush(^sig, mizXmlAttr(x, "name"));
			mizXmlSkipElement(x);
		});
		mizXmlNextElementState(x);
	}
	if (x.nState == MizEStart && x.nElName == "ConstrCounts") {
		mizXmlNextElementState(x);
		while(\ -> x.nState == MizEStart, \ -> {
			if (x.nElName == "ConstrCount") {
				kindS = mizXmlAttr(x, "kind");
				k = mizConstructorKind(getCharCodeAt(kindS, 0));
				counts := setTree(^counts, k, mizXmlIntAttrDef(x, "nr", 0));
			}
			mizXmlSkipElement(x);
		});
		mizXmlNextElementState(x);
	}
	MizDcoInfo(^sig, ^counts);
}

// Translate a LOCAL (kind, nr) of a file's own numbering frame into the merged
// frame. The frame is the ordered article list the file numbers against — for a
// `.dco` that is its <Signature> followed by the article itself, for a `.dcl`
// its <Signature> already ends with the article. This is inlibr's gTrans built
// by AssignSTables, expressed arithmetically.
mizAccomTranslateIn(st : MizAccomState, frame : [string], kind : int, nr : int) -> int {
	if (nr == 0) 0 else {
		rest = ref nr;
		res = ref 0;
		i = ref 0;
		while(\ -> ^res == 0 && ^i < length(frame), \ -> {
			a = frame[^i];
			own = mizAccomOwn(st, a, kind);
			if (^rest <= own) {
				res := mizAccomBase(st, a, kind) + ^rest;
			} else {
				rest := ^rest - own;
			}
			i := ^i + 1;
		});
		// out of frame: an unresolved reference keeps its number (the original
		// would have reported connection fault 825 while reading the header)
		if (^res != 0) ^res else nr;
	}
}

// the .dco frame of `article`
mizAccomTranslate(st : MizAccomState, article : string, kind : int, nr : int) -> int {
	switch (lookupTree(st.info, article)) {
		None(): nr;
		Some(inf): mizAccomTranslateIn(st, arrayPush(inf.signature, article), kind, nr);
	}
}

// ---------------- renumbering a loaded constructor ----------------

// Every reference inside a constructor's types/terms/attributes carries the
// SOURCE article's numbering; rewrite each to the merged frame.
mizAccomRenumberTyp(tr : (int, int) -> int, t : MizTyp) -> void {
	if (t.sort == ikTypMode) {
		t.modNr ::= tr(coMode, t.modNr);
	} else if (t.sort == ikTypStruct) {
		t.modNr ::= tr(coStructMode, t.modNr);
	}
	mizAccomRenumberCluster(tr, t.lower);
	mizAccomRenumberCluster(tr, t.upper);
	mizAccomRenumberTrmList(tr, t.modArgs);
}

mizAccomRenumberCluster(tr : (int, int) -> int, c : MizAttrColl) -> void {
	iterVector(c.items, \a -> {
		a.attrNr ::= tr(coAttribute, a.attrNr);
		mizAccomRenumberTrmList(tr, a.args);
	});
}

mizAccomRenumberTrmList(tr : (int, int) -> int, l : MizTrmList) -> void {
	switch (l) {
		MizTrmNil(): {}
		MizTrmElem(trm, next): {
			mizAccomRenumberTrm(tr, trm);
			mizAccomRenumberTrmList(tr, next);
		}
	}
}

mizAccomRenumberTrm(tr : (int, int) -> int, t : MizTrm) -> void {
	switch (t) {
		MizFuncTrm(srt, funcNr, args, __, __): {
			ft : MizFuncTrm = t;
			kind = if (srt == ikTrmFunctor) coFunctor
				else if (srt == ikTrmSelector) coSelector
				else if (srt == ikTrmAggreg || srt == ikTrmSubAgreg) coAggregate
				else -1;
			if (kind >= 0) {
				ft.funcNr ::= tr(kind, funcNr);
			}
			mizAccomRenumberTrmList(tr, args);
		}
		MizPrivFuncTrm(__, args, expn, __, __): {
			mizAccomRenumberTrm(tr, expn);
			mizAccomRenumberTrmList(tr, args);
		}
		MizFraenkelTrm(lambdaArgs, scope, compr, __, __, __): {
			iterVector(lambdaArgs, \ty -> mizAccomRenumberTyp(tr, ty));
			mizAccomRenumberTrm(tr, scope);
			mizAccomRenumberFrm(tr, compr);
		}
		MizQuaTrm(trmProper, typ, __, __): {
			mizAccomRenumberTrm(tr, trmProper);
			mizAccomRenumberTyp(tr, typ);
		}
		MizChoiceTrm(typ, __, __): mizAccomRenumberTyp(tr, typ);
		default: {}
	}
}

mizAccomRenumberFrm(tr : (int, int) -> int, f : MizFrm) -> void {
	switch (f) {
		MizPredFrm(srt, predNr, args, __): {
			pf : MizPredFrm = f;
			kind = if (srt == ikFrmAttr) coAttribute else coPredicate;
			pf.predNr ::= tr(kind, predNr);
			mizAccomRenumberTrmList(tr, args);
		}
		MizLocPredFrm(__, args, expn, __): {
			mizAccomRenumberFrm(tr, expn);
			mizAccomRenumberTrmList(tr, args);
		}
		MizQualFrm(trm, typ, __): {
			mizAccomRenumberTrm(tr, trm);
			mizAccomRenumberTyp(tr, typ);
		}
		MizNegFrm(arg, __): mizAccomRenumberFrm(tr, arg);
		MizConjFrm(conjuncts, __): iterVector(conjuncts, \g -> mizAccomRenumberFrm(tr, g));
		MizUnivFrm(__, __, quantified, scope, __): {
			mizAccomRenumberTyp(tr, quantified);
			mizAccomRenumberFrm(tr, scope);
		}
		MizFlexFrm(__, lo, ro, lt, rt, expansion, __): {
			mizAccomRenumberFrm(tr, lo);
			mizAccomRenumberFrm(tr, ro);
			mizAccomRenumberFrm(tr, expansion);
			mizAccomRenumberTrm(tr, lt);
			mizAccomRenumberTrm(tr, rt);
		}
		default: {}
	}
}

mizAccomRenumberConstr(tr : (int, int) -> int, c : MizConstr) -> void {
	iterVector(c.primaries, \t -> mizAccomRenumberTyp(tr, t));
	switch (c.typ) {
		Some(t): mizAccomRenumberTyp(tr, t);
		None(): {}
	}
	iterVector(c.prefixes, \t -> mizAccomRenumberTyp(tr, t));
	// the REDEFINITION ORIGIN is a constructor of the same kind (inlibr
	// ReadConstructors translates fWhichConstrNr for the four kinds that
	// can be redefined)
	if (c.kind == coFunctor || c.kind == coAttribute || c.kind == coMode
		|| c.kind == coPredicate) {
		c.whichConstrNr ::= tr(c.kind, c.whichConstrNr);
	}
	if (c.structModeAggrNr != 0) {
		c.structModeAggrNr ::= tr(coAggregate, c.structModeAggrNr);
	}
	// field / aggregate selector lists are selector numbers
	newFields = mizInitNatSet(mizNatCount(c.fields));
	fori(0, mizNatCount(c.fields) - 1, \i ->
		mizNatInsertElem(newFields, tr(coSelector, mizNatItem(c.fields, i).x)));
	mizNatDeleteAll(c.fields);
	fori(0, mizNatCount(newFields) - 1, \i ->
		mizNatInsertElem(c.fields, mizNatItem(newFields, i).x));
	fori(0, mizSeqCount(c.aggrFields) - 1, \i ->
		mizSeqAtPut(c.aggrFields, i,
			tr(coSelector, mizSeqValue(c.aggrFields, i))));
}

// ---------------- the constructor pass ----------------

mizAccomConstructors(acc : MizAccom, evl : MizEvl) -> [string] {
	env = acc.env;
	mmlDir = acc.mmlDir;
	st = acc.st;
	articles = mizEvlDirective(evl, "constructors");
	loaded = ref [];
	// An article's own numbering assumes its <Signature> articles come first,
	// so the whole transitive signature closure must be merged BEFORE it —
	// even when the directive does not mention those articles (subset_1 pulls
	// in xboole_0 and zfmisc_1 that way). Collect the closure, then load in
	// signature-before-article order.
	sigOf = ref makeTree();
	need = ref [];
	seen = ref makeTree();
	work = ref articles;
	while(\ -> length(^work) > 0, \ -> {
		a = ^work[0];
		work := tail(^work);
		if (!containsKeyTree(^seen, a)) {
			seen := setTree(^seen, a, true);
			need := arrayPush(^need, a);
			path0 = mizPrelPath(mmlDir, a, ".dco");
			if (fileExists(path0)) {
				r0 = mizMakeVrfReader(mizXmlInitParsing(getFileContent(path0)), env);
				r0.mml ::= true;
				mizXmlNextElementState(r0.x);
				mizXmlNextElementState(r0.x);
				pre = mizReadDcoHeader(r0.x);
				sigOf := setTree(^sigOf, a, pre.signature);
				work := concat(pre.signature, ^work);
			} else {
				sigOf := setTree(^sigOf, a, []);
			}
		}
	});
	// POST-ORDER DFS in directive order: each article's signature closure is
	// merged immediately before it (Mizar's own order — verified against .atr)
	placed = ref makeTree();
	iter(articles, \root -> {
		stack = ref [Pair(root, false)];
		while(\ -> length(^stack) > 0, \ -> {
			top = ^stack[0];
			stack := tail(^stack);
			a = top.first;
			if (top.second) {
				if (!containsKeyTree(^placed, a)) {
					placed := setTree(^placed, a, true);
					mizAccomOneDco(env, st, mmlDir, a, loaded);
				}
			} else if (!containsKeyTree(^placed, a)) {
				// visit signature children first, then this article
				kids = map(lookupTreeDef(^sigOf, a, []), \p -> Pair(p, false));
				stack := concat(kids, concat([Pair(a, true)], ^stack));
			}
		});
	});
	^loaded;
}

mizAccomOneDco(env : MizCorrelEnv, st : MizAccomState, mmlDir : string,
		a : string, loaded : ref [string]) -> void {
	{
		path = mizPrelPath(mmlDir, a, ".dco");
		if (fileExists(path)) {
			r = mizMakeVrfReader(mizXmlInitParsing(getFileContent(path)), env);
			r.mml ::= true;
			x = r.x;
			mizXmlNextElementState(x);
			mizXmlAssert(x.nElName == "Constructors");
			mizXmlNextElementState(x);
			inf = mizReadDcoHeader(x);
			// the frame is opened BEFORE the constructors are read: a
			// constructor may refer to ITSELF or to a later one of its own
			// article (HIDDEN's root mode does), and the original resolves
			// those against the slots being created
			mizAccomOpenFrame(st, a, inf);
			tr = \k, nr -> mizAccomTranslate(st, a, k, nr);
			while(\ -> x.nState == MizEStart, \ -> {
				if (x.nElName == "Constructor") {
					c = mizInConstructor1(r);
					slot = mizConstrCount(env, c.kind) + 1;
					mizAccomRenumberConstr(tr, c);
					pushed = mizPushConstr(env, c);
					if (pushed != slot) mizRunTimeError(2804);
				} else {
					mizXmlSkipElement(x);
				}
			});
			loaded := arrayPush(^loaded, a);
		}
	}
}

// ---------------- the registration pass (.ecl) ----------------

// Make sure every article of a `.dcl`'s <Signature> occupies a frame in the
// merged table. Articles outside the constructors closure get a frame WITHOUT
// their constructors — inlibr InitDCOBases/ReadDCOBases call them "the cutting
// off constructors": only their counts shift the numbering, and RestoreDCOBases
// drops the frames again once the file is processed.
mizAccomEnsureBases(acc : MizAccom, sig : [string]) -> [string] {
	st = acc.st;
	added = ref [];
	iter(sig, \a -> {
		if (!containsKeyTree(st.info, a)) {
			path = mizPrelPath(acc.mmlDir, a, ".dco");
			inf = if (fileExists(path)) {
				r = mizMakeVrfReader(mizXmlInitParsing(getFileContent(path)), acc.env);
				r.mml ::= true;
				mizXmlNextElementState(r.x);
				mizXmlNextElementState(r.x);
				mizReadDcoHeader(r.x);
			} else {
				MizDcoInfo([], makeTree());
			};
			mizAccomOpenFrame(st, a, inf);
			added := arrayPush(^added, a);
		}
	});
	^added;
}

// ---------------- accessibility (inlibr Accessible*) ----------------
//
// gChosen[kind] is the identity over 1..gConstrNbr — the count reached by the
// CONSTRUCTOR pass (ChooseConstrutors runs once, before ProcessClusters). So a
// reference is accessible exactly when it lands inside the merged table: a
// registration mentioning a cut-off article's constructor is DROPPED.

// no forallVector in ds/vector
mizAccForall(v : Vector<?>, f : (?) -> bool) -> bool {
	foldVector(v, true, \acc, x -> acc && f(x));
}

mizAccChosen(env : MizCorrelEnv, kind : int, nr : int) -> bool {
	nr >= 1 && nr <= mizConstrCount(env, kind);
}

mizAccTrmList(env : MizCorrelEnv, l : MizTrmList) -> bool {
	switch (l) {
		MizTrmNil(): true;
		MizTrmElem(trm, next): mizAccTrm(env, trm) && mizAccTrmList(env, next);
	}
}

mizAccTrm(env : MizCorrelEnv, t : MizTrm) -> bool {
	switch (t) {
		MizFuncTrm(srt, funcNr, args, __, __): {
			kind = if (srt == ikTrmFunctor) coFunctor
				else if (srt == ikTrmSelector) coSelector
				else if (srt == ikTrmAggreg || srt == ikTrmSubAgreg) coAggregate
				else -1;
			(kind < 0 || mizAccChosen(env, kind, funcNr)) && mizAccTrmList(env, args);
		}
		MizPrivFuncTrm(__, args, __, __, __): mizAccTrmList(env, args);
		MizFraenkelTrm(lambdaArgs, scope, compr, __, __, __):
			mizAccForall(lambdaArgs, \ty -> mizAccTyp(env, ty))
			&& mizAccTrm(env, scope) && mizAccFrm(env, compr);
		MizQuaTrm(trmProper, typ, __, __): mizAccTrm(env, trmProper) && mizAccTyp(env, typ);
		MizChoiceTrm(typ, __, __): mizAccTyp(env, typ);
		default: true;
	}
}

mizAccCluster(env : MizCorrelEnv, c : MizAttrColl) -> bool {
	mizAccForall(c.items, \a -> mizAccChosen(env, coAttribute, a.attrNr)
		&& mizAccTrmList(env, a.args));
}

mizAccTyp(env : MizCorrelEnv, t : MizTyp) -> bool {
	mizAccCluster(env, t.lower)
	&& mizAccChosen(env, if (t.sort == ikTypStruct) coStructMode else coMode, t.modNr)
	&& mizAccTrmList(env, t.modArgs);
}

mizAccFrm(env : MizCorrelEnv, f : MizFrm) -> bool {
	switch (f) {
		MizPredFrm(srt, predNr, args, __): {
			ok = if (srt == ikFrmAttr) mizAccChosen(env, coAttribute, predNr)
				else if (srt == ikFrmPred) mizAccChosen(env, coPredicate, predNr)
				else true;   // ikFrmSchPred: arguments only
			ok && mizAccTrmList(env, args);
		}
		MizLocPredFrm(__, args, __, __): mizAccTrmList(env, args);
		MizQualFrm(trm, typ, __): mizAccTrm(env, trm) && mizAccTyp(env, typ);
		MizNegFrm(arg, __): mizAccFrm(env, arg);
		MizConjFrm(conjuncts, __): mizAccForall(conjuncts, \g -> mizAccFrm(env, g));
		MizUnivFrm(__, __, quantified, scope, __):
			mizAccTyp(env, quantified) && mizAccFrm(env, scope);
		MizFlexFrm(__, lo, ro, __, __, __, __): mizAccFrm(env, lo) && mizAccFrm(env, ro);
		default: true;
	}
}

mizAccTypColl(env : MizCorrelEnv, v : Vector<MizTyp>) -> bool {
	mizAccForall(v, \t -> mizAccTyp(env, t));
}

// the per-kind accessibility test of ProcessClusters
mizAccCluster1(env : MizCorrelEnv, c : MizAnyCluster) -> bool {
	switch (c) {
		MizRCluster(__, __, prims, cons, typ):
			mizAccTypColl(env, prims) && mizAccTyp(env, typ)
			&& mizAccCluster(env, cons.lower);
		MizFCluster(__, __, prims, cons, trm, typ):
			mizAccTypColl(env, prims) && mizAccTrm(env, trm)
			&& (switch (typ) { Some(t): mizAccTyp(env, t); None(): true; })
			&& mizAccCluster(env, cons.lower);
		MizCCluster(__, __, prims, ante, cons, typ):
			mizAccTypColl(env, prims) && mizAccTyp(env, typ)
			&& mizAccCluster(env, ante) && mizAccCluster(env, cons.lower);
	}
}

mizAccomRenumberCl(tr : (int, int) -> int, c : MizClusterRec) -> void {
	mizAccomRenumberCluster(tr, c.lower);
	mizAccomRenumberCluster(tr, c.upper);
}

mizAccomClusters(acc : MizAccom, cl : MizClusters, evl : MizEvl) -> void {
	st = acc.st;
	iter(mizEvlDirective(evl, "registrations"), \art -> {
		path = mizPrelPath(acc.mmlDir, art, ".dcl");
		if (fileExists(path)) {
			r = mizMakeVrfReaderMML(mizXmlInitParsing(getFileContent(path)), acc.env);
			x = r.x;
			mizXmlNextElementState(x);
			mizXmlAssert(x.nElName == "Registrations");
			mizXmlNextElementState(x);
			// a .dcl numbers against its <Signature>, which already ENDS with
			// the article itself (unlike a .dco's)
			sig = mizReadDcoHeader(x).signature;
			savedMerged = st.merged;
			added = mizAccomEnsureBases(acc, sig);
			tr = \k, nr -> mizAccomTranslateIn(st, sig, k, nr);
			// the original renumbers the registration WITHIN the file's frame,
			// then renumbers it once more: `nr` becomes its index among the
			// article's registrations of that kind. lRegNr counts EVERY cluster
			// (acc_han.pas 887), lFunNr and lCondNr only their own kind.
			regNr = ref 0;
			funNr = ref 0;
			condNr = ref 0;
			while(\ -> x.nState == MizEStart, \ -> {
				switch (mizReadClusterVal(r)) {
					None(): {}
					Some(c): {
						regNr := ^regNr + 1;
						renumbered : MizAnyCluster = switch (c) {
							MizRCluster(__, __, prims, cons, typ): {
								mizAccomRenumberCl(tr, cons);
								iterVector(prims, \t -> mizAccomRenumberTyp(tr, t));
								mizAccomRenumberTyp(tr, typ);
								MizRCluster(art, ^regNr, prims, cons, typ);
							}
							MizFCluster(__, __, prims, cons, trm, typ): {
								mizAccomRenumberCl(tr, cons);
								iterVector(prims, \t -> mizAccomRenumberTyp(tr, t));
								mizAccomRenumberTrm(tr, trm);
								switch (typ) {
									Some(t): mizAccomRenumberTyp(tr, t);
									None(): {}
								}
								funNr := ^funNr + 1;
								MizFCluster(art, ^funNr, prims, cons, trm, typ);
							}
							MizCCluster(__, __, prims, ante, cons, typ): {
								mizAccomRenumberCluster(tr, ante);
								iterVector(prims, \t -> mizAccomRenumberTyp(tr, t));
								mizAccomRenumberTyp(tr, typ);
								mizAccomRenumberCl(tr, cons);
								condNr := ^condNr + 1;
								MizCCluster(art, ^condNr, prims, ante, cons, typ);
							}
						};
						// a registration reaching a CUT-OFF article's
						// constructor is inaccessible and dropped — but it
						// has still consumed its number
						if (mizAccCluster1(acc.env, renumbered)) {
							mizInsertAnyCluster(acc.env, cl, renumbered);
						}
					}
				}
			});
			// RestoreDCOBases
			st.merged ::= savedMerged;
			iter(added, \a -> {
				st.info ::= removeFromTree(st.info, a);
				st.baseOf ::= removeFromTree(st.baseOf, a);
			});
		}
	});
}

// ---------------- the theorem pass (.eth) ----------------

mizAccomArticleOrder(evl : MizEvl) -> [string] {
	th = mizEvlDirective(evl, "theorems");
	concat(th, filter(mizEvlDirective(evl, "schemes"), \a -> !contains(th, a)));
}

// ProcessTheorems: per directive article, translate every theorem into the
// merged frame, drop the inaccessible ones, and number the two kinds
// SEPARATELY in file order — the counters advance for dropped theorems too.
mizAccomTheorems(acc : MizAccom, evl : MizEvl) -> Pair<Tree<int, MizFrm>, int> {
	st = acc.st;
	order = mizAccomArticleOrder(evl);
	out = ref makeTree();
	iter(mizEvlDirective(evl, "theorems"), \art -> {
		artNr = 1 + elemIndex(order, art, -1);
		path = mizPrelPath(acc.mmlDir, art, ".the");
		if (artNr > 0 && fileExists(path)) {
			r = mizMakeVrfReaderMML(mizXmlInitParsing(getFileContent(path)), acc.env);
			x = r.x;
			mizXmlNextElementState(x);
			mizXmlAssert(x.nElName == "Theorems");
			mizXmlNextElementState(x);
			sig = mizReadDcoHeader(x).signature;
			savedMerged = st.merged;
			added = mizAccomEnsureBases(acc, sig);
			tr = \k, nr -> mizAccomTranslateIn(st, sig, k, nr);
			thNr = ref 0;
			defNr = ref 0;
			while(\ -> x.nState == MizEStart, \ -> {
				if (x.nElName == "Theorem") {
					kindS = mizXmlAttr(x, "kind");
					kind = if (kindS == "T") kindT else kindD;
					mizXmlNextElementState(x);
					f = mizInFormula(r);
					mizXmlNextElementState(x);
					mizAccomRenumberFrm(tr, f);
					curNr = if (kind == kindD) { defNr := ^defNr + 1; ^defNr }
						else { thNr := ^thNr + 1; ^thNr };
					if (mizAccFrm(acc.env, f)) {
						out := setTree(^out, mizThKey(kind, artNr, curNr), f);
					}
				} else {
					mizXmlSkipElement(x);
				}
			});
			st.merged ::= savedMerged;
			iter(added, \a -> {
				st.info ::= removeFromTree(st.info, a);
				st.baseOf ::= removeFromTree(st.baseOf, a);
			});
		}
	});
	Pair(^out, length(order) + 1);
}

// ---------------- the scheme pass (.esh) ----------------

// ProcessSchemes: like the theorems, but the number is the scheme's INDEX in
// its file (accessible or not) and both the argument types and every
// proposition must be accessible.
mizAccomSchemes(acc : MizAccom, evl : MizEvl) -> MizSchemes {
	st = acc.st;
	order = mizAccomArticleOrder(evl);
	out = mizMakeSchemes();
	iter(mizEvlDirective(evl, "schemes"), \art -> {
		artNr = 1 + elemIndex(order, art, -1);
		path = mizPrelPath(acc.mmlDir, art, ".sch");
		if (artNr > 0 && fileExists(path)) {
			r = mizMakeVrfReaderMML(mizXmlInitParsing(getFileContent(path)), acc.env);
			x = r.x;
			mizXmlNextElementState(x);
			mizXmlAssert(x.nElName == "Schemes");
			mizXmlNextElementState(x);
			sig = mizReadDcoHeader(x).signature;
			savedMerged = st.merged;
			added = mizAccomEnsureBases(acc, sig);
			tr = \k, nr -> mizAccomTranslateIn(st, sig, k, nr);
			schNr = ref 0;
			while(\ -> x.nState == MizEStart, \ -> {
				if (x.nElName == "Scheme") {
					mizXmlNextElementState(x);
					types = if (x.nState == MizEStart && x.nElName == "ArgTypes") {
						mizInArgColl(r);
					} else {
						makeVector(0);
					}
					props = ref [];
					bad = ref false;
					while(\ -> x.nState == MizEStart, \ -> {
						if (mizIsFrmEl(x.nElName)) {
							props := arrayPush(^props, mizInFormula(r));
						} else {
							if (x.nElName == "Canceled" || x.nElName == "ErrorScheme") {
								bad := true;
							}
							mizXmlSkipElement(x);
						}
					});
					mizXmlNextElementState(x);
					schNr := ^schNr + 1;
					iterVector(types, \ty -> mizAccomRenumberTyp(tr, ty));
					iter(^props, \f -> mizAccomRenumberFrm(tr, f));
					if (mizAccTypColl(acc.env, types)
						&& forall(^props, \f -> mizAccFrm(acc.env, f))) {
						pushVector(out.items,
							MizSchemeDef(artNr, ^schNr, types, ^props, !^bad));
					}
				} else {
					mizXmlSkipElement(x);
				}
			});
			st.merged ::= savedMerged;
			iter(added, \a -> {
				st.info ::= removeFromTree(st.info, a);
				st.baseOf ::= removeFromTree(st.baseOf, a);
			});
		}
	});
	out;
}

// ---------------- the definientia passes (.dfs / .dfe / .dfx) ----------------

mizAccomDefConstrKind(k : int) -> int {
	if (k == ikFrmPred) coPredicate
	else if (k == ikTypMode) coMode
	else if (k == ikTrmFunctor) coFunctor
	else if (k == ikFrmAttr) coAttribute
	else -1;
}

mizAccomRenumberDefBody(tr : (int, int) -> int, b : MizDefBody) -> void {
	switch (b) {
		MizDefFrm(f): mizAccomRenumberFrm(tr, f);
		MizDefTrm(t): mizAccomRenumberTrm(tr, t);
	}
}

// TransMMLDefiniens
mizAccomRenumberDefiniens(tr : (int, int) -> int, d : MizDefiniens) -> void {
	k = mizAccomDefConstrKind(d.constrKind);
	if (k >= 0) d.constrNr ::= tr(k, d.constrNr);
	iterVector(d.primaries, \t -> mizAccomRenumberTyp(tr, t));
	mizAccomRenumberFrm(tr, d.assumptions);
	switch (d.def) {
		None(): {}
		Some(def): {
			switch (def.otherwise) {
				Some(b): mizAccomRenumberDefBody(tr, b);
				None(): {}
			}
			iterVector(def.partials, \pd -> {
				mizAccomRenumberDefBody(tr, pd.body);
				mizAccomRenumberFrm(tr, pd.guard);
			});
		}
	}
}

// AccesibleDefiniens
mizAccDefiniens(env : MizCorrelEnv, d : MizDefiniens) -> bool {
	k = mizAccomDefConstrKind(d.constrKind);
	(k < 0 || mizAccChosen(env, k, d.constrNr))
	&& mizAccTypColl(env, d.primaries)
	&& mizAccFrm(env, d.assumptions)
	&& (switch (d.def) {
		None(): false;      // `if Definiens = nil then exit` — inaccessible
		Some(def): {
			mizAccForall(def.partials, \pd -> (switch (pd.body) {
					MizDefFrm(f): mizAccFrm(env, f);
					MizDefTrm(t): mizAccTrm(env, t);
				}) && mizAccFrm(env, pd.guard))
			&& (switch (def.otherwise) {
				None(): true;
				Some(b): switch (b) {
					MizDefFrm(f): mizAccFrm(env, f);
					MizDefTrm(t): mizAccTrm(env, t);
				}
			});
		}
	});
}

mizAccomDefinientia(acc : MizAccom, evl : MizEvl, directive : string)
		-> Vector<MizDefiniens> {
	st = acc.st;
	out : Vector<MizDefiniens> = makeVector(16);
	iter(mizEvlDirective(evl, directive), \art -> {
		path = mizPrelPath(acc.mmlDir, art, ".def");
		if (fileExists(path)) {
			r = mizMakeVrfReaderMML(mizXmlInitParsing(getFileContent(path)), acc.env);
			x = r.x;
			mizXmlNextElementState(x);
			mizXmlAssert(x.nElName == "Definientia");
			mizXmlNextElementState(x);
			sig = mizReadDcoHeader(x).signature;
			savedMerged = st.merged;
			added = mizAccomEnsureBases(acc, sig);
			tr = \k, nr -> mizAccomTranslateIn(st, sig, k, nr);
			while(\ -> x.nState == MizEStart, \ -> {
				if (x.nElName == "Definiens") {
					d = mizInDefiniens(r);
					mizAccomRenumberDefiniens(tr, d);
					if (mizAccDefiniens(acc.env, d)) pushVector(out, d);
				} else {
					mizXmlSkipElement(x);
				}
			});
			st.merged ::= savedMerged;
			iter(added, \a -> {
				st.info ::= removeFromTree(st.info, a);
				st.baseOf ::= removeFromTree(st.baseOf, a);
			});
		}
	});
	out;
}

// ---------------- the identify / reduce passes (.eid / .erd) ----------------

// both passes walk the REGISTRATIONS directive and differ only in the file
// they read and the item they keep
mizAccomIdentifyPass(acc : MizAccom, evl : MizEvl, ext : string, rootEl : string,
		read : (MizIdentify, MizVrfReader) -> void,
		take : (MizIdentify, (int, int) -> int) -> void) -> void {
	st = acc.st;
	iter(mizEvlDirective(evl, "registrations"), \art -> {
		path = mizPrelPath(acc.mmlDir, art, ext);
		if (fileExists(path)) {
			r = mizMakeVrfReaderMML(mizXmlInitParsing(getFileContent(path)), acc.env);
			x = r.x;
			mizXmlNextElementState(x);
			mizXmlAssert(x.nElName == rootEl);
			mizXmlNextElementState(x);
			sig = mizReadDcoHeader(x).signature;
			savedMerged = st.merged;
			added = mizAccomEnsureBases(acc, sig);
			tr = \k, nr -> mizAccomTranslateIn(st, sig, k, nr);
			scratch = mizMakeIdentify(acc.env);
			while(\ -> x.nState == MizEStart, \ -> read(scratch, r));
			take(scratch, tr);
			st.merged ::= savedMerged;
			iter(added, \a -> {
				st.info ::= removeFromTree(st.info, a);
				st.baseOf ::= removeFromTree(st.baseOf, a);
			});
		}
	});
}

mizAccomIdentifications(acc : MizAccom, evl : MizEvl, idn : MizIdentify) -> void {
	mizAccomIdentifyPass(acc, evl, ".did", "IdentifyRegistrations",
		\scratch, r -> {
			if (r.x.nElName == "Identify") mizReadOneIdentify(scratch, r)
			else mizXmlSkipElement(r.x);
		},
		\scratch, tr -> iterVector(scratch.identifications, \it -> {
			iterVector(it.primaries, \t -> mizAccomRenumberTyp(tr, t));
			mizAccomRenumberTrm(tr, it.pattern0);
			mizAccomRenumberTrm(tr, it.pattern1);
			// AccesibleIdentify
			if (mizAccTypColl(acc.env, it.primaries)
				&& mizAccTrm(acc.env, it.pattern0)
				&& mizAccTrm(acc.env, it.pattern1)) {
				pushVector(idn.identifications, it);
			}
		}));
}

mizAccomReductions(acc : MizAccom, evl : MizEvl, idn : MizIdentify) -> void {
	mizAccomIdentifyPass(acc, evl, ".drd", "ReductionRegistrations",
		\scratch, r -> {
			if (r.x.nElName == "Reduction") mizReadOneReduction(scratch, r)
			else mizXmlSkipElement(r.x);
		},
		\scratch, tr -> iterVector(scratch.reductions, \rd -> {
			iterVector(rd.primaries, \t -> mizAccomRenumberTyp(tr, t));
			mizAccomRenumberTrm(tr, rd.t0);
			mizAccomRenumberTrm(tr, rd.t1);
			// AccesibleReduction
			if (mizAccTypColl(acc.env, rd.primaries)
				&& mizAccTrm(acc.env, rd.t0) && mizAccTrm(acc.env, rd.t1)) {
				pushVector(idn.reductions, rd);
			}
		}));
}

// ---------------- the requirements pass (.ere) ----------------

// ProcessRequirements: one (constructor kind, nr) per requirement, translated
// into the merged frame. The original then maps it through gChosen.ElemNr+1,
// which is the identity over the merged table, so the translated number IS
// the value written to the .ere.
mizAccomRequirements(acc : MizAccom, evl : MizEvl) -> void {
	st = acc.st;
	iter(mizEvlDirective(evl, "requirements"), \art -> {
		path = mizPrelPath(acc.mmlDir, art, ".dre");
		if (fileExists(path)) {
			r = mizMakeVrfReaderMML(mizXmlInitParsing(getFileContent(path)), acc.env);
			x = r.x;
			mizXmlNextElementState(x);
			mizXmlAssert(x.nElName == "Requirements");
			mizXmlNextElementState(x);
			sig = mizReadDcoHeader(x).signature;
			savedMerged = st.merged;
			added = mizAccomEnsureBases(acc, sig);
			while(\ -> x.nState == MizEStart, \ -> {
				if (x.nElName == "Requirement") {
					kindS = mizXmlAttr(x, "constrkind");
					kind = mizConstructorKind(getCharCodeAt(kindS, 0));
					nr = mizXmlIntAttrDef(x, "constrnr", 0);
					reqNr = mizXmlIntAttrDef(x, "nr", 0);
					merged = mizAccomTranslateIn(st, sig, kind, nr);
					if (reqNr >= 0 && reqNr <= rqLAST
						&& mizAccChosen(acc.env, kind, merged)) {
						mizSetBuiltIn(acc.env.builtIn, reqNr, merged);
					}
				}
				mizXmlSkipElement(x);
			});
			st.merged ::= savedMerged;
			iter(added, \a -> {
				st.info ::= removeFromTree(st.info, a);
				st.baseOf ::= removeFromTree(st.baseOf, a);
			});
		}
	});
}

// ---------------- the whole accommodation ----------------

mizAccomEnvLoader(mmlDir : string, article : string) -> MizEnvLoader {
	evl = mizLoadEvl(mmlDir + "/" + article + ".evl");
	// the state is shared by the two phases
	accRef : ref Maybe<MizAccom> = ref None();
	MizEnvLoader(
		\env -> {
			acc = mizMakeAccom(env, mmlDir);
			accRef := Some(acc);
			mizAccomConstructors(acc, evl);
			mizAccomRequirements(acc, evl);
		},
		\env, cl, idn, defs, p -> {
			switch (^accRef) {
				None(): mizRunTimeError(2805);
				Some(acc): {
					th = mizAccomTheorems(acc, evl);
					p.theorems ::= th.first;
					p.ownArticleNr ::= th.second;
					mizAccomClusters(acc, cl, evl);
					mizAccomReductions(acc, evl, idn);
					mizAccomIdentifications(acc, evl, idn);
					iterVector(mizAccomSchemes(acc, evl).items,
						\sc -> pushVector(p.schemes.items, sc));
					iterVector(mizAccomDefinientia(acc, evl, "definitions"),
						\d -> pushVector(defs.all, d));
					iterVector(mizAccomDefinientia(acc, evl, "expansions"),
						\d -> pushVector(defs.expansions, d));
					iterVector(mizAccomDefinientia(acc, evl, "equalities"),
						\d -> mizAddEqualsDef(env, defs, d));
				}
			}
		});
}
