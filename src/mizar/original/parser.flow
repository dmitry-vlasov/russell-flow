mizSyLeftCurlyBracket = 123; mizSyRightCurlyBracket = 125;
mizSyCorrectness = 135; mizSyIf = 140; mizSyIs = 144; mizSyAre = 145;
mizSyOtherwise = 147; mizSyEx = 156; mizSyFor = 157; mizSyDefine = 159;
mizSyBeing = 161; mizSyOver = 162; mizSyCanceled = 164; mizSyDo = 165;
mizSyDoes = 166; mizSyOr = 167; mizSyWhere = 168; mizSyNon = 169;
mizSyNot = 170; mizSyCluster = 171; mizSyAttr = 172;
mizSyStructLeftBracket = 174; mizSyStructRightBracket = 175;
mizSyEnviron = 176; mizSyBegin = 178; mizSyHence = 185; mizSyHereby = 188;
mizSyThen = 192; mizSyDotEquals = 193; mizSySynonym = 196;
mizSyAntonym = 197; mizSyLet = 200; mizSyTake = 201; mizSyAssume = 202;
mizSyThus = 203; mizSyGiven = 204; mizSySuppose = 205; mizSyConsider = 206;
mizSyArrow = 211; mizSyAs = 212; mizSyQua = 213; mizSyBe = 214;
mizSyReserve = 215; mizSySet = 224; mizSySelector = 225; mizSyCases = 226;
mizSyPer = 227; mizSyScheme = 228; mizSyRedefine = 229;
mizSyReconsider = 230; mizSyCase = 231; mizSyPrefix = 232; mizSyThe = 233;
mizSyIt = 234; mizSyAll = 235; mizSyTheorem = 236; mizSyStruct = 237;
mizSyExactly = 238; mizSyMode = 239; mizSyIff = 240; mizSyFunc = 241;
mizSyPred = 242; mizSyImplies = 243; mizSySt = 244; mizSyHolds = 245;
mizSyProvided = 246; mizSyMeans = 247; mizSyOf = 248; mizSyDefpred = 249;
mizSyDeffunc = 250; mizSySuch = 251; mizSyThat = 252; mizSyAggregate = 253;
mizSyAnd = 254;

mizMaxVisArgNbr = 10;

// ---- error numbers used by the grammar (parser.pas 28-148) ----
paUnexpOf = 183; paUnexpOver = 184; paUnpairedSymbol = 214; paEndExp = 215;
paAdjClusterExp = 223; paPerExp = 231; paSupposeOrCaseExp = 232;
paOfExp = 256; paAllExp = 275; paIdentExp = 300; paWrongPredPattern = 301;
paFunctExp = 302; paWrongModePatternBeg = 303; paStructExp = 304;
paSelectExp = 305; paAttrExp = 306; paNumExp = 307; paWrongReferenceBeg = 308;
paTypeOrAttrExp = 309; paRightBraExp = 310; paWrongRightBracket = 311;
paDefExp = 312; paSchExp = 313; paWrongPattBeg = 314;
paWrongModePatternSet = 315; paWrongAfterThe = 320; paWrongPredSymbol = 321;
paSemicolonExp = 330; paWrongScopeBeg = 340; paThatExp = 350;
paCasesExp = 351; paLeftParenthExp = 360; paLeftSquareExp = 361;
paLeftCurledExp = 362; paLeftDoubleExp = 363; paWrongSchemeVarQual = 364;
paRightParenthExp = 370; paRightSquareExp = 371; paRightCurledExp = 372;
paRightDoubleExp = 373; paWrongAttrPrefixExpr = 375;
paWrongAttrArgumentSuffix = 376; paTypeExpInAdjectiveCluster = 377;
paEqualityExp = 380; paIfExp = 381; paForExp = 382; paIsExp = 383;
paColonExp = 384; paArrowExp = 385; paMeansExp = 386; paStExp = 387;
paAsExp = 388; paProofExp = 389; paWithExp = 390; paWrongItemBeg = 391;
paUnexpItemBeg = 392; paWrongJustificationBeg = 395; paWrongFormulaBeg = 396;
paWrongTermBeg = 397; paWrongRadTypeBeg = 398; paWrongFunctorPatternBeg = 399;
paNotExpected = 401; paInfinitiveExp = 402; paSuchExp = 403; paToExp = 404;
paTypeUnexpInClusterRegistration = 405; paForOrArrowExpected = 406;
paUnexpReconsider = 228; paUnexpHereby = 216; paUnexpRedef = 273;
paUnexpEquals = 186; paUnexpAntonym = 198; paUnexpSynonym = 199;

// gMainSet (parser.pas 151) — the recovery set
mizInMainSet(k : int) -> bool {
	k == mizSyBegin || k == mizSySemicolon || k == mizSyProof || k == mizSyNow
	|| k == mizSyHereby || k == mizSyDefinition || k == mizSyEnd
	|| k == mizSyTheorem || k == mizSyReserve || k == mizSyNotation
	|| k == mizSyRegistration || k == mizSyScheme || k == mizSyEOT
	|| k == mizSyDeffunc || k == mizSyDefpred || k == mizSyReconsider
	|| k == mizSyConsider || k == mizSyThen || k == mizSyPer || k == mizSyCase
	|| k == mizSySuppose;
}

// TermBegSys (parser.pas 238)
mizInTermBegSys(k : int) -> bool {
	k == mizSyIdentifier || k == mizSyInfixOperatorSymbol || k == mizSyNumeral
	|| k == mizSyLeftCircumfixSymbol || k == mizSyLeftParanthesis
	|| k == mizSyIt || k == mizSyLeftCurlyBracket || k == mizSyLeftSquareBracket
	|| k == mizSyThe || k == mizSyDolar || k == mizSyStructureSymbol;
}

// TermBegSys without ( and the structure symbol — ProcessAttributes' guard
mizInTermBegSysNoParStruct(k : int) -> bool {
	mizInTermBegSys(k) && k != mizSyLeftParanthesis && k != mizSyStructureSymbol;
}

// ------------------------------------------------------------ scanning -----

// mscanner.pas ReadToken
mizReadToken(p : MizParser) -> void {
	p.prevWord ::= p.curWord;
	p.prevPos ::= p.curPos;
	p.curWord ::= p.aheadWord;
	p.curPos ::= p.aheadPos;
	if (p.curWord.kind == mizSyBegin) mizScAllowUnderscore(p.sc, false);
	if (p.curWord.kind == mizSyError && p.curWord.nr == 200) mizErrImmP(p, p.curWord.nr);
	{ h = p.eh; h.curPos ::= p.curPos; }
	mizScGetToken(p.sc);
	p.aheadWord ::= p.sc.lexem;
	p.aheadPos ::= MizPos(p.sc.lexem.line, p.sc.lexem.col);
}

// mscanner.pas StartScaner
mizStartScanner(p : MizParser) -> void {
	p.curPos ::= MizPos(1, 0);
	p.aheadWord ::= p.sc.lexem;
	p.aheadPos ::= MizPos(p.sc.lexem.line, p.sc.lexem.col);
}

// ------------------------------------------------------ error recovery -----

mizSynErr(p : MizParser, pos : MizPos, errNr : int) -> void {
	if (p.stillCorrect) {
		p.stillCorrect ::= false;
		if (p.curWord.kind == mizSyError) {
			if (p.curWord.nr != 200) mizErrImmP(p, p.curWord.nr)
			else mizErrorP(p, pos, errNr);
		} else mizErrorP(p, pos, errNr);
		while(\ -> !mizInMainSet(p.curWord.kind), \ -> mizReadToken(p));
	}
}

mizMissingWord(p : MizParser, errNr : int) -> void {
	mizSynErr(p, MizPos(p.prevPos.line, p.prevPos.col + 1), errNr);
}

mizWrongWord(p : MizParser, errNr : int) -> void { mizSynErr(p, p.curPos, errNr); }

mizSemicolon(p : MizParser) -> void {
	mizKillItem(p);
	if (p.curWord.kind != mizSySemicolon) mizMissingWord(p, paSemicolonExp);
	if (p.curWord.kind == mizSySemicolon) mizReadToken(p);
}

mizAcceptEnd(p : MizParser, pos : MizPos) -> void {
	if (p.curWord.kind == mizSyEnd) mizReadToken(p)
	else {
		mizErrorP(p, pos, paEndExp);
		mizMissingWord(p, paUnpairedSymbol);
	}
}

mizOccurs(p : MizParser, k : int) -> bool {
	if (p.curWord.kind == k) { mizReadToken(p); true } else false;
}

mizAccept(p : MizParser, k : int, errNr : int) -> void {
	if (!mizOccurs(p, k)) mizMissingWord(p, errNr);
}

// ----------------------------------------------------- E x p r e s s i o n s

mizOpenParenth(p : MizParser, cnt : ref int) -> void {
	cnt := 0;
	while(\ -> p.curWord.kind == mizSyLeftParanthesis, \ -> {
		mizReadToken(p);
		cnt := ^cnt + 1;
	});
}

mizCloseParenth(p : MizParser, cnt : ref int) -> void {
	while(\ -> p.curWord.kind == mizSyRightParanthesis && ^cnt > 0, \ -> {
		cnt := ^cnt - 1;
		mizReadToken(p);
	});
}

mizAppendQua(p : MizParser) -> void {
	while(\ -> p.curWord.kind == mizSyQua, \ -> {
		mizSubProcessQua(p);
		mizReadToken(p);
		mizTypeSubexpression(p);
		mizSubFinishQualifiedTerm(p);
	});
	if (p.curWord.kind == mizSyExactly) {
		mizSubProcessExactly(p);
		mizReadToken(p);
	}
}

mizBracketedTerm(p : MizParser) -> void {
	mizSubStartBracketedTerm(p);
	mizReadToken(p);
	mizGetArguments(p, mizMaxVisArgNbr);
	mizSubFinishBracketedTerm(p);
}

mizProcessPostqualification(p : MizParser) -> void {
	mizSubStartPostqualification(p);
	while(\ -> p.curWord.kind == mizSyWhere, \ -> {
		mizRepeat(\ -> {
			mizSubStartPostqualifyingSegment(p);
			mizReadToken(p);
			mizRepeat(\ -> {
				mizSubProcessPostqualifiedVariable(p);
				mizAccept(p, mizSyIdentifier, paIdentExp);
				mizOccurs(p, mizSyComma);
			});
			mizSubStartPostqualificationSpecyfication(p);
			if (p.curWord.kind == mizSyIs || p.curWord.kind == mizSyAre) {
				mizReadToken(p);
				mizTypeSubexpression(p);
			}
			mizSubFinishPostqualifyingSegment(p);
			p.curWord.kind == mizSyComma;
		});
	});
}

// `repeat body until cond` — run once, then again while the body's result is
// true (the Pascal `until` condition is the NEGATION, so each site returns the
// continue condition).
mizRepeat(body : () -> bool) -> void {
	if (body()) mizRepeat(body);
}

mizGetClosedSubterm(p : MizParser) -> void {
	k = p.curWord.kind;
	if (k == mizSyIdentifier) {
		if (p.aheadWord.kind == mizSyLeftParanthesis) {
			mizSubStartPrivateTerm(p);
			mizReadToken(p);
			mizReadToken(p);
			if (p.curWord.kind != mizSyRightParanthesis) mizGetArguments(p, mizMaxVisArgNbr);
			mizSubFinishPrivateTerm(p);
			mizAccept(p, mizSyRightParanthesis, paRightParenthExp);
		} else {
			mizSubProcessSimpleTerm(p);
			mizReadToken(p);
		}
	} else if (k == mizSyStructureSymbol) {
		mizSubStartAggregateTerm(p);
		mizReadToken(p);
		mizAccept(p, mizSyStructLeftBracket, paLeftDoubleExp);
		mizGetArguments(p, mizMaxVisArgNbr);
		mizSubFinishAggregateTerm(p);
		mizAccept(p, mizSyStructRightBracket, paRightDoubleExp);
	} else if (k == mizSyNumeral) {
		mizSubProcessNumeralTerm(p);
		mizReadToken(p);
	} else if (k == mizSyLeftCircumfixSymbol || k == mizSyLeftSquareBracket) {
		mizBracketedTerm(p);
		kk = p.curWord.kind;
		if (kk == mizSyRightSquareBracket || kk == mizSyRightCurlyBracket
			|| kk == mizSyRightParanthesis) mizReadToken(p)
		else mizAccept(p, mizSyRightCircumfixSymbol, paRightBraExp);
	} else if (k == mizSyIt) {
		mizSubProcessItTerm(p);
		mizReadToken(p);
	} else if (k == mizSyDolar) {
		mizSubProcessLocusTerm(p);
		mizReadToken(p);
	} else if (k == mizSyLeftCurlyBracket) {
		mizSubStartBracketedTerm(p);
		mizReadToken(p);
		mizTermSubexpression(p);
		if (p.curWord.kind == mizSyColon || p.curWord.kind == mizSyWhere) {
			mizSubStartFraenkelTerm(p);
			mizProcessPostqualification(p);
			mizAccept(p, mizSyColon, paColonExp);
			mizFormulaSubexpression(p);
			mizSubFinishFraenkelTerm(p);
			mizAccept(p, mizSyRightCurlyBracket, paRightCurledExp);
		} else {
			mizSubFinishArgument(p);
			mizArgumentsTail(p, mizMaxVisArgNbr - 1);
			mizSubFinishBracketedTerm(p);
			kk = p.curWord.kind;
			if (kk == mizSyRightSquareBracket || kk == mizSyRightCurlyBracket
				|| kk == mizSyRightParanthesis) mizReadToken(p)
			else mizAccept(p, mizSyRightCircumfixSymbol, paRightBraExp);
		}
	} else if (k == mizSyThe) {
		mizReadToken(p);
		kk = p.curWord.kind;
		if (kk == mizSySelectorSymbol) {
			mizSubStartSelectorTerm(p);
			mizReadToken(p);
			if (mizOccurs(p, mizSyOf)) mizTermSubexpression(p);
			mizSubFinishSelectorTerm(p);
		} else if (kk == mizSyStructureSymbol) {
			if (p.aheadWord.kind == mizSyOf) {
				mizSubStartForgetfulTerm(p);
				mizReadToken(p);
				mizAccept(p, mizSyOf, paOfExp);
				mizTermSubexpression(p);
				mizSubFinishForgetfulTerm(p);
			} else {
				mizSubStartChoiceTerm(p);
				mizTypeSubexpression(p);
				mizSubFinishChoiceTerm(p);
			}
		} else if (kk == mizSySet) {
			if (p.aheadWord.kind == mizSyOf) {
				mizReadToken(p);
				mizReadToken(p);
				mizSubStartSimpleFraenkelTerm(p);
				mizAccept(p, mizSyAll, paAllExp);
				mizTermSubexpression(p);
				mizSubStartFraenkelTerm(p);
				mizProcessPostqualification(p);
				mizSubFinishSimpleFraenkelTerm(p);
			} else {
				mizSubStartChoiceTerm(p);
				mizTypeSubexpression(p);
				mizSubFinishChoiceTerm(p);
			}
		} else if (kk == mizSyModeSymbol || kk == mizSyAttributeSymbol || kk == mizSyNon
			|| kk == mizSyLeftParanthesis || kk == mizSyIdentifier
			|| kk == mizSyInfixOperatorSymbol || kk == mizSyNumeral
			|| kk == mizSyLeftCircumfixSymbol || kk == mizSyIt
			|| kk == mizSyLeftCurlyBracket || kk == mizSyLeftSquareBracket
			|| kk == mizSyThe || kk == mizSyDolar) {
			mizSubStartChoiceTerm(p);
			mizTypeSubexpression(p);
			mizSubFinishChoiceTerm(p);
		} else {
			mizSubInsertIncorrTerm(p);
			mizWrongWord(p, paWrongAfterThe);
		}
	} else mizRunTimeError(2133);
}

mizCompleteArgument(p : MizParser, cnt : ref int) -> void {
	mizSubFinishArgument(p);
	mizRepeat(\ -> {
		mizAppendQua(p);
		mizCloseParenth(p, cnt);
		p.curWord.kind == mizSyQua;
	});
}

mizAppendFunc(p : MizParser, cnt : ref int) -> void {
	while(\ -> p.curWord.kind == mizSyInfixOperatorSymbol, \ -> {
		mizSubStartLongTerm(p);
		mizRepeat(\ -> {
			mizSubProcessFunctorSymbol(p);
			mizReadToken(p);
			k = p.curWord.kind;
			if (k == mizSyLeftParanthesis) {
				mizReadToken(p);
				mizGetArguments(p, mizMaxVisArgNbr);
				mizAccept(p, mizSyRightParanthesis, paRightParenthExp);
			} else if (k == mizSyIdentifier || k == mizSyNumeral
				|| k == mizSyLeftCircumfixSymbol || k == mizSyIt
				|| k == mizSyLeftCurlyBracket || k == mizSyLeftSquareBracket
				|| k == mizSyThe || k == mizSyDolar || k == mizSyStructureSymbol) {
				mizCreateSubexpression(p);
				mizGetClosedSubterm(p);
				mizSubFinishArgument(p);
				mizKillSubexpression(p);
			}
			mizSubFinishArgList(p);
			p.curWord.kind == mizSyInfixOperatorSymbol;
		});
		mizSubFinishLongTerm(p);
		mizCompleteArgument(p, cnt);
	});
}

mizProcessArguments(p : MizParser) -> void {
	cnt = ref 0;
	mizOpenParenth(p, cnt);
	k = p.curWord.kind;
	if (k == mizSyIdentifier || k == mizSyNumeral || k == mizSyLeftCircumfixSymbol
		|| k == mizSyIt || k == mizSyLeftCurlyBracket || k == mizSyLeftSquareBracket
		|| k == mizSyThe || k == mizSyDolar || k == mizSyStructureSymbol) {
		mizGetClosedSubterm(p);
		mizCompleteArgument(p, cnt);
	} else if (k == mizSyInfixOperatorSymbol) {}
	else {
		mizSubInsertIncorrTerm(p);
		mizSubFinishArgument(p);
		mizWrongWord(p, paWrongTermBeg);
	}
	mizRepeat(\ -> {
		mizAppendFunc(p, cnt);
		if (p.curWord.kind == mizSyComma) {
			mizArgumentsTail(p, mizMaxVisArgNbr - 1);
			if (^cnt > 0 && p.curWord.kind == mizSyRightParanthesis) {
				cnt := ^cnt - 1;
				mizReadToken(p);
			}
		}
		p.curWord.kind == mizSyInfixOperatorSymbol;
	});
	while(\ -> ^cnt > 0, \ -> {
		mizAccept(p, mizSyRightParanthesis, paRightParenthExp);
		cnt := ^cnt - 1;
	});
}

// ProcessAttributes' loop guard (parser.pas 546)
mizAttrLoopGuard(p : MizParser) -> bool {
	k = p.curWord.kind;
	k == mizSyAttributeSymbol || k == mizSyNon
	|| mizInTermBegSysNoParStruct(k)
	|| (k == mizSyLeftParanthesis && !(p.aheadWord.kind == mizSySet
		|| p.aheadWord.kind == mizSyModeSymbol || p.aheadWord.kind == mizSyStructureSymbol))
	|| (k == mizSyStructureSymbol && p.aheadWord.kind == mizSyStructLeftBracket);
}

mizAttrArgGuard(p : MizParser) -> bool {
	k = p.curWord.kind;
	mizInTermBegSysNoParStruct(k)
	|| (k == mizSyLeftParanthesis && !(p.aheadWord.kind == mizSySet
		|| p.aheadWord.kind == mizSyModeSymbol || p.aheadWord.kind == mizSyStructureSymbol))
	|| (k == mizSyStructureSymbol && p.aheadWord.kind == mizSyStructLeftBracket);
}

mizProcessAttributes(p : MizParser) -> void {
	while(\ -> mizAttrLoopGuard(p), \ -> {
		mizSubProcessNon(p);
		if (p.curWord.kind == mizSyNon) mizReadToken(p);
		if (mizAttrArgGuard(p)) {
			mizSubStartAttributeArguments(p);
			mizProcessArguments(p);
			mizSubCompleteAttributeArguments(p);
		}
		if (p.curWord.kind == mizSyAttributeSymbol) {
			mizSubProcessAttribute(p);
			mizReadToken(p);
		} else mizSynErr(p, p.curPos, paAttrExp);
	});
}

mizGetAdjectiveCluster(p : MizParser) -> void { mizProcessAttributes(p); }

mizRadixTypeSubexpression(p : MizParser) -> void {
	cnt = ref 0;
	if (p.curWord.kind == mizSyLeftParanthesis) {
		mizReadToken(p);
		cnt := 1;
	}
	mizSubProcessModeSymbol(p);
	k = p.curWord.kind;
	if (k == mizSySet) mizReadToken(p)
	else if (k == mizSyModeSymbol) {
		sym = p.curWord.nr;
		mizReadToken(p);
		if (p.curWord.kind == mizSyOf) {
			mx = mizMaxArgsAt(p.modeMaxArgs, sym);
			if (mx == 0) mizWrongWord(p, paUnexpOf)
			else { mizReadToken(p); mizGetArguments(p, mx); }
		}
	} else if (k == mizSyStructureSymbol) {
		sym = p.curWord.nr;
		mizReadToken(p);
		if (p.curWord.kind == mizSyOver) {
			mx = mizMaxArgsAt(p.structModeMaxArgs, sym);
			if (mx == 0) mizWrongWord(p, paUnexpOver)
			else { mizReadToken(p); mizGetArguments(p, mx); }
		}
	} else {
		mizMissingWord(p, paWrongRadTypeBeg);
		mizSubInsertIncorrType(p);
	}
	if (^cnt > 0) mizAccept(p, mizSyRightParanthesis, paRightParenthExp);
	mizSubFinishType(p);
}

mizTypeSubexpression(p : MizParser) -> void {
	mizCreateSubexpression(p);
	mizSubStartType(p);
	mizSubStartAttributes(p);
	mizGetAdjectiveCluster(p);
	mizRadixTypeSubexpression(p);
	mizSubCompleteType(p);
	mizKillSubexpression(p);
}

mizTermSubexpression(p : MizParser) -> void {
	mizCreateSubexpression(p);
	cnt = ref 0;
	mizOpenParenth(p, cnt);
	k = p.curWord.kind;
	if (k == mizSyIdentifier || k == mizSyNumeral || k == mizSyLeftCircumfixSymbol
		|| k == mizSyIt || k == mizSyLeftCurlyBracket || k == mizSyLeftSquareBracket
		|| k == mizSyThe || k == mizSyDolar || k == mizSyStructureSymbol) {
		mizGetClosedSubterm(p);
		mizCompleteArgument(p, cnt);
	} else if (k == mizSyInfixOperatorSymbol) {}
	else {
		mizSubInsertIncorrTerm(p);
		mizSubFinishArgument(p);
		mizWrongWord(p, paWrongTermBeg);
	}
	mizAppendFunc(p, cnt);
	while(\ -> ^cnt > 0, \ -> {
		mizArgumentsTail(p, mizMaxVisArgNbr - 1);
		cnt := ^cnt - 1;
		mizAccept(p, mizSyRightParanthesis, paRightParenthExp);
		if (p.curWord.kind != mizSyInfixOperatorSymbol) mizMissingWord(p, paFunctExp);
		mizAppendFunc(p, cnt);
	});
	mizSubFinishTerm(p);
	mizKillSubexpression(p);
}

mizArgumentsTail(p : MizParser, argsNbr : int) -> void {
	n = ref argsNbr;
	while(\ -> ^n > 0 && mizOccurs(p, mizSyComma), \ -> {
		mizTermSubexpression(p);
		mizSubFinishArgument(p);
		n := ^n - 1;
	});
}

mizGetArguments(p : MizParser, argsNbr : int) -> void {
	if (argsNbr > 0) {
		mizTermSubexpression(p);
		mizSubFinishArgument(p);
		mizArgumentsTail(p, argsNbr - 1);
	}
}

mizQuantifiedVariables(p : MizParser) -> void {
	mizRepeat(\ -> {
		mizSubStartQualifiedSegment(p);
		mizReadToken(p);
		mizRepeat(\ -> {
			mizSubProcessVariable(p);
			mizAccept(p, mizSyIdentifier, paIdentExp);
			mizOccurs(p, mizSyComma);
		});
		mizSubStartQualifyingType(p);
		if (mizOccurs(p, mizSyBe) || mizOccurs(p, mizSyBeing)) mizTypeSubexpression(p);
		mizSubFinishQualifiedSegment(p);
		p.curWord.kind == mizSyComma;
	});
}

mizExistentialFormula(p : MizParser) -> void {
	mizSubStartExistential(p);
	mizQuantifiedVariables(p);
	mizAccept(p, mizSySt, paStExp);
	mizFormulaSubexpression(p);
	mizSubFinishExistential(p);
}

mizUniversalFormula(p : MizParser) -> void {
	mizSubStartUniversal(p);
	mizQuantifiedVariables(p);
	if (p.curWord.kind == mizSySt) {
		mizSubStartRestriction(p);
		mizReadToken(p);
		mizFormulaSubexpression(p);
		mizSubFinishRestriction(p);
	}
	k = p.curWord.kind;
	if (k == mizSyHolds) mizReadToken(p)
	else if (k == mizSyFor || k == mizSyEx) {}
	else {
		mizSubInsertIncorrFormula(p);
		mizMissingWord(p, paWrongScopeBeg);
	}
	mizFormulaSubexpression(p);
	mizSubFinishUniversal(p);
}

mizCompleteRightSideOfThePredicativeFormula(p : MizParser, predSymbol : int) -> void {
	mizSubProcessRightSideOfPredicateSymbol(p);
	mizReadToken(p);
	if (mizInTermBegSys(p.curWord.kind))
		mizGetArguments(p, mizMaxArgsAt(p.predMaxArgs, predSymbol));
	mizSubFinishRightSideOfPredicativeFormula(p);
}

mizCompleteMultiPredicativeFormula(p : MizParser) -> void {
	mizSubStartMultiPredicativeFormula(p);
	mizRepeat(\ -> {
		k = p.curWord.kind;
		if (k == mizSyEqual || k == mizSyPredicateSymbol) {
			mizCompleteRightSideOfThePredicativeFormula(p, p.curWord.nr);
		} else if (k == mizSyDoes || k == mizSyDo) {
			mizReadToken(p);
			mizAccept(p, mizSyNot, paNotExpected);
			if (p.curWord.kind == mizSyPredicateSymbol || p.curWord.kind == mizSyEqual) {
				mizCompleteRightSideOfThePredicativeFormula(p, p.curWord.nr);
				mizSubProcessNegative(p);
			} else {
				mizSubInsertIncorrFormula(p);
				mizSynErr(p, p.curPos, paInfinitiveExp);
			}
		}
		kk = p.curWord.kind;
		kk == mizSyEqual || kk == mizSyPredicateSymbol || kk == mizSyDoes || kk == mizSyDo;
	});
	mizSubFinishMultiPredicativeFormula(p);
}

mizCompletePredicativeFormula(p : MizParser, predSymbol : int) -> void {
	mizSubProcessPredicateSymbol(p);
	mizReadToken(p);
	if (mizInTermBegSys(p.curWord.kind))
		mizGetArguments(p, mizMaxArgsAt(p.predMaxArgs, predSymbol));
	mizSubFinishPredicativeFormula(p);
}

// the `is` branch's second guard: TermBegSys + mode/struct/set/attr/non
mizIsTypeStart(k : int) -> bool {
	mizInTermBegSys(k) || k == mizSyModeSymbol || k == mizSyStructureSymbol
	|| k == mizSySet || k == mizSyAttributeSymbol || k == mizSyNon;
}

mizCompleteAtomicFormula(p : MizParser, cnt : ref int) -> void {
	mizRepeat(\ -> {
		mizAppendFunc(p, cnt);
		if (p.curWord.kind == mizSyComma) {
			mizArgumentsTail(p, mizMaxVisArgNbr - 1);
			if (^cnt > 0 && p.curWord.kind == mizSyRightParanthesis) {
				cnt := ^cnt - 1;
				mizReadToken(p);
				if (p.curWord.kind != mizSyInfixOperatorSymbol) mizMissingWord(p, paFunctExp);
			}
		}
		p.curWord.kind == mizSyInfixOperatorSymbol;
	});
	k = p.curWord.kind;
	if (k == mizSyEqual || k == mizSyPredicateSymbol) {
		mizCompletePredicativeFormula(p, p.curWord.nr);
		kk = p.curWord.kind;
		if (kk == mizSyEqual || kk == mizSyPredicateSymbol || kk == mizSyDoes || kk == mizSyDo)
			mizCompleteMultiPredicativeFormula(p);
	} else if (k == mizSyDoes || k == mizSyDo) {
		mizReadToken(p);
		mizAccept(p, mizSyNot, paNotExpected);
		if (p.curWord.kind == mizSyPredicateSymbol || p.curWord.kind == mizSyEqual) {
			mizCompletePredicativeFormula(p, p.curWord.nr);
			mizSubProcessNegative(p);
			kk = p.curWord.kind;
			if (kk == mizSyEqual || kk == mizSyPredicateSymbol || kk == mizSyDoes || kk == mizSyDo)
				mizCompleteMultiPredicativeFormula(p);
		} else {
			mizSubInsertIncorrFormula(p);
			mizSynErr(p, p.curPos, paInfinitiveExp);
		}
	} else if (k == mizSyIs) {
		mizSubProcessAtomicFormula(p);
		mizReadToken(p);
		if ((p.curWord.kind == mizSyNot && mizIsTypeStart(p.aheadWord.kind))
			|| mizIsTypeStart(p.curWord.kind)) {
			mizSubStartType(p);
			mizSubStartAttributes(p);
			if (p.curWord.kind == mizSyNot) {
				mizSubProcessNegation(p);
				mizReadToken(p);
			}
			mizGetAdjectiveCluster(p);
			kk = p.curWord.kind;
			if (kk == mizSyLeftParanthesis || kk == mizSyModeSymbol
				|| kk == mizSyStructureSymbol || kk == mizSySet) {
				mizRadixTypeSubexpression(p);
				mizSubCompleteType(p);
				mizSubFinishQualifyingFormula(p);
			} else {
				mizSubFinishAttributiveFormula(p);
			}
		} else {
			mizSubInsertIncorrFormula(p);
			mizWrongWord(p, paTypeOrAttrExp);
		}
	} else {
		mizSubProcessAtomicFormula(p);
		mizMissingWord(p, paWrongPredSymbol);
		mizSubInsertIncorrBasic(p);
	}
}

mizViableFormula(p : MizParser) -> void {
	mizCreateSubexpression(p);
	cnt = ref 0;
	mizOpenParenth(p, cnt);
	k = p.curWord.kind;
	// StartAtomicFormula is a no-op in extSubexpObj — the base method stands.
	notPrivate = \ -> {
		mizGetClosedSubterm(p);
		mizCompleteArgument(p, cnt);
		mizCompleteAtomicFormula(p, cnt);
	};
	if (k == mizSyFor) mizUniversalFormula(p)
	else if (k == mizSyEx) mizExistentialFormula(p)
	else if (k == mizSyContradiction) { mizSubProcessContradiction(p); mizReadToken(p); }
	else if (k == mizSyThesis) { mizSubProcessThesis(p); mizReadToken(p); }
	else if (k == mizSyNot) {
		mizReadToken(p);
		mizViableFormula(p);
		mizKillSubexpression(p);
		mizSubProcessNegative(p);
	}
	else if (k == mizSyIdentifier) {
		if (p.aheadWord.kind == mizSyLeftSquareBracket) {
			mizSubStartPrivateFormula(p);
			mizReadToken(p);
			mizReadToken(p);
			if (p.curWord.kind != mizSyRightSquareBracket) mizGetArguments(p, mizMaxVisArgNbr);
			mizAccept(p, mizSyRightSquareBracket, paRightSquareExp);
			mizSubFinishPrivateFormula(p);
		} else notPrivate();   // goto: NotPrivate
	}
	else if (k == mizSyNumeral || k == mizSyLeftCircumfixSymbol || k == mizSyIt
		|| k == mizSyLeftCurlyBracket || k == mizSyLeftSquareBracket
		|| k == mizSyThe || k == mizSyDolar || k == mizSyStructureSymbol) notPrivate()
	else if (k == mizSyInfixOperatorSymbol || k == mizSyPredicateSymbol
		|| k == mizSyDoes || k == mizSyDo || k == mizSyEqual) {
		mizCompleteAtomicFormula(p, cnt);
	}
	else {
		mizSubInsertIncorrFormula(p);
		mizWrongWord(p, paWrongFormulaBeg);
	}
	while(\ -> ^cnt > 0, \ -> {
		mizConditionalTail(p);
		mizAccept(p, mizSyRightParanthesis, paRightParenthExp);
		cnt := ^cnt - 1;
		mizCloseParenth(p, cnt);
	});
}

mizConjunctiveTail(p : MizParser) -> void {
	while(\ -> p.curWord.kind == mizSyAmpersand && p.aheadWord.kind != mizSyEllipsis, \ -> {
		mizSubProcessBinaryConnective(p);
		mizReadToken(p);
		mizViableFormula(p);
		mizKillSubexpression(p);
		mizSubFinishBinaryFormula(p);
	});
}

mizFlexConjunctiveTail(p : MizParser) -> void {
	mizConjunctiveTail(p);
	if (p.curWord.kind == mizSyAmpersand) {
		mizReadToken(p); mizReadToken(p);
		mizAccept(p, mizSyAmpersand, 402);
		mizSubProcessFlexConjunction(p);
		mizViableFormula(p);
		mizConjunctiveTail(p);
		mizKillSubexpression(p);
		mizSubFinishFlexConjunction(p);
	}
}

mizDisjunctiveTail(p : MizParser) -> void {
	mizFlexConjunctiveTail(p);
	while(\ -> p.curWord.kind == mizSyOr && p.aheadWord.kind != mizSyEllipsis, \ -> {
		mizSubProcessBinaryConnective(p);
		mizReadToken(p);
		mizViableFormula(p);
		mizFlexConjunctiveTail(p);
		mizKillSubexpression(p);
		mizSubFinishBinaryFormula(p);
	});
}

mizFlexDisjunctiveTail(p : MizParser) -> void {
	mizDisjunctiveTail(p);
	if (p.curWord.kind == mizSyOr) {
		mizReadToken(p); mizReadToken(p);
		mizAccept(p, mizSyOr, 401);
		mizSubProcessFlexDisjunction(p);
		mizViableFormula(p);
		mizDisjunctiveTail(p);
		mizKillSubexpression(p);
		mizSubFinishFlexDisjunction(p);
	}
}

mizConditionalTail(p : MizParser) -> void {
	mizFlexDisjunctiveTail(p);
	k = p.curWord.kind;
	if (k == mizSyImplies || k == mizSyIff) {
		mizSubProcessBinaryConnective(p);
		mizReadToken(p);
		mizViableFormula(p);
		mizFlexDisjunctiveTail(p);
		mizKillSubexpression(p);
		mizSubFinishBinaryFormula(p);
		kk = p.curWord.kind;
		if (kk == mizSyImplies || kk == mizSyIff) mizWrongWord(p, 336);
	}
}

mizFormulaSubexpression(p : MizParser) -> void {
	mizViableFormula(p);
	mizConditionalTail(p);
	mizKillSubexpression(p);
}

// ---------------------------- C o m m u n i c a t i o n   w i t h   I t e m s

mizTermExpression(p : MizParser) -> void {
	mizCreateExpression(p, mizExTerm);
	mizTermSubexpression(p);
	mizKillExpression(p);
}

mizTypeExpression(p : MizParser) -> void {
	mizCreateExpression(p, mizExType);
	mizTypeSubexpression(p);
	mizKillExpression(p);
}

mizFormulaExpression(p : MizParser) -> void {
	mizCreateExpression(p, mizExFormula);
	mizFormulaSubexpression(p);
	mizKillExpression(p);
}

// ------------------------------------------------- M i s c e l l a n e o u s

mizProcessLab(p : MizParser) -> void {
	mizItmProcessLabel(p);
	if (p.curWord.kind == mizSyIdentifier && p.aheadWord.kind == mizSyColon) {
		mizReadToken(p);
		mizReadToken(p);
	}
}

mizProcessSentence(p : MizParser) -> void {
	mizItmStartSentence(p);
	mizFormulaExpression(p);
}

mizInCorrSentence(p : MizParser) -> void {
	mizItmStartSentence(p);
	mizCreateExpression(p, mizExFormula);
	mizCreateSubexpression(p);
	mizSubInsertIncorrFormula(p);
	mizKillSubexpression(p);
	mizKillExpression(p);
}

mizInCorrStatement(p : MizParser) -> void {
	mizItmProcessLabel(p);
	mizItmStartRegularStatement(p);
	mizInCorrSentence(p);
}

mizProcessHypotheses(p : MizParser) -> void {
	mizRepeat(\ -> {
		mizProcessLab(p);
		mizProcessSentence(p);
		mizItmFinishHypothesis(p);
		mizOccurs(p, mizSyAnd);
	});
}

mizAssumption(p : MizParser) -> void {
	if (p.curWord.kind == mizSyThat) {
		mizItmStartCollectiveAssumption(p);
		mizReadToken(p);
		mizProcessHypotheses(p);
	} else {
		mizProcessLab(p);
		mizProcessSentence(p);
		mizItmFinishHypothesis(p);
	}
	mizItmFinishAssumption(p);
}

mizFixedVariables(p : MizParser) -> void {
	mizItmStartFixedVariables(p);
	mizRepeat(\ -> {
		mizItmStartFixedSegment(p);
		mizRepeat(\ -> {
			mizItmProcessFixedVariable(p);
			mizAccept(p, mizSyIdentifier, paIdentExp);
			mizOccurs(p, mizSyComma);
		});
		mizItmProcessBeing(p);
		if (mizOccurs(p, mizSyBe) || mizOccurs(p, mizSyBeing)) mizTypeExpression(p);
		mizItmFinishFixedSegment(p);
		mizOccurs(p, mizSyComma);
	});
	mizItmFinishFixedVariables(p);
}

mizProcessChoice(p : MizParser) -> void {
	mizFixedVariables(p);
	mizAccept(p, mizSySuch, paSuchExp);
	mizAccept(p, mizSyThat, paThatExp);
	mizRepeat(\ -> {
		mizProcessLab(p);
		mizProcessSentence(p);
		mizItmFinishCondition(p);
		mizOccurs(p, mizSyAnd);
	});
}

mizGeneralization(p : MizParser) -> void {
	mizReadToken(p);
	mizFixedVariables(p);
	if (mizOccurs(p, mizSySuch)) {
		mizItmStartAssumption(p);
		mizAccept(p, mizSyThat, paThatExp);
		mizProcessHypotheses(p);
		mizItmFinishAssumption(p);
	}
}

mizExistentialAssumption(p : MizParser) -> void {
	mizCreateItem(p, mizItExistentialAssumption);
	mizReadToken(p);
	mizProcessChoice(p);
}

mizCanceled(p : MizParser) -> void {
	mizCreateItem(p, mizItCanceled);
	mizReadToken(p);
	if (p.curWord.kind == mizSyNumeral) mizReadToken(p);
}

// ------------------------------ S i m p l e   J u s t i f i c a t i o n s ---

mizGetReferences(p : MizParser) -> void {
	mizRepeat(\ -> {
		mizReadToken(p);
		k = p.curWord.kind;
		if (k == mizSyMMLIdentifier) {
			mizItmStartLibraryReferences(p);
			mizReadToken(p);
			if (p.curWord.kind == mizSyColon) {
				mizRepeat(\ -> {
					mizReadToken(p);
					mizItmProcessDef(p);
					if (p.curWord.kind == mizSyReferenceSort) {
						if (p.curWord.nr != 1) mizErrImmP(p, paDefExp);
						mizReadToken(p);
					}
					mizItmProcessTheoremNumber(p);
					mizAccept(p, mizSyNumeral, paNumExp);
					p.curWord.kind == mizSyComma
						&& p.aheadWord.kind != mizSyIdentifier
						&& p.aheadWord.kind != mizSyMMLIdentifier;
				});
			} else mizMissingWord(p, paColonExp);
		} else if (k == mizSyIdentifier) {
			mizItmProcessPrivateReference(p);
			mizReadToken(p);
		} else mizWrongWord(p, paWrongReferenceBeg);
		p.curWord.kind == mizSyComma;
	});
}

mizGetSchemeReference(p : MizParser) -> void {
	mizReadToken(p);
	k = p.curWord.kind;
	if (k == mizSyMMLIdentifier) {
		mizItmStartSchemeLibraryReference(p);
		mizReadToken(p);
		if (p.curWord.kind == mizSyColon) {
			mizReadToken(p);
			if (p.curWord.kind == mizSyReferenceSort) {
				if (p.curWord.nr != 2) mizErrImmP(p, paSchExp);
				mizReadToken(p);
			} else mizErrImmP(p, paSchExp);
			mizItmProcessSchemeNumber(p);
			mizAccept(p, mizSyNumeral, paNumExp);
		} else mizMissingWord(p, paColonExp);
	} else if (k == mizSyIdentifier) {
		mizItmProcessSchemeReference(p);
		mizReadToken(p);
	} else mizWrongWord(p, paWrongReferenceBeg);
	if (p.curWord.kind == mizSyLeftParanthesis) {
		mizGetReferences(p);
		mizAccept(p, mizSyRightParanthesis, paRightParenthExp);
	}
}

mizSimpleJustification(p : MizParser) -> void {
	mizItmStartSimpleJustification(p);
	k = p.curWord.kind;
	if (k == mizSyBy) mizGetReferences(p)
	else if (k == mizSySemicolon || k == mizSyDotEquals) {}
	else if (k == mizSyFrom) mizGetSchemeReference(p)
	else mizWrongWord(p, paWrongJustificationBeg);
	mizItmFinishSimpleJustification(p);
}

// -------------------- S t a t e m e n t s   &   R e a s o n i n g s ---------

mizIgnoreProof(p : MizParser) -> void {
	reasPos = p.curPos;
	mizReadToken(p);
	counter = ref 1;
	stop = ref false;
	mizRepeat(\ -> {
		k = p.curWord.kind;
		if (k == mizSyProof || k == mizSyNow || k == mizSyHereby
			|| k == mizSyCase || k == mizSySuppose) counter := ^counter + 1
		else if (k == mizSyEnd) counter := ^counter - 1
		else if (k == mizSyReserve || k == mizSyScheme || k == mizSyTheorem
			|| k == mizSyDefinition || k == mizSyBegin || k == mizSyNotation
			|| k == mizSyRegistration || k == mizSyEOT) {
			mizAcceptEnd(p, reasPos);
			stop := true;   // goto: exit
		};
		if (^stop) false
		else { mizReadToken(p); ^counter != 0 }
	});
}

mizJustification(p : MizParser) -> void {
	mizItmStartJustification(p);
	if (p.curWord.kind == mizSyProof) {
		if (p.proofPragma) mizReasoning(p) else mizIgnoreProof(p);
	} else mizSimpleJustification(p);
}

mizReadTypeList(p : MizParser) -> void {
	k = p.curWord.kind;
	if (k == mizSyRightSquareBracket || k == mizSyRightParanthesis) {}
	else mizRepeat(\ -> {
		mizTypeExpression(p);
		mizItmFinishLocusType(p);
		mizOccurs(p, mizSyComma);
	});
}

mizPrivateItem(p : MizParser) -> void {
	mizBlkProcessLink(p);
	if (p.curWord.kind == mizSyThen) mizReadToken(p);
	k = p.curWord.kind;
	if (k == mizSyDeffunc) {
		mizCreateItem(p, mizItPrivFuncDefinition);
		mizReadToken(p);
		mizItmStartPrivateDefiniendum(p);
		mizAccept(p, mizSyIdentifier, paIdentExp);
		mizAccept(p, mizSyLeftParanthesis, paLeftParenthExp);
		mizReadTypeList(p);
		mizAccept(p, mizSyRightParanthesis, paRightParenthExp);
		mizItmStartPrivateDefiniens(p);
		mizAccept(p, mizSyEqual, paEqualityExp);
		mizTermExpression(p);
		mizItmFinishPrivateFuncDefinienition(p);
	} else if (k == mizSyDefpred) {
		mizCreateItem(p, mizItPrivPredDefinition);
		mizReadToken(p);
		mizItmStartPrivateDefiniendum(p);
		mizAccept(p, mizSyIdentifier, paIdentExp);
		mizAccept(p, mizSyLeftSquareBracket, paLeftSquareExp);
		mizReadTypeList(p);
		mizAccept(p, mizSyRightSquareBracket, paRightSquareExp);
		mizItmStartPrivateDefiniens(p);
		mizAccept(p, mizSyMeans, paMeansExp);
		mizFormulaExpression(p);
		mizItmFinishPrivatePredDefinienition(p);
	} else if (k == mizSySet) {
		mizCreateItem(p, mizItConstantDefinition);
		mizReadToken(p);
		mizRepeat(\ -> {
			mizItmStartPrivateConstant(p);
			mizAccept(p, mizSyIdentifier, paIdentExp);
			mizAccept(p, mizSyEqual, paEqualityExp);
			mizTermExpression(p);
			mizItmFinishPrivateConstant(p);
			mizOccurs(p, mizSyComma);
		});
	} else if (k == mizSyReconsider) {
		mizCreateItem(p, mizItReconsider);
		mizReadToken(p);
		mizRepeat(\ -> {
			mizItmProcessReconsideredVariable(p);
			mizAccept(p, mizSyIdentifier, paIdentExp);
			if (p.curWord.kind == mizSyEqual) {
				mizReadToken(p);
				mizTermExpression(p);
				mizItmFinishReconsideredTerm(p);
			} else mizItmFinishDefaultTerm(p);
			mizOccurs(p, mizSyComma);
		});
		mizAccept(p, mizSyAs, paAsExp);
		mizTypeExpression(p);
		mizSimpleJustification(p);
	} else if (k == mizSyConsider) {
		mizCreateItem(p, mizItChoice);
		mizReadToken(p);
		mizProcessChoice(p);
		mizSimpleJustification(p);
	} else if (k == mizSyIdentifier || k == mizSyNow || k == mizSyFor || k == mizSyEx
		|| k == mizSyNot || k == mizSyThesis || k == mizSyLeftSquareBracket
		|| k == mizSyContradiction || k == mizSyPredicateSymbol || k == mizSyDoes
		|| k == mizSyDo || k == mizSyEqual || k == mizSyInfixOperatorSymbol
		|| k == mizSyNumeral || k == mizSyLeftCircumfixSymbol
		|| k == mizSyLeftParanthesis || k == mizSyIt || k == mizSyDolar
		|| k == mizSyStructureSymbol || k == mizSyThe || k == mizSyLeftCurlyBracket
		|| k == mizSyProof) {
		mizCreateItem(p, mizItRegularStatement);
		mizRegularStatement(p);
	} else {
		mizCreateItem(p, mizItIncorrItem);
		mizWrongWord(p, paWrongItemBeg);
	}
}

mizSetParserPragma(p : MizParser, prg : string) -> void {
	if (strLeft(prg, 3) == "$P+") p.proofPragma ::= true;
	if (strLeft(prg, 3) == "$P-") p.proofPragma ::= false;
}

mizProcessPragmas(p : MizParser) -> void {
	while(\ -> p.curWord.kind == mizSyPragma, \ -> {
		mizSetParserPragma(p, p.curWord.spelling);
		mizBlkProcessPragma(p);
		mizReadToken(p);
	});
}

mizLinearReasoning(p : MizParser) -> void {
	stop = ref false;
	while(\ -> !^stop && p.curWord.kind != mizSyEnd, \ -> {
		p.stillCorrect ::= true;
		mizProcessPragmas(p);
		k = p.curWord.kind;
		if (k == mizSyLet) {
			mizCreateItem(p, mizItGeneralization);
			mizGeneralization(p);
		} else if (k == mizSyGiven) mizExistentialAssumption(p)
		else if (k == mizSyAssume) {
			mizCreateItem(p, mizItAssumption);
			mizReadToken(p);
			mizAssumption(p);
		} else if (k == mizSyTake) {
			mizCreateItem(p, mizItExemplification);
			mizReadToken(p);
			mizRepeat(\ -> {
				if (p.curWord.kind == mizSyIdentifier && p.aheadWord.kind == mizSyEqual) {
					mizItmProcessExemplifyingVariable(p);
					mizReadToken(p);
					mizReadToken(p);
					mizTermExpression(p);
					mizItmFinishExemplifyingVariable(p);
				} else {
					mizItmStartExemplifyingTerm(p);
					mizTermExpression(p);
					mizItmFinishExemplifyingTerm(p);
				}
				mizOccurs(p, mizSyComma);
			});
		} else if (k == mizSyHereby) {
			mizCreateItem(p, mizItConclusion);
			mizReasoning(p);
		} else if (k == mizSyHence) {
			mizBlkProcessLink(p);
			mizReadToken(p);
			mizCreateItem(p, mizItConclusion);
			mizRegularStatement(p);
		} else if (k == mizSyThus) {
			mizReadToken(p);
			mizBlkProcessLink(p);
			if (p.curWord.kind == mizSyThen) mizReadToken(p);
			mizCreateItem(p, mizItConclusion);
			mizRegularStatement(p);
		} else if (k == mizSyPer || k == mizSyCase || k == mizSySuppose
			|| k == mizSyReserve || k == mizSyScheme || k == mizSyTheorem
			|| k == mizSyDefinition || k == mizSyBegin || k == mizSyNotation
			|| k == mizSyRegistration || k == mizSyEOT) stop := true
		else if (k == mizSyThen) {
			if (p.aheadWord.kind == mizSyPer) {
				mizBlkProcessLink(p);
				mizReadToken(p);
				stop := true;
			} else mizPrivateItem(p);
		} else mizPrivateItem(p);
		if (!^stop) mizSemicolon(p);
	});
}

mizNonBlockReasoning(p : MizParser) -> void {
	k0 = p.curWord.kind;
	if (k0 == mizSyPer || k0 == mizSyCase || k0 == mizSySuppose) {
		mizCreateItem(p, mizItPerCases);
		mizAccept(p, mizSyPer, paPerExp);
		mizAccept(p, mizSyCases, paCasesExp);
		mizSimpleJustification(p);
		mizSemicolon(p);
		caseKind = ref p.curWord.kind;
		processCase = \casePos -> {
			mizAssumption(p);
			mizSemicolon(p);
			mizLinearReasoning(p);
			if (p.curWord.kind == mizSyPer) mizNonBlockReasoning(p);
			mizKillBlock(p);
			mizAcceptEnd(p, casePos);
			mizSemicolon(p);
		};
		if (p.curWord.kind != mizSyCase && p.curWord.kind != mizSySuppose) {
			mizMissingWord(p, paSupposeOrCaseExp);
			caseKind := mizSySuppose;
			mizCreateItem(p, mizItCaseBlock);
			mizCreateBlock(p, mizBlSuppose);
			mizCreateItem(p, mizItSupposeHead);
			p.stillCorrect ::= true;
			processCase(p.curPos);
		}
		stop = ref false;
		mizRepeat(\ -> {
			while(\ -> p.curWord.kind == mizSyCase || p.curWord.kind == mizSySuppose, \ -> {
				mizCreateItem(p, mizItCaseBlock);
				if (^caseKind == mizSyCase) mizCreateBlock(p, mizBlCase)
				else mizCreateBlock(p, mizBlSuppose);
				casePos = p.curPos;
				p.stillCorrect ::= true;
				if (^caseKind == mizSyCase) mizCreateItem(p, mizItCaseHead)
				else mizCreateItem(p, mizItSupposeHead);
				if (p.curWord.kind != ^caseKind) mizErrImmP(p, 58);
				mizReadToken(p);
				processCase(casePos);
			});
			k = p.curWord.kind;
			if (k == mizSyReserve || k == mizSyScheme || k == mizSyTheorem
				|| k == mizSyDefinition || k == mizSyBegin || k == mizSyNotation
				|| k == mizSyRegistration || k == mizSyEOT) stop := true
			else if (k == mizSyEnd) {}
			else {
				mizMissingWord(p, paSupposeOrCaseExp);
				mizCreateItem(p, mizItCaseBlock);
				if (^caseKind == mizSyCase) mizCreateBlock(p, mizBlCase)
				else mizCreateBlock(p, mizBlSuppose);
				if (^caseKind == mizSyCase) mizCreateItem(p, mizItCaseHead)
				else mizCreateItem(p, mizItSupposeHead);
				p.stillCorrect ::= true;
				processCase(p.curPos);
			}
			!^stop && p.curWord.kind != mizSyEnd;
		});
	}
}

mizReasoning(p : MizParser) -> void {
	reasPos = p.curPos;
	k = p.curWord.kind;
	if (k == mizSyProof) { mizCreateBlock(p, mizBlProof); mizReadToken(p); }
	else if (k == mizSyHereby) { mizCreateBlock(p, mizBlHereby); mizReadToken(p); }
	else if (k == mizSyNow) { mizCreateBlock(p, mizBlDiffuse); mizReadToken(p); }
	else {
		mizCreateBlock(p, mizBlProof);
		mizWrongWord(p, paProofExp);
	}
	mizLinearReasoning(p);
	mizNonBlockReasoning(p);
	mizKillBlock(p);
	mizAcceptEnd(p, reasPos);
}

mizRegularStatement(p : MizParser) -> void {
	mizProcessLab(p);
	mizItmStartRegularStatement(p);
	if (p.curWord.kind == mizSyNow) mizReasoning(p)
	else {
		mizProcessSentence(p);
		if (p.curWord.kind == mizSyProof) {
			mizItmStartJustification(p);
			if (p.proofPragma) mizReasoning(p) else mizIgnoreProof(p);
		} else {
			mizItmStartJustification(p);
			mizSimpleJustification(p);
			mizItmFinishCompactStatement(p);
			while(\ -> p.curWord.kind == mizSyDotEquals, \ -> {
				mizItmStartIterativeStep(p);
				mizReadToken(p);
				mizTermExpression(p);
				mizItmStartJustification(p);
				mizSimpleJustification(p);
				mizItmFinishIterativeStep(p);
			});
		}
	}
}

// ---------------------------------------------------- P a t t e r n s -------

mizGetVisible(p : MizParser) -> void {
	mizItmProcessVisible(p);
	p.visibleNbr ::= p.visibleNbr + 1;
	mizAccept(p, mizSyIdentifier, paIdentExp);
}

mizReadVisible(p : MizParser) -> void {
	mizItmStartVisible(p);
	p.visibleNbr ::= 0;
	mizRepeat(\ -> {
		mizGetVisible(p);
		mizOccurs(p, mizSyComma);
	});
}

mizMaxArgsAt(v : Vector<int>, i : int) -> int {
	if (i >= 0 && i < sizeVector(v)) getVectorUnsafe(v, i) else 0;
}

mizMaxArgsSet(v : Vector<int>, i : int, x : int) -> void {
	if (i >= 0 && i < sizeVector(v)) setVector(v, i, x);
}

mizGetModePattern(p : MizParser) -> void {
	mizItmStartModePattern(p);
	k = p.curWord.kind;
	if (k == mizSySet) {
		if (p.aheadWord.kind == mizSyOf) mizWrongWord(p, paWrongModePatternSet)
		else mizReadToken(p);
	} else if (k == mizSyModeSymbol) {
		modeSymbol = p.curWord.nr;
		p.visibleNbr ::= 0;
		mizReadToken(p);
		if (mizOccurs(p, mizSyOf)) mizReadVisible(p);
		cur = mizMaxArgsAt(p.modeMaxArgs, modeSymbol);
		if (cur < p.visibleNbr || cur == 255) mizMaxArgsSet(p.modeMaxArgs, modeSymbol, p.visibleNbr);
	} else mizWrongWord(p, paWrongModePatternBeg);
	mizItmFinishModePattern(p);
}

mizReadParams(p : MizParser) -> void {
	if (mizOccurs(p, mizSyLeftParanthesis)) {
		mizReadVisible(p);
		mizAccept(p, mizSyRightParanthesis, paRightParenthExp);
	} else if (p.curWord.kind == mizSyIdentifier) {
		mizItmStartVisible(p);
		mizGetVisible(p);
	}
}

mizGetAttrPattern(p : MizParser) -> void {
	mizItmStartAttributePattern(p);
	p.visibleNbr ::= 0;
	mizGetVisible(p);
	mizAccept(p, mizSyIs, paIsExp);
	if (mizOccurs(p, mizSyLeftParanthesis)) {
		mizReadVisible(p);
		mizAccept(p, mizSyRightParanthesis, paRightParenthExp);
	} else if (p.curWord.kind == mizSyIdentifier) mizReadVisible(p);
	mizItmFinishAttributePattern(p);
	mizAccept(p, mizSyAttributeSymbol, paAttrExp);
}

mizGetFuncPattern(p : MizParser) -> void {
	mizItmStartFunctorPattern(p);
	k = p.curWord.kind;
	if (k == mizSyIdentifier || k == mizSyInfixOperatorSymbol || k == mizSyLeftParanthesis) {
		mizReadParams(p);
		mizItmProcessFunctorSymbol(p);
		mizAccept(p, mizSyInfixOperatorSymbol, paFunctExp);
		mizReadParams(p);
		mizItmFinishFunctorPattern(p);
	} else if (k == mizSyLeftCircumfixSymbol || k == mizSyLeftSquareBracket
		|| k == mizSyLeftCurlyBracket) {
		mizReadToken(p);
		mizReadVisible(p);
		mizItmFinishFunctorPattern(p);
		kk = p.curWord.kind;
		if (kk == mizSyRightSquareBracket || kk == mizSyRightCurlyBracket
			|| kk == mizSyRightParanthesis) mizReadToken(p)
		else mizAccept(p, mizSyRightCircumfixSymbol, paRightBraExp);
	} else {
		mizWrongWord(p, paWrongFunctorPatternBeg);
		mizItmFinishFunctorPattern(p);
	}
}

mizGetPredPattern(p : MizParser) -> void {
	mizItmStartPredicatePattern(p);
	if (p.curWord.kind == mizSyIdentifier) mizReadVisible(p);
	mizItmProcessPredicateSymbol(p);
	k = p.curWord.kind;
	if (k == mizSyEqual || k == mizSyPredicateSymbol) {
		predSymbol = if (k == mizSyEqual) 1 else p.curWord.nr;
		p.visibleNbr ::= 0;
		mizReadToken(p);
		if (p.curWord.kind == mizSyIdentifier) mizReadVisible(p);
		cur = mizMaxArgsAt(p.predMaxArgs, predSymbol);
		if (cur < p.visibleNbr || cur == 255) mizMaxArgsSet(p.predMaxArgs, predSymbol, p.visibleNbr);
	} else mizWrongWord(p, paWrongPredPattern);
	mizItmFinishPredicatePattern(p);
}

mizSpecification(p : MizParser) -> void {
	mizAccept(p, mizSyArrow, paArrowExp);
	mizTypeExpression(p);
	mizItmFinishSpecification(p);
}

mizGetStructPatterns(p : MizParser) -> void {
	mizCreateItem(p, mizItDefStruct);
	mizReadToken(p);
	if (p.curWord.kind == mizSyLeftParanthesis) {
		mizRepeat(\ -> {
			mizReadToken(p);
			mizTypeExpression(p);
			mizItmFinishPrefix(p);
			p.curWord.kind == mizSyComma;
		});
		mizAccept(p, mizSyRightParanthesis, paRightParenthExp);
	}
	mizItmProcessStructureSymbol(p);
	structureSymbol = if (p.curWord.kind == mizSyStructureSymbol) p.curWord.nr else 255;
	mizAccept(p, mizSyStructureSymbol, paStructExp);
	if (mizOccurs(p, mizSyOver)) mizReadVisible(p);
	mizItmStartFields(p);
	if (structureSymbol != 255) {
		cur = mizMaxArgsAt(p.structModeMaxArgs, structureSymbol);
		if (cur < p.visibleNbr || cur == 255)
			mizMaxArgsSet(p.structModeMaxArgs, structureSymbol, p.visibleNbr);
	}
	mizAccept(p, mizSyStructLeftBracket, paLeftDoubleExp);
	mizRepeat(\ -> {
		mizItmStartAggrPattSegment(p);
		mizRepeat(\ -> {
			mizItmProcessField(p);
			mizAccept(p, mizSySelectorSymbol, paSelectExp);
			mizOccurs(p, mizSyComma);
		});
		mizSpecification(p);
		mizItmFinishAggrPattSegment(p);
		mizOccurs(p, mizSyComma);
	});
	mizItmFinishFields(p);
	mizAccept(p, mizSyStructRightBracket, paRightDoubleExp);
}

// ------------------------------------------------ D e f i n i t i o n s -----

mizConstructionType(p : MizParser) -> void {
	mizItmStartConstructionType(p);
	if (p.curWord.kind == mizSyArrow) {
		mizReadToken(p);
		mizTypeExpression(p);
	}
	mizItmFinishConstructionType(p);
}

mizCorrectnessP(p : MizParser) -> void {
	while(\ -> p.curWord.kind == mizSyCorrectnessCondition, \ -> {
		p.stillCorrect ::= true;
		mizCreateItem(p, mizItCorrCond);
		mizReadToken(p);
		mizJustification(p);
		mizSemicolon(p);
	});
	mizItmProcessCorrectness(p);
	if (p.curWord.kind == mizSyCorrectness) {
		p.stillCorrect ::= true;
		mizCreateItem(p, mizItCorrectness);
		mizReadToken(p);
		mizJustification(p);
		mizSemicolon(p);
	}
}

mizDefinition(p : MizParser) -> void {
	defKind = p.curWord.kind;
	definiensExpected = ref true;
	k = p.curWord.kind;
	if (k == mizSyMode) {
		mizCreateItem(p, mizItDefMode);
		mizReadToken(p);
		mizGetModePattern(p);
		if (p.curWord.kind == mizSyIs) {
			mizItmStartExpansion(p);
			mizReadToken(p);
			mizTypeExpression(p);
			definiensExpected := false;
		} else mizConstructionType(p);
	} else if (k == mizSyAttr) {
		mizCreateItem(p, mizItDefAttr);
		mizReadToken(p);
		mizGetAttrPattern(p);
	} else if (k == mizSyStruct) {
		mizGetStructPatterns(p);
		definiensExpected := false;
	} else if (k == mizSyFunc) {
		mizCreateItem(p, mizItDefFunc);
		mizReadToken(p);
		mizGetFuncPattern(p);
		mizConstructionType(p);
	} else if (k == mizSyPred) {
		mizCreateItem(p, mizItDefPred);
		mizReadToken(p);
		mizGetPredPattern(p);
	};
	if (^definiensExpected) {
		kk = p.curWord.kind;
		if (kk == mizSyMeans) {
			mizItmProcessMeans(p);
			mizReadToken(p);
			if (mizOccurs(p, mizSyColon)) {
				mizItmProcessDefiniensLabel(p);
				mizAccept(p, mizSyIdentifier, paIdentExp);
				mizAccept(p, mizSyColon, paColonExp);
			} else mizItmProcessDefiniensLabel(p);
			mizItmStartDefiniens(p);
			mizFormulaExpression(p);
			if (p.curWord.kind == mizSyIf) {
				mizItmStartGuard(p);
				mizReadToken(p);
				mizFormulaExpression(p);
				mizItmFinishGuard(p);
				while(\ -> mizOccurs(p, mizSyComma), \ -> {
					mizFormulaExpression(p);
					mizItmStartGuard(p);
					mizAccept(p, mizSyIf, paIfExp);
					mizFormulaExpression(p);
					mizItmFinishGuard(p);
				});
				if (p.curWord.kind == mizSyOtherwise) {
					mizReadToken(p);
					mizFormulaExpression(p);
					mizItmFinishOtherwise(p);
				}
			} else mizItmFinishOtherwise(p);
			mizItmFinishDefiniens(p);
		} else if (kk == mizSyEquals) {
			if (defKind != mizSyFunc) mizWrongWord(p, paUnexpEquals)
			else {
				mizItmProcessEquals(p);
				mizReadToken(p);
				if (mizOccurs(p, mizSyColon)) {
					mizItmProcessDefiniensLabel(p);
					mizAccept(p, mizSyIdentifier, paIdentExp);
					mizAccept(p, mizSyColon, paColonExp);
				} else mizItmProcessDefiniensLabel(p);
				mizTermExpression(p);
				if (p.curWord.kind == mizSyIf) {
					mizItmStartGuard(p);
					mizReadToken(p);
					mizFormulaExpression(p);
					mizItmFinishGuard(p);
					while(\ -> mizOccurs(p, mizSyComma), \ -> {
						mizTermExpression(p);
						mizItmStartGuard(p);
						mizAccept(p, mizSyIf, paIfExp);
						mizFormulaExpression(p);
						mizItmFinishGuard(p);
					});
					if (p.curWord.kind == mizSyOtherwise) {
						mizReadToken(p);
						mizTermExpression(p);
						mizItmFinishOtherwise(p);
					}
				} else mizItmFinishOtherwise(p);
				mizItmFinishDefiniens(p);
			}
		}
	}
	mizSemicolon(p);
	mizCorrectnessP(p);
	while(\ -> p.curWord.kind == mizSyProperty, \ -> {
		mizCreateItem(p, mizItProperty);
		p.stillCorrect ::= true;
		mizReadToken(p);
		mizJustification(p);
		mizSemicolon(p);
	});
}

// CurrPatternKind (parser.pas 2015)
mizCurrPatternKind(p : MizParser) -> int {
	k = p.curWord.kind;
	a = p.aheadWord.kind;
	if (k == mizSyModeSymbol) mizSyModeSymbol
	else if (k == mizSyStructureSymbol) mizSyStructureSymbol
	else if (k == mizSyIdentifier && a == mizSyIs) mizSyAttributeSymbol
	else if (k == mizSyLeftCircumfixSymbol || k == mizSyLeftCurlyBracket
		|| k == mizSyLeftSquareBracket || k == mizSyLeftParanthesis
		|| k == mizSyInfixOperatorSymbol
		|| (k == mizSyIdentifier && a == mizSyInfixOperatorSymbol)) mizSyInfixOperatorSymbol
	else if (k == mizSyPredicateSymbol || k == mizSyEqual
		|| (k == mizSyIdentifier && (a == mizSyComma || a == mizSyPredicateSymbol
			|| a == mizSyEqual))) mizSyPredicateSymbol
	else if (k == mizSyThe && a == mizSySelectorSymbol) mizSySelectorSymbol
	else if (k == mizSyThe && a == mizSyStructureSymbol) mizSyForgetfulFunctor
	else mizSyError;
}

mizSynonym(p : MizParser) -> void {
	mizReadToken(p);
	k = mizCurrPatternKind(p);
	if (k == mizSyModeSymbol) {
		mizCreateItem(p, mizItModeNotation);
		mizGetModePattern(p);
		mizItmProcessModeSynonym(p);
		mizAccept(p, mizSyFor, paForExp);
		mizGetModePattern(p);
	} else if (k == mizSyAttributeSymbol) {
		mizCreateItem(p, mizItAttrSynonym);
		mizGetAttrPattern(p);
		mizItmProcessAttrSynonym(p);
		mizAccept(p, mizSyFor, paForExp);
		mizGetAttrPattern(p);
	} else if (k == mizSyInfixOperatorSymbol) {
		mizCreateItem(p, mizItFuncNotation);
		mizGetFuncPattern(p);
		mizItmProcessFuncSynonym(p);
		mizAccept(p, mizSyFor, paForExp);
		mizGetFuncPattern(p);
	} else if (k == mizSyPredicateSymbol) {
		mizCreateItem(p, mizItPredSynonym);
		mizGetPredPattern(p);
		mizItmProcessPredSynonym(p);
		mizAccept(p, mizSyFor, paForExp);
		mizGetPredPattern(p);
	} else {
		mizCreateItem(p, mizItIncorrItem);
		mizErrImmP(p, paWrongPattBeg);
	}
}

mizAntonym(p : MizParser) -> void {
	mizReadToken(p);
	k = mizCurrPatternKind(p);
	if (k == mizSyAttributeSymbol) {
		mizCreateItem(p, mizItAttrAntonym);
		mizGetAttrPattern(p);
		mizItmProcessAttrAntonym(p);
		mizAccept(p, mizSyFor, paForExp);
		mizGetAttrPattern(p);
	} else if (k == mizSyPredicateSymbol) {
		mizCreateItem(p, mizItPredAntonym);
		mizGetPredPattern(p);
		mizItmProcessPredAntonym(p);
		mizAccept(p, mizSyFor, paForExp);
		mizGetPredPattern(p);
	} else {
		mizCreateItem(p, mizItIncorrItem);
		mizErrImmP(p, paWrongPattBeg);
	}
}

mizUnexpectedItem(p : MizParser) -> void {
	k = p.curWord.kind;
	if (k == mizSyCase || k == mizSySuppose || k == mizSyHereby) {
		mizErrImmP(p, paWrongItemBeg);
		mizReadToken(p);
		if (p.curWord.kind == mizSyThat) mizReadToken(p);
		mizPrivateItem(p);
	} else if (k == mizSyPer) {
		mizCreateItem(p, mizItIncorrItem);
		mizErrImmP(p, paWrongItemBeg);
		mizReadToken(p);
		if (p.curWord.kind == mizSyCases) {
			mizReadToken(p);
			mizInCorrStatement(p);
			mizSimpleJustification(p);
		}
	} else {
		mizErrImmP(p, paUnexpItemBeg);
		p.stillCorrect ::= true;
		mizPrivateItem(p);
	}
}

mizIsTopLevelStart(k : int) -> bool {
	k == mizSyBegin || k == mizSyEOT || k == mizSyReserve || k == mizSyScheme
	|| k == mizSyTheorem || k == mizSyDefinition || k == mizSyRegistration
	|| k == mizSyNotation;
}

mizDefinitionalBlock(p : MizParser) -> void {
	mizCreateItem(p, mizItDefinition);
	mizCreateBlock(p, mizBlDefinition);
	defPos = p.curPos;
	mizReadToken(p);
	brk = ref false;
	while(\ -> !^brk && p.curWord.kind != mizSyEnd, \ -> {
		p.stillCorrect ::= true;
		mizBlkProcessRedefine(p);
		if (mizOccurs(p, mizSyRedefine)) {
			kr = p.curWord.kind;
			if (!(kr == mizSyMode || kr == mizSyAttr || kr == mizSyFunc || kr == mizSyPred))
				mizErrorP(p, p.prevPos, paUnexpRedef);
		}
		k = p.curWord.kind;
		if (k == mizSyMode || k == mizSyAttr || k == mizSyStruct
			|| k == mizSyFunc || k == mizSyPred) mizDefinition(p)
		else if (mizIsTopLevelStart(k)) brk := true
		else if (k == mizSyPragma) mizProcessPragmas(p)
		else {
			if (k == mizSyLet) {
				mizCreateItem(p, mizItLociDeclaration);
				mizGeneralization(p);
			} else if (k == mizSyGiven) mizExistentialAssumption(p)
			else if (k == mizSyAssume) {
				mizCreateItem(p, mizItAssumption);
				mizReadToken(p);
				mizAssumption(p);
			} else if (k == mizSyCanceled) mizCanceled(p)
			else if (k == mizSyCase || k == mizSySuppose || k == mizSyPer
				|| k == mizSyHereby) mizUnexpectedItem(p)
			else mizPrivateItem(p);
			mizSemicolon(p);
		}
	});
	mizKillBlock(p);
	mizAcceptEnd(p, defPos);
}

mizNotationBlock(p : MizParser) -> void {
	mizCreateItem(p, mizItDefinition);
	mizCreateBlock(p, mizBlNotation);
	defPos = p.curPos;
	mizReadToken(p);
	brk = ref false;
	while(\ -> !^brk && p.curWord.kind != mizSyEnd, \ -> {
		p.stillCorrect ::= true;
		k = p.curWord.kind;
		if (mizIsTopLevelStart(k)) brk := true
		else if (k == mizSyPragma) mizProcessPragmas(p)
		else {
			if (k == mizSySynonym) mizSynonym(p)
			else if (k == mizSyAntonym) mizAntonym(p)
			else if (k == mizSyLet) {
				mizCreateItem(p, mizItLociDeclaration);
				mizReadToken(p);
				mizFixedVariables(p);
			} else mizUnexpectedItem(p);
			mizSemicolon(p);
		}
	});
	mizKillBlock(p);
	mizAcceptEnd(p, defPos);
}

// ATTSubexpression (parser.pas 2226) — returns the expression kind it read
mizATTSubexpression(p : MizParser) -> int {
	expKind = ref mizExNull;
	mizSubStartAttributes(p);
	brk = ref false;
	while(\ -> !^brk && mizAttrLoopGuard(p), \ -> {
		mizSubProcessNon(p);
		attrExp = p.curWord.kind == mizSyNon;
		if (p.curWord.kind == mizSyNon) mizReadToken(p);
		k = p.curWord.kind;
		if ((mizInTermBegSys(k) && k != mizSyStructureSymbol)
			|| (k == mizSyStructureSymbol && p.aheadWord.kind == mizSyStructLeftBracket)) {
			if (^expKind == mizExNull) expKind := mizExTerm;
			mizSubStartAttributeArguments(p);
			mizProcessArguments(p);
			mizSubFinishAttributeArguments(p);
		}
		if (p.curWord.kind == mizSyAttributeSymbol) {
			expKind := mizExAdjectiveCluster;
			mizSubProcessAttribute(p);
			mizReadToken(p);
		} else {
			if (attrExp || ^expKind == mizExAdjectiveCluster) {
				mizSubProcessAttribute(p);
				mizSynErr(p, p.curPos, paAttrExp);
			}
			brk := true;
		}
	});
	^expKind;
}

mizClusterType(p : MizParser) -> void {
	mizCreateExpression(p, mizExType);
	mizCreateSubexpression(p);
	mizSubStartType(p);
	mizSubStartAttributes(p);
	mizGetAdjectiveCluster(p);
	mizRadixTypeSubexpression(p);
	mizSubCompleteType(p);
	mizKillSubexpression(p);
	mizKillExpression(p);
}

mizRegisterCluster(p : MizParser) -> void {
	mizCreateItem(p, mizItCluster);
	mizReadToken(p);
	if (p.curWord.kind == mizSyIdentifier && p.aheadWord.kind == mizSyArrow)
		mizErrImmP(p, paFunctExp);
	mizItmStartAttributes(p);
	mizCreateExpression(p, mizExAdjectiveCluster);
	mizCreateSubexpression(p);
	expKind = mizATTSubexpression(p);
	if (expKind == mizExTerm) mizSubCompleteClusterTerm(p)
	else mizSubCompleteAdjectiveCluster(p);
	mizKillSubexpression(p);
	mizKillExpression(p);
	if (expKind == mizExTerm) {
		mizItmFinishClusterTerm(p);
		mizAccept(p, mizSyArrow, paArrowExp);
		mizCreateExpression(p, mizExAdjectiveCluster);
		mizCreateSubexpression(p);
		mizSubStartAttributes(p);
		k2 = mizATTSubexpression(p);
		if (k2 != mizExAdjectiveCluster) mizErrImmP(p, paAdjClusterExp);
		mizSubCompleteAdjectiveCluster(p);
		mizKillSubexpression(p);
		mizKillExpression(p);
		mizItmFinishConsequent(p);
		if (p.curWord.kind == mizSyFor) {
			mizReadToken(p);
			mizClusterType(p);
		}
	} else {
		k = p.curWord.kind;
		if (k == mizSyArrow) {
			mizItmFinishAntecedent(p);
			mizReadToken(p);
			mizCreateExpression(p, mizExAdjectiveCluster);
			mizCreateSubexpression(p);
			mizSubStartAttributes(p);
			k2 = mizATTSubexpression(p);
			if (k2 != mizExAdjectiveCluster) mizErrImmP(p, paAdjClusterExp);
			mizSubCompleteAdjectiveCluster(p);
			mizKillSubexpression(p);
			mizKillExpression(p);
			mizItmFinishConsequent(p);
			mizAccept(p, mizSyFor, paForExp);
			mizClusterType(p);
		} else if (k == mizSyFor) {
			mizItmFinishConsequent(p);
			mizReadToken(p);
			mizClusterType(p);
		} else {
			mizSynErr(p, p.curPos, paForOrArrowExpected);
			mizItmFinishConsequent(p);
			mizCreateExpression(p, mizExType);
			mizCreateSubexpression(p);
			mizSubStartType(p);
			mizSubInsertIncorrType(p);
			mizSubCompleteType(p);
			mizKillSubexpression(p);
			mizKillExpression(p);
		}
	}
	mizSemicolon(p);
	mizCorrectnessP(p);
}

mizReduction(p : MizParser) -> void {
	mizCreateItem(p, mizItReduction);
	mizReadToken(p);
	if (p.curWord.kind == mizSyIdentifier && p.aheadWord.kind == mizSyArrow)
		mizErrImmP(p, paFunctExp);
	mizTermExpression(p);
	mizItmProcessFuncReduction(p);
	mizAccept(p, mizSyTo, paToExp);
	mizTermExpression(p);
	mizSemicolon(p);
	mizCorrectnessP(p);
}

mizIdentification(p : MizParser) -> void {
	mizCreateItem(p, mizItIdentify);
	mizReadToken(p);
	mizGetFuncPattern(p);
	mizItmProcessFuncIdentify(p);
	mizAccept(p, mizSyWith, paWithExp);
	mizGetFuncPattern(p);
	mizItmCompleteFuncIdentify(p);
	if (p.curWord.kind == mizSyWhen) {
		mizReadToken(p);
		mizRepeat(\ -> {
			mizItmProcessLeftLocus(p);
			mizAccept(p, mizSyIdentifier, paIdentExp);
			mizAccept(p, mizSyEqual, paEqualityExp);
			mizItmProcessRightLocus(p);
			mizAccept(p, mizSyIdentifier, paIdentExp);
			mizOccurs(p, mizSyComma);
		});
	}
	mizSemicolon(p);
	mizCorrectnessP(p);
}

mizRegisterProperty(p : MizParser) -> void {
	mizCreateItem(p, mizItPropertyRegistration);
	if (p.curWord.nr == 12) {
		mizReadToken(p);
		mizAccept(p, mizSyOf, paOfExp);
		mizTypeExpression(p);
		mizItmFinishSethoodProperties(p);
		mizJustification(p);
	} else mizSynErr(p, p.curPos, 400);
	mizSemicolon(p);
}

mizRegistrationBlock(p : MizParser) -> void {
	mizCreateItem(p, mizItDefinition);
	mizCreateBlock(p, mizBlRegistration);
	defPos = p.curPos;
	mizReadToken(p);
	brk = ref false;
	while(\ -> !^brk && p.curWord.kind != mizSyEnd, \ -> {
		p.stillCorrect ::= true;
		k = p.curWord.kind;
		if (k == mizSyCluster) mizRegisterCluster(p)
		else if (k == mizSyReduce) mizReduction(p)
		else if (k == mizSyIdentifyKw) mizIdentification(p)
		else if (k == mizSyProperty) mizRegisterProperty(p)
		else if (mizIsTopLevelStart(k)) brk := true
		else if (k == mizSyPragma) mizProcessPragmas(p)
		else {
			if (k == mizSyLet) {
				mizCreateItem(p, mizItLociDeclaration);
				mizReadToken(p);
				mizFixedVariables(p);
			} else if (k == mizSyCanceled) mizCanceled(p)
			else if (k == mizSyCase || k == mizSySuppose || k == mizSyPer
				|| k == mizSyHereby) mizUnexpectedItem(p)
			else mizPrivateItem(p);
			mizSemicolon(p);
		}
	});
	mizKillBlock(p);
	mizAcceptEnd(p, defPos);
}

mizReservation(p : MizParser) -> void {
	mizCreateItem(p, mizItReservation);
	mizReadToken(p);
	mizRepeat(\ -> {
		mizItmStartReservationSegment(p);
		mizRepeat(\ -> {
			mizItmProcessReservedIdentifier(p);
			mizAccept(p, mizSyIdentifier, paIdentExp);
			mizOccurs(p, mizSyComma);
		});
		mizAccept(p, mizSyFor, paForExp);
		mizCreateExpression(p, mizExResType);
		mizTypeSubexpression(p);
		mizKillExpression(p);
		mizItmFinishReservationSegment(p);
		mizOccurs(p, mizSyComma);
	});
}

mizTheorem(p : MizParser) -> void {
	mizCreateItem(p, mizItTheorem);
	mizReadToken(p);
	mizProcessLab(p);
	mizProcessSentence(p);
	mizJustification(p);
}

mizAxiom(p : MizParser) -> void {
	mizCreateItem(p, mizItAxiom);
	mizReadToken(p);
	mizProcessLab(p);
	mizProcessSentence(p);
}

// ------------------------------- M a i n   ( w i t h   S c h e m e s ) ------

mizSchemeBlock(p : MizParser) -> void {
	mizCreateItem(p, mizItSchemeBlock);
	mizCreateBlock(p, mizBlPublicScheme);
	mizReadToken(p);
	mizCreateItem(p, mizItSchemeHead);
	mizItmProcessSchemeName(p);
	schemePos = p.prevPos;
	if (p.curWord.kind == mizSyIdentifier) mizReadToken(p);
	mizAccept(p, mizSyLeftCurlyBracket, paLeftCurledExp);
	mizRepeat(\ -> {
		mizItmStartSchemeSegment(p);
		mizRepeat(\ -> {
			mizItmProcessSchemeVariable(p);
			mizAccept(p, mizSyIdentifier, paIdentExp);
			mizOccurs(p, mizSyComma);
		});
		mizItmStartSchemeQualification(p);
		k = p.curWord.kind;
		if (k == mizSyLeftSquareBracket) {
			mizReadToken(p);
			mizReadTypeList(p);
			mizItmFinishSchemeQualification(p);
			mizAccept(p, mizSyRightSquareBracket, paRightSquareExp);
		} else if (k == mizSyLeftParanthesis) {
			mizReadToken(p);
			mizReadTypeList(p);
			mizItmFinishSchemeQualification(p);
			mizAccept(p, mizSyRightParanthesis, paRightParenthExp);
			mizSpecification(p);
		} else {
			mizErrImmP(p, paWrongSchemeVarQual);
			mizItmFinishSchemeQualification(p);
			mizSpecification(p);
		}
		mizItmFinishSchemeSegment(p);
		mizOccurs(p, mizSyComma);
	});
	mizAccept(p, mizSyRightCurlyBracket, paRightCurledExp);
	mizAccept(p, mizSyColon, paColonExp);
	mizFormulaExpression(p);
	mizItmFinishSchemeThesis(p);
	if (p.curWord.kind == mizSyProvided) {
		mizRepeat(\ -> {
			mizReadToken(p);
			mizProcessLab(p);
			mizProcessSentence(p);
			mizItmFinishSchemePremise(p);
			p.curWord.kind == mizSyAnd;
		});
	}
	if (p.curWord.kind == mizSyProof) {
		mizKillItem(p);
		if (!p.proofPragma) {
			mizBlkStartSchemeDemonstration(p);
			mizIgnoreProof(p);
			mizBlkFinishSchemeDemonstration(p);
		} else {
			p.stillCorrect ::= true;
			mizAccept(p, mizSyProof, paProofExp);
			mizBlkStartSchemeDemonstration(p);
			mizLinearReasoning(p);
			if (p.curWord.kind == mizSyPer) mizNonBlockReasoning(p);
			mizAcceptEnd(p, schemePos);
			mizBlkFinishSchemeDemonstration(p);
		}
	} else {
		mizSemicolon(p);
		if (!p.proofPragma) {
			mizBlkStartSchemeDemonstration(p);
			mizIgnoreProof(p);
			mizBlkFinishSchemeDemonstration(p);
		} else {
			p.stillCorrect ::= true;
			if (p.curWord.kind == mizSyProof) {
				mizWrongWord(p, paProofExp);
				p.stillCorrect ::= true;
				mizReadToken(p);
			}
			mizBlkStartSchemeDemonstration(p);
			mizLinearReasoning(p);
			if (p.curWord.kind == mizSyPer) mizNonBlockReasoning(p);
			mizAcceptEnd(p, schemePos);
			mizBlkFinishSchemeDemonstration(p);
		}
	}
	mizKillBlock(p);
}

mizParse(p : MizParser) -> void {
	mizReadToken(p);
	while(\ -> p.curWord.kind != mizSyBegin && p.curWord.kind != mizSyEOT,
		\ -> mizReadToken(p));
	if (p.curWord.kind == mizSyEOT) mizErrImmP(p, 213)
	else {
		mizBlkStartProperText(p);
		mizBlkProcessBegin(p);
		mizAccept(p, mizSyBegin, 213);
		brk = ref false;
		while(\ -> !^brk && p.curWord.kind != mizSyEOT, \ -> {
			while(\ -> p.curWord.kind == mizSyBegin || p.curWord.kind == mizSyPragma, \ -> {
				mizProcessPragmas(p);
				if (p.curWord.kind == mizSyBegin) {
					mizBlkProcessBegin(p);
					mizReadToken(p);
				}
			});
			p.stillCorrect ::= true;
			cont = ref false;
			if (p.curWord.kind == mizSyEnd) {
				mizRepeat(\ -> {
					mizErrImmP(p, 216);
					mizReadToken(p);
					if (p.curWord.kind == mizSySemicolon) mizReadToken(p);
					p.curWord.kind == mizSyEnd;
				});
				if (p.curWord.kind == mizSyBegin) cont := true;   // goto: continue
			}
			if (!^cont) {
				if (p.curWord.kind == mizSyEOT) brk := true
				else {
					k = p.curWord.kind;
					if (k == mizSyScheme) mizSchemeBlock(p)
					else if (k == mizSyDefinition) mizDefinitionalBlock(p)
					else if (k == mizSyNotation) mizNotationBlock(p)
					else if (k == mizSyRegistration) mizRegistrationBlock(p)
					else if (k == mizSyReserve) mizReservation(p)
					else if (k == mizSyTheorem) mizTheorem(p)
					else if (k == mizSyAxiom) mizAxiom(p)
					else if (k == mizSyCanceled) mizCanceled(p)
					else if (k == mizSyCase || k == mizSySuppose || k == mizSyPer
						|| k == mizSyHereby) mizUnexpectedItem(p)
					else mizPrivateItem(p);
					mizSemicolon(p);
				}
			}
		});
	}
	mizKillBlock(p);
}
