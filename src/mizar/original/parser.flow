mizSyContradiction = 37; mizSyAmpersand = 38; mizSyBy = 39;
mizSyLeftParanthesis = 40; mizSyRightParanthesis = 41;
mizSyRegistration = 42; mizSyDefinition = 43; mizSyComma = 44;
mizSyNotation = 45; mizSyEllipsis = 46; mizSyProof = 47;
