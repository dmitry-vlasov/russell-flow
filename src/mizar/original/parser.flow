// Transcription of ~/dev/system/base/parser.pas — the Mizar grammar.
//
// A recursive-descent parser over the token stream of scanner.flow. Every
// action is a call into parseraddition.flow (the WSM builder); the parser
// itself holds NO tree, only the token registers and the block/item/subexp
// stacks.
//
// Pascal `goto` out of a loop becomes a helper function with an early return,
// marked `// goto:` at the site, as the CONVENTIONS require.

import ds/vector;
import loop;
import string;
import mizar/original/errhan;
import mizar/original/scanner;
import mizar/original/formats;
import mizar/original/wsm;
import mizar/original/parseraddition;

export {
	// mscanner.pas TokenKind ordinals
	mizSyEOT : int; mizSyPragma : int;
	mizSyFrom : int; mizSyIdentifyKw : int; mizSyThesis : int;
	mizSyContradiction : int; mizSyAmpersand : int; mizSyBy : int;
	mizSyLeftParanthesis : int; mizSyRightParanthesis : int;
	mizSyRegistration : int; mizSyDefinition : int; mizSyComma : int;
	mizSyNotation : int; mizSyEllipsis : int; mizSyProof : int;
	mizSyColon : int; mizSySemicolon : int; mizSyNow : int; mizSyEqual : int;
	mizSyEnd : int; mizSyError : int; mizSyMMLIdentifier : int;
	mizSyLibraryDirective : int; mizSyStructureSymbol : int;
	mizSyIdentifier : int; mizSyForgetfulFunctor : int;
	mizSyLeftCircumfixSymbol : int; mizSyRightCircumfixSymbol : int;
	mizSyModeSymbol : int; mizSyNumeral : int; mizSyInfixOperatorSymbol : int;
	mizSyReferenceSort : int; mizSyPredicateSymbol : int;
	mizSySelectorSymbol : int; mizSyAttributeSymbol : int;
	mizSyProperty : int; mizSyCorrectnessCondition : int; mizSyDolar : int;
	mizSyLeftSquareBracket : int; mizSyRightSquareBracket : int;
	mizSyAccording : int; mizSyReduce : int; mizSyEquals : int; mizSyWith : int;
	mizSyWrt : int; mizSyTo : int; mizSyWhen : int; mizSyAxiom : int;
	mizSyLeftCurlyBracket : int; mizSyRightCurlyBracket : int;
	mizSyCorrectness : int; mizSyIf : int; mizSyIs : int; mizSyAre : int;
	mizSyOtherwise : int; mizSyEx : int; mizSyFor : int; mizSyDefine : int;
	mizSyBeing : int; mizSyOver : int; mizSyCanceled : int; mizSyDo : int;
	mizSyDoes : int; mizSyOr : int; mizSyWhere : int; mizSyNon : int;
	mizSyNot : int; mizSyCluster : int; mizSyAttr : int;
	mizSyStructLeftBracket : int; mizSyStructRightBracket : int;
	mizSyEnviron : int; mizSyBegin : int; mizSyHence : int; mizSyHereby : int;
	mizSyThen : int; mizSyDotEquals : int; mizSySynonym : int;
	mizSyAntonym : int; mizSyLet : int; mizSyTake : int; mizSyAssume : int;
	mizSyThus : int; mizSyGiven : int; mizSySuppose : int; mizSyConsider : int;
	mizSyArrow : int; mizSyAs : int; mizSyQua : int; mizSyBe : int;
	mizSyReserve : int; mizSySet : int; mizSySelector : int; mizSyCases : int;
	mizSyPer : int; mizSyScheme : int; mizSyRedefine : int;
	mizSyReconsider : int; mizSyCase : int; mizSyPrefix : int; mizSyThe : int;
	mizSyIt : int; mizSyAll : int; mizSyTheorem : int; mizSyStruct : int;
	mizSyExactly : int; mizSyMode : int; mizSyIff : int; mizSyFunc : int;
	mizSyPred : int; mizSyImplies : int; mizSySt : int; mizSyHolds : int;
	mizSyProvided : int; mizSyMeans : int; mizSyOf : int; mizSyDefpred : int;
	mizSyDeffunc : int; mizSySuch : int; mizSyThat : int; mizSyAggregate : int;
	mizSyAnd : int;

	mizMaxVisArgNbr : int;

	// procedure Parse — the whole text proper
	mizParse(p : MizParser) -> void;
	mizReadToken(p : MizParser) -> void;
	mizStartScanner(p : MizParser) -> void;
}

mizSyEOT = 33; mizSyPragma = 32;
