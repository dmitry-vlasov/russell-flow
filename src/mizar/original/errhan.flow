// Transcription of ~/dev/system/base/errhan.pas — error handling.
//
// The original keeps CurPos/ErrorNbr/PutError as unit globals and writes errors
// to a `.err` text file. Here the unit's globals are ONE struct (MizErrHan),
// created per article, and errors accumulate in a Vector; writing the `.err`
// file is a separate step. RunTimeError/Mizassert abort via `fail`, matching
// the original's RunError(98/99).

import ds/vector;
import runtime;
import string;

export {
	// Position = record Line,Col: integer
	MizPos(line : int, col : int);
	mizZeroPos = MizPos(0, 0);

	// One recorded error: position + Mizar error number.
	MizErr(pos : MizPos, nr : int);

	// The unit state: CurPos, ErrorNbr, the error list.
	MizErrHan(
		mutable curPos : MizPos,
		mutable errorNbr : int,
		errors : Vector<MizErr>,
	);

	mizMakeErrHan() -> MizErrHan;

	// procedure Error(Pos, ErrNr)
	mizError(eh : MizErrHan, pos : MizPos, errNr : int) -> void;

	// procedure ErrImm(ErrNr) — error at CurPos
	mizErrImm(eh : MizErrHan, errNr : int) -> void;

	// The `.err` file body the original would write: "line col nr\n" per error.
	mizErrors2s(eh : MizErrHan) -> string;

	// procedure RunTimeError(ErrorCode) — internal can't-happen, aborts.
	mizRunTimeError(errorCode : int) -> void;

	// procedure Mizassert(ErrorCode, Cond)
	mizAssert(errorCode : int, cond : bool) -> void;
}

mizMakeErrHan() -> MizErrHan {
	MizErrHan(MizPos(1, 1), 0, makeVector(32));
}

mizError(eh : MizErrHan, pos : MizPos, errNr : int) -> void {
	eh.errorNbr ::= eh.errorNbr + 1;
	pushVector(eh.errors, MizErr(pos, errNr));
}

mizErrImm(eh : MizErrHan, errNr : int) -> void {
	mizError(eh, eh.curPos, errNr);
}

mizErrors2s(eh : MizErrHan) -> string {
	foldVector(eh.errors, "", \acc, e ->
		acc + i2s(e.pos.line) + " " + i2s(e.pos.col) + " " + i2s(e.nr) + "\n"
	);
}

mizRunTimeError(errorCode : int) -> void {
	fail("Mizar RunTimeError " + i2s(errorCode));
}

mizAssert(errorCode : int, cond : bool) -> void {
	if (!cond) {
		fail("Mizar assertion failed: " + i2s(errorCode));
	}
}
