// Transcription of ~/dev/system/base/syntax.pas (the block/item/expression
// KINDS) and base/abstract_syntax.pas + the AST half of base/wsmarticle.pas —
// the Weakly Strict Mizar syntax tree the parser builds and writes as `.wsx`.
//
// The tree has three layers, exactly as the Pascal has:
//   * EXPRESSIONS   types, terms, formulas, adjectives, variable segments
//                   (abstract_syntax.pas). Immutable here — the parser builds
//                   them bottom up and never rewrites one.
//   * ITEM CONTENTS one record per ItemKind (wsmarticle.pas), collected in
//                   MizWsContent.
//   * BLOCKS/ITEMS  wsBlock / wsItem, the spine. These ARE mutable: an item
//                   is created when its first token is read and its content,
//                   its block and its end position arrive later.
//
// Kinds stay INTEGERS with the same ordinal as the Pascal enum, because the
// name tables below are indexed by that ordinal and the `.wsx` records the
// name. Never renumber.

import ds/vector;
import mizar/original/errhan;

export {
	// ---- syntax.pas BlockKind ----
	mizBlMain : int;         mizBlDiffuse : int;      mizBlHereby : int;
	mizBlProof : int;        mizBlDefinition : int;   mizBlNotation : int;
	mizBlRegistration : int; mizBlCase : int;         mizBlSuppose : int;
	mizBlPublicScheme : int;

	// ---- syntax.pas ItemKind ----
	mizItIncorrItem : int;          mizItDefinition : int;
	mizItSchemeBlock : int;         mizItSchemeHead : int;
	mizItTheorem : int;             mizItAxiom : int;
	mizItReservation : int;         mizItCanceled : int;
	mizItSection : int;             mizItRegularStatement : int;
	mizItChoice : int;              mizItReconsider : int;
	mizItPrivFuncDefinition : int;  mizItPrivPredDefinition : int;
	mizItConstantDefinition : int;  mizItGeneralization : int;
	mizItLociDeclaration : int;     mizItExistentialAssumption : int;
	mizItExemplification : int;     mizItPerCases : int;
	mizItConclusion : int;          mizItCaseBlock : int;
	mizItCaseHead : int;            mizItSupposeHead : int;
	mizItAssumption : int;          mizItCorrCond : int;
	mizItCorrectness : int;         mizItProperty : int;
	mizItDefPred : int;             mizItDefFunc : int;
	mizItDefMode : int;             mizItDefAttr : int;
	mizItDefStruct : int;           mizItPredSynonym : int;
	mizItPredAntonym : int;         mizItFuncNotation : int;
	mizItModeNotation : int;        mizItAttrSynonym : int;
	mizItAttrAntonym : int;         mizItCluster : int;
	mizItIdentify : int;            mizItReduction : int;
	mizItPropertyRegistration : int; mizItPragma : int;

	// ---- syntax.pas ExpKind ----
	mizExNull : int;    mizExType : int;     mizExTerm : int;
	mizExFormula : int; mizExResType : int;  mizExAdjectiveCluster : int;

	// ---- expressions (abstract_syntax.pas) ----
	MizWsVariable(pos : MizPos, ident : int);

	MizWsType ::= MizWsErrorType, MizWsStandardType, MizWsStructType,
		MizWsClusteredType, MizWsReservedDscrType;
		MizWsErrorType(pos : MizPos);
		MizWsStandardType(pos : MizPos, modeSymbol : int, args : [MizWsTerm]);
		MizWsStructType(pos : MizPos, structSymbol : int, args : [MizWsTerm]);
		MizWsClusteredType(pos : MizPos, cluster : [MizWsAdjExpr], typ : MizWsType);
		MizWsReservedDscrType(pos : MizPos);

	MizWsTerm ::= MizWsErrorTerm, MizWsPlaceholderTerm, MizWsNumeralTerm,
		MizWsSimpleTerm, MizWsPrivateFunctorTerm, MizWsInfixTerm,
		MizWsCircumfixTerm, MizWsAggregateTerm, MizWsForgetfulFunctorTerm,
		MizWsInternalForgetfulFunctorTerm, MizWsSelectorTerm,
		MizWsInternalSelectorTerm, MizWsQualificationTerm, MizWsExactlyTerm,
		MizWsGlobalChoiceTerm, MizWsSimpleFraenkelTerm, MizWsFraenkelTerm,
		MizWsItTerm;
		MizWsErrorTerm(pos : MizPos);
		MizWsPlaceholderTerm(pos : MizPos, locusNr : int);
		MizWsNumeralTerm(pos : MizPos, value : int);
		MizWsSimpleTerm(pos : MizPos, ident : int);
		MizWsPrivateFunctorTerm(pos : MizPos, functorIdent : int, args : [MizWsTerm]);
		MizWsInfixTerm(pos : MizPos, functorSymbol : int, leftArgs : [MizWsTerm], rightArgs : [MizWsTerm]);
		MizWsCircumfixTerm(pos : MizPos, leftBracket : int, rightBracket : int, args : [MizWsTerm]);
		MizWsAggregateTerm(pos : MizPos, structSymbol : int, args : [MizWsTerm]);
		MizWsForgetfulFunctorTerm(pos : MizPos, structSymbol : int, arg : MizWsTerm);
		MizWsInternalForgetfulFunctorTerm(pos : MizPos, structSymbol : int);
		MizWsSelectorTerm(pos : MizPos, selectorSymbol : int, arg : MizWsTerm);
		MizWsInternalSelectorTerm(pos : MizPos, selectorSymbol : int);
		MizWsQualificationTerm(pos : MizPos, subject : MizWsTerm, qualification : MizWsType);
		MizWsExactlyTerm(pos : MizPos, subject : MizWsTerm);
		MizWsGlobalChoiceTerm(pos : MizPos, choiceType : MizWsType);
		MizWsSimpleFraenkelTerm(pos : MizPos, postqual : [MizWsSegment], sample : MizWsTerm);
		MizWsFraenkelTerm(pos : MizPos, postqual : [MizWsSegment], sample : MizWsTerm, formula : MizWsFormula);
		MizWsItTerm(pos : MizPos);

	MizWsAdjExpr ::= MizWsAdjective, MizWsNegatedAdjective;
		MizWsAdjective(pos : MizPos, symbol : int, negated : bool, args : [MizWsTerm]);
		MizWsNegatedAdjective(pos : MizPos, arg : MizWsAdjExpr);

	MizWsSegment ::= MizWsImplSegment, MizWsExplSegment;
		MizWsImplSegment(pos : MizPos, ident : MizWsVariable);
		MizWsExplSegment(pos : MizPos, idents : [MizWsVariable], typ : MizWsType);

	MizWsFormula ::= MizWsErrorFormula, MizWsThesis, MizWsContradiction,
		MizWsRightSideOfPredicativeFormula, MizWsPredicativeFormula,
		MizWsMultiPredicativeFormula, MizWsPrivatePredicateFormula,
		MizWsAttributiveFormula, MizWsQualifyingFormula, MizWsUniversalFormula,
		MizWsExistentialFormula, MizWsNegatedFormula, MizWsConjunctiveFormula,
		MizWsDisjunctiveFormula, MizWsConditionalFormula,
		MizWsBiconditionalFormula, MizWsFlexaryConjunctiveFormula,
		MizWsFlexaryDisjunctiveFormula;
		MizWsErrorFormula(pos : MizPos);
		MizWsThesis(pos : MizPos);
		MizWsContradiction(pos : MizPos);
		MizWsRightSideOfPredicativeFormula(pos : MizPos, predNr : int, rightArgs : [MizWsTerm]);
		MizWsPredicativeFormula(pos : MizPos, predNr : int, leftArgs : [MizWsTerm], rightArgs : [MizWsTerm]);
		MizWsMultiPredicativeFormula(pos : MizPos, scraps : [MizWsFormula]);
		MizWsPrivatePredicateFormula(pos : MizPos, predIdNr : int, args : [MizWsTerm]);
		MizWsAttributiveFormula(pos : MizPos, subject : MizWsTerm, adjectives : [MizWsAdjExpr]);
		MizWsQualifyingFormula(pos : MizPos, subject : MizWsTerm, typ : MizWsType);
		MizWsUniversalFormula(pos : MizPos, segment : MizWsSegment, scope : MizWsFormula);
		MizWsExistentialFormula(pos : MizPos, segment : MizWsSegment, scope : MizWsFormula);
		MizWsNegatedFormula(pos : MizPos, arg : MizWsFormula);
		MizWsConjunctiveFormula(pos : MizPos, left : MizWsFormula, right : MizWsFormula);
		MizWsDisjunctiveFormula(pos : MizPos, left : MizWsFormula, right : MizWsFormula);
		MizWsConditionalFormula(pos : MizPos, left : MizWsFormula, right : MizWsFormula);
		MizWsBiconditionalFormula(pos : MizPos, left : MizWsFormula, right : MizWsFormula);
		MizWsFlexaryConjunctiveFormula(pos : MizPos, left : MizWsFormula, right : MizWsFormula);
		MizWsFlexaryDisjunctiveFormula(pos : MizPos, left : MizWsFormula, right : MizWsFormula);

	// ---- item pieces (wsmarticle.pas) ----
	MizWsLabel(idNr : int, pos : MizPos);
	// LabelPtr may be nil; MizWsNoLabel stands for that.
	MizWsMaybeLabel ::= MizWsLabel, MizWsNoLabel;
		MizWsNoLabel();

	MizWsProposition(lab : MizWsMaybeLabel, sentence : MizWsFormula, sntPos : MizPos);

	// ReferenceKind ordinals: 0 local, 1 theorem, 2 definition
	MizWsReference ::= MizWsLocalRef, MizWsTheoremRef, MizWsDefinitionRef;
		MizWsLocalRef(pos : MizPos, labId : int);
		MizWsTheoremRef(pos : MizPos, articleNr : int, theoNr : int);
		MizWsDefinitionRef(pos : MizPos, articleNr : int, defNr : int);

	// InferenceKind ordinals: 0 error, 1 straightforward, 2 scheme, 3 proof,
	// 4 skipped proof
	MizWsJustification ::= MizWsInfError, MizWsStraightforward, MizWsSchemeJust,
		MizWsProofJust, MizWsSkippedProof;
		MizWsInfError(pos : MizPos);
		MizWsStraightforward(pos : MizPos, refs : [MizWsReference], linked : bool, linkPos : MizPos);
		MizWsSchemeJust(pos : MizPos, refs : [MizWsReference], schFileNr : int,
			schemeIdNr : int, schemeInfPos : MizPos);
		MizWsProofJust(pos : MizPos);
		MizWsSkippedProof(pos : MizPos);

	MizWsLocus(pos : MizPos, varId : int);

	MizWsPattern ::= MizWsPredPattern, MizWsInfixFunctorPattern,
		MizWsCircumfixFunctorPattern, MizWsModePattern, MizWsAttrPattern;
		MizWsPredPattern(pos : MizPos, symbol : int, leftArgs : [MizWsLocus], rightArgs : [MizWsLocus]);
		MizWsInfixFunctorPattern(pos : MizPos, symbol : int, leftArgs : [MizWsLocus], rightArgs : [MizWsLocus]);
		MizWsCircumfixFunctorPattern(pos : MizPos, leftBracket : int, rightBracket : int, args : [MizWsLocus]);
		MizWsModePattern(pos : MizPos, symbol : int, args : [MizWsLocus]);
		MizWsAttrPattern(pos : MizPos, symbol : int, arg : MizWsLocus, args : [MizWsLocus]);

	// DefExpressionObj: an expression tagged with its ExpKind
	MizWsDefExpr(exprKind : int, term : Maybe<MizWsTerm>, formula : Maybe<MizWsFormula>);

	MizWsPartDef(partDefiniens : MizWsDefExpr, guard : MizWsFormula);

	MizWsDefiniens ::= MizWsSimpleDefiniens, MizWsConditionalDefiniens;
		MizWsSimpleDefiniens(pos : MizPos, lab : MizWsMaybeLabel, expr : MizWsDefExpr);
		MizWsConditionalDefiniens(pos : MizPos, lab : MizWsMaybeLabel,
			partials : [MizWsPartDef], otherwise : Maybe<MizWsDefExpr>);

	MizWsSchemeSegment ::= MizWsPredicateSegment, MizWsFunctorSegment;
		MizWsPredicateSegment(pos : MizPos, vars : [MizWsVariable], typeExpList : [MizWsType]);
		MizWsFunctorSegment(pos : MizPos, vars : [MizWsVariable], typeExpList : [MizWsType],
			specification : MizWsType);

	MizWsScheme(idNr : int, pos : MizPos, params : [MizWsSchemeSegment],
		premises : [MizWsProposition], conclusion : MizWsFormula);

	MizWsFieldSymbol(pos : MizPos, symbol : int);
	MizWsFieldSegment(pos : MizPos, fields : [MizWsFieldSymbol], specification : MizWsType);

	MizWsTypeChange(kind : int, var_ : MizWsVariable, term : Maybe<MizWsTerm>);  // 0 Equating, 1 VariableIdentifier

	MizWsIterativeStep(pos : MizPos, term : MizWsTerm, justification : MizWsJustification);

	MizWsLociEquality(pos : MizPos, left : MizWsLocus, right : MizWsLocus);

	// RegularStatementKind: 0 diffuse, 1 compact, 2 iterative equality
	MizWsStatement ::= MizWsDiffuseStatement, MizWsCompactStatement, MizWsIterativeEquality;
		MizWsDiffuseStatement(lab : MizWsMaybeLabel);
		MizWsCompactStatement(prop : MizWsProposition, justification : MizWsJustification);
		MizWsIterativeEquality(prop : MizWsProposition, justification : MizWsJustification,
			steps : [MizWsIterativeStep]);

	// AssumptionKind: 0 single, 1 collective, 2 existential
	MizWsAssumption ::= MizWsSingleAssumption, MizWsCollectiveAssumption;
		MizWsSingleAssumption(pos : MizPos, prop : MizWsProposition);
		MizWsCollectiveAssumption(pos : MizPos, conditions : [MizWsProposition]);

	// ---- item contents ----
	MizWsContent ::= MizWsNoContent, MizWsSchemeContent, MizWsReservationSegment,
		MizWsStatementContent, MizWsChoiceStatement, MizWsTypeChangingStatement,
		MizWsPrivFuncDefinition, MizWsPrivPredDefinition, MizWsConstantDefinition,
		MizWsSegmentContent, MizWsAssumptionContent, MizWsExistentialAssumption,
		MizWsExample, MizWsJustificationContent, MizWsCorrectnessCondition,
		MizWsCorrectnessConditions, MizWsPropertyContent, MizWsModeDefinition,
		MizWsAttrDefinition, MizWsPredDefinition, MizWsFuncDefinition,
		MizWsStructureDefinition, MizWsNotationDeclaration, MizWsCluster,
		MizWsIdentifyRegistration, MizWsPropertyRegistration, MizWsReduceRegistration,
		MizWsPragma;
		MizWsNoContent();
		MizWsSchemeContent(scheme : MizWsScheme);
		MizWsReservationSegment(idents : [MizWsVariable], resType : MizWsType);
		MizWsStatementContent(statement : MizWsStatement);
		MizWsChoiceStatement(qualVars : [MizWsSegment], conditions : [MizWsProposition],
			justification : MizWsJustification);
		MizWsTypeChangingStatement(changes : [MizWsTypeChange], typeExpr : MizWsType,
			justification : MizWsJustification);
		MizWsPrivFuncDefinition(funcId : MizWsVariable, typeExpList : [MizWsType], term : MizWsTerm);
		MizWsPrivPredDefinition(predId : MizWsVariable, typeExpList : [MizWsType], sentence : MizWsFormula);
		MizWsConstantDefinition(varId : MizWsVariable, term : MizWsTerm);
		MizWsSegmentContent(segment : MizWsSegment);
		MizWsAssumptionContent(assumption : MizWsAssumption);
		MizWsExistentialAssumption(qVars : [MizWsSegment], conditions : [MizWsProposition]);
		MizWsExample(varId : Maybe<MizWsVariable>, term : Maybe<MizWsTerm>);
		MizWsJustificationContent(justification : MizWsJustification);
		MizWsCorrectnessCondition(pos : MizPos, sort : int, justification : MizWsJustification);
		MizWsCorrectnessConditions(pos : MizPos, conditions : [int], justification : MizWsJustification);
		MizWsPropertyContent(pos : MizPos, sort : int, justification : MizWsJustification);
		// ModeDefinitionSort: 0 expandable, 1 standard
		MizWsModeDefinition(pos : MizPos, defKind : int, redefinition : bool,
			pattern : MizWsPattern, expansion : Maybe<MizWsType>,
			specification : Maybe<MizWsType>, definiens : Maybe<MizWsDefiniens>);
		MizWsAttrDefinition(pos : MizPos, redefinition : bool, pattern : MizWsPattern,
			definiens : Maybe<MizWsDefiniens>);
		MizWsPredDefinition(pos : MizPos, redefinition : bool, pattern : MizWsPattern,
			definiens : Maybe<MizWsDefiniens>);
		// HowToDefine: 0 empty, 1 means, 2 equals
		MizWsFuncDefinition(pos : MizPos, redefinition : bool, pattern : MizWsPattern,
			specification : Maybe<MizWsType>, definingWay : int, definiens : Maybe<MizWsDefiniens>);
		MizWsStructureDefinition(pos : MizPos, ancestors : [MizWsType],
			pattern : MizWsPattern, fields : [MizWsFieldSegment]);
		MizWsNotationDeclaration(pos : MizPos, sort : int, newPattern : MizWsPattern,
			originPattern : MizWsPattern);
		// ClusterRegistrationKind: 0 existential, 1 conditional, 2 functorial
		MizWsCluster(pos : MizPos, kind : int, antecedent : [MizWsAdjExpr],
			consequent : [MizWsAdjExpr], clusterType : Maybe<MizWsType>,
			clusterTerm : Maybe<MizWsTerm>);
		MizWsIdentifyRegistration(pos : MizPos, newPattern : MizWsPattern,
			originPattern : MizWsPattern, eqLoci : [MizWsLociEquality]);
		MizWsPropertyRegistration(pos : MizPos, sort : int, sethoodType : Maybe<MizWsType>,
			justification : Maybe<MizWsJustification>);
		MizWsReduceRegistration(pos : MizPos, originTerm : MizWsTerm, newTerm : MizWsTerm);
		MizWsPragma(str : string);

	// ---- the spine ----
	MizWsItem(
		kind : int,
		pos : MizPos,
		mutable endPos : MizPos,
		mutable content : MizWsContent,
		mutable block : Maybe<MizWsBlock>,
	);

	MizWsBlock(
		kind : int,
		// StartProperText re-sets the text proper's position at `begin`
		mutable pos : MizPos,
		mutable endPos : MizPos,
		items : Vector<MizWsItem>,
		// the text proper only
		articleId : string,
		articleExt : string,
	);

	mizWsNewBlock(kind : int, pos : MizPos) -> MizWsBlock;
	mizWsNewItem(kind : int, pos : MizPos) -> MizWsItem;
	mizWsTextProper(articleId : string, articleExt : string, pos : MizPos) -> MizWsBlock;

	// ---- name tables (wsmarticle.pas) ----
	mizBlockName : [string];
	mizItemName : [string];
	mizExpName : [string];
	mizSegmentKindName : [string];
	mizTypeName : [string];
	mizTermName : [string];
	mizFormulaName : [string];
	mizReferenceKindName : [string];
	mizInferenceName : [string];
	mizRegularStatementName : [string];
	mizClusterRegistrationName : [string];
	mizModeDefinitionSortName : [string];
	mizDefiningWayName : [string];
	mizDefiniensKindName : [string];
	mizFunctorPatternName : [string];
	mizAssumptionKindName : [string];
	mizSchemeSegmentName : [string];
	// mscanner.pas CorrectnessName / PropertyName
	mizCorrectnessName : [string];
	mizPropertyName : [string];

	// position accessors — the writer needs them without switching
	mizWsTypePos(t : MizWsType) -> MizPos;
	mizWsTermPos(t : MizWsTerm) -> MizPos;
	mizWsFormulaPos(f : MizWsFormula) -> MizPos;
	mizWsSegmentPos(s : MizWsSegment) -> MizPos;
	mizWsJustPos(j : MizWsJustification) -> MizPos;
	mizWsPatternPos(p : MizWsPattern) -> MizPos;
}

mizBlMain = 0;         mizBlDiffuse = 1;      mizBlHereby = 2;
mizBlProof = 3;        mizBlDefinition = 4;   mizBlNotation = 5;
mizBlRegistration = 6; mizBlCase = 7;         mizBlSuppose = 8;
mizBlPublicScheme = 9;

mizItIncorrItem = 0;           mizItDefinition = 1;
mizItSchemeBlock = 2;          mizItSchemeHead = 3;
mizItTheorem = 4;              mizItAxiom = 5;
mizItReservation = 6;          mizItCanceled = 7;
mizItSection = 8;              mizItRegularStatement = 9;
mizItChoice = 10;              mizItReconsider = 11;
mizItPrivFuncDefinition = 12;  mizItPrivPredDefinition = 13;
mizItConstantDefinition = 14;  mizItGeneralization = 15;
mizItLociDeclaration = 16;     mizItExistentialAssumption = 17;
mizItExemplification = 18;     mizItPerCases = 19;
mizItConclusion = 20;          mizItCaseBlock = 21;
mizItCaseHead = 22;            mizItSupposeHead = 23;
mizItAssumption = 24;          mizItCorrCond = 25;
mizItCorrectness = 26;         mizItProperty = 27;
mizItDefPred = 28;             mizItDefFunc = 29;
mizItDefMode = 30;             mizItDefAttr = 31;
mizItDefStruct = 32;           mizItPredSynonym = 33;
mizItPredAntonym = 34;         mizItFuncNotation = 35;
mizItModeNotation = 36;        mizItAttrSynonym = 37;
mizItAttrAntonym = 38;         mizItCluster = 39;
mizItIdentify = 40;            mizItReduction = 41;
mizItPropertyRegistration = 42; mizItPragma = 43;

mizExNull = 0;    mizExType = 1;     mizExTerm = 2;
mizExFormula = 3; mizExResType = 4;  mizExAdjectiveCluster = 5;

mizWsNewBlock(kind : int, pos : MizPos) -> MizWsBlock {
	MizWsBlock(kind, pos, pos, makeVector(8), "", "");
}

mizWsNewItem(kind : int, pos : MizPos) -> MizWsItem {
	MizWsItem(kind, pos, pos, MizWsNoContent(), None());
}

mizWsTextProper(articleId : string, articleExt : string, pos : MizPos) -> MizWsBlock {
	MizWsBlock(mizBlMain, pos, pos, makeVector(64), articleId, articleExt);
}

mizBlockName = [
	"Text-Proper", "Now-Reasoning", "Hereby-Reasoning", "Proof",
	"Definitional-Block", "Notation-Block", "Registration-Block",
	"Case", "Suppose", "Scheme-Block",
];

mizItemName = [
	"Incorrect-Item", "Definition-Item", "Scheme-Block-Item", "Scheme-Head",
	"Theorem-Item", "Axiom-Item", "Reservation", "canceled-pragmma",
	"Section-Pragma", "Regular-Statement", "Choice-Statement",
	"Type-Changing-Statement", "Private-Functor-Definition",
	"Private-Predicate-Definition", "Constant-Definition", "Generalization",
	"Loci-Declaration", "Existential-Assumption", "Exemplification",
	"Per-Cases", "Conclusion", "Case-Block", "Case-Head", "Suppose-Head",
	"Assumption", "Correctness-Condition", "Correctness", "Property",
	"Predicate-Definition", "Functor-Definition", "Mode-Definition",
	"Attribute-Definition", "Structure-Definition", "Pred-Synonym",
	"Pred-Antonym", "Func-Synonym", "Mode-Synonym", "Attr-Synonym",
	"Attr-Antonym", "Cluster", "Identify", "Reduction",
	"Property-Registration", "Pragma",
];

mizExpName = [
	"Null-Expression", "Type-Expression", "Term-Expression",
	"Formula-Expression", "Reservation-Type", "Adjective-Cluster",
];

mizSegmentKindName = ["Implicitly-Qualified-Segment", "Explicitly-Qualified-Segment"];

mizTypeName = ["Type-Error", "Standard-Type", "Struct-Type", "Clustered-Type",
	"ReservedDscr-Type"];

mizTermName = [
	"Term-Error", "Placeholder-Term", "Numeral-Term", "Simple-Term",
	"Private-Functor-Term", "Infix-Term", "Circumfix-Term", "Aggregate-Term",
	"Forgetful-Functor-Term", "Internal-Forgetful-Functor-Term",
	"Selector-Term", "Internal-Selector-Term", "Qualification-Term",
	"Global-Choice-Term", "Simple-Fraenkel-Term", "Fraenkel-Term", "it-Term",
	"Exactly-Qualification-Term",
];

mizFormulaName = [
	"Formula-Error", "Thesis", "Contradiction",
	"RightSideOf-Predicative-Formula", "Predicative-Formula",
	"Multi-Predicative-Formula", "Private-Predicate-Formula",
	"Attributive-Formula", "Qualifying-Formula",
	"Universal-Quantifier-Formula", "Existential-Quantifier-Formula",
	"Negated-Formula", "Conjunctive-Formula", "Disjunctive-Formula",
	"Conditional-Formula", "Biconditional-Formula",
	"FlexaryConjunctive-Formula", "FlexaryDisjunctive-Formula",
];

mizReferenceKindName = ["Local-Reference", "Theorem-Reference", "Definition-Reference"];

mizInferenceName = ["Inference-Error", "Straightforward-Justification",
	"Scheme-Justification", "Proof", "SkippedProof"];

mizRegularStatementName = ["Diffuse-Statement", "Compact-Statement", "Iterative-Equality"];

mizClusterRegistrationName = ["Existential-Registration", "Conditional-Registration",
	"Functorial-Registration"];

mizModeDefinitionSortName = ["Expandable-Mode", "Standard-Mode"];

mizDefiningWayName = ["No-Definiens", "Means", "Equals"];

mizDefiniensKindName = ["Simple-Definiens", "Conditional-Definiens"];

mizFunctorPatternName = ["Operation-Functor-Pattern", "Bracket-Functor-Pattern"];

mizAssumptionKindName = ["Single-Assumption", "Collective-Assumption",
	"Existential-Assumption"];

mizSchemeSegmentName = ["Predicate-Segment", "Functor-Segment"];

mizCorrectnessName = ["correctness", "coherence", "compatibility", "consistency",
	"existence", "uniqueness", "reducibility"];

mizPropertyName = ["", "symmetry", "reflexivity", "irreflexivity", "associativity",
	"transitivity", "commutativity", "connectedness", "asymmetry", "idempotence",
	"involutiveness", "projectivity", "sethood", "abstractness"];

mizWsTypePos(t : MizWsType) -> MizPos {
	switch (t) {
		MizWsErrorType(p): p;
		MizWsStandardType(p, __, __): p;
		MizWsStructType(p, __, __): p;
		MizWsClusteredType(p, __, __): p;
		MizWsReservedDscrType(p): p;
	}
}

mizWsTermPos(t : MizWsTerm) -> MizPos {
	switch (t) {
		MizWsErrorTerm(p): p;
		MizWsPlaceholderTerm(p, __): p;
		MizWsNumeralTerm(p, __): p;
		MizWsSimpleTerm(p, __): p;
		MizWsPrivateFunctorTerm(p, __, __): p;
		MizWsInfixTerm(p, __, __, __): p;
		MizWsCircumfixTerm(p, __, __, __): p;
		MizWsAggregateTerm(p, __, __): p;
		MizWsForgetfulFunctorTerm(p, __, __): p;
		MizWsInternalForgetfulFunctorTerm(p, __): p;
		MizWsSelectorTerm(p, __, __): p;
		MizWsInternalSelectorTerm(p, __): p;
		MizWsQualificationTerm(p, __, __): p;
		MizWsExactlyTerm(p, __): p;
		MizWsGlobalChoiceTerm(p, __): p;
		MizWsSimpleFraenkelTerm(p, __, __): p;
		MizWsFraenkelTerm(p, __, __, __): p;
		MizWsItTerm(p): p;
	}
}

mizWsFormulaPos(f : MizWsFormula) -> MizPos {
	switch (f) {
		MizWsErrorFormula(p): p;
		MizWsThesis(p): p;
		MizWsContradiction(p): p;
		MizWsRightSideOfPredicativeFormula(p, __, __): p;
		MizWsPredicativeFormula(p, __, __, __): p;
		MizWsMultiPredicativeFormula(p, __): p;
		MizWsPrivatePredicateFormula(p, __, __): p;
		MizWsAttributiveFormula(p, __, __): p;
		MizWsQualifyingFormula(p, __, __): p;
		MizWsUniversalFormula(p, __, __): p;
		MizWsExistentialFormula(p, __, __): p;
		MizWsNegatedFormula(p, __): p;
		MizWsConjunctiveFormula(p, __, __): p;
		MizWsDisjunctiveFormula(p, __, __): p;
		MizWsConditionalFormula(p, __, __): p;
		MizWsBiconditionalFormula(p, __, __): p;
		MizWsFlexaryConjunctiveFormula(p, __, __): p;
		MizWsFlexaryDisjunctiveFormula(p, __, __): p;
	}
}

mizWsSegmentPos(s : MizWsSegment) -> MizPos {
	switch (s) {
		MizWsImplSegment(p, __): p;
		MizWsExplSegment(p, __, __): p;
	}
}

mizWsJustPos(j : MizWsJustification) -> MizPos {
	switch (j) {
		MizWsInfError(p): p;
		MizWsStraightforward(p, __, __, __): p;
		MizWsSchemeJust(p, __, __, __, __): p;
		MizWsProofJust(p): p;
		MizWsSkippedProof(p): p;
	}
}

mizWsPatternPos(p : MizWsPattern) -> MizPos {
	switch (p) {
		MizWsPredPattern(q, __, __, __): q;
		MizWsInfixFunctorPattern(q, __, __, __): q;
		MizWsCircumfixFunctorPattern(q, __, __, __): q;
		MizWsModePattern(q, __, __): q;
		MizWsAttrPattern(q, __, __, __): q;
	}
}
