// Transcription of ~/dev/system/base/syntax.pas (the block/item/expression
// KINDS) and base/abstract_syntax.pas + the AST half of base/wsmarticle.pas —
// the Weakly Strict Mizar syntax tree the parser builds and writes as `.wsx`.
//
// The tree has three layers, exactly as the Pascal has:
//   * EXPRESSIONS   types, terms, formulas, adjectives, variable segments
//                   (abstract_syntax.pas). Immutable here — the parser builds
//                   them bottom up and never rewrites one.
//   * ITEM CONTENTS one record per ItemKind (wsmarticle.pas), collected in
//                   MizWsContent.
//   * BLOCKS/ITEMS  wsBlock / wsItem, the spine. These ARE mutable: an item
//                   is created when its first token is read and its content,
//                   its block and its end position arrive later.
//
// Kinds stay INTEGERS with the same ordinal as the Pascal enum, because the
// name tables below are indexed by that ordinal and the `.wsx` records the
// name. Never renumber.

import ds/vector;
import mizar/original/errhan;

export {
	// ---- syntax.pas BlockKind ----
	mizBlMain : int;         mizBlDiffuse : int;      mizBlHereby : int;
	mizBlProof : int;        mizBlDefinition : int;   mizBlNotation : int;
	mizBlRegistration : int; mizBlCase : int;         mizBlSuppose : int;
	mizBlPublicScheme : int;

	// ---- syntax.pas ItemKind ----
	mizItIncorrItem : int;          mizItDefinition : int;
	mizItSchemeBlock : int;         mizItSchemeHead : int;
	mizItTheorem : int;             mizItAxiom : int;
	mizItReservation : int;         mizItCanceled : int;
	mizItSection : int;             mizItRegularStatement : int;
	mizItChoice : int;              mizItReconsider : int;
	mizItPrivFuncDefinition : int;  mizItPrivPredDefinition : int;
	mizItConstantDefinition : int;  mizItGeneralization : int;
	mizItLociDeclaration : int;     mizItExistentialAssumption : int;
	mizItExemplification : int;     mizItPerCases : int;
	mizItConclusion : int;          mizItCaseBlock : int;
	mizItCaseHead : int;            mizItSupposeHead : int;
	mizItAssumption : int;          mizItCorrCond : int;
	mizItCorrectness : int;         mizItProperty : int;
	mizItDefPred : int;             mizItDefFunc : int;
	mizItDefMode : int;             mizItDefAttr : int;
	mizItDefStruct : int;           mizItPredSynonym : int;
	mizItPredAntonym : int;         mizItFuncNotation : int;
	mizItModeNotation : int;        mizItAttrSynonym : int;
	mizItAttrAntonym : int;         mizItCluster : int;
	mizItIdentify : int;            mizItReduction : int;
	mizItPropertyRegistration : int; mizItPragma : int;

	// ---- syntax.pas ExpKind ----
	mizExNull : int;    mizExType : int;     mizExTerm : int;
	mizExFormula : int; mizExResType : int;  mizExAdjectiveCluster : int;

	// Int2PairOfInt (mobjects.pas 518) — one entry of a resSubst map
	MizIntTriple(x : int, mutable y1 : int, mutable y2 : int);

	// VariableKind (first_identification.pas 54)
	mizVkFreeVar : int;   mizVkReservedVar : int;  mizVkBound : int;
	mizVkConstant : int;  mizVkDefConstant : int;  mizVkSchematicFunc : int;
	mizVkPrivateFunc : int; mizVkSchematicPred : int; mizVkPrivatePred : int;
	mizVariableKindName : [string];

	// ---- expressions (abstract_syntax.pas) ----
	MizWsVariable(mutable pos : MizPos, mutable ident : int,
		// MSVariableObj (first_identification.pas 60) — filled by the MSM pass
		mutable origin : int, mutable varKind : int,
		mutable serialNr : int, mutable varNr : int);

	MizWsType ::= MizWsErrorType, MizWsStandardType, MizWsStructType,
		MizWsClusteredType, MizWsReservedDscrType;
		MizWsErrorType(mutable pos : MizPos);
		MizWsStandardType(mutable pos : MizPos, mutable modeSymbol : int, mutable args : [MizWsTerm]);
		MizWsStructType(mutable pos : MizPos, mutable structSymbol : int, mutable args : [MizWsTerm]);
		MizWsClusteredType(mutable pos : MizPos, mutable cluster : [MizWsAdjExpr], mutable typ : MizWsType);
		// MSReservedDscrTypeObj — created by the MSM pass only. resSubst is an
		// Int2PairOfIntFunc: a SORTED, deduped map x -> (y1, y2).
		MizWsReservedDscrType(mutable pos : MizPos, mutable ident : int,
			mutable resTypeNr : int, resSubst : Vector<MizIntTriple>);

	MizWsTerm ::= MizWsErrorTerm, MizWsPlaceholderTerm, MizWsNumeralTerm,
		MizWsSimpleTerm, MizWsPrivateFunctorTerm, MizWsInfixTerm,
		MizWsCircumfixTerm, MizWsAggregateTerm, MizWsForgetfulFunctorTerm,
		MizWsInternalForgetfulFunctorTerm, MizWsSelectorTerm,
		MizWsInternalSelectorTerm, MizWsQualificationTerm, MizWsExactlyTerm,
		MizWsGlobalChoiceTerm, MizWsSimpleFraenkelTerm, MizWsFraenkelTerm,
		MizWsItTerm;
		MizWsErrorTerm(mutable pos : MizPos);
		MizWsPlaceholderTerm(mutable pos : MizPos, mutable locusNr : int);
		MizWsNumeralTerm(mutable pos : MizPos, mutable value : int);
		MizWsSimpleTerm(mutable pos : MizPos, mutable ident : int,
			// MSSimpleTermObj
			mutable origin : int, mutable varKind : int,
			mutable serialNr : int, mutable varNr : int);
		MizWsPrivateFunctorTerm(mutable pos : MizPos, mutable functorIdent : int,
			mutable args : [MizWsTerm],
			// MSPrivateFunctorTermObj
			mutable funcKind : int, mutable serialNr : int, mutable funcNr : int);
		MizWsInfixTerm(mutable pos : MizPos, mutable functorSymbol : int, mutable leftArgs : [MizWsTerm], mutable rightArgs : [MizWsTerm]);
		MizWsCircumfixTerm(mutable pos : MizPos, mutable leftBracket : int, mutable rightBracket : int, mutable args : [MizWsTerm]);
		MizWsAggregateTerm(mutable pos : MizPos, mutable structSymbol : int, mutable args : [MizWsTerm]);
		MizWsForgetfulFunctorTerm(mutable pos : MizPos, mutable structSymbol : int, mutable arg : MizWsTerm);
		MizWsInternalForgetfulFunctorTerm(mutable pos : MizPos, mutable structSymbol : int);
		MizWsSelectorTerm(mutable pos : MizPos, mutable selectorSymbol : int, mutable arg : MizWsTerm);
		MizWsInternalSelectorTerm(mutable pos : MizPos, mutable selectorSymbol : int,
			mutable varNr : int);   // MSInternalSelectorTermObj
		MizWsQualificationTerm(mutable pos : MizPos, mutable subject : MizWsTerm, mutable qualification : MizWsType);
		MizWsExactlyTerm(mutable pos : MizPos, mutable subject : MizWsTerm);
		MizWsGlobalChoiceTerm(mutable pos : MizPos, mutable choiceType : MizWsType);
		MizWsSimpleFraenkelTerm(mutable pos : MizPos, mutable postqual : [MizWsSegment], mutable sample : MizWsTerm);
		MizWsFraenkelTerm(mutable pos : MizPos, mutable postqual : [MizWsSegment], mutable sample : MizWsTerm, mutable formula : MizWsFormula);
		MizWsItTerm(mutable pos : MizPos);

	MizWsAdjExpr ::= MizWsAdjective, MizWsNegatedAdjective;
		MizWsAdjective(mutable pos : MizPos, mutable symbol : int, mutable negated : bool, mutable args : [MizWsTerm]);
		MizWsNegatedAdjective(mutable pos : MizPos, mutable arg : MizWsAdjExpr);

	MizWsSegment ::= MizWsImplSegment, MizWsExplSegment;
		MizWsImplSegment(mutable pos : MizPos, mutable ident : MizWsVariable,
			// MSImplicitlyQualifiedSegmentObj
			mutable resType : Maybe<MizWsReservedDscrType>);
		MizWsExplSegment(mutable pos : MizPos, mutable idents : [MizWsVariable], mutable typ : MizWsType);

	MizWsFormula ::= MizWsErrorFormula, MizWsThesis, MizWsContradiction,
		MizWsRightSideOfPredicativeFormula, MizWsPredicativeFormula,
		MizWsMultiPredicativeFormula, MizWsPrivatePredicateFormula,
		MizWsAttributiveFormula, MizWsQualifyingFormula, MizWsUniversalFormula,
		MizWsExistentialFormula, MizWsNegatedFormula, MizWsConjunctiveFormula,
		MizWsDisjunctiveFormula, MizWsConditionalFormula,
		MizWsBiconditionalFormula, MizWsFlexaryConjunctiveFormula,
		MizWsFlexaryDisjunctiveFormula;
		MizWsErrorFormula(mutable pos : MizPos);
		MizWsThesis(mutable pos : MizPos);
		MizWsContradiction(mutable pos : MizPos);
		MizWsRightSideOfPredicativeFormula(mutable pos : MizPos, mutable predNr : int, mutable rightArgs : [MizWsTerm]);
		MizWsPredicativeFormula(mutable pos : MizPos, mutable predNr : int, mutable leftArgs : [MizWsTerm], mutable rightArgs : [MizWsTerm]);
		MizWsMultiPredicativeFormula(mutable pos : MizPos, mutable scraps : [MizWsFormula]);
		MizWsPrivatePredicateFormula(mutable pos : MizPos, mutable predIdNr : int,
			mutable args : [MizWsTerm],
			// MSPrivatePredicativeFormulaObj
			mutable predKind : int, mutable serialNr : int, mutable predNr : int);
		MizWsAttributiveFormula(mutable pos : MizPos, mutable subject : MizWsTerm, mutable adjectives : [MizWsAdjExpr]);
		MizWsQualifyingFormula(mutable pos : MizPos, mutable subject : MizWsTerm, mutable typ : MizWsType);
		MizWsUniversalFormula(mutable pos : MizPos, mutable segment : MizWsSegment, mutable scope : MizWsFormula);
		MizWsExistentialFormula(mutable pos : MizPos, mutable segment : MizWsSegment, mutable scope : MizWsFormula);
		MizWsNegatedFormula(mutable pos : MizPos, mutable arg : MizWsFormula);
		MizWsConjunctiveFormula(mutable pos : MizPos, mutable left : MizWsFormula, mutable right : MizWsFormula);
		MizWsDisjunctiveFormula(mutable pos : MizPos, mutable left : MizWsFormula, mutable right : MizWsFormula);
		MizWsConditionalFormula(mutable pos : MizPos, mutable left : MizWsFormula, mutable right : MizWsFormula);
		MizWsBiconditionalFormula(mutable pos : MizPos, mutable left : MizWsFormula, mutable right : MizWsFormula);
		MizWsFlexaryConjunctiveFormula(mutable pos : MizPos, mutable left : MizWsFormula, mutable right : MizWsFormula);
		MizWsFlexaryDisjunctiveFormula(mutable pos : MizPos, mutable left : MizWsFormula, mutable right : MizWsFormula);

	// ---- item pieces (wsmarticle.pas) ----
	MizWsLabel(mutable idNr : int, mutable pos : MizPos,
		mutable serialNr : int, mutable labelNr : int);   // MSLabelObj
	// LabelPtr may be nil; MizWsNoLabel stands for that.
	MizWsMaybeLabel ::= MizWsLabel, MizWsNoLabel;
		MizWsNoLabel();

	MizWsProposition(mutable lab : MizWsMaybeLabel, mutable sentence : MizWsFormula, mutable sntPos : MizPos);

	// ReferenceKind ordinals: 0 local, 1 theorem, 2 definition
	MizWsReference ::= MizWsLocalRef, MizWsTheoremRef, MizWsDefinitionRef;
		MizWsLocalRef(mutable pos : MizPos, mutable labId : int,
			mutable refNr : int, mutable labNr : int);   // MSLocalReferenceObj
		MizWsTheoremRef(mutable pos : MizPos, mutable articleNr : int, mutable theoNr : int);
		MizWsDefinitionRef(mutable pos : MizPos, mutable articleNr : int, mutable defNr : int);

	// InferenceKind ordinals: 0 error, 1 straightforward, 2 scheme, 3 proof,
	// 4 skipped proof
	MizWsJustification ::= MizWsInfError, MizWsStraightforward, MizWsSchemeJust,
		MizWsProofJust, MizWsSkippedProof;
		MizWsInfError(mutable pos : MizPos);
		MizWsStraightforward(mutable pos : MizPos, mutable refs : [MizWsReference],
			mutable linked : bool, mutable linkPos : MizPos,
			mutable labelNr : int);   // MSStraightforwardJustificationObj
		MizWsSchemeJust(mutable pos : MizPos, mutable refs : [MizWsReference],
			mutable schFileNr : int, mutable schemeIdNr : int,
			mutable schemeInfPos : MizPos,
			mutable schemeNr : int);   // MSSchemeJustificationObj
		MizWsProofJust(mutable pos : MizPos);
		MizWsSkippedProof(mutable pos : MizPos);

	MizWsLocus(mutable pos : MizPos, mutable varId : int,
		// MSLocusObj
		mutable origin : int, mutable varKind : int,
		mutable serialNr : int, mutable varNr : int);

	MizWsPattern ::= MizWsPredPattern, MizWsInfixFunctorPattern,
		MizWsCircumfixFunctorPattern, MizWsModePattern, MizWsAttrPattern;
		MizWsPredPattern(mutable pos : MizPos, mutable symbol : int, mutable leftArgs : [MizWsLocus], mutable rightArgs : [MizWsLocus]);
		MizWsInfixFunctorPattern(mutable pos : MizPos, mutable symbol : int, mutable leftArgs : [MizWsLocus], mutable rightArgs : [MizWsLocus]);
		MizWsCircumfixFunctorPattern(mutable pos : MizPos, mutable leftBracket : int, mutable rightBracket : int, mutable args : [MizWsLocus]);
		MizWsModePattern(mutable pos : MizPos, mutable symbol : int, mutable args : [MizWsLocus]);
		MizWsAttrPattern(mutable pos : MizPos, mutable symbol : int, mutable arg : MizWsLocus, mutable args : [MizWsLocus]);

	// DefExpressionObj: an expression tagged with its ExpKind
	MizWsDefExpr(mutable exprKind : int, mutable term : Maybe<MizWsTerm>, mutable formula : Maybe<MizWsFormula>);

	MizWsPartDef(mutable partDefiniens : MizWsDefExpr, mutable guard : MizWsFormula);

	MizWsDefiniens ::= MizWsSimpleDefiniens, MizWsConditionalDefiniens;
		MizWsSimpleDefiniens(mutable pos : MizPos, mutable lab : MizWsMaybeLabel, mutable expr : MizWsDefExpr);
		MizWsConditionalDefiniens(mutable pos : MizPos, mutable lab : MizWsMaybeLabel, mutable partials : [MizWsPartDef], mutable otherwise : Maybe<MizWsDefExpr>);

	MizWsSchemeSegment ::= MizWsPredicateSegment, MizWsFunctorSegment;
		MizWsPredicateSegment(mutable pos : MizPos, mutable vars : [MizWsVariable], mutable typeExpList : [MizWsType]);
		MizWsFunctorSegment(mutable pos : MizPos, mutable vars : [MizWsVariable], mutable typeExpList : [MizWsType], mutable specification : MizWsType);

	MizWsScheme(mutable idNr : int, mutable pos : MizPos,
		mutable params : [MizWsSchemeSegment], mutable premises : [MizWsProposition],
		mutable conclusion : MizWsFormula,
		mutable schemeNr : int);   // MSSchemeObj

	MizWsFieldSymbol(mutable pos : MizPos, mutable symbol : int);
	MizWsFieldSegment(mutable pos : MizPos, mutable fields : [MizWsFieldSymbol], mutable specification : MizWsType);

	MizWsTypeChange(mutable kind : int, mutable var_ : MizWsVariable, mutable term : Maybe<MizWsTerm>);  // 0 Equating, 1 VariableIdentifier

	MizWsIterativeStep(mutable pos : MizPos, mutable term : MizWsTerm, mutable justification : MizWsJustification);

	MizWsLociEquality(mutable pos : MizPos, mutable left : MizWsLocus, mutable right : MizWsLocus);

	// RegularStatementKind: 0 diffuse, 1 compact, 2 iterative equality
	MizWsStatement ::= MizWsDiffuseStatement, MizWsCompactStatement, MizWsIterativeEquality;
		MizWsDiffuseStatement(mutable lab : MizWsMaybeLabel);
		MizWsCompactStatement(mutable prop : MizWsProposition, mutable justification : MizWsJustification);
		MizWsIterativeEquality(mutable prop : MizWsProposition, mutable justification : MizWsJustification, mutable steps : [MizWsIterativeStep]);

	// AssumptionKind: 0 single, 1 collective, 2 existential
	MizWsAssumption ::= MizWsSingleAssumption, MizWsCollectiveAssumption;
		MizWsSingleAssumption(mutable pos : MizPos, mutable prop : MizWsProposition);
		MizWsCollectiveAssumption(mutable pos : MizPos, mutable conditions : [MizWsProposition]);

	// ---- item contents ----
	MizWsContent ::= MizWsNoContent, MizWsSchemeContent, MizWsReservationSegment,
		MizWsStatementContent, MizWsChoiceStatement, MizWsTypeChangingStatement,
		MizWsPrivFuncDefinition, MizWsPrivPredDefinition, MizWsConstantDefinition,
		MizWsSegmentContent, MizWsAssumptionContent, MizWsExistentialAssumption,
		MizWsExample, MizWsJustificationContent, MizWsCorrectnessCondition,
		MizWsCorrectnessConditions, MizWsPropertyContent, MizWsModeDefinition,
		MizWsAttrDefinition, MizWsPredDefinition, MizWsFuncDefinition,
		MizWsStructureDefinition, MizWsNotationDeclaration, MizWsCluster,
		MizWsIdentifyRegistration, MizWsPropertyRegistration, MizWsReduceRegistration,
		MizWsPragma;
		MizWsNoContent();
		MizWsSchemeContent(mutable scheme : MizWsScheme);
		MizWsReservationSegment(mutable idents : [MizWsVariable], mutable resType : MizWsType,
			// MSReservationSegmentObj
			mutable resVars : [int], mutable freeVars : [MizWsType]);
		MizWsStatementContent(mutable statement : MizWsStatement);
		MizWsChoiceStatement(mutable qualVars : [MizWsSegment], mutable conditions : [MizWsProposition], mutable justification : MizWsJustification);
		MizWsTypeChangingStatement(mutable changes : [MizWsTypeChange], mutable typeExpr : MizWsType, mutable justification : MizWsJustification);
		MizWsPrivFuncDefinition(mutable funcId : MizWsVariable, mutable typeExpList : [MizWsType], mutable term : MizWsTerm);
		MizWsPrivPredDefinition(mutable predId : MizWsVariable, mutable typeExpList : [MizWsType], mutable sentence : MizWsFormula);
		MizWsConstantDefinition(mutable varId : MizWsVariable, mutable term : MizWsTerm);
		MizWsSegmentContent(mutable segment : MizWsSegment);
		MizWsAssumptionContent(mutable assumption : MizWsAssumption);
		MizWsExistentialAssumption(mutable qVars : [MizWsSegment], mutable conditions : [MizWsProposition]);
		MizWsExample(mutable varId : Maybe<MizWsVariable>, mutable term : Maybe<MizWsTerm>);
		MizWsJustificationContent(mutable justification : MizWsJustification);
		MizWsCorrectnessCondition(mutable pos : MizPos, mutable sort : int, mutable justification : MizWsJustification);
		MizWsCorrectnessConditions(mutable pos : MizPos, mutable conditions : [int], mutable justification : MizWsJustification);
		MizWsPropertyContent(mutable pos : MizPos, mutable sort : int, mutable justification : MizWsJustification);
		// ModeDefinitionSort: 0 expandable, 1 standard
		MizWsModeDefinition(mutable pos : MizPos, mutable defKind : int, mutable redefinition : bool, mutable pattern : MizWsPattern, mutable expansion : Maybe<MizWsType>, mutable specification : Maybe<MizWsType>, mutable definiens : Maybe<MizWsDefiniens>);
		MizWsAttrDefinition(mutable pos : MizPos, mutable redefinition : bool, mutable pattern : MizWsPattern, mutable definiens : Maybe<MizWsDefiniens>);
		MizWsPredDefinition(mutable pos : MizPos, mutable redefinition : bool, mutable pattern : MizWsPattern, mutable definiens : Maybe<MizWsDefiniens>);
		// HowToDefine: 0 empty, 1 means, 2 equals
		MizWsFuncDefinition(mutable pos : MizPos, mutable redefinition : bool, mutable pattern : MizWsPattern, mutable specification : Maybe<MizWsType>, mutable definingWay : int, mutable definiens : Maybe<MizWsDefiniens>);
		MizWsStructureDefinition(mutable pos : MizPos, mutable ancestors : [MizWsType], mutable pattern : MizWsPattern, mutable fields : [MizWsFieldSegment]);
		MizWsNotationDeclaration(mutable pos : MizPos, mutable sort : int, mutable newPattern : MizWsPattern, mutable originPattern : MizWsPattern);
		// ClusterRegistrationKind: 0 existential, 1 conditional, 2 functorial
		MizWsCluster(mutable pos : MizPos, mutable kind : int, mutable antecedent : [MizWsAdjExpr], mutable consequent : [MizWsAdjExpr], mutable clusterType : Maybe<MizWsType>, mutable clusterTerm : Maybe<MizWsTerm>);
		MizWsIdentifyRegistration(mutable pos : MizPos, mutable newPattern : MizWsPattern, mutable originPattern : MizWsPattern, mutable eqLoci : [MizWsLociEquality]);
		MizWsPropertyRegistration(mutable pos : MizPos, mutable sort : int, mutable sethoodType : Maybe<MizWsType>, mutable justification : Maybe<MizWsJustification>);
		MizWsReduceRegistration(mutable pos : MizPos, mutable originTerm : MizWsTerm, mutable newTerm : MizWsTerm);
		MizWsPragma(mutable str : string);

	// ---- the spine ----
	MizWsItem(
		kind : int,
		pos : MizPos,
		mutable endPos : MizPos,
		mutable content : MizWsContent,
		mutable block : Maybe<MizWsBlock>,
	);

	MizWsBlock(
		kind : int,
		// StartProperText re-sets the text proper's position at `begin`
		mutable pos : MizPos,
		mutable endPos : MizPos,
		items : Vector<MizWsItem>,
		// the text proper only
		articleId : string,
		articleExt : string,
	);

	// The parser builds nodes with the MSM annotations left at zero — the
	// Pascal constructors of the WSM classes do the same and the MSM pass
	// fills them in.
	mizWsMakeVariable(pos : MizPos, ident : int) -> MizWsVariable;
	mizWsMakeLocus(pos : MizPos, varId : int) -> MizWsLocus;
	mizWsMakeSimpleTerm(pos : MizPos, ident : int) -> MizWsSimpleTerm;
	mizWsMakeLabel(idNr : int, pos : MizPos) -> MizWsLabel;
	mizWsMakeLocalRef(pos : MizPos, labId : int) -> MizWsLocalRef;
	mizWsMakePrivFuncTerm(pos : MizPos, id : int, args : [MizWsTerm]) -> MizWsPrivateFunctorTerm;
	mizWsMakePrivPredFormula(pos : MizPos, id : int, args : [MizWsTerm]) -> MizWsPrivatePredicateFormula;
	mizWsMakeInternalSelectorTerm(pos : MizPos, sym : int) -> MizWsInternalSelectorTerm;
	mizWsMakeImplSegment(pos : MizPos, ident : MizWsVariable) -> MizWsImplSegment;
	mizWsMakeScheme(idNr : int, pos : MizPos, params : [MizWsSchemeSegment],
		premises : [MizWsProposition], conclusion : MizWsFormula) -> MizWsScheme;
	mizWsMakeReservationSegment(idents : [MizWsVariable], resType : MizWsType) -> MizWsReservationSegment;
	mizWsMakeStraightforward(pos : MizPos, refs : [MizWsReference], linked : bool,
		linkPos : MizPos) -> MizWsStraightforward;
	mizWsMakeSchemeJust(pos : MizPos, refs : [MizWsReference], schFileNr : int,
		schemeIdNr : int, schemeInfPos : MizPos) -> MizWsSchemeJust;

	mizWsNewBlock(kind : int, pos : MizPos) -> MizWsBlock;
	mizWsNewItem(kind : int, pos : MizPos) -> MizWsItem;
	mizWsTextProper(articleId : string, articleExt : string, pos : MizPos) -> MizWsBlock;

	// ---- name tables (wsmarticle.pas) ----
	mizBlockName : [string];
	mizItemName : [string];
	mizExpName : [string];
	mizSegmentKindName : [string];
	mizTypeName : [string];
	mizTermName : [string];
	mizFormulaName : [string];
	mizReferenceKindName : [string];
	mizInferenceName : [string];
	mizRegularStatementName : [string];
	mizClusterRegistrationName : [string];
	mizModeDefinitionSortName : [string];
	mizDefiningWayName : [string];
	mizDefiniensKindName : [string];
	mizFunctorPatternName : [string];
	mizAssumptionKindName : [string];
	mizSchemeSegmentName : [string];
	// mscanner.pas CorrectnessName / PropertyName
	mizCorrectnessName : [string];
	mizPropertyName : [string];

	// position accessors — the writer needs them without switching
	mizWsTypePos(t : MizWsType) -> MizPos;
	mizWsTermPos(t : MizWsTerm) -> MizPos;
	mizWsFormulaPos(f : MizWsFormula) -> MizPos;
	mizWsSegmentPos(s : MizWsSegment) -> MizPos;
	mizWsJustPos(j : MizWsJustification) -> MizPos;
	mizWsPatternPos(p : MizWsPattern) -> MizPos;
}

mizBlMain = 0;         mizBlDiffuse = 1;      mizBlHereby = 2;
mizBlProof = 3;        mizBlDefinition = 4;   mizBlNotation = 5;
mizBlRegistration = 6; mizBlCase = 7;         mizBlSuppose = 8;
mizBlPublicScheme = 9;

mizItIncorrItem = 0;           mizItDefinition = 1;
mizItSchemeBlock = 2;          mizItSchemeHead = 3;
mizItTheorem = 4;              mizItAxiom = 5;
mizItReservation = 6;          mizItCanceled = 7;
mizItSection = 8;              mizItRegularStatement = 9;
mizItChoice = 10;              mizItReconsider = 11;
mizItPrivFuncDefinition = 12;  mizItPrivPredDefinition = 13;
mizItConstantDefinition = 14;  mizItGeneralization = 15;
mizItLociDeclaration = 16;     mizItExistentialAssumption = 17;
mizItExemplification = 18;     mizItPerCases = 19;
mizItConclusion = 20;          mizItCaseBlock = 21;
mizItCaseHead = 22;            mizItSupposeHead = 23;
mizItAssumption = 24;          mizItCorrCond = 25;
mizItCorrectness = 26;         mizItProperty = 27;
mizItDefPred = 28;             mizItDefFunc = 29;
mizItDefMode = 30;             mizItDefAttr = 31;
mizItDefStruct = 32;           mizItPredSynonym = 33;
mizItPredAntonym = 34;         mizItFuncNotation = 35;
mizItModeNotation = 36;        mizItAttrSynonym = 37;
mizItAttrAntonym = 38;         mizItCluster = 39;
mizItIdentify = 40;            mizItReduction = 41;
mizItPropertyRegistration = 42; mizItPragma = 43;

mizVkFreeVar = 0;   mizVkReservedVar = 1;  mizVkBound = 2;
mizVkConstant = 3;  mizVkDefConstant = 4;  mizVkSchematicFunc = 5;
mizVkPrivateFunc = 6; mizVkSchematicPred = 7; mizVkPrivatePred = 8;

mizVariableKindName = ["Free", "Reserved", "Bound", "Constant", "DefConstant",
	"SchemataFunc", "PrivateFunc", "SchemataPred", "PrivatePred"];

mizExNull = 0;    mizExType = 1;     mizExTerm = 2;
mizExFormula = 3; mizExResType = 4;  mizExAdjectiveCluster = 5;

mizWsMakeVariable(pos : MizPos, ident : int) -> MizWsVariable {
	MizWsVariable(pos, ident, 0, 0, 0, 0);
}
mizWsMakeLocus(pos : MizPos, varId : int) -> MizWsLocus {
	MizWsLocus(pos, varId, 0, 0, 0, 0);
}
mizWsMakeSimpleTerm(pos : MizPos, ident : int) -> MizWsSimpleTerm {
	MizWsSimpleTerm(pos, ident, 0, 0, 0, 0);
}
mizWsMakeLabel(idNr : int, pos : MizPos) -> MizWsLabel {
	MizWsLabel(idNr, pos, 0, 0);
}
mizWsMakeLocalRef(pos : MizPos, labId : int) -> MizWsLocalRef {
	MizWsLocalRef(pos, labId, 0, 0);
}
mizWsMakePrivFuncTerm(pos : MizPos, id : int, args : [MizWsTerm]) -> MizWsPrivateFunctorTerm {
	MizWsPrivateFunctorTerm(pos, id, args, 0, 0, 0);
}
mizWsMakePrivPredFormula(pos : MizPos, id : int, args : [MizWsTerm]) -> MizWsPrivatePredicateFormula {
	MizWsPrivatePredicateFormula(pos, id, args, 0, 0, 0);
}
mizWsMakeInternalSelectorTerm(pos : MizPos, sym : int) -> MizWsInternalSelectorTerm {
	MizWsInternalSelectorTerm(pos, sym, 0);
}
mizWsMakeImplSegment(pos : MizPos, ident : MizWsVariable) -> MizWsImplSegment {
	MizWsImplSegment(pos, ident, None());
}
mizWsMakeScheme(idNr : int, pos : MizPos, params : [MizWsSchemeSegment],
	premises : [MizWsProposition], conclusion : MizWsFormula) -> MizWsScheme {
	MizWsScheme(idNr, pos, params, premises, conclusion, 0);
}
mizWsMakeReservationSegment(idents : [MizWsVariable], resType : MizWsType) -> MizWsReservationSegment {
	MizWsReservationSegment(idents, resType, [], []);
}
mizWsMakeStraightforward(pos : MizPos, refs : [MizWsReference], linked : bool,
	linkPos : MizPos) -> MizWsStraightforward {
	MizWsStraightforward(pos, refs, linked, linkPos, 0);
}
mizWsMakeSchemeJust(pos : MizPos, refs : [MizWsReference], schFileNr : int,
	schemeIdNr : int, schemeInfPos : MizPos) -> MizWsSchemeJust {
	MizWsSchemeJust(pos, refs, schFileNr, schemeIdNr, schemeInfPos, 0);
}

mizWsNewBlock(kind : int, pos : MizPos) -> MizWsBlock {
	MizWsBlock(kind, pos, pos, makeVector(8), "", "");
}

mizWsNewItem(kind : int, pos : MizPos) -> MizWsItem {
	MizWsItem(kind, pos, pos, MizWsNoContent(), None());
}

mizWsTextProper(articleId : string, articleExt : string, pos : MizPos) -> MizWsBlock {
	MizWsBlock(mizBlMain, pos, pos, makeVector(64), articleId, articleExt);
}

