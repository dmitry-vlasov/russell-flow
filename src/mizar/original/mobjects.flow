// Transcription of ~/dev/system/base/mobjects.pas — the numeric collections the
// checker computes with. Only the types the verifier path uses are ported:
//
//   NatSet   — sorted set of ints, stored as (X, Y) pairs with Y ignored
//   NatFunc  — finite map int -> int, sorted by X, plus the `nConsistent` flag.
//              This is the ATOM of the unifier's substitution lattice: Assign
//              of a conflicting value REFUTES the whole function (consistent
//              becomes false), exactly as in the original.
//   IntSequence / IntSet — growable int list / sorted int set.
//
// Pascal inheritance NatFunc <- NatSet <- IntRel is flattened: ONE struct
// MizNatFunc serves both roles (NatSet use ignores `y` and `consistent`).
// Generic MCollection/MSortedCollection are NOT ported — each Pascal use site
// gets a typed Vector in its own unit (the virtual-method machinery of
// MObject exists only to emulate what Flow9 gives us directly).
//
// Growth semantics: the original grows by Delta and signals coOverflow when
// Delta = 0 or a cap is hit; Vector grows freely, and the caps that MATTER
// (MaxInstNbr in the InstCollection lattice) are enforced at their use sites
// with explicit checks, as the original does in prechecker.pas.

import ds/vector;
import loop;
import math/math;
import mizar/original/errhan;

export {
	MizIntPair(x : int, y : int);

	// NatSet / NatFunc. Sorted by x, no duplicate x (unless `duplicates`,
	// which the verifier path never sets — kept for fidelity).
	MizNatFunc(
		items : Vector<MizIntPair>,
		mutable consistent : bool,
	);

	mizInitNatFunc(capacity : int) -> MizNatFunc;     // NatFunc.InitNatFunc
	mizInitNatSet(capacity : int) -> MizNatFunc;      // NatSet.Init
	mizNatSetWithElement(x : int) -> MizNatFunc;      // NatSet.InitWithElement
	mizCopyNatFunc(f : MizNatFunc) -> MizNatFunc;     // CopyNatFunc / CopyNatSet

	mizNatCount(f : MizNatFunc) -> int;
	mizNatItem(f : MizNatFunc, i : int) -> MizIntPair;

	// function SearchPair(X, var Index) — binary search; returns the found flag,
	// the insertion index is mizNatSearchIndex.
	mizNatHasInDom(f : MizNatFunc, x : int) -> bool;  // HasInDom / SearchPair
	mizNatElemNr(f : MizNatFunc, x : int) -> int;     // ElemNr: index or -1
	mizNatValue(f : MizNatFunc, x : int) -> int;      // Value: aborts if absent

	mizNatInsertPair(f : MizNatFunc, x : int, y : int) -> void; // Insert (keeps first on dup x)
	mizNatInsertElem(f : MizNatFunc, x : int) -> void;          // InsertElem: (x, 0)
	mizNatDeleteElem(f : MizNatFunc, x : int) -> void;          // DeleteElem
	mizNatDeleteAll(f : MizNatFunc) -> void;                    // DeleteAll

	mizNatAssign(f : MizNatFunc, x : int, y : int) -> void;     // Assign: conflict => refuted
	mizNatUp(f : MizNatFunc, x : int) -> void;                  // Up: increment count
	mizNatDown(f : MizNatFunc, x : int) -> void;                // Down: decrement, drop at 0
	mizNatRefuted(f : MizNatFunc) -> void;                      // Refuted: clear + inconsistent
	mizNatJoin(f : MizNatFunc, g : MizNatFunc) -> void;         // Join: union, conflict => refuted
	mizNatJoinAtom(f : MizNatFunc, atom : MizNatFunc) -> Maybe<MizNatFunc>; // JoinAtom

	mizNatEnlargeBy(f : MizNatFunc, g : MizNatFunc) -> void;    // NatSet.EnlargeBy (set union)
	mizNatComplementOf(f : MizNatFunc, g : MizNatFunc) -> void; // remove g's domain
	mizNatIntersectWith(f : MizNatFunc, g : MizNatFunc) -> void;

	mizNatIsEqualTo(f : MizNatFunc, g : MizNatFunc) -> bool;
	mizNatIsSubsetOf(f : MizNatFunc, g : MizNatFunc) -> bool;   // pairs, (x,y) both match
	mizNatMisses(f : MizNatFunc, g : MizNatFunc) -> bool;       // disjoint domains
	mizNatWeakerThan(f : MizNatFunc, g : MizNatFunc) -> bool;   // f's graph included in g's
	mizNatCompareWith(f : MizNatFunc, g : MizNatFunc) -> int;   // -1 weaker / 1 stronger / 0
	mizNatCountAll(f : MizNatFunc) -> int;                      // sum of Y
	mizNatLCM(f : MizNatFunc, g : MizNatFunc) -> MizNatFunc;    // pointwise max

	// IntSequence / IntSet
	MizIntSeq(items : Vector<int>);

	mizInitIntSeq(capacity : int) -> MizIntSeq;
	mizCopyIntSeq(s : MizIntSeq) -> MizIntSeq;
	mizSeqCount(s : MizIntSeq) -> int;
	mizSeqValue(s : MizIntSeq, i : int) -> int;                 // Value(aIndex)
	mizSeqInsert(s : MizIntSeq, v : int) -> int;                // append, returns index
	mizSeqAtPut(s : MizIntSeq, i : int, v : int) -> void;
	mizSeqAtDelete(s : MizIntSeq, i : int) -> void;
	mizSeqIndexOf(s : MizIntSeq, v : int) -> int;               // linear, -1 if absent
	mizSeqClear(s : MizIntSeq) -> void;

	// IntSet: same struct, kept SORTED via these ops only.
	mizIntSetInsert(s : MizIntSeq, v : int) -> int;             // sorted insert, no dup; index
	mizIntSetIsInSet(s : MizIntSeq, v : int) -> bool;           // binary search
	mizIntSetDelete(s : MizIntSeq, v : int) -> int;             // index deleted or -1
	mizIntSetIsSubsetOf(s : MizIntSeq, t : MizIntSeq) -> bool;
	mizIntSetMisses(s : MizIntSeq, t : MizIntSeq) -> bool;

	// IntRel — a SORTED SET of (x, y) pairs, ordered LEXICOGRAPHICALLY by x then
	// y (IntRel.Search / IntRel.Insert, CompareIntPairs). Not the same order as
	// NatSet/NatFunc, which key on x alone. Insert is a no-op on a duplicate.
	// The verifier's lEqPendings and lSetting are IntRels, so the order they are
	// flushed in is the SORTED one, not the insertion one.
	mizCompareIntPairs(x1 : int, y1 : int, x2 : int, y2 : int) -> int;
	mizIntRelSearch(v : Vector<MizIntPair>, x : int, y : int) -> Pair<bool, int>;
	mizIntRelInsert(v : Vector<MizIntPair>, x : int, y : int) -> void;
	mizIntRelIsMember(v : Vector<MizIntPair>, x : int, y : int) -> bool;

	// Shared low-level helper: insert into a Vector at index (Pascal `move`).
	mizVectorAtInsert(v : Vector<?>, i : int, val : ?) -> void;
	mizVectorAtDelete(v : Vector<?>, i : int) -> void;

	// =================================================================
	// THE GENERIC CONTAINERS — mobjects.pas declarations 86-240, bodies
	// 611-1600. Transcribed as real containers, with the original's
	// method names, because six of the port's known divergences came
	// from a use site re-deriving one of these semantics by hand.
	//
	// `Limit` and `Delta` are allocation details with NO observable
	// effect (the original signals coOverFlow only when Delta = 0, which
	// no verifier use site sets); a Vector grows on its own, so neither
	// is modelled. Everything that IS observable is transcribed:
	//
	//   * Items (INSERTION order) vs fIndex/AtIndex (SORTED order) —
	//     two orders in one object. ONLY Find/FindRight/FindInterval/
	//     AtIndex/Search/IndexOf go through the index.
	//   * the EXT TAIL — a pending item is invisible to Count-bounded
	//     reads until AddExtObject/AddExtItems commits it.
	//   * MSortedExtList.Insert = InsertExt + AddExtObject, and
	//     AddExtObject uses FindRight, so equal keys keep INSERTION
	//     order among themselves.
	//   * MSortedList.Find exits at the FIRST equal key it meets;
	//     MSortedExtList.Find keeps going and returns the LEFTMOST.
	//     They read alike and are not the same function.
	//
	// ONE DELIBERATE DIVERGENCE, because Flow9 has no pointer identity:
	// IndexOf and Delete compare with `==` (structural) where Pascal
	// compares pointers. Every verifier use site looks up an item it
	// just put in, so the two agree there.
	// =================================================================

	// ---- MList (86, bodies 742-941) / MCollection (120, 611-740) ----
	// MCollection adds only AtDelete/AtInsert/AtPut/Delete over MList,
	// so the two are one struct here. Note the two DIFFERENT AtInserts:
	// MCollection.AtInsert SHIFTS (mizListAtInsert), MList.AtInsert
	// writes at an index and pads the gap (NOT ported — it needs a nil,
	// and no verifier use site reaches it).
	MizList(items : Vector<?>);

	mizNewList(capacity : int) -> MizList<?>;                   // Init
	mizListCount(l : MizList<?>) -> int;                        // Count
	mizListAt(l : MizList<?>, i : int) -> ?;                    // At / GetObject
	mizListLast(l : MizList<?>) -> ?;                           // Last
	mizListInsert(l : MizList<?>, item : ?) -> void;            // Insert (append)
	mizListAtPut(l : MizList<?>, i : int, item : ?) -> void;    // AtPut
	mizListAtInsert(l : MizList<?>, i : int, item : ?) -> void; // MCollection.AtInsert
	mizListAtDelete(l : MizList<?>, i : int) -> void;           // AtDelete
	mizListDelete(l : MizList<?>, item : ?) -> void;            // Delete
	mizListIndexOf(l : MizList<?>, item : ?) -> int;            // IndexOf, -1 if absent
	mizListDeleteAll(l : MizList<?>) -> void;                   // DeleteAll
	mizListFreeItemsFrom(l : MizList<?>, i : int) -> void;      // FreeItemsFrom
	mizListItems(l : MizList<?>) -> [?];                        // Items^[0..Count-1]

	// ---- MExtList (146, bodies 943-1077) ----------------------------
	// One storage, two boundaries: Count committed items followed by
	// fExtCount PENDING ones. fExtCount is derived (storage - count) so
	// the two can never drift apart.
	MizExtList(items : Vector<?>, mutable count : int);

	mizNewExtList(capacity : int) -> MizExtList<?>;             // Init
	mizExtListCount(l : MizExtList<?>) -> int;                  // Count
	mizExtListExtCount(l : MizExtList<?>) -> int;               // fExtCount
	mizExtListAt(l : MizExtList<?>, i : int) -> ?;              // At (Count-bounded)
	mizExtListAtExt(l : MizExtList<?>, i : int) -> ?;           // Items^[i], pending included
	mizExtListInsert(l : MizExtList<?>, item : ?) -> void;      // Insert (fails on a pending tail)
	mizExtListInsertExt(l : MizExtList<?>, item : ?) -> void;   // InsertExt
	mizExtListAddExtObject(l : MizExtList<?>) -> void;          // AddExtObject
	mizExtListAddExtItems(l : MizExtList<?>) -> void;           // AddExtItems
	mizExtListDeleteExtItems(l : MizExtList<?>) -> void;        // DeleteExtItems / FreeExtItems
	mizExtListMark(l : MizExtList<?>) -> int;                   // Mark
	mizExtListDeleteAll(l : MizExtList<?>) -> void;             // DeleteAll
	mizExtListFreeItemsFrom(l : MizExtList<?>, i : int) -> void;// FreeItemsFrom
	mizExtListItems(l : MizExtList<?>) -> [?];                  // committed items only

	// ---- MSortedList (170, bodies 1241-1480) ------------------------
	// Items in INSERTION order — that order IS the numbering at every
	// use site — plus a separate sorted fIndex. A nil fCompare is a
	// real state: Insert then appends and Find is a linear identity
	// scan, until Sort installs a comparison.
	MizSortedList(items : Vector<?>, index : Vector<int>, mutable compare : Maybe<(?, ?) -> int>);

	mizNewSortedList(capacity : int) -> MizSortedList<?>;                        // Init
	mizNewSortedListSorted(capacity : int, cmp : (?, ?) -> int) -> MizSortedList<?>; // InitSorted
	mizSortedListCount(l : MizSortedList<?>) -> int;
	mizSortedListAt(l : MizSortedList<?>, i : int) -> ?;         // Items^[i], INSERTION order
	mizSortedListAtIndex(l : MizSortedList<?>, i : int) -> ?;    // Items^[fIndex^[i]], SORTED order
	mizSortedListAtPut(l : MizSortedList<?>, i : int, item : ?) -> void;
	mizSortedListInsert(l : MizSortedList<?>, item : ?) -> void; // Insert (no duplicates)
	mizSortedListAtInsert(l : MizSortedList<?>, i : int, item : ?) -> void; // AtInsert
	mizSortedListFind(l : MizSortedList<?>, key : ?) -> Pair<bool, int>;    // Find: index INTO fIndex
	mizSortedListSearch(l : MizSortedList<?>, key : ?) -> Pair<bool, int>;  // Search: index INTO Items
	mizSortedListIndexOf(l : MizSortedList<?>, item : ?) -> int; // IndexOf, -1 if absent
	mizSortedListSort(l : MizSortedList<?>, cmp : (?, ?) -> int) -> void;   // Sort
	mizSortedListFreeItemsFrom(l : MizSortedList<?>, i : int) -> void;
	mizSortedListItems(l : MizSortedList<?>) -> [?];             // INSERTION order

	// ---- MSortedExtList (188, bodies 1079-1238) ---------------------
	// Both orders AND the ext tail. Duplicate keys are allowed and keep
	// insertion order among themselves (AddExtObject inserts through
	// FindRight, i.e. AFTER the equals already there).
	MizSortedExtList(items : Vector<?>, index : Vector<int>, mutable count : int, compare : (?, ?) -> int);

	mizNewSortedExtList(capacity : int, cmp : (?, ?) -> int) -> MizSortedExtList<?>; // InitSorted
	mizSortedExtListCount(l : MizSortedExtList<?>) -> int;
	mizSortedExtListExtCount(l : MizSortedExtList<?>) -> int;
	mizSortedExtListAt(l : MizSortedExtList<?>, i : int) -> ?;      // Items^[i], INSERTION order
	mizSortedExtListAtIndex(l : MizSortedExtList<?>, i : int) -> ?; // AtIndex, SORTED order
	mizSortedExtListFind(l : MizSortedExtList<?>, key : ?) -> Pair<bool, int>;      // Find: LEFTMOST
	mizSortedExtListFindRight(l : MizSortedExtList<?>, key : ?) -> Pair<bool, int>; // FindRight
	mizSortedExtListFindInterval(l : MizSortedExtList<?>, key : ?) -> Triple<bool, int, int>; // FindInterval
	mizSortedExtListInsert(l : MizSortedExtList<?>, item : ?) -> void;    // InsertExt + AddExtObject
	mizSortedExtListInsertExt(l : MizSortedExtList<?>, item : ?) -> void; // InsertExt
	mizSortedExtListAddExtObject(l : MizSortedExtList<?>) -> void;        // AddExtObject
	mizSortedExtListAddExtItems(l : MizSortedExtList<?>) -> void;         // AddExtItems
	mizSortedExtListFreeItemsFrom(l : MizSortedExtList<?>, i : int) -> void;
	mizSortedExtListItems(l : MizSortedExtList<?>) -> [?];                // INSERTION order

	// ---- MSortedCollection (216, bodies 1526-1600) ------------------
	// The one container that is PHYSICALLY sorted: no fIndex, Items IS
	// the order, and AtInsert shifts. `duplicates` switches Search
	// between "the first equal met" and "the leftmost equal".
	MizSortedColl(items : Vector<?>, compare : (?, ?) -> int, mutable duplicates : bool);

	mizNewSortedColl(capacity : int, cmp : (?, ?) -> int) -> MizSortedColl<?>; // InitSorted
	mizSortedCollCount(l : MizSortedColl<?>) -> int;
	mizSortedCollAt(l : MizSortedColl<?>, i : int) -> ?;
	mizSortedCollAtPut(l : MizSortedColl<?>, i : int, item : ?) -> void;
	mizSortedCollSearch(l : MizSortedColl<?>, key : ?) -> Pair<bool, int>;  // Search
	mizSortedCollInsert(l : MizSortedColl<?>, item : ?) -> void;            // Insert
	mizSortedCollAtInsert(l : MizSortedColl<?>, i : int, item : ?) -> void; // AtInsert
	mizSortedCollAtDelete(l : MizSortedColl<?>, i : int) -> void;           // AtDelete
	mizSortedCollIndexOf(l : MizSortedColl<?>, item : ?) -> int;            // IndexOf
	mizSortedCollDeleteAll(l : MizSortedColl<?>) -> void;
	mizSortedCollItems(l : MizSortedColl<?>) -> [?];
}

// CompareIntPairs (mobjects.pas): x first, then y.
mizCompareIntPairs(x1 : int, y1 : int, x2 : int, y2 : int) -> int {
	c = if (x1 < x2) -1 else if (x1 > x2) 1 else 0;
	if (c != 0) c
	else if (y1 < y2) -1 else if (y1 > y2) 1 else 0;
}

mizIntRelSearch(v : Vector<MizIntPair>, x : int, y : int) -> Pair<bool, int> {
	lo = ref 0;
	hi = ref sizeVector(v) - 1;
	found = ref false;
	while(\ -> ^lo <= ^hi, \ -> {
		i = (^lo + ^hi) / 2;
		p = getVectorUnsafe(v, i);
		c = mizCompareIntPairs(p.x, p.y, x, y);
		if (c < 0) {
			lo := i + 1;
		} else {
			hi := i - 1;
			if (c == 0) {
				found := true;
				lo := i;
			}
		}
	});
	Pair(^found, ^lo);
}

mizIntRelInsert(v : Vector<MizIntPair>, x : int, y : int) -> void {
	p = mizIntRelSearch(v, x, y);
	if (!p.first) mizVectorAtInsert(v, p.second, MizIntPair(x, y));
}

mizIntRelIsMember(v : Vector<MizIntPair>, x : int, y : int) -> bool {
	mizIntRelSearch(v, x, y).first;
}

mizVectorAtInsert(v : Vector<?>, i : int, val : ?) -> void {
	n = sizeVector(v);
	if (i >= n) {
		pushVector(v, val);
	} else {
		pushVector(v, getVectorUnsafe(v, n - 1));
		// shift right: indices n-1 .. i+1 get their left neighbor
		// (while, not fori: fori recurses and the shift can be long)
		j = ref n - 1;
		while(\ -> ^j > i, \ -> {
			setVectorUnsafe(v, ^j, getVectorUnsafe(v, ^j - 1));
			j := ^j - 1;
		});
		setVectorUnsafe(v, i, val);
	}
}

mizVectorAtDelete(v : Vector<?>, i : int) -> void {
	removeVector(v, i);
}

// ---------------- NatSet / NatFunc ----------------

mizInitNatFunc(capacity : int) -> MizNatFunc {
	MizNatFunc(makeVector(max(capacity, 4)), true);
}

mizInitNatSet(capacity : int) -> MizNatFunc {
	mizInitNatFunc(capacity);
}

mizNatSetWithElement(x : int) -> MizNatFunc {
	f = mizInitNatFunc(4);
	mizNatInsertElem(f, x);
	f;
}

mizCopyNatFunc(f : MizNatFunc) -> MizNatFunc {
	MizNatFunc(copyVector(f.items), f.consistent);
}

mizNatCount(f : MizNatFunc) -> int {
	sizeVector(f.items);
}

mizNatItem(f : MizNatFunc, i : int) -> MizIntPair {
	getVectorUnsafe(f.items, i);
}

// SearchPair: binary search for x. Returns Pair(found, insertion index L).
mizNatSearchPair(f : MizNatFunc, x : int) -> Pair<bool, int> {
	found = ref false;
	l = ref 0;
	h = ref sizeVector(f.items) - 1;
	while(\ -> ^l <= ^h, \ -> {
		i = (^l + ^h) / 2;
		c = getVectorUnsafe(f.items, i).x - x;
		if (c < 0) {
			l := i + 1;
		} else {
			h := i - 1;
			if (c == 0) {
				found := true;
				l := i;   // not Duplicates: stop at the leftmost match
				h := i - 1;
			}
		}
	});
	Pair(^found, ^l);
}

mizNatHasInDom(f : MizNatFunc, x : int) -> bool {
	mizNatSearchPair(f, x).first;
}

mizNatElemNr(f : MizNatFunc, x : int) -> int {
	p = mizNatSearchPair(f, x);
	if (p.first) p.second else -1;
}

mizNatValue(f : MizNatFunc, x : int) -> int {
	p = mizNatSearchPair(f, x);
	if (p.first) {
		getVectorUnsafe(f.items, p.second).y;
	} else {
		mizRunTimeError(2100); // NatSetError(coDuplicate) in the original: absent key
		0;
	}
}

mizNatInsertPair(f : MizNatFunc, x : int, y : int) -> void {
	p = mizNatSearchPair(f, x);
	if (!p.first) {
		mizVectorAtInsert(f.items, p.second, MizIntPair(x, y));
	}
}

mizNatInsertElem(f : MizNatFunc, x : int) -> void {
	mizNatInsertPair(f, x, 0);
}

mizNatDeleteElem(f : MizNatFunc, x : int) -> void {
	p = mizNatSearchPair(f, x);
	if (p.first) {
		mizVectorAtDelete(f.items, p.second);
	}
}

mizNatDeleteAll(f : MizNatFunc) -> void {
	clearVector(f.items);
}

mizNatRefuted(f : MizNatFunc) -> void {
	clearVector(f.items);
	f.consistent ::= false;
}

mizNatAssign(f : MizNatFunc, x : int, y : int) -> void {
	if (f.consistent) {
		p = mizNatSearchPair(f, x);
		if (p.first) {
			if (getVectorUnsafe(f.items, p.second).y != y) {
				mizNatRefuted(f);
			}
			// same value: Insert is a no-op on duplicate x
		} else {
			mizVectorAtInsert(f.items, p.second, MizIntPair(x, y));
		}
	}
}

mizNatUp(f : MizNatFunc, x : int) -> void {
	if (f.consistent) {
		p = mizNatSearchPair(f, x);
		if (p.first) {
			it = getVectorUnsafe(f.items, p.second);
			setVectorUnsafe(f.items, p.second, MizIntPair(it.x, it.y + 1));
		} else {
			mizVectorAtInsert(f.items, p.second, MizIntPair(x, 1));
		}
	}
}

mizNatDown(f : MizNatFunc, x : int) -> void {
	if (f.consistent) {
		p = mizNatSearchPair(f, x);
		if (p.first) {
			it = getVectorUnsafe(f.items, p.second);
			if (it.y == 1) {
				mizVectorAtDelete(f.items, p.second);
			} else {
				setVectorUnsafe(f.items, p.second, MizIntPair(it.x, it.y - 1));
			}
		} else {
			mizRunTimeError(2101); // NatSetError(coConsistentError)
		}
	}
}

mizNatJoin(f : MizNatFunc, g : MizNatFunc) -> void {
	if (f.consistent) {
		if (!g.consistent) {
			mizNatRefuted(f);
		} else {
			n = sizeVector(g.items);
			k = ref 0;
			while(\ -> ^k < n && f.consistent, \ -> {
				it = getVectorUnsafe(g.items, ^k);
				p = mizNatSearchPair(f, it.x);
				if (p.first) {
					mine = getVectorUnsafe(f.items, p.second);
					if (mine.y != it.y) {
						mizNatRefuted(f);
					}
				} else {
					mizVectorAtInsert(f.items, p.second, it);
				}
				k := ^k + 1;
			});
		}
	}
}

mizNatJoinAtom(f : MizNatFunc, atom : MizNatFunc) -> Maybe<MizNatFunc> {
	eval : MizNatFunc = mizCopyNatFunc(f);
	mizNatJoin(eval, atom); // EnlargeBy and Join compute the same relation
	if (eval.consistent) Some(eval) else None();
}

mizNatEnlargeBy(f : MizNatFunc, g : MizNatFunc) -> void {
	iterVector(g.items, \it -> mizNatInsertElem(f, it.x));
}

mizNatComplementOf(f : MizNatFunc, g : MizNatFunc) -> void {
	iterVector(g.items, \it -> mizNatDeleteElem(f, it.x));
}

mizNatIntersectWith(f : MizNatFunc, g : MizNatFunc) -> void {
	k = ref 0;
	while(\ -> ^k < sizeVector(f.items), \ -> {
		if (!mizNatHasInDom(g, getVectorUnsafe(f.items, ^k).x)) {
			mizVectorAtDelete(f.items, ^k);
		} else {
			k := ^k + 1;
		}
	});
}

mizNatIsEqualTo(f : MizNatFunc, g : MizNatFunc) -> bool {
	n = sizeVector(f.items);
	if (n != sizeVector(g.items)) {
		false;
	} else {
		ok = ref true;
		fori(0, n - 1, \i -> {
			a = getVectorUnsafe(f.items, i);
			b = getVectorUnsafe(g.items, i);
			if (a.x != b.x || a.y != b.y) ok := false;
		});
		^ok;
	}
}

mizNatIsSubsetOf(f : MizNatFunc, g : MizNatFunc) -> bool {
	n = sizeVector(f.items);
	c = sizeVector(g.items);
	if (c < n) {
		false;
	} else {
		// merge walk over both sorted lists, exact (x, y) match required
		res = ref true;
		j = ref 0;
		i = ref 0;
		while(\ -> ^i < n && ^res, \ -> {
			a = getVectorUnsafe(f.items, ^i);
			while(\ -> ^j < c && getVectorUnsafe(g.items, ^j).x < a.x, \ -> j := ^j + 1);
			if (^j == c) {
				res := false;
			} else {
				b = getVectorUnsafe(g.items, ^j);
				if (a.x != b.x || a.y != b.y) res := false;
			}
			i := ^i + 1;
		});
		^res;
	}
}

mizNatMisses(f : MizNatFunc, g : MizNatFunc) -> bool {
	small = if (mizNatCount(f) > mizNatCount(g)) g else f;
	large = if (mizNatCount(f) > mizNatCount(g)) f else g;
	res = ref true;
	iterVector(small.items, \it -> {
		if (mizNatHasInDom(large, it.x)) res := false;
	});
	^res;
}

mizNatWeakerThan(f : MizNatFunc, g : MizNatFunc) -> bool {
	if (mizNatCount(f) > mizNatCount(g)) {
		false;
	} else {
		res = ref true;
		iterVector(f.items, \it -> {
			if (^res) {
				p = mizNatSearchPair(g, it.x);
				if (!p.first || getVectorUnsafe(g.items, p.second).y != it.y) {
					res := false;
				}
			}
		});
		^res;
	}
}

mizNatCompareWith(f : MizNatFunc, g : MizNatFunc) -> int {
	if (mizNatCount(f) <= mizNatCount(g) && mizNatWeakerThan(f, g)) {
		-1;
	} else if (mizNatCount(g) <= mizNatCount(f) && mizNatWeakerThan(g, f)) {
		1;
	} else {
		0;
	}
}

mizNatCountAll(f : MizNatFunc) -> int {
	foldVector(f.items, 0, \acc, it -> acc + it.y);
}

mizNatLCM(f : MizNatFunc, g : MizNatFunc) -> MizNatFunc {
	r = mizInitNatFunc(mizNatCount(f) + mizNatCount(g));
	nf = mizNatCount(f);
	ng = mizNatCount(g);
	i = ref 0;
	j = ref 0;
	while(\ -> ^i < nf && ^j < ng, \ -> {
		a = getVectorUnsafe(f.items, ^i);
		b = getVectorUnsafe(g.items, ^j);
		if (a.x < b.x) {
			pushVector(r.items, a);
			i := ^i + 1;
		} else if (a.x > b.x) {
			pushVector(r.items, b);
			j := ^j + 1;
		} else {
			pushVector(r.items, MizIntPair(a.x, max(a.y, b.y)));
			i := ^i + 1;
			j := ^j + 1;
		}
	});
	while(\ -> ^i < nf, \ -> {
		pushVector(r.items, getVectorUnsafe(f.items, ^i));
		i := ^i + 1;
	});
	while(\ -> ^j < ng, \ -> {
		pushVector(r.items, getVectorUnsafe(g.items, ^j));
		j := ^j + 1;
	});
	r;
}

// ---------------- IntSequence / IntSet ----------------

mizInitIntSeq(capacity : int) -> MizIntSeq {
	MizIntSeq(makeVector(max(capacity, 4)));
}

mizCopyIntSeq(s : MizIntSeq) -> MizIntSeq {
	MizIntSeq(copyVector(s.items));
}

mizSeqCount(s : MizIntSeq) -> int {
	sizeVector(s.items);
}

mizSeqValue(s : MizIntSeq, i : int) -> int {
	getVectorUnsafe(s.items, i);
}

mizSeqInsert(s : MizIntSeq, v : int) -> int {
	pushVector(s.items, v);
	sizeVector(s.items) - 1;
}

mizSeqAtPut(s : MizIntSeq, i : int, v : int) -> void {
	setVectorUnsafe(s.items, i, v);
}

mizSeqAtDelete(s : MizIntSeq, i : int) -> void {
	removeVector(s.items, i);
}

mizSeqIndexOf(s : MizIntSeq, v : int) -> int {
	n = sizeVector(s.items);
	res = ref -1;
	i = ref 0;
	while(\ -> ^i < n && ^res < 0, \ -> {
		if (getVectorUnsafe(s.items, ^i) == v) res := ^i;
		i := ^i + 1;
	});
	^res;
}

mizSeqClear(s : MizIntSeq) -> void {
	clearVector(s.items);
}

// IntSet.Find: binary search. Pair(found, insertion index).
mizIntSetFind(s : MizIntSeq, v : int) -> Pair<bool, int> {
	found = ref false;
	l = ref 0;
	h = ref sizeVector(s.items) - 1;
	while(\ -> ^l <= ^h, \ -> {
		i = (^l + ^h) / 2;
		c = getVectorUnsafe(s.items, i) - v;
		if (c < 0) {
			l := i + 1;
		} else {
			h := i - 1;
			if (c == 0) {
				found := true;
				l := i;
				h := i - 1;
			}
		}
	});
	Pair(^found, ^l);
}

mizIntSetInsert(s : MizIntSeq, v : int) -> int {
	p = mizIntSetFind(s, v);
	if (!p.first) {
		mizVectorAtInsert(s.items, p.second, v);
	}
	p.second;
}

mizIntSetIsInSet(s : MizIntSeq, v : int) -> bool {
	mizIntSetFind(s, v).first;
}

mizIntSetDelete(s : MizIntSeq, v : int) -> int {
	p = mizIntSetFind(s, v);
	if (p.first) {
		removeVector(s.items, p.second);
		p.second;
	} else {
		-1;
	}
}

mizIntSetIsSubsetOf(s : MizIntSeq, t : MizIntSeq) -> bool {
	res = ref true;
	iterVector(s.items, \v -> {
		if (!mizIntSetIsInSet(t, v)) res := false;
	});
	^res;
}

mizIntSetMisses(s : MizIntSeq, t : MizIntSeq) -> bool {
	res = ref true;
	iterVector(s.items, \v -> {
		if (mizIntSetIsInSet(t, v)) res := false;
	});
	^res;
}

// =====================================================================
// mobjects.pas — THE GENERIC CONTAINERS.
// Each body below names the Pascal line it transcribes.
// =====================================================================

// ---- MList / MCollection --------------------------------------------

mizNewList(capacity : int) -> MizList<?> {   // MList.Init (742)
	MizList(makeVector(capacity));
}

mizListCount(l : MizList<?>) -> int {
	sizeVector(l.items);
}

mizListAt(l : MizList<?>, i : int) -> ? {    // MList.At (789)
	if (i < 0 || i >= sizeVector(l.items)) mizRunTimeError(213); // ListError(coIndexError)
	getVectorUnsafe(l.items, i);
}

mizListLast(l : MizList<?>) -> ? {           // MList.Last (799)
	mizListAt(l, sizeVector(l.items) - 1);
}

mizListInsert(l : MizList<?>, item : ?) -> void {  // MList.Insert (802)
	pushVector(l.items, item);
}

mizListAtPut(l : MizList<?>, i : int, item : ?) -> void {  // MCollection.AtPut (671)
	if (i < 0 || i >= sizeVector(l.items)) mizRunTimeError(213)
	else setVectorUnsafe(l.items, i, item);
}

mizListAtInsert(l : MizList<?>, i : int, item : ?) -> void { // MCollection.AtInsert (649)
	if (i < 0 || i > sizeVector(l.items)) mizRunTimeError(213)
	else mizVectorAtInsert(l.items, i, item);
}

mizListAtDelete(l : MizList<?>, i : int) -> void {  // MCollection.AtDelete (627)
	if (i < 0 || i >= sizeVector(l.items)) mizRunTimeError(213)
	else mizVectorAtDelete(l.items, i);
}

mizListDelete(l : MizList<?>, item : ?) -> void {   // MCollection.Delete (678)
	mizListAtDelete(l, mizListIndexOf(l, item));
}

mizListIndexOf(l : MizList<?>, item : ?) -> int {   // MList.IndexOf (854)
	res = ref -1;
	i = ref 0;
	n = sizeVector(l.items);
	while(\ -> ^res < 0 && ^i < n, \ -> {
		if (getVectorUnsafe(l.items, ^i) == item) res := ^i;
		i := ^i + 1;
	});
	^res;
}

mizListDeleteAll(l : MizList<?>) -> void {          // MList.DeleteAll (866)
	clearVector(l.items);
}

mizListFreeItemsFrom(l : MizList<?>, i : int) -> void { // MList.FreeItemsFrom (881)
	resizeVector(l.items, i);
}

mizListItems(l : MizList<?>) -> [?] {
	vector2array(l.items);
}

// ---- MExtList --------------------------------------------------------
// fExtCount is DERIVED: the storage holds Count committed items followed
// by the pending tail, exactly as Items^[0..Count+fExtCount-1] does.

mizNewExtList(capacity : int) -> MizExtList<?> {    // MExtList.Init (943)
	MizExtList(makeVector(capacity), 0);
}

mizExtListCount(l : MizExtList<?>) -> int {
	l.count;
}

mizExtListExtCount(l : MizExtList<?>) -> int {
	sizeVector(l.items) - l.count;
}

mizExtListAt(l : MizExtList<?>, i : int) -> ? {     // MList.At over Count (789)
	if (i < 0 || i >= l.count) mizRunTimeError(213);
	getVectorUnsafe(l.items, i);
}

mizExtListAtExt(l : MizExtList<?>, i : int) -> ? {  // Items^[i] — the pending tail too
	if (i < 0 || i >= sizeVector(l.items)) mizRunTimeError(213);
	getVectorUnsafe(l.items, i);
}

mizExtListInsert(l : MizExtList<?>, item : ?) -> void { // MExtList.Insert (959)
	if (mizExtListExtCount(l) != 0) mizRunTimeError(219)  // ListError(coIndexExtError)
	else {
		pushVector(l.items, item);
		l.count ::= l.count + 1;
	}
}

mizExtListInsertExt(l : MizExtList<?>, item : ?) -> void { // MExtList.InsertExt (1002)
	pushVector(l.items, item);
}

mizExtListAddExtObject(l : MizExtList<?>) -> void { // MExtList.AddExtObject (1047)
	if (mizExtListExtCount(l) <= 0) mizRunTimeError(219)
	else l.count ::= l.count + 1;
}

mizExtListAddExtItems(l : MizExtList<?>) -> void {  // MExtList.AddExtItems (1058)
	l.count ::= sizeVector(l.items);
}

mizExtListDeleteExtItems(l : MizExtList<?>) -> void { // DeleteExtItems (1064) / FreeExtItems (1069)
	resizeVector(l.items, l.count);
}

mizExtListMark(l : MizExtList<?>) -> int {          // MExtList.Mark (1029)
	l.count;
}

mizExtListDeleteAll(l : MizExtList<?>) -> void {    // MExtList.DeleteAll (972)
	if (mizExtListExtCount(l) != 0) mizRunTimeError(219)
	else {
		clearVector(l.items);
		l.count ::= 0;
	}
}

mizExtListFreeItemsFrom(l : MizExtList<?>, i : int) -> void { // FreeItemsFrom (1034)
	if (mizExtListExtCount(l) != 0) mizRunTimeError(219)
	else {
		resizeVector(l.items, i);
		l.count ::= i;
	}
}

mizExtListItems(l : MizExtList<?>) -> [?] {
	subrange(vector2array(l.items), 0, l.count);
}

// ---- MSortedList -----------------------------------------------------

mizNewSortedList(capacity : int) -> MizSortedList<?> {  // MSortedList.Init (1241)
	MizSortedList(makeVector(capacity), makeVector(capacity), None());
}

mizNewSortedListSorted(capacity : int, cmp : (?, ?) -> int) -> MizSortedList<?> { // InitSorted (1252)
	MizSortedList(makeVector(capacity), makeVector(capacity), Some(cmp));
}

mizSortedListCount(l : MizSortedList<?>) -> int {
	sizeVector(l.items);
}

mizSortedListAt(l : MizSortedList<?>, i : int) -> ? {
	if (i < 0 || i >= sizeVector(l.items)) mizRunTimeError(213);
	getVectorUnsafe(l.items, i);
}

mizSortedListAtIndex(l : MizSortedList<?>, i : int) -> ? {
	if (i < 0 || i >= sizeVector(l.index)) mizRunTimeError(218); // coSortedListError
	getVectorUnsafe(l.items, getVectorUnsafe(l.index, i));
}

mizSortedListAtPut(l : MizSortedList<?>, i : int, item : ?) -> void {
	if (i < 0 || i >= sizeVector(l.items)) mizRunTimeError(213)
	else setVectorUnsafe(l.items, i, item);
}

// MSortedList.Find (1393). NOTE the early exit on an equal key: this
// returns the FIRST equal the bisection meets, not the leftmost. The
// container forbids duplicates, so the two coincide — but do not copy
// this loop into MSortedExtList, which is a different function.
mizSortedListFind(l : MizSortedList<?>, key : ?) -> Pair<bool, int> {
	n = sizeVector(l.items);
	switch (l.compare) {
		None(): {
			found = ref false;
			idx = ref n;
			i = ref 0;
			while(\ -> !^found && ^i < n, \ -> {
				if (getVectorUnsafe(l.items, ^i) == key) {
					found := true;
					idx := ^i;
				}
				i := ^i + 1;
			});
			Pair(^found, ^idx);
		}
		Some(cmp): {
			found = ref false;
			lo = ref 0;
			hi = ref n - 1;
			while(\ -> ^lo <= ^hi, \ -> {
				i = (^lo + ^hi) / 2;
				c = cmp(getVectorUnsafe(l.items, getVectorUnsafe(l.index, i)), key);
				if (c < 0) {
					lo := i + 1;
				} else {
					hi := i - 1;
					if (c == 0) {
						found := true;
						lo := i;
					}
				}
			});
			Pair(^found, ^lo);
		}
	}
}

mizSortedListSearch(l : MizSortedList<?>, key : ?) -> Pair<bool, int> { // Search (1429)
	p = mizSortedListFind(l, key);
	if (p.first) Pair(true, getVectorUnsafe(l.index, p.second))
	else Pair(false, sizeVector(l.items));
}

mizSortedListIndexOf(l : MizSortedList<?>, item : ?) -> int {  // IndexOf (1440)
	switch (l.compare) {
		None(): { mizRunTimeError(218); -1; }
		Some(__): {
			p = mizSortedListFind(l, item);
			if (p.first) getVectorUnsafe(l.index, p.second) else -1;
		}
	}
}

// MSortedList.AtInsert (1296): the item goes at the END of Items — the
// insertion order is the numbering — and only its POSITION enters fIndex.
mizSortedListAtInsert(l : MizSortedList<?>, i : int, item : ?) -> void {
	mizVectorAtInsert(l.index, i, sizeVector(l.items));
	pushVector(l.items, item);
}

mizSortedListInsert(l : MizSortedList<?>, item : ?) -> void {  // Insert (1307)
	switch (l.compare) {
		None(): {
			pushVector(l.index, sizeVector(l.items));
			pushVector(l.items, item);
		}
		Some(__): {
			p = mizSortedListFind(l, item);
			if (!p.first) mizSortedListAtInsert(l, p.second, item);
		}
	}
}

mizSortedListSort(l : MizSortedList<?>, cmp : (?, ?) -> int) -> void { // Sort (1384)
	l.compare ::= Some(cmp);
	n = sizeVector(l.items);
	resizeVector(l.index, 0);
	loop(0, \i -> i + 1, \i -> i < n, \i -> pushVector(l.index, i));
	if (n > 0) mizListQuickSort(l.items, l.index, 0, n - 1, cmp);
}

// MSortedList.FreeItemsFrom (1464): drop the items from aIndex on, then
// COMPACT fIndex keeping the surviving positions IN THEIR SORTED ORDER.
mizSortedListFreeItemsFrom(l : MizSortedList<?>, i : int) -> void {
	n = sizeVector(l.items);
	if (i != n) {
		k = ref 0;
		loop(0, \j -> j + 1, \j -> j < n, \j -> {
			p = getVectorUnsafe(l.index, j);
			if (p < i) {
				setVectorUnsafe(l.index, ^k, p);
				k := ^k + 1;
			}
		});
		if (^k != i) mizRunTimeError(218);
		resizeVector(l.index, i);
		resizeVector(l.items, i);
	}
}

mizSortedListItems(l : MizSortedList<?>) -> [?] {
	vector2array(l.items);
}

// ListQuickSort (mobjects.pas 1357). Transcribed literally — it sorts
// fIndex, never Items, and the order it leaves equal keys in is part of
// the observable behaviour.
mizListQuickSort(items : Vector<?>, index : Vector<int>, aL : int, aR : int, cmp : (?, ?) -> int) -> void {
	l = ref aL;
	r = aR;
	i = ref 0;
	j = ref 0;
	doWhile(\ -> {
		i := ^l;
		j := r;
		p = getVectorUnsafe(items, getVectorUnsafe(index, (^l + r) / 2));
		doWhile(\ -> {
			while(\ -> cmp(getVectorUnsafe(items, getVectorUnsafe(index, ^i)), p) < 0, \ -> i := ^i + 1);
			while(\ -> cmp(getVectorUnsafe(items, getVectorUnsafe(index, ^j)), p) > 0, \ -> j := ^j - 1);
			if (^i <= ^j) {
				t = getVectorUnsafe(index, ^i);
				setVectorUnsafe(index, ^i, getVectorUnsafe(index, ^j));
				setVectorUnsafe(index, ^j, t);
				i := ^i + 1;
				j := ^j - 1;
			}
		}, \ -> ^i <= ^j);
		if (^l < ^j) mizListQuickSort(items, index, ^l, ^j, cmp);
		l := ^i;
	}, \ -> ^i < r);
}

// ---- MSortedExtList --------------------------------------------------

mizNewSortedExtList(capacity : int, cmp : (?, ?) -> int) -> MizSortedExtList<?> { // InitSorted (1082)
	MizSortedExtList(makeVector(capacity), makeVector(capacity), 0, cmp);
}

mizSortedExtListCount(l : MizSortedExtList<?>) -> int {
	l.count;
}

mizSortedExtListExtCount(l : MizSortedExtList<?>) -> int {
	sizeVector(l.items) - l.count;
}

mizSortedExtListAt(l : MizSortedExtList<?>, i : int) -> ? {
	if (i < 0 || i >= sizeVector(l.items)) mizRunTimeError(219);
	getVectorUnsafe(l.items, i);
}

mizSortedExtListAtIndex(l : MizSortedExtList<?>, i : int) -> ? { // AtIndex (1141)
	if (i < 0 || i >= l.count) mizRunTimeError(219);
	getVectorUnsafe(l.items, getVectorUnsafe(l.index, i));
}

// MSortedExtList.Find (1094) — the LEFTMOST equal key. Unlike
// MSortedList.Find it does NOT stop at the first equal it meets.
mizSortedExtListFind(l : MizSortedExtList<?>, key : ?) -> Pair<bool, int> {
	found = ref false;
	lo = ref 0;
	hi = ref l.count - 1;
	while(\ -> ^lo <= ^hi, \ -> {
		i = (^lo + ^hi) / 2;
		c = l.compare(getVectorUnsafe(l.items, getVectorUnsafe(l.index, i)), key);
		if (c < 0) {
			lo := i + 1;
		} else {
			hi := i - 1;
			if (c == 0) found := true;
		}
	});
	Pair(^found, ^lo);
}

// FindRight (1116): the first index PAST the equal run — where an equal
// key is inserted, so equal keys keep INSERTION order among themselves.
mizSortedExtListFindRight(l : MizSortedExtList<?>, key : ?) -> Pair<bool, int> {
	p = mizSortedExtListFind(l, key);
	if (p.first) {
		i = ref p.second;
		while(\ -> ^i < l.count && 0 == l.compare(getVectorUnsafe(l.items, getVectorUnsafe(l.index, ^i)), key),
			\ -> i := ^i + 1);
		Pair(true, ^i);
	} else Pair(false, p.second);
}

// FindInterval (1128): left and right are INCLUSIVE; on a miss it
// returns (left, left-1), an empty interval.
mizSortedExtListFindInterval(l : MizSortedExtList<?>, key : ?) -> Triple<bool, int, int> {
	p = mizSortedExtListFind(l, key);
	if (p.first) {
		i = ref p.second + 1;
		while(\ -> ^i < l.count && 0 == l.compare(getVectorUnsafe(l.items, getVectorUnsafe(l.index, ^i)), key),
			\ -> i := ^i + 1);
		Triple(true, p.second, ^i - 1);
	} else Triple(false, p.second, p.second - 1);
}

mizSortedExtListInsertExt(l : MizSortedExtList<?>, item : ?) -> void { // InsertExt (1158)
	pushVector(l.items, item);
}

// AddExtObject (1224): commit ONE pending item — find its place in the
// index by FindRight, put its POSITION there, and move the boundary.
mizSortedExtListAddExtObject(l : MizSortedExtList<?>) -> void {
	if (mizSortedExtListExtCount(l) <= 0) mizRunTimeError(219)
	else {
		p = mizSortedExtListFindRight(l, getVectorUnsafe(l.items, l.count));
		mizVectorAtInsert(l.index, p.second, l.count);
		l.count ::= l.count + 1;
	}
}

mizSortedExtListAddExtItems(l : MizSortedExtList<?>) -> void { // AddExtItems (1236)
	while(\ -> mizSortedExtListExtCount(l) > 0, \ -> mizSortedExtListAddExtObject(l));
}

mizSortedExtListInsert(l : MizSortedExtList<?>, item : ?) -> void { // Insert (1148)
	if (mizSortedExtListExtCount(l) != 0) mizRunTimeError(219)
	else {
		mizSortedExtListInsertExt(l, item);
		mizSortedExtListAddExtObject(l);
	}
}

mizSortedExtListFreeItemsFrom(l : MizSortedExtList<?>, i : int) -> void { // FreeItemsFrom (1204)
	if (mizSortedExtListExtCount(l) != 0) mizRunTimeError(219)
	else if (i != l.count) {
		k = ref 0;
		loop(0, \j -> j + 1, \j -> j < l.count, \j -> {
			p = getVectorUnsafe(l.index, j);
			if (p < i) {
				setVectorUnsafe(l.index, ^k, p);
				k := ^k + 1;
			}
		});
		if (^k != i) mizRunTimeError(218);
		resizeVector(l.index, i);
		resizeVector(l.items, i);
		l.count ::= i;
	}
}

mizSortedExtListItems(l : MizSortedExtList<?>) -> [?] {
	subrange(vector2array(l.items), 0, l.count);
}

// ---- MSortedCollection -----------------------------------------------

mizNewSortedColl(capacity : int, cmp : (?, ?) -> int) -> MizSortedColl<?> { // InitSorted (1533)
	MizSortedColl(makeVector(capacity), cmp, false);
}

mizSortedCollCount(l : MizSortedColl<?>) -> int {
	sizeVector(l.items);
}

mizSortedCollAt(l : MizSortedColl<?>, i : int) -> ? {
	if (i < 0 || i >= sizeVector(l.items)) mizRunTimeError(213);
	getVectorUnsafe(l.items, i);
}

mizSortedCollAtPut(l : MizSortedColl<?>, i : int, item : ?) -> void {
	if (i < 0 || i >= sizeVector(l.items)) mizRunTimeError(213)
	else setVectorUnsafe(l.items, i, item);
}

// MSortedCollection.Search (1576) — a plain binary search over Items
// itself. With Duplicates it walks on to the LEFTMOST equal; without,
// it stops at the first equal it meets.
mizSortedCollSearch(l : MizSortedColl<?>, key : ?) -> Pair<bool, int> {
	found = ref false;
	lo = ref 0;
	hi = ref sizeVector(l.items) - 1;
	while(\ -> ^lo <= ^hi, \ -> {
		i = (^lo + ^hi) / 2;
		c = l.compare(getVectorUnsafe(l.items, i), key);
		if (c < 0) {
			lo := i + 1;
		} else {
			hi := i - 1;
			if (c == 0) {
				found := true;
				if (!l.duplicates) lo := i;
			}
		}
	});
	Pair(^found, ^lo);
}

mizSortedCollAtInsert(l : MizSortedColl<?>, i : int, item : ?) -> void { // AtInsert (649)
	if (i < 0 || i > sizeVector(l.items)) mizRunTimeError(213)
	else mizVectorAtInsert(l.items, i, item);
}

mizSortedCollInsert(l : MizSortedColl<?>, item : ?) -> void { // Insert (1558)
	p = mizSortedCollSearch(l, item);
	if (!p.first || l.duplicates) mizSortedCollAtInsert(l, p.second, item);
}

mizSortedCollAtDelete(l : MizSortedColl<?>, i : int) -> void { // AtDelete (627)
	if (i < 0 || i >= sizeVector(l.items)) mizRunTimeError(213)
	else mizVectorAtDelete(l.items, i);
}

mizSortedCollIndexOf(l : MizSortedColl<?>, item : ?) -> int { // IndexOf (1546)
	p = mizSortedCollSearch(l, item);
	if (!p.first) -1
	else {
		n = sizeVector(l.items);
		i = ref p.second;
		if (l.duplicates) {
			while(\ -> ^i < n && !(getVectorUnsafe(l.items, ^i) == item), \ -> i := ^i + 1);
		}
		if (^i < n) ^i else -1;
	}
}

mizSortedCollDeleteAll(l : MizSortedColl<?>) -> void {
	clearVector(l.items);
}

mizSortedCollItems(l : MizSortedColl<?>) -> [?] {
	vector2array(l.items);
}
