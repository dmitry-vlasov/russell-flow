import mizar/xml;
import ds/tree;
import string;
import math/math;

// Constructor resolution for Mizar analyzed XML.
//
// In an article's `<article>.xml` the formula nodes reference constructors by
// ENVIRONMENT-relative numbers (`<Pred kind="R" nr="3">`). The sibling
// `<article>.atr` (`<Constructors>`) resolves them: each `<Constructor>` carries
//   - `relnr` : the global per-kind environment index the body references, and
//   - `nr`    : the constructor's number within its DEFINING article (`aid`),
// which is the number used in the MPTP-style absolute name `<letter><nr>_<aid>`.
// (`relnr`/`nr` are easy to swap — the body's nr matches the .atr `relnr`.)

export {
	// `table`: body "<kind>:<relnr>" -> defining constructor. `readable`: the same key ->
	// a human notation name (in/object/union/…) when the constructor's Mizar symbol is a
	// clean word (filled by mizFullSig in notation.flow; empty from mizParseAtr alone).
	MizSig(table : Tree<string, MizConstr>, readable : Tree<string, string>);
		MizConstr(aid : string, nr : int);

	mizParseAtr(content : string) -> MizSig;
	mizResolve(sig : MizSig, kind : string, nr : int) -> Maybe<MizConstr>;
	mizConstrName(kind : string, c : MizConstr) -> string;   // r1_tarski, k1_xboole_0, ...
}

mizParseAtr(content : string) -> MizSig {
	switch (mizParseXml(content)) {
		None(): MizSig(makeTree(), makeTree());
		Some(root): {
			cs = if (root.tag == "Constructors") Some(root) else mizFindFirst(root.kids, "Constructors");
			switch (cs) {
				None(): MizSig(makeTree(), makeTree());
				Some(c):
					MizSig(fold(mizKidsTagged(c, "Constructor"), makeTree(), \acc, con -> {
						kind  = mizAttr(con, "kind");
						relnr = mizAttr(con, "relnr");
						aid   = mizAttr(con, "aid");
						nr    = s2i(mizAttr(con, "nr"));
						if (kind == "" || relnr == "" || aid == "") acc
						else setTree(acc, kind + ":" + relnr, MizConstr(aid, nr));
					}), makeTree());
			}
		}
	}
}

mizResolve(sig : MizSig, kind : string, nr : int) -> Maybe<MizConstr> {
	lookupTree(sig.table, kind + ":" + i2s(nr));
}

mizConstrName(kind : string, c : MizConstr) -> string {
	letter =
		if (kind == "R") "r" else if (kind == "K") "k" else if (kind == "M") "m"
		else if (kind == "V") "v" else if (kind == "U") "u" else if (kind == "L") "l"
		else if (kind == "G") "g" else toLowerCase(kind);
	letter + i2s(c.nr) + "_" + toLowerCase(c.aid);
}
