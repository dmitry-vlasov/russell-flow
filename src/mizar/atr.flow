import mizar/xml;
import ds/tree;
import string;
import math/math;

// Constructor resolution for Mizar analyzed XML.
//
// In an article's `<article>.xml` the formula nodes reference constructors by
// ENVIRONMENT-relative numbers (`<Pred kind="R" nr="3">`). The sibling
// `<article>.atr` (`<Constructors>`) resolves them: each `<Constructor>` carries
//   - `relnr` : the global per-kind environment index the body references, and
//   - `nr`    : the constructor's number within its DEFINING article (`aid`),
// which is the number used in the MPTP-style absolute name `<letter><nr>_<aid>`.
// (`relnr`/`nr` are easy to swap — the body's nr matches the .atr `relnr`.)

export {
	// `table`: body "<kind>:<relnr>" -> defining constructor. `readable`: the same key ->
	// a human notation name (in/object/union/…) when the constructor's Mizar symbol is a
	// clean word (filled by mizFullSig in notation.flow; empty from mizParseAtr alone).
	MizSig(table : Tree<string, MizAtrConstr>, readable : Tree<string, string>);
		// `drop`: how many LEADING arguments to skip when the constructor is applied —
		// nonzero only for a redefinition with superfluous arguments, aliased to its base.
		MizAtrConstr(aid : string, nr : int, drop : int);

	mizParseAtr(content : string) -> MizSig;
	mizResolve(sig : MizSig, kind : string, nr : int) -> Maybe<MizAtrConstr>;
	// the adjustment's argument skip for a body reference: 0 unless the constructor is a
	// superfluous-argument redefinition
	mizResolveDrop(sig : MizSig, kind : string, nr : int) -> int;
	mizConstrName(kind : string, c : MizAtrConstr) -> string;   // r1_tarski, k1_xboole_0, ...
	// Register one <Constructor> node into a resolution table. A redefinition
	// (`redefnr`) denotes the SAME relation/functor as the original — the checker's
	// Adjust* family (AdjustedFuncNr correl.pas 3454, AdjustTrm/AdjustFrm/AdjustAttrFrm)
	// replaces the constructor by `fWhichConstrNr` and drops `fSuperfluous` LEADING
	// arguments, and term identity (EqTrm/CompTrms) is decided on the adjusted form. So
	// the alias points at the constructor already registered at that index — e.g.
	// TARSKI's redefined `in` (R nr=2 redefnr=2) resolves to HIDDEN's ∈ — and a
	// superfluous-argument redefinition (SUBSET_1's k4..k9, the subset-typed ∪/∩/∖/△)
	// additionally carries the argument skip, so `k7_subset_1 X A B` is translated as
	// the term the checker actually computes with: `A ∖ B`.
	mizAddConstr(acc : Tree<string, MizAtrConstr>, con : MizXml) -> Tree<string, MizAtrConstr>;
}

mizParseAtr(content : string) -> MizSig {
	switch (mizParseXml(content)) {
		None(): MizSig(makeTree(), makeTree());
		Some(root): {
			cs = if (root.tag == "Constructors") Some(root) else mizFindFirst(root.kids, "Constructors");
			switch (cs) {
				None(): MizSig(makeTree(), makeTree());
				Some(c):
					MizSig(fold(mizKidsTagged(c, "Constructor"), makeTree(), mizAddConstr), makeTree());
			}
		}
	}
}

mizAddConstr(acc : Tree<string, MizAtrConstr>, con : MizXml) -> Tree<string, MizAtrConstr> {
	kind  = mizAttr(con, "kind");
	relnr = mizAttr(con, "relnr");
	aid   = mizAttr(con, "aid");
	if (kind == "" || relnr == "" || aid == "") acc
	else {
		own = MizAtrConstr(aid, s2i(mizAttr(con, "nr")), 0);
		redefnr = mizAttr(con, "redefnr");
		// constructors are listed in relnr order, so the redefinition target is already
		// registered (and a redefinition-of-a-redefinition chains through it). A
		// superfluous-argument redefinition aliases to the SAME base and accumulates the
		// argument skip — the checker's one-step adjustment (fWhichConstrNr points at a
		// base constructor) makes the target's own drop 0, but chaining through the
		// registered entry keeps a redefinition-of-a-redefinition correct either way.
		c = if (redefnr != "") {
				switch (lookupTree(acc, kind + ":" + redefnr)) {
					Some(b): MizAtrConstr(b.aid, b.nr, b.drop + s2i(mizAttr(con, "superfluous")));
					None(): own;
				}
			} else own;
		setTree(acc, kind + ":" + relnr, c);
	}
}

mizResolve(sig : MizSig, kind : string, nr : int) -> Maybe<MizAtrConstr> {
	lookupTree(sig.table, kind + ":" + i2s(nr));
}

mizResolveDrop(sig : MizSig, kind : string, nr : int) -> int {
	switch (mizResolve(sig, kind, nr)) {
		Some(c): c.drop;
		None(): 0;
	}
}

mizConstrName(kind : string, c : MizAtrConstr) -> string {
	letter =
		if (kind == "R") "r" else if (kind == "K") "k" else if (kind == "M") "m"
		else if (kind == "V") "v" else if (kind == "U") "u" else if (kind == "L") "l"
		else if (kind == "G") "g" else toLowerCase(kind);
	letter + i2s(c.nr) + "_" + toLowerCase(c.aid);
}
