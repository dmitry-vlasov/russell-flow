import mizar/miz2ru;

// The derivation EVIDENCE BRIDGE: translate the checker's derivation records
// (<Premise> formulas, <Assign> witness terms — serialized in the analyzer-report
// dialect by dump-derivation= / the in-process run) into the SAME FolForm dialect
// the translated proof skeleton lives in. The completer consumes the pair.
//
// Two record-only obstacles are made explicit rather than papered over:
//   * <Const nr vid="0"> — the checker's fixed variables lost their identifiers;
//     the vid is recovered from the theorem's OWN analyzed-XML subtree (the same
//     nr there carries its vid). An nr that is ambiguous inside the theorem
//     (nested blocks reuse numbers) stays unmapped — honest, not guessed.
//   * <EqClass nr> / <It> — checker-only sorts (equalizer class references in a
//     witness representative). They translate to unhandled markers; resolving a
//     class to a surface term is its own future slice.
// A record with any unhandled marker is NOT completer-ready and is counted as such.

export {
	// nr -> vid for the theorem's fixed variables, from its analyzed-XML subtree.
	// An nr seen with two different vids maps to -1 (ambiguous — unmapped).
	mizConstScope(thmXml : MizXml) -> Tree<int, int>;

	// every <By> position in the theorem's subtree — the join keys this theorem owns
	mizByPositions(thmXml : MizXml) -> [string];

	// one derivation record formula / witness term in the article's FOL dialect;
	// unmapped constants and checker-only sorts become unhandled markers
	// (detectable by mizFormHasUnhandled / mizTermHasUnhandled)
	mizDerivForm(sig : MizSig, scope : Tree<int, int>, x : MizXml) -> FolForm;
	mizDerivTerm(sig : MizSig, scope : Tree<int, int>, x : MizXml) -> FolTerm;

	// The INSTANTIATED FACT of one <Verify> record, built as a DIRECT INSTANCE
	// of the ARTICLE-SHAPED premise: translate the record's <Premise> (the same
	// formula the article's axiom was translated from), then ∀-eliminate its
	// prefix outermost-first at the <With> witness terms. The numbering join:
	// the checker frees binders outermost-first from 1 (mizSetFreeVarInTrm) and
	// keys its substitution by varNr - 1 (mizUniEqClassAndFreeVar), so binder k
	// (0-based) takes Assign var=k. Binder guards stay in the fact (they are
	// its provable side conditions); an unassigned binder stops the
	// elimination and the rest stays universally closed exactly as the premise
	// states it (`full=false` — the residual family). An assign pointing past
	// the stop (an inner quantifier the checker instantiated after
	// normalization) rejects the record. In this shape a fact is the premise's
	// own definitional instance — what the prover's unfold machinery is built
	// for — where the earlier checker-normal-form emission was not.
	// `fact` is the instantiated premise; `premise` the article-shaped form it
	// was instantiated FROM and `wits` the elimination trace (binder name ->
	// witness term, in the order the binders were freed). The emitter needs the
	// trace to PROVE the instance from the cited premise, not merely to state it.
	MizDerivFact(fact : FolForm, full : bool, premise : FolForm,
		wits : [Pair<string, FolTerm>]);
	mizDerivFact(sig : MizSig, scope : Tree<int, int>, v : MizXml) -> Maybe<MizDerivFact>;

	// Per By position, the CONTRADICTION CODES its disjuncts closed with —
	// the checker's own name for the rule it used (SetContr; the census
	// counts them library-wide). This is what lets the emitter DISPATCH on
	// the KIND of inference instead of feeding every fact it can build into
	// one search: a type clash and a universal instantiation are different
	// proofs, and the record says which one happened.
	mizDerivPosCodes(derivXml : string) -> Tree<string, [int]>;

	// ---- THE REFUTATION, AS RECORDED ----
	// Per By position, a single-disjunct inference's own refutation: the clause
	// the checker normalized the negated thesis to (its literals, by basic-atom
	// number and sign), the instance of the universal premise it used, and the
	// PAIRING that kills each literal (<Matches><PreLit anr=>). This is the
	// whole proof — Mizar found it, and the offline validator mizDerivValidate
	// already replays it. The emitter needs the same walk as DATA, so the
	// propositional endgame is transcribed instead of searched for: nothing
	// here is a heuristic and nothing is a choice.
	MizDerivClause(
		lits : [Pair<int, FolForm>],       // basic-atom nr -> literal, as asserted
		instance : FolForm,                // the premise instance that refutes them
		premise : FolForm,                 // the universal premise it came from
		wits : [Pair<string, FolTerm>],    // the elimination trace
		kills : [Pair<int, FolForm>],      // clause-atom nr -> the instance literal
		code : int);                       // the rule Mizar closed with
	mizDerivPosClauses(derivXml : string, sig : MizSig,
		posScope : Tree<string, Tree<int, int>>) -> Tree<string, [MizDerivClause]>;

	// Per By position, the instantiated facts of a FACT-COMPLETE accepted
	// inference (every disjunct yields at least one; duplicates collapsed).
	// A partial inference contributes NOTHING: an incomplete fact list could
	// mislead the prover into a false sense of coverage, an absent one cannot.
mizDerivPosFacts(derivXml : string, sig : MizSig,
		posScope : Tree<string, Tree<int, int>>) -> Tree<string, [MizDerivFact]>;

	// S5 (the merge-log consumer, first slice): per By position, the premise
	// EQUATIONS the equalizer actually consumed — every <Equation basic=j>
	// provenance event resolved to its disjunct's <Literal basic=j> formula.
	// This is the checker's own answer to "which equalities matter here", and
	// it is used to SEED the certificate's fact selection: the flat cut cannot
	// find 14 exact facts among 40 candidates, the record simply names them.
	mizDerivPosEqs(derivXml : string, sig : MizSig,
		posScope : Tree<string, Tree<int, int>>) -> Tree<string, [FolForm]>;

	// Per By position, the DEFINITIONS the checker expanded while checking that
	// inference, as the assertion names the translator emits for them
	// (d<nr>_<article>). The checker applies a definitional expansion with no
	// `by` reference at all, so this is the only record of which definition a
	// premise came from — and on subset_1 it is most of them.
	// Per By position, the definitions the checker expanded there, each with the
	// SYMBOL whose term it rewrote when the record knows it (a functor's
	// `equals` definition does). The symbol is what makes selection exact: the
	// definition is applied to that symbol's occurrence in the step, not to
	// whichever atom happens to match first.
	mizDerivPosExpansions(derivXml : string, sig : MizSig) -> Tree<string, [Pair<string, string>]>;
	// S4b: validate one disjunct's refutation OFFLINE, from the record alone —
	// no prover, no checker. The claim being checked: the recorded evidence
	// reproduces the kill of every premise-clause literal the successful
	// attempt used. Equality of terms = same class in the record's own class
	// table; a literal is killed when one of its recorded candidates matches
	// (heads equal, arguments classwise equal). Returns "" when the disjunct
	// validates, else the first failure bucket:
	//   no-matches      — the record carries no <Matches> (not a witnessed
	//                     Verify disjunct)
	//   complex-literal — a premise-clause literal shape v1 does not handle
	//   unclassified    — a term the class table cannot place
	//   special-rule    — only special-arm candidates (element/leq/...) —
	//                     accepted, counted apart
	//   no-kill         — no candidate reproduces the literal's kill
	mizDerivValidate(d : MizXml) -> string;
}

// ---- S4b: the offline replay validator ----

mizDerivValidate(d : MizXml) -> string {
	rs = mizKidsTagged(d, "Resolve");
	vs = mizKidsTagged(d, "Verify");
	// <Matches> is the Verify's SIBLING (flushed after the evidence element)
	matches = mizKidsTagged(d, "Matches");
	if (rs != []) mizDerivValidateResolve(d, rs[0])
	// contradictory-as-normalized: the premise refutes with no instantiation
	// and no kills — replay is pure normalization, trivially valid
	else if (matches == [] && exists(vs, \v -> mizKidsTagged(v, "Contradictory") != [])) ""
	else if (matches == []) "no-matches"
	else {
		idx = mizDerivClassIndex(d);
		asg = mizDerivAsg(concatA(map(vs, \v -> mizKidsTagged(v, "With"))));
		mizDerivKills(matches[0], mizDerivPreLits(matches[0]), idx, asg,
			mizDerivBasAt(d));
	}
}

// a code-47 RESOLUTION record: the side literals must kill like a Verify's,
// and the complementary pair must match each other classwise
mizDerivValidateResolve(d : MizXml, r : MizXml) -> string {
	idx = mizDerivClassIndex(d);
	asg = mizDerivAsg(mizKidsTagged(r, "With"));
	preLits = mizDerivPreLits(r);
	ms = mizKidsTagged(r, "Matches");
	side = if (ms == []) "" else
		mizDerivKills(ms[0], preLits, idx, asg, mizDerivBasAt(d));
	if (side != "" && side != "special-rule") side
	else {
		cs = mizKidsTagged(r, "Compl");
		if (cs == []) "no-matches"
		else {
			pa = lookupTree(preLits, s2i(mizAttr(cs[0], "a")));
			pb = lookupTree(preLits, s2i(mizAttr(cs[0], "b")));
			switch (pa) {
				None(): "no-matches";
				Some(aw): switch (pb) {
					None(): "no-matches";
					Some(bw): {
						if (aw.kids == [] || bw.kids == []) "complex-literal"
						else {
							cr = mizDerivAtomsMatch(aw, mizDerivUnwrapNot(aw.kids[0]),
								bw, mizDerivUnwrapNot(bw.kids[0]), idx, asg);
							if (cr == "") side else cr;
						}
					}
				}
			}
		}
	}
}

// class member index: canonical key (arguments as class refs) -> class nr
mizDerivClassIndex(d : MizXml) -> Tree<string, int> {
	fold(mizKidsTagged(d, "Class"), makeTree(), \acc, c -> {
		nr = s2i(mizAttr(c, "nr"));
		fold(c.kids, acc, \ac, mem -> switch (mizDerivKey(mem, ac)) {
			None(): ac;
			Some(k): setTree(ac, k, nr);
		});
	});
}

// witness substitution: FreeVar nr -> class nr (Assign var is nr - 1)
mizDerivAsg(withs : [MizXml]) -> Tree<int, int> {
	fold(withs, makeTree(), \acc, w ->
		fold(mizKidsTagged(w, "Assign"), acc, \ac, a ->
			setTree(ac, s2i(mizAttr(a, "var")) + 1, s2i(mizAttr(a, "class")))));
}

mizDerivPreLits(holder : MizXml) -> Tree<int, MizXml> {
	fold(mizKidsTagged(holder, "PreLit"), makeTree(), \acc, pl ->
		setTree(acc, s2i(mizAttr(pl, "nr")), pl));
}

mizDerivBasAt(d : MizXml) -> (string, int) -> Maybe<MizXml> {
	posBas = mizKidsTagged(d, "PosBas");
	negBas = mizKidsTagged(d, "NegBas");
	\as : string, atom : int -> {
		bs = if (as == "false") posBas else negBas;
		found = filter(bs, \b -> s2i(mizAttr(b, "nr")) == atom);
		// the WRAPPER element — it carries the adjusted-head attribute
		if (found == [] || found[0].kids == []) None() else Some(found[0]);
	};
}

// every literal the attempt used must have one reproducible kill
mizDerivKills(m : MizXml, preLits : Tree<int, MizXml>, idx : Tree<string, int>,
	asg : Tree<int, int>, basAt : (string, int) -> Maybe<MizXml>) -> string {
	byLit = fold(mizKidsTagged(m, "Cand"), makeTree(), \acc, cd -> {
		l = s2i(mizAttr(cd, "lit"));
		setTree(acc, l, arrayPush(lookupTreeDef(acc, l, []), cd));
	});
	fold(getTreeKeys(byLit), "", \err, lit -> {
		if (err != "") err
		else switch (lookupTree(preLits, lit)) {
			None(): "no-matches";
			Some(pl): {
				if (pl.kids == []) "complex-literal"
				else mizDerivKill(pl, lookupTreeDef(byLit, lit, []),
					idx, asg, basAt);
			}
		}
	});
}

// one literal: try each candidate; "" as soon as one reproduces the kill.
// `plw` is the <PreLit> WRAPPER — its anr attribute is the adjusted head.
mizDerivKill(plw : MizXml, cands : [MizXml], idx : Tree<string, int>,
	asg : Tree<int, int>, basAt : (string, int) -> Maybe<MizXml>) -> string {
	litAtom = mizDerivUnwrapNot(plw.kids[0]);
	fold(cands, "no-kill", \st, cd -> {
		if (st == "" || st == "special-rule") st
		else {
			kind = mizAttr(cd, "kind");
			if (kind == "posbas" || kind == "negbas") {
				switch (basAt(mizAttr(cd, "as"), s2i(mizAttr(cd, "atom")))) {
					None(): st;
					Some(bw): {
						r = mizDerivAtomsMatch(plw, litAtom, bw,
							mizDerivUnwrapNot(bw.kids[0]), idx, asg);
						if (r == "") "" else if (st == "no-kill") r else st;
					}
				}
			} else if (kind == "reflexivity" || kind == "irreflexivity") {
				// the two arguments of the literal fall in one class
				args = filter(litAtom.kids, \k -> k.tag != "Cluster");
				if (length(args) != 2) st
				else {
					c1 = mizDerivClassify(args[0], idx, asg);
					c2 = mizDerivClassify(args[1], idx, asg);
					if (c1 > 0 && c1 == c2) "" else st;
				}
			} else {
				// element / inclusion / empty-class / leq / ... — fixed-semantics
				// arms; accepted apart until their own validators land
				if (st == "no-kill") "special-rule" else st;
			}
		}
	});
}

mizDerivUnwrapNot(x : MizXml) -> MizXml {
	if (x.tag == "Not" && x.kids != []) x.kids[0] else x;
}

// heads equal + arguments pairwise in the same class. Heads compare by the
// wrappers' ADJUSTED numbers when both carry them (a redefined predicate keeps
// its own raw number but the unifier matched through AdjustFrm), else raw.
mizDerivAtomsMatch(aw : MizXml, a : MizXml, bw : MizXml, b : MizXml,
	idx : Tree<string, int>, asg : Tree<int, int>) -> string {
	anrA = mizAttr(aw, "anr");
	anrB = mizAttr(bw, "anr");
	headOk = if (anrA != "" && anrB != "") a.tag == b.tag && anrA == anrB
		else a.tag == b.tag && mizAttr(a, "kind") == mizAttr(b, "kind")
			&& mizAttr(a, "nr") == mizAttr(b, "nr");
	if (!headOk) "no-kill"
	else {
		aa = filter(a.kids, \k -> k.tag != "Cluster");
		bb = filter(b.kids, \k -> k.tag != "Cluster");
		if (length(aa) != length(bb)) "no-kill"
		else foldi(aa, "", \i, err, ka -> {
			if (err != "") err
			else {
				c1 = mizDerivClassify(ka, idx, asg);
				c2 = mizDerivClassify(bb[i], idx, asg);
				if (c1 > 0 && c2 > 0) { if (c1 == c2) "" else "no-kill"; }
				else {
					// not a classifiable term — a TYPE argument (a qualification
					// atom "t is T") or a shape outside the class table: compare
					// by structural key with class-resolved argument positions.
					// Identical keys => equal; distinct keys are honest no-kill
					// only when both keys exist.
					k1 = mizDerivKeyC(ka, idx, asg);
					k2 = mizDerivKeyC(bb[i], idx, asg);
					switch (k1) {
						None(): "unclassified";
						Some(s1): switch (k2) {
							None(): "unclassified";
							Some(s2): if (s1 == s2) "" else "no-kill";
						}
					}
				}
			}
		});
	}
}

// the class of a term element: EqClass refs directly, FreeVars through the
// witness substitution, compound terms through the member-key index
mizDerivClassify(x : MizXml, idx : Tree<string, int>, asg : Tree<int, int>) -> int {
	if (x.tag == "EqClass") s2i(mizAttr(x, "nr"))
	else if (x.tag == "FreeVar") lookupTreeDef(asg, s2i(mizAttr(x, "nr")), 0)
	else switch (mizDerivKeyC(x, idx, asg)) {
		None(): 0;
		Some(k): lookupTreeDef(idx, k, 0);
	}
}

// canonical key of a CLASS MEMBER: leaves by identity, argument positions by
// the class they reference; a member with an argument that is neither a leaf
// nor a class ref (Fraenkel bodies etc.) yields no key — that member simply
// does not participate in classification
mizDerivKey(x : MizXml, idx : Tree<string, int>) -> Maybe<string> {
	if (x.tag == "EqClass") Some("@" + mizAttr(x, "nr"))
	else if (x.tag == "Const" || x.tag == "InfConst" || x.tag == "Num"
		|| x.tag == "Var" || x.tag == "LocusVar")
		Some(x.tag + ":" + mizAttr(x, "nr"))
	else if (x.tag == "Func" || x.tag == "Aggreg" || x.tag == "Selector") {
		args = fold(x.kids, Some([]), \acc : Maybe<[string]>, k -> switch (acc) {
			None(): None();
			Some(ks): switch (mizDerivKey(k, idx)) {
				None(): None();
				Some(kk): Some(arrayPush(ks, kk));
			}
		});
		switch (args) {
			None(): None();
			Some(ks): Some(x.tag + ":" + mizAttr(x, "kind") + ":" + mizAttr(x, "nr")
				+ "(" + strGlue(ks, ",") + ")");
		}
	} else mizDerivKeyGen(x, \k -> mizDerivKey(k, idx));
}

// generic structural key for every other shape (Choice, Fraenkel, It, types
// and clusters inside them): matches when member and term are structurally
// identical, argument positions resolved through the recursion given
mizDerivKeyGen(x : MizXml, rec : (MizXml) -> Maybe<string>) -> Maybe<string> {
	args = fold(x.kids, Some([]), \acc : Maybe<[string]>, k -> switch (acc) {
		None(): None();
		Some(ks): switch (rec(k)) {
			None(): None();
			Some(kk): Some(arrayPush(ks, kk));
		}
	});
	switch (args) {
		None(): None();
		Some(ks): Some(x.tag + ":" + mizAttr(x, "kind") + ":" + mizAttr(x, "nr")
			+ ":" + mizAttr(x, "value")
			+ "[" + strGlue(ks, ",") + "]");
	}
}

// canonical key of a SURFACE term (a premise-literal argument): every
// argument position resolves to its CLASS first, so surface structure and
// member structure meet in one key space
mizDerivKeyC(x : MizXml, idx : Tree<string, int>, asg : Tree<int, int>) -> Maybe<string> {
	if (x.tag == "EqClass") Some("@" + mizAttr(x, "nr"))
	else if (x.tag == "FreeVar") {
		c = lookupTreeDef(asg, s2i(mizAttr(x, "nr")), 0);
		if (c == 0) None() else Some("@" + i2s(c));
	}
	else if (x.tag == "Const" || x.tag == "InfConst" || x.tag == "Num"
		|| x.tag == "Var" || x.tag == "LocusVar")
		Some(x.tag + ":" + mizAttr(x, "nr"))
	else if (x.tag == "Func" || x.tag == "Aggreg" || x.tag == "Selector") {
		args = fold(x.kids, Some([]), \acc : Maybe<[string]>, k -> switch (acc) {
			None(): None();
			Some(ks): {
				c = mizDerivClassify(k, idx, asg);
				if (c > 0) Some(arrayPush(ks, "@" + i2s(c)))
				else switch (mizDerivKeyC(k, idx, asg)) {
					None(): None();
					Some(kk): Some(arrayPush(ks, kk));
				}
			}
		});
		switch (args) {
			None(): None();
			Some(ks): Some(x.tag + ":" + mizAttr(x, "kind") + ":" + mizAttr(x, "nr")
				+ "(" + strGlue(ks, ",") + ")");
		}
	} else mizDerivKeyGen(x, \k -> {
		// class resolution first, structure as the fallback — mirrors the Func branch
		c = mizDerivClassify(k, idx, asg);
		if (c > 0) Some("@" + i2s(c)) else mizDerivKeyC(k, idx, asg);
	});
}

mizConstScope(thmXml : MizXml) -> Tree<int, int> {
	fold(mizCollectAll([thmXml], "Const"), makeTree(), \acc, c -> {
		nr = s2i(mizAttr(c, "nr"));
		vid = s2i(mizAttr(c, "vid"));
		if (nr <= 0 || vid <= 0) acc
		else switch (lookupTree(acc, nr)) {
			Some(v): if (v == vid) acc else setTree(acc, nr, -1);
			None(): setTree(acc, nr, vid);
		}
	});
}

mizByPositions(thmXml : MizXml) -> [string] {
	filter(map(mizCollectAll([thmXml], "By"), mizByPos), \p -> p != "");
}

mizDerivForm(sig : MizSig, scope : Tree<int, int>, x : MizXml) -> FolForm {
	mizResugar(mizForm(sig, [], mizDerivPatch(scope, x)));
}

mizDerivTerm(sig : MizSig, scope : Tree<int, int>, x : MizXml) -> FolTerm {
	mizTerm(sig, [], mizDerivPatch(scope, x));
}

mizDerivPosCodes(derivXml : string) -> Tree<string, [int]> {
	switch (mizParseXml(derivXml)) {
		None(): makeTree();
		Some(root): fold(mizKidsTagged(root, "Inference"), makeTree(), \acc, inf -> {
			pos = mizAttr(inf, "line") + ":" + mizAttr(inf, "col");
			cs = concatA(map(mizKidsTagged(inf, "Disjunct"), \d ->
				filtermap(mizKidsTagged(d, "Contr"), \c -> {
					v = mizAttr(c, "code");
					if (v == "") None() else Some(s2i(v));
				})));
			if (cs == []) acc
			else setTree(acc, pos, uniq(concat(lookupTreeDef(acc, pos, []), cs)));
		});
	}
}

mizDerivPosExpansions(derivXml : string, sig : MizSig) -> Tree<string, [Pair<string, string>]> {
	switch (mizParseXml(derivXml)) {
		None(): makeTree();
		Some(root): fold(mizKidsTagged(root, "Inference"), makeTree(), \acc, inf -> {
			pos = mizAttr(inf, "line") + ":" + mizAttr(inf, "col");
			names = uniq(map(mizKidsTagged(inf, "Expand"), \e -> {
				nm = "d" + mizAttr(e, "nr") + "_" + toLowerCase(mizAttr(e, "article"));
				fn = mizAttr(e, "func");
				sym = if (fn == "") "" else mizSymName(sig, "K", s2i(fn));
				Pair(nm, sym);
			}));
			if (names == []) acc
			else setTree(acc, pos, uniq(concat(lookupTreeDef(acc, pos, []), names)));
		});
	}
}

// ---- RESOLVING THE CHECKER'S EQUIVALENCE CLASSES ----
// The record refers to terms by their equalizer CLASS (<EqClass nr>), and
// deriv.flow translated those to an unhandled marker — its own header called
// it a future slice. It is what made the recorded clause unreadable: the
// literals that come from the goal arrived as class references, so they
// shared nothing with anything, and the "two normal forms have no atoms in
// common" measurement was mostly this.
// The record does carry the classes: <Class nr> lists its members, and a
// member with no class reference inside it IS a surface term. Members may
// reference other classes, so resolution repeats under a fuel bound.
mizDerivHasEqClass(x : MizXml) -> bool {
	x.tag == "EqClass" || exists(x.kids, mizDerivHasEqClass);
}

mizDerivClassReps(d : MizXml) -> Tree<int, MizXml> {
	fold(mizKidsTagged(d, "Class"), makeTree(), \acc, c -> {
		nr = s2i(mizAttr(c, "nr"));
		ground = filter(c.kids, \m -> !mizDerivHasEqClass(m));
		if (ground != []) setTree(acc, nr, ground[0])
		else if (c.kids != []) setTree(acc, nr, c.kids[0])
		else acc;
	});
}

mizDerivResolveEq(x : MizXml, reps : Tree<int, MizXml>, fuel : int) -> MizXml {
	if (fuel <= 0) x
	else if (x.tag == "EqClass")
		switch (lookupTree(reps, s2i(mizAttr(x, "nr")))) {
			None(): x;
			Some(r): mizDerivResolveEq(r, reps, fuel - 1);
		}
	else MizXml(x.tag, x.attrs, map(x.kids, \k -> mizDerivResolveEq(k, reps, fuel)));
}

// per By position, the recorded refutation of a SINGLE-disjunct inference —
// the shape 74% of the library's inferences have, and 64% of subset_1's close
// by one universal premise (code 45). Clause, instance and kill pairing come
// straight from the record; this function chooses nothing.
mizDerivPosClauses(derivXml : string, sig : MizSig,
	posScope : Tree<string, Tree<int, int>>) -> Tree<string, [MizDerivClause]> {
	switch (mizParseXml(derivXml)) {
		None(): makeTree();
		Some(root): fold(mizKidsTagged(root, "Inference"), makeTree(), \acc, inf -> {
			pos = mizAttr(inf, "line") + ":" + mizAttr(inf, "col");
			scope = lookupTreeDef(posScope, pos, makeTree());
			ds = mizKidsTagged(inf, "Disjunct");
			if (mizAttr(inf, "accepted") != "true" || length(ds) != 1) acc
			else {
				d = ds[0];
				// every class reference resolved to a surface term first
				reps = mizDerivClassReps(d);
				rf = \x9 : MizXml -> mizDerivForm(sig, scope, mizDerivResolveEq(x9, reps, 8));
				codes = filtermap(mizKidsTagged(d, "Contr"), \c -> {
					v = mizAttr(c, "code");
					if (v == "") None() else Some(s2i(v));
				});
				lits = concat(
					filtermap(mizKidsTagged(d, "PosBas"), \b ->
						if (b.kids == []) None()
						else Some(Pair(s2i(mizAttr(b, "nr")),
							rf(b.kids[0])))),
					filtermap(mizKidsTagged(d, "NegBas"), \b ->
						if (b.kids == []) None()
						else Some(Pair(s2i(mizAttr(b, "nr")),
							FolNeg(rf(b.kids[0]))))));
				vs = mizKidsTagged(d, "Verify");
				ms = mizKidsTagged(d, "Matches");
				if (codes == [] || vs == [] || ms == []) acc
				else switch (mizDerivFact(sig, scope, vs[0])) {
					None(): acc;
					Some(df): {
						kills = filtermap(mizKidsTagged(ms[0], "PreLit"), \pl ->
							if (pl.kids == []) None()
							else Some(Pair(s2i(mizAttr(pl, "anr")),
								rf(pl.kids[0]))));
						if (kills == []) acc
						else setTree(acc, pos, arrayPush(lookupTreeDef(acc, pos, []),
							MizDerivClause(lits, df.fact, df.premise, df.wits,
								kills, codes[0])));
					}
				}
			}
		});
	}
}

mizDerivPosFacts(derivXml : string, sig : MizSig,
	posScope : Tree<string, Tree<int, int>>) -> Tree<string, [MizDerivFact]> {
	switch (mizParseXml(derivXml)) {
		None(): makeTree();
		Some(root): fold(mizKidsTagged(root, "Inference"), makeTree(), \acc, inf -> {
			pos = mizAttr(inf, "line") + ":" + mizAttr(inf, "col");
			scope = lookupTreeDef(posScope, pos, makeTree());
			ds = mizKidsTagged(inf, "Disjunct");
			if (mizAttr(inf, "accepted") != "true" || ds == []) acc
			else {
				perD = map(ds, \d ->
					filtermap(mizKidsTagged(d, "Verify"), \v -> mizDerivFact(sig, scope, v)));
				if (exists(perD, \fs -> fs == [])) acc
				else setTree(acc, pos, uniq(concatA(perD)));
			}
		});
	}
}

mizDerivFact(sig : MizSig, scope : Tree<int, int>, v : MizXml) -> Maybe<MizDerivFact> {
	prems = mizKidsTagged(v, "Premise");
	withs = mizKidsTagged(v, "With");
	if (prems == [] || prems[0].kids == []) None()
	else {
		prem = mizDerivForm(sig, scope, prems[0].kids[0]);
		if (mizFormHasUnhandled(prem)) None()
		else {
			// Assign var (0-based binder index) -> witness term
			asg = fold(if (withs == []) [] else mizKidsTagged(withs[0], "Assign"),
				Some(makeTree()), \acc : Maybe<Tree<int, FolTerm>>, a -> switch (acc) {
					None(): None();
					Some(s): if (a.kids == []) None() else {
						t = mizDerivTerm(sig, scope, a.kids[0]);
						if (mizTermHasUnhandled(t)) None()
						else Some(setTree(s, s2i(mizAttr(a, "var")), t));
					}
				});
			switch (asg) {
				None(): None();
				Some(s): mizDerivElim(prem, s, 0);
			}
		}
	}
}

// ∀-eliminate the premise at the recorded witnesses. Binder k takes Assign
// var=k, and THE ORDER OF k IS MIZAR'S, not the leading prefix's: the checker
// numbers a premise's free variables in RemoveExtQuantifier /
// RemoveIntQuantifier order (unifier.pas, ported at
// mizar/original/unifier.flow:2069), which frees a universal binder wherever it
// stands in POSITIVE position — under a negation, in an implication's
// consequent, inside a conjunct — and never in negative position. Walking only
// the leading prefix stopped at the first connective and rejected the record:
// `witness/inner-quantifier` was 150 of 264 records on xboole_1, by far the
// largest reason the instantiated fact could not be computed.
//
// Mizar has only ¬ and ∧, so its two mutually recursive routines read on our
// dialect as: positive (Ext) descends ¬ into negative, both sides of ∨, an
// implication's CONSEQUENT and every conjunct; negative (Int) is the dual and
// frees nothing. `iff` is left alone — it is positive and negative at once, so
// no binder under it may be freed.
//
// The translator emits one FolQuant per Mizar binder with its guard as an
// implication antecedent inside the body, so instantiation keeps the guard,
// exactly as ∀-elim does. Substitution is capture-free: witnesses are ground
// article terms. An assign that is never consumed still rejects the record.
mizDerivElim(f : FolForm, asg : Tree<int, FolTerm>, k : int) -> Maybe<MizDerivFact> {
	wits : ref [Pair<string, FolTerm>] = ref [];
	r = mizDerivElimPos(f, asg, k, wits);
	if (exists(getTreeKeys(asg), \kk -> kk >= r.second)) None()
	else Some(MizDerivFact(r.first, !existsQuantPrefix(r.first), f, ^wits));
}

// (instance, next binder index) in POSITIVE position — RemoveExtQuantifier
mizDerivElimPos(f : FolForm, asg : Tree<int, FolTerm>, k : int,
	wits : ref [Pair<string, FolTerm>]) -> Pair<FolForm, int> {
	switch (f) {
		FolQuant(q, vs, body):
			if (q != "forall" || vs == []) Pair(f, k)
			else switch (lookupTree(asg, k)) {
				None(): Pair(f, k);
				Some(t): {
					rest = if (length(vs) == 1) body else FolQuant(q, tail(vs), body);
					{
						wits := arrayPush(^wits, Pair(vs[0], t));
						mizDerivElimPos(mizDerivSubstForm(rest, makeTree1(vs[0], t)), asg, k + 1, wits);
					}
				}
			}
		FolNeg(g): {
			r = mizDerivElimNeg(g, asg, k, wits);
			Pair(FolNeg(r.first), r.second);
		}
		FolBin(op, l, r):
			if (op == "imp") {
				// ¬(l ∧ ¬r): the antecedent is negative, the consequent positive
				a = mizDerivElimNeg(l, asg, k, wits);
				b = mizDerivElimPos(r, asg, a.second, wits);
				Pair(FolBin(op, a.first, b.first), b.second);
			} else if (op == "and" || op == "or") {
				a = mizDerivElimPos(l, asg, k, wits);
				b = mizDerivElimPos(r, asg, a.second, wits);
				Pair(FolBin(op, a.first, b.first), b.second);
			} else Pair(f, k);
		default: Pair(f, k);
	}
}

// NEGATIVE position — RemoveIntQuantifier: a universal binder here is an
// existential one in the refutation and stays bound
mizDerivElimNeg(f : FolForm, asg : Tree<int, FolTerm>, k : int,
	wits : ref [Pair<string, FolTerm>]) -> Pair<FolForm, int> {
	switch (f) {
		FolNeg(g): {
			r = mizDerivElimPos(g, asg, k, wits);
			Pair(FolNeg(r.first), r.second);
		}
		FolBin(op, l, r):
			if (op == "imp") {
				a = mizDerivElimPos(l, asg, k, wits);
				b = mizDerivElimNeg(r, asg, a.second, wits);
				Pair(FolBin(op, a.first, b.first), b.second);
			} else if (op == "and" || op == "or") {
				a = mizDerivElimNeg(l, asg, k, wits);
				b = mizDerivElimNeg(r, asg, a.second, wits);
				Pair(FolBin(op, a.first, b.first), b.second);
			} else Pair(f, k);
		default: Pair(f, k);
	}
}

// does the form still START with a universal prefix (= the elimination stopped
// early, the residual family)? Inner quantifiers deeper in the body are fine.
existsQuantPrefix(f : FolForm) -> bool {
	switch (f) {
		FolQuant(q, __, __): q == "forall";
		default: false;
	}
}

// Substitute terms for free variables by name. The witness terms are ground
// surface terms (constants and functors over them), so no capture can occur;
// an inner binder of the same name (impossible in the XF namespace) would
// shadow — handled for safety anyway.
mizDerivSubstForm(f : FolForm, s : Tree<string, FolTerm>) -> FolForm {
	switch (f) {
		FolPred(n, args):  FolPred(n, map(args, \t -> mizDerivSubstTerm(t, s)));
		FolEq(l, r):       FolEq(mizDerivSubstTerm(l, s), mizDerivSubstTerm(r, s));
		FolNeg(g):         FolNeg(mizDerivSubstForm(g, s));
		FolBin(op, l, r):  FolBin(op, mizDerivSubstForm(l, s), mizDerivSubstForm(r, s));
		FolQuant(op, vs, body):
			FolQuant(op, vs, mizDerivSubstForm(body, fold(vs, s, \acc, x -> removeFromTree(acc, x))));
	}
}

mizDerivSubstTerm(t : FolTerm, s : Tree<string, FolTerm>) -> FolTerm {
	switch (t) {
		FolVar(n): lookupTreeDef(s, n, t);
		FolAbs(x, body): FolAbs(x, mizDerivSubstForm(body, removeFromTree(s, x)));
		FolApp(n, args): FolApp(n, map(args, \a -> mizDerivSubstTerm(a, s)));
	}
}

// Rewrite each <Const nr vid="0"> to its scope vid, so the shared mizForm/mizTerm
// naming ("X" + vid) lands on the same variables as the translated skeleton. An
// unmapped/ambiguous nr becomes a fresh tag that falls through to the translators'
// unhandled branch.
mizDerivPatch(scope : Tree<int, int>, x : MizXml) -> MizXml {
	if (x.tag == "Const") {
		vid = lookupTreeDef(scope, s2i(mizAttr(x, "nr")), -1);
		if (vid <= 0) MizXml("UnmappedConst", x.attrs, [])
		else MizXml("Const", setTree(x.attrs, "vid", i2s(vid)), x.kids);
	} else if (x.kids == []) x
	else MizXml(x.tag, x.attrs, map(x.kids, \k -> mizDerivPatch(scope, k)));
}

// per position, the <Equation basic=j>-cited premise-equation literals of
// every accepted disjunct, in the article dialect; unhandled-marker forms and
// non-equation shapes are dropped (honest: an absent seed cannot mislead)
mizDerivPosEqs(derivXml : string, sig : MizSig,
	posScope : Tree<string, Tree<int, int>>) -> Tree<string, [FolForm]> {
	switch (mizParseXml(derivXml)) {
		None(): makeTree();
		Some(root): fold(mizKidsTagged(root, "Inference"), makeTree(), \acc, inf -> {
			pos = mizAttr(inf, "line") + ":" + mizAttr(inf, "col");
			scope = lookupTreeDef(posScope, pos, makeTree());
			ds = mizKidsTagged(inf, "Disjunct");
			if (mizAttr(inf, "accepted") != "true" || ds == []) acc
			else {
				eqs = concatA(map(ds, \d -> {
					lits = fold(mizKidsTagged(d, "Literal"), makeTree(), \ac, l ->
						if (l.kids == []) ac
						else setTree(ac, s2i(mizAttr(l, "basic")), l.kids[0]));
					filtermap(mizKidsTagged(d, "Equation"), \e ->
						switch (lookupTree(lits, s2i(mizAttr(e, "basic")))) {
							None(): None();
							Some(lx): {
								f = mizResugar(mizDerivForm(sig, scope, lx));
								if (mizFormHasUnhandled(f)) None()
								else switch (f) {
									FolEq(__, __): Some(f);
									default: None();
								}
							}
						});
				}));
				uq = fold(eqs, [], \ac2, f2 ->
					if (exists(ac2, \g2 -> g2 == f2)) ac2 else arrayPush(ac2, f2));
				if (uq == []) acc else setTree(acc, pos, uq);
			}
		});
	}
}
